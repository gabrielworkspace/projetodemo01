	-- e a lâmina varre a frente toda; o golpe 3 é um giro completo.
	local GIRO = PI * 2
	local BRACO_GIRO = { ombroD = A(0.66, -2.97, -1.52), cotoveloD = A(0), pulsoD = A(-1.04, 1.4, -0.78) }

