------------------------------------------------------------------------
-- Atualizações
------------------------------------------------------------------------

local function atualizarPerfil()
	local perfil = Estado.perfil
	local classe = Classes.obter(perfil.classe)
	textoOuroLobby.Text = formatarNumero(perfil.ouro or 0)
	textoRecorde.Text = "Sala " .. (perfil.recorde or 0)
	classeJogador.Text = classe.icone .. " " .. classe.nome
	classeJogador.TextColor3 = classe.cor:Lerp(cores.branco, 0.25)
	tituloClasse.Text = classe.titulo
	aroFoto.Color = classe.cor
end

local function atualizarClasseNaBarra()
	local id = if Estado.stats then Estado.stats.classe else Estado.perfil.classe
	local classe = Classes.obter(id)
	local icone = medalhaoClasse:FindFirstChild("Icone") :: TextLabel?
	if icone then
		icone.Text = classe.icone
	end
	slots.ataque.icone.Text = classe.ataque.icone
	slots.habilidade.icone.Text = classe.habilidade.icone
	slots.supremo.icone.Text = classe.supremo.icone
	toque.ataque.rotulo.Text = classe.ataque.icone
	toque.habilidade.rotulo.Text = classe.habilidade.icone
	toque.supremo.rotulo.Text = classe.supremo.icone
	toque.defesa.botao.Visible = classe.id == "cavaleiro"
	barraVida.cor(classe.cor:Lerp(cores.vida, 0.65))
end

local function atualizarCartas()
	for _, filho in faixaCartas:GetChildren() do
		if filho:IsA("Frame") then
			filho:Destroy()
		end
	end
	for ordem, carta in Cartas.lista do
		local quantidade = Estado.cartas[carta.id] or 0
		if quantidade > 0 then
			local m = UI.medalhao({
				Parent = faixaCartas,
				Icone = carta.icone,
				Cor = cores.painelClaro,
				Borda = Config.RARIDADES[carta.raridade].cor,
				LayoutOrder = ordem,
			})
			if quantidade > 1 then
				local n = UI.texto({
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, 4, 1, 4),
					Size = UDim2.fromOffset(24, 16),
					FontFace = fontes.numero,
					Text = "x" .. quantidade,
					TextColor3 = cores.ouroClaro,
					ZIndex = 4,
					Parent = m,
				})
				UI.contorno(n, 1.5, 0)
			end
		end
	end
end

local function montarAliados()
	for _, filho in listaAliados:GetChildren() do
		if filho:IsA("Frame") then
			filho:Destroy()
		end
	end
	table.clear(quadrosAliados)
	for ordem, aliado in Estado.aliados do
		if aliado.userId ~= jogador.UserId then
			local classe = Classes.obter(aliado.classe)
			local quadro = UI.painel({ Size = UDim2.fromOffset(240, 58), LayoutOrder = ordem, Parent = listaAliados, SemCantos = true, Transparencia = 0.15 })
			local retrato = criar("ImageLabel", {
				Position = UDim2.fromOffset(8, 7),
				Size = UDim2.fromOffset(44, 44),
				BackgroundColor3 = cores.fundo,
				Image = UI.fotoJogador(aliado.userId),
				Parent = quadro,
			})
			UI.redondo(retrato)
			UI.borda(retrato, classe.cor, 2)
			local nome = UI.texto({
				Position = UDim2.fromOffset(60, 6),
				Size = UDim2.fromOffset(170, 20),
				FontFace = fontes.forte,
				Text = classe.icone .. " " .. aliado.nome,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = quadro,
			})
			UI.contorno(nome, 1.5)
			local barra = UI.barra({ Parent = quadro, Position = UDim2.fromOffset(60, 32), Size = UDim2.fromOffset(170, 14), Raio = 4 })
			barra.rotulo.Visible = false
			quadrosAliados[aliado.userId] = { quadro = quadro, barra = barra, nome = nome, retrato = retrato, texto = classe.icone .. " " .. aliado.nome }
		end
	end
end

------------------------------------------------------------------------
-- API chamada pelo Main
------------------------------------------------------------------------

function Hud.modo(modo: string)
	telaLobby.Visible = modo == "lobby"
	telaPartida.Visible = modo == "partida"
	areaToque.Visible = modo == "partida" and celular
	barraAcoes.Visible = not celular
	vidaCelular.Visible = celular
	painelChefe.Visible = false
	painelCaido.Visible = false
	textoEspectador.Visible = false
	if modo == "partida" then
		montarAliados()
		atualizarCartas()
		atualizarClasseNaBarra()
	else
		painelFila.Visible = false
	end
	animar(escuro, 0.3, { BackgroundTransparency = 1 })
end

function Hud.fila(dados)
	if dados.esconder or Estado.modo ~= "lobby" then
		painelFila.Visible = false
		return
	end
	painelFila.Visible = true
	if dados.cheio then
		contagemFila.Text = "—"
		dicaFila.Text = "Grupo cheio! Espere a próxima partida."
		return
	end
	contagemFila.Text = tostring(dados.segundos)
	dicaFila.Text = "Saia do círculo para cancelar"
	for i, vaga in vagas do
		local membro = dados.membros and dados.membros[i]
		if membro then
			local classe = Classes.obter(membro.classe)
			vaga.imagem.Image = UI.fotoJogador(membro.userId)
			vaga.aro.Color = classe.cor
			vaga.icone.Text = classe.icone
		else
			vaga.imagem.Image = ""
			vaga.aro.Color = cores.bronze
			vaga.icone.Text = ""
		end
	end
end

local idBanner = 0
function Hud.banner(texto: string, cor: Color3?)
	idBanner += 1
	local meu = idBanner
	textoBanner.Text = texto
	textoBanner.TextColor3 = cor or cores.texto
	banner.Position = UDim2.fromScale(0.5, 0.25)
	banner.GroupTransparency = 1
	animar(banner, 0.3, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.22) }, Enum.EasingStyle.Back)
	task.delay(2.4, function()
		if idBanner == meu then
			animar(banner, 0.4, { GroupTransparency = 1 })
		end
	end)
end

function Hud.aviso(texto: string)
	local quadro = UI.painel({ Size = UDim2.fromOffset(330, 46), Parent = pilhaAvisos, SemCantos = true, Transparencia = 0.1 })
	local grupo = criar("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = quadro })
	local rotulo = UI.texto({
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 1, -16),
		FontFace = fontes.forte,
		Text = texto,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = grupo,
	})
	UI.limiteTexto(rotulo, 20)
	local deslize = criar("UIScale", { Scale = 0.6, Parent = quadro })
	animar(deslize, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	local avisos = {}
	for _, filho in pilhaAvisos:GetChildren() do
		if filho:IsA("Frame") then
			table.insert(avisos, filho)
		end
	end
	if #avisos > 4 then
		avisos[1]:Destroy()
	end
	task.delay(3.5, function()
		if quadro.Parent then
			animar(grupo, 0.3, { GroupTransparency = 1 })
			animar(quadro, 0.3, { BackgroundTransparency = 1 })
			task.wait(0.3)
			quadro:Destroy()
		end
	end)
end

local function mostrarTitulo(titulo: string, sub: string, cor: Color3, duracao: number)
	tituloGrande.Text = titulo
	tituloGrande.TextColor3 = cor
	subtitulo.Text = sub
	local escala = cartaoTitulo:FindFirstChildOfClass("UIScale")
	cartaoTitulo.GroupTransparency = 1
	if escala then
		escala.Scale = UI.escalaAtual * 1.25
		animar(escala, 0.5, { Scale = UI.escalaAtual }, Enum.EasingStyle.Quint)
	end
	animar(cartaoTitulo, 0.4, { GroupTransparency = 0 })
	task.delay(duracao, function()
		animar(cartaoTitulo, 0.6, { GroupTransparency = 1 })
	end)
end

function Hud.sala(dados)
	textoSala.Text = (if dados.tipo == "chefe" then "☠ " elseif dados.tipo == "tesouro" then "💰 " else "") .. "SALA " .. dados.numero
	textoTema.Text = dados.tema.nome
	for i, pip in pips do
		local cor = cores.bronze
		if i < dados.posicaoNoAndar then
			cor = cores.ouro
		elseif i == dados.posicaoNoAndar then
			cor = if dados.tipo == "chefe" then Color3.fromRGB(255, 60, 60) else cores.ouroClaro
		elseif i == #pips then
			cor = Color3.fromRGB(140, 40, 40)
		end
		pip.BackgroundColor3 = cor
	end
	if dados.tipo ~= "chefe" then
		mostrarTitulo("Sala " .. dados.numero, dados.tema.nome, cores.ouroClaro, 1.6)
	end
end

function Hud.introChefe(dados)
	animar(faixaCima, 0.4, { Position = UDim2.fromScale(0, 0) })
	animar(faixaBaixo, 0.4, { Position = UDim2.fromScale(0, 0.88) })
	mostrarTitulo(dados.nome, dados.titulo, Color3.fromRGB(255, 96, 80), 2.2)
	Vfx.tremer(1.5, 0.8)
	task.delay(2.6, function()
		animar(faixaCima, 0.5, { Position = UDim2.fromScale(0, -0.12) })
		animar(faixaBaixo, 0.5, { Position = UDim2.fromScale(0, 1) })
	end)
end

function Hud.transicao(escurecer: boolean)
	if escurecer then
		animar(escuro, 0.35, { BackgroundTransparency = 0 })
	else
		task.delay(0.2, function()
			animar(escuro, 0.5, { BackgroundTransparency = 1 })
		end)
	end
end

function Hud.danoLocal(_valor: number)
	vinheta.GroupTransparency = 0.25
	animar(vinheta, 0.5, { GroupTransparency = 1 })
end

function Hud.ganhouOuro(_valor: number)
	local escala = textoOuroPartida:FindFirstChildOfClass("UIScale") or criar("UIScale", { Parent = textoOuroPartida })
	escala.Scale = 1.25
	animar(escala, 0.25, { Scale = 1 })
end

function Hud.caiu()
	painelCaido.Visible = true
	tituloCaido.Text = "VOCÊ CAIU"
	dicaCaido.Text = "Um aliado precisa ficar perto de você para te levantar!"
end

function Hud.levantou()
	painelCaido.Visible = false
end

function Hud.morreu()
	painelCaido.Visible = false
	textoEspectador.Text = "💀 Você caiu. Você volta quando seus amigos limparem a sala."
	textoEspectador.Visible = true
end

function Hud.reviveu()
	textoEspectador.Visible = false
	painelCaido.Visible = false
end

------------------------------------------------------------------------
-- Loop: barras, recargas, aliados, chefe, espectador
------------------------------------------------------------------------

local function recarga(fim: number, total: number, sombra: Frame, segundos: TextLabel, redondo: boolean)
	local restante = fim - os.clock()
	if restante > 0 then
		if redondo then
			sombra.Visible = true
		else
			sombra.Size = UDim2.fromScale(1, math.clamp(restante / math.max(total, 0.01), 0, 1))
		end
		segundos.Text = if restante >= 1 then tostring(math.ceil(restante)) else string.format("%.1f", restante)
	else
		if redondo then
			sombra.Visible = false
		else
			sombra.Size = UDim2.fromScale(1, 0)
		end
		segundos.Text = ""
	end
end

local placasCaidos = {} -- [Model] = { placa, barra }

-- Placa sobre aliados caídos, com o progresso de reviver
local function atualizarCaidos()
	for _, aliado in Estado.aliados do
		local outro = Players:GetPlayerByUserId(aliado.userId)
		local personagem = outro and outro.Character
		if personagem and outro ~= jogador then
			local caido = personagem:GetAttribute("Caido") == true
			local info = placasCaidos[personagem]
			if caido and not info then
				local cabeca = personagem:FindFirstChild("Head") or personagem:FindFirstChild("HumanoidRootPart")
				if cabeca then
					local placa = criar("BillboardGui", {
						Adornee = cabeca,
						Size = UDim2.fromOffset(150, 52),
						StudsOffset = Vector3.new(0, 3, 0),
						AlwaysOnTop = true,
						LightInfluence = 0,
						Parent = gui,
					})
					local rotulo = UI.texto({ Size = UDim2.new(1, 0, 0, 22), FontFace = fontes.numero, Text = "💀 CAÍDO", TextColor3 = Color3.fromRGB(255, 120, 110), Parent = placa })
					UI.contorno(rotulo, 2, 0)
					local barra = UI.barra({ Parent = placa, Position = UDim2.fromOffset(10, 28), Size = UDim2.fromOffset(130, 14), Cor = cores.sucesso, Raio = 4 })
					barra.rotulo.Visible = false
					barra.definir(0)
					info = { placa = placa, barra = barra }
					placasCaidos[personagem] = info
				end
			elseif not caido and info then
				info.placa:Destroy()
				placasCaidos[personagem] = nil
				info = nil
			end
			if info then
				info.barra.definir(personagem:GetAttribute("Reviver") or 0)
			end
		end
	end
	for personagem, info in placasCaidos do
		if not personagem.Parent then
			info.placa:Destroy()
			placasCaidos[personagem] = nil
		end
	end
end

local proximoEspectador = 0
local function atualizarEspectador()
	if not Estado.morto or os.clock() < proximoEspectador then
		return
	end
	proximoEspectador = os.clock() + 0.5
	local camera = workspace.CurrentCamera
	local atual = camera.CameraSubject
	local valido = atual ~= nil and atual:IsA("Humanoid") and atual.Health > 0 and atual.Parent ~= jogador.Character
	if valido then
		return
	end
	for _, aliado in Estado.aliados do
		local outro = Players:GetPlayerByUserId(aliado.userId)
		local personagem = outro and outro ~= jogador and outro.Character
		local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
		if outro and humanoid and humanoid.Health > 0 then
			camera.CameraSubject = humanoid
			textoEspectador.Text = "👻 Assistindo " .. outro.DisplayName .. ". Você volta quando a sala for limpa."
			return
		end
	end
end

local function atualizarChefe()
	local chefe = nil
	for _, modelo in CollectionService:GetTagged("Inimigo") do
		if modelo:GetAttribute("Chefe") then
			chefe = modelo
			break
		end
	end
	painelChefe.Visible = chefe ~= nil and Estado.modo == "partida"
	if chefe then
		nomeChefe.Text = (if chefe:GetAttribute("Furioso") then "🔥 " else "") .. (chefe:GetAttribute("Nome") or "")
		tituloChefe.Text = chefe:GetAttribute("Titulo") or ""
		local vida = chefe:GetAttribute("Vida") or 0
		local maxima = chefe:GetAttribute("VidaMax") or 1
		barraChefe.definir(vida / math.max(maxima, 1), formatarNumero(math.max(0, vida)) .. " / " .. formatarNumero(maxima))
	end
end

function Hud.iniciar()
	Estado.Mudou:Connect(function(chave)
		if chave == "perfil" then
			atualizarPerfil()
			if Estado.modo == "lobby" then
				atualizarClasseNaBarra()
			end
		elseif chave == "stats" then
			atualizarClasseNaBarra()
		elseif chave == "cartas" then
			atualizarCartas()
		elseif chave == "ouro" then
			textoOuroPartida.Text = formatarNumero(Estado.ouroPartida)
		elseif chave == "teclas" then
			atualizarTeclasNosSlots()
		end
	end)
	atualizarPerfil()

	local pulsoVida = 0
	local manaExibida = 0
	local semManaAte = 0
	Estado.Mudou:Connect(function(chave)
		if chave == "semMana" then
			Sons.tocar("semMana")
			semManaAte = os.clock() + 0.4
			Hud.aviso("💧 Sem mana!")
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		local personagem = jogador.Character
		local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.MaxHealth > 0 then
			local fracao = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
			local texto = math.ceil(math.max(0, humanoid.Health)) .. " / " .. math.floor(humanoid.MaxHealth)
			barraVida.definir(fracao, texto)
			barraVidaCelular.definir(fracao, texto)
			-- vida baixa: bordas vermelhas pulsando
			if Estado.modo == "partida" and fracao < 0.3 and fracao > 0 and not Estado.caido then
				pulsoVida += dt * 5
				vinhetaVida.GroupTransparency = 0.6 + 0.25 * math.sin(pulsoVida)
			else
				vinhetaVida.GroupTransparency = 1
			end
		end
		if Estado.modo ~= "partida" then
			return
		end

		-- mana: a barra corre suave até o valor do servidor; pisca vermelha quando falta
		local temMana = Estado.manaMax > 0
		barraMana.quadro.Visible = temMana
		barraManaCelular.quadro.Visible = temMana
		if temMana then
			manaExibida += (Estado.mana - manaExibida) * math.min(1, dt * 12)
			local fracaoMana = math.clamp(manaExibida / Estado.manaMax, 0, 1)
			local textoMana = "💧 " .. math.floor(manaExibida) .. " / " .. math.floor(Estado.manaMax)
			barraMana.definir(fracaoMana, textoMana)
			barraManaCelular.definir(fracaoMana)
			local alerta = math.max(0, semManaAte - os.clock()) / 0.4
			local corFundo = Color3.fromRGB(12, 18, 36):Lerp(Color3.fromRGB(150, 20, 30), alerta)
			barraMana.quadro.BackgroundColor3 = corFundo
			barraManaCelular.quadro.BackgroundColor3 = corFundo
		end

		local carga = math.clamp(Estado.carga / math.max(Estado.cargaMax, 1), 0, 1)
		barraCarga.definir(carga)
		barraCargaCelular.definir(carga)
		local pronto = carga >= 1
		slots.supremo.aro.Color = if pronto then cores.ouroClaro else cores.bronze
		slots.supremo.aro.Thickness = if pronto then 3 + math.sin(os.clock() * 6) else 2
		toque.supremo.sombra.Visible = not pronto
		toque.supremo.aro.Color = if pronto then cores.ouroClaro else cores.bronze

		recarga(Estado.habilidadeFim, Estado.habilidadeTotal, slots.habilidade.sombra, slots.habilidade.segundos, false)
		recarga(Estado.esquivaFim, Estado.esquivaTotal, slots.esquiva.sombra, slots.esquiva.segundos, false)
		recarga(Estado.habilidadeFim, Estado.habilidadeTotal, toque.habilidade.sombra, toque.habilidade.segundos, true)
		recarga(Estado.esquivaFim, Estado.esquivaTotal, toque.esquiva.sombra, toque.esquiva.segundos, true)

		for userId, info in quadrosAliados do
			local outro = Players:GetPlayerByUserId(userId)
			local p = outro and outro.Character
			local h = p and p:FindFirstChildOfClass("Humanoid")
			if not outro then
				info.nome.Text = info.texto .. " (saiu)"
				info.barra.definir(0)
			elseif h and h.MaxHealth > 0 then
				info.barra.definir(h.Health / h.MaxHealth)
				if p:GetAttribute("Caido") then
					info.nome.Text = "💀 " .. info.texto
				elseif h.Health <= 0 then
					info.nome.Text = "☠ " .. info.texto
				else
					info.nome.Text = info.texto
				end
			end
		end

		if Estado.caido and personagem then
			local restante = personagem:GetAttribute("CaidoRestante") or 0
			local reviver = personagem:GetAttribute("Reviver") or 0
			barraCaido.definir(restante / Config.TEMPO_CAIDO)
			if reviver > 0 then
				tituloCaido.Text = "LEVANTANDO... " .. math.floor(reviver * 100) .. "%"
			else
				tituloCaido.Text = "VOCÊ CAIU  •  " .. math.ceil(restante) .. "s"
			end
		end

		atualizarCaidos()
		atualizarEspectador()
		atualizarChefe()
	end)
end

return Hud
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX00000035">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source"><![CDATA[-- Script principal do jogador: liga a interface, os efeitos, os controles e recebe as
-- mensagens do servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local modulos = script.Parent
local Estado = require(modulos.Estado)
local UI = require(modulos.UI)
local Vfx = require(modulos.Vfx)
local Ambiente = require(modulos.Ambiente)
local VisualInimigos = require(modulos.VisualInimigos)
local Controles = require(modulos.Controles)
local Animacoes = require(modulos.Animacoes)
local Hud = require(modulos.Hud)
local Menus = require(modulos.Menus)
local Atalhos = require(modulos.Atalhos)
local Sons = require(modulos.Sons)
local TexturasGeradas = require(modulos.TexturasGeradas)

local jogador = Players.LocalPlayer
local Remotos = ReplicatedStorage:WaitForChild("Remotos")
local Evento = Remotos:WaitForChild("Evento") :: RemoteEvent
local Acao = Remotos:WaitForChild("Acao") :: RemoteEvent

-- Esconde a barra de vida e a mochila padrão do Roblox (usamos as nossas)
for _, tipo in { Enum.CoreGuiType.Health, Enum.CoreGuiType.Backpack } do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(tipo, false)
	end)
end

-- Escala da interface acompanha o tamanho da tela
local function acompanharCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(UI.atualizarEscala)
	end
	UI.atualizarEscala()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(acompanharCamera)
acompanharCamera()

Ambiente.iniciar()
Sons.iniciar()
TexturasGeradas.iniciar()
Animacoes.iniciar()
VisualInimigos.iniciar()
Hud.iniciar()
Menus.iniciar()
Controles.iniciar()
Controles.ligarBotoes(Hud.botoesToque)

Vfx.extras.salto = VisualInimigos.salto
Vfx.extras.anim = Animacoes.receber
Vfx.aoJogadorAtingido = Animacoes.atingido
Vfx.aoDanoLocal = Hud.danoLocal

Hud.aoAbrir = function(nome: string)
	if nome == "classe" then
		Menus.abrirClasses()
	elseif nome == "loja" then
		Menus.abrirLoja()
	elseif nome == "teclas" then
		Menus.abrirTeclas()
	else
		Menus.abrirAjuda()
	end
end

local mostrouClasses = false
local teclasCarregadas = false

local function voltarAoLobby()
	Vfx.limparFase2()
	Estado.modo = "lobby"
	Estado.stats = nil
	Estado.cartas = {}
	Estado.aliados = {}
	Estado.caido = false
	Estado.morto = false
	Estado.carga = 0
	Estado.habilidadeFim = 0
	Ambiente.lobby()
	Ambiente.caido(false)
	Menus.fecharPartida()
	Hud.modo("lobby")
end

local manipuladores = {
	perfil = function(dados)
		Estado.perfil = dados
		-- as teclas salvas só são lidas uma vez (depois o próprio jogador é quem muda)
		if not teclasCarregadas then
			teclasCarregadas = true
			Atalhos.carregar(dados.teclas)
		end
		Estado.avisar("perfil")
		if not dados.escolheuClasse and not mostrouClasses and Estado.modo == "lobby" then
			mostrouClasses = true
			task.delay(1, Menus.abrirClasses)
		end
	end,
	lobby = voltarAoLobby,
	fila = Hud.fila,
	inicioPartida = function(dados)
		Estado.modo = "partida"
		Estado.aliados = dados.aliados or {}
		Estado.cartas = {}
		Estado.ouroPartida = 0
		Estado.carga = 0
		Estado.caido = false
		Estado.morto = false
		Menus.fecharLobby()
		Hud.modo("partida")
		Estado.avisar("ouro")
		Estado.avisar("cartas")
	end,
	transicao = function()
		Hud.transicao(true)
	end,
	sala = function(dados)
		Vfx.limparFase2() -- a cor da 2ª fase do chefe não passa para a próxima sala
		Estado.sala = dados
		Ambiente.masmorra(dados.tema)
		Hud.sala(dados)
		Hud.transicao(false)
	end,
	stats = function(dados)
		Estado.stats = dados
		Estado.carga = dados.carga or Estado.carga
		Estado.cargaMax = dados.cargaMax or Estado.cargaMax
		Estado.mana = dados.mana or 0
		Estado.manaMax = dados.manaMax or 0
		Estado.avisar("stats")
	end,
	mana = function(dados)
		Estado.mana = dados.valor
		Estado.manaMax = dados.max
	end,
	semMana = function()
		Estado.avisar("semMana")
	end,
	carga = function(dados)
		Estado.carga = dados.valor
		Estado.cargaMax = dados.max
		Estado.avisar("carga")
	end,
	recarga = function(dados)
		if dados.tipo == "habilidade" then
			Estado.habilidadeFim = os.clock() + dados.restante
			Estado.habilidadeTotal = dados.total
		end
	end,
	ouro = function(dados)
		Estado.ouroPartida = dados.total
		Estado.avisar("ouro")
		Hud.ganhouOuro(dados.ganho)
	end,
	banner = function(dados)
		Hud.banner(dados.texto, dados.cor)
	end,
	aviso = function(dados)
		Hud.aviso(dados.texto)
	end,
	introChefe = Hud.introChefe,
	cartas = Menus.cartas,
	cartasFechar = Menus.fecharCartas,
	minhasCartas = function(dados)
		Estado.cartas = dados.cartas or {}
		Estado.avisar("cartas")
		Menus.cartaEscolhida()
	end,
	elevador = Menus.elevador,
	caiu = function()
		Estado.caido = true
		Controles.pararAtaque()
		Hud.caiu()
		Ambiente.caido(true)
	end,
	levantou = function()
		Estado.caido = false
		Hud.levantou()
		Ambiente.caido(false)
	end,
	morreu = function()
		Estado.morto = true
		Estado.caido = false
		Controles.pararAtaque()
		Ambiente.caido(false)
		Hud.morreu()
	end,
	reviveu = function()
		Estado.morto = false
		Estado.caido = false
		Ambiente.caido(false)
		Hud.reviveu()
	end,
	fimPartida = Menus.fim,
	abrirLoja = Menus.abrirLoja,
	vfx = Vfx.receber,
}

Evento.OnClientEvent:Connect(function(tipo: string, dados)
	local manipulador = manipuladores[tipo]
	if manipulador then
		manipulador(dados or {})
	end
end)

-- Ao renascer, a câmera volta para o próprio personagem
jogador.CharacterAdded:Connect(function(personagem)
	local humanoid = personagem:WaitForChild("Humanoid", 10)
	if humanoid then
		workspace.CurrentCamera.CameraSubject = humanoid
	end
end)

Hud.modo("lobby")
Acao:FireServer("pronto")
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000036">
          <Properties>
            <string name="Name">Menus</string>
            <ProtectedString name="Source"><![CDATA[-- Menus: escolha de classe, cartas, elevador, loja do mercador, resumo da partida, ajuda e
-- troca de teclas.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local Cartas = require(Shared:WaitForChild("Cartas"))
local Teclas = require(Shared:WaitForChild("Teclas"))

local modulos = script.Parent
local UI = require(modulos.UI)
local Estado = require(modulos.Estado)
local Atalhos = require(modulos.Atalhos)

local Menus = {}

local jogador = Players.LocalPlayer
local Acao = ReplicatedStorage:WaitForChild("Remotos"):WaitForChild("Acao") :: RemoteEvent
local criar, animar, cores, fontes = UI.criar, UI.animar, UI.cores, UI.fontes

local gui = criar("ScreenGui", {
	Name = "Menus",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 10,
	Parent = jogador:WaitForChild("PlayerGui"),
})

local gradientesGirando = {} -- bordas brilhantes das cartas épicas e lendárias

------------------------------------------------------------------------
-- Abrir e fechar
------------------------------------------------------------------------

local abertos = {}

local function novoMenu(nome: string, largura: number, altura: number)
	local fundo = criar("Frame", {
		Name = nome,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = cores.preto,
		BackgroundTransparency = 0.35,
		Visible = false,
		Parent = gui,
	})
	local conteudo = criar("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(largura, altura),
		BackgroundTransparency = 1,
		Parent = fundo,
	})
	local escala = UI.escalavel(conteudo)
	return { fundo = fundo, conteudo = conteudo, escala = escala }
end

local function abrir(menu)
	if abertos[menu] then
		return
	end
	abertos[menu] = true
	Estado.menusAbertos += 1
	UI.desfocar(true)
	menu.fundo.Visible = true
	menu.fundo.BackgroundTransparency = 1
	animar(menu.fundo, 0.25, { BackgroundTransparency = 0.35 })
	menu.escala.Scale = UI.escalaAtual * 0.9
	animar(menu.escala, 0.3, { Scale = UI.escalaAtual }, Enum.EasingStyle.Back)
end

local function fechar(menu)
	if not abertos[menu] then
		return
	end
	abertos[menu] = nil
	Estado.menusAbertos = math.max(0, Estado.menusAbertos - 1)
	UI.desfocar(false)
	menu.fundo.Visible = false
end

local function botaoFechar(menu)
	local b = UI.botao({
		Parent = menu.conteudo,
		Texto = "✕",
		Estilo = "perigo",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(48, 48),
	})
	b.ZIndex = 10
	b.Activated:Connect(function()
		fechar(menu)
	end)
end

-- Pontinhos de 1 a 5 (força de um atributo)
local function pontos(pai: Instance, posicao: UDim2, valor: number, cor: Color3)
	local linha = criar("Frame", { Position = posicao, Size = UDim2.fromOffset(120, 14), BackgroundTransparency = 1, Parent = pai })
	criar("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), Parent = linha })
	for i = 1, 5 do
		local p = criar("Frame", {
			Size = UDim2.fromOffset(20, 12),
			BackgroundColor3 = if i <= valor then cor else Color3.fromRGB(46, 40, 58),
			BorderSizePixel = 0,
			Parent = linha,
		})
		UI.cantos(p, 3)
		UI.borda(p, cores.preto, 1, 0.4)
	end
end

------------------------------------------------------------------------
-- Escolha de classe
------------------------------------------------------------------------

local menuClasses = novoMenu("Classes", 1220, 690)
botaoFechar(menuClasses)
UI.titulo(menuClasses.conteudo, "ESCOLHA SUA CLASSE", 0, 620, 58)
UI.texto({
	Position = UDim2.fromOffset(0, 72),
	Size = UDim2.new(1, 0, 0, 22),
	FontFace = fontes.texto,
	Text = "Você pode trocar quando quiser nos altares do acampamento",
	TextColor3 = cores.textoSuave,
	Parent = menuClasses.conteudo,
})
local linhaClasses = criar("Frame", { Position = UDim2.fromOffset(0, 106), Size = UDim2.new(1, 0, 0, 570), BackgroundTransparency = 1, Parent = menuClasses.conteudo })
criar("UIListLayout", {
	FillDirection = Enum.FillDirection.Horizontal,
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 14),
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = linhaClasses,
})

local botoesClasse = {}
local rotulosTeclaClasse = {} -- nome da habilidade/supremo com a tecla escolhida
for ordem, id in Classes.ordem do
	local classe = Classes.dados[id]
	local cartao = UI.painel({ Size = UDim2.fromOffset(286, 566), LayoutOrder = ordem, Parent = linhaClasses })
	local zoom = criar("UIScale", { Parent = cartao })
	local cabecalho = criar("Frame", {
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 0, 130),
		BackgroundColor3 = cores.branco,
		Parent = cartao,
	})
	UI.cantos(cabecalho, 8)
	UI.gradiente(cabecalho, classe.cor, classe.cor:Lerp(cores.fundo, 0.75))
	UI.medalhao({ Parent = cabecalho, Icone = classe.icone, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(96, 96), Cor = classe.cor, EspessuraBorda = 3 })
	local nome = UI.texto({ Position = UDim2.fromOffset(0, 144), Size = UDim2.new(1, 0, 0, 32), FontFace = fontes.cabecalho, Text = classe.nome, TextColor3 = classe.cor:Lerp(cores.branco, 0.35), Parent = cartao })
	UI.contorno(nome, 2)
	UI.texto({ Position = UDim2.fromOffset(0, 176), Size = UDim2.new(1, 0, 0, 18), FontFace = fontes.texto, Text = classe.titulo, TextColor3 = cores.ouro, Parent = cartao })
	local descricao = UI.texto({
		Position = UDim2.fromOffset(16, 198),
		Size = UDim2.new(1, -32, 0, 44),
		FontFace = fontes.texto,
		Text = classe.descricao,
		TextColor3 = cores.texto,
		TextWrapped = true,
		Parent = cartao,
	})
	UI.limiteTexto(descricao, 15)
	-- pontos fortes e fracos
	for i, info in { { "✔ " .. (classe.forte or ""), Color3.fromRGB(130, 230, 140) }, { "✘ " .. (classe.fraco or ""), Color3.fromRGB(255, 120, 120) } } do
		local linha = UI.texto({
			Position = UDim2.fromOffset(16, 244 + (i - 1) * 32),
			Size = UDim2.new(1, -32, 0, 30),
			FontFace = fontes.forte,
			Text = info[1],
			TextColor3 = info[2],
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cartao,
		})
		UI.limiteTexto(linha, 13)
	end
	local y = 314
	for _, atributo in { "Vida", "Dano", "Alcance", "Velocidade" } do
		UI.texto({
			Position = UDim2.fromOffset(20, y),
			Size = UDim2.fromOffset(120, 18),
			FontFace = fontes.forte,
			Text = atributo,
			TextColor3 = cores.textoSuave,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cartao,
		})
		pontos(cartao, UDim2.fromOffset(146, y + 3), classe.notas[atributo], classe.cor)
		y += 22
	end
	for i, info in { { classe.habilidade, "habilidade" }, { classe.supremo, "supremo" } } do
		local linhaY = 408 + (i - 1) * 52
		UI.medalhao({ Parent = cartao, Icone = info[1].icone, Position = UDim2.fromOffset(14, linhaY), Size = UDim2.fromOffset(40, 40), Cor = classe.cor })
		local rotuloHabilidade = UI.texto({
			Position = UDim2.fromOffset(60, linhaY),
			Size = UDim2.new(1, -70, 0, 18),
			FontFace = fontes.forte,
			Text = info[1].nome,
			TextColor3 = cores.ouroClaro,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cartao,
		})
		table.insert(rotulosTeclaClasse, { rotulo = rotuloHabilidade, nome = info[1].nome, acao = info[2] })
		local d = UI.texto({
			Position = UDim2.fromOffset(60, linhaY + 18),
			Size = UDim2.new(1, -70, 0, 30),
			FontFace = fontes.texto,
			Text = info[1].descricao,
			TextColor3 = cores.textoSuave,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cartao,
		})
		UI.limiteTexto(d, 12)
	end
	local botao = UI.botao({
		Parent = cartao,
		Texto = "ESCOLHER",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(230, 42),
	})
	botao.Activated:Connect(function()
		if Estado.perfil.classe ~= id or not Estado.perfil.escolheuClasse then
			Acao:FireServer("escolherClasse", id)
		end
		fechar(menuClasses)
	end)
	cartao.MouseEnter:Connect(function()
		animar(zoom, 0.15, { Scale = 1.03 })
	end)
	cartao.MouseLeave:Connect(function()
		animar(zoom, 0.15, { Scale = 1 })
	end)
	botoesClasse[id] = botao
end

local function atualizarClasses()
	for _, info in rotulosTeclaClasse do
		info.rotulo.Text = info.nome .. "  [" .. Teclas.curto(Atalhos.principal(info.acao)) .. "]"
	end
	for id, botao in botoesClasse do
		local selecionada = Estado.perfil.classe == id and Estado.perfil.escolheuClasse
		UI.textoBotao(botao, if selecionada then "SELECIONADA ✓" else "ESCOLHER")
		UI.estiloBotao(botao, if selecionada then "verde" else "ouro")
	end
end

function Menus.abrirClasses()
	if Estado.modo ~= "lobby" then
		return
	end
	atualizarClasses()
	abrir(menuClasses)
end

------------------------------------------------------------------------
-- Cartas
------------------------------------------------------------------------

local menuCartas = novoMenu("Cartas", 1040, 560)
UI.titulo(menuCartas.conteudo, "ESCOLHA UMA CARTA", 0, 600, 56)
local tempoCartas = UI.texto({
	Position = UDim2.fromOffset(0, 72),
	Size = UDim2.new(1, 0, 0, 24),
	FontFace = fontes.forte,
	Text = "",
	TextColor3 = cores.textoSuave,
	Parent = menuCartas.conteudo,
})
local linhaCartas = criar("Frame", { Position = UDim2.fromOffset(0, 120), Size = UDim2.new(1, 0, 0, 420), BackgroundTransparency = 1, Parent = menuCartas.conteudo })
criar("UIListLayout", {
	FillDirection = Enum.FillDirection.Horizontal,
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 30),
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = linhaCartas,
})

local escolhaFeita = false
local idCartas = 0

local function criarCarta(id: string, indice: number)
	local carta = Cartas.porId[id]
	if not carta then
		return
	end
	local raridade = Config.RARIDADES[carta.raridade]
	local classe = carta.classe and Classes.dados[carta.classe]
	local botao = criar("TextButton", {
		Size = UDim2.fromOffset(280, 410),
		BackgroundColor3 = cores.branco,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = indice,
		Parent = linhaCartas,
	})
	UI.cantos(botao, 14)
	UI.gradiente(botao, raridade.cor:Lerp(cores.fundo, 0.55), cores.fundo)
	local contorno = UI.borda(botao, raridade.cor, 3)
	if carta.raridade == "Epica" or carta.raridade == "Lendaria" then
		local brilho = criar("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, raridade.cor),
				ColorSequenceKeypoint.new(0.5, cores.branco),
				ColorSequenceKeypoint.new(1, raridade.cor),
			}),
			Parent = contorno,
		})
		contorno.Thickness = 4
		table.insert(gradientesGirando, brilho)
	end
	local zoom = criar("UIScale", { Scale = 0, Parent = botao })

	-- Etiqueta da classe
	local etiqueta = criar("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(150, 26),
		BackgroundColor3 = if classe then classe.cor:Lerp(cores.fundo, 0.3) else cores.bronze,
		ZIndex = 3,
		Parent = botao,
	})
	UI.cantos(etiqueta, 13)
	UI.borda(etiqueta, cores.preto, 1.5, 0.2)
	local textoEtiqueta = UI.texto({
		Size = UDim2.fromScale(1, 1),
		FontFace = fontes.numero,
		Text = if classe then string.upper(classe.nome) else "UNIVERSAL",
		ZIndex = 4,
		Parent = etiqueta,
	})
	UI.limiteTexto(textoEtiqueta, 15)

	local rotuloRaridade = UI.texto({ Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 22), FontFace = fontes.cabecalho, Text = raridade.nome, TextColor3 = raridade.cor, Parent = botao })
	UI.contorno(rotuloRaridade, 1.5)
	UI.medalhao({
		Parent = botao,
		Icone = carta.icone,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(124, 124),
		Cor = raridade.cor,
		Borda = raridade.cor:Lerp(cores.branco, 0.3),
		EspessuraBorda = 3,
	})
	local nome = UI.texto({ Position = UDim2.fromOffset(12, 196), Size = UDim2.new(1, -24, 0, 34), FontFace = fontes.cabecalho, Text = carta.nome, Parent = botao })
	UI.contorno(nome, 2)
	UI.separador(botao, UDim2.new(0.5, 0, 0, 240), 200, raridade.cor)
	local descricao = UI.texto({
		Position = UDim2.fromOffset(18, 254),
		Size = UDim2.new(1, -36, 0, 96),
		FontFace = fontes.forte,
		Text = carta.descricao,
		TextColor3 = cores.texto,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = botao,
	})
	UI.limiteTexto(descricao, 21)
	local tenho = Estado.cartas[id] or 0
	if tenho > 0 then
		UI.texto({
			Position = UDim2.new(0, 12, 1, -38),
			Size = UDim2.new(1, -24, 0, 22),
			FontFace = fontes.forte,
			Text = "Você já tem: " .. tenho .. " de " .. carta.maxPilha,
			TextColor3 = cores.ouro,
			Parent = botao,
		})
	end

	-- entrada em sequência
	task.delay((indice - 1) * 0.09, function()
		animar(zoom, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	botao.MouseEnter:Connect(function()
		if not escolhaFeita then
			animar(zoom, 0.12, { Scale = 1.06 })
		end
	end)
	botao.MouseLeave:Connect(function()
		if not escolhaFeita then
			animar(zoom, 0.12, { Scale = 1 })
		end
	end)
	botao.Activated:Connect(function()
		if escolhaFeita then
			return
		end
		escolhaFeita = true
		UI.tocar(UI.SONS.carta, 0.5)
		Acao:FireServer("escolherCarta", indice)
		for _, outro in linhaCartas:GetChildren() do
			if outro:IsA("TextButton") and outro ~= botao then
				local escala = outro:FindFirstChildOfClass("UIScale")
				if escala then
					animar(escala, 0.2, { Scale = 0 })
				end
			end
		end
		animar(zoom, 0.2, { Scale = 1.12 }, Enum.EasingStyle.Back)
		tempoCartas.Text = "Esperando os outros jogadores..."
	end)
end

function Menus.cartas(dados)
	idCartas += 1
	local meu = idCartas
	escolhaFeita = false
	table.clear(gradientesGirando)
	for _, filho in linhaCartas:GetChildren() do
		if filho:IsA("TextButton") then
			filho:Destroy()
		end
	end
	for indice, id in dados.opcoes do
		criarCarta(id, indice)
	end
	abrir(menuCartas)
	local fim = os.clock() + (dados.tempo or 20)
	task.spawn(function()
		while idCartas == meu and abertos[menuCartas] do
			if not escolhaFeita then
				tempoCartas.Text = "⏳ " .. math.max(0, math.ceil(fim - os.clock())) .. "s para escolher"
			end
			task.wait(0.2)
		end
	end)
end

function Menus.fecharCartas()
	fechar(menuCartas)
end

-- O servidor confirmou a carta: fecha logo para o jogador voltar a se mexer
function Menus.cartaEscolhida()
	if escolhaFeita then
		task.delay(0.35, function()
			fechar(menuCartas)
		end)
	end
end

------------------------------------------------------------------------
-- Elevador
------------------------------------------------------------------------

local menuElevador = novoMenu("Elevador", 920, 460)
local painelElevador = UI.painel({ Size = UDim2.fromScale(1, 1), Parent = menuElevador.conteudo })
UI.titulo(painelElevador, "O CHEFE CAIU", 18, 500, 52)
UI.texto({ Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 26), FontFace = fontes.cabecalho, Text = "Para onde agora?", TextColor3 = cores.texto, Parent = painelElevador })

local function opcaoElevador(estilo: string, x: number, icone: string, titulo: string)
	local botao = UI.botao({ Parent = painelElevador, Estilo = estilo, Position = UDim2.fromOffset(x, 130), Size = UDim2.fromOffset(400, 230) })
	local rotulo = botao:FindFirstChild("Rotulo") :: TextLabel
	rotulo.Visible = false
	UI.texto({ Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 70), Text = icone, Parent = botao })
	local t = UI.texto({ Position = UDim2.fromOffset(0, 92), Size = UDim2.new(1, 0, 0, 44), FontFace = fontes.titulo, Text = titulo, TextColor3 = if estilo == "ouro" then Color3.fromRGB(46, 28, 8) else cores.texto, Parent = botao })
	if estilo ~= "ouro" then
		UI.contorno(t, 2)
	end
	local detalhe = UI.texto({
		Position = UDim2.fromOffset(20, 142),
		Size = UDim2.new(1, -40, 0, 70),
		FontFace = fontes.forte,
		Text = "",
		TextColor3 = if estilo == "ouro" then Color3.fromRGB(60, 36, 10) else cores.texto,
		TextWrapped = true,
		Parent = botao,
	})
	UI.limiteTexto(detalhe, 22)
	return botao, detalhe
end

local botaoSubir, detalheSubir = opcaoElevador("ouro", 40, "⬆️", "SUBIR")
local botaoDescer, detalheDescer = opcaoElevador("perigo", 480, "⬇️", "DESCER")
local barraTempo = UI.barra({
	Parent = painelElevador,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 384),
	Size = UDim2.fromOffset(840, 16),
	Cor = cores.ouro,
	Raio = 5,
})
local avisoElevador = UI.texto({
	Position = UDim2.fromOffset(0, 408),
	Size = UDim2.new(1, 0, 0, 22),
	FontFace = fontes.texto,
	Text = "",
	TextColor3 = Color3.fromRGB(255, 170, 160),
	Parent = painelElevador,
})

local function responderElevador(escolha: string)
	if abertos[menuElevador] then
		fechar(menuElevador)
		Acao:FireServer("elevador", escolha)
	end
end
botaoSubir.Activated:Connect(function()
	responderElevador("sair")
end)
botaoDescer.Activated:Connect(function()
	responderElevador("continuar")
end)

local idElevador = 0
function Menus.elevador(dados)
	idElevador += 1
	local meu = idElevador
	fechar(menuCartas)
	detalheSubir.Text = "Volte ao acampamento e guarde 💰 " .. dados.ouro
	detalheDescer.Text = "Siga para a sala " .. dados.proximaSala .. ": inimigos mais fortes e mais ouro"
	avisoElevador.Text = "Se cair lá embaixo, você fica com só " .. math.floor(Config.OURO_MANTIDO_AO_MORRER * 100) .. "% do ouro. Sem resposta, você sobe."
	abrir(menuElevador)
	local total = dados.tempo or 25
	local fim = os.clock() + total
	task.spawn(function()
		while idElevador == meu and abertos[menuElevador] do
			local restante = math.max(0, fim - os.clock())
			barraTempo.definir(restante / total, math.ceil(restante) .. "s")
			task.wait(0.1)
		end
	end)
end

------------------------------------------------------------------------
-- Loja do mercador
------------------------------------------------------------------------

local menuLoja = novoMenu("Loja", 680, 560)
local painelLoja = UI.painel({ Size = UDim2.fromScale(1, 1), Parent = menuLoja.conteudo })
botaoFechar(menuLoja)
UI.titulo(painelLoja, "MERCADOR", 16, 400, 52)
local ouroLoja = UI.texto({ Position = UDim2.fromOffset(0, 84), Size = UDim2.new(1, 0, 0, 28), FontFace = fontes.numero, Text = "", TextColor3 = cores.ouroClaro, Parent = painelLoja })
UI.contorno(ouroLoja, 1.5)

local linhasLoja = {}
for i, melhoria in Config.MELHORIAS do
	local linha = criar("Frame", {
		Position = UDim2.fromOffset(28, 128 + (i - 1) * 132),
		Size = UDim2.new(1, -56, 0, 118),
		BackgroundColor3 = cores.branco,
		Parent = painelLoja,
	})
	UI.cantos(linha, 10)
	UI.gradiente(linha, cores.painelClaro, cores.fundo)
	UI.borda(linha, cores.bronze, 1.5)
	UI.medalhao({ Parent = linha, Icone = melhoria.icone, Position = UDim2.fromOffset(14, 20), Size = UDim2.fromOffset(78, 78), Cor = cores.painelClaro })
	local nome = UI.texto({
		Position = UDim2.fromOffset(106, 14),
		Size = UDim2.fromOffset(300, 30),
		FontFace = fontes.cabecalho,
		Text = melhoria.nome,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = linha,
	})
	UI.contorno(nome, 1.5)
	UI.texto({
		Position = UDim2.fromOffset(106, 46),
		Size = UDim2.fromOffset(300, 22),
		FontFace = fontes.texto,
		Text = melhoria.descricao,
		TextColor3 = cores.textoSuave,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = linha,
	})
	local niveis = criar("Frame", { Position = UDim2.fromOffset(110, 80), Size = UDim2.fromOffset(300, 16), BackgroundTransparency = 1, Parent = linha })
	criar("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), VerticalAlignment = Enum.VerticalAlignment.Center, Parent = niveis })
	local marcas = {}
	for n = 1, melhoria.nivelMax do
		local marca = criar("Frame", { Size = UDim2.fromOffset(12, 12), Rotation = 45, BackgroundColor3 = cores.bronze, BorderSizePixel = 0, LayoutOrder = n, Parent = niveis })
		UI.borda(marca, cores.preto, 1, 0.3)
		marcas[n] = marca
	end
	local comprar = UI.botao({ Parent = linha, Position = UDim2.new(1, -172, 0.5, -28), Size = UDim2.fromOffset(156, 56) })
	comprar.Activated:Connect(function()
		Acao:FireServer("comprarMelhoria", melhoria.id)
	end)
	linhasLoja[melhoria.id] = { melhoria = melhoria, botao = comprar, marcas = marcas }
end

local function atualizarLoja()
	local perfil = Estado.perfil
	ouroLoja.Text = "Seu ouro: 💰 " .. (perfil.ouro or 0)
	for id, linha in linhasLoja do
		local nivel = (perfil.melhorias and perfil.melhorias[id]) or 0
		for n, marca in linha.marcas do
			marca.BackgroundColor3 = if n <= nivel then cores.ouro else Color3.fromRGB(56, 48, 66)
		end
		if nivel >= linha.melhoria.nivelMax then
			UI.textoBotao(linha.botao, "MÁXIMO")
			UI.estiloBotao(linha.botao, "cinza")
		else
			local preco = Config.precoMelhoria(linha.melhoria, nivel)
			UI.textoBotao(linha.botao, "💰 " .. preco)
			UI.estiloBotao(linha.botao, if (perfil.ouro or 0) >= preco then "ouro" else "cinza")
		end
	end
end

function Menus.abrirLoja()
	if Estado.modo ~= "lobby" then
		return
	end
	atualizarLoja()
	abrir(menuLoja)
end

------------------------------------------------------------------------
-- Resumo da partida
------------------------------------------------------------------------

local menuFim = novoMenu("Fim", 780, 560)
local painelFim = UI.painel({ Size = UDim2.fromScale(1, 1), Parent = menuFim.conteudo })
local tituloFim = UI.titulo(painelFim, "", 18, 640, 56)
local fitaRecorde = criar("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 92),
	Size = UDim2.fromOffset(300, 34),
	BackgroundColor3 = cores.sucesso,
	Visible = false,
	Parent = painelFim,
})
UI.cantos(fitaRecorde, 17)
UI.borda(fitaRecorde, cores.preto, 2, 0.2)
local textoFita = UI.texto({ Size = UDim2.fromScale(1, 1), FontFace = fontes.numero, Text = "🏆 NOVO RECORDE!", Parent = fitaRecorde })
UI.contorno(textoFita, 1.5)

local quadrosFim = {}
for i, rotulo in { "Sala alcançada", "Inimigos derrotados", "Dano causado", "Ouro guardado" } do
	local coluna = (i - 1) % 2
	local linha = (i - 1) // 2
	local quadro = criar("Frame", {
		Position = UDim2.fromOffset(40 + coluna * 360, 140 + linha * 100),
		Size = UDim2.fromOffset(340, 88),
		BackgroundColor3 = cores.branco,
		Parent = painelFim,
	})
	UI.cantos(quadro, 10)
	UI.gradiente(quadro, cores.painelClaro, cores.fundo)
	UI.borda(quadro, cores.bronze, 1.5)
	UI.texto({ Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 20), FontFace = fontes.forte, Text = rotulo, TextColor3 = cores.textoSuave, TextXAlignment = Enum.TextXAlignment.Left, Parent = quadro })
	local valor = UI.texto({
		Position = UDim2.fromOffset(16, 34),
		Size = UDim2.new(1, -32, 0, 44),
		FontFace = fontes.numero,
		Text = "",
		TextColor3 = if i == 4 then cores.ouroClaro else cores.texto,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = quadro,
	})
	UI.contorno(valor, 1.5)
	quadrosFim[i] = valor
end
local cartasFim = criar("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 350),
	Size = UDim2.fromOffset(700, 100),
	BackgroundTransparency = 1,
	Parent = painelFim,
})
criar("UIGridLayout", {
	CellSize = UDim2.fromOffset(44, 44),
	CellPadding = UDim2.fromOffset(8, 8),
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = cartasFim,
})
local botaoVoltar = UI.botao({
	Parent = painelFim,
	Texto = "VOLTAR AO ACAMPAMENTO",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -22),
	Size = UDim2.fromOffset(360, 56),
})
botaoVoltar.Activated:Connect(function()
	fechar(menuFim)
end)

local function formatarNumero(n: number): string
	local texto = tostring(math.floor(n))
	local resultado = texto:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if resultado:sub(1, 1) == "." then
		resultado = resultado:sub(2)
	end
	return resultado
end

function Menus.fim(dados)
	fechar(menuCartas)
	fechar(menuElevador)
	local escapou = dados.motivo == "saiu"
	tituloFim.Text = if escapou then "VOCÊ ESCAPOU COM VIDA" else "VOCÊ CAIU NA MASMORRA"
	tituloFim.TextColor3 = if escapou then cores.ouroClaro else Color3.fromRGB(255, 110, 100)
	fitaRecorde.Visible = dados.novoRecorde == true
	quadrosFim[1].Text = "Sala " .. dados.sala
	quadrosFim[2].Text = tostring(dados.abates or 0)
	quadrosFim[3].Text = formatarNumero(dados.dano or 0)
	quadrosFim[4].Text = "💰 " .. dados.ganho .. (if escapou then "" else "  (de " .. dados.ouroPartida .. ")")
	for _, filho in cartasFim:GetChildren() do
		if filho:IsA("Frame") then
			filho:Destroy()
		end
	end
	for ordem, carta in Cartas.lista do
		if (dados.cartas and dados.cartas[carta.id] or 0) > 0 then
			UI.medalhao({ Parent = cartasFim, Icone = carta.icone, Cor = cores.painelClaro, Borda = Config.RARIDADES[carta.raridade].cor, LayoutOrder = ordem })
		end
	end
	abrir(menuFim)
end

------------------------------------------------------------------------
-- Como jogar
------------------------------------------------------------------------

local menuAjuda = novoMenu("Ajuda", 820, 580)
local painelAjuda = UI.painel({ Size = UDim2.fromScale(1, 1), Parent = menuAjuda.conteudo })
botaoFechar(menuAjuda)
UI.titulo(painelAjuda, "COMO JOGAR", 16, 420, 52)
local secoes = {
	{ "🎮", "Controles", "Ataque (segure e solte: golpe carregado), habilidade, esquiva, supremo e o escudo do Cavaleiro.\nVeja e troque as teclas em ⚙️ TECLAS. No celular, use os botões redondos." },
	{ "⚔️", "Combo", "Todo terceiro ataque é um golpe final mais forte. A barra dourada enche lutando: com ela cheia, use o supremo!" },
	{ "💨", "Esquiva", "Durante a esquiva você não leva dano e atravessa projéteis. Fuja das áreas vermelhas no chão!" },
	{ "🃏", "Cartas", "Depois de cada sala, escolha 1 de 3 cartas. Cada classe tem cartas próprias, e algumas combinam muito bem." },
	{ "❤️", "Reviver", "Aliado caído? Fique perto dele por alguns segundos para levantá-lo." },
	{ "👑", "Chefes", "A cada 5 salas vem um chefe. Depois dele: suba com todo o ouro, ou desça para ganhar mais." },
}
for i, secao in secoes do
	local y = 96 + (i - 1) * 76
	UI.medalhao({ Parent = painelAjuda, Icone = secao[1], Position = UDim2.fromOffset(32, y), Size = UDim2.fromOffset(56, 56), Cor = cores.painelClaro })
	UI.texto({
		Position = UDim2.fromOffset(104, y),
		Size = UDim2.fromOffset(680, 22),
		FontFace = fontes.cabecalho,
		Text = secao[2],
		TextColor3 = cores.ouroClaro,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = painelAjuda,
	})
	local texto = UI.texto({
		Position = UDim2.fromOffset(104, y + 24),
		Size = UDim2.fromOffset(680, 40),
		FontFace = fontes.texto,
		Text = secao[3],
		TextColor3 = cores.texto,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = painelAjuda,
	})
	UI.limiteTexto(texto, 17)
end

function Menus.abrirAjuda()
	abrir(menuAjuda)
end

------------------------------------------------------------------------
-- Teclas: escolha a tecla de cada ação
------------------------------------------------------------------------

local menuTeclas = novoMenu("Teclas", 780, 640)
local painelTeclas = UI.painel({ Size = UDim2.fromScale(1, 1), Parent = menuTeclas.conteudo })
botaoFechar(menuTeclas)
UI.titulo(painelTeclas, "⚙️ TECLAS", 16, 380, 52)
local instrucaoTeclas = UI.texto({
	Position = UDim2.fromOffset(30, 76),
	Size = UDim2.new(1, -60, 0, 22),
	FontFace = fontes.texto,
	Text = "Clique numa tecla e aperte a nova (vale tecla ou botão do mouse).",
	TextColor3 = cores.textoSuave,
	Parent = painelTeclas,
})
UI.limiteTexto(instrucaoTeclas, 17)
for _, cabecalho in { { "PRINCIPAL", 400 }, { "ALTERNATIVA", 580 } } do
	UI.texto({
		Position = UDim2.fromOffset(cabecalho[2], 108),
		Size = UDim2.fromOffset(170, 18),
		FontFace = fontes.cabecalho,
		Text = cabecalho[1],
		TextColor3 = cores.ouro,
		Parent = painelTeclas,
	})
end

local esperandoTecla = nil -- { id, slot } enquanto espera o jogador apertar a nova tecla
local botoesTecla = {} -- [id] = { [1] = botão, [2] = botão }

local function atualizarMenuTeclas()
	for id, botoes in botoesTecla do
		for slot = 1, 2 do
			local nome = Atalhos.atual[id][slot]
			local esperando = esperandoTecla ~= nil and esperandoTecla.id == id and esperandoTecla.slot == slot
			UI.textoBotao(botoes[slot], if esperando then "Aperte..." elseif nome then Teclas.texto(nome) else "—")
			UI.estiloBotao(botoes[slot], if esperando then "verde" elseif nome then "escuro" else "cinza")
		end
	end
end

local function avisoTeclas(texto: string, cor: Color3?)
	instrucaoTeclas.Text = texto
	instrucaoTeclas.TextColor3 = cor or cores.textoSuave
end

for i, acao in Teclas.ACOES do
	local y = 134 + (i - 1) * 72
	UI.medalhao({ Parent = painelTeclas, Icone = acao.icone, Position = UDim2.fromOffset(28, y), Size = UDim2.fromOffset(54, 54), Cor = cores.painelClaro })
	UI.texto({
		Position = UDim2.fromOffset(96, y + 4),
		Size = UDim2.fromOffset(290, 24),
		FontFace = fontes.cabecalho,
		Text = acao.nome,
		TextColor3 = cores.ouroClaro,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = painelTeclas,
	})
	local detalhe = UI.texto({
		Position = UDim2.fromOffset(96, y + 30),
		Size = UDim2.fromOffset(290, 20),
		FontFace = fontes.texto,
		Text = acao.detalhe,
		TextColor3 = cores.textoSuave,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = painelTeclas,
	})
	UI.limiteTexto(detalhe, 14)
	botoesTecla[acao.id] = {}
	for slot = 1, 2 do
		local botao = UI.botao({
			Parent = painelTeclas,
			Texto = "",
			Estilo = "escuro",
			Position = UDim2.fromOffset(if slot == 1 then 395 else 575, y + 4),
			Size = UDim2.fromOffset(170, 46),
			TamanhoTexto = 20,
		})
		botao.Activated:Connect(function()
			-- clicar de novo no mesmo botão desiste
			if esperandoTecla and esperandoTecla.id == acao.id and esperandoTecla.slot == slot then
				esperandoTecla = nil
				avisoTeclas("Clique numa tecla e aperte a nova (vale tecla ou botão do mouse).")
			else
				esperandoTecla = { id = acao.id, slot = slot }
				avisoTeclas("Aperte a nova tecla para " .. acao.nome .. ".  Apagar (Backspace) deixa vazio  •  clique de novo para desistir", cores.ouroClaro)
			end
			atualizarMenuTeclas()
		end)
		botoesTecla[acao.id][slot] = botao
	end
end

UI.texto({
	Position = UDim2.fromOffset(30, 498),
	Size = UDim2.new(1, -60, 0, 40),
	FontFace = fontes.texto,
	Text = "🎮 Controle: R2 atacar  •  X habilidade  •  B esquiva  •  Y supremo  •  L2 escudo\nW A S D, Espaço, Esc e Tab ficam para andar, pular e os menus do Roblox.",
	TextColor3 = cores.textoSuave,
	TextWrapped = true,
	Parent = painelTeclas,
})
local botaoPadrao = UI.botao({
	Parent = painelTeclas,
	Texto = "RESTAURAR PADRÃO",
	Estilo = "escuro",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(0.5, -10, 1, -18),
	Size = UDim2.fromOffset(250, 50),
	TamanhoTexto = 20,
})
botaoPadrao.Activated:Connect(function()
	esperandoTecla = nil
	Atalhos.restaurarPadrao()
	avisoTeclas("Teclas voltaram ao padrão.", cores.ouroClaro)
	atualizarMenuTeclas()
end)
local botaoProntoTeclas = UI.botao({
	Parent = painelTeclas,
	Texto = "PRONTO",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0.5, 10, 1, -18),
	Size = UDim2.fromOffset(250, 50),
	TamanhoTexto = 22,
})
botaoProntoTeclas.Activated:Connect(function()
	esperandoTecla = nil
	fechar(menuTeclas)
end)

-- Captura da nova tecla
UserInputService.InputBegan:Connect(function(entrada, processado)
	if not esperandoTecla or not abertos[menuTeclas] then
		return
	end
	local tipo = entrada.UserInputType
	local nome = nil
	if tipo == Enum.UserInputType.Keyboard then
		if entrada.KeyCode == Enum.KeyCode.Escape then
			esperandoTecla = nil
			avisoTeclas("Clique numa tecla e aperte a nova (vale tecla ou botão do mouse).")
			atualizarMenuTeclas()
			return
		elseif entrada.KeyCode == Enum.KeyCode.Backspace or entrada.KeyCode == Enum.KeyCode.Delete then
			Atalhos.limpar(esperandoTecla.id, esperandoTecla.slot)
			esperandoTecla = nil
			avisoTeclas("Tecla removida.", cores.ouroClaro)
			atualizarMenuTeclas()
			return
		elseif processado then
			return -- digitando no chat
		end
		nome = entrada.KeyCode.Name
	elseif tipo == Enum.UserInputType.MouseButton1 then
		-- clique em cima de um botão do menu é clique no menu, não a tecla nova
		if processado then
			return
		end
		nome = tipo.Name
	elseif tipo == Enum.UserInputType.MouseButton2 or tipo == Enum.UserInputType.MouseButton3 then
		nome = tipo.Name
	else
		return
	end
	local id, slot = esperandoTecla.id, esperandoTecla.slot
	local ok, mensagem = Atalhos.definir(id, slot, nome)
	if ok then
		esperandoTecla = nil
		avisoTeclas("✔ " .. Teclas.acoesPorId[id].nome .. ": " .. Teclas.texto(nome) .. (if mensagem then "   (" .. mensagem .. ")" else ""), Color3.fromRGB(130, 230, 140))
	else
		avisoTeclas("✘ " .. (mensagem or "Essa tecla não pode ser usada.") .. " Tente outra.", Color3.fromRGB(255, 120, 120))
	end
	atualizarMenuTeclas()
end)

function Menus.abrirTeclas()
	esperandoTecla = nil
	avisoTeclas("Clique numa tecla e aperte a nova (vale tecla ou botão do mouse).")
	atualizarMenuTeclas()
	abrir(menuTeclas)
end

------------------------------------------------------------------------
-- Troca de modo
------------------------------------------------------------------------

function Menus.fecharPartida()
	fechar(menuCartas)
	fechar(menuElevador)
end

function Menus.fecharLobby()
	fechar(menuClasses)
	fechar(menuLoja)
	fechar(menuAjuda)
	fechar(menuFim)
end

function Menus.iniciar()
	Estado.Mudou:Connect(function(chave)
		if chave == "perfil" then
			atualizarLoja()
			atualizarClasses()
		end
	end)
	RunService.RenderStepped:Connect(function()
		local giro = (os.clock() * 120) % 360
		for _, gradiente in gradientesGirando do
			gradiente.Rotation = giro
		end
	end)
end

return Menus
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000037">
          <Properties>
            <string name="Name">Modelos</string>
            <ProtectedString name="Source"><![CDATA[-- Aparência dos inimigos, montada com peças. Inspiração: Warcraft (proporções exageradas,
-- ombreiras grandes, olhos brilhando, armas enormes).
--
-- Cada modelo tem "ossos" (juntas que se mexem) e "peças" presas a um osso.
-- As posições são medidas a partir do chão (y = 0 é o pé), com a frente para -Z.
-- formas: bloco, bola, elipse (bola achatada), cilindro (em pé use R(0,0,90)), cunha, canto

local Modelos = {}

local V = Vector3.new
local C = Color3.fromRGB

local function R(x: number, y: number, z: number): CFrame
	return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
end

local EM_PE = R(0, 0, 90)
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local TECIDO = Enum.Material.Fabric
local MADEIRA = Enum.Material.Wood
local PEDRA = Enum.Material.Slate

-- Peça. extra: rot, mat, neon, transp, olho (fica vermelho na fúria), geleia (estica e encolhe)
local function P(osso: string, forma: string, tamanho: Vector3, pos: Vector3, cor: Color3, extra)
	extra = extra or {}
	return {
		osso = osso,
		forma = forma,
		tamanho = tamanho,
		cf = CFrame.new(pos) * (extra.rot or CFrame.identity),
		cor = cor,
		material = if extra.neon then NEON else extra.mat,
		transp = extra.transp,
		olho = extra.olho,
		geleia = extra.geleia,
	}
end

-- Barra entre dois pontos
local function S(osso: string, a: Vector3, b: Vector3, espessura: number, cor: Color3, extra)
	extra = extra or {}
	local peca = P(osso, extra.forma or "bloco", V(espessura, espessura, (b - a).Magnitude), (a + b) / 2, cor, extra)
	peca.cf = CFrame.new((a + b) / 2) * CFrame.lookAt(Vector3.zero, b - a).Rotation
	return peca
end

local function juntar(destino, origem)
	for _, item in origem do
		table.insert(destino, item)
	end
end

local function osso(pai: string, pivo: Vector3, extra)
	local o = { pai = pai, pivo = pivo }
	if extra then
		for chave, valor in extra do
			o[chave] = valor
		end
	end
	return o
end

------------------------------------------------------------------------
-- Esqueletos
------------------------------------------------------------------------

local OSSO = C(228, 221, 198)
local OSSO_ESCURO = C(168, 156, 128)
local FERRUGEM = C(124, 80, 48)
local ESCURO = C(28, 24, 26)

local function esqueleto(corOlho: Color3)
	local ossos = {
		corpo = osso("raiz", V(0, 3, 0)),
		cabeca = osso("corpo", V(0, 5.05, 0)),
		bracoE = osso("corpo", V(-1.05, 4.75, 0)),
		bracoD = osso("corpo", V(1.05, 4.75, 0)),
		pernaE = osso("raiz", V(-0.45, 2.95, 0)),
		pernaD = osso("raiz", V(0.45, 2.95, 0)),
	}
	local p = {
		P("corpo", "bloco", V(1.4, 0.45, 0.8), V(0, 3, 0), OSSO_ESCURO),
		P("corpo", "cilindro", V(1.5, 0.32, 0.32), V(0, 3.75, 0.12), OSSO, { rot = EM_PE }),
		P("corpo", "elipse", V(1.2, 1, 0.7), V(0, 4.35, 0), ESCURO),
		P("corpo", "bloco", V(1.9, 0.3, 0.9), V(0, 4.95, 0), OSSO),
		P("cabeca", "elipse", V(1.25, 1.3, 1.35), V(0, 5.65, 0), OSSO),
		P("cabeca", "bloco", V(0.9, 0.35, 0.75), V(0, 5.05, -0.15), OSSO_ESCURO),
		P("cabeca", "bloco", V(0.62, 0.12, 0.1), V(0, 5.2, -0.56), OSSO),
	}
	for i, y in { 4, 4.35, 4.7 } do
		table.insert(p, P("corpo", "elipse", V(1.85 - i * 0.12, 0.2, 1.1), V(0, y, 0), OSSO))
	end
	for _, x in { -0.28, 0.28 } do
		table.insert(p, P("cabeca", "bola", V(0.42, 0.42, 0.42), V(x, 5.7, -0.52), ESCURO))
		table.insert(p, P("cabeca", "bola", V(0.22, 0.22, 0.22), V(x, 5.7, -0.66), corOlho, { neon = true, olho = true }))
	end
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		local perna = if lado < 0 then "pernaE" else "pernaD"
		juntar(p, {
			P(braco, "bola", V(0.48, 0.48, 0.48), V(lado * 1.05, 4.75, 0), OSSO),
			P(braco, "cilindro", V(1, 0.26, 0.26), V(lado * 1.05, 4.2, 0), OSSO, { rot = EM_PE }),
			P(braco, "bola", V(0.32, 0.32, 0.32), V(lado * 1.05, 3.65, 0), OSSO_ESCURO),
			P(braco, "cilindro", V(1, 0.22, 0.22), V(lado * 1.05, 3.1, 0), OSSO, { rot = EM_PE }),
			P(braco, "bola", V(0.42, 0.42, 0.42), V(lado * 1.05, 2.5, 0), OSSO_ESCURO),
			P(perna, "cilindro", V(1.3, 0.3, 0.3), V(lado * 0.45, 2.25, 0), OSSO, { rot = EM_PE }),
			P(perna, "bola", V(0.38, 0.38, 0.38), V(lado * 0.45, 1.55, 0), OSSO_ESCURO),
			P(perna, "cilindro", V(1.3, 0.26, 0.26), V(lado * 0.45, 0.85, 0), OSSO, { rot = EM_PE }),
			P(perna, "bloco", V(0.45, 0.22, 0.85), V(lado * 0.45, 0.12, -0.15), OSSO_ESCURO),
		})
	end
	return {
		estilo = "bipede",
		ossos = ossos,
		pecas = p,
		luzes = { { osso = "cabeca", pos = V(0, 5.7, -0.7), cor = corOlho, alcance = 6, brilho = 1 } },
		efeitos = {},
		cor = OSSO,
	}
end

function Modelos.esqueleto()
	local m = esqueleto(C(255, 60, 50))
	juntar(m.pecas, {
		-- capacete com chifres
		P("cabeca", "bloco", V(1.45, 0.45, 1.45), V(0, 6.2, 0), FERRUGEM, { mat = METAL }),
		P("cabeca", "canto", V(0.3, 0.9, 0.45), V(-0.85, 6.6, 0), FERRUGEM, { mat = METAL, rot = R(0, 90, 25) }),
		P("cabeca", "canto", V(0.3, 0.9, 0.45), V(0.85, 6.6, 0), FERRUGEM, { mat = METAL, rot = R(0, -90, -25) }),
		-- escudo redondo no braço esquerdo
		P("bracoE", "cilindro", V(0.25, 2.3, 2.3), V(-1.45, 3.2, 0), C(96, 66, 42), { mat = Enum.Material.WoodPlanks }),
		P("bracoE", "cilindro", V(0.3, 0.8, 0.8), V(-1.6, 3.2, 0), FERRUGEM, { mat = METAL }),
		-- espada enferrujada
		P("bracoD", "bloco", V(0.14, 0.5, 3.2), V(1.05, 2.5, -1.75), C(150, 140, 128), { mat = Enum.Material.CorrodedMetal }),
		P("bracoD", "bloco", V(0.7, 0.16, 0.18), V(1.05, 2.5, -0.2), FERRUGEM, { mat = METAL }),
		-- tanga rasgada
		P("corpo", "bloco", V(1.2, 0.9, 0.1), V(0, 2.5, -0.42), C(96, 30, 30), { mat = TECIDO }),
	})
	return m
end

function Modelos.esqueletoArqueiro()
	local m = esqueleto(C(255, 210, 60))
	local madeira = C(98, 66, 40)
	-- arco: deitado com o braço parado, fica em pé quando o braço aponta para frente
	local mao = V(-1.05, 2.5, 0)
	juntar(m.pecas, {
		P("cabeca", "elipse", V(1.55, 1.45, 1.5), V(0, 5.8, 0.18), C(44, 62, 44), { mat = TECIDO }),
		S("bracoE", mao, mao + V(0, -0.35, -1.3), 0.2, madeira, { mat = MADEIRA }),
		S("bracoE", mao + V(0, -0.35, -1.3), mao + V(0, -0.9, -2.1), 0.18, madeira, { mat = MADEIRA }),
		S("bracoE", mao, mao + V(0, -0.35, 1.3), 0.2, madeira, { mat = MADEIRA }),
		S("bracoE", mao + V(0, -0.35, 1.3), mao + V(0, -0.9, 2.1), 0.18, madeira, { mat = MADEIRA }),
		S("bracoE", mao + V(0, -0.9, -2.1), mao + V(0, -0.9, 2.1), 0.06, C(255, 230, 160), { neon = true }),
		P("corpo", "cilindro", V(2, 0.6, 0.6), V(0.4, 4.3, 0.6), C(90, 56, 32), { rot = EM_PE * R(-20, 0, 0), mat = TECIDO }),
		P("corpo", "bloco", V(0.5, 0.3, 0.3), V(0.55, 5.35, 0.8), C(255, 80, 70), { neon = true }),
	})
	return m
end

--[[ Rei Esqueleto (primeiro chefe): um rei morto-vivo de armadura, inspirado nos reis
	espectrais de Warcraft. Bem maior que os esqueletos comuns, peitoral de ferro rachado
	mostrando a alma verde, ombreiras com espinhos e caveiras, coroa alta com gemas, capa
	longa rasgada e um espadão com runas. Chamas espectrais saem dos olhos, da coroa e da
	espada (efeitos dos pacotes: "prefabs"); na fúria elas ficam vermelhas. ]]
function Modelos.reiEsqueleto()
	local alma = C(110, 255, 120)
	local m = esqueleto(alma)
	m.escala = 2.5
	m.estilo = "rei"
	m.ritmo = 0.75 -- passos pesados
	m.subida = 1.8 -- na entrada ele sobe do chão devagar
	m.profundidade = 7
	local ouro = C(232, 186, 74)
	local ferro = C(52, 50, 60)
	local ferroClaro = C(92, 92, 104)
	local manto = C(96, 16, 34)
	local pele = C(40, 34, 38)
	local aco = C(72, 74, 86)
	m.ossos.capa = osso("corpo", V(0, 5, 0.6))
	juntar(m.pecas, {
		-- coroa alta com cinco pontas e gemas
		P("cabeca", "cilindro", V(0.5, 1.6, 1.6), V(0, 6.4, 0), ouro, { rot = EM_PE, mat = METAL }),
		P("cabeca", "cunha", V(0.3, 1.3, 0.3), V(0, 7.25, -0.66), ouro, { mat = METAL, rot = R(0, 180, 0) }),
		P("cabeca", "cunha", V(0.26, 0.95, 0.26), V(-0.58, 7.05, -0.36), ouro, { mat = METAL, rot = R(0, 150, 0) }),
		P("cabeca", "cunha", V(0.26, 0.95, 0.26), V(0.58, 7.05, -0.36), ouro, { mat = METAL, rot = R(0, -150, 0) }),
		P("cabeca", "cunha", V(0.24, 0.8, 0.24), V(-0.6, 6.95, 0.36), ouro, { mat = METAL, rot = R(0, 30, 0) }),
		P("cabeca", "cunha", V(0.24, 0.8, 0.24), V(0.6, 6.95, 0.36), ouro, { mat = METAL, rot = R(0, -30, 0) }),
		P("cabeca", "bola", V(0.3, 0.3, 0.3), V(0, 6.45, -0.8), alma, { neon = true }),
		P("cabeca", "bola", V(0.2, 0.2, 0.2), V(-0.62, 6.45, -0.5), alma, { neon = true }),
		P("cabeca", "bola", V(0.2, 0.2, 0.2), V(0.62, 6.45, -0.5), alma, { neon = true }),
		-- mandíbula maior e dentes
		P("cabeca", "bloco", V(1.05, 0.4, 0.85), V(0, 4.98, -0.18), OSSO_ESCURO),
		P("cabeca", "bloco", V(0.8, 0.14, 0.1), V(0, 5.14, -0.62), OSSO),
		-- gola de pele escura em volta do pescoço
		P("corpo", "elipse", V(2.5, 0.6, 1.6), V(0, 5.12, 0.05), pele, { mat = TECIDO }),
		-- peitoral de ferro rachado no meio: a alma verde aparece pela fenda
		P("corpo", "bloco", V(0.7, 1.25, 0.28), V(-0.52, 4.45, -0.44), ferro, { mat = METAL, rot = R(0, 8, 0) }),
		P("corpo", "bloco", V(0.7, 1.25, 0.28), V(0.52, 4.45, -0.44), ferro, { mat = METAL, rot = R(0, -8, 0) }),
		P("corpo", "bloco", V(0.72, 0.12, 0.3), V(-0.52, 5.05, -0.45), ouro, { mat = METAL }),
		P("corpo", "bloco", V(0.72, 0.12, 0.3), V(0.52, 5.05, -0.45), ouro, { mat = METAL }),
		P("corpo", "elipse", V(0.5, 1.1, 0.3), V(0, 4.4, -0.38), alma, { neon = true, transp = 0.15 }),
		P("corpo", "bloco", V(1.8, 1.3, 0.22), V(0, 4.45, 0.44), ferro, { mat = METAL }),
		-- cinto de ouro com fivela de alma, saiote de placas e pano rasgado
		P("corpo", "bloco", V(1.7, 0.32, 1.05), V(0, 3.05, 0), ouro, { mat = METAL }),
		P("corpo", "bola", V(0.36, 0.36, 0.36), V(0, 3.05, -0.55), alma, { neon = true }),
		P("corpo", "bloco", V(0.62, 0.95, 0.14), V(-0.55, 2.45, -0.52), ferro, { mat = METAL, rot = R(-8, 0, 6) }),
		P("corpo", "bloco", V(0.62, 0.95, 0.14), V(0.55, 2.45, -0.52), ferro, { mat = METAL, rot = R(-8, 0, -6) }),
		P("corpo", "bloco", V(0.62, 0.95, 0.14), V(-0.75, 2.45, 0.1), ferro, { mat = METAL, rot = R(0, 90, -8) }),
		P("corpo", "bloco", V(0.62, 0.95, 0.14), V(0.75, 2.45, 0.1), ferro, { mat = METAL, rot = R(0, 90, 8) }),
		P("corpo", "bloco", V(0.6, 1.5, 0.08), V(0, 2.2, -0.6), manto, { mat = TECIDO }),
		-- capa longa com barra dourada e a ponta rasgada
		P("capa", "bloco", V(2.4, 4.3, 0.12), V(0, 2.95, 0.72), manto, { mat = TECIDO }),
		P("capa", "bloco", V(2.5, 0.22, 0.16), V(0, 5, 0.7), ouro, { mat = METAL }),
		P("capa", "cunha", V(0.12, 0.9, 0.8), V(-0.8, 0.45, 0.72), manto, { mat = TECIDO, rot = R(0, 90, 180) }),
		P("capa", "cunha", V(0.12, 0.6, 0.8), V(0, 0.55, 0.72), manto, { mat = TECIDO, rot = R(0, -90, 180) }),
		P("capa", "cunha", V(0.12, 0.9, 0.8), V(0.8, 0.45, 0.72), manto, { mat = TECIDO, rot = R(0, 90, 180) }),
	})
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		local perna = if lado < 0 then "pernaE" else "pernaD"
		juntar(m.pecas, {
			-- ombreira grande: domo de ferro, aba de ouro, dois espinhos e uma caveira
			P(braco, "elipse", V(1.5, 0.95, 1.6), V(lado * 1.25, 5.05, 0), ferro, { mat = METAL }),
			P(braco, "elipse", V(1.2, 0.5, 1.3), V(lado * 1.32, 5.45, 0), ouro, { mat = METAL }),
			P(braco, "cunha", V(0.3, 1.15, 0.3), V(lado * 1.35, 6.05, -0.2), ferroClaro, { mat = METAL, rot = R(0, 0, -lado * 12) }),
			P(braco, "cunha", V(0.26, 0.9, 0.26), V(lado * 1.7, 5.75, 0.35), ferroClaro, { mat = METAL, rot = R(0, 0, -lado * 30) }),
			P(braco, "bola", V(0.5, 0.55, 0.5), V(lado * 1.95, 4.95, -0.2), OSSO),
			P(braco, "bola", V(0.13, 0.13, 0.13), V(lado * 1.88, 5, -0.44), alma, { neon = true, olho = true }),
			P(braco, "bola", V(0.13, 0.13, 0.13), V(lado * 2.04, 5, -0.4), alma, { neon = true, olho = true }),
			-- manopla e punho de ferro
			P(braco, "cilindro", V(1, 0.48, 0.48), V(lado * 1.05, 3.05, 0), ferro, { rot = EM_PE, mat = METAL }),
			P(braco, "cilindro", V(0.18, 0.56, 0.56), V(lado * 1.05, 3.5, 0), ouro, { rot = EM_PE, mat = METAL }),
			P(braco, "bola", V(0.62, 0.62, 0.62), V(lado * 1.05, 2.5, 0), ferro, { mat = METAL }),
			-- grevas, joelheira com espinho e botas de ferro
			P(perna, "cilindro", V(1.05, 0.46, 0.46), V(lado * 0.45, 0.85, 0), ferro, { rot = EM_PE, mat = METAL }),
			P(perna, "cunha", V(0.22, 0.6, 0.3), V(lado * 0.45, 1.75, -0.3), ferroClaro, { mat = METAL, rot = R(0, 180, 0) }),
			P(perna, "bloco", V(0.62, 0.32, 1.05), V(lado * 0.45, 0.16, -0.2), ferro, { mat = METAL }),
		})
	end
	juntar(m.pecas, {
		-- espadão rúnico: lâmina escura com runas verdes, guarda de ouro com caveira
		P("bracoD", "bloco", V(0.26, 0.95, 5.2), V(1.05, 2.5, -2.95), aco, { mat = METAL }),
		P("bracoD", "bloco", V(0.28, 0.22, 4.4), V(1.05, 2.5, -3.05), alma, { neon = true }),
		P("bracoD", "cunha", V(0.26, 0.95, 0.7), V(1.05, 2.5, -5.9), aco, { mat = METAL, rot = R(90, 0, 0) }),
		P("bracoD", "bloco", V(1.9, 0.3, 0.38), V(1.05, 2.5, -0.3), ouro, { mat = METAL }),
		P("bracoD", "bola", V(0.5, 0.55, 0.5), V(1.05, 2.5, -0.5), OSSO),
		P("bracoD", "cilindro", V(1.1, 0.26, 0.26), V(1.05, 2.5, 0.35), pele, { rot = R(0, 90, 0), mat = TECIDO }),
		P("bracoD", "bola", V(0.34, 0.34, 0.34), V(1.05, 2.5, 0.95), alma, { neon = true }),
	})
	m.efeitos = {}
	m.luzes[1].alcance = 16
	m.luzes[1].brilho = 1.5
	-- efeitos prontos dos pacotes, presos nos ossos (na fúria trocam pela versão "furia")
	m.prefabs = {
		{ osso = "cabeca", pos = V(-0.28, 5.75, -0.62), nome = "ChamaEspectral", furia = "ChamaFuria", escala = 0.22 },
		{ osso = "cabeca", pos = V(0.28, 5.75, -0.62), nome = "ChamaEspectral", furia = "ChamaFuria", escala = 0.22 },
		{ osso = "cabeca", pos = V(0, 7.1, 0), nome = "ChamaEspectral", furia = "ChamaFuria", escala = 0.45 },
		{ osso = "bracoD", pos = V(1.05, 2.5, -1.9), nome = "ChamaEspectral", furia = "ChamaFuria", escala = 0.3 },
		{ osso = "bracoD", pos = V(1.05, 2.5, -4.1), nome = "ChamaEspectral", furia = "ChamaFuria", escala = 0.3 },
		{ osso = "corpo", pos = V(0, 0.3, 0), nome = "NevoaRei", escala = 1.1 },
	}
	-- entrada: o chão racha e ele sobe; ao terminar de subir, ruge. Na fúria, ruge vermelho.
	m.entrada = { tumulo = "TumuloRei", rugido = "RugidoRei" }
	m.furia = { rugido = "RugidoFuria" }
	return m
end

------------------------------------------------------------------------
-- Gosmas e fungos
------------------------------------------------------------------------

local function gosma(cor: Color3)
	local p = {
		P("corpo", "elipse", V(3.8, 3.2, 3.8), V(0, 1.6, 0), cor, { transp = 0.22, geleia = true, mat = Enum.Material.Glass }),
		P("corpo", "elipse", V(1.5, 1.3, 1.5), V(0, 1.3, 0.2), cor:Lerp(ESCURO, 0.45), { geleia = true }),
		P("corpo", "bola", V(0.35, 0.35, 0.35), V(0.8, 1, 0.6), cor:Lerp(Color3.new(1, 1, 1), 0.5), { transp = 0.3 }),
		P("corpo", "bola", V(0.25, 0.25, 0.25), V(-0.6, 2.2, 0.8), cor:Lerp(Color3.new(1, 1, 1), 0.5), { transp = 0.3 }),
		P("corpo", "elipse", V(1.2, 0.4, 0.2), V(0, 1.45, -1.82), ESCURO),
	}
	for _, x in { -0.65, 0.65 } do
		table.insert(p, P("corpo", "bola", V(0.85, 0.85, 0.85), V(x, 2.3, -1.4), Color3.new(1, 1, 1)))
		table.insert(p, P("corpo", "bola", V(0.42, 0.42, 0.42), V(x, 2.32, -1.78), ESCURO, { olho = true }))
	end
	return {
		estilo = "gosma",
		ossos = { corpo = osso("raiz", V(0, 0, 0)) },
		pecas = p,
		luzes = { { osso = "corpo", pos = V(0, 1.4, 0), cor = cor, alcance = 7, brilho = 0.8 } },
		efeitos = {},
		cor = cor,
		altura = 3.2,
	}
end

function Modelos.gosma()
	return gosma(C(96, 222, 104))
end

function Modelos.gosminha()
	local m = gosma(C(140, 240, 120))
	m.escala = 0.55
	return m
end

function Modelos.cogumelo()
	local chapeu = C(206, 52, 58)
	local p = {
		P("corpo", "elipse", V(1.7, 2, 1.7), V(0, 1, 0), C(232, 222, 192), { geleia = true }),
		P("corpo", "elipse", V(3.6, 1.7, 3.6), V(0, 2.35, 0), chapeu, { geleia = true }),
		P("corpo", "elipse", V(3.2, 0.3, 3.2), V(0, 1.6, 0), C(150, 255, 110), { neon = true, transp = 0.2 }),
		P("corpo", "bloco", V(0.4, 0.2, 0.1), V(-0.35, 1.45, -0.82), C(255, 230, 60), { neon = true, rot = R(0, 0, -20), olho = true }),
		P("corpo", "bloco", V(0.4, 0.2, 0.1), V(0.35, 1.45, -0.82), C(255, 230, 60), { neon = true, rot = R(0, 0, 20), olho = true }),
		P("corpo", "elipse", V(0.6, 0.3, 0.9), V(-0.45, 0.15, -0.2), C(210, 200, 170)),
		P("corpo", "elipse", V(0.6, 0.3, 0.9), V(0.45, 0.15, -0.2), C(210, 200, 170)),
	}
	for _, info in { V(-1, 2.9, -0.6), V(0.9, 2.95, -0.4), V(0.2, 3.15, 0.5), V(-0.6, 2.8, 1), V(1.1, 2.6, 0.9) } do
		table.insert(p, P("corpo", "bola", V(0.55, 0.55, 0.55), info, C(250, 246, 236)))
	end
	return {
		estilo = "gosma",
		ossos = { corpo = osso("raiz", V(0, 0, 0)) },
		pecas = p,
		luzes = { { osso = "corpo", pos = V(0, 1.6, 0), cor = C(150, 255, 110), alcance = 8, brilho = 1 } },
		efeitos = { { osso = "corpo", pos = V(0, 2.4, 0), tipo = "esporos", cor = C(170, 255, 120) } },
		cor = chapeu,
		altura = 3.2,
	}
end

------------------------------------------------------------------------
-- Rato
------------------------------------------------------------------------

function Modelos.rato()
	local pelo = C(112, 96, 86)
	local rosa = C(222, 150, 150)
	local ossos = {
		corpo = osso("raiz", V(0, 1.1, 0)),
		cabeca = osso("corpo", V(0, 1.3, -1.2)),
		pernaFE = osso("raiz", V(-0.5, 0.8, -0.7)),
		pernaFD = osso("raiz", V(0.5, 0.8, -0.7)),
		pernaTE = osso("raiz", V(-0.5, 0.8, 0.7)),
		pernaTD = osso("raiz", V(0.5, 0.8, 0.7)),
		cauda = osso("corpo", V(0, 1.05, 1.3)),
	}
	local p = {
		P("corpo", "elipse", V(1.6, 1.3, 2.6), V(0, 1.15, 0), pelo),
		P("corpo", "elipse", V(1.2, 0.8, 2), V(0, 0.9, -0.1), C(150, 132, 118)),
		P("cabeca", "elipse", V(1, 0.9, 1.3), V(0, 1.35, -1.5), pelo),
		P("cabeca", "elipse", V(0.5, 0.45, 0.6), V(0, 1.25, -2.15), rosa),
		P("cabeca", "bola", V(0.2, 0.2, 0.2), V(0, 1.32, -2.45), ESCURO),
		P("cabeca", "elipse", V(0.15, 0.6, 0.5), V(-0.42, 1.9, -1.3), rosa, { rot = R(0, 0, 20) }),
		P("cabeca", "elipse", V(0.15, 0.6, 0.5), V(0.42, 1.9, -1.3), rosa, { rot = R(0, 0, -20) }),
		P("cabeca", "bola", V(0.2, 0.2, 0.2), V(-0.3, 1.55, -1.95), C(255, 50, 50), { neon = true, olho = true }),
		P("cabeca", "bola", V(0.2, 0.2, 0.2), V(0.3, 1.55, -1.95), C(255, 50, 50), { neon = true, olho = true }),
		P("cabeca", "bloco", V(0.26, 0.26, 0.1), V(0, 1.02, -2.32), C(250, 240, 210)),
		S("cauda", V(0, 1.05, 1.3), V(0, 0.95, 2.2), 0.14, rosa),
		S("cauda", V(0, 0.95, 2.2), V(0, 0.9, 3.1), 0.11, rosa),
	}
	for nome, pos in { pernaFE = V(-0.5, 0.4, -0.7), pernaFD = V(0.5, 0.4, -0.7), pernaTE = V(-0.5, 0.4, 0.7), pernaTD = V(0.5, 0.4, 0.7) } do
		table.insert(p, P(nome, "cilindro", V(0.8, 0.26, 0.26), pos, pelo:Lerp(ESCURO, 0.2), { rot = EM_PE }))
		table.insert(p, P(nome, "elipse", V(0.32, 0.18, 0.45), pos - V(0, 0.38, 0.12), rosa))
	end
	return { estilo = "quadrupede", ossos = ossos, pecas = p, luzes = {}, efeitos = {}, cor = pelo, ritmo = 1.6 }
end

------------------------------------------------------------------------
-- Kobolds ("você não pega a vela!")
------------------------------------------------------------------------

local function kobold(pelo: Color3)
	local bege = C(196, 164, 122)
	local ossos = {
		corpo = osso("raiz", V(0, 2.2, 0)),
		cabeca = osso("corpo", V(0, 3.6, -0.1)),
		bracoE = osso("corpo", V(-0.85, 3.3, 0)),
		bracoD = osso("corpo", V(0.85, 3.3, 0)),
		pernaE = osso("raiz", V(-0.35, 2.2, 0)),
		pernaD = osso("raiz", V(0.35, 2.2, 0)),
		cauda = osso("corpo", V(0, 2.3, 0.5)),
	}
	local p = {
		P("corpo", "elipse", V(1.5, 1.6, 1.1), V(0, 2.9, 0), pelo),
		P("corpo", "elipse", V(1, 1, 0.5), V(0, 2.8, -0.38), bege),
		P("corpo", "bloco", V(1.35, 0.55, 1.05), V(0, 2.2, 0), C(92, 60, 38), { mat = TECIDO }),
		P("cabeca", "elipse", V(1.2, 1.1, 1.3), V(0, 3.95, -0.15), pelo),
		P("cabeca", "elipse", V(0.7, 0.6, 0.85), V(0, 3.78, -0.85), bege),
		P("cabeca", "bola", V(0.22, 0.22, 0.22), V(0, 3.92, -1.27), ESCURO),
		P("cabeca", "bola", V(0.2, 0.2, 0.2), V(-0.3, 4.12, -0.72), C(255, 220, 60), { neon = true, olho = true }),
		P("cabeca", "bola", V(0.2, 0.2, 0.2), V(0.3, 4.12, -0.72), C(255, 220, 60), { neon = true, olho = true }),
		P("cabeca", "elipse", V(0.16, 0.75, 0.5), V(-0.6, 4.4, 0), pelo, { rot = R(0, 0, 35) }),
		P("cabeca", "elipse", V(0.16, 0.75, 0.5), V(0.6, 4.4, 0), pelo, { rot = R(0, 0, -35) }),
		S("cauda", V(0, 2.3, 0.5), V(0, 1.6, 1.6), 0.22, pelo),
	}
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		local perna = if lado < 0 then "pernaE" else "pernaD"
		juntar(p, {
			P(braco, "elipse", V(0.42, 1.25, 0.42), V(lado * 0.95, 2.85, 0), pelo),
			P(braco, "bola", V(0.45, 0.45, 0.45), V(lado * 0.95, 2.2, 0), bege),
			P(perna, "elipse", V(0.5, 1.2, 0.5), V(lado * 0.35, 1.6, 0), pelo),
			P(perna, "elipse", V(0.42, 1, 0.42), V(lado * 0.35, 0.65, 0.05), pelo),
			P(perna, "elipse", V(0.5, 0.3, 0.8), V(lado * 0.35, 0.15, -0.15), bege),
		})
	end
	return { estilo = "bipede", ossos = ossos, pecas = p, luzes = {}, efeitos = {}, cor = pelo, ritmo = 1.3 }
end

function Modelos.kobold()
	local m = kobold(C(134, 100, 70))
	juntar(m.pecas, {
		-- a famosa vela na cabeça
		P("cabeca", "cilindro", V(0.6, 0.38, 0.38), V(0, 4.75, 0), C(240, 236, 220), { rot = EM_PE }),
		P("cabeca", "bola", V(0.3, 0.3, 0.3), V(0, 5.2, 0), C(255, 200, 80), { neon = true }),
		-- picareta
		P("bracoD", "bloco", V(0.2, 0.2, 2.6), V(0.95, 2.2, -1.1), C(110, 76, 46), { mat = MADEIRA }),
		P("bracoD", "bloco", V(0.24, 1.7, 0.3), V(0.95, 2.2, -2.35), C(130, 130, 136), { mat = METAL }),
	})
	m.luzes = { { osso = "cabeca", pos = V(0, 5.2, 0), cor = C(255, 190, 90), alcance = 12, brilho = 1.5 } }
	m.efeitos = { { osso = "cabeca", pos = V(0, 5.25, 0), tipo = "chama", cor = C(255, 190, 90) } }
	return m
end

function Modelos.xama()
	local m = kobold(C(104, 104, 112))
	local verde = C(120, 255, 120)
	juntar(m.pecas, {
		P("cabeca", "bloco", V(1.3, 0.3, 0.5), V(0, 4.55, 0.2), C(170, 60, 60), { mat = TECIDO }),
		P("cabeca", "bloco", V(0.18, 1.2, 0.3), V(-0.4, 5.1, 0.2), C(255, 210, 80), { rot = R(0, 0, 15) }),
		P("cabeca", "bloco", V(0.18, 1.4, 0.3), V(0, 5.2, 0.2), C(90, 200, 255)),
		P("cabeca", "bloco", V(0.18, 1.2, 0.3), V(0.4, 5.1, 0.2), C(255, 90, 90), { rot = R(0, 0, -15) }),
		P("corpo", "bloco", V(1.7, 1.6, 0.2), V(0, 2.9, 0.55), C(70, 52, 92), { mat = TECIDO }),
		P("bracoD", "cilindro", V(4, 0.2, 0.2), V(0.95, 2.6, -0.2), C(100, 70, 44), { rot = EM_PE, mat = MADEIRA }),
		P("bracoD", "bola", V(0.6, 0.6, 0.6), V(0.95, 4.7, -0.2), verde, { neon = true }),
	})
	m.luzes = { { osso = "bracoD", pos = V(0.95, 4.7, -0.2), cor = verde, alcance = 10, brilho = 1.5 } }
	m.efeitos = { { osso = "bracoD", pos = V(0.95, 4.7, -0.2), tipo = "brilho", cor = verde } }
	return m
end

------------------------------------------------------------------------
-- Aranhas
------------------------------------------------------------------------

local function aranha(corCorpo: Color3, corMarca: Color3, corOlho: Color3)
	local ossos = { corpo = osso("raiz", V(0, 1.9, 0)) }
	local p = {
		P("corpo", "elipse", V(2, 1.2, 1.8), V(0, 1.9, -0.5), corCorpo),
		P("corpo", "elipse", V(2.6, 2, 2.8), V(0, 2.3, 1.5), corCorpo:Lerp(ESCURO, 0.2)),
		P("corpo", "bloco", V(0.75, 0.08, 0.75), V(0, 3.28, 1.4), corMarca, { neon = true, rot = R(0, 45, 0) }),
		P("corpo", "bloco", V(0.5, 0.08, 0.5), V(0, 3.24, 2.1), corMarca, { neon = true, rot = R(0, 45, 0) }),
		P("corpo", "elipse", V(1.2, 0.9, 1), V(0, 1.9, -1.5), corCorpo),
		P("corpo", "canto", V(0.2, 0.6, 0.2), V(-0.25, 1.4, -1.9), C(240, 234, 220), { rot = R(180, 0, 0) }),
		P("corpo", "canto", V(0.2, 0.6, 0.2), V(0.25, 1.4, -1.9), C(240, 234, 220), { rot = R(180, 90, 0) }),
	}
	for _, info in { V(-0.22, 2.15, -1.95), V(0.22, 2.15, -1.95), V(-0.48, 2, -1.85), V(0.48, 2, -1.85) } do
		table.insert(p, P("corpo", "bola", V(0.24, 0.24, 0.24), info, corOlho, { neon = true, olho = true }))
	end
	local indice = 0
	for i, z in { -0.9, -0.3, 0.3, 0.9 } do
		for _, lado in { -1, 1 } do
			indice += 1
			local nome = "perna" .. indice
			local quadril = V(lado * 0.85, 1.9, z - 0.3)
			local joelho = V(lado * 2.3, 3.1, z * 1.4 - 0.3)
			local pe = V(lado * 3.4, 0.1, z * 2 - 0.3)
			ossos[nome] = osso("corpo", quadril, { lado = lado, grupo = (i + (if lado > 0 then 1 else 0)) % 2 })
			juntar(p, {
				S(nome, quadril, joelho, 0.28, corCorpo),
				S(nome, joelho, pe, 0.22, corCorpo:Lerp(ESCURO, 0.25)),
				P(nome, "bola", V(0.32, 0.32, 0.32), joelho, corMarca:Lerp(ESCURO, 0.4)),
			})
		end
	end
	return {
		estilo = "aranha",
		ossos = ossos,
		pecas = p,
		luzes = { { osso = "corpo", pos = V(0, 2.1, -1.9), cor = corOlho, alcance = 7, brilho = 1 } },
		efeitos = {},
		cor = corCorpo,
		ritmo = 1.5,
	}
end

function Modelos.aranha()
	return aranha(C(58, 46, 52), C(255, 60, 60), C(255, 60, 60))
end

function Modelos.rainhaAranha()
	local m = aranha(C(54, 32, 66), C(200, 90, 255), C(220, 120, 255))
	m.escala = 1.9
	local roxo = C(200, 90, 255)
	juntar(m.pecas, {
		P("corpo", "canto", V(0.3, 1, 0.3), V(-0.6, 3.6, 1), roxo, { neon = true }),
		P("corpo", "canto", V(0.3, 1.3, 0.3), V(0, 3.75, 1.3), roxo, { neon = true }),
		P("corpo", "canto", V(0.3, 1, 0.3), V(0.6, 3.6, 1), roxo, { neon = true }),
		P("corpo", "elipse", V(1, 0.9, 1), V(0, 2.2, 3), C(230, 226, 200), { transp = 0.2 }),
		P("corpo", "bola", V(0.4, 0.4, 0.4), V(0, 2.55, -1.75), C(255, 230, 255), { neon = true }),
	})
	table.insert(m.efeitos, { osso = "corpo", pos = V(0, 2.5, 1.5), tipo = "veneno", cor = C(160, 255, 110) })
	m.luzes[1].alcance = 16
	return m
end

------------------------------------------------------------------------
-- Cripta
------------------------------------------------------------------------

function Modelos.carnical()
	local pele = C(132, 150, 120)
	local escura = C(88, 100, 78)
	local ossos = {
		corpo = osso("raiz", V(0, 2.5, 0)),
		cabeca = osso("corpo", V(0, 3.75, -0.8)),
		bracoE = osso("corpo", V(-1, 3.55, -0.45)),
		bracoD = osso("corpo", V(1, 3.55, -0.45)),
		pernaE = osso("raiz", V(-0.45, 2.5, 0)),
		pernaD = osso("raiz", V(0.45, 2.5, 0)),
	}
	local p = {
		P("corpo", "elipse", V(1.9, 1.6, 1.4), V(0, 3.25, -0.25), pele, { rot = R(25, 0, 0) }),
		P("corpo", "elipse", V(1.3, 1, 1), V(0, 2.6, 0), escura),
		P("corpo", "bloco", V(1.4, 0.7, 1.1), V(0, 2.35, 0), C(70, 50, 40), { mat = TECIDO }),
		P("cabeca", "elipse", V(1.05, 1, 1.25), V(0, 3.95, -1), pele),
		P("cabeca", "elipse", V(0.95, 0.42, 1), V(0, 3.48, -1.2), escura),
		P("cabeca", "bloco", V(0.72, 0.14, 0.1), V(0, 3.62, -1.66), C(236, 226, 196)),
		P("cabeca", "bola", V(0.22, 0.22, 0.22), V(-0.26, 4.08, -1.56), C(210, 255, 80), { neon = true, olho = true }),
		P("cabeca", "bola", V(0.22, 0.22, 0.22), V(0.26, 4.08, -1.56), C(210, 255, 80), { neon = true, olho = true }),
	}
	for i = 0, 2 do
		table.insert(p, P("corpo", "canto", V(0.25, 0.55, 0.35), V(0, 4 - i * 0.4, 0.35 + i * 0.12), escura, { rot = R(-30, 0, 0) }))
	end
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		local perna = if lado < 0 then "pernaE" else "pernaD"
		juntar(p, {
			P(braco, "elipse", V(0.48, 1.5, 0.48), V(lado * 1.1, 2.85, -0.45), pele),
			P(braco, "elipse", V(0.42, 1.5, 0.42), V(lado * 1.1, 1.6, -0.45), escura),
			P(braco, "canto", V(0.14, 0.6, 0.14), V(lado * 1.0, 0.65, -0.55), C(230, 220, 190), { rot = R(180, 0, 0) }),
			P(braco, "canto", V(0.14, 0.6, 0.14), V(lado * 1.2, 0.65, -0.55), C(230, 220, 190), { rot = R(180, 0, 0) }),
			P(perna, "elipse", V(0.52, 1.3, 0.52), V(lado * 0.45, 1.9, 0), pele),
			P(perna, "elipse", V(0.46, 1.3, 0.46), V(lado * 0.45, 0.75, 0.1), escura),
			P(perna, "elipse", V(0.5, 0.25, 0.9), V(lado * 0.45, 0.12, -0.2), escura),
		})
	end
	return { estilo = "bipede", ossos = ossos, pecas = p, luzes = {}, efeitos = {}, cor = pele, ritmo = 1.4, curvado = true }
end

local function fantasma(corManto: Color3, corOlho: Color3, transparencia: number)
	local ossos = {
		corpo = osso("raiz", V(0, 3.5, 0)),
		cabeca = osso("corpo", V(0, 4.8, 0)),
		bracoE = osso("corpo", V(-0.95, 4.6, 0)),
		bracoD = osso("corpo", V(0.95, 4.6, 0)),
		manto = osso("corpo", V(0, 3, 0)),
	}
	local p = {
		P("cabeca", "elipse", V(1.6, 1.8, 1.6), V(0, 5.1, 0.08), corManto, { transp = transparencia, mat = Enum.Material.Glass }),
		P("cabeca", "elipse", V(1, 1.1, 0.4), V(0, 5, -0.56), ESCURO),
		P("cabeca", "bola", V(0.26, 0.26, 0.26), V(-0.25, 5.1, -0.72), corOlho, { neon = true, olho = true }),
		P("cabeca", "bola", V(0.26, 0.26, 0.26), V(0.25, 5.1, -0.72), corOlho, { neon = true, olho = true }),
		P("corpo", "elipse", V(1.9, 2.6, 1.6), V(0, 3.7, 0), corManto, { transp = transparencia, mat = Enum.Material.Glass }),
		P("manto", "elipse", V(1.5, 1.6, 1.25), V(0, 2.4, 0.1), corManto, { transp = transparencia + 0.1, mat = Enum.Material.Glass }),
		P("manto", "elipse", V(1, 1.3, 0.85), V(0, 1.5, 0.25), corManto, { transp = transparencia + 0.2, mat = Enum.Material.Glass }),
		P("manto", "elipse", V(0.55, 1, 0.5), V(0, 0.8, 0.4), corManto, { transp = transparencia + 0.3, mat = Enum.Material.Glass }),
	}
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		juntar(p, {
			P(braco, "elipse", V(0.45, 1.6, 0.45), V(lado * 1.05, 3.95, 0), corManto, { transp = transparencia, mat = Enum.Material.Glass }),
			P(braco, "bola", V(0.42, 0.42, 0.42), V(lado * 1.05, 3.1, 0), corOlho, { neon = true }),
		})
	end
	return {
		estilo = "flutuante",
		ossos = ossos,
		pecas = p,
		luzes = { { osso = "corpo", pos = V(0, 4.5, -0.4), cor = corOlho, alcance = 12, brilho = 1.2 } },
		efeitos = { { osso = "corpo", pos = V(0, 3.5, 0), tipo = "gelo", cor = corOlho } },
		cor = corManto,
	}
end

function Modelos.espectro()
	return fantasma(C(120, 170, 230), C(140, 230, 255), 0.35)
end

function Modelos.lich()
	local m = fantasma(C(48, 40, 92), C(120, 210, 255), 0)
	m.escala = 1.7
	local ouro = C(220, 178, 80)
	local gelo = C(160, 225, 255)
	-- troca o rosto escuro por um crânio
	m.pecas[2] = P("cabeca", "elipse", V(0.95, 1.05, 1), V(0, 5, -0.38), OSSO)
	juntar(m.pecas, {
		P("cabeca", "bloco", V(0.6, 0.25, 0.4), V(0, 4.55, -0.55), OSSO_ESCURO),
		P("cabeca", "canto", V(0.22, 0.9, 0.22), V(-0.5, 6.1, -0.2), gelo, { neon = true }),
		P("cabeca", "canto", V(0.22, 1.2, 0.22), V(0, 6.3, -0.35), gelo, { neon = true }),
		P("cabeca", "canto", V(0.22, 0.9, 0.22), V(0.5, 6.1, -0.2), gelo, { neon = true }),
		P("corpo", "bloco", V(0.25, 2.4, 0.2), V(0, 3.7, -0.8), ouro, { mat = METAL }),
		P("bracoE", "elipse", V(1.1, 0.7, 1.2), V(-1.1, 4.9, 0), C(70, 60, 120), { mat = METAL }),
		P("bracoD", "elipse", V(1.1, 0.7, 1.2), V(1.1, 4.9, 0), C(70, 60, 120), { mat = METAL }),
		P("bracoE", "canto", V(0.25, 0.8, 0.3), V(-1.25, 5.45, 0), gelo, { neon = true }),
		P("bracoD", "canto", V(0.25, 0.8, 0.3), V(1.25, 5.45, 0), gelo, { neon = true }),
		P("bracoD", "bola", V(0.9, 0.9, 0.9), V(1.05, 2.7, -0.3), gelo, { neon = true, transp = 0.1 }),
	})
	m.ossos.orbita = osso("corpo", V(0, 4.5, 0))
	for i = 0, 3 do
		local angulo = i * math.pi / 2
		table.insert(m.pecas, P("orbita", "bloco", V(0.35, 1, 0.35), V(math.cos(angulo) * 2.2, 4.5, math.sin(angulo) * 2.2), gelo, { neon = true, rot = R(30, 0, 20) }))
	end
	m.luzes[1].alcance = 20
	return m
end

function Modelos.cavaleiroMorto()
	local armadura = C(52, 56, 66)
	local azul = C(110, 190, 255)
	local ossos = {
		corpo = osso("raiz", V(0, 4, 0)),
		cabeca = osso("corpo", V(0, 6.4, 0)),
		bracoE = osso("corpo", V(-1.6, 6, 0)),
		bracoD = osso("corpo", V(1.6, 6, 0)),
		pernaE = osso("raiz", V(-0.65, 4, 0)),
		pernaD = osso("raiz", V(0.65, 4, 0)),
		capa = osso("corpo", V(0, 6, 0.8)),
	}
	local p = {
		P("corpo", "bloco", V(2.6, 2.2, 1.6), V(0, 5.3, 0), armadura, { mat = METAL }),
		P("corpo", "bloco", V(2, 0.9, 1.3), V(0, 4.6, 0), armadura:Lerp(ESCURO, 0.3), { mat = METAL }),
		P("corpo", "bloco", V(2.4, 0.5, 1.5), V(0, 4.1, 0), C(40, 30, 30), { mat = TECIDO }),
		P("corpo", "bloco", V(0.6, 0.6, 0.15), V(0, 5.4, -0.82), azul, { neon = true, rot = R(0, 0, 45) }),
		P("cabeca", "bloco", V(1.3, 1.4, 1.3), V(0, 6.9, 0), armadura, { mat = METAL }),
		P("cabeca", "bloco", V(0.95, 0.14, 0.1), V(0, 7, -0.66), azul, { neon = true, olho = true }),
		P("cabeca", "canto", V(0.3, 1.2, 0.6), V(0, 7.85, 0.1), armadura:Lerp(ESCURO, 0.2), { mat = METAL }),
		P("capa", "bloco", V(2.4, 4.2, 0.2), V(0, 3.9, 0.9), C(92, 20, 30), { mat = TECIDO }),
	}
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		local perna = if lado < 0 then "pernaE" else "pernaD"
		juntar(p, {
			P(braco, "elipse", V(1.5, 1, 1.6), V(lado * 1.65, 6.3, 0), armadura:Lerp(ESCURO, 0.15), { mat = METAL }),
			P(braco, "canto", V(0.4, 1, 0.4), V(lado * 1.85, 6.95, 0), C(190, 196, 206), { mat = METAL }),
			P(braco, "canto", V(0.35, 0.8, 0.35), V(lado * 1.4, 6.85, 0.4), C(190, 196, 206), { mat = METAL }),
			P(braco, "bloco", V(0.8, 1.4, 0.8), V(lado * 1.65, 5.3, 0), armadura, { mat = METAL }),
			P(braco, "bloco", V(0.9, 1.3, 0.9), V(lado * 1.65, 4.2, 0), armadura:Lerp(ESCURO, 0.2), { mat = METAL }),
			P(perna, "bloco", V(0.9, 1.6, 0.9), V(lado * 0.65, 3.2, 0), armadura, { mat = METAL }),
			P(perna, "bloco", V(0.95, 1.8, 1), V(lado * 0.65, 1.4, 0), armadura:Lerp(ESCURO, 0.15), { mat = METAL }),
			P(perna, "bloco", V(1, 0.6, 1.4), V(lado * 0.65, 0.3, -0.2), armadura:Lerp(ESCURO, 0.3), { mat = METAL }),
		})
	end
	juntar(p, {
		P("bracoD", "bloco", V(0.25, 0.8, 4.8), V(1.65, 3.55, -2.6), C(150, 160, 175), { mat = METAL }),
		P("bracoD", "bloco", V(0.28, 0.2, 3.8), V(1.65, 3.6, -2.7), azul, { neon = true }),
		P("bracoD", "bloco", V(1.4, 0.3, 0.3), V(1.65, 3.55, -0.3), armadura, { mat = METAL }),
	})
	return {
		estilo = "bipede",
		ossos = ossos,
		pecas = p,
		luzes = { { osso = "cabeca", pos = V(0, 7, -0.8), cor = azul, alcance = 10, brilho = 1.5 } },
		efeitos = { { osso = "bracoD", pos = V(1.65, 3.6, -2.7), tipo = "gelo", cor = azul } },
		cor = armadura,
		ritmo = 0.8,
	}
end

