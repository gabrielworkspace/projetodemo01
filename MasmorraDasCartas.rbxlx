------------------------------------------------------------------------
-- Interpolação
------------------------------------------------------------------------

local function suavizar(tipo: string?, a: number): number
	if tipo == "linear" then
		return a
	elseif tipo == "forte" then
		return 1 - (1 - a) ^ 4
	end
	return 1 - (1 - a) * (1 - a)
end

local function misturar(a, b, alfa: number)
	return {
		a[1] + (b[1] - a[1]) * alfa,
		a[2] + (b[2] - a[2]) * alfa,
		a[3] + (b[3] - a[3]) * alfa,
		a[4] + (b[4] - a[4]) * alfa,
		a[5] + (b[5] - a[5]) * alfa,
		a[6] + (b[6] - a[6]) * alfa,
	}
end

local function juntasUsadas(definicao)
	if definicao.juntas then
		return definicao.juntas
	end
	local lista, vistas = {}, {}
	for _, quadro in definicao.quadros do
		for junta in quadro.pose do
			if not vistas[junta] then
				vistas[junta] = true
				table.insert(lista, junta)
			end
		end
	end
	definicao.juntas = lista
	return lista
end

-- Pose da animação no tempo "tau", partindo da pose "base"
local function amostrar(definicao, tau: number, base)
	local quadros = definicao.quadros
	local indice = 0
	for k, quadro in quadros do
		if quadro.t <= tau then
			indice = k
		end
	end
	local pose = {}
	for _, junta in juntasUsadas(definicao) do
		local inicio = base[junta] or ZERO
		for k = indice, 1, -1 do
			local v = quadros[k].pose[junta]
			if v then
				inicio = v
				break
			end
		end
		local proximo = quadros[indice + 1]
		if proximo and proximo.pose[junta] then
			local t0 = if indice == 0 then 0 else quadros[indice].t
			local alfa = suavizar(proximo.suave, math.clamp((tau - t0) / math.max(proximo.t - t0, 0.001), 0, 1))
			pose[junta] = misturar(inicio, proximo.pose[junta], alfa)
		else
			pose[junta] = inicio
		end
	end
	return pose
end

------------------------------------------------------------------------
-- Estado de cada personagem
------------------------------------------------------------------------

local personagens = {} -- [Model] = estado

local function obterJuntas(personagem: Model)
	local juntas = {}
	local mapa = if personagem:FindFirstChild("UpperTorso") then JUNTAS_R15 else JUNTAS_R6
	for nome, info in mapa do
		local parte = personagem:FindFirstChild(info[1])
		local motor = parte and parte:FindFirstChild(info[2])
		if motor and motor:IsA("Motor6D") then
			local rotacao = motor.C0.Rotation
			juntas[nome] = { motor = motor, rot = rotacao, inv = rotacao:Inverse() }
		end
	end
	return juntas
end

local function estadoDe(personagem: Model)
	local e = personagens[personagem]
	if not e then
		e = {
			personagem = personagem,
			jogador = Players:GetPlayerFromCharacter(personagem),
			humanoid = personagem:FindFirstChildOfClass("Humanoid"),
			juntas = obterJuntas(personagem),
			acao = nil,
			dash = nil,
			carregando = false,
			cargaInicio = 0,
			puxar = 0,
			brilho = 0,
			ultimaPose = {},
		}
		personagens[personagem] = e
	end
	return e
end

local function classeDe(e): string
	local classe = e.jogador and e.jogador:GetAttribute("Classe")
	return if Classes.existe(classe) then classe else "cavaleiro"
end

local function cargaDe(e): number
	if not e.carregando then
		return 0
	end
	return math.clamp((os.clock() - e.cargaInicio - Config.CARGA_ATAQUE_MIN) / (Config.CARGA_ATAQUE_MAX - Config.CARGA_ATAQUE_MIN) + 0.15, 0, 1)
end

local function comecar(e, definicao, dados)
	if not definicao then
		return
	end
	local agora = os.clock()
	e.acao = {
		def = definicao,
		inicio = agora,
		base = e.ultimaPose, -- parte de onde o corpo está (sem "pulos" entre animações)
		dados = dados or {},
		duracao = if definicao.manter then math.huge else (definicao.duracao or (dados and dados.duracao) or 0.5),
		soltando = nil,
	}
end

------------------------------------------------------------------------
-- Detalhes das armas: rastro da espada, corda e flecha do arco, brilho do cajado e
-- partículas de carga. Tudo criado só neste computador.
------------------------------------------------------------------------

local function prepararArma(e)
	local acessorios = e.personagem:FindFirstChild("AcessoriosDeClasse")
	local arma = acessorios and acessorios:FindFirstChild("ArmaDeClasse")
	if arma == e.arma then
		return
	end
	-- arma nova (trocou de classe ou renasceu): limpa os detalhes antigos
	for _, objeto in e.detalhes or {} do
		objeto:Destroy()
	end
	e.detalhes = {}
	e.arma = arma
	e.trilha, e.trilha2, e.encaixe, e.flecha, e.glow, e.esfera, e.emissorCarga = nil, nil, nil, nil, nil, nil, nil
	if not arma then
		return
	end
	local classe = Classes.obter(classeDe(e))

	local function rastroDaLamina(modelo: Instance?): (Trail?, Attachment?)
		local lamina = modelo and modelo:FindFirstChild("Lamina")
		local base = lamina and lamina:FindFirstChild("TrilhaBase") :: Attachment?
		local ponta = lamina and lamina:FindFirstChild("TrilhaPonta") :: Attachment?
		if not base or not ponta then
			return nil, nil
		end
		local trilha = Instance.new("Trail")
		trilha.Attachment0 = base
		trilha.Attachment1 = ponta
		trilha.Color = ColorSequence.new(Color3.new(1, 1, 1), classe.cor)
		trilha.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		trilha.Lifetime = 0.16
		trilha.LightEmission = 1
		trilha.LightInfluence = 0
		trilha.Enabled = false
		trilha.Parent = lamina
		table.insert(e.detalhes, trilha)
		return trilha, ponta
	end
	local trilha, ponta = rastroDaLamina(arma)
	if trilha then
		e.trilha = trilha
		e.pontaArma = ponta
	end
	-- Assassino: rastro também na adaga da mão esquerda
	e.trilha2 = rastroDaLamina(acessorios:FindFirstChild("ArmaSecundaria"))

	local arco = arma:FindFirstChild("Arco")
	if arco then
		local cima = arco:FindFirstChild("CordaCima") :: Attachment?
		local baixo = arco:FindFirstChild("CordaBaixo") :: Attachment?
		local encaixe = arco:FindFirstChild("Encaixe") :: Attachment?
		if cima and baixo and encaixe then
			for _, par in { { cima, encaixe }, { encaixe, baixo } } do
				local corda = Instance.new("Beam")
				corda.Attachment0 = par[1]
				corda.Attachment1 = par[2]
				corda.Width0 = 0.07
				corda.Width1 = 0.07
				corda.Color = ColorSequence.new(Color3.fromRGB(255, 240, 210))
				corda.LightEmission = 0.4
				corda.FaceCamera = true
				corda.Segments = 1
				corda.Parent = arco
				table.insert(e.detalhes, corda)
			end
			local flecha = Instance.new("Part")
			flecha.Size = Vector3.new(0.12, 0.12, 2.7)
			flecha.Material = Enum.Material.Wood
			flecha.Color = Color3.fromRGB(160, 120, 80)
			flecha.Anchored = true
			flecha.CanCollide = false
			flecha.CanQuery = false
			flecha.CanTouch = false
			flecha.CastShadow = false
			flecha.Transparency = 1
			flecha.Parent = pasta
			local pontaFlecha = Instance.new("Part")
			pontaFlecha.Size = Vector3.new(0.22, 0.22, 0.4)
			pontaFlecha.Material = Enum.Material.Neon
			pontaFlecha.Color = classe.cor
			pontaFlecha.Anchored = true
			pontaFlecha.CanCollide = false
			pontaFlecha.CanQuery = false
			pontaFlecha.CanTouch = false
			pontaFlecha.Transparency = 1
			pontaFlecha.Parent = flecha
			e.encaixe = encaixe
			e.arco = arco
			e.flecha = flecha
			e.pontaFlecha = pontaFlecha
			e.pontaArma = encaixe
			table.insert(e.detalhes, flecha)
		end
	end

	local haste = arma:FindFirstChild("Haste")
	if haste then
		local ponta = haste:FindFirstChild("Ponta") :: Attachment?
		if ponta then
			local glow = Instance.new("Part")
			glow.Shape = Enum.PartType.Ball
			glow.Size = Vector3.one
			glow.Material = Enum.Material.Neon
			glow.Color = classe.cor
			glow.Anchored = true
			glow.CanCollide = false
			glow.CanQuery = false
			glow.CanTouch = false
			glow.CastShadow = false
			glow.Transparency = 1
			glow.Parent = pasta
			local luz = Instance.new("PointLight")
			luz.Color = classe.cor
			luz.Range = 12
			luz.Brightness = 0
			luz.Parent = glow
			e.glow = glow
			e.luzGlow = luz
			e.pontaArma = ponta
			table.insert(e.detalhes, glow)
		end
	end

	-- Esfera invisível na ponta da arma: as partículas de carga convergem para ela
	local esfera = Instance.new("Part")
	esfera.Shape = Enum.PartType.Ball
	esfera.Size = Vector3.one * 5
	esfera.Transparency = 1
	esfera.Anchored = true
	esfera.CanCollide = false
	esfera.CanQuery = false
	esfera.CanTouch = false
	esfera.Parent = pasta
	local emissor = Instance.new("ParticleEmitter")
	emissor.Shape = Enum.ParticleEmitterShape.Sphere
	emissor.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	emissor.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	emissor.Color = ColorSequence.new(classe.cor:Lerp(Color3.new(1, 1, 1), 0.4), classe.cor)
	emissor.LightEmission = 1
	emissor.LightInfluence = 0
	emissor.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.6, 0.35), NumberSequenceKeypoint.new(1, 0) })
	emissor.Lifetime = NumberRange.new(0.3, 0.4)
	emissor.Speed = NumberRange.new(6, 9)
	emissor.Rate = 0
	emissor.Parent = esfera
	e.esfera = esfera
	e.emissorCarga = emissor
	e.corClasse = classe.cor
	table.insert(e.detalhes, esfera)
end

local function atualizarArma(e, agora: number)
	prepararArma(e)
	if not e.arma then
		return
	end
	local acao = e.acao
	if e.trilha then
		local ligada = acao ~= nil and acao.def.trilha == true and (acao.soltando == nil) and (agora - acao.inicio) < (if acao.def.continuo then math.huge else acao.duracao * 0.8)
		if e.trilha.Enabled ~= ligada then
			e.trilha.Enabled = ligada
		end
		if e.trilha2 and e.trilha2.Enabled ~= ligada then
			e.trilha2.Enabled = ligada
		end
	end
	if e.encaixe and e.arco and e.flecha then
		local puxar = math.clamp(e.puxar, 0, 1.3)
		local z = 0.62 + puxar * 1.6
		e.encaixe.Position = Vector3.new(0, 0, z)
		local visivel = puxar > 0.15
		e.flecha.Transparency = if visivel then 0 else 1
		e.pontaFlecha.Transparency = if visivel then 0 else 1
		if visivel then
			local cf = e.arco.CFrame * CFrame.new(0, 0, z - 1.35)
			e.flecha.CFrame = cf
			e.pontaFlecha.CFrame = cf * CFrame.new(0, 0, -1.45)
		end
	end
	local carga = cargaDe(e)
	if e.glow and e.pontaArma then
		local intensidade = math.clamp(e.brilho * 0.6 + carga, 0, 1.5)
		e.glow.Transparency = if intensidade > 0.02 then 1 - math.min(0.75, intensidade * 0.6) else 1
		e.glow.Size = Vector3.one * (0.6 + intensidade * 1.6 + math.sin(agora * 20) * 0.08 * carga)
		e.glow.CFrame = CFrame.new(e.pontaArma.WorldPosition)
		e.luzGlow.Brightness = intensidade * 3
	end
	if e.esfera and e.pontaArma then
		e.esfera.CFrame = CFrame.new(e.pontaArma.WorldPosition)
		e.emissorCarga.Rate = if e.carregando then 20 + 60 * carga else 0
		if e.carregando and carga >= 1 and not e.cheioAvisado then
			e.cheioAvisado = true
			e.emissorCarga.Color = ColorSequence.new(Color3.new(1, 1, 1), OURO)
			Vfx.cargaCheia({ pos = e.pontaArma.WorldPosition, local_ = e.jogador == jogador })
		end
	end
end

-- Barrinha de carga acima do próprio personagem (só quem carrega vê)
local barra: BillboardGui? = nil
local preenchimento: Frame? = nil

local function criarBarra()
	local gui = Instance.new("BillboardGui")
	gui.Name = "BarraDeCarga"
	gui.Size = UDim2.fromOffset(70, 9)
	gui.StudsOffset = Vector3.new(0, 3.6, 0)
	gui.AlwaysOnTop = true
	gui.Enabled = false
	local fundo = Instance.new("Frame")
	fundo.Size = UDim2.fromScale(1, 1)
	fundo.BackgroundColor3 = Color3.fromRGB(20, 18, 28)
	fundo.BackgroundTransparency = 0.25
	fundo.BorderSizePixel = 0
	fundo.Parent = gui
	Instance.new("UICorner", fundo).CornerRadius = UDim.new(1, 0)
	local contorno = Instance.new("UIStroke")
	contorno.Color = Color3.new(0, 0, 0)
	contorno.Thickness = 1.5
	contorno.Parent = fundo
	local cheio = Instance.new("Frame")
	cheio.Size = UDim2.fromScale(0, 1)
	cheio.BorderSizePixel = 0
	cheio.Parent = fundo
	Instance.new("UICorner", cheio).CornerRadius = UDim.new(1, 0)
	gui.Parent = pasta
	barra, preenchimento = gui, cheio
end

local function atualizarBarra(e, agora: number)
	if e.jogador ~= jogador then
		return
	end
	if not barra then
		criarBarra()
	end
	local gui, cheio = barra :: BillboardGui, preenchimento :: Frame
	local raiz = e.personagem:FindFirstChild("HumanoidRootPart")
	gui.Adornee = raiz
	gui.Enabled = e.carregando and raiz ~= nil
	if not gui.Enabled then
		return
	end
	local carga = cargaDe(e)
	cheio.Size = UDim2.fromScale(carga, 1)
	if carga >= 1 then
		-- cheia: pisca entre dourado e branco
		cheio.BackgroundColor3 = OURO:Lerp(Color3.new(1, 1, 1), (math.sin(agora * 18) + 1) * 0.3)
	else
		cheio.BackgroundColor3 = (e.corClasse or OURO):Lerp(Color3.new(1, 1, 1), 0.25)
	end
end

------------------------------------------------------------------------
-- Aplicar a pose nas juntas (depois da animação padrão, antes da física)
------------------------------------------------------------------------

local function pesoDaAcao(a, agora: number): (number, number)
	local tau = agora - a.inicio
	local entrada = a.def.entrada or 0.05
	local peso = math.min(1, tau / entrada)
	if a.soltando then
		peso *= math.max(0, 1 - (agora - a.soltando) / 0.15)
	elseif not a.def.manter then
		local saida = a.def.saida or 0.12
		local resto = a.duracao - tau
		if resto < saida then
			peso *= math.max(0, resto / saida)
		end
	end
	return peso, tau
end

local function poseDaAcao(a, tau: number)
	if a.def.continuo then
		return a.def.continuo(tau, a.dados)
	end
	return amostrar(a.def, tau, a.base)
end

local function animarPersonagem(e, agora: number)
	local final = {} -- junta -> { valores, peso }
	local classe = classeDe(e)
	local postura = POSTURAS[classe]
	if postura then
		for junta, valor in postura do
			final[junta] = { valor, PESO_POSTURA }
		end
	end

	local function aplicarCamada(pose, peso: number)
		for junta, valor in pose do
			local atual = final[junta]
			if atual then
				final[junta] = { misturar(atual[1], valor, peso), atual[2] + (1 - atual[2]) * peso }
			else
				final[junta] = { valor, peso }
			end
		end
	end

	-- Pose parada: entra suave quando o personagem para e sai quando ele anda ou pula
	local raiz = e.personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
	local parado = 0
	if raiz then
		-- pela velocidade (funciona também para os personagens dos outros jogadores)
		local v = raiz.AssemblyLinearVelocity
		if math.abs(v.Y) < 3 then
			parado = math.clamp(1 - Vector3.new(v.X, 0, v.Z).Magnitude / 3, 0, 1)
		end
	end
	e.parado = (e.parado or 0) + (parado - (e.parado or 0)) * 0.15
	local poseParada = PARADO[classe]
	if poseParada and e.parado > 0.01 then
		aplicarCamada(poseParada(agora), e.parado * 0.9)
	end

	local a = e.acao
	if a then
		local peso, tau = pesoDaAcao(a, agora)
		if peso <= 0 and (a.soltando or tau > a.duracao) then
			e.acao = nil
		else
			local pose = poseDaAcao(a, tau)
			if e.carregando and a.def.manter then
				-- tremendo de força enquanto carrega
				local carga = cargaDe(e)
				local tremor = math.sin(agora * 45) * 0.025 * (0.4 + carga)
				pose = table.clone(pose)
				if pose.cintura then
					pose.cintura = misturar(pose.cintura, A(pose.cintura[1] + tremor, pose.cintura[2] + tremor, pose.cintura[3]), 1)
				end
			end
			e.ultimaPose = pose
			aplicarCamada(pose, peso)
		end
	end

	local d = e.dash
	if d then
		local tau = agora - d.inicio
		local duracao = d.def.duracao
		local peso = math.min(1, tau / 0.03)
		if tau > duracao - 0.1 then
			peso *= math.max(0, (duracao - tau) / 0.1)
		end
		if tau >= duracao then
			e.dash = nil
		else
			-- a esquiva manda no corpo todo: tira a postura e o ataque de baixo
			aplicarCamada(amostrar(d.def, tau, {}), peso)
		end
	end

	local h = e.atingido
	if h then
		local tau = agora - h
		if tau >= ATINGIDO.duracao then
			e.atingido = nil
		else
			local peso = math.min(1, tau / 0.03) * math.max(0, 1 - tau / ATINGIDO.duracao)
			aplicarCamada(amostrar(ATINGIDO, tau, {}), peso * 0.8)
		end
	end

	e.puxar = if final.puxar then final.puxar[1][1] * final.puxar[2] else 0
	e.brilho = if final.brilho then final.brilho[1][1] * final.brilho[2] else 0

	for junta, info in final do
		local j = e.juntas[junta]
		local peso = info[2]
		if j and peso > 0.001 and j.motor.Parent then
			local v = info[1]
			local alvo = j.inv * CFrame.new(v[4], v[5], v[6]) * CFrame.fromEulerAnglesYXZ(v[1], v[2], v[3]) * j.rot
			j.motor.Transform = j.motor.Transform:Lerp(alvo, math.min(peso, 1))
		end
	end
end

------------------------------------------------------------------------
-- API
------------------------------------------------------------------------

--[[ Toca uma animação num personagem.
	acao: "ataque" (dados.combo), "carregar", "soltar" (dados.fracao), "cancelar",
	      "esquiva", "habilidade", "supremo" (dados.duracao), "atingido" ]]
function Animacoes.tocar(personagem: Model, acao: string, dados)
	if not personagem or not personagem.Parent then
		return
	end
	dados = dados or {}
	local e = estadoDe(personagem)
	local classe = if Classes.existe(dados.classe) then dados.classe else classeDe(e)
	local acoes = ACOES[classe]
	if acao == "ataque" then
		comecar(e, acoes["ataque" .. math.clamp(dados.combo or 1, 1, 3)], dados)
	elseif acao == "carregar" then
		e.carregando = true
		e.cargaInicio = os.clock()
		e.cheioAvisado = false
		comecar(e, acoes.carregar, dados)
	elseif acao == "soltar" then
		e.carregando = false
		if e.emissorCarga and e.corClasse then
			e.emissorCarga.Color = ColorSequence.new(e.corClasse:Lerp(Color3.new(1, 1, 1), 0.4), e.corClasse)
		end
		comecar(e, acoes.soltar, dados)
	elseif acao == "cancelar" then
		e.carregando = false
		if e.acao and e.acao.def.manter then
			e.acao.soltando = os.clock()
		end
	elseif acao == "esquiva" then
		e.carregando = false
		if e.acao and e.acao.def.manter then
			e.acao.soltando = os.clock()
		end
		e.dash = { inicio = os.clock(), def = ESQUIVAS[classe] or ESQUIVAS.cavaleiro }
		Vfx.esquiva({ jogador = e.jogador, classe = classe })
	elseif acao == "habilidade" or acao == "supremo" then
		comecar(e, acoes[acao], dados)
	elseif acao == "atingido" then
		e.atingido = os.clock()
	end
end

-- Ações que o próprio jogador já anima na hora do clique (o servidor não manda de volta)
local PREVISTAS = { ataque = true, carregar = true, soltar = true, cancelar = true, esquiva = true }

-- Mensagem "anim" vinda do servidor
function Animacoes.receber(dados)
	local player = dados.jogador
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	if player == jogador and PREVISTAS[dados.acao] then
		return
	end
	local personagem = player.Character
	if personagem then
		Animacoes.tocar(personagem, dados.acao, dados)
	end
end

function Animacoes.atingido(player: any)
	if typeof(player) == "Instance" and player:IsA("Player") and player.Character then
		Animacoes.tocar(player.Character, "atingido", nil)
	end
end

function Animacoes.iniciar()
	RunService.PreSimulation:Connect(function()
		local agora = os.clock()
		for personagem, e in personagens do
			if not personagem.Parent then
				for _, objeto in e.detalhes or {} do
					objeto:Destroy()
				end
				personagens[personagem] = nil
			else
				local humanoid = e.humanoid
				if humanoid and humanoid.Health > 0 and not humanoid.Sit then
					animarPersonagem(e, agora)
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(function()
		local agora = os.clock()
		for _, e in personagens do
			atualizarArma(e, agora)
			atualizarBarra(e, agora)
		end
	end)

	-- Todo personagem ganha estado assim que aparece (para a postura de combate)
	local function acompanhar(player: Player)
		player.CharacterAdded:Connect(function(personagem)
			personagem:WaitForChild("Humanoid", 10)
			task.wait(0.1)
			if personagem.Parent then
				estadoDe(personagem)
			end
		end)
		if player.Character then
			estadoDe(player.Character)
		end
	end
	for _, player in Players:GetPlayers() do
		acompanhar(player)
	end
	Players.PlayerAdded:Connect(acompanhar)
end

return Animacoes
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000027">
          <Properties>
            <string name="Name">Controles</string>
            <ProtectedString name="Source"><![CDATA[-- Controles: tocar para atacar (mira no mouse; no celular mira sozinha no inimigo mais próximo),
-- segurar para carregar e soltar para um golpe forte, habilidade (E), esquiva (Q), supremo (R)
-- e os botões de toque no celular.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))

local modulos = script.Parent
local Estado = require(modulos.Estado)
local Vfx = require(modulos.Vfx)
local UI = require(modulos.UI)
local Animacoes = require(modulos.Animacoes)

local Controles = {}

local jogador = Players.LocalPlayer
local Acao = ReplicatedStorage:WaitForChild("Remotos"):WaitForChild("Acao") :: RemoteEvent

local segurandoAtaque = false
local segurouEm = 0
local carregando = false
local cargaComecou = 0
local ultimoAtaque = 0
local comboLocal = 0
local ultimoFoiFinal = false
local mirandoAte = 0
local esquivandoAte = 0
local direcaoAtual = Vector3.new(0, 0, -1)

local function planar(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function personagem()
	local p = jogador.Character
	local raiz = p and p:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = p and p:FindFirstChildOfClass("Humanoid")
	return raiz, humanoid
end

local function inimigoMaisProximo(origem: Vector3, alcance: number): Vector3?
	local melhor, melhorDistancia = nil, alcance
	for _, modelo in CollectionService:GetTagged("Inimigo") do
		local raiz = modelo:FindFirstChild("HumanoidRootPart") :: BasePart?
		if raiz then
			local distancia = planar(raiz.Position - origem).Magnitude
			if distancia < melhorDistancia then
				melhor, melhorDistancia = raiz.Position, distancia
			end
		end
	end
	return melhor
end

-- Para onde o ataque vai: o ponto do chão sob o mouse, ou o inimigo mais próximo
local function direcaoDaMira(): Vector3
	local raiz = personagem()
	if not raiz then
		return direcaoAtual
	end
	if UserInputService.MouseEnabled and not UI.ehCelular() and UserInputService:GetLastInputType() ~= Enum.UserInputType.Gamepad1 then
		local camera = workspace.CurrentCamera
		local mouse = UserInputService:GetMouseLocation()
		local raio = camera:ViewportPointToRay(mouse.X, mouse.Y)
		if math.abs(raio.Direction.Y) > 1e-3 then
			local t = (raiz.Position.Y - 2 - raio.Origin.Y) / raio.Direction.Y
			if t > 0 then
				local ponto = raio.Origin + raio.Direction * t
				local direcao = planar(ponto - raiz.Position)
				if direcao.Magnitude > 0.5 then
					return direcao.Unit
				end
			end
		end
	end
	local alvo = inimigoMaisProximo(raiz.Position, 60)
	if alvo then
		local direcao = planar(alvo - raiz.Position)
		if direcao.Magnitude > 0.1 then
			return direcao.Unit
		end
	end
	local olhar = planar(raiz.CFrame.LookVector)
	return if olhar.Magnitude > 0.1 then olhar.Unit else direcaoAtual
end

-- Vira o personagem para a mira por um instante (dá para andar e atirar para outro lado)
local function mirar(direcao: Vector3)
	direcaoAtual = direcao
	mirandoAte = os.clock() + 0.35
end

-- Empurra o próprio personagem (o movimento do personagem é feito neste computador)
local function impulso(direcao: Vector3, velocidade: number, duracao: number)
	local raiz = personagem()
	if not raiz then
		return
	end
	local anexo = Instance.new("Attachment")
	anexo.Parent = raiz
	local forca = Instance.new("LinearVelocity")
	forca.Attachment0 = anexo
	forca.MaxForce = 1e7
	forca.RelativeTo = Enum.ActuatorRelativeTo.World
	forca.VectorVelocity = direcao * velocidade
	forca.Parent = raiz
	Debris:AddItem(forca, duracao)
	Debris:AddItem(anexo, duracao)
end

local function podeLutar(): boolean
	return not Estado.caido and not Estado.morto and Estado.menusAbertos == 0
end

local function tentarAtacar()
	if not podeLutar() then
		return
	end
	local raiz = personagem()
	if not raiz then
		return
	end
	local agora = os.clock()
	local stats = Estado.stats
	local naPartida = Estado.modo == "partida" and stats ~= nil
	local intervalo = if naPartida then stats.intervalo else 0.5
	local espera = intervalo * (if ultimoFoiFinal then 1.35 else 1)
	if agora - ultimoAtaque < espera then
		return
	end
	if agora - ultimoAtaque > intervalo * 2.6 + 0.3 then
		comboLocal = 0
	end
	comboLocal = comboLocal % 3 + 1
	ultimoFoiFinal = comboLocal == 3
	ultimoAtaque = agora

	local direcao = direcaoDaMira()
	mirar(direcao)
	Acao:FireServer("atacar", direcao, comboLocal)
	if jogador.Character then
		Animacoes.tocar(jogador.Character, "ataque", { combo = comboLocal })
	end

	-- O próprio corte aparece na hora, sem esperar o servidor
	if naPartida then
		local classe = Classes.obter(stats.classe)
		if classe.ataque.tipo == "corte" then
			local final = comboLocal == 3
			Vfx.corte({
				jogador = jogador,
				pos = raiz.Position,
				dir = direcao,
				alcance = stats.alcance * (if final then 1.15 else 1),
				arco = stats.arco * (if final then 1.25 else 1),
				cor = classe.cor,
				combo = comboLocal,
			})
		end
	end
end

------------------------------------------------------------------------
-- Ataque carregado: segurando o ataque, começa a carregar; ao soltar, sai o golpe forte
------------------------------------------------------------------------

local function comecarCarga()
	carregando = true
	cargaComecou = os.clock()
	Acao:FireServer("carregar")
	if jogador.Character then
		Animacoes.tocar(jogador.Character, "carregar", nil)
	end
end

local function cancelarCarga()
	if not carregando then
		return
	end
	carregando = false
	Acao:FireServer("cancelar")
	if jogador.Character then
		Animacoes.tocar(jogador.Character, "cancelar", nil)
	end
end

local function soltarCarga()
	if not carregando then
		return
	end
	local raiz = personagem()
	local duracao = os.clock() - cargaComecou
	if not raiz or not podeLutar() or duracao < Config.CARGA_ATAQUE_MIN then
		cancelarCarga()
		return
	end
	carregando = false
	local fracao = math.clamp((duracao - Config.CARGA_ATAQUE_MIN) / (Config.CARGA_ATAQUE_MAX - Config.CARGA_ATAQUE_MIN), 0, 1)
	local direcao = direcaoDaMira()
	mirar(direcao)
	Acao:FireServer("soltar", direcao)
	-- o golpe carregado encerra o combo (o próximo clique recomeça do primeiro golpe)
	comboLocal = 0
	ultimoAtaque = os.clock()
	ultimoFoiFinal = true
	if jogador.Character then
		Animacoes.tocar(jogador.Character, "soltar", { fracao = fracao })
	end

	local stats = Estado.stats
	if Estado.modo == "partida" and stats then
		local classe = Classes.obter(stats.classe)
		if classe.id == "cavaleiro" then
			Vfx.giroCarregado({
				jogador = jogador,
				raio = stats.alcance * (1.25 + 0.3 * fracao),
				cor = classe.cor,
				perfeito = fracao >= 0.99,
			})
		elseif classe.id == "assassino" then
			-- Investida Letal: dispara para frente (mesma distância que o servidor usa)
			local distancia = 12 + 6 * fracao
			Vfx.investidaLetal({ jogador = jogador, de = raiz.Position, ate = raiz.Position + direcao * distancia, cor = classe.cor, perfeito = fracao >= 0.99 })
			impulso(direcao, distancia / 0.2, 0.2)
			mirandoAte = os.clock() + 0.3
		else
			Vfx.tremer(0.4 + 0.6 * fracao, 0.15)
		end
	end
end

local function usarHabilidade()
	if Estado.modo ~= "partida" or not podeLutar() then
		return
	end
	if os.clock() < Estado.habilidadeFim - 0.1 then
		return
	end
	local direcao = direcaoDaMira()
	mirar(direcao)
	Acao:FireServer("habilidade", direcao)
	-- Arqueiro: salta para trás antes da chuva de flechas
	local stats = Estado.stats
	if stats and stats.classe == "arqueiro" then
		impulso(-direcao, 70, 0.18)
	end
end

local function usarSupremo()
	if Estado.modo ~= "partida" or not podeLutar() or Estado.carga < Estado.cargaMax then
		return
	end
	Acao:FireServer("supremo")
end

local function esquivar()
	if Estado.caido or Estado.morto or Estado.menusAbertos > 0 then
		return
	end
	local raiz, humanoid = personagem()
	if not raiz or not humanoid or humanoid.Health <= 0 then
		return
	end
	local agora = os.clock()
	if agora < Estado.esquivaFim then
		return
	end
	-- esquivar cancela a carga (segure de novo para recomeçar)
	cancelarCarga()
	segurouEm = agora
	local recarga = if Estado.stats then Estado.stats.recargaEsquiva else Config.ESQUIVA_RECARGA
	Estado.esquivaFim = agora + recarga
	Estado.esquivaTotal = recarga
	Estado.avisar("recargas")

	local direcao = planar(humanoid.MoveDirection)
	if direcao.Magnitude < 0.1 then
		direcao = planar(raiz.CFrame.LookVector)
	end
	direcao = if direcao.Magnitude > 0.01 then direcao.Unit else Vector3.new(0, 0, -1)

	local anexo = Instance.new("Attachment")
	anexo.Parent = raiz
	local impulso = Instance.new("LinearVelocity")
	impulso.Attachment0 = anexo
	impulso.MaxForce = 1e7
	impulso.RelativeTo = Enum.ActuatorRelativeTo.World
	impulso.VectorVelocity = direcao * Config.ESQUIVA_VELOCIDADE
	impulso.Parent = raiz
	Debris:AddItem(impulso, Config.ESQUIVA_DURACAO)
	Debris:AddItem(anexo, Config.ESQUIVA_DURACAO)

	-- o corpo vira para onde vai, para a animação da esquiva fazer sentido
	direcaoAtual = direcao
	mirandoAte = agora + Config.ESQUIVA_DURACAO + 0.1
	esquivandoAte = mirandoAte
	if jogador.Character then
		Animacoes.tocar(jogador.Character, "esquiva", nil)
	end
	Acao:FireServer("esquiva", direcao)
end

Controles.atacar = tentarAtacar
Controles.habilidade = usarHabilidade
Controles.supremo = usarSupremo
Controles.esquivar = esquivar

function Controles.segurarAtaque(segurando: boolean)
	if segurando == segurandoAtaque then
		return
	end
	segurandoAtaque = segurando
	if segurando then
		segurouEm = os.clock()
		tentarAtacar()
	elseif carregando then
		soltarCarga()
	end
end

-- Para tudo sem disparar o golpe (ao cair, morrer, abrir menus...)
function Controles.pararAtaque()
	segurandoAtaque = false
	cancelarCarga()
end

-- Liga os botões de toque criados pelo HUD
function Controles.ligarBotoes(botoes)
	local function aoTocar(botao: GuiButton, comecar: () -> (), terminar: (() -> ())?)
		botao.InputBegan:Connect(function(entrada)
			if entrada.UserInputType == Enum.UserInputType.Touch or entrada.UserInputType == Enum.UserInputType.MouseButton1 then
				comecar()
			end
		end)
		if terminar then
			botao.InputEnded:Connect(function(entrada)
				if entrada.UserInputType == Enum.UserInputType.Touch or entrada.UserInputType == Enum.UserInputType.MouseButton1 then
					terminar()
				end
			end)
		end
	end
	aoTocar(botoes.ataque, function()
		Controles.segurarAtaque(true)
	end, function()
		Controles.segurarAtaque(false)
	end)
	aoTocar(botoes.habilidade, usarHabilidade)
	aoTocar(botoes.esquiva, esquivar)
	aoTocar(botoes.supremo, usarSupremo)
end

function Controles.iniciar()
	UserInputService.InputBegan:Connect(function(entrada, processado)
		if processado then
			return
		end
		local tipo, tecla = entrada.UserInputType, entrada.KeyCode
		if tipo == Enum.UserInputType.MouseButton1 or tecla == Enum.KeyCode.ButtonR2 then
			Controles.segurarAtaque(true)
		elseif tecla == Enum.KeyCode.E or tecla == Enum.KeyCode.ButtonX then
			usarHabilidade()
		elseif tecla == Enum.KeyCode.Q or tecla == Enum.KeyCode.ButtonB then
			esquivar()
		elseif tecla == Enum.KeyCode.R or tecla == Enum.KeyCode.ButtonY then
			usarSupremo()
		end
	end)
	UserInputService.InputEnded:Connect(function(entrada)
		if entrada.UserInputType == Enum.UserInputType.MouseButton1 or entrada.KeyCode == Enum.KeyCode.ButtonR2 then
			Controles.segurarAtaque(false)
		end
	end)

	RunService.Heartbeat:Connect(function()
		local agora = os.clock()
		if carregando then
			local _, humanoidAtual = personagem()
			if not podeLutar() or not humanoidAtual or humanoidAtual.Health <= 0 then
				cancelarCarga()
			else
				-- enquanto carrega, o corpo acompanha a mira
				mirandoAte = math.max(mirandoAte, agora + 0.1)
			end
		elseif segurandoAtaque and agora - segurouEm >= Config.CARGA_ATAQUE_COMECA and podeLutar() and personagem() then
			comecarCarga()
		end
		local raiz, humanoid = personagem()
		if not raiz or not humanoid then
			return
		end
		if agora < mirandoAte and humanoid.Health > 0 and not Estado.caido then
			humanoid.AutoRotate = false
			raiz.CFrame = CFrame.lookAt(raiz.Position, raiz.Position + direcaoAtual)
			if segurandoAtaque and agora >= esquivandoAte then
				direcaoAtual = direcaoDaMira()
			end
		elseif not humanoid.AutoRotate then
			humanoid.AutoRotate = true
		end
	end)
end

return Controles
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000028">
          <Properties>
            <string name="Name">Estado</string>
            <ProtectedString name="Source"><![CDATA[-- Estado compartilhado entre as partes da interface do jogador.
-- Quem muda algo chama Estado.avisar("nome") e quem desenha escuta Estado.Mudou.

local Estado = {
	perfil = { ouro = 0, recorde = 0, melhorias = {}, classe = "cavaleiro", escolheuClasse = false },
	modo = "lobby", -- "lobby" ou "partida"
	stats = nil, -- atributos da partida (vêm do servidor)
	cartas = {},
	aliados = {},
	ouroPartida = 0,
	carga = 0,
	cargaMax = 100,
	habilidadeFim = 0,
	habilidadeTotal = 1,
	esquivaFim = 0,
	esquivaTotal = 1,
	caido = false,
	morto = false,
	sala = nil,
	menusAbertos = 0,
}

local evento = Instance.new("BindableEvent")
Estado.Mudou = evento.Event

function Estado.avisar(chave: string)
	evento:Fire(chave)
end

return Estado
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000029">
          <Properties>
            <string name="Name">Hud</string>
            <ProtectedString name="Source"><![CDATA[-- HUD: tudo o que fica na tela durante o jogo (lobby e masmorra).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local Cartas = require(Shared:WaitForChild("Cartas"))

local modulos = script.Parent
local UI = require(modulos.UI)
local Estado = require(modulos.Estado)
local Vfx = require(modulos.Vfx)

local Hud = {}
Hud.aoAbrir = nil :: ((string) -> ())?
Hud.botoesToque = {}

local jogador = Players.LocalPlayer
local criar, animar, cores, fontes = UI.criar, UI.animar, UI.cores, UI.fontes
local celular = UI.ehCelular()

local gui = criar("ScreenGui", {
	Name = "Hud",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 1,
	Parent = jogador:WaitForChild("PlayerGui"),
})
local topo = criar("ScreenGui", {
	Name = "HudTopo",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 30,
	Parent = jogador:WaitForChild("PlayerGui"),
})

local function camada(nome: string, pai: Instance): Frame
	return criar("Frame", { Name = nome, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = pai })
end

local telaLobby = camada("Lobby", gui)
local telaPartida = camada("Partida", gui)
telaPartida.Visible = false

------------------------------------------------------------------------
-- Componentes pequenos
------------------------------------------------------------------------

-- "Ficha": painel pequeno com ícone e um número (ouro, recorde)
local function ficha(pai: Instance, icone: string, posicao: UDim2, largura: number)
	local painel = UI.painel({
		AnchorPoint = Vector2.new(1, 0),
		Position = posicao,
		Size = UDim2.fromOffset(largura, 44),
		Parent = pai,
		SemCantos = true,
		Transparencia = 0.12,
	})
	UI.escalavel(painel)
	UI.medalhao({ Parent = painel, Icone = icone, Position = UDim2.fromOffset(4, 2), Size = UDim2.fromOffset(40, 40), Cor = cores.painelClaro })
	local texto = UI.texto({
		Position = UDim2.fromOffset(52, 7),
		Size = UDim2.new(1, -60, 0, 30),
		FontFace = fontes.numero,
		Text = "0",
		TextColor3 = cores.ouroClaro,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = painel,
	})
	UI.contorno(texto, 1.5)
	return painel, texto
end

local function formatarNumero(n: number): string
	local texto = tostring(math.floor(n))
	local resultado = texto:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if resultado:sub(1, 1) == "." then
		resultado = resultado:sub(2)
	end
	return resultado
end

------------------------------------------------------------------------
-- Lobby
------------------------------------------------------------------------

local perfilCard = UI.painel({ Position = UDim2.fromOffset(16, 64), Size = UDim2.fromOffset(310, 98), Parent = telaLobby })
UI.escalavel(perfilCard)
local foto = criar("ImageLabel", {
	Position = UDim2.fromOffset(14, 15),
	Size = UDim2.fromOffset(68, 68),
	BackgroundColor3 = cores.fundo,
	Image = UI.fotoJogador(jogador.UserId),
	Parent = perfilCard,
})
UI.redondo(foto)
local aroFoto = UI.borda(foto, cores.ouro, 3)
local nomeJogador = UI.texto({
	Position = UDim2.fromOffset(94, 12),
	Size = UDim2.fromOffset(204, 28),
	FontFace = fontes.cabecalho,
	Text = jogador.DisplayName,
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = perfilCard,
})
UI.contorno(nomeJogador, 1.5)
local classeJogador = UI.texto({
	Position = UDim2.fromOffset(94, 44),
	Size = UDim2.fromOffset(204, 24),
	FontFace = fontes.numero,
	Text = "",
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = perfilCard,
})
UI.contorno(classeJogador, 1.5)
local tituloClasse = UI.texto({
	Position = UDim2.fromOffset(94, 70),
	Size = UDim2.fromOffset(204, 18),
	FontFace = fontes.texto,
	Text = "",
	TextColor3 = cores.textoSuave,
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = perfilCard,
})

local _, textoOuroLobby = ficha(telaLobby, "💰", UDim2.new(1, -16, 0, 64), 190)
local _, textoRecorde = ficha(telaLobby, "🏆", UDim2.new(1, -16, 0, 114), 190)

local doca = criar("Frame", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -22),
	Size = UDim2.fromOffset(560, 62),
	BackgroundTransparency = 1,
	Parent = telaLobby,
})
UI.escalavel(doca)
criar("UIListLayout", {
	FillDirection = Enum.FillDirection.Horizontal,
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 14),
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = doca,
})
for ordem, info in { { "classe", "⚔️ CLASSE", "ouro" }, { "loja", "🛒 LOJA", "escuro" }, { "ajuda", "📜 COMO JOGAR", "escuro" } } do
	local botao = UI.botao({ Parent = doca, Texto = info[2], Estilo = info[3], Size = UDim2.fromOffset(170, 58), LayoutOrder = ordem, TamanhoTexto = 24 })
	botao.Activated:Connect(function()
		if Hud.aoAbrir then
			Hud.aoAbrir(info[1])
		end
	end)
end

-- Fila do portal
local painelFila = UI.painel({
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 64),
	Size = UDim2.fromOffset(440, 158),
	Visible = false,
	Parent = telaLobby,
})
UI.escalavel(painelFila)
UI.titulo(painelFila, "A MASMORRA AGUARDA", 10, 380, 36)
local contagemFila = UI.texto({
	Position = UDim2.fromOffset(20, 64),
	Size = UDim2.fromOffset(90, 70),
	FontFace = fontes.numero,
	Text = "10",
	TextColor3 = Color3.fromRGB(210, 170, 255),
	Parent = painelFila,
})
UI.contorno(contagemFila, 2)
local vagas = {}
for i = 1, Config.MAX_JOGADORES_POR_PARTIDA do
	local vaga = criar("ImageLabel", {
		Position = UDim2.fromOffset(120 + (i - 1) * 74, 70),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = cores.fundo,
		BackgroundTransparency = 0.2,
		Image = "",
		Parent = painelFila,
	})
	UI.redondo(vaga)
	local aro = UI.borda(vaga, cores.bronze, 2)
	local icone = UI.texto({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 6, 1, 6),
		Size = UDim2.fromOffset(24, 24),
		Text = "",
		Parent = vaga,
	})
	vagas[i] = { imagem = vaga, aro = aro, icone = icone }
end
local dicaFila = UI.texto({
	Position = UDim2.fromOffset(20, 134),
	Size = UDim2.new(1, -40, 0, 18),
	FontFace = fontes.texto,
	Text = "Saia do círculo para cancelar",
	TextColor3 = cores.textoSuave,
	Parent = painelFila,
})

------------------------------------------------------------------------
-- Partida
------------------------------------------------------------------------

-- Placa da sala, com o progresso até o chefe
local placaSala = criar("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.fromOffset(380, 84),
	BackgroundTransparency = 1,
	Parent = telaPartida,
})
UI.escalavel(placaSala)
local textoSala = UI.texto({ Size = UDim2.new(1, 0, 0, 38), FontFace = fontes.titulo, Text = "SALA 1", TextColor3 = cores.ouroClaro, Parent = placaSala })
UI.contorno(textoSala, 2)
local textoTema = UI.texto({ Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 20), FontFace = fontes.cabecalho, Text = "", TextColor3 = cores.texto, Parent = placaSala })
UI.contorno(textoTema, 1.5)
local pips = {}
for i = 1, Config.SALAS_POR_ANDAR do
	local x = 0.5 + (i - (Config.SALAS_POR_ANDAR + 1) / 2) * 0.075
	local pip = UI.losango(placaSala, UDim2.new(x, 0, 0, 72), if i == Config.SALAS_POR_ANDAR then 14 else 11, cores.bronze)
	pips[i] = pip
end

-- Barra do chefe
local painelChefe = criar("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 96),
	Size = UDim2.fromOffset(660, 70),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = telaPartida,
})
UI.escalavel(painelChefe)
local nomeChefe = UI.texto({ Size = UDim2.new(1, 0, 0, 30), FontFace = fontes.titulo, Text = "", TextColor3 = Color3.fromRGB(255, 120, 100), Parent = painelChefe })
UI.contorno(nomeChefe, 2)
local barraChefe = UI.barra({
	Parent = painelChefe,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 34),
	Size = UDim2.fromOffset(620, 22),
	Cor = Color3.fromRGB(196, 30, 44),
	Raio = 5,
})
local marcaFase = UI.losango(barraChefe.quadro, UDim2.fromScale(0.5, 0.5), 12, cores.ouro)
marcaFase.ZIndex = 5
local tituloChefe = UI.texto({ Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 16), FontFace = fontes.cabecalho, Text = "", TextColor3 = cores.textoSuave, Parent = painelChefe })

-- Ouro e cartas da partida
local _, textoOuroPartida = ficha(telaPartida, "💰", UDim2.new(1, -16, 0, 64), 170)
local faixaCartas = criar("Frame", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 116),
	Size = UDim2.fromOffset(250, 140),
	BackgroundTransparency = 1,
	Parent = telaPartida,
})
UI.escalavel(faixaCartas)
criar("UIGridLayout", {
	CellSize = UDim2.fromOffset(40, 40),
	CellPadding = UDim2.fromOffset(6, 6),
	HorizontalAlignment = Enum.HorizontalAlignment.Right,
	StartCorner = Enum.StartCorner.TopRight,
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = faixaCartas,
})

-- Quadros dos aliados
local listaAliados = criar("Frame", {
	Position = UDim2.fromOffset(16, 64),
	Size = UDim2.fromOffset(240, 260),
	BackgroundTransparency = 1,
	Parent = telaPartida,
})
UI.escalavel(listaAliados)
criar("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = listaAliados })
local quadrosAliados = {}

-- Barra de ações (computador)
