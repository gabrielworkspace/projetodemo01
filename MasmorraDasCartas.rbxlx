-- Fornalha
------------------------------------------------------------------------

function Modelos.diabrete()
	local vermelho = C(196, 52, 44)
	local roxo = C(110, 40, 84)
	local ossos = {
		corpo = osso("raiz", V(0, 1.9, 0)),
		cabeca = osso("corpo", V(0, 3, 0)),
		bracoE = osso("corpo", V(-0.75, 2.8, 0)),
		bracoD = osso("corpo", V(0.75, 2.8, 0)),
		pernaE = osso("raiz", V(-0.3, 1.9, 0)),
		pernaD = osso("raiz", V(0.3, 1.9, 0)),
		asaE = osso("corpo", V(-0.4, 2.9, 0.4), { lado = -1 }),
		asaD = osso("corpo", V(0.4, 2.9, 0.4), { lado = 1 }),
		cauda = osso("corpo", V(0, 2, 0.4)),
	}
	local p = {
		P("corpo", "elipse", V(1.2, 1.3, 1), V(0, 2.5, 0), vermelho),
		P("corpo", "elipse", V(0.8, 0.8, 0.4), V(0, 2.45, -0.35), C(230, 120, 90)),
		P("cabeca", "elipse", V(1.25, 1.1, 1.1), V(0, 3.4, 0), vermelho),
		P("cabeca", "canto", V(0.25, 0.85, 0.3), V(-0.42, 4.05, 0.1), C(40, 30, 30), { rot = R(-10, 0, 15) }),
		P("cabeca", "canto", V(0.25, 0.85, 0.3), V(0.42, 4.05, 0.1), C(40, 30, 30), { rot = R(-10, 90, -15) }),
		P("cabeca", "bloco", V(0.28, 0.16, 0.1), V(-0.27, 3.55, -0.55), C(255, 230, 60), { neon = true, rot = R(0, 0, -15), olho = true }),
		P("cabeca", "bloco", V(0.28, 0.16, 0.1), V(0.27, 3.55, -0.55), C(255, 230, 60), { neon = true, rot = R(0, 0, 15), olho = true }),
		P("cabeca", "bloco", V(0.62, 0.1, 0.1), V(0, 3.15, -0.54), ESCURO),
		P("asaE", "bloco", V(1.6, 1.3, 0.08), V(-1.15, 3.1, 0.55), roxo, { mat = TECIDO, rot = R(0, 20, 10) }),
		P("asaD", "bloco", V(1.6, 1.3, 0.08), V(1.15, 3.1, 0.55), roxo, { mat = TECIDO, rot = R(0, -20, -10) }),
		S("cauda", V(0, 2, 0.4), V(0, 1.4, 1.4), 0.16, vermelho),
		P("cauda", "canto", V(0.4, 0.4, 0.15), V(0, 1.35, 1.5), ESCURO),
		P("bracoD", "bola", V(0.7, 0.7, 0.7), V(0.85, 1.95, -0.3), C(255, 140, 40), { neon = true }),
	}
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		local perna = if lado < 0 then "pernaE" else "pernaD"
		juntar(p, {
			P(braco, "elipse", V(0.35, 1.1, 0.35), V(lado * 0.82, 2.35, 0), vermelho),
			P(perna, "elipse", V(0.42, 1, 0.42), V(lado * 0.3, 1.35, 0), vermelho:Lerp(ESCURO, 0.2)),
			P(perna, "elipse", V(0.36, 0.9, 0.36), V(lado * 0.3, 0.5, 0.15), vermelho:Lerp(ESCURO, 0.35)),
		})
	end
	return {
		estilo = "bipede",
		ossos = ossos,
		pecas = p,
		luzes = { { osso = "bracoD", pos = V(0.85, 1.95, -0.3), cor = C(255, 140, 40), alcance = 10, brilho = 1.5 } },
		efeitos = { { osso = "bracoD", pos = V(0.85, 1.95, -0.3), tipo = "chama", cor = C(255, 140, 40) } },
		cor = vermelho,
		ritmo = 1.4,
	}
end

local function elemental(corFogo: Color3, corNucleo: Color3)
	local rocha = C(46, 34, 32)
	local ossos = {
		corpo = osso("raiz", V(0, 3, 0)),
		cabeca = osso("corpo", V(0, 4.8, 0)),
		bracoE = osso("corpo", V(-1.4, 4.4, 0)),
		bracoD = osso("corpo", V(1.4, 4.4, 0)),
		base = osso("raiz", V(0, 1.5, 0)),
	}
	local p = {
		P("corpo", "elipse", V(2.1, 2.3, 1.6), V(0, 3.8, 0), corFogo, { neon = true, transp = 0.1 }),
		P("corpo", "elipse", V(1.2, 1.4, 1), V(0, 3.8, -0.15), corNucleo, { neon = true }),
		P("corpo", "bloco", V(1, 0.9, 0.5), V(-0.65, 4.3, -0.6), rocha, { rot = R(10, 20, 15), mat = PEDRA }),
		P("corpo", "bloco", V(1, 0.9, 0.5), V(0.65, 4.3, -0.6), rocha, { rot = R(10, -20, -15), mat = PEDRA }),
		P("cabeca", "elipse", V(1.25, 1.45, 1.2), V(0, 5.15, 0), corFogo, { neon = true }),
		P("cabeca", "bloco", V(0.3, 0.16, 0.1), V(-0.25, 5.25, -0.58), C(255, 255, 220), { neon = true, olho = true }),
		P("cabeca", "bloco", V(0.3, 0.16, 0.1), V(0.25, 5.25, -0.58), C(255, 255, 220), { neon = true, olho = true }),
		P("cabeca", "canto", V(0.4, 1.1, 0.4), V(0, 6.05, 0), corNucleo, { neon = true }),
		P("base", "elipse", V(1.7, 1, 1.7), V(0, 2.3, 0), corFogo, { neon = true, transp = 0.2 }),
		P("base", "elipse", V(1.15, 1, 1.15), V(0.15, 1.5, 0), corFogo:Lerp(corNucleo, 0.3), { neon = true, transp = 0.25 }),
		P("base", "elipse", V(0.6, 1, 0.6), V(-0.1, 0.75, 0.1), corNucleo, { neon = true, transp = 0.3 }),
	}
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		juntar(p, {
			P(braco, "elipse", V(0.75, 1.9, 0.75), V(lado * 1.5, 3.6, 0), corFogo, { neon = true, transp = 0.1 }),
			P(braco, "bloco", V(0.95, 0.7, 0.95), V(lado * 1.5, 3.1, 0), rocha, { mat = PEDRA }),
			P(braco, "elipse", V(0.95, 0.95, 0.95), V(lado * 1.5, 2.55, 0), corNucleo, { neon = true }),
		})
	end
	return {
		estilo = "flutuante",
		ossos = ossos,
		pecas = p,
		luzes = { { osso = "corpo", pos = V(0, 3.8, 0), cor = corFogo, alcance = 16, brilho = 2 } },
		efeitos = { { osso = "corpo", pos = V(0, 4, 0), tipo = "fogo", cor = corFogo } },
		cor = corFogo,
		girarBase = true,
	}
end

function Modelos.elementalFogo()
	return elemental(C(255, 120, 40), C(255, 220, 120))
end

function Modelos.senhorChamas()
	local m = elemental(C(255, 96, 30), C(255, 214, 110))
	m.escala = 2.3
	local rocha = C(40, 28, 26)
	local lava = C(255, 120, 40)
	juntar(m.pecas, {
		P("cabeca", "canto", V(0.45, 1.6, 0.6), V(-0.75, 5.9, 0.1), rocha, { rot = R(-15, 0, 25), mat = PEDRA }),
		P("cabeca", "canto", V(0.45, 1.6, 0.6), V(0.75, 5.9, 0.1), rocha, { rot = R(-15, 90, -25), mat = PEDRA }),
		P("cabeca", "elipse", V(1, 1, 0.6), V(0, 4.55, -0.45), C(255, 200, 80), { neon = true }),
		P("corpo", "bloco", V(2.4, 0.6, 1.4), V(0, 4.85, 0), rocha, { mat = PEDRA }),
		-- martelo gigante
		P("bracoD", "cilindro", V(4.4, 0.35, 0.35), V(1.5, 2.6, -1.2), C(70, 52, 40), { rot = R(0, 90, 0), mat = MADEIRA }),
		P("bracoD", "bloco", V(2.6, 1.6, 1.6), V(1.5, 2.6, -3.4), rocha, { mat = PEDRA }),
		P("bracoD", "bloco", V(2.7, 0.3, 1.7), V(1.5, 2.6, -3.4), lava, { neon = true }),
	})
	m.luzes[1].alcance = 30
	return m
end

function Modelos.ogro()
	local pele = C(140, 152, 96)
	local escura = C(104, 116, 72)
	local couro = C(96, 64, 40)
	local ossos = {
		corpo = osso("raiz", V(0, 4.8, 0)),
		cabeca = osso("corpo", V(0, 8.6, -0.4)),
		bracoE = osso("corpo", V(-2.6, 7.6, 0)),
		bracoD = osso("corpo", V(2.6, 7.6, 0)),
		pernaE = osso("raiz", V(-1.1, 4.8, 0)),
		pernaD = osso("raiz", V(1.1, 4.8, 0)),
	}
	local p = {
		P("corpo", "elipse", V(4.2, 3.8, 3.6), V(0, 5.6, -0.2), pele),
		P("corpo", "elipse", V(4.6, 2.6, 3), V(0, 7.3, 0), pele),
		P("corpo", "bloco", V(0.4, 0.25, 5.2), V(0, 6.4, -0.3), couro, { rot = R(0, 90, 35), mat = TECIDO }),
		P("corpo", "bloco", V(3.8, 1.5, 3.4), V(0, 4.6, 0), couro, { mat = TECIDO }),
		P("corpo", "bloco", V(3.9, 0.45, 3.5), V(0, 5.3, 0), C(60, 40, 26), { mat = TECIDO }),
		P("cabeca", "elipse", V(2, 1.8, 1.9), V(0, 8.95, -0.6), pele),
		P("cabeca", "elipse", V(1.8, 0.85, 1.6), V(0, 8.3, -0.9), escura),
		P("cabeca", "canto", V(0.3, 0.75, 0.3), V(-0.55, 8.8, -1.6), C(240, 232, 210)),
		P("cabeca", "canto", V(0.3, 0.75, 0.3), V(0.55, 8.8, -1.6), C(240, 232, 210), { rot = R(0, 90, 0) }),
		P("cabeca", "bola", V(0.28, 0.28, 0.28), V(-0.4, 9.2, -1.42), C(255, 220, 60), { neon = true, olho = true }),
		P("cabeca", "bola", V(0.28, 0.28, 0.28), V(0.4, 9.2, -1.42), C(255, 220, 60), { neon = true, olho = true }),
		P("cabeca", "bloco", V(0.35, 0.9, 1.7), V(0, 9.95, -0.45), C(40, 30, 30)),
	}
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		local perna = if lado < 0 then "pernaE" else "pernaD"
		juntar(p, {
			P(braco, "elipse", V(1.9, 1.7, 1.9), V(lado * 2.5, 7.8, 0), pele),
			P(braco, "elipse", V(1.3, 2.6, 1.3), V(lado * 2.7, 6.3, 0), pele),
			P(braco, "elipse", V(1.2, 2.2, 1.2), V(lado * 2.8, 4.6, -0.2), escura),
			P(braco, "bola", V(1.35, 1.35, 1.35), V(lado * 2.8, 3.3, -0.3), escura),
			P(braco, "cilindro", V(0.7, 1.3, 1.3), V(lado * 2.8, 4.1, -0.2), couro, { rot = EM_PE, mat = TECIDO }),
			P(perna, "elipse", V(1.5, 2.6, 1.5), V(lado * 1.1, 3.4, 0), pele),
			P(perna, "elipse", V(1.3, 2.2, 1.3), V(lado * 1.1, 1.4, 0), escura),
			P(perna, "elipse", V(1.4, 0.7, 2), V(lado * 1.1, 0.35, -0.3), escura),
		})
	end
	-- clava cravejada
	juntar(p, {
		P("bracoD", "elipse", V(1.1, 1.1, 4.8), V(2.8, 3.3, -2.6), C(110, 76, 46), { mat = MADEIRA }),
		P("bracoD", "canto", V(0.3, 0.6, 0.3), V(2.8, 3.95, -3.6), C(150, 150, 156), { mat = METAL }),
		P("bracoD", "canto", V(0.3, 0.6, 0.3), V(3.4, 3.4, -4.2), C(150, 150, 156), { mat = METAL, rot = R(0, 0, -90) }),
		P("bracoD", "canto", V(0.3, 0.6, 0.3), V(2.2, 3.4, -4.4), C(150, 150, 156), { mat = METAL, rot = R(0, 0, 90) }),
	})
	return { estilo = "bipede", ossos = ossos, pecas = p, luzes = {}, efeitos = {}, cor = pele, ritmo = 0.7 }
end

------------------------------------------------------------------------
-- Suporte: curandeiro, guardião do escudo e porta-estandarte
------------------------------------------------------------------------

-- Acólito Necromante: esqueleto de túnica e capuz, cajado com crânio verde que cura aliados
function Modelos.acolito()
	local verde = C(110, 255, 150)
	local tunica = C(40, 46, 44)
	local m = esqueleto(verde)
	juntar(m.pecas, {
		-- túnica longa até os pés e capuz
		P("corpo", "bloco", V(1.9, 2.6, 1.2), V(0, 3.6, 0), tunica, { mat = TECIDO }),
		P("pernaE", "bloco", V(0.95, 2.6, 1.15), V(-0.45, 1.35, 0), tunica:Lerp(ESCURO, 0.2), { mat = TECIDO }),
		P("pernaD", "bloco", V(0.95, 2.6, 1.15), V(0.45, 1.35, 0), tunica:Lerp(ESCURO, 0.2), { mat = TECIDO }),
		P("cabeca", "elipse", V(1.6, 1.6, 1.7), V(0, 5.8, 0.15), tunica, { mat = TECIDO }),
		P("cabeca", "canto", V(1.2, 0.9, 0.9), V(0, 6.6, 0.45), tunica, { mat = TECIDO, rot = R(0, 180, 0) }),
		-- faixa e runas verdes
		P("corpo", "bloco", V(0.4, 2.4, 0.1), V(0, 3.8, -0.62), verde, { neon = true, transp = 0.2 }),
		P("corpo", "bloco", V(2, 0.25, 1.25), V(0, 3.1, 0), C(70, 50, 30), { mat = TECIDO }),
		-- cajado com crânio e cristal
		P("bracoD", "cilindro", V(5.4, 0.22, 0.22), V(1.05, 3.4, -0.35), C(70, 56, 40), { rot = EM_PE, mat = MADEIRA }),
		P("bracoD", "elipse", V(0.7, 0.75, 0.75), V(1.05, 6.25, -0.35), OSSO),
		P("bracoD", "bola", V(0.18, 0.18, 0.18), V(0.92, 6.3, -0.7), verde, { neon = true, olho = true }),
		P("bracoD", "bola", V(0.18, 0.18, 0.18), V(1.18, 6.3, -0.7), verde, { neon = true, olho = true }),
		P("bracoD", "canto", V(0.35, 1, 0.35), V(1.05, 6.95, -0.35), verde, { neon = true, transp = 0.1 }),
	})
	m.luzes = {
		{ osso = "bracoD", pos = V(1.05, 6.6, -0.35), cor = verde, alcance = 12, brilho = 1.8 },
		{ osso = "cabeca", pos = V(0, 5.7, -0.7), cor = verde, alcance = 6, brilho = 1 },
	}
	m.efeitos = { { osso = "bracoD", pos = V(1.05, 6.6, -0.35), tipo = "alma", cor = verde } }
	m.curvado = true
	m.cor = tunica
	return m
end

-- Guardião Rúnico: armadura de pedra com um escudo-torre cheio de runas azuis
function Modelos.guardiao()
	local pedra = C(96, 100, 112)
	local pedraEscura = C(62, 64, 74)
	local runa = C(110, 190, 255)
	local ossos = {
		corpo = osso("raiz", V(0, 3.4, 0)),
		cabeca = osso("corpo", V(0, 5.9, 0)),
		bracoE = osso("corpo", V(-1.75, 5.5, 0)),
		bracoD = osso("corpo", V(1.75, 5.5, 0)),
		pernaE = osso("raiz", V(-0.7, 3.4, 0)),
		pernaD = osso("raiz", V(0.7, 3.4, 0)),
	}
	local p = {
		P("corpo", "bloco", V(2.8, 2.4, 1.8), V(0, 4.8, 0), pedra, { mat = PEDRA }),
		P("corpo", "bloco", V(2.2, 0.8, 1.5), V(0, 3.4, 0), pedraEscura, { mat = PEDRA }),
		P("corpo", "bloco", V(0.9, 0.9, 0.12), V(0, 5, -0.92), runa, { neon = true, rot = R(0, 0, 45) }),
		P("corpo", "bloco", V(0.4, 0.4, 0.14), V(0, 5, -0.95), C(230, 245, 255), { neon = true, rot = R(0, 0, 45) }),
		P("cabeca", "bloco", V(1.3, 1.2, 1.3), V(0, 6.5, 0), pedra, { mat = PEDRA }),
		P("cabeca", "bloco", V(1, 0.16, 0.1), V(0, 6.55, -0.66), runa, { neon = true, olho = true }),
		P("cabeca", "canto", V(0.4, 1, 0.5), V(-0.5, 7.4, 0), pedraEscura, { mat = PEDRA, rot = R(0, 90, 15) }),
		P("cabeca", "canto", V(0.4, 1, 0.5), V(0.5, 7.4, 0), pedraEscura, { mat = PEDRA, rot = R(0, -90, -15) }),
	}
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		local perna = if lado < 0 then "pernaE" else "pernaD"
		juntar(p, {
			P(braco, "elipse", V(1.6, 1.1, 1.7), V(lado * 1.8, 5.8, 0), pedraEscura, { mat = PEDRA }),
			P(braco, "bloco", V(0.95, 1.6, 0.95), V(lado * 1.8, 4.6, 0), pedra, { mat = PEDRA }),
			P(braco, "bloco", V(1.1, 1.3, 1.1), V(lado * 1.8, 3.4, 0), pedraEscura, { mat = PEDRA }),
			P(perna, "bloco", V(1.1, 1.7, 1.1), V(lado * 0.7, 2.5, 0), pedra, { mat = PEDRA }),
			P(perna, "bloco", V(1.2, 1.6, 1.3), V(lado * 0.7, 0.85, -0.1), pedraEscura, { mat = PEDRA }),
		})
	end
	-- escudo-torre no braço esquerdo, com runas acesas
	juntar(p, {
		P("bracoE", "bloco", V(0.5, 5.2, 3), V(-2.6, 3.9, -0.8), pedra:Lerp(ESCURO, 0.1), { mat = PEDRA }),
		P("bracoE", "bloco", V(0.56, 5.4, 0.3), V(-2.6, 3.9, -2.35), pedraEscura, { mat = PEDRA }),
		P("bracoE", "bloco", V(0.56, 5.4, 0.3), V(-2.6, 3.9, 0.75), pedraEscura, { mat = PEDRA }),
		P("bracoE", "bloco", V(0.58, 0.25, 2), V(-2.65, 5.1, -0.8), runa, { neon = true }),
		P("bracoE", "bloco", V(0.58, 2.6, 0.25), V(-2.65, 3.9, -0.8), runa, { neon = true }),
		P("bracoE", "bloco", V(0.58, 0.25, 2), V(-2.65, 2.7, -0.8), runa, { neon = true }),
		-- martelo de pedra
		P("bracoD", "bloco", V(0.3, 0.3, 3), V(1.8, 2.8, -1.2), C(80, 60, 44), { mat = MADEIRA }),
		P("bracoD", "bloco", V(1.3, 1, 1.4), V(1.8, 2.8, -2.8), pedraEscura, { mat = PEDRA }),
	})
	return {
		estilo = "bipede",
		ossos = ossos,
		pecas = p,
		luzes = {
			{ osso = "corpo", pos = V(0, 5, -1.1), cor = runa, alcance = 10, brilho = 1.4 },
			{ osso = "bracoE", pos = V(-2.9, 3.9, -0.8), cor = runa, alcance = 9, brilho = 1.2 },
		},
		efeitos = { { osso = "bracoE", pos = V(-2.9, 3.9, -0.8), tipo = "brilho", cor = runa } },
		cor = pedra,
		ritmo = 0.8,
	}
end

-- Porta-Estandarte: kobold de guerra com bandeira vermelha nas costas e trombeta
function Modelos.portaEstandarte()
	local vermelho = C(200, 40, 40)
	local m = kobold(C(150, 82, 60))
	m.ossos.capa = osso("corpo", V(0, 3.6, 0.55))
	juntar(m.pecas, {
		-- elmo com chifres
		P("cabeca", "elipse", V(1.35, 0.7, 1.4), V(0, 4.35, -0.05), C(110, 100, 96), { mat = METAL }),
		P("cabeca", "canto", V(0.25, 0.8, 0.35), V(-0.7, 4.75, 0), C(230, 220, 200), { rot = R(0, 90, 30) }),
		P("cabeca", "canto", V(0.25, 0.8, 0.35), V(0.7, 4.75, 0), C(230, 220, 200), { rot = R(0, -90, -30) }),
		-- mastro e bandeira (balança com a "capa")
		P("corpo", "cilindro", V(7, 0.18, 0.18), V(0, 4.6, 0.6), C(90, 62, 40), { rot = EM_PE, mat = MADEIRA }),
		P("corpo", "bola", V(0.4, 0.4, 0.4), V(0, 8.15, 0.6), C(255, 200, 80), { neon = true }),
		P("capa", "bloco", V(2.2, 2.6, 0.12), V(0, 6.6, 0.68), vermelho, { mat = TECIDO }),
		P("capa", "bloco", V(0.9, 0.9, 0.14), V(0, 6.7, 0.66), C(255, 200, 80), { neon = true, rot = R(0, 0, 45) }),
		P("capa", "canto", V(1.1, 0.9, 0.12), V(-0.55, 4.9, 0.68), vermelho, { mat = TECIDO, rot = R(0, 0, 180) }),
		P("capa", "canto", V(1.1, 0.9, 0.12), V(0.55, 4.9, 0.68), vermelho, { mat = TECIDO, rot = R(0, 180, 180) }),
		-- trombeta de guerra
		P("bracoD", "cilindro", V(1.4, 0.32, 0.32), V(0.95, 2.2, -0.6), C(210, 170, 90), { mat = METAL, rot = R(0, 90, 0) }),
		P("bracoD", "cilindro", V(0.3, 0.7, 0.7), V(0.95, 2.2, -1.35), C(210, 170, 90), { mat = METAL, rot = R(0, 90, 0) }),
		-- tabardo
		P("corpo", "bloco", V(1.3, 1.6, 0.12), V(0, 2.7, -0.55), vermelho, { mat = TECIDO }),
	})
	m.luzes = { { osso = "corpo", pos = V(0, 8.15, 0.6), cor = C(255, 190, 90), alcance = 12, brilho = 1.4 } }
	m.efeitos = { { osso = "corpo", pos = V(0, 8.2, 0.6), tipo = "chama", cor = C(255, 170, 70) } }
	return m
end

-- Modelo genérico caso surja um tipo sem aparência própria
function Modelos.padrao()
	return gosma(C(200, 200, 200))
end

return Modelos
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000043">
          <Properties>
            <string name="Name">Poses</string>
            <ProtectedString name="Source"><![CDATA[-- Poses e animações dos personagens (só dados e contas: pode ser testado fora do Roblox).
--
-- Cada animação é uma lista de "quadros-chave": em cada tempo, o ângulo de algumas juntas
-- (ombro, cotovelo, cintura...). Entre os quadros, os valores são suavizados.
--
-- Cada valor tem 7 números: rx, ry, rz (ângulos em radianos), px, py, pz (deslocamento) e
-- w (peso, de 0 a 1). Com peso 0 a junta volta para a animação de baixo (postura, andar...).
-- Toda animação começa com peso 0 nas juntas que ainda não estavam em uso e, no campo
-- "voltar", solta todas as juntas devagar: o golpe sai da pose de combate e volta para ela.
--
-- Espaço da peça "pai" (X = direita, Y = cima, Z = trás):
--   rx > 0 leva o braço/perna para FRENTE (1,57 = esticado para frente; 3,14 = para cima)
--   ry > 0 gira para a ESQUERDA (visto de cima)   rz > 0 abre o braço direito para o lado
--   no tronco (cintura), rx < 0 inclina para frente; joelho < 0 dobra
-- Valores especiais: "puxar" (corda do arco, 0 a 1,3) e "brilho" (cristal do cajado).

local Poses = {}

local function A(rx: number?, ry: number?, rz: number?, px: number?, py: number?, pz: number?)
	return { rx or 0, ry or 0, rz or 0, px or 0, py or 0, pz or 0, 1 }
end
Poses.A = A

local SOLTO = { 0, 0, 0, 0, 0, 0, 0 }
Poses.SOLTO = SOLTO

local function solto(v)
	return { v[1], v[2], v[3], v[4], v[5], v[6], 0 }
end

local function juntar(base, extra)
	local resultado = table.clone(base)
	for chave, valor in extra do
		resultado[chave] = valor
	end
	return resultado
end

local PI = math.pi

local function suavizar(tipo: string?, a: number): number
	if tipo == "linear" then
		return a
	elseif tipo == "forte" then
		return 1 - (1 - a) ^ 4
	end
	return 1 - (1 - a) * (1 - a)
end

local function misturar(a, b, alfa: number)
	return {
		a[1] + (b[1] - a[1]) * alfa,
		a[2] + (b[2] - a[2]) * alfa,
		a[3] + (b[3] - a[3]) * alfa,
		a[4] + (b[4] - a[4]) * alfa,
		a[5] + (b[5] - a[5]) * alfa,
		a[6] + (b[6] - a[6]) * alfa,
		(a[7] or 1) + ((b[7] or 1) - (a[7] or 1)) * alfa,
	}
end
Poses.misturar = misturar

-- Ângulo equivalente entre -π e π (depois de um giro de 360°, a próxima animação parte de
-- perto de zero em vez de "desgirar")
local function angulo(a: number): number
	return (a + PI) % (2 * PI) - PI
end
Poses.angulo = angulo

------------------------------------------------------------------------
-- Postura (sempre, da cintura para cima) e pose parada (corpo todo)
------------------------------------------------------------------------

Poses.POSTURAS = {
	-- espada à frente e escudo erguido à frente do lado esquerdo (também enquanto anda)
	cavaleiro = {
		ombroD = A(0.49, -0.25, 0.37),
		cotoveloD = A(1.28),
		pulsoD = A(-0.59, -0.03, 0.9),
		ombroE = A(0.15, 0, -0.14),
		cotoveloE = A(0.35),
		pescoco = A(-0.05),
	},
	-- cajado em pé do lado de fora do corpo (não atravessa o tronco nem as pernas)
	mago = { ombroD = A(0.08, -0.14, 0.38), cotoveloD = A(1.42), pulsoD = A(-1.7, -0.35, -0.1), ombroE = A(0.15, 0, -0.12), cintura = A(0.06) },
	arqueiro = { ombroE = A(0.45, 0.2, -0.1), cotoveloE = A(0.3), ombroD = A(0.15, 0, 0.1) },
	-- o Assassino anda sempre curvado, com as adagas baixas e à frente
	assassino = {
		cintura = A(-0.3),
		pescoco = A(0.22),
		ombroD = A(0.55, 0, 0.3),
		cotoveloD = A(1.2),
		pulsoD = A(-0.3),
		ombroE = A(0.75, 0.25, -0.3),
		cotoveloE = A(1.35),
		pulsoE = A(-0.3),
	},
}

-- "t" é o tempo em segundos (para respirar e balançar de leve)
Poses.PARADO = {
	-- Guarda firme: base larga, escudo à frente, espada pronta
	cavaleiro = function(t: number)
		local respirar = math.sin(t * 1.6) * 0.025
		return {
			-- base aberta, peso um pouco à frente, peito aberto
			raiz = A(0, -0.2, 0, 0, -0.15 + respirar * 0.5, 0),
			cintura = A(-0.04 + respirar, 0.08),
			pescoco = A(-0.04, 0.12),
			ombroD = A(0.49, -0.25, 0.37),
			cotoveloD = A(1.28),
			pulsoD = A(-0.59, -0.03, 0.9),
			ombroE = A(0.12 + respirar, 0, -0.16),
			cotoveloE = A(0.3),
			pulsoE = A(0),
			quadrilD = A(-0.12, 0, 0.24),
			joelhoD = A(-0.25),
			tornozeloD = A(0.1),
			quadrilE = A(0.22, 0, -0.24),
			joelhoE = A(-0.35),
			tornozeloE = A(0.12),
		}
	end,
	-- Levitando, ereto e confiante: cajado em pé, a outra mão conjura uma luz (a altura e as
	-- pernas soltas vêm de Poses.FLUTUAR)
	mago = function(t: number)
		return {
			raiz = A(0, math.sin(t * 0.7) * 0.06, math.sin(t * 1.1) * 0.03),
			cintura = A(0.1 + math.sin(t * 1.4) * 0.02),
			pescoco = A(-0.14),
			ombroD = A(0.08, -0.14, 0.38),
			cotoveloD = A(1.42),
			pulsoD = A(-1.7, -0.35, -0.1),
			ombroE = A(0.75, 0.35, -0.25),
			cotoveloE = A(1.35),
			pulsoE = A(0.45 + math.sin(t * 2) * 0.1),
			brilho = A(0.35 + math.sin(t * 2) * 0.1),
		}
	end,
	-- Relaxado, peso numa perna, arco baixo, olhando em volta
	arqueiro = function(t: number)
		return {
			raiz = A(0, -0.25, 0.07),
			cintura = A(0.02, 0.15, -0.05),
			pescoco = A(0, math.sin(t * 0.6) * 0.45),
			ombroE = A(0.25, 0, -0.18),
			cotoveloE = A(0.25),
			ombroD = A(-0.12, 0, 0.18),
			cotoveloD = A(0.5),
			quadrilD = A(0, 0, 0.1),
			quadrilE = A(0.18, 0, -0.16),
			joelhoE = A(-0.35),
			tornozeloE = A(0.15),
		}
	end,
	-- Agachado e inclinado para frente, pronto para dar o bote
	assassino = function(t: number)
		local respirar = math.sin(t * 3.2) * 0.04
		return {
			raiz = A(0, 0.3, 0, 0, -0.42 + respirar, 0),
			cintura = A(-0.5 + respirar, -0.2),
			pescoco = A(0.42, 0.15 + math.sin(t * 0.8) * 0.15),
			ombroD = A(0.7, 0, 0.4),
			cotoveloD = A(1.35),
			pulsoD = A(-0.35),
			ombroE = A(1, 0.35, -0.35),
			cotoveloE = A(1.55),
			pulsoE = A(-0.35),
			quadrilD = A(0.65, 0, 0.15),
			joelhoD = A(-1.1),
			tornozeloD = A(0.42),
			quadrilE = A(0.35, 0, -0.2),
			joelhoE = A(-1),
			tornozeloE = A(0.6),
		}
	end,
}

------------------------------------------------------------------------
-- Andar feito por código: substitui a animação de andar do Roblox (que vem do avatar de
-- cada jogador e pode ser de qualquer estilo). Só as classes que estão aqui usam.
--   fase: ciclo da passada em radianos (uma volta = dois passos)
--   frente, lado: direção do movimento em relação ao corpo (de -1 a 1)
--   forca: 0 (devagar) a 1 (correndo)
------------------------------------------------------------------------

Poses.ANDAR = {
	-- Mago: não anda, desliza no ar. O corpo inclina para onde vai (e de lado nas curvas), o
	-- cajado vai à frente e a outra mão fica para trás, como quem voa.
	mago = function(fase: number, frente: number, lado: number, forca: number)
		local balanco = math.sin(fase * 0.5)
		return {
			raiz = A(-0.22 * frente * forca, 0, 0.14 * lado * forca + 0.03 * balanco),
			cintura = A(-0.08 * frente * forca, 0.05 * balanco),
			pescoco = A(0.15 * frente * forca),
			-- cajado inclinado para a frente, do lado de fora do corpo
			ombroD = A(-0.07, 0.1, 1.03),
			cotoveloD = A(1.41),
			pulsoD = A(-1.72, -1.15, -0.03),
			ombroE = A(-0.35 * forca, 0.2, -0.45),
			cotoveloE = A(0.45),
			pulsoE = A(0.2),
			brilho = A(0.4),
		}
	end,
	-- Cavaleiro: andar solto e confiante. Pernas bem afastadas, passos longos, peito aberto e o
	-- quadril sem rebolar. A espada vai em guarda aberta (para cima e para fora) e o escudo
	-- vai solto ao lado do corpo, balançando com o passo.
	cavaleiro = function(fase: number, frente: number, lado: number, forca: number)
		local s = math.sin(fase)
		local amplitude = 0.45 + 0.3 * forca
		local function perna(f: number, abertura: number)
			local sf, cf = math.sin(f), math.cos(f)
			local quadril = A(amplitude * frente * sf, 0, abertura + amplitude * 0.7 * lado * sf)
			local joelho = A(-(0.15 + (0.7 + 0.5 * forca) * math.max(0, cf)))
			local tornozelo = A(0.12 + 0.22 * math.max(0, cf) - 0.18 * forca * math.max(0, -sf))
			return quadril, joelho, tornozelo
		end
		local quadrilD, joelhoD, tornozeloD = perna(fase, 0.2)
		local quadrilE, joelhoE, tornozeloE = perna(fase + PI, -0.2)
		local pisada = math.cos(2 * fase)
		local balanco = 0.22 * frente * forca
		return {
			raiz = A(-0.08 - 0.04 * forca, 0.06 * s * frente, 0, 0, -0.15 - 0.05 * forca * pisada, 0),
			cintura = A(-0.08, -0.08 * s * frente),
			pescoco = A(0.03, 0.03 * s * frente),
			ombroD = A(0.49 - 0.05 * balanco * s, -0.25, 0.37),
			cotoveloD = A(1.28),
			pulsoD = A(-0.59, -0.03, 0.9),
			-- braço do escudo solto: vai para a frente quando a perna direita vai
			ombroE = A(0.15 + balanco * s, 0, -0.14),
			cotoveloE = A(0.35 + 0.1 * forca),
			pulsoE = A(0),
			quadrilD = quadrilD,
			joelhoD = joelhoD,
			tornozeloD = tornozeloD,
			quadrilE = quadrilE,
			joelhoE = joelhoE,
			tornozeloE = tornozeloE,
		}
	end,
	-- Arqueiro: passos leves e rápidos de caçador, o corpo um pouco inclinado para a frente e a
	-- cabeça firme olhando adiante. O arco vai baixo na mão esquerda, com a ponta de cima para a
	-- frente, e a mão da corda balança solta perto do quadril.
	arqueiro = function(fase: number, frente: number, lado: number, forca: number)
		local s = math.sin(fase)
		local amplitude = 0.5 + 0.35 * forca
		local function perna(f: number, abertura: number)
			local sf, cf = math.sin(f), math.cos(f)
			local quadril = A(amplitude * frente * sf - 0.05, 0, abertura + amplitude * 0.7 * lado * sf)
			-- joelho sobe mais (passo ágil, quase na ponta dos pés quando corre)
			local joelho = A(-(0.2 + (0.8 + 0.6 * forca) * math.max(0, cf)))
			local tornozelo = A(0.15 + 0.25 * math.max(0, cf) - 0.25 * forca * math.max(0, -sf))
			return quadril, joelho, tornozelo
		end
		local quadrilD, joelhoD, tornozeloD = perna(fase, 0.1)
		local quadrilE, joelhoE, tornozeloE = perna(fase + PI, -0.1)
		local pisada = math.cos(2 * fase)
		local balanco = (0.3 + 0.2 * forca) * frente
		local inclinacao = 0.1 + 0.1 * forca
		return {
			raiz = A(-inclinacao * frente, 0.08 * s * frente, -0.04 * lado, 0, -0.12 - 0.08 * forca * pisada, 0),
			cintura = A(-0.04, -0.1 * s * frente),
			-- a cabeça compensa a inclinação e fica olhando para a frente
			pescoco = A(inclinacao * 0.8, 0.05 * s * frente),
			-- arco: braço quase solto, um pouco à frente, balançando pouco (o arco pesa)
			ombroE = A(0.3 + 0.35 * balanco * s, 0.15, -0.16),
			cotoveloE = A(0.35 + 0.15 * forca),
			pulsoE = A(0.1),
			-- mão da corda: vai e volta com o passo, mais dobrada quando corre
			ombroD = A(0.05 - balanco * s, 0, 0.14),
			cotoveloD = A(0.35 + 0.35 * forca + 0.15 * math.max(0, -s)),
			pulsoD = A(0),
			quadrilD = quadrilD,
			joelhoD = joelhoD,
			tornozeloD = tornozeloD,
			quadrilE = quadrilE,
			joelhoE = joelhoE,
			tornozeloE = tornozeloE,
		}
	end,
}

-- Corrida leve (Shift), por cima do andar. Como numa corrida de verdade: o corpo inclina para
-- a frente (a partir do tornozelo, não dobrando a cintura), os cotovelos dobram perto de 90° e
-- os braços balançam ao contrário das pernas, o joelho sobe mais na volta da perna e o corpo
-- "flutua" um pouco entre um apoio e outro.
local function pernasDeCorrida(fase: number, frente: number, lado: number, dobra: number)
	local function perna(f: number, abertura: number)
		local sf, cf = math.sin(f), math.cos(f)
		local quadril = A(dobra + 0.9 * frente * sf, 0, abertura + 0.5 * lado * sf)
		local joelho = A(-(0.3 + dobra + 1.5 * math.max(0, cf)))
		local tornozelo = A(0.25 + 0.35 * math.max(0, cf) - 0.35 * math.max(0, -sf))
		return quadril, joelho, tornozelo
	end
	local quadrilD, joelhoD, tornozeloD = perna(fase, 0.12)
	local quadrilE, joelhoE, tornozeloE = perna(fase + PI, -0.12)
	return {
		quadrilD = quadrilD,
		joelhoD = joelhoD,
		tornozeloD = tornozeloD,
		quadrilE = quadrilE,
		joelhoE = joelhoE,
		tornozeloE = tornozeloE,
	}
end

Poses.CORRER = {
	-- espada pronta perto do corpo, o escudo balança com o passo
	cavaleiro = function(fase: number, frente: number, lado: number)
		local s = math.sin(fase)
		local pose = pernasDeCorrida(fase, frente, lado, 0)
		pose.raiz = A(-0.2 * frente, 0.1 * s * frente, -0.05 * lado, 0, -0.2 + 0.18 * math.abs(math.cos(fase)), 0)
		pose.cintura = A(-0.06, -0.14 * s * frente)
		pose.pescoco = A(0.14, 0.06 * s * frente)
		pose.ombroD = A(0.35 - 0.3 * s, -0.2, 0.3)
		pose.cotoveloD = A(1.5)
		pose.pulsoD = A(-0.59, -0.03, 0.9)
		pose.ombroE = A(0.25 + 0.55 * s, 0, -0.15)
		pose.cotoveloE = A(1.4)
		return pose
	end,
	-- arco baixo na mão, a mão da corda bate o ritmo
	arqueiro = function(fase: number, frente: number, lado: number)
		local s = math.sin(fase)
		local pose = pernasDeCorrida(fase, frente, lado, 0.05)
		pose.raiz = A(-0.25 * frente, 0.1 * s * frente, -0.05 * lado, 0, -0.18 + 0.2 * math.abs(math.cos(fase)), 0)
		pose.cintura = A(-0.05, -0.14 * s * frente)
		pose.pescoco = A(0.2, 0.06 * s * frente)
		pose.ombroE = A(0.2 + 0.5 * s, 0.1, -0.15)
		pose.cotoveloE = A(0.7)
		pose.ombroD = A(-0.6 * s, 0, 0.12)
		pose.cotoveloD = A(1.55)
		return pose
	end,
	-- corrida de ninja: bem inclinado, braços esticados para trás, cabeça erguida
	assassino = function(fase: number, frente: number, lado: number)
		local s = math.sin(fase)
		local pose = pernasDeCorrida(fase, frente, lado, 0.35)
		pose.raiz = A(-0.55 * frente, 0.08 * s * frente, -0.06 * lado, 0, -0.45 + 0.12 * math.abs(math.cos(fase)), 0)
		pose.cintura = A(-0.15, -0.08 * s * frente)
		pose.pescoco = A(0.65, 0.04 * s * frente)
		pose.ombroD = A(-1.25 - 0.12 * s, 0, 0.25)
		pose.ombroE = A(-1.25 + 0.12 * s, 0, -0.25)
		pose.cotoveloD = A(0.15)
		pose.cotoveloE = A(0.15)
		pose.pulsoD = A(-1.05)
		pose.pulsoE = A(-1.05)
		return pose
	end,
	-- o Mago voa mais deitado, a mão livre para trás (as pernas vêm da levitação)
	mago = function(fase: number, frente: number, lado: number)
		local balanco = math.sin(fase * 0.5)
		return {
			raiz = A(-0.45 * frente, 0, 0.18 * lado + 0.04 * balanco),
			cintura = A(-0.15 * frente, 0.05 * balanco),
			pescoco = A(0.35 * frente),
			ombroE = A(-0.8, 0.2, -0.5),
			cotoveloE = A(0.3),
			pulsoE = A(0.3),
			brilho = A(0.7),
		}
	end,
}

-- Distância (em studs) de um ciclo inteiro da passada (dois passos). Quem não está aqui usa 8.
Poses.PASSADA = { arqueiro = 6.5, assassino = 7 }

-- Assassino: corrida de ninja, baixa e silenciosa. Agachado, o tronco bem inclinado e a cabeça
-- erguida olhando o alvo. Andando devagar, as adagas ficam em guarda na frente; correndo, os
-- braços vão para trás com as lâminas apontando para trás.
Poses.ANDAR.assassino = function(fase: number, frente: number, lado: number, forca: number)
	local s = math.sin(fase)
	local amplitude = 0.55 + 0.3 * forca
	local function perna(f: number, abertura: number)
		local sf, cf = math.sin(f), math.cos(f)
		-- quadril já dobrado (agachado) e joelho sempre flexionado
		local quadril = A(0.3 + amplitude * frente * sf, 0, abertura + amplitude * 0.6 * lado * sf)
		local joelho = A(-(0.45 + (0.8 + 0.5 * forca) * math.max(0, cf)))
		local tornozelo = A(0.25 + 0.2 * math.max(0, cf) - 0.2 * forca * math.max(0, -sf))
		return quadril, joelho, tornozelo
	end
	local quadrilD, joelhoD, tornozeloD = perna(fase, 0.12)
	local quadrilE, joelhoE, tornozeloE = perna(fase + PI, -0.12)
	local pisada = math.cos(2 * fase)
	local inclinacao = 0.3 + 0.15 * forca
	-- braços: da guarda na frente (devagar) para trás (correndo)
	local bracos = 0.45 - 1.45 * forca
	local balanco = 0.25 * (1 - forca) * frente
	-- correndo, o pulso deita a lâmina ao longo do braço (apontando para trás)
	local pulso = -0.3 - 0.75 * forca
	return {
		raiz = A(-inclinacao * frente, 0.06 * s * frente, -0.05 * lado, 0, -0.38 - 0.06 * pisada, 0),
		cintura = A(-0.12, -0.08 * s * frente),
		pescoco = A(inclinacao + 0.1, 0.04 * s * frente),
		ombroD = A(bracos - balanco * s, 0, 0.3 - 0.15 * forca),
		cotoveloD = A(0.9 - 0.7 * forca),
		pulsoD = A(pulso),
		ombroE = A(bracos + balanco * s, 0, -0.3 + 0.15 * forca),
		cotoveloE = A(0.9 - 0.7 * forca),
		pulsoE = A(pulso),
		quadrilD = quadrilD,
		joelhoD = joelhoD,
		tornozeloD = tornozeloD,
		quadrilE = quadrilE,
		joelhoE = joelhoE,
		tornozeloE = tornozeloE,
	}
end

------------------------------------------------------------------------
-- Levitação (Mago): o corpo fica sempre um pouco acima do chão, subindo e descendo devagar,
-- com as pernas soltas (pendentes parado, para trás quando desliza). Vale também nos ataques,
-- nas magias e na esquiva.
--   altura: quanto o corpo sobe   pernas(t, movendo): pose das pernas (movendo de 0 a 1)
------------------------------------------------------------------------

Poses.FLUTUAR = {
	mago = {
		altura = 1.3,
		balanco = 0.18,
		pernas = function(t: number, movendo: number)
			local m = movendo
			local onda = math.sin(t * 1.8)
			return {
				quadrilD = A(0.18 - 0.5 * m + 0.04 * onda, 0, 0.06),
				joelhoD = A(-0.35 - 0.35 * m),
				tornozeloD = A(-0.45),
				quadrilE = A(0.32 - 0.6 * m - 0.04 * onda, 0, -0.08),
				joelhoE = A(-0.7 - 0.25 * m),
				tornozeloE = A(-0.5),
			}
		end,
	},
}

