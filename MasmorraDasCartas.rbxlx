-- Elites: versões mais fortes com um poder especial
Inimigos.ELITES = {
	Blindado = { cor = Color3.fromRGB(205, 215, 235), vida = 1.8, armadura = 0.3 },
	Veloz = { cor = Color3.fromRGB(255, 232, 80), velocidade = 1.45, recarga = 0.7 },
	["Gélido"] = { cor = Color3.fromRGB(120, 210, 255), gelido = true },
	Explosivo = { cor = Color3.fromRGB(255, 120, 40), explosivo = true },
	Gigante = { cor = Color3.fromRGB(255, 80, 80), escala = 1.45, vida = 2.5, dano = 1.3 },
}
Inimigos.LISTA_ELITES = { "Blindado", "Veloz", "Gélido", "Explosivo", "Gigante" }

------------------------------------------------------------------------
-- Criação
------------------------------------------------------------------------

local function criarCaixa(nome: string, tamanho: Vector3, quadril: number)
	local modelo = Instance.new("Model")
	modelo.Name = nome

	local raiz = Instance.new("Part")
	raiz.Name = "HumanoidRootPart"
	raiz.Size = tamanho
	raiz.Transparency = 1
	raiz.CanCollide = true
	raiz.CFrame = CFrame.new()
	raiz.Parent = modelo
	modelo.PrimaryPart = raiz

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = quadril
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.Parent = modelo
	-- A vida é controlada pelo nosso código; o Humanoid só serve para andar
	for _, estado in {
		Enum.HumanoidStateType.Dead,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Climbing,
		Enum.HumanoidStateType.Seated,
	} do
		humanoid:SetStateEnabled(estado, false)
	end
	return modelo, raiz, humanoid
end

-- "posicao" é um ponto no chão. mult = { vida, dano }. elite = nome da elite ou nil.
function Inimigos.criar(run, tipo: string, posicao: Vector3, mult, elite: string?)
	local def = Inimigos.TIPOS[tipo]
	local modificador = elite and Inimigos.ELITES[elite]
	local escala = if modificador then modificador.escala or 1 else 1
	-- chefes usam a vida do grupo própria deles (sobe mais por jogador: todos batem nele)
	local multVida = if def.chefe and mult.vidaChefe then mult.vidaChefe else mult.vida
	local vida = def.vida * multVida * (if modificador then 1.5 * (modificador.vida or 1) else 1)
	local multDano = if def.chefe and mult.danoChefe then mult.danoChefe else mult.dano
	local dano = def.dano * multDano * (if modificador then modificador.dano or 1 else 1)

	local modelo, raiz, humanoid = criarCaixa(def.nome, def.raiz * escala, def.quadril * escala)
	local alturaRaiz = def.quadril * escala + def.raiz.Y * escala / 2

	modelo:SetAttribute("Tipo", tipo)
	modelo:SetAttribute("Nome", def.nome)
	modelo:SetAttribute("Titulo", def.titulo or "")
	modelo:SetAttribute("Chefe", def.chefe == true)
	modelo:SetAttribute("Elite", elite or "")
	modelo:SetAttribute("Escala", escala)
	modelo:SetAttribute("Vida", vida)
	modelo:SetAttribute("VidaMax", vida)
	modelo:SetAttribute("AlturaBarra", def.alturaBarra * escala)
	modelo:SetAttribute("Acao", "")
	modelo:SetAttribute("Furioso", false)
	CollectionService:AddTag(modelo, "Inimigo")

	local centroSala = if run.sala then run.sala.origem else posicao
	local olhar = unidade(centroSala - posicao, Vector3.new(0, 0, -1))
	modelo:PivotTo(CFrame.lookAt(posicao + Vector3.new(0, alturaRaiz + 0.2, 0), posicao + Vector3.new(0, alturaRaiz + 0.2, 0) + olhar))
	modelo.Parent = run.pasta
	pcall(function()
		raiz:SetNetworkOwner(nil) -- o servidor controla o movimento
	end)

	local ataques = {}
	for _, ataque in def.ataques do
		table.insert(ataques, ataque)
	end

	local agora = os.clock()
	local inimigo = {
		tipo = tipo,
		def = def,
		modelo = modelo,
		raiz = raiz,
		humanoid = humanoid,
		vida = vida,
		vidaMax = vida,
		dano = dano,
		mult = mult,
		escala = escala,
		raio = def.raio * escala,
		alturaRaiz = alturaRaiz,
		alturaBarra = def.alturaBarra * escala,
		armadura = (def.armadura or 0) + (if modificador then modificador.armadura or 0 else 0),
		pesado = def.pesado == true or escala > 1.2,
		chefe = def.chefe == true,
		elite = elite,
		modificador = modificador,
		velocidadeMult = if modificador then modificador.velocidade or 1 else 1,
		recargaMult = if modificador then modificador.recarga or 1 else 1,
		-- chefe em grupo: golpes voltam mais rápido e a postura aguenta mais (Config)
		recargaGrupo = if def.chefe then mult.recargaChefe or 1 else 1,
		posturaMax = if def.posturaMax then def.posturaMax * (if def.chefe then mult.posturaChefe or 1 else 1) else nil,
		ouro = def.ouro * (if elite then 3 else 1),
		vivo = true,
		ameaca = {},
		ataques = ataques,
		prontoEm = {},
		ocupadoAte = agora + 0.4,
		proximaDecisao = agora + math.random() * 0.2,
		lentoAte = 0,
		lentoFator = 1,
		atordoadoAte = 0,
		acaoN = 0,
		lado = if math.random() < 0.5 then -1 else 1,
		trocaLadoEm = agora + 2,
	}
	-- chefes, Ceifadores e quem luta de longe viram pelo nosso código: andam sempre de frente
	-- para o alvo (recuando ou rodeando, não mostram as costas)
	inimigo.encara = def.pausa ~= nil or def.encarar == true or (def.comportamento ~= nil and def.comportamento ~= "perseguir")
	if inimigo.encara then
		humanoid.AutoRotate = false
	end
	if def.maldicaoDoAlto then
		inimigo.proximaMaldicao = agora + (def.entrada or 0) + Config.MALDICAO_INTERVALO
	end
	if def.caveiras then
		inimigo.proximasCaveiras = agora + (def.entrada or 0) + Config.CAVEIRAS_INTERVALO
	end
	-- entrada de chefe: sobe do chão e ruge, sem atacar nem levar dano
	if def.entrada then
		inimigo.ocupadoAte = agora + def.entrada
		inimigo.invulneravelAte = agora + def.entrada
	end
	-- chefes começam a usar os golpes logo depois de despertar (Config.INICIO_ATAQUES_CHEFE)
	local inicioMult = if def.chefe then Config.INICIO_ATAQUES_CHEFE else 1
	for _, ataque in ataques do
		local inicial = ataque.inicial or math.random() * (ataque.recarga or 1) * 0.5
		inimigo.prontoEm[ataque] = agora + (def.entrada or 0) + inicial * inicioMult
	end
	run.inimigos[inimigo] = true
	return inimigo
end

------------------------------------------------------------------------
-- Ajudantes
------------------------------------------------------------------------

local function definirAcao(inimigo, nome: string)
	inimigo.acaoN += 1
	if inimigo.modelo.Parent then
		inimigo.modelo:SetAttribute("Acao", nome .. "|" .. inimigo.acaoN)
	end
end

local function podeContinuar(run, inimigo): boolean
	return inimigo.vivo and run.ativa and os.clock() >= inimigo.atordoadoAte
end

local function noChao(run, pos: Vector3): Vector3
	return Vector3.new(pos.X, if run.sala then run.sala.origem.Y else pos.Y, pos.Z)
end

local function limitarNaSala(run, pos: Vector3, margem: number): Vector3
	local sala = run.sala
	if not sala then
		return pos
	end
	local local_ = pos - sala.origem
	local x = math.clamp(local_.X, -sala.largura / 2 + margem + 1, sala.largura / 2 - margem - 1)
	local z = math.clamp(local_.Z, -sala.comprimento / 2 + margem + 1, sala.comprimento / 2 - margem - 1)
	return sala.origem + Vector3.new(x, local_.Y, z)
end

local function parar(inimigo)
	inimigo.humanoid:MoveTo(inimigo.raiz.Position)
end

local function olharPara(inimigo, alvo: Vector3)
	local pos = inimigo.raiz.Position
	local direcao = planar(alvo - pos)
	if direcao.Magnitude > 0.1 then
		inimigo.raiz.CFrame = CFrame.lookAt(pos, pos + direcao)
	end
end

local function jogadoresAtingiveis(run)
	local lista = {}
	for _, estado in run.jogadores do
		if estado.vivo and not estado.caido then
			local raiz = Combate.raizDe(estado)
			if raiz then
				table.insert(lista, { estado = estado, raiz = raiz })
			end
		end
	end
	return lista
end

local function opcoesDoEfeito(inimigo, efeito: string?)
	local opcoes = {}
	if efeito == "lento" or (inimigo.modificador and inimigo.modificador.gelido) then
		opcoes.lento = { fator = 0.6, duracao = 2 }
	end
	if efeito == "queimar" then
		opcoes.queimar = inimigo.dano * 0.15
	end
	if efeito == "maldicao" then
		opcoes.maldicao = Config.MALDICAO_DURACAO
	end
	return opcoes
end

-- Acerta os jogadores dentro de um cone (ou círculo, se arco >= 360)
local function acertarJogadores(run, inimigo, centro: Vector3, direcao: Vector3?, alcance: number, arco: number, mult: number, efeito: string?)
	local limite = math.cos(math.rad(math.min(arco, 359) / 2 + 10))
	for _, info in jogadoresAtingiveis(run) do
		local delta = planar(info.raiz.Position - centro)
		local distancia = delta.Magnitude
		if distancia <= alcance + 1.6 then
			local dentro = arco >= 360 or not direcao or distancia < 2 or delta.Unit:Dot(direcao) >= limite
			if dentro then
				Combate.danoAoJogador(run, info.estado, inimigo.dano * mult, inimigo, opcoesDoEfeito(inimigo, efeito))
			end
		end
	end
end

local function corDoEfeito(efeito: string?): Color3
	if efeito == "alma" then
		return Color3.fromRGB(90, 255, 120)
	elseif efeito == "queimar" then
		return Color3.fromRGB(255, 120, 40)
	elseif efeito == "lento" then
		return Color3.fromRGB(130, 210, 255)
	end
	return Color3.fromRGB(255, 70, 70)
end

local function contarInimigos(run): number
	local total = 0
	for _ in run.inimigos do
		total += 1
	end
	return total
end

------------------------------------------------------------------------
-- Ataques. Cada um devolve false se não pôde ser usado agora.
------------------------------------------------------------------------

local function ataqueGolpe(run, inimigo, ataque, alvoPos: Vector3, agora: number): boolean
	local alcance = ataque.alcance * inimigo.escala
	local arco = ataque.arco or 100
	local preparo = ataque.preparo * inimigo.recargaMult
	if ataque.atrasoVariavel then
		-- segura o golpe por um tempo diferente a cada vez (não dá para decorar o ritmo)
		local faixa = ataque.atrasoVariavel
		preparo *= faixa[1] + math.random() * (faixa[2] - faixa[1])
	end
	-- "anim" troca o nome da ação (prepararVarrida, golpeVarrida...) para o visual do chefe
	local nomePreparo = if ataque.anim then "preparar" .. ataque.anim elseif arco >= 360 then "prepararGiro" else "preparar"
	local nomeGolpe = if ataque.anim then "golpe" .. ataque.anim elseif arco >= 360 then "giro" else "golpe"
	local acertos = ataque.acertos or 1
	local entre = ataque.entreAcertos or 0.3
	local direcao = unidade(alvoPos - inimigo.raiz.Position, inimigo.raiz.CFrame.LookVector)
	local giro = arco >= 360

	parar(inimigo)
	olharPara(inimigo, alvoPos)
	definirAcao(inimigo, nomePreparo)
	inimigo.ocupadoAte = agora + preparo + (acertos - 1) * entre + 0.4
	Vfx.partida(run, "telegrafo", {
		dono = inimigo.modelo,
		forma = if giro then "circulo" else "cone",
		pos = noChao(run, inimigo.raiz.Position),
		dir = direcao,
		raio = alcance,
		arco = arco,
		duracao = preparo,
		chefe = inimigo.chefe,
	})

	task.delay(preparo, function()
		for i = 1, acertos do
			if not podeContinuar(run, inimigo) then
				return
			end
			definirAcao(inimigo, nomeGolpe)
			local centro = inimigo.raiz.Position
			Vfx.partida(run, "golpeInimigo", { pos = centro, dir = direcao, alcance = alcance, arco = arco, cor = corDoEfeito(ataque.efeito), tipo = inimigo.tipo, anim = ataque.anim, volta = ataque.volta or i % 2 == 0 })
			acertarJogadores(run, inimigo, centro, direcao, alcance, arco, ataque.mult or 1, ataque.efeito)
			if i < acertos then
				task.wait(entre)
			end
		end
		if ataque.preso and inimigo.vivo and math.random() < (ataque.presoChance or 1) then
			-- a lâmina fica presa no chão: ele demora para soltar e leva mais dano nesse tempo
			local fim = os.clock() + ataque.preso
			inimigo.ocupadoAte = math.max(inimigo.ocupadoAte, fim)
			inimigo.vulneravelAte = fim
			definirAcao(inimigo, "preso")
			Vfx.partida(run, "dano", {
				pos = inimigo.raiz.Position + Vector3.new(0, inimigo.alturaBarra * 0.7, 0),
				valor = "VULNERÁVEL!",
				cor = Color3.fromRGB(255, 225, 90),
			})
			task.delay(ataque.preso, function()
				if inimigo.vivo then
					definirAcao(inimigo, "")
				end
			end)
			return
		end
		task.delay(0.3, function()
			if inimigo.vivo then
				definirAcao(inimigo, "")
			end
		end)
	end)
	return true
end

local function ataqueDisparo(run, inimigo, ataque, alvo, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	parar(inimigo)
	definirAcao(inimigo, if ataque.anim then "preparar" .. ataque.anim else "conjurar")
	inimigo.ocupadoAte = agora + preparo + 0.35
	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		local raizAlvo = Combate.raizDe(alvo)
		local origem = inimigo.raiz.Position + Vector3.new(0, 0.8, 0)
		local destino = if raizAlvo and alvo.vivo then raizAlvo.Position else origem + inimigo.raiz.CFrame.LookVector * 10
		olharPara(inimigo, destino)
		definirAcao(inimigo, if ataque.anim then "golpe" .. ataque.anim else "disparo")
		local direcao = unidade(destino - origem, inimigo.raiz.CFrame.LookVector)
		local quantidade = ataque.quantidade or 1
		local abertura = ataque.espalhamento or 10
		local lista = {}
		for i = 1, quantidade do
			local angulo = math.rad((i - (quantidade + 1) / 2) * abertura)
			table.insert(lista, {
				lado = "inimigo",
				tipo = ataque.projetil,
				pos = origem + direcao * inimigo.raio,
				dir = CFrame.Angles(0, angulo, 0):VectorToWorldSpace(direcao),
				velocidade = ataque.velocidade or 45,
				alcance = (ataque.alcance or 45) * 1.3,
				raio = 1.1,
				aoAcertar = function(estado, _, projetil)
					-- o golpe vem de onde o projétil estava (para o escudo saber se foi de frente)
					local opcoes = opcoesDoEfeito(inimigo, ataque.efeito)
					opcoes.origem = projetil.pos - projetil.dir * 4
					Combate.danoAoJogador(run, estado, inimigo.dano * (ataque.mult or 1), inimigo, opcoes)
				end,
			})
		end
		Projeteis.disparar(run, lista)
		task.delay(0.3, function()
			if inimigo.vivo then
				definirAcao(inimigo, "")
			end
		end)
	end)
	return true
end

local function ataqueRajada(run, inimigo, ataque, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + preparo + 0.5
	Vfx.partida(run, "telegrafo", { forma = "circulo", pos = noChao(run, inimigo.raiz.Position), raio = inimigo.raio + 3, duracao = preparo, chefe = true, dono = inimigo.modelo })
	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		definirAcao(inimigo, "disparo")
		local quantidade = ataque.quantidade or 12
		local giro = math.random() * math.pi
		local origem = inimigo.raiz.Position
		local lista = {}
		for i = 1, quantidade do
			local angulo = giro + i * (math.pi * 2 / quantidade)
			local direcao = Vector3.new(math.sin(angulo), 0, math.cos(angulo))
			table.insert(lista, {
				lado = "inimigo",
				tipo = ataque.projetil,
				pos = origem + direcao * (inimigo.raio + 1),
				dir = direcao,
				velocidade = ataque.velocidade or 35,
				alcance = 70,
				raio = 1.2,
				aoAcertar = function(estado, _, projetil)
					-- o golpe vem de onde o projétil estava (para o escudo saber se foi de frente)
					local opcoes = opcoesDoEfeito(inimigo, ataque.efeito)
					opcoes.origem = projetil.pos - projetil.dir * 4
					Combate.danoAoJogador(run, estado, inimigo.dano * (ataque.mult or 1), inimigo, opcoes)
				end,
			})
		end
		Projeteis.disparar(run, lista)
		task.delay(0.4, function()
			if inimigo.vivo then
				definirAcao(inimigo, "")
			end
		end)
	end)
	return true
end

local function ataqueInvestida(run, inimigo, ataque, alvoPos: Vector3, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	local direcao = unidade(alvoPos - inimigo.raiz.Position, inimigo.raiz.CFrame.LookVector)
	local distancia = ataque.distancia * inimigo.escala
	local largura = ataque.largura * inimigo.escala

	parar(inimigo)
	olharPara(inimigo, alvoPos)
	definirAcao(inimigo, "prepararInvestida")
	inimigo.ocupadoAte = agora + preparo + 0.7
	Vfx.partida(run, "telegrafo", {
		dono = inimigo.modelo,
		forma = "linha",
		pos = noChao(run, inimigo.raiz.Position),
		dir = direcao,
		comprimento = distancia,
		largura = largura,
		duracao = preparo,
		chefe = inimigo.chefe,
	})

	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		definirAcao(inimigo, "investida")
		local destino = limitarNaSala(run, inimigo.raiz.Position + direcao * distancia, inimigo.raio)
		inimigo.investindo = true
		inimigo.humanoid.WalkSpeed = 75
		inimigo.humanoid:MoveTo(destino)
		local atingidos = {}
		local fim = os.clock() + 0.5
		while os.clock() < fim and inimigo.vivo and run.ativa do
			for _, info in jogadoresAtingiveis(run) do
				if not atingidos[info.estado] and planar(info.raiz.Position - inimigo.raiz.Position).Magnitude <= inimigo.raio + largura / 2 + 0.5 then
					atingidos[info.estado] = true
					Combate.danoAoJogador(run, info.estado, inimigo.dano * (ataque.mult or 1), inimigo, opcoesDoEfeito(inimigo, ataque.efeito))
				end
			end
			task.wait(0.05)
		end
		inimigo.investindo = false
		if inimigo.vivo then
			parar(inimigo)
			definirAcao(inimigo, "")
		end
	end)
	return true
end

local function ataqueSalto(run, inimigo, ataque, alvoPos: Vector3, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	local voo = ataque.voo or 0.6
	local raio = ataque.raio * inimigo.escala
	local destino = limitarNaSala(run, noChao(run, alvoPos), inimigo.raio)

	parar(inimigo)
	olharPara(inimigo, alvoPos)
	definirAcao(inimigo, "prepararSalto")
	inimigo.ocupadoAte = agora + preparo + voo + 0.45
	Vfx.partida(run, "telegrafo", { forma = "circulo", pos = destino, raio = raio, duracao = preparo + voo, chefe = inimigo.chefe, dono = inimigo.modelo })

	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		definirAcao(inimigo, "salto")
		local chegada = destino + Vector3.new(0, inimigo.alturaRaiz, 0)
		Vfx.partida(run, "salto", { modelo = inimigo.modelo, de = inimigo.raiz.Position, para = chegada, duracao = voo })
		task.delay(voo, function()
			if not inimigo.vivo or not run.ativa then
				return
			end
			local olhar = unidade(destino - inimigo.raiz.Position, inimigo.raiz.CFrame.LookVector)
			inimigo.modelo:PivotTo(CFrame.lookAt(chegada, chegada + olhar))
			Vfx.partida(run, "impacto", { pos = destino, raio = raio, cor = corDoEfeito(ataque.efeito), forte = inimigo.chefe, tipo = inimigo.tipo, quebrar = ataque.tremor })
			acertarJogadores(run, inimigo, destino, nil, raio, 360, ataque.mult or 1, ataque.efeito)
			definirAcao(inimigo, "")
			if ataque.tremor then
				-- o chão continua rachando: dois anéis de tremor saem do ponto da queda
				for i, extra in { 7, 15 } do
					local anel = raio + extra
					local atraso = 0.25 + 0.3 * i
					Vfx.partida(run, "anelPerigo", { pos = destino, raio = anel, largura = 2.5, duracao = atraso, cor = corDoEfeito("alma"), tipo = inimigo.tipo })
					task.delay(atraso, function()
						if not run.ativa then
							return
						end
						Vfx.partida(run, "anelExplode", { pos = destino, raio = anel, largura = 2.5, cor = corDoEfeito("alma"), tipo = inimigo.tipo })
						for _, info in jogadoresAtingiveis(run) do
							if math.abs(planar(info.raiz.Position - destino).Magnitude - anel) <= 2.5 then
								Combate.danoAoJogador(run, info.estado, inimigo.dano * 0.6, inimigo, { origem = destino })
							end
						end
					end)
				end
			end
		end)
	end)
	return true
end

local function ataqueExplodir(run, inimigo, ataque, agora: number): boolean
	local raio = ataque.raio * inimigo.escala
	parar(inimigo)
	definirAcao(inimigo, "prepararExplosao")
	inimigo.ocupadoAte = agora + 99
	Vfx.partida(run, "telegrafo", { forma = "circulo", pos = noChao(run, inimigo.raiz.Position), raio = raio, duracao = ataque.preparo, dono = inimigo.modelo })
	task.delay(ataque.preparo, function()
		if not inimigo.vivo or not run.ativa then
			return
		end
		local centro = inimigo.raiz.Position
		Vfx.partida(run, "explosao", { pos = centro, raio = raio, cor = ataque.cor or Color3.fromRGB(255, 140, 40), forte = true })
		acertarJogadores(run, inimigo, centro, nil, raio, 360, ataque.mult or 1, ataque.efeito)
		run:aoMorrerInimigo(inimigo, nil)
	end)
	return true
end

local function ataqueInvocar(run, inimigo, ataque, agora: number): boolean
	if contarInimigos(run) >= (ataque.maxVivos or 12) or not run.sala then
		return false
	end
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + ataque.preparo + 0.4
	if inimigo.chefe then
		-- o chefe ergue a arma e chama: a tela treme e a terra começa a rachar
		Vfx.partida(run, "chamado", { modelo = inimigo.modelo, pos = noChao(run, inimigo.raiz.Position), duracao = ataque.preparo, tipo = inimigo.tipo })
	end
	task.delay(ataque.preparo, function()
		if not podeContinuar(run, inimigo) or not run.sala then
			return
		end
		for i = 1, ataque.quantidade or 2 do
			local angulo = i * (math.pi * 2 / (ataque.quantidade or 2)) + math.random()
			local pos = noChao(run, inimigo.raiz.Position + Vector3.new(math.cos(angulo), 0, math.sin(angulo)) * (inimigo.raio + 5))
			pos = limitarNaSala(run, pos, 2)
			if Masmorra.posicaoValida(run.sala, pos, 1.5) then
				if inimigo.chefe then
					-- o chão racha onde cada servo do chefe sobe
					Vfx.partida(run, "invocacao", { pos = pos, tipo = inimigo.tipo })
				end
				run:invocar(ataque.invocado, pos, nil)
			end
		end
		definirAcao(inimigo, "")
	end)
	return true
end

local function ataqueArea(run, inimigo, ataque, agora: number): boolean
	if not run.sala then
		return false
	end
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + ataque.preparo + 0.4
	task.delay(ataque.preparo, function()
		if not podeContinuar(run, inimigo) or not run.sala then
			return
		end
		local pontos = {}
		local alvos = jogadoresAtingiveis(run)
		for _, info in alvos do
			table.insert(pontos, noChao(run, info.raiz.Position))
		end
		while #pontos < (ataque.quantidade or 3) and #alvos > 0 do
			local base = alvos[math.random(#alvos)].raiz.Position
			table.insert(pontos, limitarNaSala(run, noChao(run, base + Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))), 2))
		end
		local raio = ataque.raio
		local atraso = ataque.atraso or 1.2
		for i = 1, math.min(#pontos, ataque.quantidade or 3) do
			local ponto = pontos[i]
			Vfx.partida(run, "telegrafo", { forma = "circulo", pos = ponto, raio = raio, duracao = atraso, chefe = true, dono = inimigo.modelo })
			if ataque.visual == "meteoro" then
				Vfx.partida(run, "meteoro", { pos = ponto, duracao = atraso, raio = raio })
			elseif ataque.visual == "alma" then
				Vfx.partida(run, "portalAlma", { pos = ponto, duracao = atraso, raio = raio })
			end
			task.delay(atraso, function()
				if not run.ativa then
					return
				end
				Vfx.partida(run, "impactoArea", { pos = ponto, raio = raio, visual = ataque.visual })
				for _, info in jogadoresAtingiveis(run) do
					if planar(info.raiz.Position - ponto).Magnitude <= raio + 1 then
						local opcoes = opcoesDoEfeito(inimigo, ataque.efeito)
						opcoes.origem = ponto
						Combate.danoAoJogador(run, info.estado, inimigo.dano * (ataque.mult or 1), nil, opcoes)
					end
				end
			end)
		end
		definirAcao(inimigo, "")
	end)
	return true
end

local function ataqueTeleporte(run, inimigo, ataque, agora: number): boolean
	local sala = run.sala
	if not sala then
		return false
	end
	local alvos = jogadoresAtingiveis(run)
	local destino = nil
	for _ = 1, 20 do
		local ponto = Masmorra.pontoLivre(sala, run.rng, inimigo.raio + 1)
		if ponto then
			local longe = true
			for _, info in alvos do
				if planar(info.raiz.Position - ponto).Magnitude < 14 then
					longe = false
				end
			end
			if longe then
				destino = ponto
				break
			end
		end
	end
	if not destino then
		return false
	end
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + ataque.preparo + 0.5
	Vfx.partida(run, "teleporte", { pos = inimigo.raiz.Position })
	task.delay(ataque.preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		local chegada = destino + Vector3.new(0, inimigo.alturaRaiz, 0)
		inimigo.modelo:PivotTo(CFrame.new(chegada) * inimigo.raiz.CFrame.Rotation)
		Vfx.partida(run, "teleporte", { pos = chegada })
		definirAcao(inimigo, "")
	end)
	return true
end

-- Puxão das Almas: estende a mão, um redemoinho se forma e todos que estão longe (dentro do
-- raio) são puxados para perto dele por um tempo. Andar para trás resiste um pouco; a esquiva
-- escapa. O movimento do personagem é feito no computador do jogador ("puxar").
local function ataquePuxar(run, inimigo, ataque, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	local raio = ataque.raio
	parar(inimigo)
	definirAcao(inimigo, "prepararPuxao")
	inimigo.ocupadoAte = agora + preparo + ataque.duracao + 0.2
	local centro = noChao(run, inimigo.raiz.Position)
	Vfx.partida(run, "telegrafo", { forma = "circulo", pos = centro, raio = raio, duracao = preparo, chefe = true, dono = inimigo.modelo, tipoAviso = "puxar" })
	Vfx.partida(run, "puxaoPreparo", { modelo = inimigo.modelo, pos = centro, duracao = preparo, tipo = inimigo.tipo })
	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		definirAcao(inimigo, "puxao")
		local agoraCentro = noChao(run, inimigo.raiz.Position)
		Vfx.partida(run, "puxao", { modelo = inimigo.modelo, pos = agoraCentro, raio = raio, duracao = ataque.duracao, tipo = inimigo.tipo })
		for _, info in jogadoresAtingiveis(run) do
			if planar(info.raiz.Position - agoraCentro).Magnitude <= raio then
				Remotos.enviar(info.estado.player, "puxar", { centro = agoraCentro, duracao = ataque.duracao, forca = ataque.forca })
			end
		end
		task.delay(ataque.duracao, function()
			if inimigo.vivo then
				definirAcao(inimigo, "")
			end
		end)
	end)
	return true
end

-- Fissura de Almas: a lâmina bate no chão e uma linha de explosões corre até o alvo (uma ou
-- várias em leque). Cada jogador leva no máximo um acerto por fissura.
local function ataqueFissura(run, inimigo, ataque, alvoPos: Vector3, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	local quantidade = ataque.quantidade or 1
	local abertura = math.rad(ataque.abertura or 30)
	local comprimento = ataque.comprimento
	local largura = ataque.largura or 5
	local passos = ataque.passos or 10
	local entre = ataque.entre or 0.07
	local centro = noChao(run, inimigo.raiz.Position)
	local frente = unidade(alvoPos - inimigo.raiz.Position, inimigo.raiz.CFrame.LookVector)
	local direcoes = {}
	for i = 1, quantidade do
		local angulo = (i - (quantidade + 1) / 2) * abertura
		table.insert(direcoes, CFrame.Angles(0, angulo, 0):VectorToWorldSpace(frente))
	end

	parar(inimigo)
	olharPara(inimigo, alvoPos)
	definirAcao(inimigo, "preparar")
	inimigo.ocupadoAte = agora + preparo + passos * entre + 0.5
	for _, direcao in direcoes do
		Vfx.partida(run, "telegrafo", {
			dono = inimigo.modelo,
			forma = "linha",
			pos = centro + direcao * inimigo.raio,
			dir = direcao,
			comprimento = comprimento,
			largura = largura,
			duracao = preparo + passos * entre * 0.5,
			chefe = true,
		})
	end

	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		definirAcao(inimigo, "golpe")
		Vfx.partida(run, "golpeInimigo", { pos = inimigo.raiz.Position, dir = frente, alcance = inimigo.raio + 4, arco = 90, cor = corDoEfeito("alma"), tipo = inimigo.tipo })
		local atingidos = {}
		for passo = 1, passos do
			local distancia = inimigo.raio + passo * (comprimento / passos)
			for _, direcao in direcoes do
				local ponto = limitarNaSala(run, centro + direcao * distancia, 1)
				Vfx.partida(run, "fissura", { pos = ponto, raio = largura / 2 + 0.5, cor = corDoEfeito("alma"), forte = passo == passos })
				for _, info in jogadoresAtingiveis(run) do
					if not atingidos[info.estado] and planar(info.raiz.Position - ponto).Magnitude <= largura / 2 + 1.2 then
						atingidos[info.estado] = true
						local opcoes = opcoesDoEfeito(inimigo, ataque.efeito)
						opcoes.origem = ponto
						Combate.danoAoJogador(run, info.estado, inimigo.dano * (ataque.mult or 1), inimigo, opcoes)
					end
				end
			end
			task.wait(entre)
		end
		if inimigo.vivo then
			definirAcao(inimigo, "")
		end
	end)
	return true
end

------------------------------------------------------------------------
-- Ataques da 2ª fase dos chefes: espiral de projéteis e anéis de perigo
------------------------------------------------------------------------

-- Várias ondas de projéteis em todas as direções, cada onda girada um pouco (espiral)
local function ataqueEspiral(run, inimigo, ataque, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	local ondas = ataque.ondas or 4
	local intervalo = ataque.intervalo or 0.35
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + preparo + ondas * intervalo + 0.3
	Vfx.partida(run, "telegrafo", { forma = "circulo", pos = noChao(run, inimigo.raiz.Position), raio = inimigo.raio + 4, duracao = preparo, chefe = true, dono = inimigo.modelo })
	task.delay(preparo, function()
		local giro = math.random() * math.pi
		for _ = 1, ondas do
			if not podeContinuar(run, inimigo) then
				return
			end
			definirAcao(inimigo, "disparo")
			local origem = inimigo.raiz.Position
			local lista = {}
			local quantidade = ataque.quantidade or 10
			for i = 1, quantidade do
				local angulo = giro + i * (math.pi * 2 / quantidade)
				local direcao = Vector3.new(math.sin(angulo), 0, math.cos(angulo))
				table.insert(lista, {
					lado = "inimigo",
					tipo = ataque.projetil,
					pos = origem + direcao * (inimigo.raio + 1),
					dir = direcao,
					velocidade = ataque.velocidade or 32,
					alcance = 80,
					raio = 1.2,
					aoAcertar = function(estado, _, projetil)
						local opcoes = opcoesDoEfeito(inimigo, ataque.efeito)
						opcoes.origem = projetil.pos - projetil.dir * 4
						Combate.danoAoJogador(run, estado, inimigo.dano * (ataque.mult or 1), inimigo, opcoes)
					end,
				})
			end
			Projeteis.disparar(run, lista)
			giro += ataque.giro or 0.25
			task.wait(intervalo)
		end
		if inimigo.vivo then
			definirAcao(inimigo, "")
		end
	end)
	return true
end

-- Anéis de perigo que saem do chefe, um depois do outro: fique entre eles ou pule por cima
local function ataqueAnel(run, inimigo, ataque, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	local aneis = ataque.aneis or 3
	local largura = ataque.largura or 4
	local entre = ataque.entre or 0.7
	local centro = noChao(run, inimigo.raiz.Position)
	local primeiro = inimigo.raio + 3
	local passo = largura * 2.6
	parar(inimigo)
	definirAcao(inimigo, "prepararGiro")
	inimigo.ocupadoAte = agora + preparo + aneis * entre + 0.4
	for i = 1, aneis do
		local raio = primeiro + (i - 1) * passo
		local atraso = preparo + (i - 1) * entre
		Vfx.partida(run, "anelPerigo", { pos = centro, raio = raio, largura = largura, duracao = atraso, cor = corDoEfeito(ataque.efeito), tipo = inimigo.tipo })
		task.delay(atraso, function()
			if not inimigo.vivo or not run.ativa then
				return
			end
			definirAcao(inimigo, "giro")
			Vfx.partida(run, "anelExplode", { pos = centro, raio = raio, largura = largura, cor = corDoEfeito(ataque.efeito), tipo = inimigo.tipo })
			for _, info in jogadoresAtingiveis(run) do
				local distancia = planar(info.raiz.Position - centro).Magnitude
				if math.abs(distancia - raio) <= largura then
					local opcoes = opcoesDoEfeito(inimigo, ataque.efeito)
					opcoes.origem = centro
					Combate.danoAoJogador(run, info.estado, inimigo.dano * (ataque.mult or 1), inimigo, opcoes)
				end
			end
		end)
	end
	task.delay(preparo + aneis * entre + 0.3, function()
		if inimigo.vivo then
			definirAcao(inimigo, "")
		end
	end)
	return true
end

------------------------------------------------------------------------
-- Suporte: cura, escudo e grito de guerra (não precisam de jogador no alcance)
------------------------------------------------------------------------

local function aliadosPerto(run, inimigo, raio: number)
	local lista = {}
	for outro in run.inimigos do
		if outro.vivo and planar(outro.raiz.Position - inimigo.raiz.Position).Magnitude <= raio then
			table.insert(lista, outro)
		end
	end
	return lista
end

local function ataqueCurar(run, inimigo, ataque, agora: number): boolean
	-- o aliado mais ferido (em proporção) que ainda não está quase cheio
	local alvo, menor = nil, 0.8
	for _, outro in aliadosPerto(run, inimigo, ataque.raio) do
		local fracao = outro.vida / outro.vidaMax
		if fracao < menor and (outro ~= inimigo or fracao < 0.5) then
			alvo, menor = outro, fracao
		end
	end
	if not alvo then
		return false
	end
	local preparo = ataque.preparo * inimigo.recargaMult
	parar(inimigo)
	olharPara(inimigo, alvo.raiz.Position)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + preparo + 0.3
	Vfx.partida(run, "canalizarCura", { de = inimigo.modelo, para = alvo.modelo, duracao = preparo })
	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) or not alvo.vivo then
			return
		end
		local cura = math.floor(alvo.vidaMax * ataque.cura + 0.5)
		alvo.vida = math.min(alvo.vidaMax, alvo.vida + cura)
		alvo.modelo:SetAttribute("Vida", alvo.vida)
		Vfx.partida(run, "curaInimigo", { pos = alvo.raiz.Position, altura = alvo.alturaBarra, valor = cura, raio = alvo.raio })
		definirAcao(inimigo, "")
	end)
	return true
end

local function ataqueEscudo(run, inimigo, ataque, agora: number): boolean
	local candidatos = {}
	for _, outro in aliadosPerto(run, inimigo, ataque.raio) do
		if (outro.escudo or 0) <= 0 then
			table.insert(candidatos, outro)
		end
	end
	if #candidatos == 0 then
		return false
	end
	-- protege primeiro quem está mais perto dos jogadores (quem vai apanhar)
	local jogadores = jogadoresAtingiveis(run)
	local function perigo(outro): number
		local menor = math.huge
		for _, info in jogadores do
			menor = math.min(menor, planar(info.raiz.Position - outro.raiz.Position).Magnitude)
		end
		return menor
	end
	table.sort(candidatos, function(a, b)
		return perigo(a) < perigo(b)
	end)
	local preparo = ataque.preparo * inimigo.recargaMult
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + preparo + 0.3
	Vfx.partida(run, "telegrafoSuporte", { modelo = inimigo.modelo, cor = Color3.fromRGB(110, 190, 255), duracao = preparo })
	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		local alvos = {}
		for i = 1, math.min(ataque.maximo or 4, #candidatos) do
			local outro = candidatos[i]
			if outro.vivo then
				outro.escudo = outro.vidaMax * ataque.escudo
				outro.escudoAte = os.clock() + ataque.duracao
				outro.modelo:SetAttribute("Escudo", outro.escudo)
				outro.modelo:SetAttribute("EscudoMax", outro.escudo)
				table.insert(alvos, outro.modelo)
			end
		end
		Vfx.partida(run, "escudoInimigo", { de = inimigo.modelo, alvos = alvos })
		definirAcao(inimigo, "")
	end)
	return true
end

local function ataqueGrito(run, inimigo, ataque, agora: number): boolean
	local aliados = aliadosPerto(run, inimigo, ataque.raio)
	if #aliados < 2 then
		return false -- sozinho, não adianta gritar
	end
	local preparo = ataque.preparo * inimigo.recargaMult
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + preparo + 0.4
	Vfx.partida(run, "telegrafoSuporte", { modelo = inimigo.modelo, cor = Color3.fromRGB(255, 80, 60), duracao = preparo })
	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		local fim = os.clock() + ataque.duracao
		for _, outro in aliadosPerto(run, inimigo, ataque.raio) do
			outro.inspiradoAte = fim
			outro.modelo:SetAttribute("Inspirado", true)
		end
		Vfx.partida(run, "gritoGuerra", { pos = noChao(run, inimigo.raiz.Position), raio = ataque.raio, modelo = inimigo.modelo })
		definirAcao(inimigo, "")
	end)
	return true
end

local function executarAtaque(run, inimigo, ataque, alvo, alvoPos: Vector3, agora: number): boolean
	local tipo = ataque.tipo
	if tipo == "golpe" then
		return ataqueGolpe(run, inimigo, ataque, alvoPos, agora)
	elseif tipo == "disparo" then
		return ataqueDisparo(run, inimigo, ataque, alvo, agora)
	elseif tipo == "rajada" then
		return ataqueRajada(run, inimigo, ataque, agora)
	elseif tipo == "investida" then
		return ataqueInvestida(run, inimigo, ataque, alvoPos, agora)
	elseif tipo == "salto" then
		return ataqueSalto(run, inimigo, ataque, alvoPos, agora)
	elseif tipo == "explodir" then
		return ataqueExplodir(run, inimigo, ataque, agora)
	elseif tipo == "invocar" then
		return ataqueInvocar(run, inimigo, ataque, agora)
	elseif tipo == "area" then
		return ataqueArea(run, inimigo, ataque, agora)
	elseif tipo == "teleporte" then
		return ataqueTeleporte(run, inimigo, ataque, agora)
	elseif tipo == "puxar" then
		return ataquePuxar(run, inimigo, ataque, agora)
	elseif tipo == "fissura" then
		return ataqueFissura(run, inimigo, ataque, alvoPos, agora)
	elseif tipo == "espiral" then
		return ataqueEspiral(run, inimigo, ataque, agora)
	elseif tipo == "anel" then
		return ataqueAnel(run, inimigo, ataque, agora)
	elseif tipo == "curar" then
		return ataqueCurar(run, inimigo, ataque, agora)
	elseif tipo == "escudo" then
		return ataqueEscudo(run, inimigo, ataque, agora)
	elseif tipo == "grito" then
		return ataqueGrito(run, inimigo, ataque, agora)
	end
	return false
end

------------------------------------------------------------------------
-- Movimento e decisões
------------------------------------------------------------------------

-- Anda até o destino desviando de pilares e de outros inimigos
local function mover(run, inimigo, destino: Vector3)
	local pos = inimigo.raiz.Position
	local caminho = planar(destino - pos)
	local distancia = caminho.Magnitude
	if distancia < 0.5 then
		return
	end
	local direcao = caminho / distancia

	if run.sala then
		for _, pilar in run.sala.pilares do
			local paraPilar = planar(pilar.pos - pos)
			local projecao = paraPilar:Dot(direcao)
			if projecao > 0 and projecao < math.min(distancia, 14) then
				local lateral = paraPilar - direcao * projecao
				if lateral.Magnitude < pilar.raio + inimigo.raio + 1.5 then
					local desvio = -lateral
					if desvio.Magnitude < 0.01 then
						desvio = Vector3.new(-direcao.Z, 0, direcao.X)
					end
					direcao = (direcao + desvio.Unit * 1.4).Unit
				end
			end
		end
	end

	for outro in run.inimigos do
		if outro ~= inimigo and outro.vivo then
			local afastar = planar(pos - outro.raiz.Position)
			local m = afastar.Magnitude
			if m > 0.01 and m < inimigo.raio + outro.raio + 0.5 then
				direcao += afastar / m * 0.6
			end
		end
	end

	if direcao.Magnitude > 0.01 then
		inimigo.humanoid:MoveTo(limitarNaSala(run, pos + direcao.Unit * 6, inimigo.raio))
	end
end

local function escolherAlvo(run, inimigo)
	local pos = inimigo.raiz.Position
	local melhor, melhorNota, melhorDistancia = nil, -math.huge, math.huge
	for estado, valor in inimigo.ameaca do
		inimigo.ameaca[estado] = valor * 0.985
	end
	for _, info in jogadoresAtingiveis(run) do
		local distancia = planar(info.raiz.Position - pos).Magnitude
		local nota = (inimigo.ameaca[info.estado] or 0) - distancia * 3
		if info.estado == inimigo.alvoAtual then
			nota += 15 -- não troca de alvo a toda hora
		end
		if nota > melhorNota then
			melhor, melhorNota, melhorDistancia = info, nota, distancia
		end
	end
	inimigo.alvoAtual = melhor and melhor.estado
	return melhor, melhorDistancia
end

-- Transformação: o chefe para, fica imune e junta poder por alguns segundos (a sala muda de cor),
-- solta uma onda de choque e volta mais rápido, com ataques novos
local TRANSFORMACAO = 2.8

local function entrarNaFase2(run, inimigo)
	local fase2 = inimigo.def.fase2
	local agora = os.clock()
	local cor = fase2.cor or Color3.fromRGB(255, 70, 50)
	inimigo.fase2 = true
	inimigo.invulneravelAte = agora + TRANSFORMACAO
	inimigo.ocupadoAte = agora + TRANSFORMACAO + 0.3
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.modelo:SetAttribute("Furioso", true)
	inimigo.modelo:SetAttribute("Fase", 2)
	run:anunciar("🔥 " .. (fase2.anuncio or (inimigo.def.nome .. " se enfurece!")), Color3.fromRGB(255, 90, 60))
	local centro = noChao(run, inimigo.raiz.Position)
	local raioOnda = inimigo.raio + 14
	Vfx.partida(run, "fase2", { modelo = inimigo.modelo, pos = centro, cor = cor, duracao = TRANSFORMACAO, raio = raioOnda, tipo = inimigo.tipo })
	Vfx.partida(run, "telegrafo", { forma = "circulo", pos = centro, raio = raioOnda, duracao = TRANSFORMACAO, chefe = true, dono = inimigo.modelo })

	task.delay(TRANSFORMACAO, function()
		if not inimigo.vivo or not run.ativa then
			return
		end
		Vfx.partida(run, "furia", { pos = inimigo.raiz.Position, tipo = inimigo.tipo })
		Vfx.partida(run, "explosao", { pos = inimigo.raiz.Position, raio = raioOnda, cor = cor, forte = true })
		acertarJogadores(run, inimigo, inimigo.raiz.Position, nil, raioOnda, 360, 1.3, nil)
		inimigo.velocidadeMult *= fase2.velocidade or 1
		inimigo.recargaMult *= fase2.recarga or 1
		if fase2.ataques then
			for i, ataque in fase2.ataques do
				table.insert(inimigo.ataques, i, ataque)
				inimigo.prontoEm[ataque] = os.clock() + (ataque.inicial or 1)
			end
		end
		definirAcao(inimigo, "")
	end)
end

-- Golpe que vem logo depois deste num combo (ou nil): cada opção de "seguir" tem uma chance
local function sortearSeguinte(inimigo, ataque)
	if not ataque.seguir then
		return nil
	end
	local mult = if inimigo.fase2 then inimigo.def.fase2.combos or 1 else 1
	for _, opcao in ataque.seguir do
		if math.random() < opcao[2] * mult then
			for _, outro in inimigo.ataques do
				if outro.nome == opcao[1] then
					return outro
				end
			end
		end
	end
	return nil
end

--[[ Maldição do Alto (Skullbane): uma alma cai do alto num jogador do grupo (sorteado). O selo
	segue a pessoa e só trava no lugar Config.MALDICAO_TRAVA segundos antes da queda: escapa quem
	dá a esquiva bem na hora (fica intocável ou sai do selo) ou quem defende com o escudo. Quem é
	atingido leva dano e fica amaldiçoado (sem dash, corrida e habilidades). Vem do céu, não dele:
	acontece mesmo com o chefe atacando ou tonto. ]]
local idMaldicao = 0
local function maldicaoDoAlto(run, inimigo, forte: boolean)
	local candidatos = {}
	for _, estado in run.jogadores do
		local personagem = estado.player.Character
		local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart")
		if estado.vivo and not estado.caido and raiz then
			table.insert(candidatos, estado)
		end
	end
	if #candidatos == 0 then
		return
	end
	local alvo = candidatos[math.random(#candidatos)]
	local function posicaoDoAlvo(): Vector3?
		local personagem = alvo.player.Character
		local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
		return if raiz then noChao(run, raiz.Position) else nil
	end
	local centro = posicaoDoAlvo()
	if not centro then
		return
	end
	idMaldicao += 1
	local id = idMaldicao
	local raio = if forte then Config.MALDICAO_FORTE_RAIO else Config.MALDICAO_RAIO
	local duracao = if forte then Config.MALDICAO_FORTE_DURACAO else Config.MALDICAO_DURACAO
	local trava = math.min(Config.MALDICAO_TRAVA, Config.MALDICAO_AVISO)
	Vfx.partida(run, "maldicaoCeu", { id = id, jogador = alvo.player, pos = centro, raio = raio, duracao = Config.MALDICAO_AVISO, forte = forte })
	task.delay(Config.MALDICAO_AVISO - trava, function()
		if not run.ativa or not inimigo.vivo then
			return
		end
		-- o selo trava onde a pessoa está agora
		centro = posicaoDoAlvo() or centro
		Vfx.partida(run, "maldicaoTrava", { id = id, pos = centro, resta = trava })
		task.delay(trava, function()
			if not run.ativa or not inimigo.vivo then
				return
			end
			for _, estado in run.jogadores do
				local personagem = estado.player.Character
				local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
				if estado.vivo and not estado.caido and raiz and planar(raiz.Position - centro).Magnitude <= raio + 0.5 then
					if estado.defendendoDesde then
						-- escudo erguido: a alma bate no escudo e some
						Vfx.partida(run, "defesa", { jogador = estado.player, perfeita = true, pos = raiz.Position + Vector3.new(0, 2.5, 0), dir = Vector3.yAxis })
					else
						-- (esquivando ou com escudo ativo, o dano e a maldição são anulados em danoAoJogador)
						Combate.danoAoJogador(run, estado, inimigo.dano * (if forte then 0.7 else 0.3), inimigo, { maldicao = duracao, origem = centro })
					end
				end
			end
		end)
	end)
end

--[[ Caveiras (Skullbane): saem do peito dele e perseguem os jogadores, virando devagar
	(Config.CAVEIRAS_GIRO). Dá para fugir, desviar de lado na hora certa ou atravessar com a
	esquiva (intocável). ]]
local function soltarCaveiras(run, inimigo)
	local alvos = {}
	for _, estado in run.jogadores do
		local personagem = estado.player.Character
		if estado.vivo and not estado.caido and personagem and personagem:FindFirstChild("HumanoidRootPart") then
			table.insert(alvos, estado)
		end
	end
	if #alvos == 0 then
		return
	end
	local quantidade = math.max(Config.CAVEIRAS_MINIMO, #alvos)
	local origem = inimigo.raiz.Position + Vector3.new(0, 3, 0)
	local frente = unidade(inimigo.raiz.CFrame.LookVector, Vector3.new(0, 0, -1))
	local lista = {}
	for i = 1, quantidade do
		local estado = alvos[(i - 1) % #alvos + 1]
		local saida = CFrame.Angles(0, (i - (quantidade + 1) / 2) * 0.9, 0):VectorToWorldSpace(frente)
		table.insert(lista, {
			lado = "inimigo",
			tipo = "caveira",
			pos = origem + saida * (inimigo.raio + 2),
			dir = saida,
			velocidade = Config.CAVEIRAS_VELOCIDADE,
			alcance = Config.CAVEIRAS_VELOCIDADE * Config.CAVEIRAS_DURACAO,
			raio = 1.3,
			aoMover = function(projetil, dt)
				-- vira devagar em direção à pessoa que persegue
				local personagem = estado.player.Character
				local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
				if raiz and estado.vivo and not estado.caido then
					local desejada = planar(raiz.Position - projetil.pos)
					if desejada.Magnitude > 0.5 then
						local alvoDir = desejada.Unit
						local angulo = math.acos(math.clamp(projetil.dir:Dot(alvoDir), -1, 1))
						if angulo > 0.001 then
							local nova = projetil.dir:Lerp(alvoDir, math.min(1, Config.CAVEIRAS_GIRO * dt / angulo))
							if nova.Magnitude > 0.001 then
								projetil.dir = nova.Unit
							end
						end
					end
				end
				-- os computadores dos jogadores recebem a direção nova algumas vezes por segundo
				projetil.tempoAviso = (projetil.tempoAviso or 0) + dt
				if projetil.tempoAviso >= 0.12 then
					projetil.tempoAviso = 0
					Vfx.partida(run, "projetilDir", { id = projetil.id, pos = projetil.pos, dir = projetil.dir, silencioso = true })
				end
			end,
			aoAcertar = function(alvoEstado, _, projetil)
				Combate.danoAoJogador(run, alvoEstado, inimigo.dano * Config.CAVEIRAS_DANO, inimigo, { origem = projetil.pos - projetil.dir * 4 })
			end,
		})
	end
	Vfx.partida(run, "caveiras", { pos = origem })
	Projeteis.disparar(run, lista)
end

local function decidir(run, inimigo, agora: number)
	local def = inimigo.def
	if def.maldicaoDoAlto and inimigo.proximaMaldicao and agora >= inimigo.proximaMaldicao then
		inimigo.proximaMaldicao = agora + Config.MALDICAO_INTERVALO
		inimigo.maldicoes = (inimigo.maldicoes or 0) + 1
		maldicaoDoAlto(run, inimigo, inimigo.maldicoes % Config.MALDICAO_FORTE_A_CADA == 0)
	end
	-- caveiras: saem dele, então não com ele tonto ou grogue (soltam assim que ele se recupera)
	if def.caveiras and inimigo.proximasCaveiras and agora >= inimigo.proximasCaveiras and agora >= (inimigo.atordoadoAte or 0) then
		inimigo.proximasCaveiras = agora + Config.CAVEIRAS_INTERVALO
		soltarCaveiras(run, inimigo)
	end

	-- postura: esvazia sozinha depois de 3s sem pressão; o grogue acaba e a barra zera
	if def.posturaMax then
		if inimigo.grogueAte and agora >= inimigo.grogueAte then
			inimigo.grogueAte = nil
			inimigo.fatalPronto = false
			inimigo.postura = 0
			inimigo.modelo:SetAttribute("Grogue", false)
			inimigo.modelo:SetAttribute("Postura", 0)
		elseif (inimigo.postura or 0) > 0 and not inimigo.grogueAte and agora - (inimigo.posturaTocadaEm or 0) > 3 then
			inimigo.postura = math.max(0, inimigo.postura - (def.posturaRecupera or 1.4))
			inimigo.modelo:SetAttribute("Postura", inimigo.postura / (inimigo.posturaMax or def.posturaMax))
		end
	end

	if agora < inimigo.atordoadoAte then
		parar(inimigo)
		return
	elseif inimigo.modelo:GetAttribute("Atordoado") then
		inimigo.modelo:SetAttribute("Atordoado", false)
	end
	if agora >= inimigo.lentoAte and inimigo.lentoFator < 1 then
		inimigo.lentoFator = 1
		inimigo.modelo:SetAttribute("Lento", false)
	end
	-- escudo de runas e grito de guerra acabam com o tempo
	if (inimigo.escudo or 0) > 0 and agora >= (inimigo.escudoAte or 0) then
		inimigo.escudo = 0
		inimigo.modelo:SetAttribute("Escudo", 0)
	end
	local inspirado = agora < (inimigo.inspiradoAte or 0)
	if not inspirado and inimigo.modelo:GetAttribute("Inspirado") then
		inimigo.modelo:SetAttribute("Inspirado", false)
	end

	if inimigo.chefe and def.fase2 and not inimigo.fase2 and inimigo.vida <= inimigo.vidaMax * 0.5 then
		entrarNaFase2(run, inimigo)
	end

	if agora < inimigo.ocupadoAte or inimigo.investindo then
		return
	end

	local velocidade = def.velocidade * inimigo.velocidadeMult * (if inspirado then 1.35 else 1)
	if agora < inimigo.lentoAte then
		velocidade *= inimigo.lentoFator
	end
	inimigo.humanoid.WalkSpeed = velocidade

	local info, distancia = escolherAlvo(run, inimigo)
	if not info then
		parar(inimigo)
		return
	end
	local alvoPos = info.raiz.Position

	-- combo encadeado: o próximo golpe sai logo que o anterior termina (sem pausa nem recarga)
	if inimigo.encadear then
		local proximo = inimigo.encadear
		inimigo.encadear = nil
		if distancia <= (proximo.alcance or 999) * inimigo.escala * 1.4 then
			olharPara(inimigo, alvoPos)
			if executarAtaque(run, inimigo, proximo, info.estado, alvoPos, agora) then
				inimigo.ultimoAtaque = proximo
				inimigo.encadear = sortearSeguinte(inimigo, proximo)
				return
			end
		end
	end

	-- chefes com "pausa": depois de cada ataque andam um pouco antes do próximo
	local podeAtacar = agora >= (inimigo.ataqueLivreEm or 0)
	if def.aleatorio then
		-- sorteia entre os golpes prontos e no alcance, com peso pela distância
		if podeAtacar then
			local candidatos, total = {}, 0
			for _, ataque in inimigo.ataques do
				if agora >= (inimigo.prontoEm[ataque] or 0) and distancia <= (ataque.alcance or 999) * inimigo.escala and distancia >= (ataque.minimo or 0) then
					local peso = ataque.peso or 1
					if distancia <= 10 and ataque.pesoPerto then
						peso = ataque.pesoPerto
					elseif distancia >= 22 and ataque.pesoLonge then
						peso = ataque.pesoLonge
					end
					if ataque == inimigo.ultimoAtaque then
						peso *= 0.25 -- quase nunca repete o mesmo golpe
					end
					if peso > 0 then
						total += peso
						table.insert(candidatos, { ataque, peso })
					end
				end
			end
			local sorteio = math.random() * total
			for _, item in candidatos do
				sorteio -= item[2]
				if sorteio <= 0 then
					local ataque = item[1]
					if executarAtaque(run, inimigo, ataque, info.estado, alvoPos, agora) then
						inimigo.prontoEm[ataque] = agora + (ataque.recarga or 2) * inimigo.recargaMult * inimigo.recargaGrupo
						inimigo.ultimoAtaque = ataque
						inimigo.encadear = sortearSeguinte(inimigo, ataque)
						if def.pausa and not inimigo.encadear then
							local pausa = def.pausa[1] + math.random() * (def.pausa[2] - def.pausa[1])
							inimigo.ataqueLivreEm = inimigo.ocupadoAte + pausa * (if inimigo.fase2 then 0.7 else 1) * inimigo.recargaGrupo
						end
						return
					end
					inimigo.prontoEm[ataque] = agora + 2
					break
				end
			end
		end
		podeAtacar = false -- o resto é só movimento
	end
	for _, ataque in inimigo.ataques do
		if podeAtacar and agora >= (inimigo.prontoEm[ataque] or 0) and distancia <= (ataque.alcance or 999) * inimigo.escala and distancia >= (ataque.minimo or 0) then
			if executarAtaque(run, inimigo, ataque, info.estado, alvoPos, agora) then
				local apressado = if inspirado and ataque.tipo ~= "grito" then 0.7 else 1
				inimigo.prontoEm[ataque] = agora + (ataque.recarga or 2) * inimigo.recargaMult * inimigo.recargaGrupo * apressado
				if def.pausa then
					local pausa = def.pausa[1] + math.random() * (def.pausa[2] - def.pausa[1])
					inimigo.ataqueLivreEm = inimigo.ocupadoAte + pausa * (if inimigo.fase2 then 0.7 else 1) * inimigo.recargaGrupo
				end
				return
			else
				inimigo.prontoEm[ataque] = agora + 2
			end
		end
	end

	-- Ninguém no alcance: anda
	local comportamento = def.comportamento or "perseguir"
	if comportamento == "perseguir" then
		local alcanceGolpe = 4
		local menorGolpe = math.huge
		for _, ataque in inimigo.ataques do
			if ataque.tipo == "golpe" or ataque.tipo == "explodir" then
				alcanceGolpe = math.max(alcanceGolpe, ataque.alcance * inimigo.escala)
				if not ataque.minimo then
					menorGolpe = math.min(menorGolpe, ataque.alcance * inimigo.escala)
				end
			end
		end
		-- quem escolhe golpes ao acaso (chefe, Ceifador) chega no alcance do golpe mais curto,
		-- para todos os golpes de perto poderem sair
		if def.aleatorio and menorGolpe < math.huge then
			alcanceGolpe = menorGolpe
		end
		if distancia > alcanceGolpe * 0.75 then
			mover(run, inimigo, alvoPos)
			if inimigo.encara then
				olharPara(inimigo, alvoPos)
			end
		elseif def.pausa or def.encarar then
			-- esperando o próximo ataque (pausa ou golpes recarregando): rodeia o alvo, encarando
			if agora >= inimigo.trocaLadoEm then
				inimigo.lado = -inimigo.lado
				inimigo.trocaLadoEm = agora + 1.5 + math.random() * 1.5
			end
			local pos = inimigo.raiz.Position
			local paraAlvo = unidade(alvoPos - pos, Vector3.new(0, 0, 1))
			inimigo.humanoid.WalkSpeed = velocidade * 0.75
			mover(run, inimigo, pos + Vector3.new(-paraAlvo.Z, 0, paraAlvo.X) * inimigo.lado * 6)
			olharPara(inimigo, alvoPos)
		else
			parar(inimigo)
			olharPara(inimigo, alvoPos)
		end
	elseif comportamento == "suporte" then
		-- fica atrás dos aliados (do lado oposto aos jogadores), sem chegar perto de ninguém
		local pos = inimigo.raiz.Position
		local soma, quantos = Vector3.zero, 0
		for outro in run.inimigos do
			if outro ~= inimigo and outro.vivo and outro.def.comportamento ~= "suporte" then
				soma += outro.raiz.Position
				quantos += 1
			end
		end
		local ideal = def.distancia or 20
		if distancia < ideal - 6 then
			-- jogador perto demais: recua
			mover(run, inimigo, pos + unidade(pos - alvoPos, Vector3.new(1, 0, 0)) * 10)
		elseif quantos > 0 then
			local centro = soma / quantos
			local atras = centro + unidade(centro - alvoPos, Vector3.new(0, 0, 1)) * 7
			if planar(atras - pos).Magnitude > 4 then
				mover(run, inimigo, atras)
			else
				parar(inimigo)
				olharPara(inimigo, alvoPos)
			end
		elseif distancia > ideal + 4 then
			mover(run, inimigo, alvoPos)
		else
			parar(inimigo)
			olharPara(inimigo, alvoPos)
		end
	else
		local ideal = def.distancia or 24
		local pos = inimigo.raiz.Position
		if agora >= inimigo.trocaLadoEm then
			inimigo.lado = -inimigo.lado
			inimigo.trocaLadoEm = agora + 1.5 + math.random() * 2
		end
		if distancia > ideal + 4 then
			mover(run, inimigo, alvoPos)
		elseif distancia < ideal - 8 then
			mover(run, inimigo, pos + unidade(pos - alvoPos, Vector3.new(1, 0, 0)) * 10)
		else
			-- anda de lado para não ficar parado
			local paraAlvo = unidade(alvoPos - pos, Vector3.new(0, 0, 1))
			mover(run, inimigo, pos + Vector3.new(-paraAlvo.Z, 0, paraAlvo.X) * inimigo.lado * 6)
		end
	end
	-- recuando ou andando de lado, quem encara continua de frente para o alvo
	if inimigo.encara and comportamento ~= "perseguir" then
		olharPara(inimigo, alvoPos)
	end
end

-- Chamado a cada frame pelo controlador da partida
function Inimigos.atualizar(run, agora: number)
	local lista = {}
	for inimigo in run.inimigos do
		table.insert(lista, inimigo)
	end
	for _, inimigo in lista do
		if inimigo.vivo and agora >= inimigo.proximaDecisao then
			inimigo.proximaDecisao = agora + 0.12
			decidir(run, inimigo, agora)
		end
	end
end

------------------------------------------------------------------------
-- Morte
------------------------------------------------------------------------

function Inimigos.morrer(run, inimigo)
	if not inimigo.vivo then
		return
	end
	inimigo.vivo = false
	run.inimigos[inimigo] = nil
	local posicao = inimigo.raiz.Position
	inimigo.modelo:Destroy() -- os jogadores veem a animação de morte no próprio computador

	if not run.ativa or not run.sala then
		return
	end
	local chao = noChao(run, posicao)

	-- Gosmas se dividem em gosminhas
	if inimigo.def.divide then
		for i = 1, 2 do
			local angulo = i * math.pi + math.random()
			run:invocar(inimigo.def.divide, chao + Vector3.new(math.cos(angulo), 0, math.sin(angulo)) * 2, nil, true)
		end
	end

	-- Elite explosiva: explode logo depois de morrer
	if inimigo.modificador and inimigo.modificador.explosivo then
		local raio = 8 * inimigo.escala
		Vfx.partida(run, "telegrafo", { forma = "circulo", pos = chao, raio = raio, duracao = 1, dono = inimigo.modelo })
		task.delay(1, function()
			if not run.ativa then
				return
			end
			Vfx.partida(run, "explosao", { pos = chao, raio = raio, cor = Color3.fromRGB(255, 120, 40), forte = true })
			for _, info in jogadoresAtingiveis(run) do
				if planar(info.raiz.Position - chao).Magnitude <= raio + 1 then
					Combate.danoAoJogador(run, info.estado, inimigo.dano * 1.5, nil, { origem = chao })
				end
			end
		end)
	end
end

function Inimigos.limparTodos(run)
	for inimigo in run.inimigos do
		inimigo.vivo = false
		inimigo.modelo:Destroy()
	end
	table.clear(run.inimigos)
end

return Inimigos
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000023">
        <Properties>
          <string name="Name">Lobby</string>
          <ProtectedString name="Source"><![CDATA[-- Lobby (o acampamento): altares das classes, portal da masmorra, loja do mercador e placa.
--
-- O CENÁRIO (chão, praça, muralha, árvores, lago, cercas...) é um mapa salvo no próprio jogo:
-- Workspace > Mapa > Lobby (vem de mapas/Lobby.rbxmx). Dá para ver e mexer nele no Studio.
-- Aqui o código só monta o que é vivo (portal girando, altares com prompt, loja, letreiros,
-- placa, efeitos), em cima dos MARCADORES do mapa (pasta Marcadores): se você mover um marcador
-- no Studio, aquilo aparece no lugar novo. Os efeitos vêm dos pacotes de VFX
-- (ReplicatedStorage > EfeitosVFX), sem partículas feitas por código.
-- A água do lago é do Terrain (ondas, reflexo, dá para nadar): ela é criada no volume da peça
-- azul "Agua" do mapa (pasta Lago), que no Studio só mostra onde a água vai ficar.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))

local servidor = script.Parent
local Remotos = require(servidor.Remotos)
local Dados = require(servidor.Dados)
local Vfx = require(servidor.Vfx)
local Armas = require(servidor.Armas)
local Partida = require(servidor.Partida)

local Lobby = {}

-- onde fica o círculo do portal (o marcador "Portal" do mapa pode mudar isto)
local POSICAO_PORTAL = Vector3.new(0, 0, -46)
local RAIO_PORTAL = 9
local ROXO = Color3.fromRGB(150, 70, 255)

-- Posições padrão, caso algum marcador não esteja no mapa
local PADRAO = {
	Nascimento = CFrame.new(0, 0.5, 22),
	Portal = CFrame.new(0, 0.5, -46),
	Vortice = CFrame.new(0, 11, -60),
	PlacaAltares = CFrame.new(-60, 23, 0),
	Loja = CFrame.new(37, 4.6, 0),
	Vagalumes = CFrame.new(0, 7, 0),
}

local vivo = Instance.new("Model")
vivo.Name = "LobbyVivo"

local efeitos = ReplicatedStorage:WaitForChild("EfeitosVFX", 10)

local function peca(nome: string, tamanho: Vector3, cframe: CFrame, cor: Color3, opcoes): Part
	opcoes = opcoes or {}
	local p = Instance.new("Part")
	p.Name = nome
	p.Anchored = true
	p.Size = tamanho
	p.CFrame = cframe
	p.Material = opcoes.material or Enum.Material.SmoothPlastic
	p.Color = cor
	p.Transparency = opcoes.transparencia or 0
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = opcoes.sombra == true
	p.Parent = opcoes.pai or vivo
	return p
end

local function luz(pai: Instance, cor: Color3, alcance: number, brilho: number)
	local l = Instance.new("PointLight")
	l.Color = cor
	l.Range = alcance
	l.Brightness = brilho
	l.Parent = pai
	return l
end

--[[ Liga um efeito do pacote de VFX preso num ponto (fica sempre ligado). Os emissores do
	efeito são copiados para um anexo em "pai" (com "deslocamento", se houver).
	opcoes: escala (tamanho e velocidade), velocidade (se quiser outra que não a da escala),
	cor (tinge), taxa (quantidade de partículas). ]]
local function efeitoPronto(nome: string, pai: BasePart, opcoes)
	opcoes = opcoes or {}
	local molde = efeitos and efeitos:FindFirstChild(nome)
	if not molde then
		return
	end
	local anexo = Instance.new("Attachment")
	anexo.Name = "Efeito" .. nome
	anexo.CFrame = opcoes.deslocamento or CFrame.identity
	anexo.Parent = pai
	local escala = opcoes.escala or 1
	local velocidade = opcoes.velocidade or escala
	for _, original in molde:GetDescendants() do
		if original:IsA("ParticleEmitter") then
			local emissor = original:Clone()
			if escala ~= 1 then
				local chaves = {}
				for _, chave in emissor.Size.Keypoints do
					table.insert(chaves, NumberSequenceKeypoint.new(chave.Time, chave.Value * escala, chave.Envelope * escala))
				end
				emissor.Size = NumberSequence.new(chaves)
			end
			if velocidade ~= 1 then
				emissor.Speed = NumberRange.new(emissor.Speed.Min * velocidade, emissor.Speed.Max * velocidade)
			end
			if opcoes.cor then
				emissor.Color = ColorSequence.new(opcoes.cor)
			end
			if opcoes.taxa then
				emissor.Rate *= opcoes.taxa
			end
			emissor.Enabled = true
			emissor.Parent = anexo
		end
	end
end

local function letreiro(posicao: Vector3, titulo: string, subtitulo: string, cor: Color3, largura: number?)
	local ancora = peca("Letreiro", Vector3.one, CFrame.new(posicao), cor, { transparencia = 1 })
	local placa = Instance.new("BillboardGui")
	placa.Size = UDim2.fromScale(largura or 20, (largura or 20) / 4)
	placa.MaxDistance = 160
	placa.LightInfluence = 0
	placa.Parent = ancora

	local textoTitulo = Instance.new("TextLabel")
	textoTitulo.Size = UDim2.fromScale(1, 0.62)
	textoTitulo.BackgroundTransparency = 1
	textoTitulo.FontFace = Font.new(Font.fromEnum(Enum.Font.Merriweather).Family, Enum.FontWeight.Bold)
	textoTitulo.Text = titulo
	textoTitulo.TextColor3 = cor
	textoTitulo.TextScaled = true
	textoTitulo.TextStrokeTransparency = 0.25
	textoTitulo.Parent = placa

	local textoSub = Instance.new("TextLabel")
	textoSub.Position = UDim2.fromScale(0, 0.64)
	textoSub.Size = UDim2.fromScale(1, 0.34)
	textoSub.BackgroundTransparency = 1
	textoSub.FontFace = Font.new(Font.fromEnum(Enum.Font.BuilderSans).Family, Enum.FontWeight.Bold)
	textoSub.Text = subtitulo
	textoSub.TextColor3 = Color3.fromRGB(245, 238, 220)
	textoSub.TextScaled = true
	textoSub.TextStrokeTransparency = 0.35
	textoSub.Parent = placa
end

------------------------------------------------------------------------
-- Mapa e marcadores
------------------------------------------------------------------------

local mapa: Instance? = nil
local marcadores: Instance? = nil

-- CFrame de um marcador (ou a posição padrão, se ele não existir no mapa)
local function marcador(nome: string): CFrame
	local m = marcadores and marcadores:FindFirstChild(nome)
	if m and m:IsA("BasePart") then
		return m.CFrame
	end
	return PADRAO[nome] or CFrame.new()
end

-- O marcador em si (para prender prompt, luz ou efeito nele), invisível no jogo
local function pecaDoMarcador(nome: string): BasePart
	local m = marcadores and marcadores:FindFirstChild(nome)
	if m and m:IsA("BasePart") then
		return m
	end
	return peca(nome, Vector3.one, marcador(nome), Color3.new(1, 1, 1), { transparencia = 1 })
end

-- Água de verdade no lago: enche com água do Terrain o volume da peça "Agua" (um cilindro em pé,
-- como os discos do mapa) e tira a peça
local function encherLago()
	local terreno = workspace.Terrain
	terreno.WaterColor = Color3.fromRGB(56, 178, 214)
	terreno.WaterTransparency = 0.72
	terreno.WaterReflectance = 0.45
	terreno.WaterWaveSize = 0.08
	terreno.WaterWaveSpeed = 7
	for _, objeto in (mapa :: Instance):GetDescendants() do
		if objeto:IsA("BasePart") and objeto.Name == "Agua" then
			local altura = objeto.Size.X -- o eixo do cilindro (X) aponta para cima
			local raio = math.min(objeto.Size.Y, objeto.Size.Z) / 2
			local ok, erro = pcall(function()
				terreno:FillCylinder(CFrame.new(objeto.Position), altura, raio, Enum.Material.Water)
			end)
			if ok then
				objeto:Destroy()
			else
				warn("[Lobby] Não deu para criar a água do lago:", erro)
			end
		end
	end
end

local function prepararMapa()
	local pasta = workspace:FindFirstChild("Mapa")
	mapa = pasta and pasta:FindFirstChild("Lobby")
	if not mapa then
		-- sem o mapa (mapas/Lobby.rbxmx): pelo menos um chão para não cair no vazio
		warn("[Lobby] Workspace > Mapa > Lobby não encontrado; usando um chão simples.")
		local chao = peca("ChaoReserva", Vector3.new(400, 2, 400), CFrame.new(0, -1, 0), Color3.fromRGB(108, 196, 74))
		chao.CanCollide = true
		chao.CanQuery = true
		return
	end
	marcadores = mapa:FindFirstChild("Marcadores")
	-- marcadores ficam rosa no Studio para ajudar a editar; no jogo, invisíveis
	if marcadores then
		for _, m in marcadores:GetChildren() do
			if m:IsA("BasePart") then
				m.Transparency = 1
				m.CanCollide = false
				m.CanQuery = false
				m.CanTouch = false
			end
		end
	end
	for _, objeto in mapa:GetDescendants() do
		-- chamas das lanternas e dos braseiros tremulam (Ambiente.luau)
		if objeto:IsA("PointLight") and objeto.Name == "LuzChama" then
			CollectionService:AddTag(objeto, "Chama")
		end
		-- fogo dos braseiros: chamas do pacote
		if objeto:IsA("BasePart") and objeto.Name == "Brasa" then
			efeitoPronto("LaminaFogo", objeto, { escala = 1.2, deslocamento = CFrame.new(0.2, 0, 0) })
		end
	end
	local p = marcador("Portal").Position
	POSICAO_PORTAL = Vector3.new(p.X, 0, p.Z)
	encherLago()
end

------------------------------------------------------------------------
-- Partes vivas
------------------------------------------------------------------------

local function construirCristal()
	local cristal = mapa and mapa:FindFirstChild("CristalFlutuante", true)
	if not cristal or not cristal:IsA("Model") then
		return
	end
	local nucleo = cristal:FindFirstChild("Cristal")
	if not nucleo or not nucleo:IsA("BasePart") then
		return
	end
	cristal.PrimaryPart = nucleo
	cristal:SetAttribute("Giro", 0.6)
	cristal:SetAttribute("Flutuar", 0.8)
	CollectionService:AddTag(cristal, "Girar")
	luz(nucleo, Color3.fromRGB(110, 200, 255), 24, 1.4)
	efeitoPronto("CargaAura", nucleo, { escala = 0.6, cor = Color3.fromRGB(150, 220, 255), taxa = 0.5 })
end

local function construirPortal()
	-- o portal é o efeito do pacote (PortalChuva): um redemoinho roxo grande enchendo o arco, de
	-- frente para a praça (o efeito solta as linhas para a "frente" do anexo; girado, elas saem
	-- para o lado da praça)
	local vortice = pecaDoMarcador("Vortice")
	luz(vortice, ROXO, 40, 2)
	efeitoPronto("PortalChuva", vortice, {
		escala = 5,
		velocidade = 1.4,
		cor = Color3.fromRGB(170, 100, 255),
		deslocamento = CFrame.Angles(0, math.pi, 0),
	})
	-- o mesmo portal deitado no chão: o círculo onde o grupo se junta
	local circulo = pecaDoMarcador("Portal")
	efeitoPronto("PortalChuva", circulo, {
		escala = RAIO_PORTAL * 2 / 3,
		velocidade = 0.8,
		cor = Color3.fromRGB(180, 120, 255),
		taxa = 0.8,
		deslocamento = CFrame.new(0, -0.1, 0) * CFrame.Angles(math.rad(90), 0, 0), -- logo acima da pedra do círculo
	})
	luz(circulo, ROXO, 22, 1.2)
	letreiro(POSICAO_PORTAL + Vector3.new(0, 11, 0), "⚔️ A MASMORRA", "Fique no círculo roxo com seu grupo (1 a 4)", Color3.fromRGB(210, 170, 255))
end

-- Altares: um santuário por classe (no mapa, pasta Santuarios). O marcador Altar_<classe> fica em
-- cima do pedestal; chegue perto e escolha sua classe.
local function construirAltares()
	for _, id in Classes.ordem do
		local classe = Classes.dados[id]
		local altar = pecaDoMarcador("Altar_" .. id)
		local base = altar.CFrame
		luz(altar, classe.cor, 14, 1)
		-- brilho suave da cor da classe em volta da arma
		efeitoPronto("CargaAura", altar, { escala = 0.4, cor = classe.cor, taxa = 0.35, deslocamento = CFrame.new(0, 3.6, 0) })

		-- arma flutuando sobre o pedestal (gira no computador de cada jogador)
		local exibicao = Armas.modeloExibicao(id)
		exibicao.Name = "Arma" .. classe.nome
		local orientacao = if id == "cavaleiro" or id == "assassino" then CFrame.Angles(math.rad(-90), 0, 0) else CFrame.new()
		exibicao:PivotTo(CFrame.new(base.Position + Vector3.new(0, 3.6, 0)) * orientacao)
		exibicao:SetAttribute("Giro", 0.8)
		exibicao:SetAttribute("Flutuar", 0.6)
		CollectionService:AddTag(exibicao, "Girar")
		exibicao.Parent = vivo

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Tornar-se " .. classe.nome
		prompt.ObjectText = classe.titulo
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 11
		prompt.RequiresLineOfSight = false
		prompt.Parent = altar
		prompt.Triggered:Connect(function(player)
			Lobby.escolherClasse(player, id)
		end)

		-- nome da classe dentro do arco, acima da arma
		letreiro(base.Position + Vector3.new(0, 8.6, 0), classe.icone .. " " .. string.upper(classe.nome), classe.titulo, classe.cor:Lerp(Color3.new(1, 1, 1), 0.35), 12)
	end
	letreiro(marcador("PlacaAltares").Position, "SANTUÁRIOS DAS CLASSES", "Chegue perto de um santuário para escolher", Color3.fromRGB(255, 220, 140))
end

local function construirLoja()
	local balcao = pecaDoMarcador("Loja")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Abrir loja"
	prompt.ObjectText = "Mercador"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = balcao
	prompt.Triggered:Connect(function(player)
		if not Partida.emPartida(player) then
			Remotos.enviar(player, "abrirLoja", {})
		end
	end)
	letreiro((marcador("Loja") * CFrame.new(5, 13.4, 0)).Position, "🛒 MERCADOR", "Melhorias permanentes", Color3.fromRGB(255, 205, 90))
end

local function construirPlaca()
	local quadro = mapa and mapa:FindFirstChild("QuadroComoJogar", true)
	if not quadro or not quadro:IsA("BasePart") then
		return
	end
	local tela = Instance.new("SurfaceGui")
	tela.Face = Enum.NormalId.Front
	tela.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	tela.PixelsPerStud = 50
	tela.LightInfluence = 0.2
	tela.Parent = quadro

	local titulo = Instance.new("TextLabel")
	titulo.Size = UDim2.fromScale(1, 0.2)
	titulo.BackgroundTransparency = 1
	titulo.FontFace = Font.new(Font.fromEnum(Enum.Font.Merriweather).Family, Enum.FontWeight.Bold)
	titulo.Text = "COMO JOGAR"
	titulo.TextColor3 = Color3.fromRGB(255, 236, 170)
	titulo.TextStrokeTransparency = 0.4
	titulo.TextScaled = true
	titulo.Parent = tela

	local regras = Instance.new("TextLabel")
	regras.Position = UDim2.fromScale(0.05, 0.22)
	regras.Size = UDim2.fromScale(0.9, 0.74)
	regras.BackgroundTransparency = 1
	regras.FontFace = Font.new(Font.fromEnum(Enum.Font.BuilderSans).Family, Enum.FontWeight.Bold)
	regras.TextColor3 = Color3.fromRGB(255, 250, 235)
	regras.TextStrokeTransparency = 0.5
	regras.TextScaled = true
	regras.TextWrapped = true
	regras.TextXAlignment = Enum.TextXAlignment.Left
	regras.Text = "1. Escolha sua classe nos santuários (à esquerda)\n"
		.. "2. Entre no círculo roxo com seu grupo\n"
		.. "3. Combo de 3 golpes, habilidade (E), esquiva (Q) e supremo (R)\n"
		.. "4. Limpe a sala e escolha uma carta de poder\n"
		.. "5. Aliado caído? Fique perto para reviver!\n"
		.. "6. Depois do chefe: SUBA com o ouro ou DESÇA mais fundo"
	regras.Parent = tela
end

local function construirNascimento()
	local nascimento = Instance.new("SpawnLocation")
	nascimento.Name = "Nascimento"
	nascimento.Anchored = true
	nascimento.Size = Vector3.new(10, 1, 6)
	nascimento.CFrame = marcador("Nascimento") * CFrame.new(0, -0.3, 0)
	nascimento.Transparency = 1
	nascimento.CanCollide = false
	nascimento.CanQuery = false
	nascimento.Neutral = true
	nascimento.Duration = 0
	nascimento.Parent = vivo
end

local function construirVagalumes()
	-- brilhinhos dourados flutuando pelo campo (efeito do pacote numa área de 200 x 200 em volta
	-- do marcador)
	local area = peca("Vagalumes", Vector3.new(200, 10, 200), marcador("Vagalumes"), Color3.new(1, 1, 1), { transparencia = 1 })
	local molde = efeitos and efeitos:FindFirstChild("CargaBrilhoCheia")
	if not molde then
		return
	end
	for _, original in molde:GetDescendants() do
		if original:IsA("ParticleEmitter") then
			local emissor = original:Clone()
			emissor.Color = ColorSequence.new(Color3.fromRGB(235, 255, 150))
			emissor.Rate = 14
			emissor.Shape = Enum.ParticleEmitterShape.Box
			emissor.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
			emissor.LockedToPart = false
			emissor.Enabled = true
			emissor.Parent = area
		end
	end
end

------------------------------------------------------------------------
-- API
------------------------------------------------------------------------

function Lobby.construir()
	prepararMapa()
	construirCristal()
	construirPortal()
	construirAltares()
	construirLoja()
	construirPlaca()
	construirNascimento()
	construirVagalumes()
	vivo.Parent = workspace
end

-- Coloca a arma e os acessórios da classe no personagem (no lobby, só para exibir)
function Lobby.vestirClasse(player: Player)
	local personagem = player.Character
	local perfil = Dados.obter(player)
	if not personagem or not perfil or Partida.emPartida(player) then
		return
	end
	Armas.vestir(personagem, perfil.Classe)
end

function Lobby.escolherClasse(player: Player, classe: any)
	if Partida.emPartida(player) or not Dados.definirClasse(player, classe) then
		return
	end
	Lobby.vestirClasse(player)
	Dados.enviarPerfil(player)
	local dados = Classes.obter(classe)
	Remotos.enviar(player, "aviso", { texto = dados.icone .. " Agora você é " .. dados.nome .. "!" })
	Vfx.todos("escolheuClasse", { jogador = player, cor = dados.cor })
end

-- Fica olhando quem está no círculo do portal e começa a partida após a contagem
function Lobby.iniciarFila()
	local fimContagem: number? = nil
	local ultimoEnviado = {}

	while true do
		task.wait(0.25)
		local naFila = {}
		for _, player in Players:GetPlayers() do
			local personagem = player.Character
			local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
			if raiz and humanoid and humanoid.Health > 0 and Dados.obter(player) and not Partida.emPartida(player) then
				local delta = raiz.Position - POSICAO_PORTAL
				if Vector3.new(delta.X, 0, delta.Z).Magnitude <= RAIO_PORTAL and math.abs(delta.Y) < 8 then
					table.insert(naFila, player)
				end
			end
		end

		local grupo = {}
		for i = 1, math.min(#naFila, Config.MAX_JOGADORES_POR_PARTIDA) do
			grupo[i] = naFila[i]
		end

		local agora = os.clock()
		if #grupo == 0 then
			fimContagem = nil
		else
			fimContagem = fimContagem or agora + Config.CONTAGEM_PORTAL
			if #grupo >= Config.MAX_JOGADORES_POR_PARTIDA then
				fimContagem = math.min(fimContagem :: number, agora + Config.CONTAGEM_PORTAL_CHEIO)
			end
		end

		local membros = {}
		for _, player in grupo do
			local perfil = Dados.obter(player)
			table.insert(membros, { userId = player.UserId, nome = player.DisplayName, classe = perfil and perfil.Classe or "cavaleiro" })
		end

		local mensagens = {}
		for _, player in grupo do
			mensagens[player] = {
				segundos = math.max(0, math.ceil((fimContagem :: number) - agora)),
				membros = membros,
				max = Config.MAX_JOGADORES_POR_PARTIDA,
			}
		end
		for _, player in naFila do
			if not mensagens[player] then
				mensagens[player] = { cheio = true }
			end
		end
		for _, player in Players:GetPlayers() do
			local mensagem = mensagens[player]
			local chave = "nada"
			if mensagem then
				if mensagem.cheio then
					chave = "cheio"
				else
					local ids = {}
					for _, membro in membros do
						table.insert(ids, membro.userId .. membro.classe)
					end
					chave = mensagem.segundos .. "|" .. table.concat(ids, ",")
				end
			end
			if ultimoEnviado[player] ~= chave then
				ultimoEnviado[player] = chave
				Remotos.enviar(player, "fila", mensagem or { esconder = true })
			end
		end
		for player in ultimoEnviado do
			if not player.Parent then
				ultimoEnviado[player] = nil
			end
		end

		if fimContagem and agora >= fimContagem then
			fimContagem = nil
			for _, player in grupo do
				ultimoEnviado[player] = "nada"
				Remotos.enviar(player, "fila", { esconder = true })
			end
			Partida.iniciar(grupo)
		end
	end
end

return Lobby
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX00000024">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source"><![CDATA[-- Script principal do servidor: monta o lobby e cuida da entrada e saída dos jogadores.

local Players = game:GetService("Players")

-- Os personagens são criados pelo nosso código (para controlar mortes e renascimentos)
Players.CharacterAutoLoads = false

local servidor = script.Parent
local Remotos = require(servidor.Remotos)
local Dados = require(servidor.Dados)
local Partida = require(servidor.Partida)
local Lobby = require(servidor.Lobby)

Lobby.construir()
task.spawn(Lobby.iniciarFila)

local function aoEntrar(player: Player)
	local perfil = Dados.carregar(player)
	if not perfil or not player.Parent then
		return
	end

	player.CharacterAdded:Connect(function(personagem)
		local humanoid = personagem:WaitForChild("Humanoid", 10) :: Humanoid?
		if not humanoid then
			return
		end
		if not Partida.emPartida(player) then
			task.defer(Lobby.vestirClasse, player)
		end
		-- Mortes no lobby: renasce em 3 segundos. Mortes na masmorra são tratadas pela Partida.
		humanoid.Died:Connect(function()
			if Partida.emPartida(player) then
				return
			end
			task.delay(3, function()
				if player.Parent and player.Character == personagem and not Partida.emPartida(player) then
					player:LoadCharacterAsync()
				end
			end)
		end)
	end)

	player:LoadCharacterAsync()
	Dados.enviarPerfil(player)
	Remotos.enviar(player, "lobby", {})
end

Players.PlayerAdded:Connect(aoEntrar)
for _, player in Players:GetPlayers() do
	task.spawn(aoEntrar, player)
end

Players.PlayerRemoving:Connect(function(player)
	Partida.removerJogador(player)
	Dados.salvarERemover(player)
end)

game:BindToClose(function()
	Dados.salvarTodos()
end)

local ultimoSalvarTeclas = {} -- [Player] = quando salvou as teclas pela última vez
Players.PlayerRemoving:Connect(function(player)
	ultimoSalvarTeclas[player] = nil
end)

local ACOES_DE_COMBATE = { atacar = true, carregar = true, soltar = true, cancelar = true, defender = true, habilidade = true, esquiva = true, supremo = true, correr = true }

Remotos.Acao.OnServerEvent:Connect(function(player, tipo, dados, extra)
	if type(tipo) ~= "string" then
		return
	end
	if ACOES_DE_COMBATE[tipo] then
		Partida.acaoDeCombate(player, tipo, dados, extra)
	elseif tipo == "pronto" then
		Dados.enviarPerfil(player)
		if not Partida.emPartida(player) then
			Remotos.enviar(player, "lobby", {})
		end
	elseif tipo == "salvarTeclas" then
		-- no máximo uma vez a cada 0,5s por jogador
		local agora = os.clock()
		if agora - (ultimoSalvarTeclas[player] or 0) >= 0.5 then
			ultimoSalvarTeclas[player] = agora
			Dados.definirTeclas(player, dados)
		end
	elseif tipo == "escolherClasse" then
		Lobby.escolherClasse(player, dados)
	elseif tipo == "escolherCarta" then
		Partida.escolherCarta(player, dados)
	elseif tipo == "elevador" then
		Partida.escolherElevador(player, dados)
	elseif tipo == "comprarMelhoria" then
		if Partida.emPartida(player) then
			return
		end
		local _, mensagem = Dados.comprarMelhoria(player, dados)
		Remotos.enviar(player, "aviso", { texto = mensagem })
		Dados.enviarPerfil(player)
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000025">
        <Properties>
          <string name="Name">Masmorra</string>
          <ProtectedString name="Source"><![CDATA[-- Gera as salas da masmorra por código. Cada sala é sorteada na hora: tamanho, pilares,
-- lava e decoração mudam a cada partida, e o visual muda conforme o tema do andar.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Masmorra = {}

local ALTURA_PAREDE = 24
local LARGURA_PORTA = 10
local ALTURA_PORTA = 13
local TAMANHO_LAJOTA = 10
local EM_PE = CFrame.Angles(0, 0, math.rad(90)) -- deixa um cilindro em pé (ou deitado como disco)

local function planar(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function escurecer(cor: Color3, quanto: number): Color3
	return cor:Lerp(Color3.new(0, 0, 0), quanto)
end

local function variar(cor: Color3, rng: Random, quanto: number): Color3
	local fator = 1 + rng:NextNumber(-quanto, quanto)
	return Color3.new(math.clamp(cor.R * fator, 0, 1), math.clamp(cor.G * fator, 0, 1), math.clamp(cor.B * fator, 0, 1))
end

-- opcoes: formato, colide (padrão true), transparencia, sombra (padrão true)
local function parte(pai: Instance, nome: string, tamanho: Vector3, cframe: CFrame, material: Enum.Material, cor: Color3, opcoes): Part
	opcoes = opcoes or {}
	local p = Instance.new("Part")
	p.Name = nome
	p.Anchored = true
	p.Shape = opcoes.formato or Enum.PartType.Block
	p.Size = tamanho
	p.CFrame = cframe
	p.Material = material
	p.Color = cor
	p.Transparency = opcoes.transparencia or 0
	p.CanCollide = opcoes.colide ~= false
	p.CastShadow = opcoes.sombra ~= false
	if opcoes.colide == false then
		p.CanQuery = false
		p.CanTouch = false
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = pai
	return p
end

local function ponta(pai: Instance, nome: string, tamanho: Vector3, cframe: CFrame, material: Enum.Material, cor: Color3): CornerWedgePart
	local w = Instance.new("CornerWedgePart")
	w.Name = nome
	w.Anchored = true
	w.Size = tamanho
	w.CFrame = cframe
	w.Material = material
	w.Color = cor
	w.CanCollide = false
	w.CanQuery = false
	w.Parent = pai
	return w
end

local function luz(pai: Instance, cor: Color3, alcance: number, brilho: number, tremula: boolean?)
	local l = Instance.new("PointLight")
	l.Color = cor
	l.Range = alcance
	l.Brightness = brilho
	l.Parent = pai
	if tremula then
		CollectionService:AddTag(l, "Chama") -- os jogadores fazem a luz tremular
	end
	return l
end

local function sequencia(pontos): NumberSequence
	local chaves = {}
	for _, ponto in pontos do
		table.insert(chaves, NumberSequenceKeypoint.new(ponto[1], ponto[2]))
	end
	return NumberSequence.new(chaves)
end

-- Fogo: chama clássica + faíscas subindo
local function fogo(pai: BasePart, cor: Color3, tamanho: number)
	local f = Instance.new("Fire")
	f.Size = tamanho
	f.Heat = tamanho * 2
	f.Color = cor
	f.SecondaryColor = Color3.fromRGB(255, 60, 10)
	f.Parent = pai

	local e = Instance.new("ParticleEmitter")
	e.Name = "Faiscas"
	e.Color = ColorSequence.new(Color3.fromRGB(255, 230, 160), cor)
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Size = sequencia({ { 0, 0.18 * tamanho / 2 }, { 1, 0 } })
	e.Transparency = sequencia({ { 0, 0 }, { 1, 1 } })
	e.Lifetime = NumberRange.new(0.8, 1.6)
	e.Speed = NumberRange.new(2, 5)
	e.SpreadAngle = Vector2.new(25, 25)
	e.Acceleration = Vector3.new(0, 4, 0)
	e.Drag = 1
	e.Rate = 6 * tamanho
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = pai
end

------------------------------------------------------------------------
-- Posições livres
------------------------------------------------------------------------

-- Caminho da entrada até a porta (nada que atrapalhe é colocado ali)
local function noCaminho(sala, pos: Vector3, folga: number): boolean
	local local_ = pos - sala.origem
	local meiaC = sala.comprimento / 2
	local pertoDaEntrada = (planar(local_) - Vector3.new(0, 0, -meiaC + 7)).Magnitude < 12 + folga
	local pertoDaPorta = math.abs(local_.X) < 8 + folga and local_.Z > meiaC - 14 - folga
	return pertoDaEntrada or pertoDaPorta
end

function Masmorra.posicaoValida(sala, pos: Vector3, raio: number): boolean
	local local_ = pos - sala.origem
	if math.abs(local_.X) > sala.largura / 2 - raio or math.abs(local_.Z) > sala.comprimento / 2 - raio then
		return false
	end
	for _, pilar in sala.pilares do
		if planar(pos - pilar.pos).Magnitude < pilar.raio + raio then
			return false
		end
	end
	for _, perigo in sala.perigos do
		local d = pos - perigo.centro
		if math.abs(d.X) < perigo.meio.X + raio and math.abs(d.Z) < perigo.meio.Z + raio then
			return false
		end
	end
	return true
end

local function posicaoLivre(sala, rng: Random, raio: number, evitarCaminho: boolean): Vector3?
	for _ = 1, 40 do
		local x = rng:NextNumber(-sala.largura / 2 + raio + 2, sala.largura / 2 - raio - 2)
		local z = rng:NextNumber(-sala.comprimento / 2 + raio + 2, sala.comprimento / 2 - raio - 2)
		local pos = sala.origem + Vector3.new(x, 0, z)
		if Masmorra.posicaoValida(sala, pos, raio) and not (evitarCaminho and noCaminho(sala, pos, raio)) then
			return pos
		end
	end
	return nil
end

function Masmorra.pontoLivre(sala, rng: Random, raio: number): Vector3?
	return posicaoLivre(sala, rng, raio, false)
end

-- Ponto encostado numa parede (para decoração), com a direção "para dentro" da sala
local function pontoNaParede(sala, rng: Random, recuo: number): (Vector3, Vector3)
	local meiaL, meiaC = sala.largura / 2, sala.comprimento / 2
	local lado = rng:NextInteger(1, 3) -- 1 esquerda, 2 direita, 3 fundo
	if lado == 1 then
		return sala.origem + Vector3.new(-meiaL + recuo, 0, rng:NextNumber(-meiaC + 14, meiaC - 6)), Vector3.new(1, 0, 0)
	elseif lado == 2 then
		return sala.origem + Vector3.new(meiaL - recuo, 0, rng:NextNumber(-meiaC + 14, meiaC - 6)), Vector3.new(-1, 0, 0)
	end
	local x = rng:NextNumber(meiaL * 0.35, meiaL - 6) * (if rng:NextNumber() < 0.5 then -1 else 1)
	return sala.origem + Vector3.new(x, 0, -meiaC + recuo), Vector3.new(0, 0, 1)
end

-- Registra um objeto como obstáculo (inimigos desviam e projéteis batem nele)
local function obstaculo(sala, pos: Vector3, raio: number)
	table.insert(sala.pilares, { pos = pos, raio = raio })
end

------------------------------------------------------------------------
-- Partes da sala
------------------------------------------------------------------------

local function criarChao(sala, rng: Random)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	parte(modelo, "Base", Vector3.new(sala.largura + 4, 2, sala.comprimento + 4), CFrame.new(origem + Vector3.new(0, -1.2, 0)), tema.detalhe.material, escurecer(tema.detalhe.cor, 0.35))
	-- Lajotas com pequenas variações de cor (as frestas mostram a base mais escura)
	local colunas = math.ceil(sala.largura / TAMANHO_LAJOTA)
	local linhas = math.ceil(sala.comprimento / TAMANHO_LAJOTA)
	local larguraLajota = sala.largura / colunas
	local comprimentoLajota = sala.comprimento / linhas
	for i = 0, colunas - 1 do
		for j = 0, linhas - 1 do
			local x = -sala.largura / 2 + (i + 0.5) * larguraLajota
			local z = -sala.comprimento / 2 + (j + 0.5) * comprimentoLajota
			local especial = rng:NextNumber() < 0.08
			parte(
				modelo,
				"Lajota",
				Vector3.new(larguraLajota - 0.3, 0.6, comprimentoLajota - 0.3),
				CFrame.new(origem + Vector3.new(x, -0.3, z)),
				if especial then tema.detalhe.material else tema.chao.material,
				variar(if especial then tema.detalhe.cor else tema.chao.cor, rng, 0.09),
				{ sombra = false }
			)
		end
	end
end

local function criarArandela(sala, pos: Vector3, paraDentro: Vector3)
	local tema, modelo = sala.tema, sala.modelo
	local base = CFrame.lookAt(pos, pos + paraDentro)
	parte(modelo, "Suporte", Vector3.new(0.5, 0.5, 1.6), base * CFrame.new(0, 0, -0.6), Enum.Material.Metal, Color3.fromRGB(45, 40, 40), { colide = false })
	local tigela = parte(modelo, "Tigela", Vector3.new(0.7, 1.2, 1.2), base * CFrame.new(0, 0.2, -1.4) * EM_PE, Enum.Material.Metal, Color3.fromRGB(60, 52, 48), { formato = Enum.PartType.Cylinder, colide = false })
	local chama = parte(modelo, "Chama", Vector3.new(0.6, 0.6, 0.6), tigela.CFrame * CFrame.new(0.6, 0, 0), Enum.Material.Neon, tema.luz, { colide = false, sombra = false })
	fogo(chama, tema.luz, 2.2)
	luz(chama, tema.luz, 22, 1.7, true)
end

local function criarBraseiro(sala, pos: Vector3, escala: number)
	local tema, modelo = sala.tema, sala.modelo
	parte(modelo, "PeBraseiro", Vector3.new(3 * escala, 1.4 * escala, 1.4 * escala), CFrame.new(pos + Vector3.new(0, 1.5 * escala, 0)) * EM_PE, tema.detalhe.material, tema.detalhe.cor, { formato = Enum.PartType.Cylinder })
	parte(modelo, "Base", Vector3.new(0.6 * escala, 2.4 * escala, 2.4 * escala), CFrame.new(pos + Vector3.new(0, 0.3 * escala, 0)) * EM_PE, tema.detalhe.material, escurecer(tema.detalhe.cor, 0.2), { formato = Enum.PartType.Cylinder })
	local tigela = parte(modelo, "Tigela", Vector3.new(1 * escala, 3 * escala, 3 * escala), CFrame.new(pos + Vector3.new(0, 3.3 * escala, 0)) * EM_PE, Enum.Material.Metal, Color3.fromRGB(55, 48, 44), { formato = Enum.PartType.Cylinder })
	local brasa = parte(modelo, "Brasa", Vector3.new(0.3, 2.4 * escala, 2.4 * escala), tigela.CFrame * CFrame.new(0.5 * escala, 0, 0), Enum.Material.Neon, tema.luz, { formato = Enum.PartType.Cylinder, colide = false })
	fogo(brasa, tema.luz, 4 * escala)
	luz(brasa, tema.luz, 30 * escala, 2, true)
	obstaculo(sala, pos, 1.6 * escala)
end

local function criarParedes(sala)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local meiaL, meiaC = sala.largura / 2, sala.comprimento / 2
	local y = ALTURA_PAREDE / 2
	local corParede, matParede = tema.parede.cor, tema.parede.material
	local corDetalhe, matDetalhe = tema.detalhe.cor, tema.detalhe.material

	local function parede(tamanho: Vector3, posicao: Vector3)
		parte(modelo, "Parede", tamanho, CFrame.new(origem + posicao), matParede, corParede)
	end

	parede(Vector3.new(2, ALTURA_PAREDE, sala.comprimento + 4), Vector3.new(-meiaL - 1, y, 0))
	parede(Vector3.new(2, ALTURA_PAREDE, sala.comprimento + 4), Vector3.new(meiaL + 1, y, 0))
	parede(Vector3.new(sala.largura + 4, ALTURA_PAREDE, 2), Vector3.new(0, y, -meiaC - 1))
	local segmento = (sala.largura + 4 - LARGURA_PORTA) / 2
	parede(Vector3.new(segmento, ALTURA_PAREDE, 2), Vector3.new(-(LARGURA_PORTA / 2 + segmento / 2), y, meiaC + 1))
	parede(Vector3.new(segmento, ALTURA_PAREDE, 2), Vector3.new(LARGURA_PORTA / 2 + segmento / 2, y, meiaC + 1))
	local alturaVerga = ALTURA_PAREDE - ALTURA_PORTA
	parede(Vector3.new(LARGURA_PORTA, alturaVerga, 2), Vector3.new(0, ALTURA_PORTA + alturaVerga / 2, meiaC + 1))

	-- Rodapé e cornija (dão volume às paredes)
	for _, info in {
		{ Vector3.new(1, 1.6, sala.comprimento), Vector3.new(-meiaL + 0.5, 0.8, 0) },
		{ Vector3.new(1, 1.6, sala.comprimento), Vector3.new(meiaL - 0.5, 0.8, 0) },
		{ Vector3.new(sala.largura, 1.6, 1), Vector3.new(0, 0.8, -meiaC + 0.5) },
	} do
		parte(modelo, "Rodape", info[1], CFrame.new(origem + info[2]), matDetalhe, corDetalhe)
		parte(modelo, "Cornija", info[1] + Vector3.new(0.6, -0.4, 0.6), CFrame.new(origem + info[2] + Vector3.new(0, ALTURA_PAREDE - 1.6, 0)), matDetalhe, corDetalhe, { colide = false })
	end

	-- Contrafortes ao longo das paredes laterais, com arandelas entre eles
	local passos = math.max(3, math.floor(sala.comprimento / 16))
	for i = 0, passos do
		local z = -meiaC + 4 + i * ((sala.comprimento - 8) / passos)
		for _, lado in { -1, 1 } do
			local x = lado * (meiaL - 1)
			parte(modelo, "Contraforte", Vector3.new(2.4, ALTURA_PAREDE, 2.4), CFrame.new(origem + Vector3.new(x, y, z)), matDetalhe, corDetalhe)
			parte(modelo, "Capitel", Vector3.new(3, 1, 3), CFrame.new(origem + Vector3.new(x, ALTURA_PAREDE - 3, z)), matDetalhe, escurecer(corDetalhe, 0.15), { colide = false })
			if i < passos and i % 2 == 0 then
				local zMeio = z + (sala.comprimento - 8) / passos / 2
				criarArandela(sala, origem + Vector3.new(lado * meiaL, 8, zMeio), Vector3.new(-lado, 0, 0))
			end
		end
	end

	-- Estandartes no fundo
	for _, x in { -meiaL / 2, meiaL / 2 } do
		local estandarte = parte(modelo, "Estandarte", Vector3.new(4.4, 9, 0.2), CFrame.new(origem + Vector3.new(x, 13, -meiaC + 0.2)), Enum.Material.Fabric, Color3.fromRGB(120, 24, 34), { colide = false })
		parte(modelo, "Barra", Vector3.new(5.2, 0.3, 0.3), estandarte.CFrame * CFrame.new(0, 4.6, 0), Enum.Material.Metal, Color3.fromRGB(200, 160, 70), { colide = false })
		parte(modelo, "Simbolo", Vector3.new(1.6, 1.6, 0.1), estandarte.CFrame * CFrame.new(0, 1, -0.12) * CFrame.Angles(0, 0, math.rad(45)), Enum.Material.Neon, tema.luz, { colide = false })
	end
end

local function criarPorta(sala)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local meiaC = sala.comprimento / 2
	local corDetalhe, matDetalhe = tema.detalhe.cor, tema.detalhe.material
	local zParede = meiaC + 1

	-- Moldura em arco
	for _, lado in { -1, 1 } do
		parte(modelo, "Umbral", Vector3.new(2.2, ALTURA_PORTA + 1, 3), CFrame.new(origem + Vector3.new(lado * (LARGURA_PORTA / 2 + 1), (ALTURA_PORTA + 1) / 2, zParede - 0.5)), matDetalhe, corDetalhe)
	end
	parte(modelo, "Arco", Vector3.new(LARGURA_PORTA + 4.4, 2.2, 3), CFrame.new(origem + Vector3.new(0, ALTURA_PORTA + 1.1, zParede - 0.5)), matDetalhe, corDetalhe)
	local runa = parte(modelo, "Runa", Vector3.new(1.4, 1.4, 0.3), CFrame.new(origem + Vector3.new(0, ALTURA_PORTA + 1.1, zParede - 2.05)) * CFrame.Angles(0, 0, math.rad(45)), Enum.Material.Neon, Color3.fromRGB(255, 70, 70), { colide = false })
	sala.runaPorta = runa

	-- Grade levadiça (sobe quando a sala é limpa)
	local grade = Instance.new("Model")
	grade.Name = "Grade"
	local corFerro = Color3.fromRGB(46, 44, 46)
	for i = 0, 5 do
		local x = -LARGURA_PORTA / 2 + 0.8 + i * ((LARGURA_PORTA - 1.6) / 5)
		parte(grade, "Barra", Vector3.new(0.5, ALTURA_PORTA, 0.5), CFrame.new(origem + Vector3.new(x, ALTURA_PORTA / 2, zParede)), Enum.Material.Metal, corFerro)
	end
	for _, h in { 3, 7, 11 } do
		parte(grade, "Travessa", Vector3.new(LARGURA_PORTA, 0.4, 0.4), CFrame.new(origem + Vector3.new(0, h, zParede)), Enum.Material.Metal, corFerro)
	end
	grade.Parent = modelo
	sala.grade = grade

	-- Gatilho invisível no vão (quem entra vai para a próxima sala)
	local gatilho = parte(modelo, "Porta", Vector3.new(LARGURA_PORTA, ALTURA_PORTA, 1.5), CFrame.new(origem + Vector3.new(0, ALTURA_PORTA / 2, zParede + 1.5)), Enum.Material.Neon, Color3.fromRGB(80, 255, 140), { colide = false, transparencia = 1 })
	gatilho.CanTouch = true
	sala.porta = gatilho

	-- Corredor com névoa atrás da porta
	parte(modelo, "Corredor", Vector3.new(LARGURA_PORTA + 4, 2, 14), CFrame.new(origem + Vector3.new(0, -1, meiaC + 9)), tema.chao.material, escurecer(tema.chao.cor, 0.3))
	parte(modelo, "ParedeCorredor", Vector3.new(2, ALTURA_PORTA + 2, 14), CFrame.new(origem + Vector3.new(-LARGURA_PORTA / 2 - 1, ALTURA_PORTA / 2, meiaC + 9)), tema.parede.material, tema.parede.cor)
	parte(modelo, "ParedeCorredor", Vector3.new(2, ALTURA_PORTA + 2, 14), CFrame.new(origem + Vector3.new(LARGURA_PORTA / 2 + 1, ALTURA_PORTA / 2, meiaC + 9)), tema.parede.material, tema.parede.cor)
	parte(modelo, "FundoCorredor", Vector3.new(LARGURA_PORTA + 4, ALTURA_PORTA + 2, 2), CFrame.new(origem + Vector3.new(0, ALTURA_PORTA / 2, meiaC + 17)), tema.parede.material, tema.parede.cor)
	local nevoa = parte(modelo, "Nevoa", Vector3.new(LARGURA_PORTA, 1, 10), CFrame.new(origem + Vector3.new(0, 0.6, meiaC + 9)), Enum.Material.SmoothPlastic, Color3.new(1, 1, 1), { colide = false, transparencia = 1 })
	local emissor = Instance.new("ParticleEmitter")
	emissor.Name = "Nevoa"
	emissor.Color = ColorSequence.new(tema.nevoa:Lerp(Color3.new(1, 1, 1), 0.3))
	emissor.Size = sequencia({ { 0, 3 }, { 1, 6 } })
	emissor.Transparency = sequencia({ { 0, 1 }, { 0.3, 0.75 }, { 1, 1 } })
	emissor.Lifetime = NumberRange.new(3, 5)
	emissor.Speed = NumberRange.new(0.3, 1)
	emissor.SpreadAngle = Vector2.new(180, 30)
	emissor.Rate = 8
	emissor.Shape = Enum.ParticleEmitterShape.Box
	emissor.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emissor.Parent = nevoa
	sala.luzPorta = luz(nevoa, Color3.fromRGB(255, 80, 80), 18, 1.2, false)
end

local function criarEntrada(sala)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local meiaC = sala.comprimento / 2
	local centro = origem + Vector3.new(0, 0.05, -meiaC + 7)
	-- Círculo de runas onde o grupo aparece (anel = disco brilhante + disco do chão por cima)
	parte(modelo, "Circulo", Vector3.new(0.12, 11, 11), CFrame.new(centro) * EM_PE, Enum.Material.Neon, tema.luz, { formato = Enum.PartType.Cylinder, colide = false, transparencia = 0.3, sombra = false })
	parte(modelo, "CirculoMiolo", Vector3.new(0.14, 10, 10), CFrame.new(centro + Vector3.new(0, 0.02, 0)) * EM_PE, tema.chao.material, escurecer(tema.chao.cor, 0.15), { formato = Enum.PartType.Cylinder, colide = false, sombra = false })
	parte(modelo, "PortaEntrada", Vector3.new(LARGURA_PORTA, ALTURA_PORTA, 0.6), CFrame.new(origem + Vector3.new(0, ALTURA_PORTA / 2, -meiaC + 0.1)), Enum.Material.WoodPlanks, Color3.fromRGB(70, 46, 30))
	for _, lado in { -1, 1 } do
		parte(modelo, "UmbralEntrada", Vector3.new(2, ALTURA_PORTA + 1, 1.6), CFrame.new(origem + Vector3.new(lado * (LARGURA_PORTA / 2 + 1), (ALTURA_PORTA + 1) / 2, -meiaC + 0.6)), tema.detalhe.material, tema.detalhe.cor)
	end
end

local function criarPilares(sala, rng: Random)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local posicoes = {}
	if sala.tipo == "chefe" then
		local dx, dz = sala.largura / 3, sala.comprimento / 3
		posicoes = {
			origem + Vector3.new(-dx, 0, -dz / 2),
			origem + Vector3.new(dx, 0, -dz / 2),
			origem + Vector3.new(-dx, 0, dz),
			origem + Vector3.new(dx, 0, dz),
			origem + Vector3.new(-dx * 1.15, 0, dz * 0.25),
			origem + Vector3.new(dx * 1.15, 0, dz * 0.25),
		}
	elseif sala.tipo == "combate" then
		-- mais pilares em salas maiores (cobertura contra disparos)
		local area = sala.largura * sala.comprimento / 8000
		for _ = 1, math.floor(rng:NextInteger(3, 6) * area + 0.5) do
			local pos = posicaoLivre(sala, rng, 9, true)
			if pos then
				table.insert(posicoes, pos)
				-- reserva o espaço para o próximo pilar não ficar colado neste
				table.insert(sala.pilares, { pos = pos, raio = 5 })
			end
		end
		table.clear(sala.pilares)
	end

	for _, pos in posicoes do
		local diametro = rng:NextInteger(4, 6)
		parte(modelo, "Pilar", Vector3.new(ALTURA_PAREDE, diametro, diametro), CFrame.new(pos + Vector3.new(0, ALTURA_PAREDE / 2, 0)) * EM_PE, tema.parede.material, tema.parede.cor, { formato = Enum.PartType.Cylinder })
		parte(modelo, "BasePilar", Vector3.new(diametro + 1.6, 1.6, diametro + 1.6), CFrame.new(pos + Vector3.new(0, 0.8, 0)), tema.detalhe.material, tema.detalhe.cor)
		parte(modelo, "AnelPilar", Vector3.new(0.8, diametro + 0.6, diametro + 0.6), CFrame.new(pos + Vector3.new(0, 2.2, 0)) * EM_PE, tema.detalhe.material, escurecer(tema.detalhe.cor, 0.15), { formato = Enum.PartType.Cylinder })
		parte(modelo, "Capitel", Vector3.new(diametro + 1.4, 1.4, diametro + 1.4), CFrame.new(pos + Vector3.new(0, ALTURA_PAREDE - 2, 0)), tema.detalhe.material, tema.detalhe.cor, { colide = false })
		-- Runa brilhante no pilar
		parte(modelo, "RunaPilar", Vector3.new(0.2, 1.2, 1.2), CFrame.new(pos + Vector3.new(0, 7, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0) * CFrame.new(diametro / 2, 0, 0) * CFrame.Angles(math.rad(45), 0, 0), Enum.Material.Neon, tema.luz, { colide = false, sombra = false })
		table.insert(sala.pilares, { pos = pos, raio = diametro / 2 + 0.6 })
	end
end

local function criarLava(sala, rng: Random)
	if sala.tipo ~= "combate" then
		return
	end
	if not (sala.tema.lava or (sala.numero >= 7 and rng:NextNumber() < 0.35)) then
		return
	end
	for _ = 1, rng:NextInteger(2, 4) do
		local tamanho = Vector3.new(rng:NextInteger(8, 16), 0.4, rng:NextInteger(8, 16))
		local pos = posicaoLivre(sala, rng, math.max(tamanho.X, tamanho.Z) / 2 + 2, true)
		if pos then
			parte(sala.modelo, "Borda", tamanho + Vector3.new(1.6, 0.3, 1.6), CFrame.new(pos + Vector3.new(0, 0.1, 0)), Enum.Material.Basalt, Color3.fromRGB(35, 28, 28), { colide = false })
			local lava = parte(sala.modelo, "Lava", tamanho, CFrame.new(pos + Vector3.new(0, 0.2, 0)), Enum.Material.Neon, Color3.fromRGB(255, 96, 24), { colide = false, sombra = false })
			luz(lava, Color3.fromRGB(255, 110, 40), 18, 1.6, true)
			local brasas = Instance.new("ParticleEmitter")
			brasas.Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 70, 20))
			brasas.LightEmission = 1
			brasas.Size = sequencia({ { 0, 0.3 }, { 1, 0 } })
			brasas.Lifetime = NumberRange.new(1, 2)
			brasas.Speed = NumberRange.new(2, 5)
			brasas.SpreadAngle = Vector2.new(20, 20)
			brasas.Rate = 10
			brasas.EmissionDirection = Enum.NormalId.Top
			brasas.Shape = Enum.ParticleEmitterShape.Box
			brasas.Parent = lava
			table.insert(sala.perigos, { centro = pos, meio = Vector3.new(tamanho.X / 2, 0, tamanho.Z / 2) })
		end
	end
end

-- Decoração própria de cada tema, encostada nas paredes
local function criarDecoracao(sala, rng: Random)
	local tema, modelo = sala.tema, sala.modelo
	local area = sala.largura * sala.comprimento / 7000
	local quantidade = math.floor(rng:NextInteger(6, 10) * math.max(1, area) + 0.5)
	for _ = 1, quantidade do
		local pos, dentro = pontoNaParede(sala, rng, 3)
		local giro = CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		if tema.id == "calabouco" then
			if rng:NextNumber() < 0.5 then
				local barril = parte(modelo, "Barril", Vector3.new(3, 2.2, 2.2), CFrame.new(pos + Vector3.new(0, 1.5, 0)) * EM_PE, Enum.Material.WoodPlanks, Color3.fromRGB(110, 72, 44), { formato = Enum.PartType.Cylinder })
				for _, h in { -0.9, 0.9 } do
					parte(modelo, "Aro", Vector3.new(0.2, 2.3, 2.3), barril.CFrame * CFrame.new(h, 0, 0), Enum.Material.Metal, Color3.fromRGB(60, 56, 56), { formato = Enum.PartType.Cylinder, colide = false })
				end
				obstaculo(sala, pos, 1.3)
			else
				local tamanho = rng:NextNumber(2.2, 3.2)
				parte(modelo, "Caixote", Vector3.one * tamanho, CFrame.new(pos + Vector3.new(0, tamanho / 2, 0)) * giro, Enum.Material.WoodPlanks, Color3.fromRGB(125, 88, 52))
				if rng:NextNumber() < 0.5 then
					parte(modelo, "Caixote", Vector3.one * tamanho * 0.7, CFrame.new(pos + Vector3.new(0, tamanho + tamanho * 0.35, 0)) * giro * CFrame.Angles(0, 0.4, 0), Enum.Material.WoodPlanks, Color3.fromRGB(110, 76, 46))
				end
				obstaculo(sala, pos, tamanho * 0.7)
			end
			-- Crânio no chão
			parte(modelo, "Cranio", Vector3.one * 0.8, CFrame.new(pos + dentro * 2.5 + Vector3.new(0, 0.4, 0)), Enum.Material.SmoothPlastic, Color3.fromRGB(225, 218, 196), { formato = Enum.PartType.Ball, colide = false })
		elseif tema.id == "caverna" then
			if rng:NextNumber() < 0.6 then
				-- Cogumelos brilhantes
				for k = 1, rng:NextInteger(2, 4) do
					local p = pos + Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
					local altura = rng:NextNumber(1.2, 3.5)
					parte(modelo, "Caule", Vector3.new(altura, 0.5, 0.5), CFrame.new(p + Vector3.new(0, altura / 2, 0)) * EM_PE, Enum.Material.SmoothPlastic, Color3.fromRGB(220, 215, 190), { formato = Enum.PartType.Cylinder, colide = false })
					local chapeu = parte(modelo, "Chapeu", Vector3.new(0.6, altura * 0.9 + 0.6, altura * 0.9 + 0.6), CFrame.new(p + Vector3.new(0, altura + 0.2, 0)) * EM_PE, Enum.Material.Neon, if k % 2 == 0 then Color3.fromRGB(90, 255, 180) else Color3.fromRGB(140, 120, 255), { formato = Enum.PartType.Cylinder, colide = false })
					if k == 1 then
						luz(chapeu, chapeu.Color, 10, 1, false)
					end
				end
			else
				-- Estalagmite
				local altura = rng:NextNumber(5, 9)
				for k = 0, 2 do
					local h = altura * (1 - k * 0.3)
					parte(modelo, "Estalagmite", Vector3.new(h, 2.6 - k * 0.7, 2.6 - k * 0.7), CFrame.new(pos + Vector3.new(0, h / 2, 0)) * EM_PE, tema.parede.material, escurecer(tema.parede.cor, k * 0.08), { formato = Enum.PartType.Cylinder })
				end
				obstaculo(sala, pos, 1.4)
			end
		elseif tema.id == "cripta" then
			if rng:NextNumber() < 0.55 then
				-- Lápide
				local lapide = CFrame.lookAt(pos, pos + dentro)
				parte(modelo, "Lapide", Vector3.new(2.4, 3, 0.6), lapide * CFrame.new(0, 1.5, 0), Enum.Material.Slate, Color3.fromRGB(120, 125, 140))
				parte(modelo, "TopoLapide", Vector3.new(0.6, 2.4, 2.4), lapide * CFrame.new(0, 3, 0) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Slate, Color3.fromRGB(120, 125, 140), { formato = Enum.PartType.Cylinder, colide = false })
				local vela = parte(modelo, "Vela", Vector3.new(0.3, 0.8, 0.3), lapide * CFrame.new(0.8, 0.4, -1), Enum.Material.SmoothPlastic, Color3.fromRGB(230, 230, 240), { colide = false })
				local chama = parte(modelo, "ChamaVela", Vector3.one * 0.25, vela.CFrame * CFrame.new(0, 0.55, 0), Enum.Material.Neon, Color3.fromRGB(140, 210, 255), { colide = false, sombra = false })
				luz(chama, Color3.fromRGB(140, 210, 255), 8, 1, true)
				obstaculo(sala, pos, 1.3)
			else
				-- Cristais de gelo
				for _ = 1, rng:NextInteger(2, 4) do
					local altura = rng:NextNumber(2, 6)
					local p = pos + Vector3.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
					parte(modelo, "Cristal", Vector3.new(1, altura, 1), CFrame.new(p + Vector3.new(0, altura / 2 - 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, 3), rng:NextNumber(-0.35, 0.35)), Enum.Material.Glass, Color3.fromRGB(160, 220, 255), { colide = false, transparencia = 0.25 })
				end
				local nucleo = parte(modelo, "Nucleo", Vector3.one * 0.6, CFrame.new(pos + Vector3.new(0, 1, 0)), Enum.Material.Neon, Color3.fromRGB(150, 220, 255), { colide = false, sombra = false })
				luz(nucleo, nucleo.Color, 10, 1, false)
			end
		else
			if rng:NextNumber() < 0.6 then
				-- Espinhos de obsidiana
				for _ = 1, rng:NextInteger(2, 4) do
					local altura = rng:NextNumber(3, 7)
					local p = pos + Vector3.new(rng:NextNumber(-1.8, 1.8), 0, rng:NextNumber(-1.8, 1.8))
					ponta(modelo, "Espinho", Vector3.new(1.4, altura, 1.4), CFrame.new(p + Vector3.new(0, altura / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), Enum.Material.Basalt, Color3.fromRGB(28, 22, 26))
				end
				obstaculo(sala, pos, 1.6)
			else
				-- Fenda de lava na parede
				local fenda = parte(modelo, "Fenda", Vector3.new(0.4, rng:NextNumber(4, 9), 1.2), CFrame.lookAt(pos - dentro * 2.3, pos) * CFrame.new(0, 3, 0), Enum.Material.Neon, Color3.fromRGB(255, 100, 30), { colide = false, sombra = false })
				luz(fenda, Color3.fromRGB(255, 110, 40), 14, 1.4, true)
			end
		end
	end
end

-- Partículas no ar da sala (poeira, esporos, neve ou brasas)
local function criarAtmosfera(sala)
	local tema = sala.tema
	local volume = parte(sala.modelo, "Atmosfera", Vector3.new(sala.largura - 4, 12, sala.comprimento - 4), CFrame.new(sala.origem + Vector3.new(0, 8, 0)), Enum.Material.SmoothPlastic, Color3.new(1, 1, 1), { colide = false, transparencia = 1, sombra = false })
	local e = Instance.new("ParticleEmitter")
	e.Name = "Ambiente"
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.LightInfluence = 0
	local area = sala.largura * sala.comprimento / 6000
	if tema.particulas == "neve" then
		e.Color = ColorSequence.new(Color3.fromRGB(235, 245, 255))
		e.Size = sequencia({ { 0, 0.25 }, { 1, 0.15 } })
		e.Transparency = sequencia({ { 0, 1 }, { 0.15, 0.2 }, { 1, 1 } })
		e.Lifetime = NumberRange.new(5, 8)
		e.Speed = NumberRange.new(1, 2)
		e.Acceleration = Vector3.new(0.4, -1.5, 0)
		e.Rate = 50 * area
		e.LightEmission = 0.4
	elseif tema.particulas == "brasas" then
		e.Color = ColorSequence.new(Color3.fromRGB(255, 210, 90), Color3.fromRGB(255, 70, 20))
		e.Size = sequencia({ { 0, 0.22 }, { 1, 0 } })
		e.Transparency = sequencia({ { 0, 0 }, { 1, 1 } })
		e.Lifetime = NumberRange.new(3, 6)
		e.Speed = NumberRange.new(1, 3)
		e.Acceleration = Vector3.new(0, 1.5, 0)
		e.Rate = 40 * area
		e.LightEmission = 1
	elseif tema.particulas == "esporos" then
		e.Color = ColorSequence.new(Color3.fromRGB(150, 255, 170), Color3.fromRGB(120, 200, 255))
		e.Size = sequencia({ { 0, 0 }, { 0.3, 0.25 }, { 1, 0 } })
		e.Transparency = NumberSequence.new(0.2)
		e.Lifetime = NumberRange.new(4, 7)
		e.Speed = NumberRange.new(0.2, 0.8)
		e.Acceleration = Vector3.new(0, 0.3, 0)
		e.Rate = 30 * area
		e.LightEmission = 1
	else
		e.Color = ColorSequence.new(Color3.fromRGB(220, 205, 185))
		e.Size = sequencia({ { 0, 0 }, { 0.3, 0.15 }, { 1, 0 } })
		e.Transparency = NumberSequence.new(0.45)
		e.Lifetime = NumberRange.new(5, 9)
		e.Speed = NumberRange.new(0.1, 0.5)
		e.Rate = 25 * area
		e.LightEmission = 0.3
	end
	e.SpreadAngle = Vector2.new(180, 180)
	e.Parent = volume
end

local function criarSalaDoChefe(sala)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local meiaL, meiaC = sala.largura / 2, sala.comprimento / 2
	-- Círculo ritual no centro: escuro e discreto (vermelho forte parecia um aviso de golpe)
	local centro = origem + Vector3.new(0, 0.05, 6)
	local runa = Color3.fromRGB(60, 110, 70)
	parte(modelo, "Ritual", Vector3.new(0.12, 60, 60), CFrame.new(centro) * EM_PE, Enum.Material.Neon, runa, { formato = Enum.PartType.Cylinder, colide = false, transparencia = 0.8, sombra = false })
	parte(modelo, "RitualMiolo", Vector3.new(0.14, 58, 58), CFrame.new(centro + Vector3.new(0, 0.02, 0)) * EM_PE, tema.chao.material, escurecer(tema.chao.cor, 0.2), { formato = Enum.PartType.Cylinder, colide = false, sombra = false })
	parte(modelo, "RitualInterno", Vector3.new(0.12, 20, 20), CFrame.new(centro + Vector3.new(0, 0.04, 0)) * EM_PE, Enum.Material.Neon, runa, { formato = Enum.PartType.Cylinder, colide = false, transparencia = 0.8, sombra = false })
	parte(modelo, "RitualInternoMiolo", Vector3.new(0.14, 18.6, 18.6), CFrame.new(centro + Vector3.new(0, 0.06, 0)) * EM_PE, tema.chao.material, escurecer(tema.chao.cor, 0.25), { formato = Enum.PartType.Cylinder, colide = false, sombra = false })
	-- Trono no fundo
	local trono = origem + Vector3.new(0, 0, meiaC - 8)
	parte(modelo, "Degrau", Vector3.new(16, 1, 8), CFrame.new(trono + Vector3.new(0, 0.5, 0)), tema.detalhe.material, tema.detalhe.cor)
	parte(modelo, "Assento", Vector3.new(6, 3, 4), CFrame.new(trono + Vector3.new(0, 2.5, 0.5)), tema.detalhe.material, escurecer(tema.detalhe.cor, 0.1))
	parte(modelo, "Encosto", Vector3.new(6, 9, 1.4), CFrame.new(trono + Vector3.new(0, 6, 2.6)), tema.detalhe.material, escurecer(tema.detalhe.cor, 0.1))
	local gema = parte(modelo, "Gema", Vector3.one * 1.4, CFrame.new(trono + Vector3.new(0, 9.4, 1.8)) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Enum.Material.Neon, Color3.fromRGB(255, 50, 60), { colide = false })
	luz(gema, gema.Color, 16, 2, false)
	obstaculo(sala, trono, 4)
	-- Braseiros grandes nos cantos
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			criarBraseiro(sala, origem + Vector3.new(x * (meiaL - 8), 0, z * (meiaC - 10)), 1.6)
		end
	end
end

local function criarBau(sala)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local madeira = Color3.fromRGB(120, 75, 40)
	local dourado = Color3.fromRGB(255, 200, 60)
	local centro = origem + Vector3.new(0, 0, 4)
	parte(modelo, "Estrado", Vector3.new(12, 1, 10), CFrame.new(centro + Vector3.new(0, 0.5, 0)), tema.detalhe.material, tema.detalhe.cor)
	local base = parte(modelo, "Bau", Vector3.new(5, 3, 3.5), CFrame.new(centro + Vector3.new(0, 2.5, 0)), Enum.Material.WoodPlanks, madeira)
	local tampa = parte(modelo, "Tampa", Vector3.new(5.2, 1.2, 3.7), CFrame.new(centro + Vector3.new(0, 4.6, 0)), Enum.Material.WoodPlanks, escurecer(madeira, 0.25))
	parte(modelo, "Faixa", Vector3.new(5.3, 0.4, 3.8), CFrame.new(centro + Vector3.new(0, 3.6, 0)), Enum.Material.Neon, dourado, { colide = false })
	for _, x in { -1.8, 1.8 } do
		parte(modelo, "Reforco", Vector3.new(0.35, 3.2, 3.8), CFrame.new(centro + Vector3.new(x, 2.6, 0)), Enum.Material.Metal, dourado)
	end
	-- Moedas espalhadas
	for _ = 1, 14 do
		local p = centro + Vector3.new(math.random(-5, 5), 1.15, math.random(-4, 4))
		parte(modelo, "Moeda", Vector3.new(0.15, 0.8, 0.8), CFrame.new(p) * EM_PE * CFrame.Angles(math.random() * 0.5, 0, 0), Enum.Material.Neon, dourado, { formato = Enum.PartType.Cylinder, colide = false, sombra = false })
	end
	-- Feixe de luz vindo de cima
	parte(modelo, "Feixe", Vector3.new(40, 7, 7), CFrame.new(centro + Vector3.new(0, 20, 0)) * EM_PE, Enum.Material.Neon, dourado, { formato = Enum.PartType.Cylinder, colide = false, transparencia = 0.88, sombra = false })
	luz(base, dourado, 24, 2.5, false)
	local brilho = Instance.new("ParticleEmitter")
	brilho.Color = ColorSequence.new(dourado)
	brilho.LightEmission = 1
	brilho.Size = sequencia({ { 0, 0 }, { 0.5, 0.4 }, { 1, 0 } })
	brilho.Lifetime = NumberRange.new(1, 2)
	brilho.Speed = NumberRange.new(1, 3)
	brilho.SpreadAngle = Vector2.new(60, 60)
	brilho.Rate = 12
	brilho.EmissionDirection = Enum.NormalId.Top
	brilho.Parent = base

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Abrir"
	prompt.ObjectText = "Baú do Tesouro"
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = base

	sala.bau = base
	sala.tampaBau = tampa
	sala.promptBau = prompt
	obstaculo(sala, centro, 3)
end

------------------------------------------------------------------------
-- API
------------------------------------------------------------------------

-- Cria uma sala nova. "origem" é o centro do chão (a superfície fica em origem.Y).
function Masmorra.construir(origem: Vector3, numero: number, tipo: string, rng: Random)
	local largura, comprimento
	-- salas amplas: espaço para esquivar, cercar e lutar em grupo
	if tipo == "chefe" then
		largura, comprimento = 150, 150
	elseif tipo == "tesouro" then
		largura, comprimento = 64, 70
	else
		largura = rng:NextInteger(21, 28) * 5
		comprimento = rng:NextInteger(21, 28) * 5
	end

	local modelo = Instance.new("Model")
	modelo.Name = "Sala" .. numero

	local sala = {
		modelo = modelo,
		origem = origem,
		numero = numero,
		tipo = tipo,
		tema = Config.temaDaSala(numero),
		largura = largura,
		comprimento = comprimento,
		pilares = {},
		perigos = {},
		spawn = CFrame.lookAt(origem + Vector3.new(0, 3, -comprimento / 2 + 7), origem + Vector3.new(0, 3, comprimento / 2)),
	}

	criarChao(sala, rng)
	criarParedes(sala)
	criarPorta(sala)
	criarEntrada(sala)
	criarPilares(sala, rng)
	criarLava(sala, rng)
	criarDecoracao(sala, rng)
	criarAtmosfera(sala)
	if tipo == "chefe" then
		criarSalaDoChefe(sala)
	elseif tipo == "tesouro" then
		criarBau(sala)
	else
		-- braseiros nos cantos da entrada e no meio das laterais (iluminam a sala grande)
		local meiaL, meiaC = largura / 2, comprimento / 2
		criarBraseiro(sala, origem + Vector3.new(-meiaL + 5, 0, -meiaC + 5), 1)
		criarBraseiro(sala, origem + Vector3.new(meiaL - 5, 0, -meiaC + 5), 1)
		criarBraseiro(sala, origem + Vector3.new(-meiaL + 5, 0, 0), 1.2)
		criarBraseiro(sala, origem + Vector3.new(meiaL - 5, 0, 0), 1.2)
		criarBraseiro(sala, origem + Vector3.new(-meiaL + 5, 0, meiaC - 5), 1)
		criarBraseiro(sala, origem + Vector3.new(meiaL - 5, 0, meiaC - 5), 1)
	end
	return sala
end

-- Ponto no chão para um inimigo aparecer, longe da entrada dos jogadores
function Masmorra.posicaoInimigo(sala, rng: Random): Vector3
	local entrada = sala.spawn.Position
	for _ = 1, 30 do
		local pos = posicaoLivre(sala, rng, 3, false)
		if pos and planar(pos - entrada).Magnitude > 34 then
			return pos
		end
	end
	return sala.origem + Vector3.new(0, 0, sala.comprimento / 4)
end

function Masmorra.naLava(sala, pos: Vector3): boolean
	if pos.Y > sala.origem.Y + 6 then
		return false
	end
	for _, perigo in sala.perigos do
		local d = pos - perigo.centro
		if math.abs(d.X) < perigo.meio.X and math.abs(d.Z) < perigo.meio.Z then
			return true
		end
	end
	return false
end

-- Sobe a grade e acende a saída. Retorna a peça que leva para a próxima sala.
function Masmorra.abrirPorta(sala): BasePart
	if sala.grade then
		for _, barra in sala.grade:GetChildren() do
			if barra:IsA("BasePart") then
				barra.CanCollide = false
				TweenService:Create(barra, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
					CFrame = barra.CFrame + Vector3.new(0, ALTURA_PORTA - 1, 0),
				}):Play()
			end
		end
	end
	if sala.runaPorta then
		sala.runaPorta.Color = Color3.fromRGB(90, 255, 150)
		luz(sala.runaPorta, Color3.fromRGB(90, 255, 150), 20, 2, false)
	end
	if sala.luzPorta then
		sala.luzPorta.Color = Color3.fromRGB(90, 255, 150)
		sala.luzPorta.Brightness = 3
	end
	local porta = sala.porta
	porta.Transparency = 0.8

	local placa = Instance.new("BillboardGui")
	placa.Size = UDim2.fromScale(12, 2.5)
	placa.StudsOffset = Vector3.new(0, 9, -2)
	placa.AlwaysOnTop = true
	placa.MaxDistance = 150
	placa.LightInfluence = 0
	placa.Parent = porta

	local texto = Instance.new("TextLabel")
	texto.Size = UDim2.fromScale(1, 1)
	texto.BackgroundTransparency = 1
	texto.Text = "PRÓXIMA SALA ➜"
	texto.TextScaled = true
	texto.Font = Enum.Font.Merriweather
	texto.TextColor3 = Color3.fromRGB(140, 255, 175)
	texto.TextStrokeTransparency = 0.2
	texto.Parent = placa
	return porta
end

function Masmorra.abrirBau(sala)
	local tampa = sala.tampaBau
	if tampa then
		TweenService:Create(tampa, TweenInfo.new(0.5, Enum.EasingStyle.Back), {
			CFrame = tampa.CFrame * CFrame.new(0, 1.2, 1.8) * CFrame.Angles(math.rad(-70), 0, 0),
		}):Play()
	end
end

return Masmorra
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000026">
        <Properties>
          <string name="Name">Partida</string>
          <ProtectedString name="Source"><![CDATA[-- Controla cada partida: salas, ondas de inimigos, cartas, elevador e fim de jogo.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cartas = require(Shared:WaitForChild("Cartas"))

local servidor = script.Parent
local Remotos = require(servidor.Remotos)
local Dados = require(servidor.Dados)
local Vfx = require(servidor.Vfx)
local Masmorra = require(servidor.Masmorra)
local Combate = require(servidor.Combate)
local Projeteis = require(servidor.Projeteis)
local Inimigos = require(servidor.Inimigos)

local Partida = {}

local partidasAtivas = {} -- [run] = true
local partidaDoJogador = {} -- [Player] = run
local contadorPartidas = 0

local COR_OURO = Color3.fromRGB(255, 205, 60)
local COR_VERDE = Color3.fromRGB(120, 255, 150)
local COR_VERMELHO = Color3.fromRGB(255, 80, 80)

------------------------------------------------------------------------
-- Objeto da partida
------------------------------------------------------------------------
local Run = {}
Run.__index = Run

function Run:enviar(player: Player, tipo: string, dados)
	Remotos.enviar(player, tipo, dados)
end

function Run:enviarTodos(tipo: string, dados)
	for player in self.jogadores do
		Remotos.enviar(player, tipo, dados)
	end
end

function Run:anunciar(texto: string, cor: Color3?)
	self:enviarTodos("banner", { texto = texto, cor = cor })
end

-- Jogadores de pé (vivos e não caídos)
function Run:jogadoresAtivos(): number
	local total = 0
	for _, estado in self.jogadores do
		if estado.vivo and not estado.caido then
			total += 1
		end
	end
	return total
end

function Run:quantidadeJogadores(): number
	local total = 0
	for _ in self.jogadores do
		total += 1
	end
	return total
end

function Run:quantidadeInimigos(): number
	local total = 0
	for _ in self.inimigos do
		total += 1
	end
	return total
end

local function darOuro(run, estado, base: number)
	local valor = math.max(1, math.floor(base * estado.stats.multOuro + 0.5))
	estado.ouro += valor
	run:enviar(estado.player, "ouro", { total = estado.ouro, ganho = valor })
end

-- Cria um inimigo. Sem "imediato", ele sai de um portal no chão (o jogador vê de onde vem).
function Run:invocar(tipo: string, posicao: Vector3, elite: string?, imediato: boolean?)
	local sala = self.sala
	if imediato then
		Inimigos.criar(self, tipo, posicao, self.mult, elite)
		return
	end
	self.inimigosPendentes += 1
	Vfx.partida(self, "portal", { pos = posicao, duracao = 0.9, elite = elite ~= nil })
	task.delay(0.9, function()
		self.inimigosPendentes -= 1
		if self.ativa and self.sala == sala then
			Inimigos.criar(self, tipo, posicao, self.mult, elite)
		end
	end)
end

function Run:aoMorrerInimigo(inimigo, estadoMatador)
	if not inimigo.vivo then
		return
	end
	local posicao = inimigo.raiz.Position
	local eraChefe = inimigo.chefe
	Inimigos.morrer(self, inimigo)

	if estadoMatador then
		local ouroBase = inimigo.ouro * (1 + self.numeroSala * 0.08)
		for _, estado in self.jogadores do
			darOuro(self, estado, ouroBase)
		end
		Vfx.partida(self, "moedas", { pos = posicao, quantidade = math.clamp(math.floor(ouroBase / 2), 2, 14) })
		estadoMatador.abates += 1
		Combate.adicionarCarga(estadoMatador, Config.CARGA_POR_ABATE)

		local stats = estadoMatador.stats
		if stats.arquimago then
			Combate.reduzirRecarga(estadoMatador, 1)
		end
		if stats.manaAbate > 0 then
			Combate.ganharMana(estadoMatador, stats.manaAbate)
		end
		-- Carta Combustão: explosões em cadeia
		if stats.explosaoMorte > 0 then
			task.delay(0.12, function()
				if not self.ativa then
					return
				end
				Vfx.partida(self, "explosao", { pos = posicao, raio = 10, cor = Color3.fromRGB(255, 140, 40), magia = "bolaFogo" })
				Combate.danoEmArea(self, posicao, 10, stats.dano * 0.6 * stats.explosaoMorte, estadoMatador, {
					semEfeitos = true,
					cor = Color3.fromRGB(255, 140, 40),
				})
			end)
		end
	end

	if eraChefe then
		self:enviarTodos("chefe", { fim = true })
	end
end

------------------------------------------------------------------------
-- Personagens
------------------------------------------------------------------------

local function personagemVivo(player: Player): boolean
	local personagem = player.Character
	local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function configurarPersonagem(run, estado)
	local player = estado.player
	local personagem = player.Character
	local humanoid = personagem and personagem:WaitForChild("Humanoid", 5) :: Humanoid?
	if not humanoid then
		return
	end
	for _, conexao in estado.conexoes do
		conexao:Disconnect()
	end
	estado.conexoes = {}

	Combate.aplicarStats(estado, true)
	Combate.equipar(estado)
	Combate.enviarStats(estado)

	table.insert(estado.conexoes, humanoid.Died:Connect(function()
		if run.jogadores[player] ~= estado or not estado.vivo then
			return
		end
		estado.vivo = false
		estado.caido = false
		run:enviar(player, "morreu", {})
	end))
end

local function reviver(run, estado, cframe: CFrame)
	local player = estado.player
	if not player.Parent then
		return
	end
	player:LoadCharacterAsync()
	if not player.Parent or run.jogadores[player] ~= estado then
		return
	end
	local personagem = player.Character
	if not personagem then
		return
	end
	personagem:PivotTo(cframe)
	estado.vivo = true
	estado.caido = false
	configurarPersonagem(run, estado)
	run:enviar(player, "reviveu", {})
end

------------------------------------------------------------------------
-- Fim da partida para um jogador
------------------------------------------------------------------------

-- motivo: "saiu" (elevador), "morreu" ou "desconectou"
local function finalizarJogador(run, estado, motivo: string)
	local player = estado.player
	if run.jogadores[player] ~= estado then
		return
	end
	run.jogadores[player] = nil
	partidaDoJogador[player] = nil
	for _, conexao in estado.conexoes do
		conexao:Disconnect()
	end

	local ganho = if motivo == "saiu" then estado.ouro else math.floor(estado.ouro * Config.OURO_MANTIDO_AO_MORRER)
	Dados.adicionarOuro(player, ganho)
	local novoRecorde = Dados.registrarRecorde(player, run.numeroSala)

	if motivo == "desconectou" then
		return
	end
	task.spawn(Dados.salvar, player)

	Remotos.enviar(player, "fimPartida", {
		motivo = motivo,
		sala = run.numeroSala,
		ouroPartida = estado.ouro,
		ganho = ganho,
		novoRecorde = novoRecorde,
		abates = estado.abates,
		dano = estado.danoCausado,
		cartas = estado.cartas,
		classe = estado.classe,
	})
	task.spawn(function()
		if player.Parent and not partidaDoJogador[player] then
			player:SetAttribute("PoderFogo", false) -- as cartas ficam na partida
			player:SetAttribute("BarreiraArcana", false)
			player:SetAttribute("AuraProtetor", false)
			player:SetAttribute("InvestidaBrutal", false)
			player:LoadCharacterAsync()
			Remotos.enviar(player, "lobby", {})
			Dados.enviarPerfil(player)
		end
	end)
end

------------------------------------------------------------------------
-- Salas
------------------------------------------------------------------------

local function escolherTipoSala(run, numero: number): string
	if numero % Config.SALAS_POR_ANDAR == 0 then
		return "chefe"
	end
	local depoisDoChefe = numero % Config.SALAS_POR_ANDAR == 1
	if numero > 1 and not depoisDoChefe and run.ultimoTesouro ~= numero - 1 and run.rng:NextNumber() < Config.CHANCE_SALA_TESOURO then
		run.ultimoTesouro = numero
		return "tesouro"
	end
	return "combate"
end

local function multiplicadores(run, numero: number)
	local extras = math.max(0, run:quantidadeJogadores() - 1)
	local ciclo = (numero - 1) // (Config.SALAS_POR_ANDAR * #Config.TEMAS)
	local vidaSala = (1 + (numero - 1) * Config.VIDA_INIMIGO_POR_SALA) * (1 + ciclo * 0.5)
	local danoSala = (1 + (numero - 1) * Config.DANO_INIMIGO_POR_SALA) * (1 + ciclo * 0.25)
	return {
		vida = vidaSala * (1 + extras * Config.VIDA_INIMIGO_POR_JOGADOR_EXTRA),
		dano = danoSala * (1 + extras * Config.DANO_INIMIGO_POR_JOGADOR_EXTRA),
		-- chefes: vida, dano, recarga dos golpes e postura próprios do grupo
		vidaChefe = vidaSala * (1 + extras * Config.VIDA_CHEFE_POR_JOGADOR_EXTRA),
		danoChefe = danoSala * (1 + extras * Config.DANO_CHEFE_POR_JOGADOR_EXTRA),
		recargaChefe = math.max(0.6, 1 - extras * Config.RECARGA_CHEFE_POR_JOGADOR_EXTRA),
		posturaChefe = 1 + extras * Config.POSTURA_CHEFE_POR_JOGADOR_EXTRA,
	}
end

-- Avisa o grupo quando a dificuldade muda porque alguém entrou ou saiu
local function avisarDificuldade(run)
	local jogadores = run:quantidadeJogadores()
	if jogadores == (run.tamanhoAvisado or 1) then
		return
	end
	run.tamanhoAvisado = jogadores
	if jogadores <= 1 then
		return
	end
	local extras = jogadores - 1
	local function pct(valor: number): number
		return math.floor(extras * valor * 100 + 0.5)
	end
	run:anunciar(string.format("👥 Grupo de %d: inimigos +%d%% vida e +%d%% dano · chefes +%d%% vida e +%d%% dano",
		jogadores,
		pct(Config.VIDA_INIMIGO_POR_JOGADOR_EXTRA),
		pct(Config.DANO_INIMIGO_POR_JOGADOR_EXTRA),
		pct(Config.VIDA_CHEFE_POR_JOGADOR_EXTRA),
		pct(Config.DANO_CHEFE_POR_JOGADOR_EXTRA)), Color3.fromRGB(255, 170, 80))
end

local function prepararSala(run, numero: number, tipo: string)
	run:enviarTodos("transicao", {})
	task.wait(0.45)
	if not run.ativa then
		return
	end

	Inimigos.limparTodos(run)
	Projeteis.limpar(run)
	local salaAntiga = run.sala
	run.usarSegundoEspaco = not run.usarSegundoEspaco
	local origem = run.origemBase + (if run.usarSegundoEspaco then Vector3.new(0, 0, 400) else Vector3.zero)

	local sala = Masmorra.construir(origem, numero, tipo, run.rng)
	sala.modelo.Parent = run.pasta
	run.sala = sala
	run.numeroSala = numero
	run.mult = multiplicadores(run, numero)
	avisarDificuldade(run)

	local jogadores = {}
	for _, estado in run.jogadores do
		table.insert(jogadores, estado)
	end
	for indice, estado in jogadores do
		local cframe = sala.spawn * CFrame.new((indice - 1) * 4 - 6, 0, 0)
		if not estado.vivo or estado.caido or not personagemVivo(estado.player) then
			reviver(run, estado, cframe)
		else
			local personagem = estado.player.Character
			if personagem then
				personagem:PivotTo(cframe)
			end
		end
		Combate.novaSala(estado)
	end

	if salaAntiga then
		salaAntiga.modelo:Destroy()
	end

	local tema = sala.tema
	run:enviarTodos("sala", {
		numero = numero,
		tipo = tipo,
		posicaoNoAndar = (numero - 1) % Config.SALAS_POR_ANDAR + 1,
		tema = {
			id = tema.id,
			nome = tema.nome,
			ambiente = tema.ambiente,
			nevoa = tema.nevoa,
			luz = tema.luz,
			tinta = tema.tinta,
		},
	})
end

local function sortearDaTabela(rng: Random, pesos): string
	local total = 0
	for _, peso in pesos do
		total += peso
	end
	local sorteio = rng:NextNumber() * total
	local ultimo = nil
	for tipo, peso in pesos do
		ultimo = tipo
		sorteio -= peso
		if sorteio <= 0 then
			return tipo
		end
	end
	return ultimo
end

-- Só os inimigos que já podem aparecer nesta sala (alguns esperam a 2ª sala). Os de apoio
-- (curam, dão escudo, gritam) aparecem mais vezes: Config.PESO_INIMIGOS_DE_APOIO
local function tabelaDaSala(pesos, numero: number)
	local filtrada = {}
	for tipo, peso in pesos do
		local def = Inimigos.TIPOS[tipo]
		if def and numero >= (def.salaMinima or 1) then
			filtrada[tipo] = if def.comportamento == "suporte" then peso * Config.PESO_INIMIGOS_DE_APOIO else peso
		end
	end
	return filtrada
end

local function sortearElite(run, numero: number): string?
	local extras = math.max(0, run:quantidadeJogadores() - 1)
	local chance = math.min(
		Config.CHANCE_ELITE_BASE + numero * Config.CHANCE_ELITE_POR_SALA + extras * Config.ELITE_POR_JOGADOR_EXTRA,
		Config.CHANCE_ELITE_MAXIMA + extras * Config.ELITE_POR_JOGADOR_EXTRA
	)
	if numero >= 2 and run.rng:NextNumber() < chance then
		return Inimigos.LISTA_ELITES[run.rng:NextInteger(1, #Inimigos.LISTA_ELITES)]
	end
	return nil
end

-- Retorna true se a sala foi limpa, false se o grupo inteiro caiu
local function salaDeCombate(run, tipo: string): boolean
	local sala = run.sala
	local numero = run.numeroSala
	local jogadores = run:quantidadeJogadores()
	run.inimigosPendentes = 0
	local terminouDeInvocar = false

	if tipo == "chefe" then
		local chefe = Inimigos.TIPOS[sala.tema.chefe]
		run:enviarTodos("introChefe", { nome = chefe.nome, titulo = chefe.titulo or "" })
		task.wait(1.2)
		-- sem o portal: o chefe tem a própria entrada (sobe da tumba enquanto o nome aparece)
		run:invocar(sala.tema.chefe, sala.origem, nil, true) -- no centro da sala, de frente para a entrada
		terminouDeInvocar = true
	else
		-- salas maiores: mais inimigos, chegando em ondas
		local total = math.min(7 + math.floor(numero * 1.1) + (jogadores - 1) * Config.INIMIGOS_POR_JOGADOR_EXTRA, 42)
		local maximoVivos = math.min(8 + numero // 3 + (jogadores - 1) * Config.VIVOS_POR_JOGADOR_EXTRA, 18)
		task.spawn(function()
			local criados = 0
			while run.ativa and run.sala == sala and criados < total do
				if run:quantidadeInimigos() + run.inimigosPendentes < maximoVivos then
					local tipoInimigo = sortearDaTabela(run.rng, tabelaDaSala(sala.tema.inimigos, numero))
					local grupo = Inimigos.TIPOS[tipoInimigo].grupo or 1
					local base = Masmorra.posicaoInimigo(sala, run.rng)
					for g = 1, grupo do
						local pos = if g == 1 then base else base + Vector3.new(run.rng:NextNumber(-3, 3), 0, run.rng:NextNumber(-3, 3))
						run:invocar(tipoInimigo, pos, if g == 1 then sortearElite(run, numero) else nil)
					end
					criados += grupo
					task.wait(0.4)
				else
					task.wait(0.3)
				end
			end
			terminouDeInvocar = true
		end)
	end

	while run.ativa do
		if run:jogadoresAtivos() == 0 then
			return false
		end
		if terminouDeInvocar and run.inimigosPendentes == 0 and run:quantidadeInimigos() == 0 then
			return true
		end
		task.wait(0.25)
	end
	return false
end

local function salaDoTesouro(run): boolean
	local sala = run.sala
	local aberto = false

	local function abrir()
		if aberto then
			return
		end
		aberto = true
		sala.promptBau.Enabled = false
		Masmorra.abrirBau(sala)
		local base = 25 + run.numeroSala * 6
		for _, estado in run.jogadores do
			darOuro(run, estado, base)
		end
		Vfx.partida(run, "moedas", { pos = sala.bau.Position + Vector3.new(0, 2, 0), quantidade = 30 })
		run:anunciar("💰 Baú aberto! Ouro para todos!", COR_OURO)
	end

	run:anunciar("🎁 Sala do Tesouro!", COR_OURO)
	run:enviarTodos("aviso", { texto = "Abra o baú: as cartas daqui são raras ou melhores!" })
	local conexao = sala.promptBau.Triggered:Connect(function(player)
		if run.jogadores[player] then
			abrir()
		end
	end)
	local limite = os.clock() + 45
	while run.ativa and not aberto and os.clock() < limite do
		task.wait(0.25)
	end
	conexao:Disconnect()
	abrir()
	task.wait(1)
	return true
end

-- Ao limpar a sala, quem caiu levanta e quem morreu volta
local function reviverTodos(run)
	local sala = run.sala
	for _, estado in run.jogadores do
		if estado.caido then
			Combate.levantar(run, estado, 1)
		elseif not estado.vivo then
			task.spawn(reviver, run, estado, sala.spawn)
		end
	end
	task.wait(0.5)
end

------------------------------------------------------------------------
-- Cartas
------------------------------------------------------------------------

local function indiceRaridade(raridade: string): number
	return table.find(Config.ORDEM_RARIDADES, raridade) or 1
end

local function sortearCartas(estado, quantidade: number, raridadeMinima: string?)
	local sorte = estado.perfil.Melhorias.Sorte or 0
	local minimo = if raridadeMinima then indiceRaridade(raridadeMinima) else 1
	local disponiveis = {}
	for _, carta in Cartas.lista do
		local daClasse = carta.classe == estado.classe
		local permitida = carta.classe == nil or daClasse
		if permitida and (estado.cartas[carta.id] or 0) < carta.maxPilha and indiceRaridade(carta.raridade) >= minimo then
			local raridade = Config.RARIDADES[carta.raridade]
			local peso = math.max(0.5, raridade.peso + Config.SORTE_POR_NIVEL[carta.raridade] * sorte)
			if daClasse then
				peso *= Config.PESO_EXTRA_CARTA_DE_CLASSE
			end
			table.insert(disponiveis, { id = carta.id, peso = peso })
		end
	end

	local escolhidas = {}
	for _ = 1, quantidade do
		if #disponiveis == 0 then
			break
		end
		local total = 0
		for _, item in disponiveis do
			total += item.peso
		end
		local sorteio = math.random() * total
		local escolhido = #disponiveis
		for i, item in disponiveis do
			sorteio -= item.peso
			if sorteio <= 0 then
				escolhido = i
				break
			end
		end
		table.insert(escolhidas, disponiveis[escolhido].id)
		table.remove(disponiveis, escolhido)
	end
	return escolhidas
end

local function aplicarCarta(run, estado, id: string)
	estado.opcoesCartas = nil
	estado.cartas[id] = (estado.cartas[id] or 0) + 1
	Combate.calcularStats(estado)
	Combate.aplicarStats(estado, id == "coracao")
	if Cartas.porId[id].efeitos.escudo then
		estado.escudoAtivo = true
	end
	Combate.enviarStats(estado)
	run:enviar(estado.player, "minhasCartas", { cartas = estado.cartas })
	local carta = Cartas.porId[id]
	local cor = Config.RARIDADES[carta.raridade].cor
	Vfx.partida(run, "carta", { jogador = estado.player, cor = cor, raridade = carta.raridade })
	if carta.raridade == "Lendaria" then
		run:anunciar("🌟 " .. estado.player.DisplayName .. " pegou uma LENDÁRIA: " .. carta.nome .. "!", COR_OURO)
	end
end

local function oferecerCartas(run, raridadeMinima: string?)
	for player, estado in run.jogadores do
		local opcoes = sortearCartas(estado, 3, raridadeMinima)
		if #opcoes > 0 then
			estado.opcoesCartas = opcoes
			run:enviar(player, "cartas", { opcoes = opcoes, tempo = Config.TEMPO_ESCOLHER_CARTA, classe = estado.classe })
		end
	end

	local limite = os.clock() + Config.TEMPO_ESCOLHER_CARTA + 1
	while run.ativa and os.clock() < limite do
		local falta = false
		for _, estado in run.jogadores do
			if estado.opcoesCartas then
				falta = true
			end
		end
		if not falta then
			break
		end
		task.wait(0.2)
	end

	for player, estado in run.jogadores do
		if estado.opcoesCartas then
			aplicarCarta(run, estado, estado.opcoesCartas[math.random(#estado.opcoesCartas)])
			run:enviar(player, "cartasFechar", {})
		end
	end
end

function Partida.escolherCarta(player: Player, indice: any)
	local run = partidaDoJogador[player]
	local estado = run and run.jogadores[player]
	if not estado or not estado.opcoesCartas or type(indice) ~= "number" then
		return
	end
	local id = estado.opcoesCartas[indice]
	if id then
		aplicarCarta(run, estado, id)
	end
end

------------------------------------------------------------------------
-- Elevador (depois de cada chefe)
------------------------------------------------------------------------

local function elevador(run)
	for player, estado in run.jogadores do
		estado.escolhaElevador = "pendente"
		run:enviar(player, "elevador", { ouro = estado.ouro, tempo = Config.TEMPO_ELEVADOR, proximaSala = run.numeroSala + 1 })
	end

	local limite = os.clock() + Config.TEMPO_ELEVADOR + 1
	while run.ativa and os.clock() < limite do
		local falta = false
		for _, estado in run.jogadores do
			if estado.escolhaElevador == "pendente" then
				falta = true
			end
		end
		if not falta then
			break
		end
		task.wait(0.2)
	end

	local saindo, ficando = {}, 0
	for _, estado in run.jogadores do
		if estado.escolhaElevador == "continuar" then
			ficando += 1
		else
			table.insert(saindo, estado) -- quem não respondeu sobe e guarda o ouro
		end
		estado.escolhaElevador = nil
	end
	for _, estado in saindo do
		finalizarJogador(run, estado, "saiu")
		if ficando > 0 then
			run:anunciar("⬆️ " .. estado.player.DisplayName .. " subiu com o ouro!", COR_OURO)
		end
	end
	if ficando > 0 then
		run:anunciar("⬇️ Descendo mais fundo...", COR_VERMELHO)
	end
end

function Partida.escolherElevador(player: Player, escolha: any)
	local run = partidaDoJogador[player]
	local estado = run and run.jogadores[player]
	if estado and estado.escolhaElevador == "pendente" and (escolha == "sair" or escolha == "continuar") then
		estado.escolhaElevador = escolha
	end
end

local function aguardarPorta(run)
	local porta = Masmorra.abrirPorta(run.sala)
	run:enviarTodos("aviso", { texto = "A grade subiu! Entre na porta para seguir ➜" })
	local passou = false
	local conexao = porta.Touched:Connect(function(peca)
		local player = Players:GetPlayerFromCharacter(peca.Parent)
		local estado = player and run.jogadores[player]
		if estado and estado.vivo and not estado.caido then
			passou = true
		end
	end)
	local limite = os.clock() + Config.TEMPO_PORTA_AUTOMATICA
	while run.ativa and not passou and os.clock() < limite do
		task.wait(0.15)
	end
	conexao:Disconnect()
end

------------------------------------------------------------------------
-- Loop principal de uma partida
------------------------------------------------------------------------

local function encerrar(run)
	run.ativa = false
	partidasAtivas[run] = nil
	for _, estado in run.jogadores do
		finalizarJogador(run, estado, "morreu")
	end
	Inimigos.limparTodos(run)
	Projeteis.limpar(run)
	run.pasta:Destroy()
end

local function loopDaPartida(run)
	local aliados = {}
	for player, estado in run.jogadores do
		table.insert(aliados, { userId = player.UserId, nome = player.DisplayName, classe = estado.classe })
	end
	run:enviarTodos("inicioPartida", { aliados = aliados })

	local numero = 1
	while run.ativa do
		local tipo = escolherTipoSala(run, numero)
		prepararSala(run, numero, tipo)
		if not run.ativa then
			break
		end

		local venceu = if tipo == "tesouro" then salaDoTesouro(run) else salaDeCombate(run, tipo)
		if not run.ativa then
			break
		end
		if not venceu then
			run:anunciar("💀 O grupo inteiro caiu...", COR_VERMELHO)
			task.wait(2.5)
			break
		end

		if tipo == "chefe" then
			run:anunciar("🏆 CHEFE DERROTADO!", COR_OURO)
		elseif tipo == "combate" then
			run:anunciar("✨ Sala limpa!", COR_VERDE)
		end
		reviverTodos(run)

		local raridadeMinima = if tipo == "tesouro" then "Rara" elseif tipo == "chefe" then "Epica" else nil
		oferecerCartas(run, raridadeMinima)
		if not run.ativa then
			break
		end

		if tipo == "chefe" then
			elevador(run)
			if run:quantidadeJogadores() == 0 then
				break
			end
		end

		aguardarPorta(run)
		numero += 1
	end
end

------------------------------------------------------------------------
-- API pública
------------------------------------------------------------------------

function Partida.emPartida(player: Player): boolean
	return partidaDoJogador[player] ~= nil
end

function Partida.iniciar(lista: { Player })
	contadorPartidas += 1
	local pasta = Instance.new("Folder")
	pasta.Name = "Partida" .. contadorPartidas
	pasta.Parent = workspace

	local run = setmetatable({
		id = contadorPartidas,
		origemBase = Vector3.new(2000 + (contadorPartidas % 20) * 700, 0, 0),
		jogadores = {},
		inimigos = {},
		projeteis = {},
		inimigosPendentes = 0,
		sala = nil,
		numeroSala = 0,
		mult = { vida = 1, dano = 1 },
		ativa = true,
		rng = Random.new(),
		pasta = pasta,
		usarSegundoEspaco = false,
		ultimoTesouro = nil,
		acumulador = 0,
	}, Run)

	for _, player in lista do
		local perfil = Dados.obter(player)
		if player.Parent and perfil and not partidaDoJogador[player] then
			local estado = {
				player = player,
				perfil = perfil,
				classe = perfil.Classe,
				cartas = {},
				vivo = false, -- todos "renascem" na primeira sala
				caido = false,
				ouro = 0,
				abates = 0,
				danoCausado = 0,
				combo = 0,
				ultimoAtaque = 0,
				ultimoFoiFinal = false,
				habilidadeProntaEm = 0,
				esquivaProntaEm = 0,
				carga = 0,
				cargaEnviada = 0,
				progressoReviver = 0,
				escudoAtivo = false,
				invulneravelAte = 0,
				conexoes = {},
			}
			Combate.calcularStats(estado)
			run.jogadores[player] = estado
			partidaDoJogador[player] = run
		end
	end

	if run:quantidadeJogadores() == 0 then
		pasta:Destroy()
		return
	end
	partidasAtivas[run] = true
	task.spawn(function()
		-- Se algo der erro no meio da partida, os jogadores voltam ao lobby em vez de ficarem presos
		local ok, erro = pcall(loopDaPartida, run)
		if not ok then
			warn("[Partida] Erro na partida " .. run.id .. ": " .. tostring(erro))
		end
		encerrar(run)
	end)
end

function Partida.removerJogador(player: Player)
	local run = partidaDoJogador[player]
	local estado = run and run.jogadores[player]
	if estado then
		finalizarJogador(run, estado, "desconectou")
		if run:quantidadeJogadores() == 0 then
			run.ativa = false
		end
	end
end

-- No lobby os ataques são só para exibir a classe: os outros jogadores veem a animação
local cargaNoLobby = {} -- [Player] = momento em que começou a carregar

local function animacaoNoLobby(player: Player, tipo: string, extra: any, ativo: any)
	local dados = { jogador = player, classe = player:GetAttribute("Classe") or "cavaleiro" }
	if tipo == "atacar" then
		dados.acao = "ataque"
		dados.combo = if type(extra) == "number" then math.clamp(math.floor(extra), 1, 3) else 1
	elseif tipo == "carregar" then
		cargaNoLobby[player] = os.clock()
		dados.acao = "carregar"
	elseif tipo == "soltar" then
		local inicio = cargaNoLobby[player]
		cargaNoLobby[player] = nil
		if not inicio then
			return
		end
		dados.acao = "soltar"
		dados.fracao = math.clamp((os.clock() - inicio - Config.CARGA_ATAQUE_MIN) / (Config.CARGA_ATAQUE_MAX - Config.CARGA_ATAQUE_MIN), 0, 1)
	elseif tipo == "cancelar" then
		cargaNoLobby[player] = nil
		dados.acao = "cancelar"
	elseif tipo == "esquiva" then
		dados.acao = "esquiva"
	elseif tipo == "correr" then
		-- no acampamento também dá para correr
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 16 * (if ativo == true then Config.VELOCIDADE_CORRIDA else 1)
		end
		player:SetAttribute("Correndo", ativo == true)
		return
	elseif tipo == "defender" then
		if dados.classe ~= "cavaleiro" then
			return
		end
		dados.acao = if ativo == true then "defender" else "pararDefesa"
	else
		return
	end
	Vfx.todos("anim", dados)
end

-- Ações de combate vindas do jogador
function Partida.acaoDeCombate(player: Player, tipo: string, direcao: any, extra: any)
	local run = partidaDoJogador[player]
	local estado = run and run.jogadores[player]
	if not estado then
		animacaoNoLobby(player, tipo, extra, direcao)
		return
	end
	if tipo == "atacar" then
		Combate.atacar(run, estado, direcao)
	elseif tipo == "carregar" then
		Combate.carregar(run, estado)
	elseif tipo == "soltar" then
		Combate.soltar(run, estado, direcao)
	elseif tipo == "cancelar" then
		Combate.cancelarCarga(run, estado)
	elseif tipo == "defender" then
		Combate.defender(run, estado, direcao == true)
	elseif tipo == "habilidade" then
		Combate.habilidade(run, estado, direcao)
	elseif tipo == "esquiva" then
		Combate.esquiva(run, estado, direcao)
	elseif tipo == "supremo" then
		Combate.supremo(run, estado)
	elseif tipo == "correr" then
		Combate.correr(estado, direcao == true)
	end
end

Players.PlayerRemoving:Connect(function(player)
	cargaNoLobby[player] = nil
end)

-- Inteligência dos inimigos e projéteis a cada frame; o resto a cada 0,25s
RunService.Heartbeat:Connect(function(dt)
	local agora = os.clock()
	for run in partidasAtivas do
		if run.ativa then
			Inimigos.atualizar(run, agora)
			Projeteis.atualizar(run, dt)
			run.acumulador += dt
			if run.acumulador >= 0.25 then
				Combate.tick(run, run.acumulador)
				run.acumulador = 0
			end
		end
	end
end)

return Partida
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000027">
        <Properties>
          <string name="Name">Projeteis</string>
          <ProtectedString name="Source"><![CDATA[-- Projéteis (flechas, orbes, bolas de fogo...). O servidor calcula o trajeto e os acertos;
-- os jogadores só desenham. Funciona para projéteis de jogadores e de inimigos.

local Vfx = require(script.Parent.Vfx)

local Projeteis = {}

local proximoId = 0

local function planar(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Distância (no plano) de um ponto até o segmento a-b, e a posição relativa no segmento (0 a 1)
local function distanciaAoSegmento(ponto: Vector3, a: Vector3, b: Vector3): (number, number)
	local p, ia, ib = planar(ponto), planar(a), planar(b)
	local ab = ib - ia
	local comprimento2 = ab:Dot(ab)
	local t = 0
	if comprimento2 > 0 then
		t = math.clamp((p - ia):Dot(ab) / comprimento2, 0, 1)
	end
	return (ia + ab * t - p).Magnitude, t
end
Projeteis.distanciaAoSegmento = distanciaAoSegmento

--[[ Cada item da lista aceita:
	lado = "jogador" ou "inimigo"   tipo = nome do visual (orbe, flecha, fogo...)
	pos, dir, velocidade, alcance, raio, tamanho
	perfuracao, ricochete           (quantos inimigos atravessa / quica)
	explosao                        (raio da explosão ao terminar, opcional)
	aoAcertar(alvo, pos, projetil)  alvo = inimigo (lado jogador) ou estado do jogador (lado inimigo)
	aoExplodir(pos, alvoPrincipal)
	aoMover(projetil, dt)           (chamado a cada passo, opcional)
	fogo                            (opcional: o visual vira de fogo)  ]]
function Projeteis.disparar(run, lista)
	local visuais = {}
	for _, dados in lista do
		local direcao = planar(dados.dir)
		direcao = if direcao.Magnitude > 0.01 then direcao.Unit else Vector3.new(0, 0, -1)
		proximoId += 1
		local projetil = {
			id = proximoId,
			lado = dados.lado,
			pos = dados.pos,
			dir = direcao,
			velocidade = dados.velocidade,
			alcance = dados.alcance,
			percorrido = 0,
			raio = dados.raio or 1,
			perfuracao = dados.perfuracao or 0,
			ricochete = dados.ricochete or 0,
			explosao = dados.explosao,
			aoAcertar = dados.aoAcertar,
			aoExplodir = dados.aoExplodir,
			aoMover = dados.aoMover,
			atingidos = {},
		}
		run.projeteis[projetil] = true
		table.insert(visuais, {
			id = projetil.id,
			tipo = dados.tipo,
			pos = dados.pos,
			dir = direcao,
			vel = dados.velocidade,
			alcance = dados.alcance,
			tamanho = dados.tamanho or 1,
			fogo = dados.fogo, -- flechas de fogo (só muda o visual)
		})
	end
	if #visuais > 0 then
		Vfx.partida(run, "projeteis", { lista = visuais })
	end
end

local function terminar(run, projetil, impacto: boolean, alvoPrincipal)
	run.projeteis[projetil] = nil
	if projetil.explosao and projetil.aoExplodir then
		projetil.aoExplodir(projetil.pos, alvoPrincipal)
	end
	Vfx.partida(run, "projetilFim", { id = projetil.id, pos = projetil.pos, impacto = impacto })
end

local function alvosDoInimigo(run)
	local lista = {}
	local agora = os.clock()
	for _, estado in run.jogadores do
		-- quem está esquivando atravessa os projéteis
		if estado.vivo and not estado.caido and agora >= (estado.invulneravelAte or 0) then
			local personagem = estado.player.Character
			local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
			if raiz then
				table.insert(lista, { alvo = estado, pos = raiz.Position, raio = 1.6 })
			end
		end
	end
	return lista
end

local function alvosDoJogador(run)
	local lista = {}
	for inimigo in run.inimigos do
		if inimigo.vivo then
			table.insert(lista, { alvo = inimigo, pos = inimigo.raiz.Position, raio = inimigo.raio })
		end
	end
	return lista
end

local function procurarRicochete(run, projetil)
	local melhor, melhorDistancia = nil, 24
	for inimigo in run.inimigos do
		if inimigo.vivo and not projetil.atingidos[inimigo] then
			local distancia = planar(inimigo.raiz.Position - projetil.pos).Magnitude
			if distancia < melhorDistancia then
				melhor, melhorDistancia = inimigo, distancia
			end
		end
	end
	return melhor
end

local function bateuNaSala(run, pos: Vector3): boolean
	local sala = run.sala
	if not sala then
		return false
	end
	local local_ = pos - sala.origem
	if math.abs(local_.X) > sala.largura / 2 or math.abs(local_.Z) > sala.comprimento / 2 then
		return true
	end
	for _, pilar in sala.pilares do
		if planar(pos - pilar.pos).Magnitude < pilar.raio then
			return true
		end
	end
	return false
end

function Projeteis.atualizar(run, dt: number)
	local lista = {}
	for projetil in run.projeteis do
		table.insert(lista, projetil)
	end

	for _, projetil in lista do
		local passo = projetil.velocidade * dt
		local inicio = projetil.pos
		local fim = inicio + projetil.dir * passo
		projetil.pos = fim
		projetil.percorrido += passo
		if projetil.aoMover then
			projetil.aoMover(projetil, dt)
		end

		-- Quem está no caminho deste passo, em ordem
		local candidatos = {}
		local alvos = if projetil.lado == "jogador" then alvosDoJogador(run) else alvosDoInimigo(run)
		for _, info in alvos do
			if not projetil.atingidos[info.alvo] then
				local distancia, t = distanciaAoSegmento(info.pos, inicio, fim)
				if distancia <= projetil.raio + info.raio then
					table.insert(candidatos, { info = info, t = t })
				end
			end
		end
		table.sort(candidatos, function(a, b)
			return a.t < b.t
		end)

		local acabou = false
		for _, candidato in candidatos do
			local alvo = candidato.info.alvo
			projetil.atingidos[alvo] = true
			projetil.pos = inicio:Lerp(fim, candidato.t)
			if projetil.aoAcertar then
				projetil.aoAcertar(alvo, projetil.pos, projetil)
			end
			if projetil.perfuracao > 0 then
				projetil.perfuracao -= 1
			elseif projetil.ricochete > 0 and projetil.lado == "jogador" then
				projetil.ricochete -= 1
				local proximo = procurarRicochete(run, projetil)
				if proximo then
					projetil.dir = planar(proximo.raiz.Position - projetil.pos).Unit
					projetil.percorrido = math.max(0, projetil.alcance - 30)
					Vfx.partida(run, "projetilDir", { id = projetil.id, pos = projetil.pos, dir = projetil.dir })
				else
					terminar(run, projetil, true, alvo)
					acabou = true
				end
				break
			else
				terminar(run, projetil, true, alvo)
				acabou = true
				break
			end
		end

		if not acabou then
			if bateuNaSala(run, projetil.pos) then
				terminar(run, projetil, true, nil)
			elseif projetil.percorrido >= projetil.alcance then
				terminar(run, projetil, false, nil)
			end
		end
	end
end

function Projeteis.limpar(run)
	table.clear(run.projeteis)
end

return Projeteis
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000028">
        <Properties>
          <string name="Name">Remotos</string>
          <ProtectedString name="Source"><![CDATA[-- Canais de comunicação entre servidor e jogadores.
-- Evento: servidor -> jogador (tipo, dados). Acao: jogador -> servidor (tipo, dados).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotos = {}

local pasta = Instance.new("Folder")
pasta.Name = "Remotos"

local evento = Instance.new("RemoteEvent")
evento.Name = "Evento"
evento.Parent = pasta

local acao = Instance.new("RemoteEvent")
acao.Name = "Acao"
acao.Parent = pasta

pasta.Parent = ReplicatedStorage

Remotos.Evento = evento
Remotos.Acao = acao

function Remotos.enviar(player: Player, tipo: string, dados: any?)
	if player.Parent then
		evento:FireClient(player, tipo, dados or {})
	end
end

function Remotos.enviarParaTodos(tipo: string, dados: any?)
	evento:FireAllClients(tipo, dados or {})
end

return Remotos
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000029">
        <Properties>
          <string name="Name">Vfx</string>
          <ProtectedString name="Source"><![CDATA[-- Efeitos visuais: o servidor só avisa o que aconteceu e cada jogador desenha o efeito
-- no próprio computador (fica suave e não pesa na rede). Os desenhos ficam em Client/Vfx.

local Remotos = require(script.Parent.Remotos)

local Vfx = {}

-- Envia um efeito para todos os jogadores de uma partida (menos "exceto", se informado)
function Vfx.partida(run, tipo: string, dados, exceto: Player?)
	dados.t = tipo
	for player in run.jogadores do
		if player ~= exceto then
			Remotos.enviar(player, "vfx", dados)
		end
	end
end

-- Envia um efeito para todo mundo no servidor (usado no lobby)
function Vfx.todos(tipo: string, dados)
	dados.t = tipo
	Remotos.enviarParaTodos("vfx", dados)
end

return Vfx
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00000030">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="GameSettingsAvatar">1</token>
      <bool name="EnableMouseLockOption">false</bool>
      <token name="AvatarJointUpgrade">1</token>
      <token name="AvatarJointUpgrade_SerializedRollout">1</token>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00000031">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX00000032">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000033">
          <Properties>
            <string name="Name">Ambiente</string>
            <ProtectedString name="Source"><![CDATA[-- Iluminação e pós-processamento: acampamento com visual mágico e vivo (luz de dia suave, cores
-- saturadas, névoa clara); masmorra escura, com tochas fortes, névoa do tema e brilho forte. Também faz as chamas tremularem e os objetos girarem.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Ambiente = {}

local function obter(classe: string, nome: string): any
	local existente = Lighting:FindFirstChild(nome)
	if existente then
		return existente
	end
	local novo = Instance.new(classe)
	novo.Name = nome
	novo.Parent = Lighting
	return novo
end

local atmosfera = obter("Atmosphere", "AtmosferaJogo")
local bloom = obter("BloomEffect", "BrilhoJogo")
local cores = obter("ColorCorrectionEffect", "CoresJogo")
local raiosDeSol = obter("SunRaysEffect", "RaiosJogo")
-- profundidade de campo: o personagem e a sala ficam nítidos e o fundo distante desfoca de leve
local foco = obter("DepthOfFieldEffect", "FocoJogo")

local function animar(objeto: Instance, duracao: number, propriedades)
	TweenService:Create(objeto, TweenInfo.new(duracao, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), propriedades):Play()
end

-- Visual "mágico" (estilo desenho animado vivo): luz de dia suave e sem sombras escuras, cores
-- bem saturadas, névoa clara ao fundo e brilho macio nas partes claras.
local SATURACAO = 0.15 -- (o cenário do lobby já é colorido)
local CONTRASTE = 0.1
local SATURACAO_MASMORRA = 0.3
local CONTRASTE_MASMORRA = 0.26
local masmorraAtiva = false

-- Música do acampamento (Config.MUSICA_LOBBY): entra devagar no lobby e some na masmorra
local musica = Instance.new("Sound")
musica.Name = "MusicaLobby"
musica.SoundId = Config.MUSICA_LOBBY or ""
musica.Looped = true
musica.Volume = 0
musica.Parent = SoundService
local vezMusica = 0

local function musicaDoLobby(ligar: boolean)
	if musica.SoundId == "" then
		return
	end
	vezMusica += 1
	local minhaVez = vezMusica
	if ligar then
		if not musica.IsPlaying then
			musica:Resume()
		end
		animar(musica, 2.5, { Volume = Config.VOLUME_MUSICA_LOBBY or 0.4 })
	else
		animar(musica, 1.2, { Volume = 0 })
		task.delay(1.3, function()
			if vezMusica == minhaVez then
				musica:Pause()
			end
		end)
	end
end

function Ambiente.lobby()
	-- acampamento de fantasia (estilo desenho): sol de fim de tarde, mais baixo e quente, que faz
	-- as árvores e as construções jogarem sombras compridas e bem marcadas no chão. A luz do céu
	-- (ambiente) é baixa para não apagar as sombras, e o brilho (bloom) é fraco: só o que é muito
	-- claro brilha um pouco.
	masmorraAtiva = false
	Lighting.ClockTime = 16.3
	Lighting.Brightness = 3.4
	Lighting.Ambient = Color3.fromRGB(96, 96, 118)
	Lighting.OutdoorAmbient = Color3.fromRGB(124, 128, 150)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 222, 176)
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.ExposureCompensation = 0.1
	Lighting.ShadowSoftness = 0.12
	atmosfera.Density = 0.24
	atmosfera.Offset = 0.1
	atmosfera.Color = Color3.fromRGB(214, 226, 255)
	atmosfera.Decay = Color3.fromRGB(150, 180, 255)
	atmosfera.Glare = 0
	atmosfera.Haze = 0.2
	bloom.Intensity = 0.15
	bloom.Size = 16
	bloom.Threshold = 2.2
	cores.Brightness = 0
	cores.Contrast = CONTRASTE
	cores.Saturation = SATURACAO
	cores.TintColor = Color3.fromRGB(255, 248, 236)
	raiosDeSol.Intensity = 0.07
	raiosDeSol.Spread = 0.5
	foco.FocusDistance = 30
	foco.InFocusRadius = 50
	foco.FarIntensity = 0.08
	foco.NearIntensity = 0
	musicaDoLobby(true)
end

-- Masmorra: escura (noite, salas sem teto), mas com luz de qualidade: tochas fortes com sombras
-- marcadas, névoa colorida do tema, cores vivas e brilho forte em tudo que acende (tochas,
-- magias, efeitos). A luz ambiente é baixa, só o suficiente para enxergar a sala.

function Ambiente.masmorra(tema)
	masmorraAtiva = true
	musicaDoLobby(false)
	Lighting.ClockTime = 0
	Lighting.Brightness = 0.6
	Lighting.ColorShift_Top = Color3.new(0, 0, 0) -- (o tom quente é só do acampamento)
	Lighting.Ambient = tema.ambiente:Lerp(tema.luz, 0.15)
	Lighting.OutdoorAmbient = tema.ambiente:Lerp(Color3.new(0, 0, 0), 0.1)
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.7
	Lighting.ExposureCompensation = 0
	Lighting.ShadowSoftness = 0.25
	atmosfera.Density = 0.4
	atmosfera.Offset = 0
	atmosfera.Color = tema.nevoa:Lerp(Color3.new(1, 1, 1), 0.15)
	atmosfera.Decay = tema.nevoa
	atmosfera.Glare = 0
	atmosfera.Haze = 2.6
	bloom.Intensity = 1.2
	bloom.Size = 32
	bloom.Threshold = 0.8
	cores.Brightness = -0.02
	cores.Contrast = CONTRASTE_MASMORRA
	cores.Saturation = SATURACAO_MASMORRA
	cores.TintColor = tema.tinta
	raiosDeSol.Intensity = 0
	foco.FocusDistance = 30
	foco.InFocusRadius = 38
	foco.FarIntensity = 0.2
	foco.NearIntensity = 0
end

-- Tela sem cor enquanto o jogador está caído
function Ambiente.caido(ligar: boolean)
	local saturacao = if masmorraAtiva then SATURACAO_MASMORRA else SATURACAO
	local contraste = if masmorraAtiva then CONTRASTE_MASMORRA else CONTRASTE
	animar(cores, 0.5, { Saturation = if ligar then -0.85 else saturacao, Contrast = if ligar then 0.3 else contraste })
end

------------------------------------------------------------------------
-- Chamas tremulando e objetos girando (só no computador do jogador)
------------------------------------------------------------------------

local chamas = {} -- [PointLight] = { brilho, semente }
local giratorios = {} -- [Model] = pivô original

local function adicionarChama(luz: Instance)
	if luz:IsA("PointLight") and not chamas[luz] then
		-- tochas mais fortes, alcançando mais longe e com sombra: poças de luz quente no escuro
		luz.Range *= 1.25
		luz.Shadows = true
		chamas[luz] = { brilho = luz.Brightness * 1.35, semente = math.random() * 100 }
	end
end

local function adicionarGiratorio(modelo: Instance)
	if modelo:IsA("Model") then
		giratorios[modelo] = modelo:GetPivot()
	end
end

function Ambiente.iniciar()
	Ambiente.lobby()
	for _, luz in CollectionService:GetTagged("Chama") do
		adicionarChama(luz)
	end
	CollectionService:GetInstanceAddedSignal("Chama"):Connect(adicionarChama)
	CollectionService:GetInstanceRemovedSignal("Chama"):Connect(function(luz)
		chamas[luz] = nil
	end)
	for _, modelo in CollectionService:GetTagged("Girar") do
		adicionarGiratorio(modelo)
	end
	CollectionService:GetInstanceAddedSignal("Girar"):Connect(adicionarGiratorio)
	CollectionService:GetInstanceRemovedSignal("Girar"):Connect(function(modelo)
		giratorios[modelo] = nil
	end)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for luz, info in chamas do
			if luz.Parent then
				luz.Brightness = info.brilho * (0.78 + 0.32 * math.noise(t * 7, info.semente))
			else
				chamas[luz] = nil
			end
		end
		for modelo, pivo in giratorios do
			if modelo.Parent then
				local giro = (modelo:GetAttribute("Giro") or 1) * t
				local flutuar = modelo:GetAttribute("Flutuar") or 0
				local deslocamento = CFrame.new(0, math.sin(t * 1.6) * flutuar, 0)
				if modelo:GetAttribute("EixoGiro") == "X" then
					modelo:PivotTo(pivo * deslocamento * CFrame.Angles(giro, 0, 0))
				else
					-- gira em volta do eixo vertical do mundo, mantendo a inclinação original
					modelo:PivotTo(deslocamento * CFrame.new(pivo.Position) * CFrame.Angles(0, giro, 0) * pivo.Rotation)
				end
			else
				giratorios[modelo] = nil
			end
		end
	end)
end

return Ambiente
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000034">
          <Properties>
            <string name="Name">Animacoes</string>
            <ProtectedString name="Source"><![CDATA[-- Animações dos personagens feitas por código (não precisam de arquivos de animação).
-- As poses e os golpes ficam em Poses.luau; aqui elas são aplicadas nas juntas do personagem,
-- por cima da animação padrão do Roblox (andar, pular). Também cuida dos detalhes das armas
-- (rastro da lâmina, corda e flecha do arco, brilho do cajado, partículas de carga).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))

local Vfx = require(script.Parent.Vfx)
local Poses = require(script.Parent.Poses)
local Sons = require(script.Parent.Sons)

local Animacoes = {}

local jogador = Players.LocalPlayer
local pasta = Instance.new("Folder")
pasta.Name = "AnimacoesLocais"
pasta.Parent = workspace

local PESO_POSTURA = 0.75

-- Pausa no instante do impacto de cada golpe (segundos): golpes pesados param mais
local PAUSA_IMPACTO = { cavaleiro = 0.065, mago = 0.045, arqueiro = 0.04, assassino = 0.03 }

-- Escudo do Cavaleiro: duas posições no antebraço, trocadas aos poucos (preso numa só, ele ficava
-- de cabeça para baixo com o braço solto ou obrigava o braço a ficar encolhido).
--   carregado: ao lado do corpo, em pé, virado para fora (comprido ao longo do braço)
--   defesa:    na parte de fora do antebraço, em pé e de frente com o antebraço erguido
local ESCUDO_CARREGADO = CFrame.new(-0.62, 0, 0)
local ESCUDO_DEFESA = CFrame.new(0, 0, 0.62) * CFrame.fromMatrix(Vector3.zero, Vector3.new(0, 0, -1), Vector3.new(0, -1, 0))
local OURO = Color3.fromRGB(255, 214, 90)

-- Peça do corpo que a junta move -> junta lógica. A junta é achada pela peça (Part1), e não
-- pelo nome: assim funciona com Motor6D (corpo clássico) e com AnimationConstraint (corpos com
-- o "Avatar Joint Upgrade" do Roblox), que têm C0 e Transform do mesmo jeito.
local JUNTAS_R15 = {
	LowerTorso = "raiz",
	UpperTorso = "cintura",
	Head = "pescoco",
	RightUpperArm = "ombroD",
	RightLowerArm = "cotoveloD",
	RightHand = "pulsoD",
	LeftUpperArm = "ombroE",
	LeftLowerArm = "cotoveloE",
	LeftHand = "pulsoE",
	RightUpperLeg = "quadrilD",
	RightLowerLeg = "joelhoD",
	LeftUpperLeg = "quadrilE",
	LeftLowerLeg = "joelhoE",
	RightFoot = "tornozeloD",
	LeftFoot = "tornozeloE",
}
local JUNTAS_R6 = {
	Torso = "raiz",
	Head = "pescoco",
	["Right Arm"] = "ombroD",
	["Left Arm"] = "ombroE",
	["Right Leg"] = "quadrilD",
	["Left Leg"] = "quadrilE",
}

local A = Poses.A
local POSTURAS = Poses.POSTURAS
local PARADO = Poses.PARADO
local ANDAR = Poses.ANDAR
local FLUTUAR = Poses.FLUTUAR
local ACOES = Poses.ACOES
local ESQUIVAS = Poses.ESQUIVAS
local ATINGIDO = Poses.ATINGIDO
local BLOQUEIO = Poses.BLOQUEIO
local BLOQUEIO_PERFEITO = Poses.BLOQUEIO_PERFEITO
local amostrar = Poses.amostrar
local misturar = Poses.misturar
local angulo = Poses.angulo

-- Valores que não são juntas (corda do arco, brilho do cajado, flecha na mão)
local ESPECIAIS = { puxar = true, brilho = true, flechaMao = true }
-- Pernas: enquanto o personagem anda, o golpe mexe menos nelas (os pés não "patinam")
local PERNAS = { quadrilD = true, joelhoD = true, tornozeloD = true, quadrilE = true, joelhoE = true, tornozeloE = true }

------------------------------------------------------------------------
-- Estado de cada personagem
------------------------------------------------------------------------

local personagens = {} -- [Model] = estado

-- Junta que a animação pode mexer: Motor6D (rig clássico) ou AnimationConstraint (rig novo
-- do Roblox, "Avatar Joint Upgrade"). As duas têm a propriedade Transform.
local function ehJunta(objeto: Instance): boolean
	return objeto:IsA("Motor6D") or objeto:IsA("AnimationConstraint")
end

-- Rotação de referência da junta (onde ela fica presa na peça "pai")
local function rotacaoBase(junta: any): CFrame
	if junta:IsA("Motor6D") then
		return junta.C0.Rotation
	end
	local a0 = junta.Attachment0
	return if a0 then a0.CFrame.Rotation else CFrame.identity
end

-- Peça que a junta move (a "filha")
local function pecaFilha(junta: any): Instance?
	if junta:IsA("Motor6D") then
		return junta.Part1
	end
	local a1 = junta.Attachment1
	return a1 and a1.Parent
end

local function acharJunta(personagem: Model, nomePeca: string, nomeJunta: string): Instance?
	local peca = personagem:FindFirstChild(nomePeca)
	local junta = peca and peca:FindFirstChild(nomeJunta)
	if junta and ehJunta(junta) then
		return junta
	end
	-- em outro lugar com o mesmo nome, ou com outro nome mas movendo a mesma peça
	local porPeca = nil
	for _, objeto in personagem:GetDescendants() do
		if ehJunta(objeto) then
			if objeto.Name == nomeJunta then
				return objeto
			end
			local filha = pecaFilha(objeto)
			if not porPeca and filha and filha.Name == nomePeca then
				porPeca = objeto
			end
		end
	end
	return porPeca
end

local avisouSemJuntas = {}

local function obterJuntas(personagem: Model)
	local juntas = {}
	local mapa = if personagem:FindFirstChild("UpperTorso") then JUNTAS_R15 else JUNTAS_R6
	local quantas = 0
	for _, objeto in personagem:GetDescendants() do
		if ehJunta(objeto) then
			local junta = objeto :: any
			local filha = pecaFilha(junta)
			local nome = if filha then mapa[filha.Name] else nil
			if nome and not juntas[nome] then
				local rotacao = rotacaoBase(junta)
				juntas[nome] = { motor = junta, rot = rotacao, inv = rotacao:Inverse() }
				quantas += 1
			end
		end
	end
	if quantas == 0 and personagem:FindFirstChildOfClass("Humanoid") and not avisouSemJuntas[personagem] then
		avisouSemJuntas[personagem] = true
		task.delay(3, function()
			if personagem.Parent and next(obterJuntas(personagem)) == nil then
				warn("[Animacoes] Nenhuma junta encontrada em " .. personagem.Name .. " (sem Motor6D nem AnimationConstraint): as animações não vão aparecer.")
			end
		end)
	end
	return juntas
end

-- Uma linha no Output dizendo o que foi achado no corpo do próprio jogador (ajuda a descobrir
-- por que uma animação não aparece)
local function avisarCorpo(e)
	if e.jogador ~= jogador then
		return
	end
	local quantas, tipo = 0, "nenhum"
	for _, j in e.juntas do
		quantas += 1
		tipo = j.motor.ClassName
	end
	local corpo = if e.personagem:FindFirstChild("UpperTorso") then "R15" else "R6"
	local assinatura = corpo .. quantas .. tipo
	if e.avisado == assinatura then
		return
	end
	e.avisado = assinatura
	if quantas == 0 then
		warn("[Animacoes] Nenhuma junta encontrada no personagem (" .. corpo .. "): as animações não vão aparecer.")
	elseif corpo == "R6" then
		warn("[Animacoes] Personagem R6: só ombros, quadris e pescoço mexem. Use R15 (Game Settings > Avatar > R15).")
	else
		print(string.format("[Animacoes] Personagem %s com %d juntas (%s): animações ligadas.", corpo, quantas, tipo))
	end
end

local function estadoDe(personagem: Model)
	local e = personagens[personagem]
	if not e then
		e = {
			personagem = personagem,
			jogador = Players:GetPlayerFromCharacter(personagem),
			humanoid = personagem:FindFirstChildOfClass("Humanoid"),
			juntas = obterJuntas(personagem),
			acao = nil,
			dash = nil,
			carregando = false,
			cargaInicio = 0,
			puxar = 0,
			brilho = 0,
			flechaMao = 0,
			ultimaPose = {},
		}
		personagens[personagem] = e
		avisarCorpo(e)
	end
	return e
end

local function classeDe(e): string
	local classe = e.jogador and e.jogador:GetAttribute("Classe")
	return if Classes.existe(classe) then classe else "cavaleiro"
end

local function cargaDe(e): number
	if not e.carregando then
		return 0
	end
	return math.clamp((os.clock() - e.cargaInicio - Config.CARGA_ATAQUE_MIN) / (Config.CARGA_ATAQUE_MAX - Config.CARGA_ATAQUE_MIN) + 0.15, 0, 1)
end

local function comecar(e, definicao, dados)
	if not definicao then
		return
	end
	if definicao.quadros then
		Poses.preparar(definicao)
	end
	local agora = os.clock()
	-- parte de onde o corpo está (sem "pulos" entre animações); giros grandes (360°, a espada
	-- girando na mão) voltam para perto de zero, para a próxima animação não "desgirar"
	local base = {}
	for junta, v in e.ultimaPose do
		base[junta] = if ESPECIAIS[junta] then v else { angulo(v[1]), angulo(v[2]), angulo(v[3]), v[4], v[5], v[6], v[7] }
	end
	e.acao = {
		def = definicao,
		inicio = agora,
		base = base,
		dados = dados or {},
		duracao = if definicao.manter then math.huge else (definicao.duracao or (dados and dados.duracao) or 0.5),
		soltando = nil,
	}
end

------------------------------------------------------------------------
-- Detalhes das armas: rastro da espada, corda e flecha do arco, brilho do cajado e
-- partículas de carga. Tudo criado só neste computador.
------------------------------------------------------------------------

local function prepararArma(e)
	local acessorios = e.personagem:FindFirstChild("AcessoriosDeClasse")
	local arma = acessorios and acessorios:FindFirstChild("ArmaDeClasse")
	if arma == e.arma then
		return
	end
	-- arma nova (trocou de classe ou renasceu): limpa os detalhes antigos
	for _, objeto in e.detalhes or {} do
		objeto:Destroy()
	end
	e.detalhes = {}
	e.arma = arma
	e.trilha, e.trilha2, e.encaixe, e.flecha, e.glow, e.esfera, e.emissorCarga = nil, nil, nil, nil, nil, nil, nil
	e.chamasLamina = nil
	if not arma then
		return
	end
	local classe = Classes.obter(classeDe(e))

	local function rastroDaLamina(modelo: Instance?): (Trail?, Attachment?)
		local lamina = modelo and modelo:FindFirstChild("Lamina")
		local base = lamina and lamina:FindFirstChild("TrilhaBase") :: Attachment?
		local ponta = lamina and lamina:FindFirstChild("TrilhaPonta") :: Attachment?
		if not base or not ponta then
			return nil, nil
		end
		if classe.id == "cavaleiro" or (classe.id == "assassino" and Vfx.temPrefab("CorteAdaga")) then
			-- Cavaleiro e Assassino não têm rastro na lâmina: o efeito do golpe é só o corte do pacote de VFX
			return nil, ponta
		end
		local trilha = Instance.new("Trail")
		trilha.Attachment0 = base
		trilha.Attachment1 = ponta
		trilha.Color = ColorSequence.new(Color3.new(1, 1, 1), classe.cor)
		trilha.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		trilha.Lifetime = 0.16
		trilha.LightEmission = 1
		trilha.LightInfluence = 0
		trilha.Enabled = false
		trilha.Parent = lamina
		table.insert(e.detalhes, trilha)
		return trilha, ponta
	end
	-- escudo: a solda do servidor é trocada (só neste computador) por uma que o código move
	e.soldaEscudo = nil
	local escudo = acessorios:FindFirstChild("Escudo")
	local braco = e.personagem:FindFirstChild("LeftLowerArm")
	if escudo and escudo:IsA("BasePart") and braco and braco:IsA("BasePart") then
		for _, solda in escudo:GetChildren() do
			if solda:IsA("WeldConstraint") and (solda.Part0 == braco or solda.Part1 == braco) then
				solda.Enabled = false
			end
		end
		local solda = Instance.new("Weld")
		solda.Name = "SoldaEscudoLocal"
		solda.Part0 = braco
		solda.Part1 = escudo
		solda.C0 = ESCUDO_CARREGADO
		solda.Parent = escudo
		e.soldaEscudo = solda
		e.pesoEscudo = 0
		table.insert(e.detalhes, solda)
	end

	local trilha, ponta = rastroDaLamina(arma)
	e.trilha = trilha
	if ponta then
		e.pontaArma = ponta
	end
	-- Assassino: rastro também na adaga da mão esquerda
	e.trilha2 = rastroDaLamina(acessorios:FindFirstChild("ArmaSecundaria"))

	local arco = arma:FindFirstChild("Arco")
	if arco then
		local cima = arco:FindFirstChild("CordaCima") :: Attachment?
		local baixo = arco:FindFirstChild("CordaBaixo") :: Attachment?
		local encaixe = arco:FindFirstChild("Encaixe") :: Attachment?
		if cima and baixo and encaixe then
			for _, par in { { cima, encaixe }, { encaixe, baixo } } do
				local corda = Instance.new("Beam")
				corda.Attachment0 = par[1]
				corda.Attachment1 = par[2]
				corda.Width0 = 0.07
				corda.Width1 = 0.07
				corda.Color = ColorSequence.new(Color3.fromRGB(255, 240, 210))
				corda.LightEmission = 0.4
				corda.FaceCamera = true
				corda.Segments = 1
				corda.Parent = arco
				table.insert(e.detalhes, corda)
			end
			local flecha = Instance.new("Part")
			flecha.Size = Vector3.new(0.12, 0.12, 2.7)
			flecha.Material = Enum.Material.Wood
			flecha.Color = Color3.fromRGB(160, 120, 80)
			flecha.Anchored = true
			flecha.CanCollide = false
			flecha.CanQuery = false
			flecha.CanTouch = false
			flecha.CastShadow = false
			flecha.Transparency = 1
			flecha.Parent = pasta
			local pontaFlecha = Instance.new("Part")
			pontaFlecha.Size = Vector3.new(0.22, 0.22, 0.4)
			pontaFlecha.Material = Enum.Material.Neon
			pontaFlecha.Color = classe.cor
			pontaFlecha.Anchored = true
			pontaFlecha.CanCollide = false
			pontaFlecha.CanQuery = false
			pontaFlecha.CanTouch = false
			pontaFlecha.Transparency = 1
			pontaFlecha.Parent = flecha
			e.encaixe = encaixe
			e.arco = arco
			e.flecha = flecha
			e.pontaFlecha = pontaFlecha
			e.pontaArma = encaixe
			table.insert(e.detalhes, flecha)
		end
	end

	local haste = arma:FindFirstChild("Haste")
	if haste then
		local ponta = haste:FindFirstChild("Ponta") :: Attachment?
		if ponta then
			local glow = Instance.new("Part")
			glow.Shape = Enum.PartType.Ball
			glow.Size = Vector3.one
			glow.Material = Enum.Material.Neon
			glow.Color = classe.cor
			glow.Anchored = true
			glow.CanCollide = false
			glow.CanQuery = false
			glow.CanTouch = false
			glow.CastShadow = false
			glow.Transparency = 1
			glow.Parent = pasta
			local luz = Instance.new("PointLight")
			luz.Color = classe.cor
			luz.Range = 12
			luz.Brightness = 0
			luz.Parent = glow
			e.glow = glow
			e.luzGlow = luz
			e.pontaArma = ponta
			table.insert(e.detalhes, glow)
		end
	end

	-- Esfera invisível na ponta da arma: as partículas de carga convergem para ela
	local esfera = Instance.new("Part")
	esfera.Shape = Enum.PartType.Ball
	esfera.Size = Vector3.one * 5
	esfera.Transparency = 1
	esfera.Anchored = true
	esfera.CanCollide = false
	esfera.CanQuery = false
	esfera.CanTouch = false
	esfera.Parent = pasta
	local emissor = Instance.new("ParticleEmitter")
	emissor.Shape = Enum.ParticleEmitterShape.Sphere
	emissor.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	emissor.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	emissor.Color = ColorSequence.new(classe.cor:Lerp(Color3.new(1, 1, 1), 0.4), classe.cor)
	emissor.LightEmission = 1
	emissor.LightInfluence = 0
	emissor.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.6, 0.35), NumberSequenceKeypoint.new(1, 0) })
	emissor.Lifetime = NumberRange.new(0.3, 0.4)
	emissor.Speed = NumberRange.new(6, 9)
	emissor.Rate = 0
	emissor.Parent = esfera
	e.esfera = esfera
	e.emissorCarga = emissor
	e.corClasse = classe.cor
	table.insert(e.detalhes, esfera)
end

-- Tempo da animação: nos golpes, a preparação é esticada (o golpe demora mais para sair,
-- com mais peso) e o resto (o corte e a volta) segue no ritmo normal
-- Depois do impacto: uma pausa curta no ponto de contato ("hit-stop", dá peso ao golpe) e a
-- volta para a guarda esticada até o próximo ataque ficar liberado (cadência): o corpo
-- acompanha o golpe e se recompõe em vez de ficar parado esperando.
local function tempoAnimado(a, tau: number): number
	local preparo = a.preparo
	local t = tau
	if preparo then
		local fimPreparo = preparo.base * preparo.fator
		if tau < fimPreparo then
			return tau / preparo.fator
		end
		t = tau - (fimPreparo - preparo.base)
	end
	local volta = a.recuperacao
	if volta and t > volta.inicio then
		local depois = t - volta.inicio
		if depois < volta.pausa then
			return volta.inicio
		end
		return volta.inicio + (depois - volta.pausa) / volta.fator
	end
	return t
end

local function atualizarArma(e, agora: number)
	prepararArma(e)
	if not e.arma then
		return
	end
	-- Mago: anel de energia roxo no chão, debaixo dos pés, enquanto levita
	if FLUTUAR[classeDe(e)] and not e.levitacaoAtiva and e.humanoid then
		local raiz = e.personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = e.humanoid
		if raiz then
			e.levitacaoAtiva = true
			local parar = Vfx.prefab("LevitacaoMago", function()
				if not raiz.Parent or humanoid.Health <= 0 or not FLUTUAR[classeDe(e)] then
					e.levitacaoAtiva = false
					return nil
				end
				return CFrame.new(raiz.Position.X, raiz.Position.Y - (humanoid.HipHeight + raiz.Size.Y / 2) + 0.15, raiz.Position.Z)
			end, 0, 1.1)
			if not parar then
				e.levitacaoAtiva = "sem efeito" -- não existe o efeito: não tenta de novo
			end
		end
	end
	-- Escudo ativo (Barreira Arcana do Mago, Escudo Abençoado do Cavaleiro ou o escudo que o
	-- supremo do Cavaleiro dá aos aliados): bolha em volta do corpo até bloquear um golpe.
	-- Roxa no Mago, dourada nas outras classes.
	local comBarreira = e.jogador ~= nil and e.jogador:GetAttribute("BarreiraArcana") == true
	if comBarreira and not e.pararBarreira then
		local tronco = e.personagem:FindFirstChild("UpperTorso") or e.personagem:FindFirstChild("Torso")
		if tronco and tronco:IsA("BasePart") then
			local bolha = if classeDe(e) == "mago" then "BarreiraArcana" else "EscudoAbencoado"
			e.pararBarreira = Vfx.prefab(bolha, function()
				return if tronco.Parent then CFrame.new(tronco.Position) else nil
			end, 0, 1.7) or false
		end
	elseif not comBarreira and e.pararBarreira then
		e.pararBarreira()
		e.pararBarreira = nil
	end
	-- Maldição das Almas (Skullbane): névoa verde em volta do corpo e o selo acima da cabeça
	local maldito = e.jogador ~= nil and e.jogador:GetAttribute("Amaldicoado") == true
	if maldito and not e.pararMaldicao then
		local tronco = e.personagem:FindFirstChild("UpperTorso") or e.personagem:FindFirstChild("Torso")
		local cabeca = e.personagem:FindFirstChild("Head")
		if tronco and tronco:IsA("BasePart") and cabeca and cabeca:IsA("BasePart") then
			local pararNevoa = Vfx.prefab("MaldicaoNevoa", function()
				return if tronco.Parent then CFrame.new(tronco.Position) else nil
			end, 0, 1.1)
			local pararMarca = Vfx.prefab("MaldicaoMarca", function()
				return if cabeca.Parent then CFrame.new(cabeca.Position + Vector3.new(0, 2.2, 0)) else nil
			end, 0, 0.3)
			e.pararMaldicao = function()
				if pararNevoa then
					pararNevoa()
				end
				if pararMarca then
					pararMarca()
				end
			end
		end
	elseif not maldito and e.pararMaldicao then
		e.pararMaldicao()
		e.pararMaldicao = nil
	end
	-- Aura do Protetor: círculo dourado no chão do tamanho da área protegida (18 studs)
	local comAura = e.jogador ~= nil and e.jogador:GetAttribute("AuraProtetor") == true
	if comAura and not e.pararAura then
		local raizAura = e.personagem:FindFirstChild("HumanoidRootPart")
		if raizAura and raizAura:IsA("BasePart") then
			e.pararAura = Vfx.prefab("AuraProtetor", function()
				return if raizAura.Parent then CFrame.new(raizAura.Position - Vector3.new(0, 2.8, 0)) else nil
			end, 0, 3.6) or false
		end
	elseif not comAura and e.pararAura then
		e.pararAura()
		e.pararAura = nil
	end
	-- carta de fogo: a lâmina pega fogo (chamas do pacote de VFX)
	local comFogo = e.jogador ~= nil and e.jogador:GetAttribute("PoderFogo") == true
	if comFogo ~= (e.chamasLamina ~= nil) then
		if e.chamasLamina then
			for _, chama in e.chamasLamina do
				chama.Enabled = false
				game:GetService("Debris"):AddItem(chama, 1)
			end
			e.chamasLamina = nil
		else
			local efeitos = ReplicatedStorage:FindFirstChild("EfeitosVFX")
			local molde = if efeitos then efeitos:FindFirstChild("LaminaFogo") else nil
			-- espada: a lâmina pega fogo; arco: a ponta da flecha encaixada vira brasa
			local lamina = e.arma:FindFirstChild("Lamina") or e.pontaFlecha
			local fator = if lamina == e.pontaFlecha then 0.2 else 0.45
			if molde and lamina then
				e.chamasLamina = {}
				for _, original in molde:GetDescendants() do
					if original:IsA("ParticleEmitter") then
						local chama = original:Clone()
						-- menor, para caber na lâmina
						local chaves = {}
						for _, k in chama.Size.Keypoints do
							table.insert(chaves, NumberSequenceKeypoint.new(k.Time, k.Value * fator, k.Envelope * fator))
						end
						chama.Size = NumberSequence.new(chaves)
						chama.Rate = chama.Rate * 0.5
						chama.Enabled = true
						chama.Parent = lamina
						table.insert(e.chamasLamina, chama)
						table.insert(e.detalhes, chama)
					end
				end
			end
		end
	end
	if e.soldaEscudo then
		-- o escudo vai para a frente quando defende e volta para o lado quando solta
		local dt = math.clamp(agora - (e.quadroArma or agora), 0, 0.1)
		local alvo = if e.defendendo then 1 else 0
		e.pesoEscudo = (e.pesoEscudo or 0) + (alvo - (e.pesoEscudo or 0)) * math.min(1, dt * 16)
		e.soldaEscudo.C0 = ESCUDO_CARREGADO:Lerp(ESCUDO_DEFESA, e.pesoEscudo)
	end
	e.quadroArma = agora
	local acao = e.acao
	if e.trilha then
		-- "trilha" = true (o tempo todo) ou { início, fim } (só durante o corte)
		local ligada = false
		if acao and acao.def.trilha and acao.soltando == nil then
			local tau = tempoAnimado(acao, agora - acao.inicio)
			local janela = acao.def.trilha
			ligada = if type(janela) == "table" then tau >= janela[1] and tau <= janela[2] else true
		end
		if e.trilha.Enabled ~= ligada then
			e.trilha.Enabled = ligada
		end
		if e.trilha2 and e.trilha2.Enabled ~= ligada then
			e.trilha2.Enabled = ligada
		end
	end
	if e.encaixe and e.arco and e.flecha then
		local puxar = math.clamp(e.puxar, 0, 1.3)
		local z = 0.62 + puxar * 1.6
		e.encaixe.Position = Vector3.new(0, 0, z)
		local noArco = puxar > 0.15
		-- flecha na mão direita: acabou de tirar da aljava e ainda não encaixou
		local maoDireita = e.personagem:FindFirstChild("RightHand") or e.personagem:FindFirstChild("Right Arm")
		local naMao = not noArco and e.flechaMao > 0.5 and maoDireita ~= nil
		local visivel = noArco or naMao
		e.flecha.Transparency = if visivel then 0 else 1
		e.pontaFlecha.Transparency = if visivel then 0 else 1
		if e.chamasLamina then
			for _, chama in e.chamasLamina do
				if chama.Enabled ~= visivel then
					chama.Enabled = visivel
				end
			end
		end
		if noArco then
			local cf = e.arco.CFrame * CFrame.new(0, 0, z - 1.35)
			e.flecha.CFrame = cf
			e.pontaFlecha.CFrame = cf * CFrame.new(0, 0, -1.45)
		elseif naMao then
			-- presa entre os dedos, apontando para cima ao longo do braço
			local cf = (maoDireita :: BasePart).CFrame * CFrame.new(0, 0.9, 0) * CFrame.Angles(math.rad(90), 0, 0)
			e.flecha.CFrame = cf
			e.pontaFlecha.CFrame = cf * CFrame.new(0, 0, -1.45)
		end
	end
	local carga = cargaDe(e)
	if e.glow and e.pontaArma then
		-- carregando com o efeito do pacote (Orbe do Vazio na ponta do cajado), a bola de luz feita
		-- por código não cresce: fica só o brilho de sempre do cristal
		local cargaNaBola = if e.efeitoCarga then 0 else carga
		local intensidade = math.clamp(e.brilho * 0.6 + cargaNaBola, 0, 1.5)
		e.glow.Transparency = if intensidade > 0.02 then 1 - math.min(0.75, intensidade * 0.6) else 1
		e.glow.Size = Vector3.one * (0.6 + intensidade * 1.6 + math.sin(agora * 20) * 0.08 * cargaNaBola)
		e.glow.CFrame = CFrame.new(e.pontaArma.WorldPosition)
		e.luzGlow.Brightness = intensidade * 3
	end
	if e.esfera and e.pontaArma then
		e.esfera.CFrame = CFrame.new(e.pontaArma.WorldPosition)
		-- (Cavaleiro e Arqueiro usam o efeito de carga do pacote de VFX, sem estas partículas)
		local classe = classeDe(e)
		local cargaPronta = classe == "cavaleiro"
			or (classe == "arqueiro" and Vfx.temPrefab("CargaArqueiro"))
			or (classe == "assassino" and Vfx.temPrefab("CargaAssassino"))
			or (classe == "mago" and e.efeitoCarga ~= nil)
		e.emissorCarga.Rate = if e.carregando and not cargaPronta then 20 + 60 * carga else 0
		if e.carregando and carga >= 1 and not e.cheioAvisado then
			e.cheioAvisado = true
			e.emissorCarga.Color = ColorSequence.new(Color3.new(1, 1, 1), OURO)
			-- o Arqueiro brilha na ponta da flecha (a corda está puxada até o rosto)
			local onde = if classe == "arqueiro" and e.pontaFlecha and e.pontaFlecha.Transparency < 1
				then e.pontaFlecha.Position
				else e.pontaArma.WorldPosition
			-- o Assassino acende um selo vermelho no chão, debaixo dele
			local raizCarga = e.personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
			if classe == "assassino" and raizCarga then
				onde = raizCarga.Position - Vector3.new(0, 2.6, 0)
			end
			Vfx.cargaCheia({ pos = onde, local_ = e.jogador == jogador, classe = classe })
		end
	end
end

-- Barrinha de carga acima do próprio personagem (só quem carrega vê)
local barra: BillboardGui? = nil
local preenchimento: Frame? = nil

local function criarBarra()
	local gui = Instance.new("BillboardGui")
	gui.Name = "BarraDeCarga"
	gui.Size = UDim2.fromOffset(70, 9)
	gui.StudsOffset = Vector3.new(0, 3.6, 0)
	gui.AlwaysOnTop = true
	gui.Enabled = false
	local fundo = Instance.new("Frame")
	fundo.Size = UDim2.fromScale(1, 1)
	fundo.BackgroundColor3 = Color3.fromRGB(20, 18, 28)
	fundo.BackgroundTransparency = 0.25
	fundo.BorderSizePixel = 0
	fundo.Parent = gui
	Instance.new("UICorner", fundo).CornerRadius = UDim.new(1, 0)
	local contorno = Instance.new("UIStroke")
	contorno.Color = Color3.new(0, 0, 0)
	contorno.Thickness = 1.5
	contorno.Parent = fundo
	local cheio = Instance.new("Frame")
	cheio.Size = UDim2.fromScale(0, 1)
	cheio.BorderSizePixel = 0
	cheio.Parent = fundo
	Instance.new("UICorner", cheio).CornerRadius = UDim.new(1, 0)
	gui.Parent = pasta
	barra, preenchimento = gui, cheio
end

local function atualizarBarra(e, agora: number)
	if e.jogador ~= jogador then
		return
	end
	if not barra then
		criarBarra()
	end
	local gui, cheio = barra :: BillboardGui, preenchimento :: Frame
	local raiz = e.personagem:FindFirstChild("HumanoidRootPart")
	gui.Adornee = raiz
	gui.Enabled = e.carregando and raiz ~= nil
	if not gui.Enabled then
		return
	end
	local carga = cargaDe(e)
	cheio.Size = UDim2.fromScale(carga, 1)
	if carga >= 1 then
		-- cheia: pisca entre dourado e branco
		cheio.BackgroundColor3 = OURO:Lerp(Color3.new(1, 1, 1), (math.sin(agora * 18) + 1) * 0.3)
	else
		cheio.BackgroundColor3 = (e.corClasse or OURO):Lerp(Color3.new(1, 1, 1), 0.25)
	end
end

------------------------------------------------------------------------
-- Aplicar a pose nas juntas (depois da animação padrão, antes da física)
------------------------------------------------------------------------

-- Peso geral da ação. Quem tem quadros já entra e sai suave junta por junta (peso de cada
-- valor); só as animações contínuas e as interrompidas precisam de rampa aqui.
local function pesoDaAcao(a, agora: number): (number, number)
	local tau = agora - a.inicio
	local peso = 1
	if a.def.continuo then
		peso = math.min(1, tau / 0.08)
	end
	if a.soltando then
		peso *= math.max(0, 1 - (agora - a.soltando) / 0.15)
	elseif not a.def.manter and not a.def.voltar then
		local saida = a.def.saida or 0.12
		local resto = a.duracao - tau
		if resto < saida then
			peso *= math.max(0, resto / saida)
		end
	end
	return peso, tempoAnimado(a, tau)
end

local function poseDaAcao(a, tau: number)
	if a.def.continuo then
		return a.def.continuo(tau, a.dados)
	end
	return amostrar(a.def, tau, a.base)
end

local function cframeDe(v): CFrame
	return CFrame.new(v[4], v[5], v[6]) * CFrame.fromEulerAnglesYXZ(v[1], v[2], v[3])
end

local function animarPersonagem(e, agora: number)
	-- junta -> { CFrame, peso }. As camadas são misturadas como rotações (CFrame:Lerp), não
	-- ângulo por ângulo: assim a volta de um golpe para a guarda faz sempre o caminho curto.
	local final = {}
	local especiais = {} -- puxar/brilho/flechaMao -> { valor, peso }
	local classe = classeDe(e)

	-- Mistura uma camada por cima: o peso de cada junta é o peso da camada vezes o peso
	-- do próprio valor (o 7º número)
	local function aplicarCamada(pose, peso: number, pesoPernas: number?)
		for junta, valor in pose do
			local w = peso * (valor[7] or 1)
			if pesoPernas and PERNAS[junta] then
				w *= pesoPernas
			end
			if w > 0.001 then
				if ESPECIAIS[junta] then
					local atual = especiais[junta]
					especiais[junta] = if atual then { atual[1] + (valor[1] - atual[1]) * w, atual[2] + (1 - atual[2]) * w } else { valor[1], w }
				else
					local atual = final[junta]
					local alvo = cframeDe(valor)
					if atual then
						final[junta] = { atual[1]:Lerp(alvo, w), atual[2] + (1 - atual[2]) * w }
					else
						final[junta] = { alvo, w }
					end
				end
			end
		end
	end

	local postura = POSTURAS[classe]
	if postura then
		aplicarCamada(postura, PESO_POSTURA)
	end

	local raiz = e.personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
	local dt = math.clamp(agora - (e.ultimoQuadro or agora), 0, 0.1)
	e.ultimoQuadro = agora

	-- Andar próprio da classe (no lugar da animação de andar do avatar do jogador): a passada
	-- acompanha a velocidade e a direção em que o corpo anda; no ar, volta a animação de pulo
	local andar = ANDAR[classe]
	if andar and raiz then
		local v = raiz.AssemblyLinearVelocity
		local plano = Vector3.new(v.X, 0, v.Z)
		local velocidade = plano.Magnitude
		local humanoid = e.humanoid
		local noChao = humanoid ~= nil and humanoid.FloorMaterial ~= Enum.Material.Air
		local alvo = if noChao and velocidade > 1.5 then 1 else 0
		e.andando = (e.andando or 0) + (alvo - (e.andando or 0)) * math.min(1, dt * 12)
		if e.andando > 0.01 then
			local frente, lado = 1, 0
			if velocidade > 0.5 then
				local relativo = raiz.CFrame:VectorToObjectSpace(plano)
				frente, lado = -relativo.Z / velocidade, relativo.X / velocidade
			end
			-- uma volta da fase = dois passos, a cada 8 studs andados (passos longos e pesados);
			-- o Arqueiro dá passos mais curtos e rápidos (Poses.PASSADA)
			local passada = Poses.PASSADA[classe] or 8
			e.fase = ((e.fase or 0) + dt * velocidade * (2 * math.pi / passada)) % (2 * math.pi)
			aplicarCamada(andar(e.fase, frente, lado, math.clamp(velocidade / 16, 0, 1)), e.andando)
			-- correndo (Shift): a corrida entra por cima do andar
			local correr = Poses.CORRER[classe]
			local querCorrer = e.jogador ~= nil and e.jogador:GetAttribute("Correndo") == true and velocidade > 10
			e.correndo = (e.correndo or 0) + ((if querCorrer then 1 else 0) - (e.correndo or 0)) * math.min(1, dt * 8)
			if correr and e.correndo > 0.01 then
				aplicarCamada(correr(e.fase, frente, lado), e.correndo * e.andando)
			end
		end
	end

	-- Pose parada: entra suave quando o personagem para e sai quando ele anda ou pula
	local parado = 0
	if raiz then
		-- pela velocidade (funciona também para os personagens dos outros jogadores)
		local v = raiz.AssemblyLinearVelocity
		if math.abs(v.Y) < 3 then
			parado = math.clamp(1 - Vector3.new(v.X, 0, v.Z).Magnitude / 3, 0, 1)
		end
	end
	e.parado = (e.parado or 0) + (parado - (e.parado or 0)) * 0.15
	local poseParada = PARADO[classe]
	if poseParada and e.parado > 0.01 then
		aplicarCamada(poseParada(agora), e.parado * 0.9)
	end

	local a = e.acao
	if a then
		local peso, tau = pesoDaAcao(a, agora)
		if (peso <= 0 and a.soltando) or tau > a.duracao then
			e.acao = nil
			e.ultimaPose = {}
		else
			local pose = poseDaAcao(a, tau)
			if e.carregando and a.def.manter then
				-- tremendo de força enquanto carrega
				local carga = cargaDe(e)
				local tremor = math.sin(agora * 45) * 0.025 * (0.4 + carga)
				pose = table.clone(pose)
				if pose.cintura then
					pose.cintura = misturar(pose.cintura, A(pose.cintura[1] + tremor, pose.cintura[2] + tremor, pose.cintura[3]), 1)
				end
			end
			-- guarda onde o corpo está (com o peso atual) para a próxima ação partir daqui
			local guardada = {}
			for junta, valor in pose do
				guardada[junta] = { valor[1], valor[2], valor[3], valor[4], valor[5], valor[6], (valor[7] or 1) * peso }
			end
			e.ultimaPose = guardada
			-- andando, as pernas seguem mais a corrida do que o golpe
			aplicarCamada(pose, peso, 0.3 + 0.7 * (e.parado or 0))
		end
	end

	-- Levitação (Mago): pernas soltas por cima do golpe (a altura entra no fim, na raiz)
	local flutuar = FLUTUAR[classe]
	if flutuar then
		aplicarCamada(flutuar.pernas(agora, e.andando or 0), 1)
	end

	local d = e.dash
	if d then
		local tau = agora - d.inicio
		local duracao = d.def.duracao
		local peso = math.min(1, tau / 0.03)
		if tau > duracao - 0.1 then
			peso *= math.max(0, (duracao - tau) / 0.1)
		end
		if tau >= duracao then
			e.dash = nil
		else
			-- a esquiva manda no corpo todo: tira a postura e o ataque de baixo
			aplicarCamada(if d.def.continuo then d.def.continuo(tau, {}) else amostrar(d.def, tau, {}), peso)
		end
	end

	-- reações rápidas por cima de tudo: levou dano / escudo bloqueou
	local bloqueio = if e.bloqueioPerfeito then BLOQUEIO_PERFEITO else BLOQUEIO
	for _, info in { { "atingido", ATINGIDO, 0.8 }, { "bloqueou", bloqueio, 1 } } do
		local inicio = e[info[1]]
		if inicio then
			local tau = agora - inicio
			Poses.preparar(info[2])
			if tau >= info[2].duracao then
				e[info[1]] = nil
			else
				aplicarCamada(amostrar(info[2], tau, {}), info[3])
			end
		end
	end

	e.puxar = if especiais.puxar then especiais.puxar[1] * especiais.puxar[2] else 0
	e.brilho = if especiais.brilho then especiais.brilho[1] * especiais.brilho[2] else 0
	e.flechaMao = if especiais.flechaMao then especiais.flechaMao[1] * especiais.flechaMao[2] else 0

	-- as juntas podem ter sido trocadas (roupa/escala aplicada depois de nascer): procura de novo
	local precisaBuscar = next(e.juntas) == nil
	for _, j in e.juntas do
		if not j.motor.Parent or not j.motor:IsDescendantOf(e.personagem) then
			precisaBuscar = true
			break
		end
	end
	if precisaBuscar and agora >= (e.proximaBusca or 0) then
		e.proximaBusca = agora + 0.5
		e.juntas = obterJuntas(e.personagem)
		avisarCorpo(e)
	end

	if flutuar then
		-- o corpo inteiro sobe e desce devagar, acima do chão
		local altura = flutuar.altura + math.sin(agora * 2) * flutuar.balanco
		local atual = final.raiz
		final.raiz = { CFrame.new(0, altura, 0) * (if atual then atual[1] else CFrame.identity), 1 }
	end

	for junta, info in final do
		local j = e.juntas[junta]
		local peso = info[2]
		if j and peso > 0.001 and j.motor.Parent then
			local alvo = j.inv * info[1] * j.rot
			j.motor.Transform = j.motor.Transform:Lerp(alvo, math.min(peso, 1))
		end
	end
end

------------------------------------------------------------------------
-- API
------------------------------------------------------------------------

--[[ Toca uma animação num personagem.
	acao: "ataque" (dados.combo), "carregar", "soltar" (dados.fracao), "cancelar",
	      "esquiva", "habilidade", "supremo" (dados.duracao), "defender", "pararDefesa",
	      "bloqueou", "atingido" ]]
-- Sons de cada golpe, no ritmo da animação: o vulto da lâmina chega no auge junto com o
-- impacto; o arqueiro puxa a corda e solta no disparo. (As magias tocam ao sair, em Vfx.)
local function sonsDoAtaque(personagem: Model, classe: string, combo: number)
	local raiz = personagem:FindFirstChild("HumanoidRootPart")
	if not raiz then
		return
	end
	local impacto = Classes.obter(classe).ataque.impacto
	local momento = if impacto then impacto[combo] or 0 else 0
	local function depois(segundos: number, nome: string, opcoes)
		task.delay(math.max(0, segundos), function()
			if raiz.Parent then
				opcoes = opcoes or {}
				opcoes.pai = raiz
				Sons.tocar(nome, opcoes)
			end
		end)
	end
	if classe == "cavaleiro" then
		if combo == 3 then
			depois(momento - 0.2, "espadaPesada", { tom = 0.85 })
		else
			depois(momento - 0.13, "espada")
		end
	elseif classe == "assassino" then
		if combo == 3 then
			depois(momento - 0.13, "espada", { tom = 1.3 })
		else
			depois(momento - 0.06, "adaga")
		end
	elseif classe == "arqueiro" then
		depois(momento * 0.55, "arcoPuxar")
		depois(momento, "arcoSoltar")
	end
end

-- Efeitos presos ao corpo (vento da carga, barreira do escudo): cada um devolve uma função
-- que apaga o efeito
local function pararEfeito(e, campo: string)
	local parar = e[campo]
	if parar then
		e[campo] = nil
		parar()
	end
end

-- Tem carta de fogo? (o servidor marca o jogador; muda os efeitos para as versões de fogo)
local function comFogo(e): boolean
	return e.jogador ~= nil and e.jogador:GetAttribute("PoderFogo") == true
end

--[[ Disparo do Arqueiro: daqui a "momento" segundos (quando a corda solta), sai do arco o anel
	de vento (tiro normal) ou a rajada (tiro forte), na direção em que o corpo olha.
	"subir" inclina a direção para o alto (Chuva de Flechas). ]]
local function disparoDoArco(e, momento: number, forte: boolean, escala: number, subir: Vector3?)
	task.delay(math.max(0, momento), function()
		local raiz = e.personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not raiz or not e.personagem.Parent then
			return
		end
		local direcao = raiz.CFrame.LookVector + (subir or Vector3.zero)
		local origem = if e.arco and e.arco.Parent then e.arco.Position else raiz.Position + Vector3.new(0, 1, 0)
		Vfx.disparoArqueiro(origem + direcao.Unit * 0.8, direcao, forte, escala, comFogo(e))
	end)
end

function Animacoes.tocar(personagem: Model, acao: string, dados)
	if not personagem or not personagem.Parent then
		return
	end
	dados = dados or {}
	local e = estadoDe(personagem)
	local classe = if Classes.existe(dados.classe) then dados.classe else classeDe(e)
	local acoes = ACOES[classe]
	local cor = Classes.obter(classe).cor
	-- o zumbido de carregar para quando o golpe sai, é cancelado ou o personagem esquiva
	if acao == "soltar" or acao == "cancelar" or acao == "esquiva" or acao == "defender" then
		Sons.parar(e.somCarga)
		e.somCarga = nil
		pararEfeito(e, "efeitoCarga")
	end
	if acao ~= "defender" and acao ~= "bloqueou" and acao ~= "atingido" then
		pararEfeito(e, "efeitoEscudo")
	end
	local raizSom = personagem:FindFirstChild("HumanoidRootPart")
	if acao == "ataque" then
		local combo = math.clamp(dados.combo or 1, 1, 3)
		sonsDoAtaque(personagem, classe, combo)
		comecar(e, acoes["ataque" .. combo], dados)
		-- preparação mais longa (peso do golpe): estica só o começo da animação
		local ataqueDef = Classes.obter(classe).ataque
		local base = ataqueDef.impactoBase and ataqueDef.impactoBase[combo] or 0
		local fator = ataqueDef.preparoFator or 1
		if e.acao and base > 0 and fator > 1 then
			e.acao.preparo = { base = base, fator = fator }
			e.acao.duracao += base * (fator - 1)
		end
		-- depois do impacto: pausa curta e a volta dura até o próximo ataque (cadência)
		if e.acao and base > 0 then
			local impacto = base * fator
			local pausa = PAUSA_IMPACTO[classe] or 0.04
			local restoBase = math.max(0.05, (e.acao.def.duracao or 0.5) - base)
			local cadencia = Classes.cadencia(Classes.obter(classe), combo, dados.velAtaque or 1)
			local esticar = math.max(1, (cadencia - impacto - pausa) / restoBase)
			e.acao.recuperacao = { inicio = base, pausa = pausa, fator = esticar }
			e.acao.duracao = impacto + pausa + restoBase * esticar
		end
		if classe == "arqueiro" then
			local impacto = Classes.obter(classe).ataque.impacto
			disparoDoArco(e, if impacto then impacto[combo] or 0 else 0, combo == 3, if combo == 3 then 0.3 else 0.55)
		end
	elseif acao == "carregar" then
		if raizSom then
			e.somCarga = Sons.tocar("carregar", { pai = raizSom })
			if classe == "arqueiro" then
				Sons.tocar("arcoPuxar", { pai = raizSom, tom = 0.85 })
			end
		end
		e.carregando = true
		e.cargaInicio = os.clock()
		e.cheioAvisado = false
		comecar(e, acoes.carregar, dados)
		if classe == "cavaleiro" then
			-- o vento do tornado se formando em volta enquanto a espada gira
			pararEfeito(e, "efeitoCarga")
			e.efeitoCarga = Vfx.ventoCarga(personagem, cor, function()
				return cargaDe(e)
			end)
		elseif classe == "arqueiro" then
			-- energia juntando na ponta da flecha (na mão ao pegar da aljava, depois no arco)
			pararEfeito(e, "efeitoCarga")
			e.efeitoCarga = Vfx.cargaArqueiro(function()
				if not personagem.Parent then
					return nil
				end
				if e.pontaFlecha and e.pontaFlecha.Transparency < 1 then
					return e.pontaFlecha.Position
				end
				return if e.encaixe then e.encaixe.WorldPosition else nil
			end, comFogo(e))
		elseif classe == "assassino" and raizSom then
			-- a escuridão se junta em volta dele enquanto ele se encolhe
			pararEfeito(e, "efeitoCarga")
			local raizCarga = raizSom :: BasePart
			e.efeitoCarga = Vfx.prefab("CargaAssassino", function()
				return if raizCarga.Parent then CFrame.new(raizCarga.Position) else nil
			end, 0, 0.2)
		elseif classe == "mago" then
			-- o Orbe do Vazio (efeito do pacote) se forma na ponta do cajado enquanto carrega
			pararEfeito(e, "efeitoCarga")
			e.efeitoCarga = Vfx.prefab("ProjetilVazio", function()
				local ponta = e.pontaArma
				return if ponta and ponta.Parent and personagem.Parent then CFrame.new(ponta.WorldPosition) else nil
			end, 0, 0.14)
		end
	elseif acao == "soltar" then
		e.carregando = false
		if e.emissorCarga and e.corClasse then
			e.emissorCarga.Color = ColorSequence.new(e.corClasse:Lerp(Color3.new(1, 1, 1), 0.4), e.corClasse)
		end
		comecar(e, acoes.soltar, dados)
		if classe == "arqueiro" then
			disparoDoArco(e, 0.03, true, 0.35 + 0.25 * math.clamp(dados.fracao or 0, 0, 1))
		end
	elseif acao == "cancelar" then
		e.carregando = false
		if e.acao and e.acao.def.manter then
			e.acao.soltando = os.clock()
		end
	elseif acao == "esquiva" then
		e.carregando = false
		if e.acao and e.acao.def.manter then
			e.acao.soltando = os.clock()
		end
		e.dash = { inicio = os.clock(), def = ESQUIVAS[classe] or ESQUIVAS.cavaleiro }
		Vfx.esquiva({ jogador = e.jogador, classe = classe })
	elseif acao == "habilidade" or acao == "supremo" then
		if acao == "habilidade" and classe == "arqueiro" and raizSom then
			Vfx.saltoArqueiro(raizSom :: BasePart)
			task.delay(0.18, function()
				Sons.tocar("arcoSoltar", { pai = raizSom, tom = 1.1 })
			end)
			-- o arco aponta para o alto: a rajada sobe para a frente
			disparoDoArco(e, 0.18, true, 0.4, Vector3.new(0, 1.6, 0))
		end
		comecar(e, acoes[acao], dados)
	elseif acao == "defender" then
		if raizSom then
			Sons.tocar("escudo", { pai = raizSom, volume = 0.25, tom = 1.5 })
		end
		e.carregando = false
		e.defendendo = true
		comecar(e, acoes.defender, dados)
		pararEfeito(e, "efeitoEscudo")
		e.efeitoEscudo = Vfx.barreiraEscudo(personagem, cor)
	elseif acao == "pararDefesa" then
		e.defendendo = false
		if e.acao and e.acao.def == acoes.defender then
			e.acao.soltando = os.clock()
		end
	elseif acao == "bloqueou" then
		e.bloqueou = os.clock()
		e.bloqueioPerfeito = dados.perfeita == true
	elseif acao == "atingido" then
		e.atingido = os.clock()
	end
end

-- Ações que o próprio jogador já anima na hora do clique (o servidor não manda de volta)
local PREVISTAS = { ataque = true, carregar = true, soltar = true, cancelar = true, esquiva = true, defender = true, pararDefesa = true }

-- Mensagem "anim" vinda do servidor
function Animacoes.receber(dados)
	local player = dados.jogador
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	if player == jogador and PREVISTAS[dados.acao] then
		return
	end
	local personagem = player.Character
	if personagem then
		Animacoes.tocar(personagem, dados.acao, dados)
	end
end

function Animacoes.atingido(player: any)
	if typeof(player) == "Instance" and player:IsA("Player") and player.Character then
		Animacoes.tocar(player.Character, "atingido", nil)
	end
end

function Animacoes.iniciar()
	RunService.PreSimulation:Connect(function()
		local agora = os.clock()
		for personagem, e in personagens do
			if not personagem.Parent then
				for _, objeto in e.detalhes or {} do
					objeto:Destroy()
				end
				personagens[personagem] = nil
			else
				local humanoid = e.humanoid
				if not humanoid or not humanoid.Parent then
					-- o estado pode ter sido criado antes do Humanoid aparecer
					humanoid = personagem:FindFirstChildOfClass("Humanoid")
					e.humanoid = humanoid
				end
				if humanoid and humanoid.Health > 0 and not humanoid.Sit then
					local ok, erro = pcall(animarPersonagem, e, agora)
					if not ok and not e.erroAvisado then
						-- mostra o erro uma vez só (em vez de a animação sumir em silêncio)
						e.erroAvisado = true
						warn("[Animacoes] Erro ao animar " .. personagem.Name .. ": " .. tostring(erro))
					end
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(function()
		local agora = os.clock()
		for _, e in personagens do
			atualizarArma(e, agora)
			atualizarBarra(e, agora)
		end
	end)

	-- Todo personagem ganha estado assim que aparece (para a postura de combate)
	local function acompanhar(player: Player)
		player.CharacterAdded:Connect(function(personagem)
			personagem:WaitForChild("Humanoid", 10)
			task.wait(0.1)
			if personagem.Parent then
				estadoDe(personagem)
			end
		end)
		if player.Character then
			estadoDe(player.Character)
		end
	end
	for _, player in Players:GetPlayers() do
		acompanhar(player)
	end
	Players.PlayerAdded:Connect(acompanhar)
end

return Animacoes
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000035">
          <Properties>
            <string name="Name">Atalhos</string>
            <ProtectedString name="Source"><![CDATA[-- Teclas escolhidas pelo jogador: diz qual ação uma tecla aperta e salva as mudanças
-- no perfil (servidor). A lista de ações e as teclas padrão ficam em Shared/Teclas.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Teclas = require(Shared:WaitForChild("Teclas"))

local Estado = require(script.Parent.Estado)

local Atalhos = {}

local Acao = ReplicatedStorage:WaitForChild("Remotos"):WaitForChild("Acao") :: RemoteEvent

Atalhos.atual = Teclas.normalizar(nil)

-- Nome da tecla (ou botão do mouse) de uma entrada; nil se não for teclado/mouse
function Atalhos.nomeDe(entrada: InputObject): string?
	local tipo = entrada.UserInputType
	if tipo == Enum.UserInputType.MouseButton1 or tipo == Enum.UserInputType.MouseButton2 or tipo == Enum.UserInputType.MouseButton3 then
		return tipo.Name
	elseif tipo == Enum.UserInputType.Keyboard then
		return entrada.KeyCode.Name
	end
	return nil
end

-- Qual ação esta entrada aciona (teclado, mouse ou controle)
function Atalhos.acaoDe(entrada: InputObject): string?
	local nome = Atalhos.nomeDe(entrada)
	if nome then
		for id, lista in Atalhos.atual do
			if lista[1] == nome or lista[2] == nome then
				return id
			end
		end
		return nil
	end
	for id, botao in Teclas.CONTROLE do
		if entrada.KeyCode == botao then
			return id
		end
	end
	return nil
end

-- Tecla principal de uma ação (para mostrar no HUD); usa a alternativa se não houver
function Atalhos.principal(id: string): string?
	local lista = Atalhos.atual[id]
	if not lista then
		return nil
	end
	return (lista[1] or lista[2]) or nil
end

local function avisarMudanca()
	Estado.avisar("teclas")
end

-- Teclas vindas do perfil salvo
function Atalhos.carregar(tabela: any)
	Atalhos.atual = Teclas.normalizar(tabela)
	avisarMudanca()
end

local salvarAgendado = false
local function salvar()
	avisarMudanca()
	-- junta várias mudanças seguidas num só envio
	if salvarAgendado then
		return
	end
	salvarAgendado = true
	task.delay(1, function()
		salvarAgendado = false
		Acao:FireServer("salvarTeclas", Atalhos.atual)
	end)
end

--[[ Coloca uma tecla numa ação (slot 1 = principal, 2 = alternativa).
	Se a tecla já era de outra ação, sai de lá. Retorna (ok, mensagem). ]]
function Atalhos.definir(id: string, slot: number, nome: string): (boolean, string?)
	if not Atalhos.atual[id] or (slot ~= 1 and slot ~= 2) then
		return false, nil
	end
	if Teclas.RESERVADAS[nome] then
		return false, "Essa tecla já é usada para andar, pular ou abrir o chat."
	end
	if not Teclas.valida(nome) then
		return false, "Essa tecla não pode ser usada."
	end
	local mensagem = nil
	for outroId, lista in Atalhos.atual do
		for outroSlot = 1, 2 do
			if lista[outroSlot] == nome and not (outroId == id and outroSlot == slot) then
				lista[outroSlot] = false
				mensagem = Teclas.texto(nome) .. " saiu de " .. Teclas.acoesPorId[outroId].nome .. "."
			end
		end
	end
	Atalhos.atual[id][slot] = nome
	salvar()
	return true, mensagem
end

function Atalhos.limpar(id: string, slot: number)
	if Atalhos.atual[id] then
		Atalhos.atual[id][slot] = false
		salvar()
	end
end

function Atalhos.restaurarPadrao()
	Atalhos.atual = Teclas.normalizar(nil)
	salvar()
end

return Atalhos
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000036">
          <Properties>
            <string name="Name">BracoMalha</string>
            <ProtectedString name="Source"><![CDATA[-- Braço que se mexe num modelo 3D de uma peça só (sem esqueleto), como o Skullbane.
-- Usa EditableMesh: os vértices do braço e da lâmina giram pelo ombro e pelo cotovelo.
--
-- As medidas vêm do arquivo original (.glb), num espaço em que o modelo olha para +Z e o braço
-- da lâmina fica do lado -X. A malha do Roblox é ligada a esse espaço pela caixa em volta
-- (mínimo e máximo de cada eixo), então não importa se o Roblox centralizou ou espelhou.
--
-- Pose do braço (radianos):
--   lev = levanta para a frente/cima (0 = caído, 1,57 = para a frente, 2,7 = acima da cabeça)
--   abr = abre para o lado de fora     gir = gira na horizontal (+ = cruza na frente do corpo)
--   cot = dobra o cotovelo para a frente
--
-- Precisa de Game Settings > Security > "Allow Mesh / Image APIs". Sem isso (ou se der erro),
-- BracoMalha.criar devolve nil e o modelo fica com o braço parado.

local AssetService = game:GetService("AssetService")

local BracoMalha = {}

local function suave(a: number, b: number, x: number): number
	local k = math.clamp((x - a) / (b - a), 0, 1)
	return k * k * (3 - 2 * k)
end

-- Pesos de um ponto (espaço do .glb): w = o quanto gira com o ombro, wE = com o cotovelo
local function pesos(def, p: Vector3): (number, number)
	local cadeia, raios = def.cadeia, def.raios
	local melhor, sMelhor, rMelhor = math.huge, 0, 0
	local acumulado = 0
	local inicioCotovelo = 0
	for i = 1, #cadeia - 1 do
		local a, b = cadeia[i], cadeia[i + 1]
		local ab = b - a
		local comprimento = ab.Magnitude
		local t = math.clamp((p - a):Dot(ab) / (comprimento * comprimento), 0, 1)
		local d = (p - (a + ab * t)).Magnitude
		if d < melhor then
			melhor, sMelhor, rMelhor = d, acumulado + t * comprimento, raios[i]
		end
		if i == 1 then
			inicioCotovelo = comprimento
		end
		acumulado += comprimento
	end
	-- transições largas: na malha do Roblox (com triângulos maiores que os do .glb) um
	-- triângulo nunca fica com um canto girando e outro parado
	local w = (1 - suave(rMelhor - 0.05, rMelhor, melhor)) * suave(0.02, 0.18, sMelhor)
	local wE = suave(inicioCotovelo - 0.08, inicioCotovelo + 0.08, sMelhor)
	local regras = def.regras
	-- pernas nunca mexem (nem um espinho do pé que fique do lado da arma)
	if regras.pernasY and p.Y < regras.pernasY then
		return 0, 0
	end
	-- lâmina e manopla: tudo à esquerda da capa abaixo do pulso vai inteiro com o braço
	if p.Y < regras.pulsoY and p.X < regras.laminaX then
		return 1, 1
	end
	-- capa e corpo: nunca mexem
	if (p.Y < regras.pulsoY and p.X > regras.capaX) or p.X > regras.corpoX then
		return 0, 0
	end
	return w, wE
end

-- Rotações do ombro e do cotovelo (espaço do .glb) para uma pose
local function rotacoes(lev: number, abr: number, gir: number, cot: number): (CFrame, CFrame)
	local ombro = CFrame.Angles(0, gir, 0) * CFrame.Angles(0, 0, -abr) * CFrame.Angles(-lev, 0, 0)
	local cotovelo = CFrame.Angles(-cot, 0, 0)
	return ombro, cotovelo
end
BracoMalha.rotacoes = rotacoes

-- Transformação da lâmina (pontos com peso total) no espaço do .glb
function BracoMalha.transformacao(def, lev: number, abr: number, gir: number, cot: number): CFrame
	local ombro, cotovelo = rotacoes(lev, abr, gir, cot)
	local s, e = def.cadeia[1], def.cadeia[2]
	return CFrame.new(s) * ombro * CFrame.new(-s) * CFrame.new(e) * cotovelo * CFrame.new(-e)
end

--[[ Cria a malha editável a partir da peça original. Devolve { parte = MeshPart nova (já com
	a mesma aparência e tamanho), aplicar = function(lev, abr, gir, cot) } ou nil.
	Demora um pouco (carrega a malha); chame dentro de task.spawn. ]]
function BracoMalha.criar(original: MeshPart, def)
	local ok, resultado = pcall(function()
		local conteudo = Content.fromUri(original.MeshId)
		local malha = AssetService:CreateEditableMeshAsync(conteudo, { FixedSize = false })
		local vertices = malha:GetVertices()
		if #vertices == 0 then
			error("malha sem vértices")
		end
		-- caixa da malha do Roblox
		local minimo = Vector3.one * math.huge
		local maximo = -Vector3.one * math.huge
		local posicoes = {}
		local menorX, maiorX = nil, nil
		for _, id in vertices do
			local p = malha:GetPosition(id)
			posicoes[id] = p
			minimo = minimo:Min(p)
			maximo = maximo:Max(p)
			if not menorX or p.X < posicoes[menorX].X then
				menorX = id
			end
			if not maiorX or p.X > posicoes[maiorX].X then
				maiorX = id
			end
		end
		local extensao = maximo - minimo
		-- espelhado? Compara os pontos mais à esquerda e mais à direita com os mesmos pontos
		-- medidos no .glb (altura e profundidade de 0 a 1 dentro da caixa)
		local function relativo(p: Vector3): Vector2
			local u = (p - minimo) / extensao
			return Vector2.new(u.Y, u.Z)
		end
		local a, b = relativo(posicoes[menorX]), relativo(posicoes[maiorX])
		local refMin, refMax = def.referencia.minX, def.referencia.maxX
		local espelhoX = math.abs(a.X - refMin.X) + math.abs(b.X - refMax.X) > math.abs(a.X - refMax.X) + math.abs(b.X - refMin.X)
		local ponta = if espelhoX then b else a -- o ponto que no .glb é o mais à esquerda
		local espelhoZ = math.abs(ponta.Y - refMin.Y) > math.abs((1 - ponta.Y) - refMin.Y)
		local gMin, gMax = def.caixa.min, def.caixa.max
		local gExt = gMax - gMin
		local function paraGlb(p: Vector3): Vector3
			local u = (p - minimo) / extensao
			if espelhoX then
				u = Vector3.new(1 - u.X, u.Y, u.Z)
			end
			if espelhoZ then
				u = Vector3.new(u.X, u.Y, 1 - u.Z)
			end
			return gMin + u * gExt
		end
		local function daGlb(g: Vector3): Vector3
			local u = (g - gMin) / gExt
			if espelhoX then
				u = Vector3.new(1 - u.X, u.Y, u.Z)
			end
			if espelhoZ then
				u = Vector3.new(u.X, u.Y, 1 - u.Z)
			end
			return minimo + u * extensao
		end
		local sinal = Vector3.new(if espelhoX then -1 else 1, 1, if espelhoZ then -1 else 1)

		-- vértices que se mexem, com os pesos e as normais
		local braco = {}
		for _, id in vertices do
			local g = paraGlb(posicoes[id])
			local w, wE = pesos(def, g)
			if w > 0.001 then
				table.insert(braco, { id, g, w, wE, {} })
			end
		end
		if #braco == 0 then
			error("nenhum vértice no braço (o modelo é outro?)")
		end

		-- Triângulos que ligam a parte que gira à parte parada (a malha da IA é uma casca só:
		-- a lâmina pode estar "colada" na coxa ou na capa) esticariam em fios compridos com a
		-- textura da lâmina. Eles são apagados; se forem muitos, o braço fica parado.
		local pesoDe = {}
		for _, v in braco do
			pesoDe[v[1]] = v
		end
		local remover, facesDoBraco = {}, 0
		for _, face in malha:GetFaces() do
			local menorW, maiorW, menorE, maiorE = 1, 0, 1, 0
			for _, id in malha:GetFaceVertices(face) do
				local v = pesoDe[id]
				local w = if v then v[3] else 0
				local we = if v then v[3] * v[4] else 0
				menorW, maiorW = math.min(menorW, w), math.max(maiorW, w)
				menorE, maiorE = math.min(menorE, we), math.max(maiorE, we)
			end
			if maiorW > 0.001 then
				facesDoBraco += 1
				if maiorW - menorW > 0.45 or maiorE - menorE > 0.6 then
					table.insert(remover, face)
				end
			end
		end
		if facesDoBraco == 0 or #remover / facesDoBraco > 0.15 then
			error(string.format("%d de %d triângulos do braço esticariam (a malha não combina com as medidas)", #remover, facesDoBraco))
		end
		for _, face in remover do
			malha:RemoveFace(face)
		end
		-- normais de cada vértice (lidas depois de apagar os triângulos, só as que sobraram)
		for _, v in braco do
			local okNormais, ids = pcall(function()
				return malha:GetVertexNormals(v[1])
			end)
			if okNormais and ids then
				for _, idNormal in ids do
					local n = malha:GetNormal(idNormal)
					if n then
						table.insert(v[5], { idNormal, n * sinal })
					end
				end
			end
		end

		local parte = AssetService:CreateMeshPartAsync(Content.fromObject(malha))
		parte.Size = original.Size
		for _, filho in original:GetChildren() do
			if filho:IsA("SurfaceAppearance") then
				filho:Clone().Parent = parte
			end
		end
		parte.Anchored = true
		parte.CanCollide = false
		parte.CanQuery = false
		parte.CanTouch = false
		parte.CastShadow = original.CastShadow
		parte.Massless = true

		local s, e = def.cadeia[1], def.cadeia[2]
		local function aplicar(lev: number, abr: number, gir: number, cot: number)
			local ombro, cotovelo = rotacoes(lev, abr, gir, cot)
			local tudo = ombro * cotovelo
			for _, v in braco do
				local g, w, wE = v[2], v[3], v[4]
				local p1 = g
				if wE > 0.001 then
					p1 = g:Lerp(e + cotovelo:VectorToWorldSpace(g - e), w * wE)
				end
				local p2 = p1:Lerp(s + ombro:VectorToWorldSpace(p1 - s), w)
				malha:SetPosition(v[1], daGlb(p2))
				-- normais: giram junto (a luz bate certo no braço erguido)
				if w > 0.5 then
					local rot = if wE > 0.5 then tudo else ombro
					for _, n in v[5] do
						malha:SetNormal(n[1], rot:VectorToWorldSpace(n[2]) * sinal)
					end
				end
			end
		end
		return { parte = parte, aplicar = aplicar, vertices = #braco }
	end)
	if not ok then
		warn("[BracoMalha] O braço do chefe vai ficar parado (" .. tostring(resultado) .. "). Ligue Game Settings > Security > Allow Mesh / Image APIs.")
		return nil
	end
	return resultado
end

return BracoMalha
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000037">
          <Properties>
            <string name="Name">Controles</string>
            <ProtectedString name="Source"><![CDATA[-- Controles: tocar para atacar (mira no mouse; no celular mira sozinha no inimigo mais próximo),
-- segurar para carregar e soltar para um golpe forte, habilidade (E), esquiva (Q), supremo (R),
-- defesa com escudo do Cavaleiro e os botões de toque no celular. As teclas de cada ação
-- vêm de Atalhos (o jogador pode trocar no menu ⚙️ Teclas).

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))

local modulos = script.Parent
local Estado = require(modulos.Estado)
local Vfx = require(modulos.Vfx)
local UI = require(modulos.UI)
local Animacoes = require(modulos.Animacoes)
local Atalhos = require(modulos.Atalhos)

local Controles = {}

local jogador = Players.LocalPlayer
local Acao = ReplicatedStorage:WaitForChild("Remotos"):WaitForChild("Acao") :: RemoteEvent

local segurandoAtaque = false
local segurouEm = 0
local carregando = false
local cargaComecou = 0
local defendendo = false
local ultimoAtaque = 0
local comboLocal = 0
local ultimoFoiFinal = false
local ataquePendente = false -- clique feito pouco antes de liberar: sai assim que puder
local BUFFER_ATAQUE = 0.3
local mirandoAte = 0
local esquivandoAte = 0
local direcaoAtual = Vector3.new(0, 0, -1)

local function planar(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function personagem()
	local p = jogador.Character
	local raiz = p and p:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = p and p:FindFirstChildOfClass("Humanoid")
	return raiz, humanoid
end

local function inimigoMaisProximo(origem: Vector3, alcance: number): Vector3?
	local melhor, melhorDistancia = nil, alcance
	for _, modelo in CollectionService:GetTagged("Inimigo") do
		local raiz = modelo:FindFirstChild("HumanoidRootPart") :: BasePart?
		if raiz then
			local distancia = planar(raiz.Position - origem).Magnitude
			if distancia < melhorDistancia then
				melhor, melhorDistancia = raiz.Position, distancia
			end
		end
	end
	return melhor
end

-- Para onde o ataque vai: o ponto do chão sob o mouse, ou o inimigo mais próximo
local function direcaoDaMira(): Vector3
	local raiz = personagem()
	if not raiz then
		return direcaoAtual
	end
	-- mira travada: o ataque vai para onde a câmera olha
	if Estado.travaMira then
		local olhar = planar(workspace.CurrentCamera.CFrame.LookVector)
		if olhar.Magnitude > 0.1 then
			return olhar.Unit
		end
	end
	if UserInputService.MouseEnabled and not UI.ehCelular() and UserInputService:GetLastInputType() ~= Enum.UserInputType.Gamepad1 then
		local camera = workspace.CurrentCamera
		local mouse = UserInputService:GetMouseLocation()
		local raio = camera:ViewportPointToRay(mouse.X, mouse.Y)
		if math.abs(raio.Direction.Y) > 1e-3 then
			local t = (raiz.Position.Y - 2 - raio.Origin.Y) / raio.Direction.Y
			if t > 0 then
				local ponto = raio.Origin + raio.Direction * t
				local direcao = planar(ponto - raiz.Position)
				if direcao.Magnitude > 0.5 then
					return direcao.Unit
				end
			end
		end
	end
	local alvo = inimigoMaisProximo(raiz.Position, 60)
	if alvo then
		local direcao = planar(alvo - raiz.Position)
		if direcao.Magnitude > 0.1 then
			return direcao.Unit
		end
	end
	local olhar = planar(raiz.CFrame.LookVector)
	return if olhar.Magnitude > 0.1 then olhar.Unit else direcaoAtual
end

-- Vira o personagem para a mira por um instante (dá para andar e atirar para outro lado)
local function mirar(direcao: Vector3)
	direcaoAtual = direcao
	mirandoAte = os.clock() + 0.35
end

-- Empurra o próprio personagem (o movimento do personagem é feito neste computador)
local function impulso(direcao: Vector3, velocidade: number, duracao: number)
	local raiz = personagem()
	if not raiz then
		return
	end
	local anexo = Instance.new("Attachment")
	anexo.Parent = raiz
	local forca = Instance.new("LinearVelocity")
	forca.Attachment0 = anexo
	forca.MaxForce = 1e7
	forca.RelativeTo = Enum.ActuatorRelativeTo.World
	forca.VectorVelocity = direcao * velocidade
	forca.Parent = raiz
	Debris:AddItem(forca, duracao)
	Debris:AddItem(anexo, duracao)
end

-- Mago: tem mana para esta magia? (o servidor confere de novo; aqui é só para não animar à toa)
local function temMana(tipoCusto: string): boolean
	local stats = Estado.stats
	if Estado.modo ~= "partida" or not stats or (stats.manaMax or 0) <= 0 then
		return true
	end
	local custos = Classes.obter(stats.classe).custos
	local custo = if custos then (custos[tipoCusto] or 0) * (stats.custoMana or 1) else 0
	if Estado.mana < custo then
		Estado.avisar("semMana")
		return false
	end
	Estado.mana -= custo
	return true
end

local function podeLutar(): boolean
	return not Estado.caido and not Estado.morto and Estado.menusAbertos == 0
end

local function tentarAtacar()
	if not podeLutar() or defendendo then
		return
	end
	local raiz = personagem()
	if not raiz then
		return
	end
	local agora = os.clock()
	local stats = Estado.stats
	local naPartida = Estado.modo == "partida" and stats ~= nil
	local classeAtual = Classes.obter(if naPartida then stats.classe else Estado.perfil.classe)
	local velocidade = if naPartida then stats.velAtaque or 1 else 1
	-- cadência: o golpe anterior precisa terminar. Um clique pouco antes fica guardado e sai
	-- na hora certa (não dá para atacar mais rápido clicando sem parar)
	local espera = Classes.cadencia(classeAtual, if ultimoFoiFinal then 3 else comboLocal, velocidade)
	if agora - ultimoAtaque < espera then
		if espera - (agora - ultimoAtaque) <= BUFFER_ATAQUE then
			ataquePendente = true
		end
		return
	end
	ataquePendente = false
	if agora - ultimoAtaque > espera + 0.9 then
		comboLocal = 0
	end
	if not temMana(if comboLocal % 3 + 1 == 3 then "final" else "ataque") then
		ultimoAtaque = agora - espera * 0.5 -- não fica repetindo o aviso a cada quadro
		return
	end
	comboLocal = comboLocal % 3 + 1
	ultimoFoiFinal = comboLocal == 3
	ultimoAtaque = agora
	Estado.ataqueTotal = Classes.cadencia(classeAtual, comboLocal, velocidade)
	Estado.ataqueFim = agora + Estado.ataqueTotal
	Estado.avisar("ataque")

	local direcao = direcaoDaMira()
	mirar(direcao)
	Acao:FireServer("atacar", direcao, comboLocal)
	if jogador.Character then
		Animacoes.tocar(jogador.Character, "ataque", { combo = comboLocal, velAtaque = velocidade })
	end

	-- O próprio corte aparece na hora, sem esperar o servidor
	if naPartida then
		local classe = Classes.obter(stats.classe)
		if classe.ataque.tipo == "corte" then
			-- o rastro do corte aparece quando a lâmina passa na frente (não no clique)
			local combo = comboLocal
			local final = combo == 3
			task.delay(classe.ataque.impacto and classe.ataque.impacto[combo] or 0, function()
				local raizAgora = personagem()
				if not raizAgora then
					return
				end
				Vfx.corte({
					jogador = jogador,
					pos = raizAgora.Position,
					dir = direcao,
					alcance = stats.alcance * (if final then 1.15 else 1),
					arco = stats.arco * (if final then 1.25 else 1),
					cor = classe.cor,
					combo = combo,
					giro = final and classe.id == "cavaleiro",
					cavaleiro = classe.id == "cavaleiro",
					assassino = classe.id == "assassino",
					fogo = stats.fogo == true,
				})
			end)
		end
	end
end

------------------------------------------------------------------------
-- Ataque carregado: segurando o ataque, começa a carregar; ao soltar, sai o golpe forte
------------------------------------------------------------------------

local function comecarCarga()
	local stats = Estado.stats
	local custos = stats and Classes.obter(stats.classe).custos
	if custos and Estado.modo == "partida" and Estado.mana < custos.carregado * (stats.custoMana or 1) then
		Estado.avisar("semMana")
		segurouEm = os.clock() + 999 -- só tenta de novo ao segurar outra vez
		return
	end
	carregando = true
	cargaComecou = os.clock()
	Acao:FireServer("carregar")
	if jogador.Character then
		Animacoes.tocar(jogador.Character, "carregar", nil)
	end
end

local function cancelarCarga()
	if not carregando then
		return
	end
	carregando = false
	Acao:FireServer("cancelar")
	if jogador.Character then
		Animacoes.tocar(jogador.Character, "cancelar", nil)
	end
end

local function soltarCarga()
	if not carregando then
		return
	end
	local raiz = personagem()
	local duracao = os.clock() - cargaComecou
	if not raiz or not podeLutar() or duracao < Config.CARGA_ATAQUE_MIN then
		cancelarCarga()
		return
	end
	carregando = false
	local fracao = math.clamp((duracao - Config.CARGA_ATAQUE_MIN) / (Config.CARGA_ATAQUE_MAX - Config.CARGA_ATAQUE_MIN), 0, 1)
	local direcao = direcaoDaMira()
	mirar(direcao)
	Acao:FireServer("soltar", direcao)
	-- o golpe carregado encerra o combo (o próximo clique recomeça do primeiro golpe)
	comboLocal = 0
	ultimoAtaque = os.clock()
	ultimoFoiFinal = true
	ataquePendente = false
	do
		local stats = Estado.stats
		local classeAtual = Classes.obter(if stats then stats.classe else Estado.perfil.classe)
		Estado.ataqueTotal = Classes.cadencia(classeAtual, 3, if stats then stats.velAtaque or 1 else 1)
		Estado.ataqueFim = ultimoAtaque + Estado.ataqueTotal
	end
	if jogador.Character then
		Animacoes.tocar(jogador.Character, "soltar", { fracao = fracao })
	end

	local stats = Estado.stats
	if Estado.modo == "partida" and stats then
		local classe = Classes.obter(stats.classe)
		if classe.id == "cavaleiro" then
			-- o tornado vem do servidor (sai junto com o corte, em 0,14s); aqui só o tranco
			task.delay(0.14, function()
				Vfx.tremer(0.5 + 0.7 * fracao, 0.2)
			end)
		elseif classe.id == "assassino" then
			-- Investida Letal: dispara para frente (mesma distância que o servidor usa)
			local distancia = 12 + 6 * fracao
			Vfx.investidaLetal({ jogador = jogador, de = raiz.Position, ate = raiz.Position + direcao * distancia, cor = classe.cor, perfeito = fracao >= 0.99 })
			impulso(direcao, distancia / 0.2, 0.2)
			mirandoAte = os.clock() + 0.3
		else
			Vfx.tremer(0.4 + 0.6 * fracao, 0.15)
		end
	end
end

------------------------------------------------------------------------
-- Defesa com escudo (só o Cavaleiro)
------------------------------------------------------------------------

local function minhaClasse(): string
	return if Estado.stats then Estado.stats.classe else Estado.perfil.classe
end

local function defender(ativo: boolean)
	if ativo == defendendo then
		return
	end
	if ativo then
		if minhaClasse() ~= "cavaleiro" or not podeLutar() then
			return
		end
		cancelarCarga()
		defendendo = true
		Acao:FireServer("defender", true)
		if jogador.Character then
			Animacoes.tocar(jogador.Character, "defender", nil)
		end
	else
		defendendo = false
		Acao:FireServer("defender", false)
		if jogador.Character then
			Animacoes.tocar(jogador.Character, "pararDefesa", nil)
		end
	end
end
Controles.defender = defender

-- Maldição das Almas (Skullbane): sem dash, corrida, habilidade e supremo enquanto durar
local function amaldicoado(): boolean
	if jogador:GetAttribute("Amaldicoado") == true then
		Vfx.maldicaoBloqueou()
		return true
	end
	return false
end

local function usarHabilidade()
	if Estado.modo ~= "partida" or not podeLutar() or amaldicoado() then
		return
	end
	if os.clock() < Estado.habilidadeFim - 0.1 then
		return
	end
	if not temMana("habilidade") then
		return
	end
	defender(false)
	local direcao = direcaoDaMira()
	mirar(direcao)
	Acao:FireServer("habilidade", direcao)
	-- Arqueiro: salta para trás antes da chuva de flechas
	local stats = Estado.stats
	if stats and stats.classe == "arqueiro" then
		impulso(-direcao, 70, 0.18)
	end
end

local function usarSupremo()
	if Estado.modo ~= "partida" or not podeLutar() or Estado.carga < Estado.cargaMax or amaldicoado() then
		return
	end
	Acao:FireServer("supremo")
end

local function esquivar()
	if Estado.caido or Estado.morto or Estado.menusAbertos > 0 or amaldicoado() then
		return
	end
	local raiz, humanoid = personagem()
	if not raiz or not humanoid or humanoid.Health <= 0 then
		return
	end
	local agora = os.clock()
	if agora < Estado.esquivaFim then
		return
	end
	-- esquivar cancela a carga e abaixa o escudo (segure de novo para recomeçar)
	cancelarCarga()
	defender(false)
	segurouEm = agora
	local recarga = if Estado.stats then Estado.stats.recargaEsquiva else Config.ESQUIVA_RECARGA
	Estado.esquivaFim = agora + recarga
	Estado.esquivaTotal = recarga
	Estado.avisar("recargas")

	local direcao = planar(humanoid.MoveDirection)
	if direcao.Magnitude < 0.1 then
		direcao = planar(raiz.CFrame.LookVector)
	end
	direcao = if direcao.Magnitude > 0.01 then direcao.Unit else Vector3.new(0, 0, -1)

	-- cada classe pode ter a própria esquiva (o rolamento do Cavaleiro é mais longo)
	local dash = Classes.obter(minhaClasse()).esquiva
	local velocidade = if dash then dash.velocidade else Config.ESQUIVA_VELOCIDADE
	local duracaoDash = if dash then dash.duracao else Config.ESQUIVA_DURACAO

	local anexo = Instance.new("Attachment")
	anexo.Parent = raiz
	local impulso = Instance.new("LinearVelocity")
	impulso.Attachment0 = anexo
	impulso.MaxForce = 1e7
	impulso.RelativeTo = Enum.ActuatorRelativeTo.World
	impulso.VectorVelocity = direcao * velocidade
	impulso.Parent = raiz
	Debris:AddItem(impulso, duracaoDash)
	Debris:AddItem(anexo, duracaoDash)

	-- o corpo vira para onde vai, para a animação da esquiva fazer sentido
	direcaoAtual = direcao
	mirandoAte = agora + duracaoDash + 0.1
	esquivandoAte = mirandoAte
	if jogador.Character then
		Animacoes.tocar(jogador.Character, "esquiva", nil)
	end
	Acao:FireServer("esquiva", direcao)
end

-- Puxão das Almas (chefe): o personagem é arrastado até o centro por um tempo. Andar para
-- longe resiste um pouco; esquivar escapa do puxão na hora.
function Controles.puxar(dados)
	local raiz, humanoid = personagem()
	if not raiz or not humanoid or Estado.caido or Estado.morto then
		return
	end
	local centro: Vector3 = dados.centro
	local forca: number = dados.forca or 30
	local fim = os.clock() + (dados.duracao or 1)
	local anexo = Instance.new("Attachment")
	anexo.Parent = raiz
	local puxao = Instance.new("LinearVelocity")
	puxao.Attachment0 = anexo
	puxao.MaxForce = math.huge
	puxao.RelativeTo = Enum.ActuatorRelativeTo.World
	puxao.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	puxao.PrimaryTangentAxis = Vector3.xAxis
	puxao.SecondaryTangentAxis = Vector3.zAxis
	puxao.Parent = raiz
	local conexao
	conexao = RunService.Heartbeat:Connect(function()
		local agora = os.clock()
		local paraCentro = planar(centro - raiz.Position)
		if agora >= fim or not raiz.Parent or agora < esquivandoAte or paraCentro.Magnitude < 6 or Estado.caido then
			conexao:Disconnect()
			puxao:Destroy()
			anexo:Destroy()
			return
		end
		local resistencia = planar(humanoid.MoveDirection) * humanoid.WalkSpeed * 0.55
		local velocidade = paraCentro.Unit * forca + resistencia
		puxao.PlaneVelocity = Vector2.new(velocidade.X, velocidade.Z)
	end)
end

-- Corrida leve (segurando a tecla): o servidor aumenta a velocidade (menos atacando,
-- carregando ou defendendo) e todos veem a animação de corrida
local querCorrer = false
local function correr(ativo: boolean)
	if ativo == querCorrer then
		return
	end
	querCorrer = ativo
	Estado.correndo = ativo
	Acao:FireServer("correr", ativo)
end
Controles.correr = correr

-- Trava da mira (liga e desliga): o mouse fica preso no centro da tela, a câmera vai para
-- trás do ombro direito e o personagem sempre olha para onde a câmera aponta
local function travarMira(ativo: boolean)
	Estado.travaMira = ativo
	local _, humanoid = personagem()
	if humanoid then
		humanoid.CameraOffset = if ativo then Vector3.new(1.75, 0.3, 0) else Vector3.zero
	end
	if not ativo then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	Estado.avisar("travaMira")
end
Controles.travarMira = travarMira

Controles.atacar = tentarAtacar
Controles.habilidade = usarHabilidade
Controles.supremo = usarSupremo
Controles.esquivar = esquivar

function Controles.segurarAtaque(segurando: boolean)
	if segurando == segurandoAtaque then
		return
	end
	segurandoAtaque = segurando
	if segurando then
		segurouEm = os.clock()
		tentarAtacar()
	elseif carregando then
		soltarCarga()
	end
end

-- Para tudo sem disparar o golpe (ao cair, morrer, abrir menus...)
function Controles.pararAtaque()
	segurandoAtaque = false
	cancelarCarga()
	defender(false)
	correr(false)
end

-- Liga os botões de toque criados pelo HUD
function Controles.ligarBotoes(botoes)
	local function aoTocar(botao: GuiButton, comecar: () -> (), terminar: (() -> ())?)
		botao.InputBegan:Connect(function(entrada)
			if entrada.UserInputType == Enum.UserInputType.Touch or entrada.UserInputType == Enum.UserInputType.MouseButton1 then
				comecar()
			end
		end)
		if terminar then
			botao.InputEnded:Connect(function(entrada)
				if entrada.UserInputType == Enum.UserInputType.Touch or entrada.UserInputType == Enum.UserInputType.MouseButton1 then
					terminar()
				end
			end)
		end
	end
	aoTocar(botoes.ataque, function()
		Controles.segurarAtaque(true)
	end, function()
		Controles.segurarAtaque(false)
	end)
	aoTocar(botoes.habilidade, usarHabilidade)
	aoTocar(botoes.esquiva, esquivar)
	aoTocar(botoes.supremo, usarSupremo)
	if botoes.defesa then
		aoTocar(botoes.defesa, function()
			defender(true)
		end, function()
			defender(false)
		end)
	end
end

function Controles.iniciar()
	UserInputService.InputBegan:Connect(function(entrada, processado)
		if processado then
			return
		end
		local acao = Atalhos.acaoDe(entrada)
		if acao == "ataque" then
			Controles.segurarAtaque(true)
		elseif acao == "habilidade" then
			usarHabilidade()
		elseif acao == "esquiva" then
			esquivar()
		elseif acao == "supremo" then
			usarSupremo()
		elseif acao == "defender" then
			defender(true)
		elseif acao == "correr" then
			correr(true)
		elseif acao == "travarMira" then
			travarMira(not Estado.travaMira)
		end
	end)
	-- soltar a tecla: termina o ataque segurado (solta o golpe carregado) e abaixa o escudo
	UserInputService.InputEnded:Connect(function(entrada)
		local acao = Atalhos.acaoDe(entrada)
		if acao == "ataque" then
			Controles.segurarAtaque(false)
		elseif acao == "defender" then
			defender(false)
		elseif acao == "correr" then
			correr(false)
		end
	end)

	-- mira travada: segura o mouse no centro (o Roblox solta ele a cada quadro) e solta
	-- quando um menu abre ou o personagem cai
	RunService:BindToRenderStep("TravaDaMira", Enum.RenderPriority.Camera.Value + 2, function()
		if not Estado.travaMira then
			return
		end
		local _, humanoidAtual = personagem()
		if Estado.menusAbertos > 0 or Estado.caido or Estado.morto then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			return
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		if humanoidAtual and humanoidAtual.CameraOffset.Magnitude < 0.1 then
			humanoidAtual.CameraOffset = Vector3.new(1.75, 0.3, 0) -- (renasceu com a trava ligada)
		end
	end)

	-- correndo, o campo de visão abre um pouco (soma por cima, sem brigar com outros efeitos)
	local fovCorrida = 0
	RunService.RenderStepped:Connect(function(dt)
		local _, humanoidAtual = personagem()
		local movendo = humanoidAtual ~= nil and humanoidAtual.MoveDirection.Magnitude > 0.2
		local alvo = if querCorrer and movendo and not carregando and not defendendo then 6 else 0
		local novo = fovCorrida + (alvo - fovCorrida) * math.min(1, dt * 6)
		local camera = workspace.CurrentCamera
		if camera then
			camera.FieldOfView += novo - fovCorrida
		end
		fovCorrida = novo
	end)

	RunService.Heartbeat:Connect(function()
		local agora = os.clock()
		-- clique guardado durante a cadência: ataca assim que liberar
		if ataquePendente and agora >= Estado.ataqueFim and not carregando then
			ataquePendente = false
			tentarAtacar()
		end
		if defendendo then
			-- o escudo acompanha a mira (protege o lado para onde você aponta)
			if not podeLutar() or minhaClasse() ~= "cavaleiro" then
				defender(false)
			else
				direcaoAtual = direcaoDaMira()
				mirandoAte = math.max(mirandoAte, agora + 0.1)
			end
		end
		if carregando then
			local _, humanoidAtual = personagem()
			if not podeLutar() or not humanoidAtual or humanoidAtual.Health <= 0 then
				cancelarCarga()
			else
				-- enquanto carrega, o corpo acompanha a mira
				mirandoAte = math.max(mirandoAte, agora + 0.1)
			end
		elseif segurandoAtaque and not defendendo and agora - segurouEm >= Config.CARGA_ATAQUE_COMECA and podeLutar() and personagem() then
			comecarCarga()
		end
		local raiz, humanoid = personagem()
		if not raiz or not humanoid then
			return
		end
		if agora < mirandoAte and humanoid.Health > 0 and not Estado.caido then
			humanoid.AutoRotate = false
			raiz.CFrame = CFrame.lookAt(raiz.Position, raiz.Position + direcaoAtual)
			if segurandoAtaque and agora >= esquivandoAte then
				direcaoAtual = direcaoDaMira()
			end
		elseif Estado.travaMira and humanoid.Health > 0 and not Estado.caido then
			-- mira travada: o corpo acompanha a câmera
			humanoid.AutoRotate = false
			local olhar = planar(workspace.CurrentCamera.CFrame.LookVector)
			if olhar.Magnitude > 0.1 then
				raiz.CFrame = CFrame.lookAt(raiz.Position, raiz.Position + olhar.Unit)
			end
		elseif not humanoid.AutoRotate then
			humanoid.AutoRotate = true
		end
	end)
end

return Controles
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000038">
          <Properties>
            <string name="Name">Estado</string>
            <ProtectedString name="Source"><![CDATA[-- Estado compartilhado entre as partes da interface do jogador.
-- Quem muda algo chama Estado.avisar("nome") e quem desenha escuta Estado.Mudou.

local Estado = {
	perfil = { ouro = 0, recorde = 0, melhorias = {}, classe = "cavaleiro", escolheuClasse = false },
	modo = "lobby", -- "lobby" ou "partida"
	stats = nil, -- atributos da partida (vêm do servidor)
	cartas = {},
	aliados = {},
	ouroPartida = 0,
	carga = 0,
	cargaMax = 100,
	mana = 0, -- só o Mago usa
	manaMax = 0,
	habilidadeFim = 0,
	habilidadeTotal = 1,
	esquivaFim = 0,
	esquivaTotal = 1,
	ataqueFim = 0, -- quando o próximo ataque fica liberado (cadência do golpe)
	ataqueTotal = 1,
	correndo = false,
	travaMira = false, -- mira travada no centro da tela (câmera no ombro)
	caido = false,
	morto = false,
	sala = nil,
	menusAbertos = 0,
}

local evento = Instance.new("BindableEvent")
Estado.Mudou = evento.Event

function Estado.avisar(chave: string)
	evento:Fire(chave)
end

return Estado
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000039">
          <Properties>
            <string name="Name">Hud</string>
            <ProtectedString name="Source"><![CDATA[-- HUD: tudo o que fica na tela durante o jogo (lobby e masmorra).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local Cartas = require(Shared:WaitForChild("Cartas"))
local Teclas = require(Shared:WaitForChild("Teclas"))

local modulos = script.Parent
local UI = require(modulos.UI)
local Estado = require(modulos.Estado)
local Vfx = require(modulos.Vfx)
local Atalhos = require(modulos.Atalhos)
local Sons = require(modulos.Sons)

local Hud = {}
Hud.aoAbrir = nil :: ((string) -> ())?
Hud.botoesToque = {}

local jogador = Players.LocalPlayer
local criar, animar, cores, fontes = UI.criar, UI.animar, UI.cores, UI.fontes
local celular = UI.ehCelular()

local gui = criar("ScreenGui", {
	Name = "Hud",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 1,
	Parent = jogador:WaitForChild("PlayerGui"),
})
local topo = criar("ScreenGui", {
	Name = "HudTopo",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 30,
	Parent = jogador:WaitForChild("PlayerGui"),
})

local function camada(nome: string, pai: Instance): Frame
	return criar("Frame", { Name = nome, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = pai })
end

-- versão do jogo no canto de baixo (ReplicatedStorage > Versao, gravada pelo build.py):
-- serve para conferir se o jogo publicado está na mesma versão do Studio
task.spawn(function()
	local valor = game:GetService("ReplicatedStorage"):WaitForChild("Versao", 15)
	UI.texto({
		Name = "Versao",
		Text = if valor and valor:IsA("StringValue") then valor.Value else "versão ?",
		TextScaled = false,
		TextSize = 13,
		FontFace = fontes.texto,
		TextColor3 = Color3.fromRGB(235, 225, 205),
		TextTransparency = 0.35,
		TextStrokeTransparency = 0.6,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -6),
		Size = UDim2.fromOffset(260, 16),
		ZIndex = 50,
		Parent = topo,
	})
end)

-- Maldição das Almas: a tela fica verde e aparece o aviso do que está bloqueado
do
	local Lighting = game:GetService("Lighting")
	local cor = Instance.new("ColorCorrectionEffect")
	cor.Name = "Maldicao"
	cor.TintColor = Color3.new(1, 1, 1)
	cor.Saturation = 0
	cor.Enabled = false
	cor.Parent = Lighting
	local aviso = UI.texto({
		Name = "AvisoMaldicao",
		Text = "☠ AMALDIÇOADO: sem dash, corrida e habilidades",
		TextColor3 = Color3.fromRGB(150, 255, 160),
		TextStrokeTransparency = 0.3,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.fromScale(0.5, 0.04),
		Visible = false,
		ZIndex = 40,
		Parent = topo,
	})
	local function atualizar()
		local ativo = jogador:GetAttribute("Amaldicoado") == true
		aviso.Visible = ativo
		if ativo then
			cor.Enabled = true
			animar(cor, 0.35, { TintColor = Color3.fromRGB(150, 255, 165), Saturation = -0.35, Contrast = 0.12 })
		else
			animar(cor, 0.6, { TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0 })
			task.delay(0.65, function()
				if jogador:GetAttribute("Amaldicoado") ~= true then
					cor.Enabled = false
				end
			end)
		end
	end
	jogador:GetAttributeChangedSignal("Amaldicoado"):Connect(atualizar)
end

local telaLobby = camada("Lobby", gui)
local telaPartida = camada("Partida", gui)
telaPartida.Visible = false

------------------------------------------------------------------------
-- Componentes pequenos
------------------------------------------------------------------------

-- "Ficha": painel pequeno com ícone e um número (ouro, recorde)
local function ficha(pai: Instance, icone: string, posicao: UDim2, largura: number)
	local painel = UI.painel({
		AnchorPoint = Vector2.new(1, 0),
		Position = posicao,
		Size = UDim2.fromOffset(largura, 34),
		Parent = pai,
		SemCantos = true,
		Transparencia = 0.12,
	})
	UI.escalavel(painel)
	UI.medalhao({ Parent = painel, Icone = icone, Position = UDim2.fromOffset(3, 2), Size = UDim2.fromOffset(30, 30), Cor = cores.painelClaro })
	local texto = UI.texto({
		Position = UDim2.fromOffset(40, 6),
		Size = UDim2.new(1, -48, 0, 22),
		FontFace = fontes.numero,
		Text = "0",
		TextColor3 = cores.ouroClaro,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = painel,
	})
	UI.contorno(texto, 1.5)
	return painel, texto
end

local function formatarNumero(n: number): string
	local texto = tostring(math.floor(n))
	local resultado = texto:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if resultado:sub(1, 1) == "." then
		resultado = resultado:sub(2)
	end
	return resultado
end

------------------------------------------------------------------------
-- Lobby
------------------------------------------------------------------------

------------------------------------------------------------------------
-- Quadro do jogador (estilo RPG, como no Warcraft): retrato redondo com aro dourado e o selo da
-- classe, e as barras empilhadas ao lado (vida, supremo e mana), com um enfeite dourado embaixo.
-- Fica no canto de cima, no lobby e na partida (no lobby só a vida aparece).
------------------------------------------------------------------------

local VERMELHO_VIDA = Color3.fromRGB(214, 44, 36)
local ROXO_SUPREMO = Color3.fromRGB(150, 78, 214)
local AZUL_MANA = Color3.fromRGB(62, 96, 232)
local OURO_ESCURO = Color3.fromRGB(150, 118, 60)
local FUNDO_BARRA = Color3.fromRGB(22, 18, 26)

local quadroJogador = criar("Frame", {
	Name = "QuadroJogador",
	Position = UDim2.fromOffset(14, 58),
	Size = UDim2.fromOffset(300, 96),
	BackgroundTransparency = 1,
	Parent = gui,
})
UI.escalavel(quadroJogador)

-- barras escalonadas (cada uma um pouco mais curta), começando por baixo do aro do retrato
local function barraDoQuadro(y: number, largura: number, altura: number, cor: Color3)
	local barra = UI.barra({
		Parent = quadroJogador,
		Position = UDim2.fromOffset(74, y),
		Size = UDim2.fromOffset(largura, altura),
		Cor = cor,
		CorClara = cor:Lerp(cores.branco, 0.3),
		Fundo = FUNDO_BARRA,
		Borda = OURO_ESCURO,
		EspessuraBorda = 1.5,
		Raio = 3,
	})
	barra.quadro.ZIndex = 1
	return barra
end
local barraVida = barraDoQuadro(24, 222, 20, VERMELHO_VIDA)
local barraSupremo = barraDoQuadro(47, 206, 10, ROXO_SUPREMO)
barraSupremo.rotulo.Visible = false
barraSupremo.definir(0)
barraSupremo.quadro.Visible = false -- (só na partida)
local barraMana = barraDoQuadro(60, 192, 10, AZUL_MANA)
barraMana.rotulo.Visible = false
barraMana.quadro.Visible = false

-- enfeite dourado embaixo das barras (linha que some para a direita, com losangos)
local enfeite = criar("Frame", {
	Position = UDim2.fromOffset(84, 77),
	Size = UDim2.fromOffset(196, 2),
	BackgroundColor3 = cores.ouro,
	BorderSizePixel = 0,
	Parent = quadroJogador,
})
criar("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = enfeite })
UI.losango(quadroJogador, UDim2.fromOffset(84, 78), 9)
UI.losango(quadroJogador, UDim2.fromOffset(98, 78), 5)
UI.losango(quadroJogador, UDim2.fromOffset(108, 78), 4)

local nomeQuadro = UI.texto({
	Position = UDim2.fromOffset(92, 3),
	Size = UDim2.fromOffset(124, 18),
	FontFace = fontes.cabecalho,
	Text = jogador.DisplayName,
	TextColor3 = cores.ouroClaro,
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = quadroJogador,
})
UI.contorno(nomeQuadro, 1.5)
local classeQuadro = UI.texto({
	Position = UDim2.fromOffset(216, 5),
	Size = UDim2.fromOffset(80, 15),
	FontFace = fontes.forte,
	Text = "",
	TextXAlignment = Enum.TextXAlignment.Right,
	Parent = quadroJogador,
})
UI.contorno(classeQuadro, 1.5)

-- retrato: aro dourado grosso (por cima do começo das barras), foto e o selo da classe
local aroRetrato = criar("Frame", {
	Position = UDim2.fromOffset(0, 4),
	Size = UDim2.fromOffset(86, 86),
	BackgroundColor3 = cores.branco,
	ZIndex = 5,
	Parent = quadroJogador,
})
UI.redondo(aroRetrato)
UI.gradiente(aroRetrato, Color3.fromRGB(255, 234, 166), Color3.fromRGB(168, 118, 46), 45)
UI.borda(aroRetrato, Color3.fromRGB(58, 38, 12), 1.5)
local fotoQuadro = criar("ImageLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(74, 74),
	BackgroundColor3 = Color3.fromRGB(28, 24, 34),
	Image = UI.fotoJogador(jogador.UserId),
	Parent = aroRetrato,
})
UI.redondo(fotoQuadro)
UI.borda(fotoQuadro, Color3.fromRGB(40, 28, 12), 2)
local seloClasse = UI.medalhao({
	Parent = aroRetrato,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.86, 0.86),
	Size = UDim2.fromOffset(30, 30),
	Icone = "🛡️",
	EspessuraBorda = 2,
})
local gradienteSelo = seloClasse:FindFirstChildOfClass("UIGradient")

local _, textoOuroLobby = ficha(telaLobby, "💰", UDim2.new(1, -16, 0, 60), 150)
local _, textoRecorde = ficha(telaLobby, "🏆", UDim2.new(1, -16, 0, 100), 150)

local doca = criar("Frame", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Size = UDim2.fromOffset(620, 44),
	BackgroundTransparency = 1,
	Parent = telaLobby,
})
UI.escalavel(doca)
criar("UIListLayout", {
	FillDirection = Enum.FillDirection.Horizontal,
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 10),
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = doca,
})
for ordem, info in { { "classe", "⚔️ CLASSE", "ouro" }, { "loja", "🛒 LOJA", "escuro" }, { "ajuda", "📜 COMO JOGAR", "escuro" }, { "teclas", "⚙️ TECLAS", "escuro" } } do
	local botao = UI.botao({ Parent = doca, Texto = info[2], Estilo = info[3], Size = UDim2.fromOffset(140, 42), LayoutOrder = ordem, TamanhoTexto = 19 })
	botao.Activated:Connect(function()
		if Hud.aoAbrir then
			Hud.aoAbrir(info[1])
		end
	end)
end

-- Fila do portal
local painelFila = UI.painel({
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 64),
	Size = UDim2.fromOffset(440, 158),
	Visible = false,
	Parent = telaLobby,
})
UI.escalavel(painelFila)
UI.titulo(painelFila, "A MASMORRA AGUARDA", 10, 380, 36)
local contagemFila = UI.texto({
	Position = UDim2.fromOffset(20, 64),
	Size = UDim2.fromOffset(90, 70),
	FontFace = fontes.numero,
	Text = "10",
	TextColor3 = Color3.fromRGB(210, 170, 255),
	Parent = painelFila,
})
UI.contorno(contagemFila, 2)
local vagas = {}
for i = 1, Config.MAX_JOGADORES_POR_PARTIDA do
	local vaga = criar("ImageLabel", {
		Position = UDim2.fromOffset(120 + (i - 1) * 74, 70),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = cores.fundo,
		BackgroundTransparency = 0.2,
		Image = "",
		Parent = painelFila,
	})
	UI.redondo(vaga)
	local aro = UI.borda(vaga, cores.bronze, 2)
	local icone = UI.texto({
