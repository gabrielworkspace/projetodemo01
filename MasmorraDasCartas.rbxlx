			ombroE = { 1.2, 0.3, -0.2 },
			cotoveloE = { 1.9 },
			pulsoE = { 0.3 },
			ombroD = { 1.1, -0.3, 0.25 },
			cotoveloD = { 1.8 },
		}),
	},
	-- Passo de sombra: dá o impulso agachando, dispara numa corrida baixa de ninja com os
	-- braços para trás e freia derrapando, com a mão esquerda quase no chão
	assassino = {
		duracao = 0.34,
		quadros = {
			{
				t = 0.035,
				pose = {
					raiz = A(-0.3, 0, 0, 0, -0.75, 0),
					cintura = A(-0.45),
					pescoco = A(0.5),
					ombroD = A(-0.4, 0, 0.4),
					ombroE = A(-0.4, 0, -0.4),
					cotoveloD = A(0.6),
					cotoveloE = A(0.6),
					quadrilD = A(1.2),
					joelhoD = A(-1.6),
					tornozeloD = A(0.5),
					quadrilE = A(0.2),
					joelhoE = A(-1.2),
					tornozeloE = A(0.6),
				},
			},
			{
				t = 0.08,
				suave = "forte",
				pose = {
					raiz = A(-0.65, 0, 0, 0, -0.55, 0),
					cintura = A(-0.3),
					pescoco = A(0.65),
					ombroD = A(-1.3, 0, 0.25),
					ombroE = A(-1.3, 0, -0.25),
					cotoveloD = A(0.1),
					cotoveloE = A(0.1),
					pulsoD = A(-1),
					pulsoE = A(-1),
					quadrilD = A(1.2),
					joelhoD = A(-1.5),
					tornozeloD = A(0.3),
					quadrilE = A(-0.6),
					joelhoE = A(-0.6),
					tornozeloE = A(0.2),
				},
			},
			{ t = 0.2, suave = "linear", pose = { raiz = A(-0.6, 0.08, 0, 0, -0.55, 0), quadrilD = A(-0.4), joelhoD = A(-0.8), quadrilE = A(1.1), joelhoE = A(-1.5) } },
			{
				t = 0.27,
				pose = {
					-- derrapa: corpo para trás, base larga, mão esquerda perto do chão
					raiz = A(0.05, 0.35, 0, 0, -0.8, 0.35),
					cintura = A(-0.35, -0.2),
					pescoco = A(0.35, 0.3),
					ombroE = A(1.1, 0, -0.5),
					cotoveloE = A(0.3),
					ombroD = A(0.5, 0, 0.6),
					cotoveloD = A(1.2),
					pulsoD = A(-0.3),
					pulsoE = A(-0.3),
					quadrilD = A(0.9, 0, 0.35),
					joelhoD = A(-1.4),
					quadrilE = A(-0.2, 0, -0.45),
					joelhoE = A(-0.5),
				},
			},
		},
	},
}

-- Levou dano: o tronco é jogado para trás e os braços abrem
Poses.ATINGIDO = {
	voltar = 0.3,
	quadros = {
		{
			t = 0.05,
			suave = "forte",
			pose = {
				cintura = A(0.35, 0.15),
				pescoco = A(0.3),
				raiz = A(0.1, 0, 0, 0, 0, 0.25),
				ombroD = A(0.1, 0, 0.5),
				ombroE = A(0.2, 0, -0.5),
			},
		},
	},
}

-- Escudo bloqueou um golpe: o escudo é empurrado para trás e inclina, o corpo escorrega
Poses.BLOQUEIO = {
	voltar = 0.3,
	quadros = {
		{
			t = 0.04,
			suave = "forte",
			pose = {
				ombroE = A(-0.54, 1.97, 1.51),
				cotoveloE = A(1.81, -1.63, 0.39),
				cintura = A(0.14, -0.15),
				pescoco = A(0, 0.6),
				raiz = A(0.05, -0.55, 0, 0, -0.36, 0.45),
			},
		},
	},
}

-- Defesa perfeita: empurrão com o escudo para a frente
Poses.BLOQUEIO_PERFEITO = {
	voltar = 0.42,
	quadros = {
		{
			t = 0.06,
			suave = "forte",
			pose = {
				ombroE = A(-0.74, 2.26, 1.47),
				cotoveloE = A(2.19, -1.59, 0.34),
				cintura = A(-0.3, -0.35),
				pescoco = A(0.25, 0.7),
				raiz = A(-0.12, -0.6, 0, 0, -0.4, -0.5),
			},
		},
		{ t = 0.16, pose = { raiz = A(-0.1, -0.58, 0, 0, -0.38, -0.45) } },
	},
}

------------------------------------------------------------------------
-- Interpolação
------------------------------------------------------------------------


-- Junta todas as juntas usadas e, se a animação tem "voltar", cria o quadro final que solta
-- todas elas (mesmos ângulos, peso 0: não desfaz giros)
local function preparar(definicao)
	if definicao.preparada then
		return
	end
	local lista, vistas, ultimo = {}, {}, {}
	for _, quadro in definicao.quadros do
		for junta, valor in quadro.pose do
			if not vistas[junta] then
				vistas[junta] = true
				table.insert(lista, junta)
			end
			ultimo[junta] = valor
		end
	end
	if definicao.voltar then
		local final = {}
		for junta, valor in ultimo do
			final[junta] = solto(valor)
		end
		table.insert(definicao.quadros, { t = definicao.voltar, pose = final })
		definicao.duracao = definicao.duracao or definicao.voltar + 0.02
	end
	definicao.juntas = lista
	definicao.preparada = true
end
Poses.preparar = preparar

--[[ Pose da animação no tempo "tau", partindo da pose "base" (onde o corpo estava).
	Juntas que estavam na base mas não são usadas aqui são soltas em 0,1s. ]]
function Poses.amostrar(definicao, tau: number, base)
	preparar(definicao)
	local quadros = definicao.quadros
	local indice = 0
	for k, quadro in quadros do
		if quadro.t <= tau then
			indice = k
		end
	end
	local pose = {}
	for _, junta in definicao.juntas do
		local inicio = base[junta] or SOLTO
		for k = indice, 1, -1 do
			local v = quadros[k].pose[junta]
			if v then
				inicio = v
				break
			end
		end
		-- próximo quadro que mexe nesta junta
		local proximo, t0 = nil, 0
		for k = indice + 1, #quadros do
			if quadros[k].pose[junta] then
				proximo = quadros[k]
				break
			end
		end
		if proximo then
			for k = indice, 1, -1 do
				if quadros[k].pose[junta] then
					t0 = quadros[k].t
					break
				end
			end
			local alfa = suavizar(proximo.suave, math.clamp((tau - t0) / math.max(proximo.t - t0, 0.001), 0, 1))
			pose[junta] = misturar(inicio, proximo.pose[junta], alfa)
		else
			pose[junta] = inicio
		end
	end
	for junta, valor in base do
		if pose[junta] == nil then
			pose[junta] = misturar(valor, solto(valor), math.clamp(tau / 0.1, 0, 1))
		end
	end
	return pose
end

return Poses
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000044">
          <Properties>
            <string name="Name">Sons</string>
            <ProtectedString name="Source"><![CDATA[-- Efeitos sonoros. Todos os sons ficam num arquivo só (sons/MasmorraSons.ogg, gerado por
-- ferramentas/gerar_sons.py); cada som é um trecho dele (SonsMapa.luau diz onde começa e
-- quanto dura). Depois de enviar o arquivo para o Roblox, cole o ID em Config.SONS_ID.
-- Também dá para usar um ID por som em Config.SONS_IDS (tem preferência).
--
-- Sons.tocar("espada", { pos = Vector3 })   -> som no mundo (mais baixo de longe)
-- Sons.tocar("clique")                      -> som da interface (sem posição)

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Mapa = require(script.Parent.SonsMapa)

local Sons = {}

-- volume base e quanto o tom varia a cada vez (para não soar repetido)
local AJUSTES = {
	espada = { 0.6, 0.08 },
	espadaPesada = { 0.75, 0.06 },
	adaga = { 0.5, 0.1 },
	impacto = { 0.5, 0.12 },
	critico = { 0.7, 0.05 },
	sangue = { 0.45, 0.12 },
	escudo = { 0.7, 0.05 },
	escudoPerfeito = { 0.85, 0 },
	giro = { 0.55, 0.03 },
	julgamento = { 0.95, 0 },
	arcoPuxar = { 0.35, 0.05 },
	arcoSoltar = { 0.85, 0.06 },
	flechaImpacto = { 0.5, 0.1 },
	chuvaFlechas = { 0.5, 0 },
	dardoArcano = { 0.5, 0.08 },
	lancaGelo = { 0.55, 0.06 },
	geloQuebra = { 0.5, 0.1 },
	bolaFogo = { 0.6, 0.06 },
	explosao = { 0.75, 0.08 },
	vazioExplode = { 0.85, 0 },
	meteoro = { 0.7, 0 },
	raio = { 0.55, 0.12 },
	tempestade = { 0.6, 0 },
	semMana = { 0.5, 0 },
	passoSombrio = { 0.65, 0.05 },
	investida = { 0.7, 0.05 },
	carregar = { 0.45, 0 },
	cargaCheia = { 0.6, 0 },
	esquiva = { 0.5, 0.1 },
	supremo = { 0.75, 0 },
	inimigoMorre = { 0.5, 0.12 },
	danoJogador = { 0.6, 0.08 },
	moeda = { 0.35, 0.1 },
	carta = { 0.5, 0.05 },
	clique = { 0.3, 0.03 },
	reviver = { 0.6, 0 },
	caiu = { 0.6, 0 },
	portal = { 0.55, 0 },
	pouso = { 0.7, 0.08 },
	vento = { 0.6, 0.05 },
	trovao = { 0.9, 0.04 },
	golpeEspada = { 0.75, 0.08 },
}

-- Sons que já vêm com o Roblox: tocam mesmo antes de enviar o arquivo de sons
local SEM_ARQUIVO = {
	explosao = "rbxasset://sounds/impact_explosion_03.mp3",
	vazioExplode = "rbxasset://sounds/impact_explosion_03.mp3",
	julgamento = "rbxasset://sounds/impact_explosion_03.mp3",
	pouso = "rbxasset://sounds/action_jump_land.mp3", -- fim do rolamento do Cavaleiro
	vento = "rbxasset://sounds/action_falling.ogg", -- vento do tornado
	trovao = "rbxassetid://4299587602", -- estrondo de raio (veio no pacote de VFX): supremo do Cavaleiro
}

local grupo = Instance.new("SoundGroup")
grupo.Name = "Efeitos"
grupo.Volume = 1
grupo.Parent = SoundService

local terreno = workspace.Terrain
local ultimaVez = {} -- [nome] = quando tocou (evita o mesmo som 20 vezes no mesmo quadro)
local tocando = 0
local MAXIMO_JUNTOS = 28

local function idValido(id: any): boolean
	return type(id) == "string" and string.match(id, "%d+") ~= nil and not string.match(id, "^rbxassetid://0+$")
end

-- ID e trecho (início, duração) de um som; nil se não houver como tocar
local function origem(nome: string): (string?, { number }?)
	local individual = Config.SONS_IDS and Config.SONS_IDS[nome]
	if idValido(individual) then
		return individual, nil
	end
	if idValido(Config.SONS_ID) and Mapa[nome] then
		return Config.SONS_ID, Mapa[nome]
	end
	return SEM_ARQUIVO[nome], nil
end

--[[ opcoes: pos (Vector3: som no mundo), pai (Instance: segue a peça), volume (multiplica),
	tom (multiplica a velocidade/altura), alcance (distância em que some, padrão 140),
	duracao (repete o som por esse tempo e some devagar no fim)
	Devolve o Sound (para parar antes, se precisar). ]]
function Sons.tocar(nome: string, opcoes): Sound?
	opcoes = opcoes or {}
	local id, trecho = origem(nome)
	if not id then
		return nil
	end
	local agora = os.clock()
	if agora - (ultimaVez[nome] or 0) < 0.04 or tocando >= MAXIMO_JUNTOS then
		return nil
	end
	ultimaVez[nome] = agora

	local ajuste = AJUSTES[nome] or { 0.5, 0 }
	local som = Instance.new("Sound")
	som.Name = nome
	som.SoundId = id
	som.Volume = ajuste[1] * (opcoes.volume or 1)
	som.PlaybackSpeed = (opcoes.tom or 1) * (1 + (math.random() * 2 - 1) * ajuste[2])
	som.SoundGroup = grupo
	if trecho then
		som.PlaybackRegionsEnabled = true
		som.PlaybackRegion = NumberRange.new(trecho[1], trecho[1] + trecho[2])
	end

	local remover: Instance = som
	if opcoes.pos then
		local ponto = Instance.new("Attachment")
		ponto.WorldPosition = opcoes.pos
		ponto.Parent = terreno
		som.Parent = ponto
		remover = ponto
	elseif opcoes.pai then
		som.Parent = opcoes.pai
	else
		som.Parent = SoundService
	end
	if opcoes.pos or opcoes.pai then
		som.RollOffMode = Enum.RollOffMode.InverseTapered
		som.RollOffMinDistance = 14
		som.RollOffMaxDistance = opcoes.alcance or 140
	end

	local duracao = (if trecho then trecho[2] else 5) / som.PlaybackSpeed + 0.3
	if opcoes.duracao then
		-- som contínuo (vento): repete e some devagar no fim
		som.Looped = true
		duracao = opcoes.duracao + 0.4
		task.delay(opcoes.duracao, function()
			if som.Parent then
				game:GetService("TweenService"):Create(som, TweenInfo.new(0.35), { Volume = 0 }):Play()
			end
		end)
	end
	som:Play()
	tocando += 1
	task.delay(duracao, function()
		tocando -= 1
	end)
	Debris:AddItem(remover, duracao)
	return som
end

-- Para um som antes do fim (ex.: o som de carregar quando o jogador solta)
function Sons.parar(som: Sound?)
	if som and som.Parent then
		som:Stop()
	end
end

function Sons.iniciar()
	if not idValido(Config.SONS_ID) and next(Config.SONS_IDS or {}) == nil then
		warn("[Sons] Os efeitos sonoros ainda não foram enviados para o Roblox. Envie sons/MasmorraSons.ogg e cole o ID em Config.SONS_ID (veja COMO_USAR.md).")
		return
	end
	-- carrega o arquivo antes de precisar dele (o primeiro golpe já sai com som)
	task.spawn(function()
		local previa = Instance.new("Sound")
		previa.SoundId = Config.SONS_ID
		pcall(function()
			ContentProvider:PreloadAsync({ previa })
		end)
		previa:Destroy()
	end)
end

return Sons
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000045">
          <Properties>
            <string name="Name">SonsMapa</string>
            <ProtectedString name="Source"><![CDATA[-- ARQUIVO GERADO por ferramentas/gerar_sons.py (não edite à mão: rode o script de novo).
-- Onde cada som começa e quanto dura dentro de sons/MasmorraSons.ogg (em segundos).

return {
	espada = { 0.0000, 0.3200 },
	espadaPesada = { 0.5700, 0.4500 },
	adaga = { 1.2700, 0.1800 },
	impacto = { 1.7000, 0.2200 },
	critico = { 2.1700, 0.5000 },
	sangue = { 2.9200, 0.2200 },
	escudo = { 3.3900, 1.1000 },
	escudoPerfeito = { 4.7400, 1.8000 },
	giro = { 6.7899, 2.0000 },
	julgamento = { 9.0399, 3.3000 },
	arcoPuxar = { 12.5899, 0.3000 },
	arcoSoltar = { 13.1399, 0.4500 },
	flechaImpacto = { 13.8399, 0.1800 },
	chuvaFlechas = { 14.2699, 2.8000 },
	dardoArcano = { 17.3199, 0.3500 },
	lancaGelo = { 17.9199, 0.4500 },
	geloQuebra = { 18.6199, 0.5000 },
	bolaFogo = { 19.3699, 0.7000 },
	explosao = { 20.3198, 2.0000 },
	vazioExplode = { 22.5698, 2.2800 },
	meteoro = { 25.0998, 0.9000 },
	raio = { 26.2498, 1.4000 },
	tempestade = { 27.8997, 3.0000 },
	semMana = { 31.1497, 0.3500 },
	passoSombrio = { 31.7497, 1.0000 },
	investida = { 32.9997, 0.3000 },
	carregar = { 33.5497, 1.1000 },
	cargaCheia = { 34.8997, 1.2000 },
	esquiva = { 36.3497, 0.2500 },
	supremo = { 36.8497, 1.7000 },
	inimigoMorre = { 38.7996, 0.4500 },
	danoJogador = { 39.4996, 0.2500 },
	moeda = { 39.9996, 0.3500 },
	carta = { 40.5996, 0.2000 },
	clique = { 41.0496, 0.0600 },
	reviver = { 41.3596, 1.4700 },
	caiu = { 43.0796, 1.4000 },
	portal = { 44.7295, 1.5000 },
}
]]></ProtectedString>
