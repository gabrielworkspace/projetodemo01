		voltar = 0.62,
		quadros = {
			{
				t = 0.15,
				pose = {
					ombroD = A(1.77, -0.01, -0.17),
					ombroE = A(3, 0, -0.2),
					cotoveloD = A(0),
					cotoveloE = A(0.2),
					pulsoD = A(-1.7),
					cintura = A(0.35),
					pescoco = A(-0.5),
					raiz = A(0.05, 0, 0, 0, 0.1, 0),
					brilho = A(1.2),
				},
