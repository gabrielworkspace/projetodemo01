		-- Revés: torce para a esquerda com a espada sobre o ombro esquerdo e corta de volta
		-- para a direita, com o passo do pé direito
		ataque2 = {
			voltar = 0.44,
			trilha = { 0.06, 0.25 },
			quadros = {
				{
					t = 0.07,
