function Modelos.diabrete()
	local vermelho = C(196, 52, 44)
	local roxo = C(110, 40, 84)
	local ossos = {
		corpo = osso("raiz", V(0, 1.9, 0)),
		cabeca = osso("corpo", V(0, 3, 0)),
		bracoE = osso("corpo", V(-0.75, 2.8, 0)),
		bracoD = osso("corpo", V(0.75, 2.8, 0)),
		pernaE = osso("raiz", V(-0.3, 1.9, 0)),
		pernaD = osso("raiz", V(0.3, 1.9, 0)),
		asaE = osso("corpo", V(-0.4, 2.9, 0.4), { lado = -1 }),
		asaD = osso("corpo", V(0.4, 2.9, 0.4), { lado = 1 }),
		cauda = osso("corpo", V(0, 2, 0.4)),
	}
	local p = {
		P("corpo", "elipse", V(1.2, 1.3, 1), V(0, 2.5, 0), vermelho),
		P("corpo", "elipse", V(0.8, 0.8, 0.4), V(0, 2.45, -0.35), C(230, 120, 90)),
		P("cabeca", "elipse", V(1.25, 1.1, 1.1), V(0, 3.4, 0), vermelho),
		P("cabeca", "canto", V(0.25, 0.85, 0.3), V(-0.42, 4.05, 0.1), C(40, 30, 30), { rot = R(-10, 0, 15) }),
		P("cabeca", "canto", V(0.25, 0.85, 0.3), V(0.42, 4.05, 0.1), C(40, 30, 30), { rot = R(-10, 90, -15) }),
		P("cabeca", "bloco", V(0.28, 0.16, 0.1), V(-0.27, 3.55, -0.55), C(255, 230, 60), { neon = true, rot = R(0, 0, -15), olho = true }),
		P("cabeca", "bloco", V(0.28, 0.16, 0.1), V(0.27, 3.55, -0.55), C(255, 230, 60), { neon = true, rot = R(0, 0, 15), olho = true }),
		P("cabeca", "bloco", V(0.62, 0.1, 0.1), V(0, 3.15, -0.54), ESCURO),
		P("asaE", "bloco", V(1.6, 1.3, 0.08), V(-1.15, 3.1, 0.55), roxo, { mat = TECIDO, rot = R(0, 20, 10) }),
		P("asaD", "bloco", V(1.6, 1.3, 0.08), V(1.15, 3.1, 0.55), roxo, { mat = TECIDO, rot = R(0, -20, -10) }),
		S("cauda", V(0, 2, 0.4), V(0, 1.4, 1.4), 0.16, vermelho),
		P("cauda", "canto", V(0.4, 0.4, 0.15), V(0, 1.35, 1.5), ESCURO),
		P("bracoD", "bola", V(0.7, 0.7, 0.7), V(0.85, 1.95, -0.3), C(255, 140, 40), { neon = true }),
	}
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		local perna = if lado < 0 then "pernaE" else "pernaD"
		juntar(p, {
			P(braco, "elipse", V(0.35, 1.1, 0.35), V(lado * 0.82, 2.35, 0), vermelho),
			P(perna, "elipse", V(0.42, 1, 0.42), V(lado * 0.3, 1.35, 0), vermelho:Lerp(ESCURO, 0.2)),
			P(perna, "elipse", V(0.36, 0.9, 0.36), V(lado * 0.3, 0.5, 0.15), vermelho:Lerp(ESCURO, 0.35)),
		})
	end
	return {
		estilo = "bipede",
		ossos = ossos,
		pecas = p,
		luzes = { { osso = "bracoD", pos = V(0.85, 1.95, -0.3), cor = C(255, 140, 40), alcance = 10, brilho = 1.5 } },
		efeitos = { { osso = "bracoD", pos = V(0.85, 1.95, -0.3), tipo = "chama", cor = C(255, 140, 40) } },
		cor = vermelho,
		ritmo = 1.4,
	}
end

local function elemental(corFogo: Color3, corNucleo: Color3)
	local rocha = C(46, 34, 32)
	local ossos = {
		corpo = osso("raiz", V(0, 3, 0)),
		cabeca = osso("corpo", V(0, 4.8, 0)),
		bracoE = osso("corpo", V(-1.4, 4.4, 0)),
		bracoD = osso("corpo", V(1.4, 4.4, 0)),
		base = osso("raiz", V(0, 1.5, 0)),
	}
	local p = {
		P("corpo", "elipse", V(2.1, 2.3, 1.6), V(0, 3.8, 0), corFogo, { neon = true, transp = 0.1 }),
		P("corpo", "elipse", V(1.2, 1.4, 1), V(0, 3.8, -0.15), corNucleo, { neon = true }),
		P("corpo", "bloco", V(1, 0.9, 0.5), V(-0.65, 4.3, -0.6), rocha, { rot = R(10, 20, 15), mat = PEDRA }),
		P("corpo", "bloco", V(1, 0.9, 0.5), V(0.65, 4.3, -0.6), rocha, { rot = R(10, -20, -15), mat = PEDRA }),
		P("cabeca", "elipse", V(1.25, 1.45, 1.2), V(0, 5.15, 0), corFogo, { neon = true }),
		P("cabeca", "bloco", V(0.3, 0.16, 0.1), V(-0.25, 5.25, -0.58), C(255, 255, 220), { neon = true, olho = true }),
		P("cabeca", "bloco", V(0.3, 0.16, 0.1), V(0.25, 5.25, -0.58), C(255, 255, 220), { neon = true, olho = true }),
		P("cabeca", "canto", V(0.4, 1.1, 0.4), V(0, 6.05, 0), corNucleo, { neon = true }),
		P("base", "elipse", V(1.7, 1, 1.7), V(0, 2.3, 0), corFogo, { neon = true, transp = 0.2 }),
		P("base", "elipse", V(1.15, 1, 1.15), V(0.15, 1.5, 0), corFogo:Lerp(corNucleo, 0.3), { neon = true, transp = 0.25 }),
		P("base", "elipse", V(0.6, 1, 0.6), V(-0.1, 0.75, 0.1), corNucleo, { neon = true, transp = 0.3 }),
	}
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		juntar(p, {
			P(braco, "elipse", V(0.75, 1.9, 0.75), V(lado * 1.5, 3.6, 0), corFogo, { neon = true, transp = 0.1 }),
			P(braco, "bloco", V(0.95, 0.7, 0.95), V(lado * 1.5, 3.1, 0), rocha, { mat = PEDRA }),
			P(braco, "elipse", V(0.95, 0.95, 0.95), V(lado * 1.5, 2.55, 0), corNucleo, { neon = true }),
		})
	end
	return {
		estilo = "flutuante",
		ossos = ossos,
		pecas = p,
		luzes = { { osso = "corpo", pos = V(0, 3.8, 0), cor = corFogo, alcance = 16, brilho = 2 } },
		efeitos = { { osso = "corpo", pos = V(0, 4, 0), tipo = "fogo", cor = corFogo } },
		cor = corFogo,
		girarBase = true,
	}
end

function Modelos.elementalFogo()
	return elemental(C(255, 120, 40), C(255, 220, 120))
end

function Modelos.senhorChamas()
	local m = elemental(C(255, 96, 30), C(255, 214, 110))
	m.escala = 2.3
	local rocha = C(40, 28, 26)
	local lava = C(255, 120, 40)
	juntar(m.pecas, {
		P("cabeca", "canto", V(0.45, 1.6, 0.6), V(-0.75, 5.9, 0.1), rocha, { rot = R(-15, 0, 25), mat = PEDRA }),
		P("cabeca", "canto", V(0.45, 1.6, 0.6), V(0.75, 5.9, 0.1), rocha, { rot = R(-15, 90, -25), mat = PEDRA }),
		P("cabeca", "elipse", V(1, 1, 0.6), V(0, 4.55, -0.45), C(255, 200, 80), { neon = true }),
		P("corpo", "bloco", V(2.4, 0.6, 1.4), V(0, 4.85, 0), rocha, { mat = PEDRA }),
		-- martelo gigante
		P("bracoD", "cilindro", V(4.4, 0.35, 0.35), V(1.5, 2.6, -1.2), C(70, 52, 40), { rot = R(0, 90, 0), mat = MADEIRA }),
		P("bracoD", "bloco", V(2.6, 1.6, 1.6), V(1.5, 2.6, -3.4), rocha, { mat = PEDRA }),
		P("bracoD", "bloco", V(2.7, 0.3, 1.7), V(1.5, 2.6, -3.4), lava, { neon = true }),
	})
	m.luzes[1].alcance = 30
	return m
end

function Modelos.ogro()
	local pele = C(140, 152, 96)
	local escura = C(104, 116, 72)
	local couro = C(96, 64, 40)
	local ossos = {
		corpo = osso("raiz", V(0, 4.8, 0)),
		cabeca = osso("corpo", V(0, 8.6, -0.4)),
		bracoE = osso("corpo", V(-2.6, 7.6, 0)),
		bracoD = osso("corpo", V(2.6, 7.6, 0)),
		pernaE = osso("raiz", V(-1.1, 4.8, 0)),
		pernaD = osso("raiz", V(1.1, 4.8, 0)),
	}
	local p = {
		P("corpo", "elipse", V(4.2, 3.8, 3.6), V(0, 5.6, -0.2), pele),
		P("corpo", "elipse", V(4.6, 2.6, 3), V(0, 7.3, 0), pele),
		P("corpo", "bloco", V(0.4, 0.25, 5.2), V(0, 6.4, -0.3), couro, { rot = R(0, 90, 35), mat = TECIDO }),
		P("corpo", "bloco", V(3.8, 1.5, 3.4), V(0, 4.6, 0), couro, { mat = TECIDO }),
		P("corpo", "bloco", V(3.9, 0.45, 3.5), V(0, 5.3, 0), C(60, 40, 26), { mat = TECIDO }),
		P("cabeca", "elipse", V(2, 1.8, 1.9), V(0, 8.95, -0.6), pele),
		P("cabeca", "elipse", V(1.8, 0.85, 1.6), V(0, 8.3, -0.9), escura),
		P("cabeca", "canto", V(0.3, 0.75, 0.3), V(-0.55, 8.8, -1.6), C(240, 232, 210)),
		P("cabeca", "canto", V(0.3, 0.75, 0.3), V(0.55, 8.8, -1.6), C(240, 232, 210), { rot = R(0, 90, 0) }),
		P("cabeca", "bola", V(0.28, 0.28, 0.28), V(-0.4, 9.2, -1.42), C(255, 220, 60), { neon = true, olho = true }),
		P("cabeca", "bola", V(0.28, 0.28, 0.28), V(0.4, 9.2, -1.42), C(255, 220, 60), { neon = true, olho = true }),
		P("cabeca", "bloco", V(0.35, 0.9, 1.7), V(0, 9.95, -0.45), C(40, 30, 30)),
	}
	for _, lado in { -1, 1 } do
		local braco = if lado < 0 then "bracoE" else "bracoD"
		local perna = if lado < 0 then "pernaE" else "pernaD"
		juntar(p, {
			P(braco, "elipse", V(1.9, 1.7, 1.9), V(lado * 2.5, 7.8, 0), pele),
			P(braco, "elipse", V(1.3, 2.6, 1.3), V(lado * 2.7, 6.3, 0), pele),
			P(braco, "elipse", V(1.2, 2.2, 1.2), V(lado * 2.8, 4.6, -0.2), escura),
			P(braco, "bola", V(1.35, 1.35, 1.35), V(lado * 2.8, 3.3, -0.3), escura),
			P(braco, "cilindro", V(0.7, 1.3, 1.3), V(lado * 2.8, 4.1, -0.2), couro, { rot = EM_PE, mat = TECIDO }),
			P(perna, "elipse", V(1.5, 2.6, 1.5), V(lado * 1.1, 3.4, 0), pele),
			P(perna, "elipse", V(1.3, 2.2, 1.3), V(lado * 1.1, 1.4, 0), escura),
			P(perna, "elipse", V(1.4, 0.7, 2), V(lado * 1.1, 0.35, -0.3), escura),
		})
	end
	-- clava cravejada
	juntar(p, {
		P("bracoD", "elipse", V(1.1, 1.1, 4.8), V(2.8, 3.3, -2.6), C(110, 76, 46), { mat = MADEIRA }),
		P("bracoD", "canto", V(0.3, 0.6, 0.3), V(2.8, 3.95, -3.6), C(150, 150, 156), { mat = METAL }),
		P("bracoD", "canto", V(0.3, 0.6, 0.3), V(3.4, 3.4, -4.2), C(150, 150, 156), { mat = METAL, rot = R(0, 0, -90) }),
		P("bracoD", "canto", V(0.3, 0.6, 0.3), V(2.2, 3.4, -4.4), C(150, 150, 156), { mat = METAL, rot = R(0, 0, 90) }),
	})
	return { estilo = "bipede", ossos = ossos, pecas = p, luzes = {}, efeitos = {}, cor = pele, ritmo = 0.7 }
end

-- Modelo genérico caso surja um tipo sem aparência própria
function Modelos.padrao()
	return gosma(C(200, 200, 200))
end

return Modelos
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000033">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source"><![CDATA[-- Kit visual da interface: cores, fontes e componentes (painéis, botões, barras, medalhões).
-- Estilo "fantasia sombria": painéis escuros, bordas douradas duplas e losangos nos cantos.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local UI = {}

UI.cores = {
	fundo = Color3.fromRGB(12, 10, 18),
	painel = Color3.fromRGB(24, 20, 34),
	painelClaro = Color3.fromRGB(44, 37, 60),
	bronze = Color3.fromRGB(128, 100, 62),
	ouro = Color3.fromRGB(236, 192, 96),
	ouroClaro = Color3.fromRGB(255, 228, 160),
	texto = Color3.fromRGB(246, 238, 222),
	textoSuave = Color3.fromRGB(184, 174, 160),
	vida = Color3.fromRGB(206, 40, 52),
	vidaClara = Color3.fromRGB(255, 108, 98),
	perigo = Color3.fromRGB(224, 64, 64),
	sucesso = Color3.fromRGB(86, 204, 112),
	mana = Color3.fromRGB(86, 156, 255),
	preto = Color3.new(0, 0, 0),
	branco = Color3.new(1, 1, 1),
}

local function fonte(nome: Enum.Font, peso: Enum.FontWeight): Font
	return Font.new(Font.fromEnum(nome).Family, peso)
end

UI.fontes = {
	titulo = fonte(Enum.Font.GrenzeGotisch, Enum.FontWeight.Bold),
	cabecalho = fonte(Enum.Font.Merriweather, Enum.FontWeight.Bold),
	texto = fonte(Enum.Font.BuilderSans, Enum.FontWeight.Medium),
	forte = fonte(Enum.Font.BuilderSans, Enum.FontWeight.Bold),
	numero = fonte(Enum.Font.BuilderSans, Enum.FontWeight.ExtraBold),
}

------------------------------------------------------------------------
-- Básico
------------------------------------------------------------------------

function UI.criar(classe: string, propriedades): any
	local objeto = Instance.new(classe)
	for chave, valor in propriedades do
		if chave ~= "Parent" then
			(objeto :: any)[chave] = valor
		end
	end
	objeto.Parent = propriedades.Parent
	return objeto
end
local criar = UI.criar

function UI.animar(objeto: Instance, duracao: number, propriedades, estilo: Enum.EasingStyle?, direcao: Enum.EasingDirection?)
	local tween = TweenService:Create(objeto, TweenInfo.new(duracao, estilo or Enum.EasingStyle.Quad, direcao or Enum.EasingDirection.Out), propriedades)
	tween:Play()
	return tween
end
local animar = UI.animar

function UI.cantos(objeto: Instance, raio: number?)
	return criar("UICorner", { CornerRadius = UDim.new(0, raio or 10), Parent = objeto })
end

function UI.redondo(objeto: Instance)
	return criar("UICorner", { CornerRadius = UDim.new(1, 0), Parent = objeto })
end

function UI.borda(objeto: Instance, cor: Color3, espessura: number?, transparencia: number?): UIStroke
	return criar("UIStroke", {
		Color = cor,
		Thickness = espessura or 2,
		Transparency = transparencia or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = objeto,
	})
end

-- Contorno escuro no texto (fica legível em qualquer fundo)
function UI.contorno(objeto: Instance, espessura: number?, transparencia: number?): UIStroke
	return criar("UIStroke", {
		Color = UI.cores.preto,
		Thickness = espessura or 2,
		Transparency = transparencia or 0.25,
		Parent = objeto,
	})
end

function UI.gradiente(objeto: Instance, topo: Color3, base: Color3, rotacao: number?)
	return criar("UIGradient", { Color = ColorSequence.new(topo, base), Rotation = rotacao or 90, Parent = objeto })
end

function UI.texto(propriedades): TextLabel
	local final = {
		BackgroundTransparency = 1,
		FontFace = UI.fontes.forte,
		TextColor3 = UI.cores.texto,
		TextScaled = true,
	}
	for chave, valor in propriedades do
		final[chave] = valor
	end
	return criar("TextLabel", final)
end

function UI.limiteTexto(objeto: Instance, maximo: number)
	criar("UITextSizeConstraint", { MaxTextSize = maximo, Parent = objeto })
end

------------------------------------------------------------------------
-- Escala para caber em qualquer tela (o desenho é feito para ~1280x720)
------------------------------------------------------------------------

local escalas = {}
UI.escalaAtual = 1

function UI.atualizarEscala()
	local camera = workspace.CurrentCamera
	local tela = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	UI.escalaAtual = math.clamp(math.min(tela.X / 1280, tela.Y / 720), 0.55, 1.3)
	for objeto, base in escalas do
		if objeto.Parent then
			objeto.Scale = UI.escalaAtual * base
		else
			escalas[objeto] = nil
		end
	end
end

function UI.escalavel(objeto: Instance, fator: number?): UIScale
	local escala = criar("UIScale", { Scale = UI.escalaAtual * (fator or 1), Parent = objeto })
	escalas[escala] = fator or 1
	return escala
end

function UI.ehCelular(): boolean
	local UserInputService = game:GetService("UserInputService")
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

------------------------------------------------------------------------
-- Sons da interface (sons que já vêm com o Roblox; troque pelos seus IDs se quiser)
------------------------------------------------------------------------

UI.SONS = {
	clique = "rbxasset://sounds/electronicpingshort.wav",
}

function UI.tocar(id: string, volume: number?)
	local som = Instance.new("Sound")
	som.SoundId = id
	som.Volume = volume or 0.4
	som.Parent = SoundService
	som:Play()
	som.Ended:Once(function()
		som:Destroy()
	end)
	task.delay(4, function()
		if som.Parent then
			som:Destroy()
		end
	end)
end

------------------------------------------------------------------------
-- Componentes
------------------------------------------------------------------------

-- Losango dourado (usado nos cantos e nos separadores)
function UI.losango(pai: Instance, posicao: UDim2, tamanho: number, cor: Color3?)
	local l = criar("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = posicao,
		Size = UDim2.fromOffset(tamanho, tamanho),
		Rotation = 45,
		BackgroundColor3 = cor or UI.cores.ouro,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = pai,
	})
	UI.borda(l, UI.cores.preto, 1, 0.3)
	return l
end

-- Painel com borda dupla e losangos nos cantos
function UI.painel(propriedades): Frame
	local final = {
		BackgroundColor3 = UI.cores.branco,
		BorderSizePixel = 0,
	}
	for chave, valor in propriedades do
		if chave ~= "Transparencia" and chave ~= "SemCantos" and chave ~= "Cor" then
			final[chave] = valor
		end
	end
	final.BackgroundTransparency = propriedades.Transparencia or 0.04
	local painel = criar("Frame", final)
	UI.cantos(painel, 10)
	local corBase = propriedades.Cor or UI.cores.painel
	UI.gradiente(painel, corBase:Lerp(UI.cores.painelClaro, 0.55), corBase:Lerp(UI.cores.fundo, 0.4))
	UI.borda(painel, UI.cores.bronze, 2)
	local interna = criar("Frame", {
		Name = "BordaInterna",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(5, 5),
		Size = UDim2.new(1, -10, 1, -10),
		Parent = painel,
	})
	UI.cantos(interna, 7)
	UI.borda(interna, UI.cores.ouro, 1, 0.65)
	if not propriedades.SemCantos then
		for _, canto in { UDim2.fromScale(0, 0), UDim2.fromScale(1, 0), UDim2.fromScale(0, 1), UDim2.fromScale(1, 1) } do
			UI.losango(painel, canto, 10)
		end
	end
	return painel
end

-- Linha ornamental com losango no meio
function UI.separador(pai: Instance, posicao: UDim2, largura: number, cor: Color3?)
	local caixa = criar("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = posicao,
		Size = UDim2.fromOffset(largura, 12),
		BackgroundTransparency = 1,
		Parent = pai,
	})
	local corLinha = cor or UI.cores.ouro
	for _, lado in { 0, 1 } do
		local linha = criar("Frame", {
			AnchorPoint = Vector2.new(lado, 0.5),
			Position = UDim2.fromScale(lado, 0.5),
			Size = UDim2.new(0.5, -10, 0, 2),
			BackgroundColor3 = corLinha,
			BorderSizePixel = 0,
			Parent = caixa,
		})
		criar("UIGradient", {
			Transparency = NumberSequence.new(if lado == 0 then 1 else 0, if lado == 0 then 0 else 1),
			Parent = linha,
		})
	end
	UI.losango(caixa, UDim2.fromScale(0.5, 0.5), 8, corLinha)
	return caixa
end

-- Título grande com separador embaixo
function UI.titulo(pai: Instance, texto: string, y: number, largura: number, altura: number?, fonteTitulo: Font?)
	local rotulo = UI.texto({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, y),
		Size = UDim2.fromOffset(largura, altura or 44),
		FontFace = fonteTitulo or UI.fontes.titulo,
		Text = texto,
		TextColor3 = UI.cores.ouroClaro,
		Parent = pai,
	})
	UI.contorno(rotulo, 2)
	UI.separador(pai, UDim2.new(0.5, 0, 0, y + (altura or 44) + 6), math.min(largura, 360))
	return rotulo
end

local CORES_BOTAO = {
	ouro = { Color3.fromRGB(255, 220, 130), Color3.fromRGB(196, 136, 46), Color3.fromRGB(46, 28, 8) },
	escuro = { Color3.fromRGB(70, 60, 92), Color3.fromRGB(34, 28, 46), UI.cores.texto },
	perigo = { Color3.fromRGB(236, 96, 90), Color3.fromRGB(150, 32, 40), UI.cores.texto },
	verde = { Color3.fromRGB(130, 230, 140), Color3.fromRGB(44, 140, 70), UI.cores.texto },
	cinza = { Color3.fromRGB(110, 108, 116), Color3.fromRGB(64, 62, 70), Color3.fromRGB(200, 196, 190) },
}

--[[ Botão. propriedades: Texto, Estilo (ouro/escuro/perigo/verde), Position, Size, AnchorPoint, Parent, TamanhoTexto
	Devolve o TextButton; use botao.Activated. Para trocar o estilo: UI.estiloBotao(botao, "cinza") ]]
function UI.botao(propriedades): TextButton
	local b = criar("TextButton", {
		AnchorPoint = propriedades.AnchorPoint or Vector2.zero,
		Position = propriedades.Position or UDim2.new(),
		Size = propriedades.Size or UDim2.fromOffset(200, 50),
		BackgroundColor3 = UI.cores.branco,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = propriedades.LayoutOrder or 0,
		Parent = propriedades.Parent,
	})
	UI.cantos(b, 9)
	local gradiente = criar("UIGradient", { Rotation = 90, Parent = b })
	local contorno = UI.borda(b, UI.cores.preto, 2, 0.1)
	criar("Frame", {
		Name = "Brilho",
		BackgroundColor3 = UI.cores.branco,
		BackgroundTransparency = 0.75,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 6, 0, 3),
		Size = UDim2.new(1, -12, 0, 2),
		Parent = b,
	})
	local rotulo = UI.texto({
		Name = "Rotulo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(1, -16, 0.62, 0),
		FontFace = UI.fontes.numero,
		Text = propriedades.Texto or "",
		Parent = b,
	})
	if propriedades.TamanhoTexto then
		UI.limiteTexto(rotulo, propriedades.TamanhoTexto)
	end
	local escala = criar("UIScale", { Parent = b })

	b:SetAttribute("Estilo", propriedades.Estilo or "ouro")
	local function aplicarEstilo()
		local cores = CORES_BOTAO[b:GetAttribute("Estilo")] or CORES_BOTAO.ouro
		gradiente.Color = ColorSequence.new(cores[1], cores[2])
		rotulo.TextColor3 = cores[3]
		contorno.Color = cores[2]:Lerp(UI.cores.preto, 0.6)
	end
	aplicarEstilo()
	b:GetAttributeChangedSignal("Estilo"):Connect(aplicarEstilo)

	b.MouseEnter:Connect(function()
		animar(escala, 0.12, { Scale = 1.05 })
	end)
	b.MouseLeave:Connect(function()
		animar(escala, 0.12, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		animar(escala, 0.06, { Scale = 0.95 })
	end)
	b.MouseButton1Up:Connect(function()
		animar(escala, 0.1, { Scale = 1.03 })
	end)
	b.Activated:Connect(function()
		UI.tocar(UI.SONS.clique, 0.25)
	end)
	return b
end

function UI.estiloBotao(botao: TextButton, estilo: string)
	botao:SetAttribute("Estilo", estilo)
end

function UI.textoBotao(botao: TextButton, texto: string)
	local rotulo = botao:FindFirstChild("Rotulo") :: TextLabel?
	if rotulo then
		rotulo.Text = texto
	end
end

-- Medalhão redondo com um ícone (emoji) no meio
function UI.medalhao(propriedades): Frame
	local cor = propriedades.Cor or UI.cores.ouro
	local m = criar("Frame", {
		AnchorPoint = propriedades.AnchorPoint or Vector2.zero,
		Position = propriedades.Position or UDim2.new(),
		Size = propriedades.Size or UDim2.fromOffset(56, 56),
		BackgroundColor3 = UI.cores.branco,
		LayoutOrder = propriedades.LayoutOrder or 0,
		Parent = propriedades.Parent,
	})
	UI.redondo(m)
	UI.gradiente(m, cor:Lerp(UI.cores.branco, 0.15), cor:Lerp(UI.cores.fundo, 0.65))
	UI.borda(m, propriedades.Borda or UI.cores.ouro, propriedades.EspessuraBorda or 2)
	UI.texto({
		Name = "Icone",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.62, 0.62),
		Text = propriedades.Icone or "",
		Parent = m,
	})
	return m
end

--[[ Barra com rastro: o pedaço perdido some devagar (como nos jogos de luta).
	Devolve { quadro, definir(fracao, texto) } ]]
function UI.barra(propriedades)
	local quadro = criar("Frame", {
		AnchorPoint = propriedades.AnchorPoint or Vector2.zero,
		Position = propriedades.Position or UDim2.new(),
		Size = propriedades.Size or UDim2.fromOffset(300, 22),
		BackgroundColor3 = propriedades.Fundo or Color3.fromRGB(26, 14, 18),
		BorderSizePixel = 0,
		Parent = propriedades.Parent,
	})
	UI.cantos(quadro, propriedades.Raio or 6)
	UI.borda(quadro, UI.cores.preto, 2, 0.1)
	local rastro = criar("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = propriedades.CorRastro or Color3.fromRGB(255, 236, 200),
		BorderSizePixel = 0,
		Parent = quadro,
	})
	UI.cantos(rastro, propriedades.Raio or 6)
	local preenchimento = criar("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UI.cores.branco,
		BorderSizePixel = 0,
		Parent = quadro,
	})
	UI.cantos(preenchimento, propriedades.Raio or 6)
	local cor = propriedades.Cor or UI.cores.vida
	local gradiente = UI.gradiente(preenchimento, (propriedades.CorClara or cor:Lerp(UI.cores.branco, 0.35)), cor)
	criar("Frame", {
		BackgroundColor3 = UI.cores.branco,
		BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 3, 0, 2),
		Size = UDim2.new(1, -6, 0.22, 0),
		Parent = preenchimento,
	})
	local rotulo = UI.texto({
		Size = UDim2.fromScale(1, 1),
		FontFace = UI.fontes.numero,
		Text = "",
		ZIndex = 3,
		Parent = quadro,
	})
	UI.contorno(rotulo, 1.5)

	local atual = 1
	local objeto = { quadro = quadro, rotulo = rotulo, preenchimento = preenchimento }
	function objeto.definir(fracao: number, texto: string?)
		fracao = math.clamp(fracao, 0, 1)
		if math.abs(fracao - atual) > 0.0005 then
			animar(preenchimento, 0.12, { Size = UDim2.fromScale(fracao, 1) })
			if fracao < atual then
				task.delay(0.3, function()
					animar(rastro, 0.45, { Size = UDim2.fromScale(fracao, 1) })
				end)
			else
				rastro.Size = UDim2.fromScale(fracao, 1)
			end
			atual = fracao
		end
		if texto then
			rotulo.Text = texto
		end
	end
	function objeto.cor(nova: Color3)
		gradiente.Color = ColorSequence.new(nova:Lerp(UI.cores.branco, 0.35), nova)
	end
	return objeto
end

------------------------------------------------------------------------
-- Desfoque do fundo quando um menu está aberto
------------------------------------------------------------------------

local desfoque = Lighting:FindFirstChild("DesfoqueMenu") or criar("BlurEffect", { Name = "DesfoqueMenu", Size = 0, Parent = Lighting })
local menusAbertos = 0

function UI.desfocar(ligar: boolean)
	menusAbertos = math.max(0, menusAbertos + (if ligar then 1 else -1))
	animar(desfoque, 0.25, { Size = if menusAbertos > 0 then 14 else 0 })
end

-- Foto do jogador (rosto do avatar)
function UI.fotoJogador(userId: number): string
	return "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=150&h=150"
end

function UI.jogadorLocal(): Player
	return Players.LocalPlayer
end

return UI
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000034">
          <Properties>
            <string name="Name">Vfx</string>
            <ProtectedString name="Source"><![CDATA[-- Efeitos visuais desenhados no computador do jogador: cortes, projéteis, explosões,
-- avisos de ataque no chão, números de dano, moedas e tremor da câmera.
-- O servidor manda { t = "tipo", ... } e Vfx.receber chama a função certa.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent.UI)

local Vfx = {}
Vfx.extras = {} -- outros módulos podem registrar efeitos aqui (ex.: salto dos inimigos)
Vfx.aoDanoLocal = nil :: ((number) -> ())?
Vfx.aoJogadorAtingido = nil :: ((any) -> ())?

local jogador = Players.LocalPlayer
local terreno = workspace.Terrain
local pasta = Instance.new("Folder")
pasta.Name = "EfeitosLocais"
pasta.Parent = workspace

local EM_PE = CFrame.Angles(0, 0, math.rad(90))
local BRANCO = Color3.new(1, 1, 1)
local VERMELHO = Color3.fromRGB(255, 60, 50)
local FOGO = Color3.fromRGB(255, 130, 40)

------------------------------------------------------------------------
-- Ajudantes
------------------------------------------------------------------------

local function animar(objeto: Instance, duracao: number, propriedades, estilo: Enum.EasingStyle?, direcao: Enum.EasingDirection?)
	local tween = TweenService:Create(objeto, TweenInfo.new(duracao, estilo or Enum.EasingStyle.Quad, direcao or Enum.EasingDirection.Out), propriedades)
	tween:Play()
	return tween
end

local function parte(tamanho: Vector3, cframe: CFrame, cor: Color3, transparencia: number?, formato: Enum.PartType?, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = material or Enum.Material.Neon
	p.Shape = formato or Enum.PartType.Block
	p.Size = tamanho
	p.CFrame = cframe
	p.Color = cor
	p.Transparency = transparencia or 0
	p.Parent = pasta
	return p
end

local function sequencia(pontos): NumberSequence
	local chaves = {}
	for _, ponto in pontos do
		table.insert(chaves, NumberSequenceKeypoint.new(ponto[1], ponto[2]))
	end
	return NumberSequence.new(chaves)
end

local function ancora(posicao: Vector3): Attachment
	local a = Instance.new("Attachment")
	a.Position = posicao
	a.Parent = terreno
	return a
end

--[[ Explosão de partículas num ponto. opcoes: cor, cor2, quantidade, tamanho, velocidade,
	vida, espalhar, gravidade, arrasto ]]
local function particulas(posicao: Vector3, opcoes)
	local a = ancora(posicao)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(opcoes.cor or BRANCO, opcoes.cor2 or opcoes.cor or BRANCO)
	e.LightEmission = opcoes.luz or 1
	e.LightInfluence = 0
	e.Size = sequencia({ { 0, opcoes.tamanho or 0.5 }, { 1, 0 } })
	e.Transparency = sequencia({ { 0, 0 }, { 0.7, 0.2 }, { 1, 1 } })
	local vida = opcoes.vida or 0.5
	e.Lifetime = NumberRange.new(vida * 0.6, vida)
	local velocidade = opcoes.velocidade or 15
	e.Speed = NumberRange.new(velocidade * 0.5, velocidade)
	e.SpreadAngle = opcoes.espalhar or Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -(opcoes.gravidade or 0), 0)
	e.Drag = opcoes.arrasto or 3
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-200, 200)
	e.Rate = 0
	e.EmissionDirection = opcoes.direcao or Enum.NormalId.Top
	e.Parent = a
	e:Emit(opcoes.quantidade or 12)
	Debris:AddItem(a, vida + 0.2)
end

local function clarao(posicao: Vector3, cor: Color3, alcance: number, duracao: number, brilho: number?)
	local a = ancora(posicao)
	local l = Instance.new("PointLight")
	l.Color = cor
	l.Range = alcance
	l.Brightness = brilho or 4
	l.Parent = a
	animar(l, duracao, { Brightness = 0 })
	Debris:AddItem(a, duracao + 0.1)
end

-- Disco deitado no chão
local function disco(centro: Vector3, diametro: number, cor: Color3, transparencia: number, espessura: number?): Part
	return parte(Vector3.new(espessura or 0.15, diametro, diametro), CFrame.new(centro) * EM_PE, cor, transparencia, Enum.PartType.Cylinder)
end

-- Anel feito de segmentos (um círculo vazado)
local function anel(centro: Vector3, raio: number, cor: Color3, transparencia: number, segmentos: number?, largura: number?): { BasePart }
	local lista: { BasePart } = {}
	local n = segmentos or 24
	local comprimento = 2 * math.pi * raio / n * 1.05
	for i = 1, n do
		local angulo = i / n * math.pi * 2
		local pos = centro + Vector3.new(math.cos(angulo) * raio, 0, math.sin(angulo) * raio)
		local p = parte(Vector3.new(largura or 0.35, 0.16, comprimento), CFrame.lookAt(pos, centro) * CFrame.Angles(0, math.rad(90), 0), cor, transparencia)
		table.insert(lista, p)
	end
	return lista
end

local function sumir(partes: { BasePart }, duracao: number, depois: number?)
	task.delay(depois or 0, function()
		for _, p in partes do
			if p.Parent then
				animar(p, duracao, { Transparency = 1 })
				Debris:AddItem(p, duracao + 0.05)
			end
		end
	end)
end

local function raizDoJogador(player: any): BasePart?
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return nil
	end
	local personagem = player.Character
	return personagem and personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
end

------------------------------------------------------------------------
-- Tremor da câmera
------------------------------------------------------------------------

local tremorForca, tremorFim, tremorDuracao = 0, 0, 1

function Vfx.tremer(forca: number, duracao: number)
	local agora = os.clock()
	local restante = if agora < tremorFim then tremorForca * (tremorFim - agora) / tremorDuracao else 0
	if forca >= restante then
		tremorForca = forca
		tremorDuracao = duracao
		tremorFim = agora + duracao
	end
end

-- Tremor que enfraquece com a distância
function Vfx.tremerEm(posicao: Vector3, forca: number, duracao: number)
	local raiz = raizDoJogador(jogador)
	if not raiz then
		return
	end
	local distancia = (raiz.Position - posicao).Magnitude
	local fator = math.clamp(1 - distancia / 70, 0, 1)
	if fator > 0 then
		Vfx.tremer(forca * fator, duracao)
	end
end

RunService:BindToRenderStep("TremorDaCamera", Enum.RenderPriority.Camera.Value + 1, function()
	local agora = os.clock()
	if agora >= tremorFim then
		return
	end
	local camera = workspace.CurrentCamera
	local i = tremorForca * (tremorFim - agora) / tremorDuracao
	local function r()
		return (math.random() - 0.5) * 2
	end
	camera.CFrame *= CFrame.new(r() * i * 0.12, r() * i * 0.12, 0) * CFrame.Angles(r() * i * 0.006, r() * i * 0.006, r() * i * 0.004)
end)

------------------------------------------------------------------------
-- Corte de espada: um arco curvo (Beam) que "varre" da esquerda para a direita
------------------------------------------------------------------------

local function transparenciaDeVarredura(cabeca: number, cauda: number, minima: number): NumberSequence
	local chaves = {}
	for i = 0, 9 do
		local x = i / 9
		local valor = 1
		if x <= cabeca and x >= cabeca - cauda then
			valor = minima + (1 - minima) * ((cabeca - x) / cauda)
		end
		table.insert(chaves, NumberSequenceKeypoint.new(x, math.clamp(valor, 0, 1)))
	end
	return NumberSequence.new(chaves)
end

-- Posiciona dois Attachments para que um Beam entre eles desenhe um arco de círculo
local function posicionarArco(a0: Attachment, a1: Attachment, feixes: { Beam }, origem: CFrame, raio: number, arcoGraus: number)
	local meio = math.rad(arcoGraus) / 2
	local function ponto(phi: number)
		local local_ = Vector3.new(-raio * math.sin(phi), 0, -raio * math.cos(phi))
		local tangente = Vector3.new(math.cos(phi), 0, -math.sin(phi))
		return origem:PointToWorldSpace(local_), origem:VectorToWorldSpace(tangente)
	end
	local p0, t0 = ponto(meio)
	local p1, t1 = ponto(-meio)
	a0.WorldCFrame = CFrame.fromMatrix(p0, t0, Vector3.yAxis)
	a1.WorldCFrame = CFrame.fromMatrix(p1, t1, Vector3.yAxis)
	local controle = 4 / 3 * math.tan(math.rad(arcoGraus) / 4) * raio
	for _, feixe in feixes do
		feixe.CurveSize0 = controle
		feixe.CurveSize1 = controle
	end
end

local function novoFeixe(a0: Attachment, a1: Attachment, cor: Color3, largura: number): Beam
	local b = Instance.new("Beam")
	b.Attachment0 = a0
	b.Attachment1 = a1
	b.Color = ColorSequence.new(cor)
	b.LightEmission = 1
	b.LightInfluence = 0
	b.FaceCamera = true
	b.Segments = 24
	b.Width0 = largura
	b.Width1 = largura
	b.Transparency = NumberSequence.new(1)
	b.Parent = a0
	return b
end

--[[ origem: CFrame na altura do peito, olhando para onde o golpe vai
	opcoes: espessura, duracao, reverso (varre da direita para a esquerda) ]]
local function arcoDeCorte(origem: CFrame, raio: number, arcoGraus: number, cor: Color3, opcoes)
	opcoes = opcoes or {}
	local espessura = opcoes.espessura or 1
	local duracao = opcoes.duracao or 0.16
	if opcoes.reverso then
		origem = origem * CFrame.Angles(0, 0, math.pi) -- espelha o arco
	end
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Parent = terreno
	a1.Parent = terreno
	local nucleo = novoFeixe(a0, a1, cor:Lerp(BRANCO, 0.55), 0.7 * espessura)
	local aura = novoFeixe(a0, a1, cor, 2.4 * espessura)
	posicionarArco(a0, a1, { nucleo, aura }, origem, raio, arcoGraus)

	local inicio = os.clock()
	local conexao
	conexao = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - inicio) / duracao
		local cabeca = t * 1.45
		nucleo.Transparency = transparenciaDeVarredura(cabeca, 0.45, 0)
		aura.Transparency = transparenciaDeVarredura(cabeca, 0.55, 0.45)
		if cabeca > 1.6 then
			conexao:Disconnect()
			a0:Destroy()
			a1:Destroy()
		end
	end)
	-- faíscas na ponta do arco
	local fim = origem:PointToWorldSpace(Vector3.new(raio * math.sin(math.rad(arcoGraus) / 2), 0, -raio * math.cos(math.rad(arcoGraus) / 2)))
	task.delay(duracao * 0.6, function()
		particulas(fim, { cor = cor:Lerp(BRANCO, 0.4), quantidade = 6, tamanho = 0.35, velocidade = 12, vida = 0.3 })
	end)
end

function Vfx.corte(dados)
	local raiz = raizDoJogador(dados.jogador)
	local base = if raiz then raiz.Position else dados.pos
	local direcao = dados.dir
	local origem = CFrame.lookAt(base, base + direcao)
	local combo = dados.combo or 1
	local final = combo == 3
	local raio = dados.alcance * 0.8
	if final then
		arcoDeCorte(origem * CFrame.Angles(0, 0, math.rad(-12)), raio, dados.arco, dados.cor, { espessura = 1.6, duracao = 0.2 })
		arcoDeCorte(origem * CFrame.new(0, -0.6, 0), raio * 0.75, dados.arco, dados.cor, { espessura = 1, duracao = 0.22 })
		local frente = base + direcao * raio * 0.8
		particulas(frente, { cor = dados.cor, cor2 = BRANCO, quantidade = 16, tamanho = 0.6, velocidade = 22, vida = 0.4 })
		local onda = disco(Vector3.new(base.X, base.Y - 2.6, base.Z) + direcao * 3, 2, dados.cor, 0.4)
		animar(onda, 0.3, { Size = Vector3.new(0.15, raio * 2, raio * 2), Transparency = 1 })
		Debris:AddItem(onda, 0.35)
		Vfx.tremerEm(base, 0.8, 0.15)
	else
		local inclinacao = if combo == 2 then CFrame.Angles(0, 0, math.rad(18)) else CFrame.Angles(0, 0, math.rad(-8))
		arcoDeCorte(origem * inclinacao, raio, dados.arco, dados.cor, { reverso = combo == 2 })
	end
end

function Vfx.golpeInimigo(dados)
	local base = dados.pos
	if dados.arco >= 360 then
		local chao = Vector3.new(base.X, base.Y - 1.5, base.Z)
		local onda = disco(chao, 2, dados.cor, 0.25)
		animar(onda, 0.35, { Size = Vector3.new(0.15, dados.alcance * 2, dados.alcance * 2), Transparency = 1 })
		Debris:AddItem(onda, 0.4)
		for _, p in anel(chao + Vector3.new(0, 0.2, 0), dados.alcance, dados.cor, 0.2, 20, 0.6) do
			animar(p, 0.4, { Transparency = 1 })
			Debris:AddItem(p, 0.45)
		end
		Vfx.tremerEm(base, 0.6, 0.2)
	else
		local origem = CFrame.lookAt(base, base + dados.dir)
		arcoDeCorte(origem, dados.alcance * 0.85, math.min(dados.arco, 170), dados.cor, { espessura = 1.3 })
	end
end

function Vfx.redemoinho(dados)
	local raiz = raizDoJogador(dados.jogador)
	if not raiz then
		return
	end
	local cor = if dados.fogo then FOGO else dados.cor
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	local b0, b1 = Instance.new("Attachment"), Instance.new("Attachment")
	for _, a in { a0, a1, b0, b1 } do
		a.Parent = terreno
	end
	local feixesA = { novoFeixe(a0, a1, cor:Lerp(BRANCO, 0.5), 0.8), novoFeixe(a0, a1, cor, 2.6) }
	local feixesB = { novoFeixe(b0, b1, cor:Lerp(BRANCO, 0.5), 0.8), novoFeixe(b0, b1, cor, 2.6) }
	for i, feixe in { feixesA[1], feixesA[2], feixesB[1], feixesB[2] } do
		feixe.Transparency = sequencia({ { 0, 1 }, { 0.5, if i % 2 == 1 then 0 else 0.5 }, { 1, 0.1 } })
	end
	local inicio = os.clock()
	local conexao
	conexao = RunService.RenderStepped:Connect(function()
		local t = os.clock() - inicio
		if t > dados.duracao or not raiz.Parent then
			conexao:Disconnect()
			for _, a in { a0, a1, b0, b1 } do
				a:Destroy()
			end
			return
		end
		local centro = CFrame.new(raiz.Position) * CFrame.Angles(0, -t * 14, 0)
		posicionarArco(a0, a1, feixesA, centro, dados.raio * 0.8, 150)
		posicionarArco(b0, b1, feixesB, centro * CFrame.Angles(0, math.pi, 0), dados.raio * 0.8, 150)
		if math.random() < 0.3 then
			particulas(raiz.Position + Vector3.new(math.random(-4, 4), -1, math.random(-4, 4)), { cor = cor, quantidade = 3, tamanho = 0.4, velocidade = 8, vida = 0.4 })
		end
	end)
end

function Vfx.rajada(dados)
	local origem = CFrame.lookAt(dados.pos, dados.pos + dados.dir)
	for _ = 1, 9 do
		local inicio = origem * CFrame.Angles(0, math.rad(math.random(-28, 28)), 0)
		local bola = parte(Vector3.one * 1.6, inicio * CFrame.new(0, 0, -2), FOGO, 0.1, Enum.PartType.Ball)
		animar(bola, 0.32, { CFrame = inicio * CFrame.new(0, 0, -dados.alcance), Size = Vector3.one * 4, Transparency = 1 })
		Debris:AddItem(bola, 0.35)
	end
	particulas(dados.pos + dados.dir * 4, { cor = Color3.fromRGB(255, 220, 120), cor2 = FOGO, quantidade = 20, velocidade = 30, vida = 0.4, espalhar = Vector2.new(30, 30) })
end

------------------------------------------------------------------------
-- Projéteis (o servidor calcula; aqui só desenhamos)
------------------------------------------------------------------------

local projeteis = {} -- [id] = { parte, pos, dir, vel, alcance, percorrido, cor, tipo }

local ESTILOS_PROJETIL = {
	orbe = { cor = Color3.fromRGB(190, 110, 255), formato = "bola", tamanho = 1.3 },
	orbeGrande = { cor = Color3.fromRGB(215, 140, 255), formato = "bola", tamanho = 1.3 },
	flecha = { cor = Color3.fromRGB(150, 255, 160), formato = "flecha", tamanho = 1 },
	flechaGrande = { cor = Color3.fromRGB(200, 255, 140), formato = "flecha", tamanho = 1 },
	fantasma = { cor = Color3.fromRGB(140, 240, 255), formato = "flecha", tamanho = 1 },
	onda = { cor = Color3.fromRGB(140, 190, 255), formato = "onda", tamanho = 1 },
	flechaOssea = { cor = Color3.fromRGB(255, 90, 80), formato = "flecha", tamanho = 1 },
	veneno = { cor = Color3.fromRGB(130, 255, 80), formato = "bola", tamanho = 1.2 },
	gelo = { cor = Color3.fromRGB(140, 220, 255), formato = "cristal", tamanho = 1.3 },
	fogo = { cor = Color3.fromRGB(255, 120, 40), formato = "bola", tamanho = 1.4, fogo = true },
	orbeCarregado = { cor = Color3.fromRGB(225, 150, 255), formato = "bola", tamanho = 1.2 },
	flechaCarregada = { cor = Color3.fromRGB(255, 230, 120), formato = "flecha", tamanho = 1 },
	adaga = { cor = Color3.fromRGB(255, 90, 120), formato = "flecha", tamanho = 0.7 },
}

local function rastro(p: BasePart, cor: Color3, largura: number, duracao: number)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, largura / 2, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -largura / 2, 0)
	a1.Parent = p
	local t = Instance.new("Trail")
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Color = ColorSequence.new(cor:Lerp(BRANCO, 0.5), cor)
	t.Transparency = sequencia({ { 0, 0.15 }, { 1, 1 } })
	t.WidthScale = sequencia({ { 0, 1 }, { 1, 0 } })
	t.Lifetime = duracao
	t.LightEmission = 1
	t.LightInfluence = 0
	t.FaceCamera = true
	t.Parent = p
end

local function criarVisualProjetil(tipo: string, tamanho: number): (BasePart, Color3)
	local estilo = ESTILOS_PROJETIL[tipo] or ESTILOS_PROJETIL.orbe
	local cor = estilo.cor
	local escala = estilo.tamanho * tamanho
	local p
	if estilo.formato == "flecha" then
		p = parte(Vector3.new(0.18 * escala, 0.18 * escala, 2.6 * escala), CFrame.new(), cor, 0, nil, Enum.Material.Neon)
		rastro(p, cor, 0.35 * escala, 0.18)
	elseif estilo.formato == "onda" then
		p = parte(Vector3.new(5.5, 0.6, 1), CFrame.new(), cor, 0.2)
		rastro(p, cor, 0.6, 0.25)
	elseif estilo.formato == "cristal" then
		p = parte(Vector3.new(0.8, 0.8, 2) * escala, CFrame.new(), cor, 0.05)
		rastro(p, cor, 0.6 * escala, 0.25)
	else
		p = parte(Vector3.one * escala, CFrame.new(), cor, 0, Enum.PartType.Ball)
		rastro(p, cor, 0.9 * escala, 0.22)
		local brilho = Instance.new("ParticleEmitter")
		brilho.Color = ColorSequence.new(cor:Lerp(BRANCO, 0.4), cor)
		brilho.LightEmission = 1
		brilho.LightInfluence = 0
		brilho.Size = sequencia({ { 0, 0.35 * escala }, { 1, 0 } })
		brilho.Lifetime = NumberRange.new(0.2, 0.4)
		brilho.Speed = NumberRange.new(0.5, 2)
		brilho.SpreadAngle = Vector2.new(180, 180)
		brilho.Rate = 40
		brilho.Parent = p
	end
	if estilo.fogo then
		local f = Instance.new("Fire")
		f.Size = 2
		f.Heat = 0
		f.Parent = p
	end
	local l = Instance.new("PointLight")
	l.Color = cor
	l.Range = 8 + 4 * escala
	l.Brightness = 1.5
	l.Parent = p
	return p, cor
end

function Vfx.projeteis(dados)
	for _, info in dados.lista do
		local visual, cor = criarVisualProjetil(info.tipo, info.tamanho or 1)
		visual.CFrame = CFrame.lookAt(info.pos, info.pos + info.dir)
		projeteis[info.id] = {
			parte = visual,
			pos = info.pos,
			dir = info.dir,
			vel = info.vel,
			alcance = info.alcance,
			percorrido = 0,
			cor = cor,
			tipo = info.tipo,
			girar = info.tipo == "gelo",
		}
	end
end

local function removerProjetil(id: number, impacto: boolean, pos: Vector3?)
	local p = projeteis[id]
	if not p then
		return
	end
	projeteis[id] = nil
	local onde = pos or p.pos
	p.parte.Transparency = 1
	Debris:AddItem(p.parte, 0.3) -- deixa o rastro terminar
	if impacto then
		particulas(onde, { cor = p.cor, cor2 = BRANCO, quantidade = 10, tamanho = 0.45, velocidade = 16, vida = 0.35 })
		clarao(onde, p.cor, 10, 0.2, 2)
	end
end

function Vfx.projetilFim(dados)
	removerProjetil(dados.id, dados.impacto, dados.pos)
end

function Vfx.projetilDir(dados)
	local p = projeteis[dados.id]
	if p then
		p.pos = dados.pos
		p.dir = dados.dir
		particulas(dados.pos, { cor = p.cor, quantidade = 6, tamanho = 0.3, velocidade = 10, vida = 0.25 })
	end
end

RunService.RenderStepped:Connect(function(dt)
	for id, p in projeteis do
		local passo = p.vel * dt
		p.pos += p.dir * passo
		p.percorrido += passo
		if p.percorrido > p.alcance + 6 then
			removerProjetil(id, false)
		else
			local cf = CFrame.lookAt(p.pos, p.pos + p.dir)
			if p.girar then
				cf *= CFrame.Angles(0, 0, os.clock() * 12)
			end
			p.parte.CFrame = cf
		end
	end
end)

------------------------------------------------------------------------
-- Explosões e impactos
------------------------------------------------------------------------

function Vfx.explosao(dados)
	local pos, raio, cor = dados.pos, dados.raio or 6, dados.cor or FOGO
	local forte = dados.forte == true
	local leve = dados.leve == true
	local nucleo = parte(Vector3.one * 1.5, CFrame.new(pos), cor:Lerp(BRANCO, 0.5), 0, Enum.PartType.Ball)
	animar(nucleo, if leve then 0.22 else 0.35, { Size = Vector3.one * raio * 2, Transparency = 1, Color = cor })
	Debris:AddItem(nucleo, 0.4)
	local chao = Vector3.new(pos.X, pos.Y - (if leve then 1 else 0) , pos.Z)
	local onda = disco(chao, 2, cor, 0.2)
	animar(onda, 0.4, { Size = Vector3.new(0.15, raio * 2.6, raio * 2.6), Transparency = 1 })
	Debris:AddItem(onda, 0.45)
	particulas(pos, {
		cor = cor:Lerp(BRANCO, 0.3),
		cor2 = cor,
		quantidade = if leve then 10 else 28,
		tamanho = if leve then 0.5 else 0.9,
		velocidade = raio * 5,
		vida = 0.6,
		gravidade = 10,
	})
	clarao(pos, cor, raio * 4, 0.4, if forte then 6 else 3)
	if not leve then
		Vfx.tremerEm(pos, if forte then 2.2 else 1, 0.3)
	end
end

function Vfx.impacto(dados)
	local pos, raio = dados.pos, dados.raio or 6
	local poeira = disco(pos + Vector3.new(0, 0.2, 0), 2, Color3.fromRGB(200, 180, 160), 0.35)
	animar(poeira, 0.45, { Size = Vector3.new(0.15, raio * 2.4, raio * 2.4), Transparency = 1 })
	Debris:AddItem(poeira, 0.5)
	particulas(pos + Vector3.new(0, 0.5, 0), { cor = Color3.fromRGB(190, 170, 150), quantidade = 18, tamanho = 0.7, velocidade = 20, vida = 0.6, gravidade = 30, luz = 0, espalhar = Vector2.new(70, 70) })
	if dados.cor then
		clarao(pos, dados.cor, raio * 3, 0.3, 3)
	end
	Vfx.tremerEm(pos, if dados.forte then 2.5 else 1.2, 0.3)
end

function Vfx.impactoArea(dados)
	local pos, raio = dados.pos, dados.raio
	if dados.visual == "gelo" then
		for _ = 1, 7 do
			local p = pos + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * raio * 1.6
			local altura = math.random(3, 6)
			local espinho = parte(Vector3.new(0.9, 0.1, 0.9), CFrame.new(p) * CFrame.Angles(math.random() * 0.4, math.random() * 3, math.random() * 0.4), Color3.fromRGB(170, 230, 255), 0.15)
			animar(espinho, 0.12, { Size = Vector3.new(0.9, altura, 0.9), CFrame = espinho.CFrame * CFrame.new(0, altura / 2, 0) }, Enum.EasingStyle.Back)
			sumir({ espinho }, 0.5, 0.7)
		end
		particulas(pos + Vector3.new(0, 1, 0), { cor = Color3.fromRGB(220, 245, 255), quantidade = 20, velocidade = 14, vida = 0.6, gravidade = 10 })
		clarao(pos, Color3.fromRGB(150, 220, 255), raio * 3, 0.4)
	elseif dados.visual == "teia" then
		local teia = disco(pos + Vector3.new(0, 0.18, 0), raio * 2, Color3.fromRGB(235, 235, 235), 0.55, 0.1)
		teia.Material = Enum.Material.SmoothPlastic
		for i = 0, 3 do
			parte(Vector3.new(raio * 2, 0.12, 0.15), CFrame.new(pos + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, i * math.pi / 4, 0), Color3.fromRGB(240, 240, 240), 0.3, nil, Enum.Material.SmoothPlastic).Parent = teia
		end
		sumir({ teia }, 0.8, 1.6)
		for _, filho in teia:GetChildren() do
			if filho:IsA("BasePart") then
				sumir({ filho }, 0.8, 1.6)
			end
		end
		particulas(pos + Vector3.new(0, 1, 0), { cor = Color3.fromRGB(150, 255, 110), quantidade = 14, velocidade = 12, vida = 0.5 })
	else
		Vfx.explosao({ pos = pos + Vector3.new(0, 1, 0), raio = raio, cor = if dados.visual == "meteoro" then FOGO else VERMELHO, forte = dados.visual == "meteoro" })
	end
end

function Vfx.meteoro(dados)
	local alvo = dados.pos
	local inicio = alvo + Vector3.new(-14, 48, -14)
	local bola = parte(Vector3.one * 3.4, CFrame.new(inicio), FOGO, 0, Enum.PartType.Ball)
	local f = Instance.new("Fire")
	f.Size = 8
	f.Heat = 0
	f.Parent = bola
	rastro(bola, FOGO, 2.6, 0.4)
	local l = Instance.new("PointLight")
	l.Color = FOGO
	l.Range = 24
	l.Brightness = 3
	l.Parent = bola
	animar(bola, dados.duracao, { CFrame = CFrame.new(alvo + Vector3.new(0, 1.5, 0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(bola, dados.duracao + 0.05)
	if dados.amigo then
		local partes = anel(alvo + Vector3.new(0, 0.15, 0), dados.raio or 10, FOGO, 0.35, 24, 0.4)
		sumir(partes, 0.2, dados.duracao)
	end
end

function Vfx.chuvaFlechas(dados)
	local centro, raio, duracao, cor = dados.pos, dados.raio, dados.duracao, dados.cor
	local partes = anel(centro + Vector3.new(0, 0.15, 0), raio, cor, 0.35, 28, 0.45)
	local fundo = disco(centro + Vector3.new(0, 0.12, 0), raio * 2, cor, 0.85)
	table.insert(partes, fundo)
	sumir(partes, 0.4, duracao)
	task.spawn(function()
		local fim = os.clock() + duracao
		while os.clock() < fim do
			local angulo = math.random() * math.pi * 2
			local distancia = math.sqrt(math.random()) * raio
			local chao = centro + Vector3.new(math.cos(angulo) * distancia, 0, math.sin(angulo) * distancia)
			local topo = chao + Vector3.new(3, 26, 3)
			local flecha = parte(Vector3.new(0.15, 0.15, 2.4), CFrame.lookAt(topo, chao), cor:Lerp(BRANCO, 0.3), 0)
			local tween = animar(flecha, 0.22, { CFrame = CFrame.lookAt(chao + Vector3.new(0, 0.8, 0), chao + Vector3.new(-3, -26, -3)) }, Enum.EasingStyle.Linear)
			tween.Completed:Once(function()
				particulas(chao + Vector3.new(0, 0.3, 0), { cor = Color3.fromRGB(200, 185, 160), quantidade = 3, tamanho = 0.3, velocidade = 6, vida = 0.25, luz = 0 })
				sumir({ flecha }, 0.3, 0.3)
			end)
			task.wait(0.035)
		end
	end)
end

function Vfx.julgamento(dados)
	local pos, raio, cor = dados.pos, dados.raio, Color3.fromRGB(255, 220, 120)
	local coluna = parte(Vector3.new(60, 6, 6), CFrame.new(pos + Vector3.new(0, 60, 0)) * EM_PE, cor, 0.1, Enum.PartType.Cylinder)
	animar(coluna, 0.3, { CFrame = CFrame.new(pos + Vector3.new(0, 30, 0)) * EM_PE }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.3, function()
		animar(coluna, 0.5, { Size = Vector3.new(60, 0.5, 0.5), Transparency = 1 })
		Debris:AddItem(coluna, 0.55)
		for i = 0, 2 do
			task.delay(i * 0.12, function()
				local onda = disco(pos + Vector3.new(0, 0.25, 0), 3, if i == 0 then BRANCO else dados.cor or cor, 0.15)
				animar(onda, 0.5, { Size = Vector3.new(0.15, raio * 2.2, raio * 2.2), Transparency = 1 })
				Debris:AddItem(onda, 0.55)
			end)
		end
		particulas(pos + Vector3.new(0, 1, 0), { cor = BRANCO, cor2 = cor, quantidade = 50, tamanho = 1, velocidade = 45, vida = 0.8, gravidade = 25 })
		clarao(pos, cor, raio * 4, 0.6, 8)
		Vfx.tremerEm(pos, 3.5, 0.5)
	end)
end

local function zigueZague(de: Vector3, ate: Vector3, cor: Color3, espessura: number, desvio: number, segmentos: number)
	local pontos = { de }
	for i = 1, segmentos - 1 do
		local base = de:Lerp(ate, i / segmentos)
		table.insert(pontos, base + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * desvio)
	end
	table.insert(pontos, ate)
	local partes: { BasePart } = {}
	for i = 1, #pontos - 1 do
		local a, b = pontos[i], pontos[i + 1]
		table.insert(partes, parte(Vector3.new(espessura, espessura, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), cor, 0))
	end
	sumir(partes, 0.18, 0.04)
end

function Vfx.raio(dados)
	zigueZague(dados.de, dados.ate, Color3.fromRGB(255, 245, 140), 0.35, 2.5, 5)
	clarao(dados.ate, Color3.fromRGB(255, 240, 120), 12, 0.2, 3)
end

function Vfx.raioCeu(dados)
	local cor = dados.cor or Color3.fromRGB(200, 150, 255)
	zigueZague(dados.pos + Vector3.new(math.random(-3, 3), 45, math.random(-3, 3)), dados.pos, cor:Lerp(BRANCO, 0.5), 0.6, 4, 7)
	zigueZague(dados.pos + Vector3.new(0, 45, 0), dados.pos, cor, 1.4, 3, 6)
	local onda = disco(dados.pos + Vector3.new(0, 0.2, 0), 1, cor, 0.2)
	animar(onda, 0.3, { Size = Vector3.new(0.15, 10, 10), Transparency = 1 })
	Debris:AddItem(onda, 0.35)
	particulas(dados.pos + Vector3.new(0, 0.5, 0), { cor = BRANCO, cor2 = cor, quantidade = 12, velocidade = 20, vida = 0.35 })
	clarao(dados.pos, cor, 22, 0.25, 6)
	Vfx.tremerEm(dados.pos, 0.6, 0.15)
end

function Vfx.teleporte(dados)
	local cor = Color3.fromRGB(130, 80, 220)
	local esfera = parte(Vector3.one * 6, CFrame.new(dados.pos), cor, 0.3, Enum.PartType.Ball)
	animar(esfera, 0.35, { Size = Vector3.one * 0.5, Transparency = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	Debris:AddItem(esfera, 0.4)
	particulas(dados.pos, { cor = Color3.fromRGB(200, 160, 255), cor2 = cor, quantidade = 24, velocidade = 14, vida = 0.6 })
	clarao(dados.pos, cor, 18, 0.4, 3)
end

function Vfx.furia(dados)
	local onda = disco(dados.pos - Vector3.new(0, 2, 0), 4, VERMELHO, 0.1)
	animar(onda, 0.7, { Size = Vector3.new(0.15, 70, 70), Transparency = 1 })
	Debris:AddItem(onda, 0.75)
	clarao(dados.pos, VERMELHO, 50, 0.8, 6)
	Vfx.tremer(2.5, 0.6)
end

------------------------------------------------------------------------
-- Avisos de ataque no chão (telegrafia)
------------------------------------------------------------------------

local function cunha(): WedgePart
	local w = Instance.new("WedgePart")
	w.Anchored = true
	w.CanCollide = false
	w.CanQuery = false
	w.CanTouch = false
	w.CastShadow = false
	w.Material = Enum.Material.Neon
	w.Parent = pasta
	return w
end

-- Desenha um triângulo a-b-c usando duas cunhas (técnica clássica do Roblox)
local function triangulo(a: Vector3, b: Vector3, c: Vector3, cor: Color3, transparencia: number): { BasePart }
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local direita = ac:Cross(ab).Unit
	local cima = bc:Cross(direita).Unit
	local tras = bc.Unit
	local altura = math.abs(ab:Dot(cima))
	local w1 = cunha()
	w1.Size = Vector3.new(0.12, altura, math.abs(ab:Dot(tras)))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2, direita, cima, tras)
	local w2 = cunha()
	w2.Size = Vector3.new(0.12, altura, math.abs(ac:Dot(tras)))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2, -direita, cima, -tras)
	for _, w in { w1, w2 } do
		w.Color = cor
		w.Transparency = transparencia
	end
	return { w1, w2 }
end

local function telegrafoCirculo(centro: Vector3, raio: number, duracao: number, cor: Color3)
	local partes = anel(centro + Vector3.new(0, 0.05, 0), raio, cor, 0.15, math.clamp(math.floor(raio * 3), 16, 40), 0.35)
	local fundo = disco(centro, raio * 2, cor, 0.82)
	local enchendo = disco(centro + Vector3.new(0, 0.02, 0), 0.3, cor, 0.5)
	animar(enchendo, duracao, { Size = Vector3.new(0.15, raio * 2, raio * 2) }, Enum.EasingStyle.Linear)
	table.insert(partes, fundo)
	table.insert(partes, enchendo)
	task.delay(duracao, function()
		for _, p in partes do
			if p.Parent then
				p.Color = BRANCO
			end
		end
		sumir(partes, 0.15)
	end)
end

local function telegrafoCone(centro: Vector3, direcao: Vector3, raio: number, arcoGraus: number, duracao: number, cor: Color3)
	local partes = {}
	local fatias = math.max(4, math.floor(arcoGraus / 12))
	local inicio = -math.rad(arcoGraus) / 2
	local passo = math.rad(arcoGraus) / fatias
	local base = CFrame.lookAt(centro, centro + direcao)
	local function ponto(angulo: number, r: number)
		return base:PointToWorldSpace(Vector3.new(-r * math.sin(angulo), 0, -r * math.cos(angulo)))
	end
	for i = 0, fatias - 1 do
		for _, w in triangulo(centro, ponto(inicio + i * passo, raio), ponto(inicio + (i + 1) * passo, raio), cor, 0.78) do
			table.insert(partes, w)
		end
	end
	-- borda do cone
	for i = 0, fatias - 1 do
		local a, b = ponto(inicio + i * passo, raio), ponto(inicio + (i + 1) * passo, raio)
		table.insert(partes, parte(Vector3.new(0.3, 0.16, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), cor, 0.15))
	end
	for _, angulo in { inicio, -inicio } do
		local a = ponto(angulo, raio)
		table.insert(partes, parte(Vector3.new(0.3, 0.16, raio), CFrame.lookAt((centro + a) / 2, a), cor, 0.15))
	end
	for _, p in partes do
		animar(p, duracao, { Transparency = math.max(0.35, p.Transparency - 0.35) }, Enum.EasingStyle.Linear)
	end
	task.delay(duracao, function()
		for _, p in partes do
			if p.Parent then
				p.Color = BRANCO
			end
		end
		sumir(partes, 0.15)
	end)
end

local function telegrafoLinha(inicio: Vector3, direcao: Vector3, comprimento: number, largura: number, duracao: number, cor: Color3)
	local base = CFrame.lookAt(inicio, inicio + direcao)
	local fundo = parte(Vector3.new(largura, 0.14, comprimento), base * CFrame.new(0, 0, -comprimento / 2), cor, 0.8)
	local enchendo = parte(Vector3.new(largura, 0.16, 0.2), base * CFrame.new(0, 0.01, -0.1), cor, 0.45)
	animar(enchendo, duracao, { Size = Vector3.new(largura, 0.16, comprimento), CFrame = base * CFrame.new(0, 0.01, -comprimento / 2) }, Enum.EasingStyle.Linear)
	local partes = { fundo, enchendo }
	for _, lado in { -1, 1 } do
		table.insert(partes, parte(Vector3.new(0.3, 0.17, comprimento), base * CFrame.new(lado * largura / 2, 0.02, -comprimento / 2), cor, 0.15))
	end
	task.delay(duracao, function()
		for _, p in partes do
			if p.Parent then
				p.Color = BRANCO
			end
		end
		sumir(partes, 0.15)
	end)
end

function Vfx.telegrafo(dados)
	local cor = if dados.chefe then Color3.fromRGB(255, 40, 60) else Color3.fromRGB(255, 80, 50)
	local centro = dados.pos + Vector3.new(0, 0.12, 0)
	if dados.forma == "cone" then
		telegrafoCone(centro, dados.dir, dados.raio, dados.arco, dados.duracao, cor)
	elseif dados.forma == "linha" then
		telegrafoLinha(centro, dados.dir, dados.comprimento, dados.largura, dados.duracao, cor)
	else
		telegrafoCirculo(centro, dados.raio, dados.duracao, cor)
	end
end

------------------------------------------------------------------------
-- Números de dano, cura e textos flutuantes
------------------------------------------------------------------------

local function textoFlutuante(posicao: Vector3, texto: string, cor: Color3, tamanho: number, opcoes)
	opcoes = opcoes or {}
	local a = ancora(posicao + Vector3.new((math.random() - 0.5) * 1.6, 0, (math.random() - 0.5) * 1.6))
	local placa = Instance.new("BillboardGui")
	placa.Size = UDim2.fromOffset(tamanho * 5, tamanho * 1.4)
	placa.AlwaysOnTop = true
	placa.LightInfluence = 0
	placa.MaxDistance = 140
	placa.Parent = a
	local rotulo = UI.texto({
		Size = UDim2.fromScale(1, 1),
		FontFace = UI.fontes.numero,
		Text = texto,
		TextColor3 = cor,
		Parent = placa,
	})
	local contorno = UI.contorno(rotulo, if tamanho > 40 then 3 else 2, 0)
	local pulo = UI.criar("UIScale", { Scale = opcoes.pop or 1.6, Parent = rotulo })
	animar(pulo, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	local subida = opcoes.subida or 3
	animar(placa, 0.8, { StudsOffset = Vector3.new((math.random() - 0.5) * 1.5, subida, 0) }, Enum.EasingStyle.Quad)
	task.delay(0.45, function()
		animar(rotulo, 0.35, { TextTransparency = 1 })
		animar(contorno, 0.35, { Transparency = 1 })
	end)
	Debris:AddItem(a, 0.85)
end

function Vfx.dano(dados)
	local critico = dados.critico
	local cor = dados.cor or (if critico then Color3.fromRGB(255, 214, 70) else Color3.fromRGB(255, 250, 240))
	textoFlutuante(dados.pos, if critico then dados.valor .. "!" else tostring(dados.valor), cor, if critico then 46 else 30, { pop = if critico then 2.2 else 1.5 })
	if dados.impacto then
		particulas(dados.impacto, {
			cor = if critico then Color3.fromRGB(255, 230, 120) else Color3.fromRGB(255, 240, 220),
			cor2 = dados.cor or Color3.fromRGB(255, 160, 80),
			quantidade = if critico then 14 else 7,
			tamanho = if critico then 0.6 else 0.4,
			velocidade = if critico then 24 else 16,
			vida = 0.3,
		})
		if critico then
			Vfx.tremerEm(dados.impacto, 0.5, 0.1)
		end
	end
end

function Vfx.danoJogador(dados)
	local raiz = raizDoJogador(dados.jogador)
	if Vfx.aoJogadorAtingido then
		Vfx.aoJogadorAtingido(dados.jogador)
	end
	if raiz then
		textoFlutuante(raiz.Position + Vector3.new(0, 3, 0), "-" .. dados.valor, Color3.fromRGB(255, 80, 80), 30, { pop = 1.4 })
	end
	if dados.jogador == jogador then
		Vfx.tremer(math.clamp(dados.valor / 15, 0.4, 2), 0.25)
		if Vfx.aoDanoLocal then
			Vfx.aoDanoLocal(dados.valor)
		end
	end
end

function Vfx.cura(dados)
	local raiz = raizDoJogador(dados.jogador)
	if raiz then
		textoFlutuante(raiz.Position + Vector3.new(0, 3, 0), "+" .. dados.valor, Color3.fromRGB(110, 255, 140), 28, { pop = 1.3 })
		particulas(raiz.Position, { cor = Color3.fromRGB(150, 255, 170), quantidade = 8, velocidade = 6, vida = 0.8, espalhar = Vector2.new(30, 30) })
	end
end

local function pilarDeLuz(raiz: BasePart, cor: Color3, altura: number, largura: number)
	local base = raiz.Position - Vector3.new(0, 3, 0)
	local pilar = parte(Vector3.new(altura, largura, largura), CFrame.new(base + Vector3.new(0, altura / 2, 0)) * EM_PE, cor, 0.35, Enum.PartType.Cylinder)
	animar(pilar, 0.7, { Size = Vector3.new(altura, 0.3, 0.3), Transparency = 1 })
	Debris:AddItem(pilar, 0.75)
	local onda = disco(base + Vector3.new(0, 0.2, 0), 1, cor, 0.2)
	animar(onda, 0.5, { Size = Vector3.new(0.15, 12, 12), Transparency = 1 })
	Debris:AddItem(onda, 0.55)
	particulas(raiz.Position, { cor = BRANCO, cor2 = cor, quantidade = 26, tamanho = 0.6, velocidade = 14, vida = 1, gravidade = -6, espalhar = Vector2.new(40, 40) })
	clarao(raiz.Position, cor, 26, 0.7, 5)
end

function Vfx.carta(dados)
	local raiz = raizDoJogador(dados.jogador)
	if raiz then
		local lendaria = dados.raridade == "Lendaria"
		pilarDeLuz(raiz, dados.cor, if lendaria then 60 else 30, if lendaria then 6 else 3.5)
		if lendaria and dados.jogador == jogador then
			Vfx.tremer(1.5, 0.4)
		end
	end
end

function Vfx.escolheuClasse(dados)
	local raiz = raizDoJogador(dados.jogador)
	if raiz then
		pilarDeLuz(raiz, dados.cor, 40, 5)
	end
end

function Vfx.reviver(dados)
	local raiz = raizDoJogador(dados.jogador)
	if raiz then
		pilarDeLuz(raiz, Color3.fromRGB(140, 255, 170), 30, 4)
		textoFlutuante(raiz.Position + Vector3.new(0, 4, 0), "DE PÉ!", Color3.fromRGB(140, 255, 170), 34, { pop = 1.8 })
	end
end

function Vfx.segundaChance(dados)
	local raiz = raizDoJogador(dados.jogador)
	if raiz then
		pilarDeLuz(raiz, Color3.fromRGB(255, 220, 110), 50, 6)
		textoFlutuante(raiz.Position + Vector3.new(0, 4, 0), "SEGUNDA CHANCE!", Color3.fromRGB(255, 220, 110), 40, { pop = 2 })
	end
end

function Vfx.caiu(dados)
	local raiz = raizDoJogador(dados.jogador)
	if raiz then
		particulas(raiz.Position, { cor = Color3.fromRGB(80, 70, 90), quantidade = 20, velocidade = 10, vida = 0.8, luz = 0, gravidade = 5 })
	end
end

function Vfx.bloqueio(dados)
	local raiz = raizDoJogador(dados.jogador)
	if raiz then
		local cor = Color3.fromRGB(110, 190, 255)
		local bolha = parte(Vector3.one * 5, CFrame.new(raiz.Position), cor, 0.4, Enum.PartType.Ball, Enum.Material.ForceField)
		animar(bolha, 0.4, { Size = Vector3.one * 8, Transparency = 1 })
		Debris:AddItem(bolha, 0.45)
		textoFlutuante(raiz.Position + Vector3.new(0, 3.5, 0), "BLOQUEADO", cor, 30)
	end
end

local COR_ESQUIVA = {
	cavaleiro = Color3.fromRGB(255, 225, 160),
	mago = Color3.fromRGB(210, 160, 255),
	arqueiro = Color3.fromRGB(170, 255, 190),
	assassino = Color3.fromRGB(120, 30, 60),
}

function Vfx.esquiva(dados)
	local raiz = raizDoJogador(dados.jogador)
	if not raiz then
		return
	end
	local personagem = raiz.Parent
	local cor = COR_ESQUIVA[dados.classe] or Color3.fromRGB(200, 230, 255)
	-- "fantasmas" do personagem que ficam para trás
	for i = 0, 2 do
		task.delay(i * 0.05, function()
			if not personagem or not personagem.Parent then
				return
			end
			for _, peca in personagem:GetChildren() do
				if peca:IsA("BasePart") and peca.Name ~= "HumanoidRootPart" and peca.Transparency < 1 then
					local fantasma = parte(peca.Size, peca.CFrame, cor, 0.5 + i * 0.1, nil, Enum.Material.Neon)
					animar(fantasma, 0.3, { Transparency = 1, Size = peca.Size * 0.85 })
					Debris:AddItem(fantasma, 0.32)
				end
			end
		end)
	end
	particulas(raiz.Position - Vector3.new(0, 2, 0), { cor = Color3.fromRGB(230, 240, 255), quantidade = 10, velocidade = 10, vida = 0.35, luz = 0.5 })
	-- risco de vento que acompanha o corpo durante o impulso
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = raiz
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1.6, 0)
	a1.Parent = raiz
	local vento = Instance.new("Trail")
	vento.Attachment0 = a0
	vento.Attachment1 = a1
	vento.Color = ColorSequence.new(BRANCO, cor)
	vento.Transparency = sequencia({ { 0, 0.35 }, { 1, 1 } })
	vento.Lifetime = 0.2
	vento.LightEmission = 1
	vento.LightInfluence = 0
	vento.FaceCamera = true
	vento.Parent = raiz
	task.delay(0.22, function()
		vento.Enabled = false
	end)
	Debris:AddItem(vento, 0.5)
	Debris:AddItem(a0, 0.5)
	Debris:AddItem(a1, 0.5)
end

------------------------------------------------------------------------
-- Ataque carregado
------------------------------------------------------------------------

-- Carga cheia: clarão dourado na ponta da arma
function Vfx.cargaCheia(dados)
	local ouro = Color3.fromRGB(255, 214, 90)
	local bola = parte(Vector3.one * 0.6, CFrame.new(dados.pos), ouro:Lerp(BRANCO, 0.4), 0.1, Enum.PartType.Ball, Enum.Material.Neon)
	animar(bola, 0.25, { Size = Vector3.one * 4, Transparency = 1 })
	Debris:AddItem(bola, 0.3)
	particulas(dados.pos, { cor = BRANCO, cor2 = ouro, quantidade = 12, tamanho = 0.35, velocidade = 14, vida = 0.3 })
	clarao(dados.pos, ouro, 14, 0.25, 4)
	if dados.local_ then
		Vfx.tremer(0.35, 0.1)
	end
end

-- Fumaça escura que fica onde o Assassino some ou aparece
local function fumaca(posicao: Vector3, cor: Color3, quantidade: number)
	particulas(posicao, { cor = Color3.fromRGB(30, 22, 40), cor2 = cor, quantidade = quantidade, tamanho = 1.1, velocidade = 7, vida = 0.5, luz = 0 })
	local nuvem = parte(Vector3.one * 2, CFrame.new(posicao), Color3.fromRGB(25, 18, 32), 0.35, Enum.PartType.Ball, Enum.Material.SmoothPlastic)
	animar(nuvem, 0.4, { Size = Vector3.one * 5, Transparency = 1 })
	Debris:AddItem(nuvem, 0.45)
end

-- Assassino: some numa fumaça e aparece em outro lugar, deixando um risco no ar
function Vfx.passoSombrio(dados)
	local de, ate = dados.de, dados.ate
	local cor = dados.cor
	fumaca(de, cor, if dados.leve then 6 else 12)
	fumaca(ate, cor, if dados.leve then 4 else 8)
	local distancia = (ate - de).Magnitude
	if distancia > 1 then
		local risco = parte(Vector3.new(0.35, 0.35, distancia), CFrame.lookAt((de + ate) / 2, ate), cor, 0.2, nil, Enum.Material.Neon)
		animar(risco, 0.25, { Size = Vector3.new(0.05, 0.05, distancia), Transparency = 1 })
		Debris:AddItem(risco, 0.3)
	end
	if dados.jogador == jogador and not dados.leve then
		Vfx.tremer(0.4, 0.1)
	end
end

-- Investida Letal do Assassino (golpe carregado): linha de cortes no caminho
function Vfx.investidaLetal(dados)
	local de, ate = dados.de, dados.ate
	local cor = if dados.perfeito then dados.cor:Lerp(Color3.fromRGB(255, 214, 90), 0.5) else dados.cor
	local distancia = (ate - de).Magnitude
	if distancia < 0.5 then
		return
	end
	local direcao = (ate - de).Unit
	for i = 0, 2 do
		task.delay(i * 0.04, function()
			local lado = if i % 2 == 0 then 1 else -1
			local origem = CFrame.lookAt(de + direcao * distancia * (0.3 + 0.3 * i), de + direcao * distancia * (0.3 + 0.3 * i) + direcao)
			arcoDeCorte(origem * CFrame.Angles(0, 0, math.rad(35 * lado)), 3.2, 160, cor, { espessura = 0.9, duracao = 0.12, reverso = lado < 0 })
		end)
	end
	local rastro = parte(Vector3.new(1.2, 0.2, distancia), CFrame.lookAt((de + ate) / 2, ate), cor, 0.3, nil, Enum.Material.Neon)
	animar(rastro, 0.35, { Size = Vector3.new(0.1, 0.05, distancia), Transparency = 1 })
	Debris:AddItem(rastro, 0.4)
	particulas(ate, { cor = cor, cor2 = BRANCO, quantidade = 12, tamanho = 0.4, velocidade = 18, vida = 0.3 })
	Vfx.tremerEm(ate, if dados.perfeito then 1 else 0.6, 0.12)
end

-- Chão em chamas deixado pelo Meteoro
function Vfx.zonaFogo(dados)
	local centro = dados.pos + Vector3.new(0, 0.1, 0)
	local diametro = dados.raio * 2
	local base = disco(centro, diametro, FOGO, 0.45)
	-- peça invisível e achatada: as chamas saem de toda a área dela, para cima
	local area = parte(Vector3.new(diametro * 0.75, 0.2, diametro * 0.75), CFrame.new(centro), FOGO, 1)
	local chamas = Instance.new("ParticleEmitter")
	chamas.Color = ColorSequence.new(Color3.fromRGB(255, 200, 90), Color3.fromRGB(255, 70, 20))
	chamas.LightEmission = 1
	chamas.LightInfluence = 0
	chamas.Size = sequencia({ { 0, 0.9 }, { 1, 0 } })
	chamas.Lifetime = NumberRange.new(0.5, 0.9)
	chamas.Speed = NumberRange.new(3, 6)
	chamas.SpreadAngle = Vector2.new(10, 10)
	chamas.Shape = Enum.ParticleEmitterShape.Box
	chamas.EmissionDirection = Enum.NormalId.Top
	chamas.Rate = 60
	chamas.Parent = area
	local luz = Instance.new("PointLight")
	luz.Color = FOGO
	luz.Range = diametro
	luz.Brightness = 2
	luz.Parent = area
	task.delay(dados.duracao, function()
		chamas.Enabled = false
		animar(luz, 0.3, { Brightness = 0 })
	end)
	sumir({ base }, 0.4, dados.duracao)
	Debris:AddItem(area, dados.duracao + 1)
end

-- Escudo ganho com o Julgamento do Cavaleiro
function Vfx.escudoGanho(dados)
	local raiz = raizDoJogador(dados.jogador)
	if not raiz then
		return
	end
	local bolha = parte(Vector3.one * 2, raiz.CFrame, dados.cor:Lerp(BRANCO, 0.4), 0.3, Enum.PartType.Ball, Enum.Material.ForceField)
	animar(bolha, 0.5, { Size = Vector3.one * 7, Transparency = 1 })
	Debris:AddItem(bolha, 0.55)
	textoFlutuante(raiz.Position + Vector3.new(0, 3.5, 0), "🛡️ ESCUDO", dados.cor:Lerp(BRANCO, 0.4), 26)
end

-- Giro do Cavaleiro com a espada carregada
function Vfx.giroCarregado(dados)
	local raiz = raizDoJogador(dados.jogador)
	if not raiz then
		return
	end
	local base = raiz.Position
	local raio = dados.raio
	local cor = if dados.perfeito then dados.cor:Lerp(Color3.fromRGB(255, 214, 90), 0.6) else dados.cor
	local origem = CFrame.lookAt(base, base + raiz.CFrame.LookVector)
	arcoDeCorte(origem, raio * 0.85, 180, cor, { espessura = 1.8, duracao = 0.16 })
	task.delay(0.08, function()
		arcoDeCorte(origem * CFrame.Angles(0, math.pi, 0), raio * 0.85, 180, cor, { espessura = 1.8, duracao = 0.16 })
	end)
	local chao = Vector3.new(base.X, base.Y - 2.6, base.Z)
	local onda = disco(chao, 2, cor, 0.3)
	animar(onda, 0.35, { Size = Vector3.new(0.15, raio * 2.2, raio * 2.2), Transparency = 1 })
	Debris:AddItem(onda, 0.4)
	particulas(chao + Vector3.new(0, 0.5, 0), { cor = cor, cor2 = BRANCO, quantidade = 20, tamanho = 0.5, velocidade = 26, vida = 0.4 })
	Vfx.tremerEm(base, if dados.perfeito then 1.6 else 1, 0.2)
	if dados.perfeito then
		clarao(base, cor, 30, 0.4, 6)
	end
end

function Vfx.supremo(dados)
	local raiz = raizDoJogador(dados.jogador)
	if not raiz then
		return
	end
	textoFlutuante(raiz.Position + Vector3.new(0, 5, 0), string.upper(dados.nome) .. "!", dados.cor:Lerp(BRANCO, 0.3), 54, { pop = 2.4, subida = 4 })
	local onda = parte(Vector3.one * 2, CFrame.new(raiz.Position), dados.cor, 0.2, Enum.PartType.Ball)
	animar(onda, 0.5, { Size = Vector3.one * 24, Transparency = 1 })
	Debris:AddItem(onda, 0.55)
	clarao(raiz.Position, dados.cor, 40, 0.8, 6)
	if dados.jogador == jogador then
		Vfx.tremer(1.5, 0.35)
	end
end

------------------------------------------------------------------------
-- Portal de invocação e moedas
------------------------------------------------------------------------

function Vfx.portal(dados)
	local cor = if dados.elite then Color3.fromRGB(255, 200, 60) else Color3.fromRGB(150, 70, 255)
	local centro = dados.pos + Vector3.new(0, 0.12, 0)
	local base = disco(centro, 0.5, cor, 0.3)
	animar(base, dados.duracao * 0.5, { Size = Vector3.new(0.15, 6, 6) }, Enum.EasingStyle.Back)
	local partes = anel(centro + Vector3.new(0, 0.03, 0), 3.4, cor, 0.1, 14, 0.3)
	table.insert(partes, base)
	local a = ancora(centro)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(cor:Lerp(BRANCO, 0.4), cor)
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Size = sequencia({ { 0, 0.4 }, { 1, 0 } })
	e.Lifetime = NumberRange.new(0.5, 0.9)
	e.Speed = NumberRange.new(4, 8)
	e.SpreadAngle = Vector2.new(15, 15)
	e.Shape = Enum.ParticleEmitterShape.Disc
	e.Rate = 45
	e.Parent = a
	local l = Instance.new("PointLight")
	l.Color = cor
	l.Range = 14
	l.Brightness = 2
	l.Parent = a
	task.delay(dados.duracao, function()
		e.Enabled = false
		animar(l, 0.3, { Brightness = 0 })
		particulas(centro + Vector3.new(0, 1, 0), { cor = cor, quantidade = 16, velocidade = 12, vida = 0.4 })
	end)
	sumir(partes, 0.3, dados.duracao)
	Debris:AddItem(a, dados.duracao + 1)
end

function Vfx.moedas(dados)
	local destino = raizDoJogador(jogador)
	local ouro = Color3.fromRGB(255, 206, 70)
	for _ = 1, dados.quantidade do
		local moeda = Instance.new("Part")
		moeda.Shape = Enum.PartType.Cylinder
		moeda.Size = Vector3.new(0.18, 0.9, 0.9)
		moeda.Material = Enum.Material.Neon
		moeda.Color = ouro
		moeda.CanQuery = false
		moeda.CanTouch = false
		moeda.CastShadow = false
		moeda.CFrame = CFrame.new(dados.pos + Vector3.new(0, 1, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
		moeda.Parent = pasta
		moeda.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 22, math.random(18, 30), (math.random() - 0.5) * 22)
		moeda.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), 0)
		task.delay(0.9 + math.random() * 0.4, function()
			if not moeda.Parent then
				return
			end
			moeda.Anchored = true
			local alvo = destino and destino.Parent and destino.Position or moeda.Position + Vector3.new(0, 4, 0)
			local tween = animar(moeda, 0.35, { CFrame = CFrame.new(alvo), Size = Vector3.new(0.1, 0.4, 0.4) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween.Completed:Once(function()
				moeda:Destroy()
			end)
		end)
		Debris:AddItem(moeda, 3)
	end
end

-- Estouro genérico (usado na morte dos inimigos)
function Vfx.estouro(posicao: Vector3, cor: Color3, quantidade: number, velocidade: number)
	particulas(posicao, { cor = cor:Lerp(BRANCO, 0.3), cor2 = cor, quantidade = quantidade, tamanho = 0.7, velocidade = velocidade, vida = 0.6, gravidade = 20 })
	clarao(posicao, cor, 16, 0.3, 3)
end

------------------------------------------------------------------------
-- Entrada
------------------------------------------------------------------------

function Vfx.receber(dados)
	local funcao = Vfx.extras[dados.t] or (Vfx :: any)[dados.t]
	if type(funcao) == "function" then
		local ok, erro = pcall(funcao, dados)
		if not ok then
			warn("[Vfx] Erro no efeito " .. tostring(dados.t) .. ": " .. tostring(erro))
		end
	end
end

return Vfx
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000035">
          <Properties>
            <string name="Name">VisualInimigos</string>
            <ProtectedString name="Source"><![CDATA[-- Dá vida aos inimigos no computador do jogador: monta o modelo (Modelos.luau), anima
-- (andar, preparar golpe, golpear, conjurar, pular...), mostra barra de vida, piscar ao levar
-- dano, fogo, gelo, atordoamento, aura de elite e a explosão de peças na morte.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Modelos = require(script.Parent.Modelos)
local UI = require(script.Parent.UI)
local Vfx = require(script.Parent.Vfx)

local VisualInimigos = {}

local visuais = {} -- [modelo do servidor] = visual
local pasta = Instance.new("Folder")
pasta.Name = "InimigosVisuais"
pasta.Parent = workspace

local BRANCO = Color3.new(1, 1, 1)
local CORES_ELITE = {
	Blindado = Color3.fromRGB(205, 215, 235),
	Veloz = Color3.fromRGB(255, 232, 80),
	["Gélido"] = Color3.fromRGB(120, 210, 255),
	Explosivo = Color3.fromRGB(255, 120, 40),
	Gigante = Color3.fromRGB(255, 80, 80),
}
local ZERO = {}

------------------------------------------------------------------------
-- Montagem
------------------------------------------------------------------------

local function construirPeca(definicao, escala: number): (BasePart, SpecialMesh?)
	local parte: BasePart
	local malha = nil
	local forma = definicao.forma
	if forma == "cunha" then
		parte = Instance.new("WedgePart")
	elseif forma == "canto" then
		parte = Instance.new("CornerWedgePart")
	else
		local p = Instance.new("Part")
		if forma == "bola" then
			p.Shape = Enum.PartType.Ball
		elseif forma == "cilindro" then
			p.Shape = Enum.PartType.Cylinder
		end
		parte = p
	end
	parte.Size = definicao.tamanho * escala
	if forma == "elipse" then
		malha = Instance.new("SpecialMesh")
		malha.MeshType = Enum.MeshType.Sphere
		malha.Parent = parte
	end
	parte.Anchored = true
	parte.CanCollide = false
	parte.CanQuery = false
	parte.CanTouch = false
	parte.CastShadow = definicao.tamanho.Magnitude * escala > 1.5
	parte.Material = definicao.material or Enum.Material.SmoothPlastic
	parte.Color = definicao.cor
	parte.Transparency = definicao.transp or 0
	parte.TopSurface = Enum.SurfaceType.Smooth
	parte.BottomSurface = Enum.SurfaceType.Smooth
	return parte, malha
end

local function sequencia(pontos): NumberSequence
	local chaves = {}
	for _, ponto in pontos do
		table.insert(chaves, NumberSequenceKeypoint.new(ponto[1], ponto[2]))
	end
	return NumberSequence.new(chaves)
end

local function emissor(pai: Instance, cor: Color3, propriedades)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(cor:Lerp(BRANCO, 0.3), cor)
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Size = sequencia({ { 0, 0.35 }, { 1, 0 } })
	e.Transparency = sequencia({ { 0, 0.1 }, { 1, 1 } })
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(1, 3)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rate = 12
	for chave, valor in propriedades or {} do
		(e :: any)[chave] = valor
	end
	e.Parent = pai
	return e
end

-- Efeitos permanentes de cada modelo (alma, esporos, chama...)
local function criarEfeito(ancora: BasePart, tipo: string, cor: Color3, escala: number)
	if tipo == "chama" or tipo == "fogo" then
		local f = Instance.new("Fire")
		f.Size = (if tipo == "fogo" then 6 else 1.5) * escala
		f.Heat = if tipo == "fogo" then 8 else 3
		f.Color = cor
		f.SecondaryColor = Color3.fromRGB(255, 60, 10)
		f.Parent = ancora
		if tipo == "fogo" then
			emissor(ancora, cor, { Rate = 25, Speed = NumberRange.new(3, 7), Acceleration = Vector3.new(0, 6, 0), Size = sequencia({ { 0, 0.5 * escala }, { 1, 0 } }) })
		end
	elseif tipo == "alma" then
		emissor(ancora, cor, { Rate = 30, Speed = NumberRange.new(1, 4), Acceleration = Vector3.new(0, 5, 0), Size = sequencia({ { 0, 0.6 * escala }, { 1, 0 } }) })
	elseif tipo == "esporos" or tipo == "veneno" then
		emissor(ancora, cor, { Rate = 8, Speed = NumberRange.new(0.5, 1.5), Acceleration = Vector3.new(0, if tipo == "veneno" then -4 else 1, 0) })
	elseif tipo == "gelo" then
		emissor(ancora, cor, { Rate = 14, Speed = NumberRange.new(0.5, 2), Acceleration = Vector3.new(0, -2, 0), Size = sequencia({ { 0, 0.25 }, { 1, 0 } }) })
	else
		emissor(ancora, cor, { Rate = 10 })
	end
end

local function ordenarOssos(ossos): { string }
	local ordem, prontos = {}, { raiz = true }
	local restantes = 0
	for _ in ossos do
		restantes += 1
	end
	while restantes > 0 do
		local avancou = false
		for nome, o in ossos do
			if not prontos[nome] and prontos[o.pai] then
				table.insert(ordem, nome)
				prontos[nome] = true
				restantes -= 1
				avancou = true
			end
		end
		if not avancou then
			break -- osso com pai inexistente: ignorado
		end
	end
	return ordem
end

local function criarBarra(v)
	local modelo = v.modelo
	local elite = modelo:GetAttribute("Elite") or ""
	local temNome = elite ~= ""
	local placa = UI.criar("BillboardGui", {
		Adornee = v.raiz,
		Size = UDim2.fromOffset(120, if temNome then 34 else 14),
		StudsOffset = Vector3.new(0, (modelo:GetAttribute("AlturaBarra") or 4), 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 110,
		Enabled = temNome,
		Parent = pasta,
	})
	if temNome then
		local rotulo = UI.texto({
			Size = UDim2.new(1, 0, 0, 18),
			FontFace = UI.fontes.numero,
			Text = "★ " .. elite,
			TextColor3 = CORES_ELITE[elite] or UI.cores.ouro,
			Parent = placa,
		})
		UI.contorno(rotulo, 1.5, 0)
	end
	local barra = UI.barra({
		Parent = placa,
		Position = UDim2.new(0.5, 0, 1, -12),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(100, 10),
		Raio = 3,
		Cor = if temNome then Color3.fromRGB(230, 150, 40) else UI.cores.vida,
	})
	barra.rotulo.Visible = false
	v.placa = placa
	v.barra = barra
end

local function criarVisual(modelo: Model)
	local raiz = modelo:WaitForChild("HumanoidRootPart", 5) :: BasePart?
	local humanoid = modelo:WaitForChild("Humanoid", 5) :: Humanoid?
	if not raiz or not humanoid or not modelo.Parent then
		return nil
	end
	local tipo = modelo:GetAttribute("Tipo")
	local construtor = (Modelos :: any)[tipo] or Modelos.padrao
	local rig = construtor()
	local escala = (rig.escala or 1) * (modelo:GetAttribute("Escala") or 1)

	local visual = Instance.new("Model")
	visual.Name = "Visual_" .. tostring(tipo)

	local ossos = {}
	for nome, definicao in rig.ossos do
		ossos[nome] = {
			pai = definicao.pai,
			repouso = CFrame.new(definicao.pivo * escala),
			lado = definicao.lado,
			grupo = definicao.grupo,
			rx = 0, ry = 0, rz = 0, ox = 0, oy = 0, oz = 0,
			mundo = CFrame.identity,
		}
	end
	for _, o in ossos do
		local repousoPai = if o.pai == "raiz" then CFrame.identity else (ossos[o.pai] and ossos[o.pai].repouso or CFrame.identity)
		o.relativo = repousoPai:Inverse() * o.repouso
	end

	local pecas = {}
	local function adicionar(parte: BasePart, nomeOsso: string, cfRepouso: CFrame, extra)
		local o = ossos[nomeOsso] or ossos.corpo
		if not o then
			parte:Destroy()
			return
		end
		parte.Parent = visual
		table.insert(pecas, {
			parte = parte,
			osso = if ossos[nomeOsso] then nomeOsso else "corpo",
			local_ = o.repouso:Inverse() * cfRepouso,
			corBase = parte.Color,
			malha = extra and extra.malha,
			olho = extra and extra.olho,
			geleia = extra and extra.geleia,
			ancora = extra and extra.ancora,
		})
	end

	for _, definicao in rig.pecas do
		local parte, malha = construirPeca(definicao, escala)
		local cf = CFrame.new(definicao.cf.Position * escala) * definicao.cf.Rotation
		adicionar(parte, definicao.osso, cf, { malha = malha, olho = definicao.olho, geleia = definicao.geleia })
	end

	-- Âncoras invisíveis para luzes e efeitos
	local ancoraCorpo = nil
	local function novaAncora(nomeOsso: string, pos: Vector3): BasePart
		local a = Instance.new("Part")
		a.Size = Vector3.one * 0.2
		a.Transparency = 1
		a.Anchored = true
		a.CanCollide = false
		a.CanQuery = false
		a.CanTouch = false
		adicionar(a, nomeOsso, CFrame.new(pos * escala), { ancora = true })
		return a
	end
	for _, luz in rig.luzes or {} do
		local a = novaAncora(luz.osso, luz.pos)
		local l = Instance.new("PointLight")
		l.Color = luz.cor
		l.Range = luz.alcance * math.sqrt(escala)
		l.Brightness = luz.brilho
		l.Parent = a
	end
	for _, efeito in rig.efeitos or {} do
		criarEfeito(novaAncora(efeito.osso, efeito.pos), efeito.tipo, efeito.cor, escala)
	end
	if ossos.corpo then
		local pivoCorpo = rig.ossos.corpo.pivo
		ancoraCorpo = novaAncora("corpo", pivoCorpo + Vector3.new(0, (rig.altura or 2) * 0.5, 0))
	end
	visual.Parent = pasta

	local v = {
		modelo = modelo,
		raiz = raiz,
		humanoid = humanoid,
		rig = rig,
		escala = escala,
		alturaRaiz = humanoid.HipHeight + raiz.Size.Y / 2,
		ossos = ossos,
		ordem = ordenarOssos(ossos),
		pecas = pecas,
		visual = visual,
		ancoraCorpo = ancoraCorpo,
		ultimaPos = raiz.Position,
		velocidade = 0,
		fase = math.random() * 6,
		acao = "",
		acaoInicio = 0,
		nascimento = os.clock(),
		vidaAnterior = modelo:GetAttribute("Vida") or 1,
		flashAte = 0,
		flashAtivo = false,
		impacto = 0,
		chefe = modelo:GetAttribute("Chefe") == true,
		conexoes = {},
	}

	if not v.chefe then
		criarBarra(v)
	end

	-- Elite: aura colorida
	local elite = modelo:GetAttribute("Elite") or ""
	if elite ~= "" and ancoraCorpo then
		local cor = CORES_ELITE[elite] or UI.cores.ouro
		emissor(ancoraCorpo, cor, {
			Rate = 18,
			Speed = NumberRange.new(2, 4),
			Acceleration = Vector3.new(0, 4, 0),
			Size = sequencia({ { 0, 0.5 * escala }, { 1, 0 } }),
			Shape = Enum.ParticleEmitterShape.Sphere,
		})
		local l = Instance.new("PointLight")
		l.Color = cor
		l.Range = 10 * escala
		l.Brightness = 1.5
		l.Parent = ancoraCorpo
	end
	return v
end

------------------------------------------------------------------------
-- Reações aos atributos vindos do servidor
------------------------------------------------------------------------

local function atualizarVida(v)
	local vida = v.modelo:GetAttribute("Vida") or 0
	local maxima = v.modelo:GetAttribute("VidaMax") or 1
	if vida < v.vidaAnterior then
		v.flashAte = os.clock() + 0.07
		v.impacto = 1
		if v.placa then
			v.placa.Enabled = true
		end
	end
	v.vidaAnterior = vida
	if v.barra then
		v.barra.definir(vida / math.max(1, maxima))
	end
end

local function atualizarAcao(v)
	local texto = v.modelo:GetAttribute("Acao") or ""
	v.acao = string.match(texto, "^([^|]*)") or ""
	v.acaoInicio = os.clock()
end

local function atualizarEstados(v)
	local modelo = v.modelo
	local ancora = v.ancoraCorpo
	if not ancora then
		return
	end
	local queimando = modelo:GetAttribute("Queimando") == true
	local fogo = ancora:FindFirstChild("Queimando")
	if queimando and not fogo then
		local f = Instance.new("Fire")
		f.Name = "Queimando"
		f.Size = 4 * v.escala
		f.Heat = 6
		f.Parent = ancora
	elseif not queimando and fogo then
		fogo:Destroy()
	end

	local lento = modelo:GetAttribute("Lento") == true
	local gelo = ancora:FindFirstChild("Lento")
	if lento and not gelo then
		local e = emissor(ancora, Color3.fromRGB(150, 220, 255), { Rate = 20, Shape = Enum.ParticleEmitterShape.Sphere, Speed = NumberRange.new(0.5, 1.5) })
		e.Name = "Lento"
	elseif not lento and gelo then
		gelo:Destroy()
	end

	local atordoado = modelo:GetAttribute("Atordoado") == true
	if atordoado and not v.estrelas then
		v.estrelas = {}
		for _ = 1, 3 do
			local estrela = Instance.new("Part")
			estrela.Shape = Enum.PartType.Ball
			estrela.Size = Vector3.one * 0.45
			estrela.Material = Enum.Material.Neon
			estrela.Color = Color3.fromRGB(255, 230, 90)
			estrela.Anchored = true
			estrela.CanCollide = false
			estrela.CanQuery = false
			estrela.CanTouch = false
			estrela.Parent = v.visual
			table.insert(v.estrelas, estrela)
		end
	elseif not atordoado and v.estrelas then
		for _, estrela in v.estrelas do
			estrela:Destroy()
		end
		v.estrelas = nil
	end

	if modelo:GetAttribute("Furioso") == true and not v.furioso then
		v.furioso = true
		for _, peca in v.pecas do
			if peca.olho then
				peca.corBase = Color3.fromRGB(255, 40, 40)
				peca.parte.Color = peca.corBase
			end
		end
		emissor(ancora, Color3.fromRGB(255, 60, 40), { Rate = 30, Speed = NumberRange.new(3, 6), Acceleration = Vector3.new(0, 6, 0), Size = sequencia({ { 0, 0.8 * v.escala }, { 1, 0 } }) })
	end
end

------------------------------------------------------------------------
-- Poses (ângulos de cada osso conforme a ação)
------------------------------------------------------------------------

local function poseBipede(v, t: number, andar: number, alvos)
	local s = math.sin(v.fase)
	local escala = v.escala
	local curvado = if v.rig.curvado then -0.25 else 0
	alvos.corpo = {
		rx = curvado - 0.08 * andar,
		oy = math.abs(math.cos(v.fase)) * 0.12 * andar * escala + math.sin(t * 2.2) * 0.04 * escala,
	}
	alvos.pernaE = { rx = s * 0.7 * andar }
	alvos.pernaD = { rx = -s * 0.7 * andar }
	alvos.bracoE = { rx = -s * 0.5 * andar + math.sin(t * 1.7) * 0.04, rz = -0.08 }
	alvos.bracoD = { rx = s * 0.5 * andar + math.sin(t * 1.7 + 1) * 0.04, rz = 0.08 }
	alvos.cabeca = { rx = math.sin(t * 1.3) * 0.05 }
	alvos.capa = { rx = -(0.1 + 0.4 * andar) + math.sin(t * 2) * 0.05 }
	alvos.cauda = { ry = math.sin(t * 4) * 0.35 }
	alvos.asaE = { ry = math.sin(t * 16) * 0.5 }
	alvos.asaD = { ry = -math.sin(t * 16) * 0.5 }

	local acao, at = v.acao, v.acaoT
	if acao == "preparar" then
		alvos.bracoD = { rx = 3.3, rz = 0.2 }
		alvos.bracoE = { rx = 0.6, rz = -0.2 }
		alvos.corpo.rx += 0.18
		alvos.corpo.ry = 0.3
	elseif acao == "golpe" then
		alvos.bracoD = { rx = 0.5, rz = -0.2, rapido = true }
		alvos.bracoE = { rx = -0.3 }
		alvos.corpo.rx -= 0.3
		alvos.corpo.ry = -0.25
		alvos.corpo.oz = -0.4 * escala
		alvos.corpo.rapido = true
	elseif acao == "prepararGiro" then
		alvos.bracoE = { rz = -1.4 }
		alvos.bracoD = { rz = 1.4 }
		alvos.corpo.ry = 0.9
	elseif acao == "giro" then
		alvos.bracoE = { rz = -1.4, rapido = true }
		alvos.bracoD = { rz = 1.4, rapido = true }
		alvos.corpo.ry = -at * 22
		alvos.corpo.direto = true
	elseif acao == "conjurar" then
		alvos.bracoE = { rx = 2.3, rz = -0.3 }
		alvos.bracoD = { rx = 2.3, rz = 0.3 }
		alvos.corpo.rx += 0.12
		alvos.cabeca = { rx = 0.2 }
	elseif acao == "disparo" then
		alvos.bracoE = { rx = 1.57, rapido = true }
		alvos.bracoD = { rx = 1.45, ry = 0.3, rapido = true }
	elseif acao == "prepararInvestida" then
		alvos.corpo.rx -= 0.45
		alvos.corpo.oy -= 0.4 * escala
		alvos.bracoE = { rx = -0.7 }
		alvos.bracoD = { rx = -0.7 }
		alvos.pernaE = { rx = 0.5 }
		alvos.pernaD = { rx = -0.3 }
	elseif acao == "investida" then
		local corrida = math.sin(t * 25)
		alvos.corpo.rx -= 0.6
		alvos.bracoE = { rx = 1.2 }
		alvos.bracoD = { rx = 1.2 }
		alvos.pernaE = { rx = corrida * 0.9, rapido = true }
		alvos.pernaD = { rx = -corrida * 0.9, rapido = true }
	elseif acao == "prepararSalto" then
		alvos.corpo.oy -= 0.7 * escala
		alvos.corpo.rx -= 0.3
		alvos.bracoE = { rx = -0.8 }
		alvos.bracoD = { rx = -0.8 }
		alvos.pernaE = { rx = 0.7 }
		alvos.pernaD = { rx = 0.7 }
	elseif acao == "salto" then
		alvos.bracoE = { rx = 2.6 }
		alvos.bracoD = { rx = 2.6 }
		alvos.pernaE = { rx = 0.9 }
		alvos.pernaD = { rx = -0.3 }
	elseif acao == "prepararExplosao" then
		alvos.corpo.rx += math.sin(t * 60) * 0.08
	end
	if v.atordoado then
		alvos.corpo.rx = -0.35
		alvos.cabeca = { rx = -0.3, ry = math.sin(t * 3) * 0.4 }
		alvos.bracoE = { rx = 0.2, rz = -0.2 }
		alvos.bracoD = { rx = 0.2, rz = 0.2 }
	end
	alvos.corpo.rx += v.impacto * 0.3
end

local function poseFlutuante(v, t: number, andar: number, alvos)
	local escala = v.escala
	alvos.corpo = { oy = math.sin(t * 2) * 0.35 * escala, rx = -0.15 * andar }
	alvos.manto = { rx = -0.35 * andar + math.sin(t * 3) * 0.08 }
	alvos.bracoE = { rx = math.sin(t * 1.5) * 0.15, rz = -0.15 }
	alvos.bracoD = { rx = math.sin(t * 1.5 + 1) * 0.15, rz = 0.15 }
	alvos.cabeca = { rx = math.sin(t * 1.1) * 0.06 }
	alvos.base = { ry = t * 5, direto = true }
	alvos.orbita = { ry = t * 1.5, direto = true }
	local acao, at = v.acao, v.acaoT
	if acao == "conjurar" or acao == "prepararGiro" then
		alvos.bracoE = { rx = 2.4, rz = -0.4 }
		alvos.bracoD = { rx = 2.4, rz = 0.4 }
		alvos.corpo.oy += 0.5 * escala
	elseif acao == "disparo" then
		alvos.bracoD = { rx = 1.6, rapido = true }
	elseif acao == "preparar" then
		alvos.bracoD = { rx = 3, rz = 0.2 }
		alvos.corpo.rx += 0.15
	elseif acao == "golpe" then
		alvos.bracoD = { rx = 0.6, rapido = true }
		alvos.corpo.rx -= 0.25
		alvos.corpo.oz = -0.4 * escala
	elseif acao == "giro" then
		alvos.corpo.ry = -at * 20
		alvos.corpo.direto = true
		alvos.bracoE = { rz = -1.4 }
		alvos.bracoD = { rz = 1.4 }
	end
	if v.atordoado then
		alvos.corpo.rx = -0.3
		alvos.corpo.oy = -0.5 * escala
	end
	alvos.corpo.rx += v.impacto * 0.3
end

local function poseQuadrupede(v, t: number, andar: number, alvos)
	local s = math.sin(v.fase * 1.2)
	local escala = v.escala
	alvos.corpo = { oy = math.abs(math.cos(v.fase * 1.2)) * 0.08 * andar * escala }
	alvos.pernaFE = { rx = s * 0.7 * andar }
	alvos.pernaTD = { rx = s * 0.7 * andar }
	alvos.pernaFD = { rx = -s * 0.7 * andar }
	alvos.pernaTE = { rx = -s * 0.7 * andar }
	alvos.cabeca = { rx = math.sin(t * 3) * 0.06 }
	alvos.cauda = { ry = math.sin(t * 6) * 0.5 }
	local acao = v.acao
	if acao == "preparar" then
		alvos.corpo.rx = 0.25
		alvos.cabeca = { rx = 0.3 }
	elseif acao == "golpe" then
		alvos.corpo.rx = -0.15
		alvos.corpo.oz = -0.5 * escala
		alvos.corpo.rapido = true
	end
	alvos.corpo.rx = (alvos.corpo.rx or 0) + v.impacto * 0.2
end

local function poseAranha(v, t: number, andar: number, alvos)
	local escala = v.escala
	alvos.corpo = { oy = math.sin(v.fase * 2) * 0.08 * andar * escala + math.sin(t * 2) * 0.03 * escala }
	for nome, o in v.ossos do
		if o.lado and string.sub(nome, 1, 5) == "perna" then
			local fase = v.fase * 1.2 + (if o.grupo == 1 then math.pi else 0)
			alvos[nome] = {
				ry = math.sin(fase) * 0.35 * andar,
				rz = (math.max(0, math.cos(fase)) * 0.3 * andar + math.sin(t * 2 + o.grupo) * 0.03) * o.lado,
			}
		end
	end
	local acao = v.acao
	if acao == "preparar" or acao == "prepararSalto" or acao == "conjurar" then
		alvos.corpo.rx = 0.35
		alvos.corpo.oy -= 0.3 * escala
	elseif acao == "golpe" then
		alvos.corpo.rx = -0.2
		alvos.corpo.oz = -0.6 * escala
		alvos.corpo.rapido = true
	elseif acao == "salto" then
		for nome, o in v.ossos do
			if o.lado and string.sub(nome, 1, 5) == "perna" then
				alvos[nome] = { rz = 0.5 * o.lado }
			end
		end
	end
	alvos.corpo.rx = (alvos.corpo.rx or 0) + v.impacto * 0.2
end

-- Gosmas: em vez de ossos, o corpo estica e encolhe
local function poseGosma(v, t: number, andar: number, alvos)
	local escala = v.escala
	local s = math.sin(v.fase * 1.3)
	local sy, sxz = 1 + math.sin(t * 3) * 0.04, 1 - math.sin(t * 3) * 0.02
	local pulo = 0
	if andar > 0.1 then
		sy = 1 + 0.16 * s * andar
		sxz = 1 - 0.08 * s * andar
		pulo = math.max(0, s) * 0.7 * andar * escala
	end
	local oz = 0
	local acao, at = v.acao, v.acaoT
	if acao == "preparar" or acao == "prepararGiro" or acao == "conjurar" then
		sy, sxz = 0.72, 1.22
	elseif acao == "golpe" or acao == "giro" then
		sy, sxz = 1.3, 0.86
		oz = -0.6 * escala
	elseif acao == "prepararExplosao" then
		local inchar = 1 + math.min(at, 1) * 0.35 + math.sin(t * 40) * 0.05
		sy, sxz = inchar, inchar
	end
	sy += v.impacto * -0.15
	sxz += v.impacto * 0.1
	v.escalaGeleia = Vector3.new(sxz, sy, sxz)
	alvos.corpo = { oy = pulo, oz = oz, rapido = acao == "golpe" }
end

local POSES = {
	bipede = poseBipede,
	flutuante = poseFlutuante,
	quadrupede = poseQuadrupede,
	aranha = poseAranha,
	gosma = poseGosma,
}

------------------------------------------------------------------------
-- Atualização a cada frame
------------------------------------------------------------------------

local function atualizarVisual(v, dt: number, agora: number, partes, cframes)
	local raizCF = v.raiz.CFrame
	local pos = raizCF.Position
	local deslocamento = pos - v.ultimaPos
	v.ultimaPos = pos
	local velocidade = Vector3.new(deslocamento.X, 0, deslocamento.Z).Magnitude / math.max(dt, 1 / 240)
	if velocidade > 120 then
		velocidade = 0 -- teleporte
	end
	v.velocidade += (velocidade - v.velocidade) * math.min(1, dt * 8)
	local andar = math.clamp(v.velocidade / 12, 0, 1)
	v.fase += dt * (2 + v.velocidade * 0.6) * (v.rig.ritmo or 1)
	v.acaoT = agora - v.acaoInicio
	if (v.acao == "golpe" or v.acao == "disparo" or v.acao == "giro") and v.acaoT > 1.2 then
		v.acao = ""
	end
	v.atordoado = v.estrelas ~= nil
	v.impacto = math.max(0, v.impacto - dt * 6)

	local base = raizCF * CFrame.new(0, -v.alturaRaiz, 0)
	if v.salto then
		local s = (agora - v.salto.inicio) / v.salto.duracao
		if s >= 1 then
			v.salto = nil
		else
			local p = v.salto.de:Lerp(v.salto.para, s) + Vector3.new(0, v.salto.altura * 4 * s * (1 - s), 0)
			base = CFrame.new(p - Vector3.new(0, v.alturaRaiz, 0)) * raizCF.Rotation
		end
	end
	local idade = agora - v.nascimento
	if idade < 0.4 then
		base *= CFrame.new(0, -(1 - idade / 0.4) * 3 * v.escala, 0)
	end

	local alvos = {}
	local pose = POSES[v.rig.estilo] or poseBipede
	pose(v, agora, andar, alvos)

	for _, nome in v.ordem do
		local o = v.ossos[nome]
		local alvo = alvos[nome] or ZERO
		if alvo.direto then
			o.rx, o.ry, o.rz = alvo.rx or 0, alvo.ry or 0, alvo.rz or 0
		else
			local k = math.min(1, dt * (if alvo.rapido then 30 else 12))
			o.rx += ((alvo.rx or 0) - o.rx) * k
			o.ry += ((alvo.ry or 0) - o.ry) * k
			o.rz += ((alvo.rz or 0) - o.rz) * k
		end
		local k = math.min(1, dt * (if alvo.rapido then 30 else 12))
		o.ox += ((alvo.ox or 0) - o.ox) * k
		o.oy += ((alvo.oy or 0) - o.oy) * k
		o.oz += ((alvo.oz or 0) - o.oz) * k
		local paiCF = if o.pai == "raiz" then base else v.ossos[o.pai].mundo
		o.mundo = paiCF * o.relativo * CFrame.new(o.ox, o.oy, o.oz) * CFrame.Angles(o.rx, o.ry, o.rz)
	end

	-- Piscar branco ao levar dano
	if agora < v.flashAte and not v.flashAtivo then
		v.flashAtivo = true
		for _, peca in v.pecas do
			if not peca.ancora then
				peca.parte.Color = BRANCO
			end
		end
	elseif v.flashAtivo and agora >= v.flashAte then
		v.flashAtivo = false
		for _, peca in v.pecas do
			peca.parte.Color = peca.corBase
		end
	end

	local geleia = v.escalaGeleia
	for _, peca in v.pecas do
		local o = v.ossos[peca.osso]
		local cf
		if geleia and peca.osso == "corpo" then
			cf = o.mundo * CFrame.new(peca.local_.Position * geleia) * peca.local_.Rotation
			if peca.malha and peca.geleia then
				peca.malha.Scale = geleia
			end
		else
			cf = o.mundo * peca.local_
		end
		table.insert(partes, peca.parte)
		table.insert(cframes, cf)
	end

	if v.estrelas then
		local cabeca = v.ossos.cabeca or v.ossos.corpo
		local centro = cabeca.mundo.Position + Vector3.new(0, 2.2 * v.escala, 0)
		for i, estrela in v.estrelas do
			local angulo = agora * 6 + i * (math.pi * 2 / 3)
			table.insert(partes, estrela)
			table.insert(cframes, CFrame.new(centro + Vector3.new(math.cos(angulo), 0, math.sin(angulo)) * 1.2 * v.escala))
		end
	end
end

------------------------------------------------------------------------
-- Morte: as peças se soltam e voam
------------------------------------------------------------------------

local function morrer(v)
	for _, conexao in v.conexoes do
		conexao:Disconnect()
	end
	if v.placa then
		v.placa:Destroy()
	end
	if v.estrelas then
		for _, estrela in v.estrelas do
			estrela:Destroy()
		end
	end
	local centro = v.ultimaPos
	Vfx.estouro(centro, v.rig.cor or BRANCO, if v.chefe then 60 else 18, if v.chefe then 40 else 18)
	if v.chefe then
		Vfx.tremerEm(centro, 3, 0.8)
	end
	for _, peca in v.pecas do
		local parte = peca.parte
		if peca.ancora then
			parte:Destroy()
		else
			parte.Anchored = false
			parte.CanCollide = true
			local fora = parte.Position - centro
			fora = if fora.Magnitude > 0.1 then fora.Unit else Vector3.new(0, 1, 0)
			parte.AssemblyLinearVelocity = fora * math.random(10, 24) + Vector3.new(0, math.random(14, 28), 0)
			parte.AssemblyAngularVelocity = Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10))
			task.delay(0.6 + math.random() * 0.3, function()
				if parte.Parent then
					TweenService:Create(parte, TweenInfo.new(0.5), { Transparency = 1 }):Play()
				end
			end)
		end
	end
	Debris:AddItem(v.visual, 1.6)
end

------------------------------------------------------------------------
-- API
------------------------------------------------------------------------

-- Efeito de salto vindo do servidor: o modelo voa num arco até o destino
function VisualInimigos.salto(dados)
	local v = visuais[dados.modelo]
	if v then
		local distancia = (dados.para - dados.de).Magnitude
		v.salto = {
			inicio = os.clock(),
			de = dados.de,
			para = dados.para,
			duracao = dados.duracao,
			altura = math.max(6, distancia * 0.35),
		}
	end
end

local function adicionar(modelo: Instance)
	if not modelo:IsA("Model") or visuais[modelo] then
		return
	end
	task.spawn(function()
		local v = criarVisual(modelo)
		if not v then
			return
		end
		if not modelo.Parent then
			v.visual:Destroy()
			return
		end
		visuais[modelo] = v
		atualizarVida(v)
		atualizarAcao(v)
		atualizarEstados(v)
		table.insert(v.conexoes, modelo:GetAttributeChangedSignal("Vida"):Connect(function()
			atualizarVida(v)
		end))
		table.insert(v.conexoes, modelo:GetAttributeChangedSignal("Acao"):Connect(function()
			atualizarAcao(v)
		end))
		for _, atributo in { "Queimando", "Lento", "Atordoado", "Furioso" } do
			table.insert(v.conexoes, modelo:GetAttributeChangedSignal(atributo):Connect(function()
				atualizarEstados(v)
			end))
		end
	end)
end

local function remover(modelo: Instance)
	local v = visuais[modelo]
	if v then
		visuais[modelo] = nil
		morrer(v)
	end
end

function VisualInimigos.iniciar()
	for _, modelo in CollectionService:GetTagged("Inimigo") do
		adicionar(modelo)
	end
	CollectionService:GetInstanceAddedSignal("Inimigo"):Connect(adicionar)
	CollectionService:GetInstanceRemovedSignal("Inimigo"):Connect(remover)

	RunService.RenderStepped:Connect(function(dt)
		local agora = os.clock()
		local partes, cframes = {}, {}
		for modelo, v in visuais do
			if v.raiz.Parent then
				atualizarVisual(v, dt, agora, partes, cframes)
			else
				remover(modelo)
			end
		end
		if #partes > 0 then
			workspace:BulkMoveTo(partes, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end)
end

return VisualInimigos
