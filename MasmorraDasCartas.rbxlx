      <Item class="ModuleScript" referent="RBX00000007">
        <Properties>
          <string name="Name">Cartas</string>
          <ProtectedString name="Source"><![CDATA[-- Cartas de poder (11 universais e 11 de cada classe). "classe = nil" aparece para todos; as outras só para aquela classe.
-- "efeitos" soma valores aos atributos do jogador (veja Combate.calcularStats no servidor).

local Cartas = {}

local function carta(id, nome, icone, raridade, classe, maxPilha, descricao, efeitos)
	return {
		id = id,
		nome = nome,
		icone = icone,
		raridade = raridade,
		classe = classe,
		maxPilha = maxPilha,
		descricao = descricao,
		efeitos = efeitos,
	}
end

Cartas.lista = {
	-- Universais ------------------------------------------------------------
	carta("coracao", "Coração Forte", "❤️", "Comum", nil, 8, "+25 de vida máxima e cura total", { vidaPlana = 25 }),
	carta("forca", "Força Bruta", "💪", "Comum", nil, 8, "+15% de dano", { danoPct = 0.15 }),
	carta("botas", "Botas Ligeiras", "👟", "Comum", nil, 4, "+10% de velocidade", { velocidadePct = 0.1 }),
	carta("regen", "Regeneração", "🌿", "Comum", nil, 5, "Recupera 1,5 de vida por segundo", { regen = 1.5 }),
	carta("vampiro", "Vampirismo", "🦇", "Rara", nil, 4, "Cada acerto cura 2 de vida", { rouboVida = 2 }),
	carta("critico", "Olhar Mortal", "🎯", "Rara", nil, 4, "+12% de chance de crítico (dano triplo)", { critico = 0.12 }),
	carta("ampulheta", "Ampulheta", "⏳", "Rara", nil, 3, "A habilidade recarrega 15% mais rápido", { recargaPct = 0.15 }),
	carta("brasa", "Coração em Brasa", "🔥", "Rara", nil, 3, "O Supremo carrega 30% mais rápido", { cargaPct = 0.3 }),
	carta("ganancia", "Ganância", "💰", "Rara", nil, 3, "+50% de ouro, mas -15 de vida máxima", { ouroPct = 0.5, vidaPlana = -15 }),
	carta("segunda", "Segunda Chance", "👼", "Lendaria", nil, 1, "Ao cair, levanta na hora com metade da vida (uma vez)", { segundaChance = 1 }),
	carta("midas", "Rei Midas", "👑", "Lendaria", nil, 1, "Dobra todo o ouro que você ganha", { ouroMult = 1 }),

	-- Cavaleiro ------------------------------------------------------------
	carta("laminaLarga", "Lâmina Larga", "🗡️", "Comum", "cavaleiro", 4, "+25% de alcance dos cortes", { alcancePct = 0.25 }),
	carta("ritmo", "Ritmo de Batalha", "🥁", "Comum", "cavaleiro", 5, "Ataca 15% mais rápido", { ataqueVelPct = 0.15 }),
	carta("armadura", "Armadura Pesada", "🧱", "Comum", "cavaleiro", 4, "Recebe 10% menos dano", { armadura = 0.1 }),
	carta("espinhos", "Espinhos", "🌵", "Rara", "cavaleiro", 3, "Quem te acerta leva o mesmo dano de volta", { espinhos = 1 }),
	carta("investida", "Investida Brutal", "🐗", "Rara", "cavaleiro", 2, "Sua esquiva atropela os inimigos no caminho", { investida = 1 }),
	carta("escudo", "Escudo Abençoado", "🛡️", "Epica", "cavaleiro", 1, "Bloqueia o primeiro golpe que você leva em cada sala", { escudo = 1 }),
	carta("ondaCorte", "Onda de Corte", "🌊", "Epica", "cavaleiro", 2, "O golpe final do combo solta uma onda de energia", { ondaCorte = 1 }),
	carta("redemoinhoFogo", "Redemoinho Flamejante", "🌪️", "Epica", "cavaleiro", 1, "O Redemoinho dura 50% a mais e queima os inimigos", { redemoinhoFogo = 1 }),
	carta("gigante", "Gigante", "🗿", "Epica", "cavaleiro", 2, "Fica 30% maior: +50 de vida e +20% de alcance, mas 8% mais lento", { gigante = 1 }),
	carta("dragao", "Fúria do Dragão", "🐉", "Lendaria", "cavaleiro", 1, "Todo golpe solta uma rajada de fogo à frente", { dragao = 1 }),
	carta("protetor", "Aura do Protetor", "✨", "Lendaria", "cavaleiro", 1, "Aliados perto de você recebem 30% menos dano", { protetor = 1 }),

	-- Mago -----------------------------------------------------------------
	carta("orbeMaior", "Orbe Maior", "🔮", "Comum", "mago", 4, "+20% de dano e orbes maiores", { danoPct = 0.2, tamanhoPct = 0.2 }),
	carta("canalizacao", "Canalização", "🌀", "Comum", "mago", 5, "Lança orbes 15% mais rápido", { ataqueVelPct = 0.15 }),
	carta("explosaoArcana", "Explosão Arcana", "💠", "Comum", "mago", 3, "A explosão dos orbes fica 40% maior", { explosaoPct = 0.4 }),
	carta("missil", "Míssil Duplo", "🎆", "Rara", "mago", 2, "+1 orbe por ataque", { projeteisExtra = 1 }),
	carta("gelo", "Toque Gélido", "❄️", "Rara", "mago", 2, "Orbes deixam os inimigos 35% mais lentos", { lentidao = 1 }),
	carta("barreira", "Barreira Arcana", "🌐", "Epica", "mago", 1, "Bloqueia o primeiro golpe que você leva em cada sala", { escudo = 1 }),
	carta("raio", "Corrente Elétrica", "⚡", "Epica", "mago", 3, "Cada acerto solta raios em 2 inimigos próximos", { raios = 2 }),
	carta("chuvaMeteoros", "Chuva de Meteoros", "☄️", "Epica", "mago", 2, "O Meteoro cai mais 2 vezes", { meteoros = 2 }),
	carta("perfurante", "Orbe Perfurante", "📌", "Epica", "mago", 2, "Orbes atravessam mais 2 inimigos", { perfuracao = 2 }),
	carta("combustao", "Combustão", "💥", "Lendaria", "mago", 1, "Inimigos explodem ao morrer e ferem os vizinhos", { explosaoMorte = 1 }),
	carta("arquimago", "Arquimago", "🧙", "Lendaria", "mago", 1, "Cada inimigo derrotado reduz 1s da recarga da habilidade", { arquimago = 1 }),
	carta("fonteArcana", "Fonte Arcana", "💧", "Comum", "mago", 4, "A mana volta 35% mais rápido", { manaRegenPct = 0.35 }),
	carta("reservatorio", "Reservatório Arcano", "🏺", "Comum", "mago", 3, "+40 de mana máxima", { manaPlana = 40 }),
	carta("sifao", "Sifão de Almas", "👻", "Rara", "mago", 3, "Cada inimigo derrotado devolve 10 de mana", { manaAbate = 10 }),
	carta("menteSerena", "Mente Serena", "🧘", "Epica", "mago", 2, "Magias custam 20% menos mana", { economiaMana = 0.2 }),

	-- Arqueiro ---------------------------------------------------------------
	carta("pontaAfiada", "Ponta Afiada", "📍", "Comum", "arqueiro", 5, "+15% de dano", { danoPct = 0.15 }),
	carta("maoRapida", "Mão Rápida", "🤚", "Comum", "arqueiro", 5, "Atira 15% mais rápido", { ataqueVelPct = 0.15 }),
	carta("passosLeves", "Passos Leves", "🍃", "Comum", "arqueiro", 3, "+10% de velocidade e esquiva 25% mais rápida", { velocidadePct = 0.1, esquivaPct = 0.25 }),
	carta("multiplo", "Tiro Múltiplo", "🎇", "Rara", "arqueiro", 3, "+2 flechas em leque", { projeteisExtra = 2 }),
	carta("perfurantes", "Flechas Perfurantes", "➡️", "Rara", "arqueiro", 3, "Flechas atravessam mais 1 inimigo", { perfuracao = 1 }),
	carta("flechasFogo", "Flechas de Fogo", "🔥", "Rara", "arqueiro", 3, "Flechas queimam o inimigo por 3 segundos", { queimadura = 0.3 }),
	carta("aguia", "Olho de Águia", "🦅", "Rara", "arqueiro", 3, "+10% de crítico e flechas mais velozes", { critico = 0.1, velProjPct = 0.25 }),
	carta("ricochete", "Ricochete", "↪️", "Epica", "arqueiro", 2, "Flechas quicam em mais 2 inimigos", { ricochete = 2 }),
	carta("torrencial", "Chuva Torrencial", "🌧️", "Epica", "arqueiro", 2, "A Chuva de Flechas fica 40% maior e dura mais", { chuvaPct = 0.4 }),
	carta("fantasma", "Tiro Fantasma", "👻", "Lendaria", "arqueiro", 1, "O golpe final do combo dispara uma flecha gigante que atravessa tudo", { fantasma = 1 }),
	carta("cacador", "Caçador", "🏹", "Lendaria", "arqueiro", 1, "Críticos causam 5x de dano em vez de 3x", { multCritico = 2 }),

	-- Assassino --------------------------------------------------------------
	carta("laminasAfiadas", "Lâminas Afiadas", "🔪", "Comum", "assassino", 5, "+15% de dano", { danoPct = 0.15 }),
	carta("reflexos", "Reflexos", "⚡", "Comum", "assassino", 5, "Ataca 15% mais rápido", { ataqueVelPct = 0.15 }),
	carta("sombraAgil", "Sombra Ágil", "💨", "Comum", "assassino", 3, "+10% de velocidade e esquiva 20% mais rápida", { velocidadePct = 0.1, esquivaPct = 0.2 }),
	carta("corteProfundo", "Corte Profundo", "🩸", "Rara", "assassino", 3, "O sangramento acumula +2 vezes e causa 40% a mais de dano", { sangrePilhas = 2, sangrePct = 0.4 }),
	carta("pontoFraco", "Ponto Fraco", "🎯", "Rara", "assassino", 3, "Golpes pelas costas causam +40% de dano", { costasPct = 0.4 }),
	carta("sangria", "Sede de Sangue", "🦇", "Rara", "assassino", 3, "Críticos curam 4 de vida", { curaCritico = 4 }),
	carta("sombraPersistente", "Sombra Persistente", "🌑", "Epica", "assassino", 2, "O Passo Sombrio recarga 30% mais rápido", { recargaPct = 0.3 }),
	carta("lequeAdagas", "Leque de Adagas", "🎴", "Epica", "assassino", 2, "O golpe final do combo arremessa 3 adagas em leque", { leque = 1 }),
	carta("contraAtaque", "Contra-Ataque", "🔄", "Epica", "assassino", 1, "Depois de esquivar, o próximo golpe é crítico garantido", { contraAtaque = 1 }),
	carta("execucao", "Execução", "☠️", "Lendaria", "assassino", 1, "Golpes acabam na hora com inimigos abaixo de 20% de vida (chefes levam dano dobrado)", { execucao = 1 }),
	carta("milCortes", "Mil Cortes", "🌸", "Lendaria", "assassino", 1, "Cada crítico tira 0,5s da recarga do Passo Sombrio", { milCortes = 1 }),
}

Cartas.porId = {}
for _, c in Cartas.lista do
	Cartas.porId[c.id] = c
end

return Cartas
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000008">
        <Properties>
          <string name="Name">Classes</string>
          <ProtectedString name="Source"><![CDATA[-- As quatro classes jogáveis. Os números de cada classe ficam aqui.
-- As cartas de cada classe ficam em Cartas.luau (campo "classe").
--
-- Cada classe tem pontos fortes e fracos claros:
--   Cavaleiro: aguenta muito e protege o grupo, mas é lento e só bate de perto
--   Mago:      destrói grupos de longe, mas é frágil e ataca devagar
--   Arqueiro:  dano constante de longe e muito ágil, mas fraco contra quem chega perto
--   Assassino: mata um alvo de cada vez muito rápido, mas tem pouca vida e quase nenhuma área
--
-- Campos opcionais: critico (chance base), esquivaMult (recarga da esquiva),
-- ameacaMult (o quanto chama a atenção dos inimigos)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Classes = {}

Classes.ordem = { "cavaleiro", "mago", "arqueiro", "assassino" }

Classes.dados = {
	cavaleiro = {
		id = "cavaleiro",
		nome = "Cavaleiro",
		titulo = "A Muralha de Aço",
		icone = "🛡️",
		cor = Color3.fromRGB(86, 156, 255),
		descricao = "Luta na linha de frente com espada e escudo e atrai os inimigos para si.",
		forte = "Muita vida e armadura, protege os aliados",
		fraco = "Lento, esquiva demora mais e só bate de perto",
		notas = { Vida = 5, Dano = 3, Alcance = 1, Velocidade = 1 },

		vida = 160,
		dano = 22,
		velocidade = 16,
		intervalo = 0.44,
		alcance = 9.5,
		armadura = 0.15,
		esquivaMult = 1.25,
		ameacaMult = 2.5,
		-- a esquiva é um rolamento: mais lenta e mais longa, mas cobre a mesma distância
		esquiva = { velocidade = 44, duracao = 0.3 },

		ataque = {
			tipo = "corte",
			arco = 140,
			combo = { 1, 1.1, 1.9 }, -- o terceiro golpe é o finalizador: um giro que acerta em volta
			impacto = { 0.13, 0.13, 0.24 }, -- quando a lâmina chega no alvo em cada golpe (segundos)
			preparo = 1.8, -- golpes pesados: preparação 80% mais longa (veja Config.PREPARO_GOLPE)
			-- cadência: segundos até poder atacar de novo depois de cada golpe (o golpe inteiro:
			-- preparação, impacto e a volta para a guarda). Clicar antes não faz nada.
			cadencia = { 0.66, 0.66, 1.05 },
			nome = "Combo de Espada",
			icone = "⚔️",
		},
		habilidade = {
			id = "redemoinho",
			nome = "Redemoinho",
			icone = "🌀",
			recarga = 8,
			descricao = "Uma tempestade de cortes em volta dele por 2s, puxando os inimigos. Recebe 40% menos dano enquanto gira.",
		},
		supremo = {
			id = "julgamento",
			nome = "Julgamento",
			icone = "⚡",
			descricao = "Um raio cai do céu: atordoa todos ao redor, dá um escudo aos aliados próximos e, por 10s, brilha e recebe 10% menos dano.",
		},
	},

	mago = {
		id = "mago",
		nome = "Mago",
		titulo = "O Arcano",
		icone = "🔮",
		cor = Color3.fromRGB(180, 96, 255),
		descricao = "Ataca de longe com orbes que explodem e controla o campo com fogo e raios.",
		forte = "Enorme dano em área, magias de fogo, gelo e arcano",
		fraco = "Pouca vida, defesa baixa (leva 10% a mais de dano) e depende de mana",
		notas = { Vida = 1, Dano = 5, Alcance = 4, Velocidade = 2 },

		vida = 70,
		dano = 25,
		velocidade = 17,
		intervalo = 0.52,
		alcance = 50,
		armadura = -0.1, -- defesa baixa: leva 10% a mais de dano
		-- Mana: toda magia gasta mana, que volta sozinha com o tempo
		mana = 100,
		manaRegen = 9, -- por segundo (mais devagar: precisa escolher bem as magias)
		danoEmArea = 1.15, -- explosões, meteoro e tempestade causam 15% a mais
		custos = { ataque = 7, final = 14, carregado = 22, habilidade = 30 },

		ataque = {
			tipo = "projetil",
			projetil = "orbe",
			velocidade = 62,
			raio = 1.3,
			explosao = 4,
			combo = { 1, 1, 1.7 },
			impacto = { 0.15, 0.15, 0.28 },
			preparo = 1.5,
			cadencia = { 0.95, 0.95, 1.4 }, -- conjurar leva tempo: cada magia tem o seu momento
			nome = "Dardo, Gelo e Fogo",
			icone = "✨",
		},
		habilidade = {
			id = "meteoro",
			nome = "Meteoro",
			icone = "☄️",
			recarga = 9,
			descricao = "Um meteoro cai na mira e deixa o chão em chamas por 3 segundos.",
		},
		supremo = {
			id = "tempestade",
			nome = "Tempestade Arcana",
			icone = "🌩️",
			descricao = "Raios caem sem parar por 5s e deixam os inimigos atingidos lentos.",
		},
	},

	arqueiro = {
		id = "arqueiro",
		nome = "Arqueiro",
		titulo = "O Olho do Bosque",
		icone = "🏹",
		cor = Color3.fromRGB(96, 214, 120),
		descricao = "Rápido e certeiro. Atira sem parar enquanto mantém os inimigos longe.",
		forte = "Maior alcance, muito ágil, dano constante",
		fraco = "Flechas perdem força em inimigos colados",
		notas = { Vida = 3, Dano = 3, Alcance = 5, Velocidade = 4 },

		vida = 100,
		dano = 22, -- cada tiro tira a flecha da aljava: mais lento, mas mais forte
		velocidade = 20,
		intervalo = 0.5,
		alcance = 60,
		armadura = 0,
		critico = 0.05,

		ataque = {
			tipo = "projetil",
			projetil = "flecha",
			velocidade = 115,
			raio = 0.9,
			explosao = 0,
			combo = { 1, 1, 2 },
			impacto = { 0.26, 0.26, 0.34 },
			preparo = 1.25, -- já tem o ciclo de pegar a flecha na aljava
			cadencia = { 0.95, 0.95, 1.3 }, -- pegar, encaixar, puxar, mirar, soltar e acompanhar
			nome = "Flechada",
			icone = "🎯",
		},
		habilidade = {
			id = "chuva",
			nome = "Chuva de Flechas",
			icone = "🌧️",
			recarga = 9,
			descricao = "Salta para trás e faz chover flechas na mira por 3s, deixando os inimigos lentos.",
		},
		supremo = {
			id = "saraivada",
			nome = "Saraivada",
			icone = "💫",
			descricao = "Dispara flechas em todas as direções por 4s, correndo 30% mais rápido.",
		},
	},

	assassino = {
		id = "assassino",
		nome = "Assassino",
		titulo = "A Lâmina na Sombra",
		icone = "🗡️",
		cor = Color3.fromRGB(235, 60, 90),
		descricao = "Duas adagas que fazem sangrar, muitos críticos e golpes pelas costas.",
		forte = "Sangramento, críticos, o mais rápido de todos",
		fraco = "Defesa baixa: leva 15% a mais de dano; pouca vida",
		notas = { Vida = 1, Dano = 5, Alcance = 1, Velocidade = 5 },

		vida = 85,
		dano = 15,
		velocidade = 23,
		intervalo = 0.26,
		alcance = 7.5,
		armadura = -0.15, -- defesa baixa: leva mais dano
		-- cada golpe abre um corte: o inimigo sangra (acumula até maxPilhas vezes)
		sangramento = { dps = 0.14, duracao = 4, maxPilhas = 5 },
		critico = 0.15,
		esquivaMult = 0.7,
		ameacaMult = 0.6,

		ataque = {
			tipo = "corte",
			arco = 95,
			combo = { 1, 1, 2.4 },
			impacto = { 0.09, 0.09, 0.2 },
			preparo = 1.6,
			cadencia = { 0.42, 0.42, 0.78 },
			costas = 0.5, -- +50% de dano acertando o inimigo pelas costas
			nome = "Dança das Adagas",
			icone = "🗡️",
		},
		habilidade = {
			id = "passoSombrio",
			nome = "Passo Sombrio",
			icone = "🌑",
			recarga = 6,
			descricao = "Some e aparece atrás do inimigo na mira, com um golpe crítico garantido.",
		},
		supremo = {
			id = "laminasNoturnas",
			nome = "Lâminas da Noite",
			icone = "🌙",
			descricao = "Fica intocável e salta de inimigo em inimigo, cortando até 10 vezes.",
		},
	},
}

-- Preparação dos golpes: "impacto" passa a ser o momento real (mais tarde); o original fica em
-- "impactoBase" (é nele que estão os quadros da animação, que Animacoes estica só na preparação)
for _, classe in Classes.dados do
	local ataque = classe.ataque
	local fator = ataque.preparo or Config.PREPARO_GOLPE or 1
	ataque.preparoFator = fator
	ataque.impactoBase = ataque.impacto
	if ataque.impacto then
		local atrasado = {}
		for i, momento in ataque.impacto do
			atrasado[i] = momento * fator
		end
		ataque.impacto = atrasado
	end
end

-- Tempo a mais que cada golpe leva por causa da preparação mais longa
function Classes.atrasoDoPreparo(classe, combo: number): number
	local base = classe.ataque.impactoBase
	return if base then (base[combo] or 0) * ((classe.ataque.preparoFator or 1) - 1) else 0
end

-- Segundos até o próximo ataque depois do golpe "combo" (0 = depois do golpe carregado, que
-- conta como golpe final). velocidade = 1 + bônus de velocidade de ataque das cartas.
function Classes.cadencia(classe, combo: number, velocidade: number?): number
	local lista = classe.ataque.cadencia or { 0.5, 0.5, 0.7 }
	local valor = lista[if combo >= 1 and combo <= 3 then combo else 3]
	return valor / math.max(velocidade or 1, 0.1)
end

function Classes.obter(id: string?)
	return Classes.dados[id or ""] or Classes.dados.cavaleiro
end

function Classes.existe(id: any): boolean
	return type(id) == "string" and Classes.dados[id] ~= nil
end

return Classes
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000009">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[-- Configurações do jogo. Quase todo o balanceamento fica aqui: mude os números e teste.

local Config = {}

Config.NOME_DO_JOGO = "Masmorra das Cartas"

-- Efeitos sonoros: envie sons/MasmorraSons.ogg para o Roblox e cole o ID aqui
-- (ex.: "rbxassetid://1234567890"). Veja "Efeitos sonoros" em COMO_USAR.md.
Config.SONS_ID = ""
-- Opcional: um ID por som (tem preferência sobre o arquivo único). Ex.: espada = "rbxassetid://..."
Config.SONS_IDS = {
	-- som de espada que você salvou no jogo (sword-swing-whoosh): golpes do Cavaleiro
	espada = "rbxassetid://135315310485417",
	espadaPesada = "rbxassetid://135315310485417",
	golpeEspada = "rbxassetid://135315310485417", -- espada acertando o inimigo
}
-- Música do acampamento (o som "Ambient Trust" que você colocou no jogo): toca em loop no lobby
-- e some ao entrar na masmorra. Deixe "" para desligar.
Config.MUSICA_LOBBY = "rbxassetid://91000345218760"
Config.VOLUME_MUSICA_LOBBY = 0.4

-- Partida
Config.MAX_JOGADORES_POR_PARTIDA = 4
Config.CONTAGEM_PORTAL = 10 -- segundos em cima do portal até a partida começar
Config.CONTAGEM_PORTAL_CHEIO = 3 -- contagem quando o grupo já está completo
Config.SALAS_POR_ANDAR = 5 -- a cada 5 salas vem um chefe e o elevador
Config.CHANCE_SALA_TESOURO = 0.15
Config.TEMPO_ESCOLHER_CARTA = 20
Config.TEMPO_ELEVADOR = 25
Config.TEMPO_PORTA_AUTOMATICA = 60

-- Esquiva (todas as classes)
Config.ESQUIVA_RECARGA = 2.2
Config.ESQUIVA_INVULNERAVEL = 0.35
Config.ESQUIVA_VELOCIDADE = 78
Config.ESQUIVA_DURACAO = 0.17

-- Ataque carregado: segure o ataque para carregar e solte para um golpe mais forte
Config.CARGA_ATAQUE_COMECA = 0.3 -- segurando por este tempo, começa a carregar
Config.CARGA_ATAQUE_MIN = 0.3 -- carga mínima para o golpe carregado sair
Config.CARGA_ATAQUE_MAX = 1.2 -- carga cheia (dano máximo e efeito especial)
Config.DANO_CARGA_MIN = 1.6 -- multiplicador de dano com carga mínima
Config.DANO_CARGA_MAX = 3.2 -- multiplicador de dano com carga cheia
Config.VELOCIDADE_CARREGANDO = 0.5 -- anda mais devagar enquanto carrega

-- Peso dos golpes: a preparação (do clique até a arma chegar no alvo) fica mais longa.
-- 1 = como antes; 1.8 = 80% mais tempo preparando. Cada classe pode ter o seu (ataque.preparo).
Config.PREPARO_GOLPE = 1.7
-- Braço da espada animado nos modelos 3D (Skullbane, Ceifador): deforma a malha com
-- EditableMesh. Se der problema no seu jogo, troque para false (o braço fica parado).
Config.BRACO_ANIMADO = true
Config.VELOCIDADE_CORRIDA = 1.35 -- segurando Shift: corrida leve (não vale atacando, carregando ou defendendo)
Config.VELOCIDADE_ATACANDO = 0.45 -- o personagem quase para enquanto prepara o golpe

-- Defesa com escudo (Cavaleiro): segure F, o botão direito do mouse ou L2
Config.DEFESA_REDUCAO = 0.75 -- golpes de frente perdem 75% do dano
Config.DEFESA_ANGULO = 65 -- protege golpes vindos até 65° para cada lado da frente
Config.DEFESA_PERFEITA = 0.3 -- erguer o escudo até 0,3s antes do golpe: bloqueia tudo e atordoa
Config.VELOCIDADE_DEFENDENDO = 0.45

-- Supremo: a barra enche causando dano e derrotando inimigos
Config.CARGA_MAXIMA = 100
Config.CARGA_POR_ACERTO = 2.5
Config.CARGA_POR_ABATE = 4

-- Jogador caído: aliados reviram ficando perto
Config.TEMPO_CAIDO = 15
Config.TEMPO_PARA_REVIVER = 3
Config.RAIO_REVIVER = 8
Config.VIDA_AO_REVIVER = 0.4

-- Ouro: quem morre fica só com esta parte. Quem sobe no elevador fica com tudo.
Config.OURO_MANTIDO_AO_MORRER = 0.25

-- Versão do jogo: aparece no canto da tela junto com a data e a hora do build (o build.py
-- grava ReplicatedStorage > Versao). Suba o número quando publicar uma atualização grande.
Config.VERSAO = "0.14"

-- Inimigos ficam mais fortes a cada sala
Config.VIDA_INIMIGO_POR_SALA = 0.14
Config.DANO_INIMIGO_POR_SALA = 0.06

-- Dificuldade do grupo: cada jogador a mais na partida deixa a masmorra mais difícil.
-- Com 4 jogadores: inimigos com +225% de vida e +60% de dano; chefes com +390% de vida,
-- +90% de dano, golpes 30% mais frequentes e postura +180% (mais difícil de quebrar).
Config.VIDA_INIMIGO_POR_JOGADOR_EXTRA = 0.75
Config.DANO_INIMIGO_POR_JOGADOR_EXTRA = 0.2
-- o grupo inteiro bate no chefe ao mesmo tempo e o dano dele se divide entre todos
Config.VIDA_CHEFE_POR_JOGADOR_EXTRA = 1.3
Config.DANO_CHEFE_POR_JOGADOR_EXTRA = 0.3
Config.RECARGA_CHEFE_POR_JOGADOR_EXTRA = 0.1 -- recarga dos golpes 10% menor por jogador a mais (mínimo 60%)
Config.POSTURA_CHEFE_POR_JOGADOR_EXTRA = 0.6 -- mais parries no grupo: a postura aguenta mais
Config.INIMIGOS_POR_JOGADOR_EXTRA = 4 -- inimigos a mais em cada sala de combate
Config.VIVOS_POR_JOGADOR_EXTRA = 2 -- inimigos a mais ao mesmo tempo na sala
Config.ELITE_POR_JOGADOR_EXTRA = 0.04 -- chance de elite a mais (o máximo também sobe)

-- Inimigos de apoio (Acólito cura, Guardião dá escudo, Porta-Estandarte grita) aparecem
-- mais nas salas grandes: o peso deles em Config.TEMAS é multiplicado por isto (1 = normal).
-- Com 2, eles passam de ~1 em 5 para ~1 em 3 inimigos.
Config.PESO_INIMIGOS_DE_APOIO = 2

-- Maldição do Alto (só o Skullbane, 1º chefe): a cada MALDICAO_INTERVALO segundos uma alma cai
-- do alto num jogador do grupo. O círculo verde avisa; quem sai dele, esquiva ou defende com o
-- escudo escapa. Quem é atingido fica sem esquiva (dash), corrida, habilidade (E) e supremo (R),
-- com a tela verde. A cada MALDICAO_FORTE_A_CADA quedas vem a maldição forte (maior e mais longa).
Config.MALDICAO_INTERVALO = 5
Config.MALDICAO_DURACAO = 1.2
Config.MALDICAO_RAIO = 5
Config.MALDICAO_AVISO = 1.4 -- tempo do selo no chão até a alma cair
-- o selo segue a pessoa e só trava no lugar este tempo antes de a alma cair: sair andando não
-- adianta; escapa quem dá a esquiva (dash) bem na hora ou quem defende com o escudo
Config.MALDICAO_TRAVA = 0.35
Config.MALDICAO_FORTE_A_CADA = 2 -- uma queda sim, outra não: a forte vem a cada 10s
Config.MALDICAO_FORTE_DURACAO = 2.5
Config.MALDICAO_FORTE_RAIO = 7

-- Caveiras (só o Skullbane): a cada CAVEIRAS_INTERVALO segundos ele solta caveiras em chamas
-- verdes que perseguem os jogadores (uma por jogador, no mínimo CAVEIRAS_MINIMO). Elas viram
-- devagar (CAVEIRAS_GIRO, em radianos por segundo): dá para fugir ou desviar de lado na hora certa.
Config.CAVEIRAS_INTERVALO = 7
Config.CAVEIRAS_MINIMO = 2
Config.CAVEIRAS_VELOCIDADE = 17
Config.CAVEIRAS_GIRO = 2.2
Config.CAVEIRAS_DURACAO = 5 -- segundos até a caveira se desfazer
Config.CAVEIRAS_DANO = 0.45 -- parte do dano do chefe

-- Chefes começam a atacar logo depois de despertar: o tempo até o primeiro uso de cada
-- golpe ("inicial" em Inimigos.luau) é multiplicado por isto
Config.INICIO_ATAQUES_CHEFE = 0.35

-- Inimigos de elite (mais fortes, com um poder especial, dão mais ouro)
Config.CHANCE_ELITE_BASE = 0.05
Config.CHANCE_ELITE_POR_SALA = 0.012
Config.CHANCE_ELITE_MAXIMA = 0.3

Config.RARIDADES = {
	Comum = { nome = "Comum", cor = Color3.fromRGB(196, 202, 214), peso = 60 },
	Rara = { nome = "Rara", cor = Color3.fromRGB(72, 165, 255), peso = 28 },
	Epica = { nome = "Épica", cor = Color3.fromRGB(190, 100, 255), peso = 10 },
	Lendaria = { nome = "Lendária", cor = Color3.fromRGB(255, 186, 48), peso = 2.5 },
}
Config.ORDEM_RARIDADES = { "Comum", "Rara", "Epica", "Lendaria" }
Config.SORTE_POR_NIVEL = { Comum = -3, Rara = 1.5, Epica = 1, Lendaria = 0.5 }
Config.PESO_EXTRA_CARTA_DE_CLASSE = 1.5 -- cartas da sua classe aparecem mais

Config.MELHORIAS = {
	{ id = "Vida", nome = "Vida Extra", icone = "❤️", descricao = "+15 de vida máxima por nível", precoBase = 40, nivelMax = 10 },
	{ id = "Forca", nome = "Força", icone = "💪", descricao = "+8% de dano por nível", precoBase = 50, nivelMax = 10 },
	{ id = "Sorte", nome = "Sorte", icone = "🍀", descricao = "Cartas raras aparecem mais", precoBase = 75, nivelMax = 5 },
}

function Config.precoMelhoria(melhoria, nivelAtual: number): number
	return math.floor(melhoria.precoBase * (nivelAtual + 1) ^ 1.6)
end

function Config.buscarMelhoria(id)
	for _, melhoria in Config.MELHORIAS do
		if melhoria.id == id then
			return melhoria
		end
	end
	return nil
end

-- Cada andar (5 salas) tem um tema: visual, inimigos e chefe próprios.
-- Depois do último tema, o ciclo recomeça com inimigos mais fortes.
Config.TEMAS = {
	{
		id = "calabouco",
		nome = "Calabouço",
		inimigos = { gosma = 4, esqueleto = 4, esqueletoArqueiro = 2.5, rato = 2, acolito = 1.3, guardiao = 0.9, portaEstandarte = 0.8 },
		chefe = "skullbane", -- (o Rei Esqueleto continua no jogo: troque aqui para voltar a ele)
		chao = { material = Enum.Material.Cobblestone, cor = Color3.fromRGB(98, 94, 100) },
		parede = { material = Enum.Material.Brick, cor = Color3.fromRGB(84, 74, 76) },
		detalhe = { material = Enum.Material.Slate, cor = Color3.fromRGB(58, 52, 58) },
		luz = Color3.fromRGB(255, 165, 85),
		ambiente = Color3.fromRGB(62, 52, 62),
		nevoa = Color3.fromRGB(34, 24, 30),
		tinta = Color3.fromRGB(255, 236, 220),
		particulas = "poeira",
		lava = false,
	},
	{
		id = "caverna",
		nome = "Caverna Musgosa",
		inimigos = { kobold = 4, aranha = 3, cogumelo = 2, xama = 2, gosma = 1.5, portaEstandarte = 1.4, acolito = 0.9, guardiao = 0.8 },
		chefe = "rainhaAranha",
		chao = { material = Enum.Material.Ground, cor = Color3.fromRGB(74, 84, 58) },
		parede = { material = Enum.Material.Rock, cor = Color3.fromRGB(70, 78, 64) },
		detalhe = { material = Enum.Material.Slate, cor = Color3.fromRGB(50, 60, 48) },
		luz = Color3.fromRGB(170, 255, 140),
		ambiente = Color3.fromRGB(44, 66, 50),
		nevoa = Color3.fromRGB(18, 34, 24),
		tinta = Color3.fromRGB(225, 255, 230),
		particulas = "esporos",
		lava = false,
	},
	{
		id = "cripta",
		nome = "Cripta Congelada",
		inimigos = { carnical = 4, espectro = 3, cavaleiroMorto = 1.5, esqueleto = 1.5, acolito = 1.4, guardiao = 1.3, portaEstandarte = 0.8 },
		chefe = "lich",
		chao = { material = Enum.Material.Slate, cor = Color3.fromRGB(120, 140, 165) },
		parede = { material = Enum.Material.Glacier, cor = Color3.fromRGB(130, 160, 200) },
		detalhe = { material = Enum.Material.Ice, cor = Color3.fromRGB(165, 205, 240) },
		luz = Color3.fromRGB(140, 205, 255),
		ambiente = Color3.fromRGB(70, 86, 118),
		nevoa = Color3.fromRGB(30, 42, 66),
		tinta = Color3.fromRGB(220, 235, 255),
		particulas = "neve",
		lava = false,
	},
	{
		id = "fornalha",
		nome = "Fornalha",
		inimigos = { diabrete = 3.5, elementalFogo = 3, ogro = 1.5, carnical = 1, guardiao = 1.3, portaEstandarte = 1.3, acolito = 1 },
		chefe = "senhorChamas",
		chao = { material = Enum.Material.Basalt, cor = Color3.fromRGB(46, 38, 38) },
		parede = { material = Enum.Material.CrackedLava, cor = Color3.fromRGB(96, 46, 34) },
		detalhe = { material = Enum.Material.Basalt, cor = Color3.fromRGB(30, 24, 24) },
		luz = Color3.fromRGB(255, 120, 60),
		ambiente = Color3.fromRGB(86, 44, 34),
		nevoa = Color3.fromRGB(52, 16, 8),
		tinta = Color3.fromRGB(255, 220, 200),
		particulas = "brasas",
		lava = true,
	},
}

function Config.indiceTema(numeroSala: number): number
	return ((numeroSala - 1) // Config.SALAS_POR_ANDAR) % #Config.TEMAS + 1
end

function Config.temaDaSala(numeroSala: number)
	return Config.TEMAS[Config.indiceTema(numeroSala)]
end

return Config
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000010">
        <Properties>
          <string name="Name">Teclas</string>
          <ProtectedString name="Source"><![CDATA[-- Teclas de cada ação (o jogador pode trocar no menu ⚙️ Teclas). Usado pelo servidor
-- para validar o que é salvo e pelo jogador para ler os comandos.
--
-- Cada ação tem até 2 teclas (principal e alternativa). Uma tecla é guardada pelo nome:
-- o nome de um Enum.KeyCode ("E", "LeftShift"...) ou "MouseButton1", "MouseButton2",
-- "MouseButton3". O controle (gamepad) tem botões fixos.

local Teclas = {}

Teclas.ACOES = {
	{ id = "ataque", nome = "Atacar", detalhe = "Segure e solte para o golpe carregado", icone = "⚔️" },
	{ id = "habilidade", nome = "Habilidade", detalhe = "Habilidade especial da classe", icone = "✨" },
	{ id = "esquiva", nome = "Esquiva", detalhe = "Fica intocável por um instante", icone = "💨" },
	{ id = "supremo", nome = "Supremo", detalhe = "Com a barra dourada cheia", icone = "⚡" },
	{ id = "defender", nome = "Defender", detalhe = "Cavaleiro: segure para erguer o escudo", icone = "🛡️" },
	{ id = "correr", nome = "Correr", detalhe = "Segure para uma corrida leve", icone = "🏃" },
	{ id = "travarMira", nome = "Travar a mira", detalhe = "Liga e desliga: câmera no ombro, mira no centro", icone = "🎯" },
}

Teclas.PADRAO = {
	ataque = { "MouseButton1" },
	habilidade = { "E" },
	esquiva = { "Q" },
	supremo = { "R" },
	defender = { "F", "MouseButton2" },
	correr = { "LeftShift" },
	travarMira = { "LeftAlt" },
}

-- Botões do controle (não mudam)
Teclas.CONTROLE = {
	ataque = Enum.KeyCode.ButtonR2,
	habilidade = Enum.KeyCode.ButtonX,
	esquiva = Enum.KeyCode.ButtonB,
	supremo = Enum.KeyCode.ButtonY,
	defender = Enum.KeyCode.ButtonL2,
	correr = Enum.KeyCode.ButtonL3,
	travarMira = Enum.KeyCode.ButtonR3,
}

-- Teclas que já fazem outra coisa no Roblox (andar, pular, chat, menu)
Teclas.RESERVADAS = {
	W = true,
	A = true,
	S = true,
	D = true,
	Up = true,
	Down = true,
	Left = true,
	Right = true,
	Space = true,
	Escape = true,
	Slash = true,
	Tab = true,
	Backquote = true,
	Unknown = true,
}

local MOUSE = { MouseButton1 = true, MouseButton2 = true, MouseButton3 = true }

local acoesPorId = {}
for _, acao in Teclas.ACOES do
	acoesPorId[acao.id] = acao
end
Teclas.acoesPorId = acoesPorId

-- A tecla existe e pode ser usada?
function Teclas.valida(nome: any): boolean
	if type(nome) ~= "string" or #nome > 32 then
		return false
	end
	if MOUSE[nome] then
		return true
	end
	if Teclas.RESERVADAS[nome] then
		return false
	end
	local ok, tecla = pcall(function()
		return (Enum.KeyCode :: any)[nome]
	end)
	return ok and tecla ~= nil
end

-- Limpa uma tabela vinda de fora: só ações conhecidas, no máximo 2 teclas válidas cada,
-- e a mesma tecla nunca em duas ações. Ações que ficarem de fora usam o padrão.
function Teclas.normalizar(tabela: any)
	local resultado = {}
	local usadas = {}
	for _, acao in Teclas.ACOES do
		local lista = if type(tabela) == "table" then tabela[acao.id] else nil
		if type(lista) ~= "table" then
			lista = Teclas.PADRAO[acao.id]
		end
		local limpa = {}
		for slot = 1, 2 do
			local nome = lista[slot]
			if Teclas.valida(nome) and not usadas[nome] then
				usadas[nome] = true
				limpa[slot] = nome
			else
				limpa[slot] = false -- vazio (false para não abrir buraco na lista)
			end
		end
		resultado[acao.id] = limpa
	end
	return resultado
end

-- Nome curto para mostrar na tela
local NOMES = {
	MouseButton1 = "Clique Esq.",
	MouseButton2 = "Clique Dir.",
	MouseButton3 = "Clique Meio",
	LeftShift = "Shift Esq.",
	RightShift = "Shift Dir.",
	LeftControl = "Ctrl Esq.",
	RightControl = "Ctrl Dir.",
	LeftAlt = "Alt Esq.",
	RightAlt = "Alt Dir.",
	Return = "Enter",
	Backspace = "Apagar",
	CapsLock = "Caps Lock",
	One = "1",
	Two = "2",
	Three = "3",
	Four = "4",
	Five = "5",
	Six = "6",
	Seven = "7",
	Eight = "8",
	Nine = "9",
	Zero = "0",
	Minus = "-",
	Equals = "=",
	LeftBracket = "[",
	RightBracket = "]",
	Semicolon = ";",
	Quote = "'",
	Comma = ",",
	Period = ".",
	BackSlash = "\\",
}

function Teclas.texto(nome: any): string
	if type(nome) ~= "string" then
		return "—"
	end
	return NOMES[nome] or nome
end

-- Texto bem curto para os quadradinhos do HUD
function Teclas.curto(nome: any): string
	if nome == "MouseButton1" then
		return "🖱️E"
	elseif nome == "MouseButton2" then
		return "🖱️D"
	elseif nome == "MouseButton3" then
		return "🖱️M"
	end
	local texto = Teclas.texto(nome)
	return if #texto > 5 then string.sub(texto, 1, 5) else texto
end

return Teclas
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
