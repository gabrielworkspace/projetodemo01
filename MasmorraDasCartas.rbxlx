------------------------------------------------------------------------
-- Atualizações
------------------------------------------------------------------------

local function atualizarPerfil()
	local perfil = Estado.perfil
	local classe = Classes.obter(perfil.classe)
	textoOuroLobby.Text = formatarNumero(perfil.ouro or 0)
	textoRecorde.Text = "Sala " .. (perfil.recorde or 0)
	classeJogador.Text = classe.icone .. " " .. classe.nome
	classeJogador.TextColor3 = classe.cor:Lerp(cores.branco, 0.25)
	tituloClasse.Text = classe.titulo
	aroFoto.Color = classe.cor
end

local function atualizarClasseNaBarra()
	local id = if Estado.stats then Estado.stats.classe else Estado.perfil.classe
	local classe = Classes.obter(id)
	local icone = medalhaoClasse:FindFirstChild("Icone") :: TextLabel?
	if icone then
		icone.Text = classe.icone
	end
	slots.ataque.icone.Text = classe.ataque.icone
	slots.habilidade.icone.Text = classe.habilidade.icone
	slots.supremo.icone.Text = classe.supremo.icone
	toque.ataque.rotulo.Text = classe.ataque.icone
	toque.habilidade.rotulo.Text = classe.habilidade.icone
	toque.supremo.rotulo.Text = classe.supremo.icone
	barraVida.cor(classe.cor:Lerp(cores.vida, 0.65))
end

local function atualizarCartas()
	for _, filho in faixaCartas:GetChildren() do
		if filho:IsA("Frame") then
			filho:Destroy()
		end
	end
	for ordem, carta in Cartas.lista do
		local quantidade = Estado.cartas[carta.id] or 0
		if quantidade > 0 then
			local m = UI.medalhao({
				Parent = faixaCartas,
				Icone = carta.icone,
				Cor = cores.painelClaro,
				Borda = Config.RARIDADES[carta.raridade].cor,
				LayoutOrder = ordem,
			})
			if quantidade > 1 then
				local n = UI.texto({
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, 4, 1, 4),
					Size = UDim2.fromOffset(24, 16),
					FontFace = fontes.numero,
					Text = "x" .. quantidade,
					TextColor3 = cores.ouroClaro,
					ZIndex = 4,
					Parent = m,
				})
				UI.contorno(n, 1.5, 0)
			end
		end
	end
end

local function montarAliados()
	for _, filho in listaAliados:GetChildren() do
		if filho:IsA("Frame") then
			filho:Destroy()
		end
	end
	table.clear(quadrosAliados)
	for ordem, aliado in Estado.aliados do
		if aliado.userId ~= jogador.UserId then
			local classe = Classes.obter(aliado.classe)
			local quadro = UI.painel({ Size = UDim2.fromOffset(240, 58), LayoutOrder = ordem, Parent = listaAliados, SemCantos = true, Transparencia = 0.15 })
			local retrato = criar("ImageLabel", {
				Position = UDim2.fromOffset(8, 7),
				Size = UDim2.fromOffset(44, 44),
				BackgroundColor3 = cores.fundo,
				Image = UI.fotoJogador(aliado.userId),
				Parent = quadro,
			})
			UI.redondo(retrato)
			UI.borda(retrato, classe.cor, 2)
			local nome = UI.texto({
				Position = UDim2.fromOffset(60, 6),
				Size = UDim2.fromOffset(170, 20),
				FontFace = fontes.forte,
				Text = classe.icone .. " " .. aliado.nome,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = quadro,
			})
			UI.contorno(nome, 1.5)
			local barra = UI.barra({ Parent = quadro, Position = UDim2.fromOffset(60, 32), Size = UDim2.fromOffset(170, 14), Raio = 4 })
			barra.rotulo.Visible = false
			quadrosAliados[aliado.userId] = { quadro = quadro, barra = barra, nome = nome, retrato = retrato, texto = classe.icone .. " " .. aliado.nome }
		end
	end
end

------------------------------------------------------------------------
-- API chamada pelo Main
------------------------------------------------------------------------

function Hud.modo(modo: string)
	telaLobby.Visible = modo == "lobby"
	telaPartida.Visible = modo == "partida"
	areaToque.Visible = modo == "partida" and celular
	barraAcoes.Visible = not celular
	vidaCelular.Visible = celular
	painelChefe.Visible = false
	painelCaido.Visible = false
	textoEspectador.Visible = false
	if modo == "partida" then
		montarAliados()
		atualizarCartas()
		atualizarClasseNaBarra()
	else
		painelFila.Visible = false
	end
	animar(escuro, 0.3, { BackgroundTransparency = 1 })
end

function Hud.fila(dados)
	if dados.esconder or Estado.modo ~= "lobby" then
		painelFila.Visible = false
		return
	end
	painelFila.Visible = true
	if dados.cheio then
		contagemFila.Text = "—"
		dicaFila.Text = "Grupo cheio! Espere a próxima partida."
		return
	end
	contagemFila.Text = tostring(dados.segundos)
	dicaFila.Text = "Saia do círculo para cancelar"
	for i, vaga in vagas do
		local membro = dados.membros and dados.membros[i]
		if membro then
			local classe = Classes.obter(membro.classe)
			vaga.imagem.Image = UI.fotoJogador(membro.userId)
			vaga.aro.Color = classe.cor
			vaga.icone.Text = classe.icone
		else
			vaga.imagem.Image = ""
			vaga.aro.Color = cores.bronze
			vaga.icone.Text = ""
		end
	end
end

local idBanner = 0
function Hud.banner(texto: string, cor: Color3?)
	idBanner += 1
	local meu = idBanner
	textoBanner.Text = texto
	textoBanner.TextColor3 = cor or cores.texto
	banner.Position = UDim2.fromScale(0.5, 0.25)
	banner.GroupTransparency = 1
	animar(banner, 0.3, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.22) }, Enum.EasingStyle.Back)
	task.delay(2.4, function()
		if idBanner == meu then
			animar(banner, 0.4, { GroupTransparency = 1 })
		end
	end)
end

function Hud.aviso(texto: string)
	local quadro = UI.painel({ Size = UDim2.fromOffset(330, 46), Parent = pilhaAvisos, SemCantos = true, Transparencia = 0.1 })
	local grupo = criar("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = quadro })
	local rotulo = UI.texto({
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 1, -16),
		FontFace = fontes.forte,
		Text = texto,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = grupo,
	})
	UI.limiteTexto(rotulo, 20)
	local deslize = criar("UIScale", { Scale = 0.6, Parent = quadro })
	animar(deslize, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	local avisos = {}
	for _, filho in pilhaAvisos:GetChildren() do
		if filho:IsA("Frame") then
			table.insert(avisos, filho)
		end
	end
	if #avisos > 4 then
		avisos[1]:Destroy()
	end
	task.delay(3.5, function()
		if quadro.Parent then
			animar(grupo, 0.3, { GroupTransparency = 1 })
			animar(quadro, 0.3, { BackgroundTransparency = 1 })
			task.wait(0.3)
			quadro:Destroy()
		end
	end)
end

local function mostrarTitulo(titulo: string, sub: string, cor: Color3, duracao: number)
	tituloGrande.Text = titulo
	tituloGrande.TextColor3 = cor
	subtitulo.Text = sub
	local escala = cartaoTitulo:FindFirstChildOfClass("UIScale")
	cartaoTitulo.GroupTransparency = 1
	if escala then
		escala.Scale = UI.escalaAtual * 1.25
		animar(escala, 0.5, { Scale = UI.escalaAtual }, Enum.EasingStyle.Quint)
	end
	animar(cartaoTitulo, 0.4, { GroupTransparency = 0 })
	task.delay(duracao, function()
		animar(cartaoTitulo, 0.6, { GroupTransparency = 1 })
	end)
end

function Hud.sala(dados)
	textoSala.Text = (if dados.tipo == "chefe" then "☠ " elseif dados.tipo == "tesouro" then "💰 " else "") .. "SALA " .. dados.numero
	textoTema.Text = dados.tema.nome
	for i, pip in pips do
		local cor = cores.bronze
		if i < dados.posicaoNoAndar then
			cor = cores.ouro
		elseif i == dados.posicaoNoAndar then
			cor = if dados.tipo == "chefe" then Color3.fromRGB(255, 60, 60) else cores.ouroClaro
		elseif i == #pips then
			cor = Color3.fromRGB(140, 40, 40)
		end
		pip.BackgroundColor3 = cor
	end
	if dados.tipo ~= "chefe" then
		mostrarTitulo("Sala " .. dados.numero, dados.tema.nome, cores.ouroClaro, 1.6)
	end
end

function Hud.introChefe(dados)
	animar(faixaCima, 0.4, { Position = UDim2.fromScale(0, 0) })
	animar(faixaBaixo, 0.4, { Position = UDim2.fromScale(0, 0.88) })
	mostrarTitulo(dados.nome, dados.titulo, Color3.fromRGB(255, 96, 80), 2.2)
	Vfx.tremer(1.5, 0.8)
	task.delay(2.6, function()
		animar(faixaCima, 0.5, { Position = UDim2.fromScale(0, -0.12) })
		animar(faixaBaixo, 0.5, { Position = UDim2.fromScale(0, 1) })
	end)
end

function Hud.transicao(escurecer: boolean)
	if escurecer then
		animar(escuro, 0.35, { BackgroundTransparency = 0 })
	else
		task.delay(0.2, function()
			animar(escuro, 0.5, { BackgroundTransparency = 1 })
		end)
	end
end

function Hud.danoLocal(_valor: number)
	vinheta.GroupTransparency = 0.25
	animar(vinheta, 0.5, { GroupTransparency = 1 })
end

function Hud.ganhouOuro(_valor: number)
	local escala = textoOuroPartida:FindFirstChildOfClass("UIScale") or criar("UIScale", { Parent = textoOuroPartida })
	escala.Scale = 1.25
	animar(escala, 0.25, { Scale = 1 })
end

function Hud.caiu()
	painelCaido.Visible = true
	tituloCaido.Text = "VOCÊ CAIU"
	dicaCaido.Text = "Um aliado precisa ficar perto de você para te levantar!"
end

function Hud.levantou()
	painelCaido.Visible = false
end

function Hud.morreu()
	painelCaido.Visible = false
	textoEspectador.Text = "💀 Você caiu. Você volta quando seus amigos limparem a sala."
	textoEspectador.Visible = true
end

function Hud.reviveu()
	textoEspectador.Visible = false
	painelCaido.Visible = false
end

------------------------------------------------------------------------
-- Loop: barras, recargas, aliados, chefe, espectador
------------------------------------------------------------------------

local function recarga(fim: number, total: number, sombra: Frame, segundos: TextLabel, redondo: boolean)
	local restante = fim - os.clock()
	if restante > 0 then
		if redondo then
			sombra.Visible = true
		else
			sombra.Size = UDim2.fromScale(1, math.clamp(restante / math.max(total, 0.01), 0, 1))
		end
		segundos.Text = if restante >= 1 then tostring(math.ceil(restante)) else string.format("%.1f", restante)
	else
		if redondo then
			sombra.Visible = false
		else
			sombra.Size = UDim2.fromScale(1, 0)
		end
		segundos.Text = ""
	end
end

local placasCaidos = {} -- [Model] = { placa, barra }

-- Placa sobre aliados caídos, com o progresso de reviver
local function atualizarCaidos()
	for _, aliado in Estado.aliados do
		local outro = Players:GetPlayerByUserId(aliado.userId)
		local personagem = outro and outro.Character
		if personagem and outro ~= jogador then
			local caido = personagem:GetAttribute("Caido") == true
			local info = placasCaidos[personagem]
			if caido and not info then
				local cabeca = personagem:FindFirstChild("Head") or personagem:FindFirstChild("HumanoidRootPart")
				if cabeca then
					local placa = criar("BillboardGui", {
						Adornee = cabeca,
						Size = UDim2.fromOffset(150, 52),
						StudsOffset = Vector3.new(0, 3, 0),
						AlwaysOnTop = true,
						LightInfluence = 0,
						Parent = gui,
					})
					local rotulo = UI.texto({ Size = UDim2.new(1, 0, 0, 22), FontFace = fontes.numero, Text = "💀 CAÍDO", TextColor3 = Color3.fromRGB(255, 120, 110), Parent = placa })
					UI.contorno(rotulo, 2, 0)
					local barra = UI.barra({ Parent = placa, Position = UDim2.fromOffset(10, 28), Size = UDim2.fromOffset(130, 14), Cor = cores.sucesso, Raio = 4 })
					barra.rotulo.Visible = false
					barra.definir(0)
					info = { placa = placa, barra = barra }
					placasCaidos[personagem] = info
				end
			elseif not caido and info then
				info.placa:Destroy()
				placasCaidos[personagem] = nil
				info = nil
			end
			if info then
				info.barra.definir(personagem:GetAttribute("Reviver") or 0)
			end
		end
	end
	for personagem, info in placasCaidos do
		if not personagem.Parent then
			info.placa:Destroy()
			placasCaidos[personagem] = nil
		end
	end
end

local proximoEspectador = 0
local function atualizarEspectador()
	if not Estado.morto or os.clock() < proximoEspectador then
		return
	end
	proximoEspectador = os.clock() + 0.5
	local camera = workspace.CurrentCamera
	local atual = camera.CameraSubject
	local valido = atual ~= nil and atual:IsA("Humanoid") and atual.Health > 0 and atual.Parent ~= jogador.Character
	if valido then
		return
	end
	for _, aliado in Estado.aliados do
		local outro = Players:GetPlayerByUserId(aliado.userId)
		local personagem = outro and outro ~= jogador and outro.Character
		local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
		if outro and humanoid and humanoid.Health > 0 then
			camera.CameraSubject = humanoid
			textoEspectador.Text = "👻 Assistindo " .. outro.DisplayName .. ". Você volta quando a sala for limpa."
			return
		end
	end
end

local function atualizarChefe()
	local chefe = nil
	for _, modelo in CollectionService:GetTagged("Inimigo") do
		if modelo:GetAttribute("Chefe") then
			chefe = modelo
			break
		end
	end
	painelChefe.Visible = chefe ~= nil and Estado.modo == "partida"
	if chefe then
		nomeChefe.Text = (if chefe:GetAttribute("Furioso") then "🔥 " else "") .. (chefe:GetAttribute("Nome") or "")
		tituloChefe.Text = chefe:GetAttribute("Titulo") or ""
		local vida = chefe:GetAttribute("Vida") or 0
		local maxima = chefe:GetAttribute("VidaMax") or 1
		barraChefe.definir(vida / math.max(maxima, 1), formatarNumero(math.max(0, vida)) .. " / " .. formatarNumero(maxima))
	end
end

function Hud.iniciar()
	Estado.Mudou:Connect(function(chave)
		if chave == "perfil" then
			atualizarPerfil()
			if Estado.modo == "lobby" then
				atualizarClasseNaBarra()
			end
		elseif chave == "stats" then
			atualizarClasseNaBarra()
		elseif chave == "cartas" then
			atualizarCartas()
		elseif chave == "ouro" then
			textoOuroPartida.Text = formatarNumero(Estado.ouroPartida)
		end
	end)
	atualizarPerfil()

	local pulsoVida = 0
	RunService.RenderStepped:Connect(function(dt)
		local personagem = jogador.Character
		local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.MaxHealth > 0 then
			local fracao = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
			local texto = math.ceil(math.max(0, humanoid.Health)) .. " / " .. math.floor(humanoid.MaxHealth)
			barraVida.definir(fracao, texto)
			barraVidaCelular.definir(fracao, texto)
			-- vida baixa: bordas vermelhas pulsando
			if Estado.modo == "partida" and fracao < 0.3 and fracao > 0 and not Estado.caido then
				pulsoVida += dt * 5
				vinhetaVida.GroupTransparency = 0.6 + 0.25 * math.sin(pulsoVida)
			else
				vinhetaVida.GroupTransparency = 1
			end
		end
		if Estado.modo ~= "partida" then
			return
		end

		local carga = math.clamp(Estado.carga / math.max(Estado.cargaMax, 1), 0, 1)
		barraCarga.definir(carga)
		barraCargaCelular.definir(carga)
		local pronto = carga >= 1
		slots.supremo.aro.Color = if pronto then cores.ouroClaro else cores.bronze
		slots.supremo.aro.Thickness = if pronto then 3 + math.sin(os.clock() * 6) else 2
		toque.supremo.sombra.Visible = not pronto
		toque.supremo.aro.Color = if pronto then cores.ouroClaro else cores.bronze

		recarga(Estado.habilidadeFim, Estado.habilidadeTotal, slots.habilidade.sombra, slots.habilidade.segundos, false)
		recarga(Estado.esquivaFim, Estado.esquivaTotal, slots.esquiva.sombra, slots.esquiva.segundos, false)
		recarga(Estado.habilidadeFim, Estado.habilidadeTotal, toque.habilidade.sombra, toque.habilidade.segundos, true)
		recarga(Estado.esquivaFim, Estado.esquivaTotal, toque.esquiva.sombra, toque.esquiva.segundos, true)

		for userId, info in quadrosAliados do
			local outro = Players:GetPlayerByUserId(userId)
			local p = outro and outro.Character
			local h = p and p:FindFirstChildOfClass("Humanoid")
			if not outro then
				info.nome.Text = info.texto .. " (saiu)"
				info.barra.definir(0)
			elseif h and h.MaxHealth > 0 then
				info.barra.definir(h.Health / h.MaxHealth)
				if p:GetAttribute("Caido") then
					info.nome.Text = "💀 " .. info.texto
				elseif h.Health <= 0 then
					info.nome.Text = "☠ " .. info.texto
				else
					info.nome.Text = info.texto
				end
			end
		end

		if Estado.caido and personagem then
			local restante = personagem:GetAttribute("CaidoRestante") or 0
			local reviver = personagem:GetAttribute("Reviver") or 0
			barraCaido.definir(restante / Config.TEMPO_CAIDO)
			if reviver > 0 then
				tituloCaido.Text = "LEVANTANDO... " .. math.floor(reviver * 100) .. "%"
			else
				tituloCaido.Text = "VOCÊ CAIU  •  " .. math.ceil(restante) .. "s"
			end
		end

		atualizarCaidos()
		atualizarEspectador()
		atualizarChefe()
	end)
end

return Hud
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX00000030">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source"><![CDATA[-- Script principal do jogador: liga a interface, os efeitos, os controles e recebe as
-- mensagens do servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local modulos = script.Parent
local Estado = require(modulos.Estado)
local UI = require(modulos.UI)
local Vfx = require(modulos.Vfx)
local Ambiente = require(modulos.Ambiente)
local VisualInimigos = require(modulos.VisualInimigos)
local Controles = require(modulos.Controles)
local Animacoes = require(modulos.Animacoes)
local Hud = require(modulos.Hud)
local Menus = require(modulos.Menus)

local jogador = Players.LocalPlayer
local Remotos = ReplicatedStorage:WaitForChild("Remotos")
local Evento = Remotos:WaitForChild("Evento") :: RemoteEvent
local Acao = Remotos:WaitForChild("Acao") :: RemoteEvent

-- Esconde a barra de vida e a mochila padrão do Roblox (usamos as nossas)
for _, tipo in { Enum.CoreGuiType.Health, Enum.CoreGuiType.Backpack } do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(tipo, false)
	end)
end

-- Escala da interface acompanha o tamanho da tela
local function acompanharCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(UI.atualizarEscala)
	end
	UI.atualizarEscala()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(acompanharCamera)
acompanharCamera()

Ambiente.iniciar()
Animacoes.iniciar()
VisualInimigos.iniciar()
Hud.iniciar()
Menus.iniciar()
Controles.iniciar()
Controles.ligarBotoes(Hud.botoesToque)

Vfx.extras.salto = VisualInimigos.salto
Vfx.extras.anim = Animacoes.receber
Vfx.aoJogadorAtingido = Animacoes.atingido
Vfx.aoDanoLocal = Hud.danoLocal

Hud.aoAbrir = function(nome: string)
	if nome == "classe" then
		Menus.abrirClasses()
	elseif nome == "loja" then
		Menus.abrirLoja()
	else
		Menus.abrirAjuda()
	end
end

local mostrouClasses = false

local function voltarAoLobby()
	Estado.modo = "lobby"
	Estado.stats = nil
	Estado.cartas = {}
	Estado.aliados = {}
	Estado.caido = false
	Estado.morto = false
	Estado.carga = 0
	Estado.habilidadeFim = 0
	Ambiente.lobby()
	Ambiente.caido(false)
	Menus.fecharPartida()
	Hud.modo("lobby")
end

local manipuladores = {
	perfil = function(dados)
		Estado.perfil = dados
		Estado.avisar("perfil")
		if not dados.escolheuClasse and not mostrouClasses and Estado.modo == "lobby" then
			mostrouClasses = true
			task.delay(1, Menus.abrirClasses)
		end
	end,
	lobby = voltarAoLobby,
	fila = Hud.fila,
	inicioPartida = function(dados)
		Estado.modo = "partida"
		Estado.aliados = dados.aliados or {}
		Estado.cartas = {}
		Estado.ouroPartida = 0
		Estado.carga = 0
		Estado.caido = false
		Estado.morto = false
		Menus.fecharLobby()
		Hud.modo("partida")
		Estado.avisar("ouro")
		Estado.avisar("cartas")
	end,
	transicao = function()
		Hud.transicao(true)
	end,
	sala = function(dados)
		Estado.sala = dados
		Ambiente.masmorra(dados.tema)
		Hud.sala(dados)
		Hud.transicao(false)
	end,
	stats = function(dados)
		Estado.stats = dados
		Estado.carga = dados.carga or Estado.carga
		Estado.cargaMax = dados.cargaMax or Estado.cargaMax
		Estado.avisar("stats")
	end,
	carga = function(dados)
		Estado.carga = dados.valor
		Estado.cargaMax = dados.max
		Estado.avisar("carga")
	end,
	recarga = function(dados)
		if dados.tipo == "habilidade" then
			Estado.habilidadeFim = os.clock() + dados.restante
			Estado.habilidadeTotal = dados.total
		end
	end,
	ouro = function(dados)
		Estado.ouroPartida = dados.total
		Estado.avisar("ouro")
		Hud.ganhouOuro(dados.ganho)
	end,
	banner = function(dados)
		Hud.banner(dados.texto, dados.cor)
	end,
	aviso = function(dados)
		Hud.aviso(dados.texto)
	end,
	introChefe = Hud.introChefe,
	cartas = Menus.cartas,
	cartasFechar = Menus.fecharCartas,
	minhasCartas = function(dados)
		Estado.cartas = dados.cartas or {}
		Estado.avisar("cartas")
		Menus.cartaEscolhida()
	end,
	elevador = Menus.elevador,
	caiu = function()
		Estado.caido = true
		Controles.pararAtaque()
		Hud.caiu()
		Ambiente.caido(true)
	end,
	levantou = function()
		Estado.caido = false
		Hud.levantou()
		Ambiente.caido(false)
	end,
	morreu = function()
		Estado.morto = true
		Estado.caido = false
		Controles.pararAtaque()
		Ambiente.caido(false)
		Hud.morreu()
	end,
	reviveu = function()
		Estado.morto = false
		Estado.caido = false
		Ambiente.caido(false)
		Hud.reviveu()
	end,
	fimPartida = Menus.fim,
	abrirLoja = Menus.abrirLoja,
	vfx = Vfx.receber,
}

Evento.OnClientEvent:Connect(function(tipo: string, dados)
	local manipulador = manipuladores[tipo]
	if manipulador then
		manipulador(dados or {})
	end
end)

-- Ao renascer, a câmera volta para o próprio personagem
jogador.CharacterAdded:Connect(function(personagem)
	local humanoid = personagem:WaitForChild("Humanoid", 10)
	if humanoid then
		workspace.CurrentCamera.CameraSubject = humanoid
	end
end)

Hud.modo("lobby")
Acao:FireServer("pronto")
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000031">
          <Properties>
            <string name="Name">Menus</string>
            <ProtectedString name="Source"><![CDATA[-- Menus: escolha de classe, cartas, elevador, loja do mercador, resumo da partida e ajuda.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local Cartas = require(Shared:WaitForChild("Cartas"))

local modulos = script.Parent
local UI = require(modulos.UI)
local Estado = require(modulos.Estado)

local Menus = {}

local jogador = Players.LocalPlayer
local Acao = ReplicatedStorage:WaitForChild("Remotos"):WaitForChild("Acao") :: RemoteEvent
local criar, animar, cores, fontes = UI.criar, UI.animar, UI.cores, UI.fontes

local gui = criar("ScreenGui", {
	Name = "Menus",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 10,
	Parent = jogador:WaitForChild("PlayerGui"),
})

local gradientesGirando = {} -- bordas brilhantes das cartas épicas e lendárias

------------------------------------------------------------------------
-- Abrir e fechar
------------------------------------------------------------------------

local abertos = {}

local function novoMenu(nome: string, largura: number, altura: number)
	local fundo = criar("Frame", {
		Name = nome,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = cores.preto,
		BackgroundTransparency = 0.35,
		Visible = false,
		Parent = gui,
	})
	local conteudo = criar("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(largura, altura),
		BackgroundTransparency = 1,
		Parent = fundo,
	})
	local escala = UI.escalavel(conteudo)
	return { fundo = fundo, conteudo = conteudo, escala = escala }
end

local function abrir(menu)
	if abertos[menu] then
		return
	end
	abertos[menu] = true
	Estado.menusAbertos += 1
	UI.desfocar(true)
	menu.fundo.Visible = true
	menu.fundo.BackgroundTransparency = 1
	animar(menu.fundo, 0.25, { BackgroundTransparency = 0.35 })
	menu.escala.Scale = UI.escalaAtual * 0.9
	animar(menu.escala, 0.3, { Scale = UI.escalaAtual }, Enum.EasingStyle.Back)
end

local function fechar(menu)
	if not abertos[menu] then
		return
	end
	abertos[menu] = nil
	Estado.menusAbertos = math.max(0, Estado.menusAbertos - 1)
	UI.desfocar(false)
	menu.fundo.Visible = false
end

local function botaoFechar(menu)
	local b = UI.botao({
		Parent = menu.conteudo,
		Texto = "✕",
		Estilo = "perigo",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(48, 48),
	})
	b.ZIndex = 10
	b.Activated:Connect(function()
		fechar(menu)
	end)
end

-- Pontinhos de 1 a 5 (força de um atributo)
local function pontos(pai: Instance, posicao: UDim2, valor: number, cor: Color3)
	local linha = criar("Frame", { Position = posicao, Size = UDim2.fromOffset(120, 14), BackgroundTransparency = 1, Parent = pai })
	criar("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), Parent = linha })
	for i = 1, 5 do
		local p = criar("Frame", {
			Size = UDim2.fromOffset(20, 12),
			BackgroundColor3 = if i <= valor then cor else Color3.fromRGB(46, 40, 58),
			BorderSizePixel = 0,
			Parent = linha,
		})
		UI.cantos(p, 3)
		UI.borda(p, cores.preto, 1, 0.4)
	end
end

------------------------------------------------------------------------
-- Escolha de classe
------------------------------------------------------------------------

local menuClasses = novoMenu("Classes", 1220, 690)
botaoFechar(menuClasses)
UI.titulo(menuClasses.conteudo, "ESCOLHA SUA CLASSE", 0, 620, 58)
UI.texto({
	Position = UDim2.fromOffset(0, 72),
	Size = UDim2.new(1, 0, 0, 22),
	FontFace = fontes.texto,
	Text = "Você pode trocar quando quiser nos altares do acampamento",
	TextColor3 = cores.textoSuave,
	Parent = menuClasses.conteudo,
})
local linhaClasses = criar("Frame", { Position = UDim2.fromOffset(0, 106), Size = UDim2.new(1, 0, 0, 570), BackgroundTransparency = 1, Parent = menuClasses.conteudo })
criar("UIListLayout", {
	FillDirection = Enum.FillDirection.Horizontal,
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 14),
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = linhaClasses,
})

local botoesClasse = {}
for ordem, id in Classes.ordem do
	local classe = Classes.dados[id]
	local cartao = UI.painel({ Size = UDim2.fromOffset(286, 566), LayoutOrder = ordem, Parent = linhaClasses })
	local zoom = criar("UIScale", { Parent = cartao })
	local cabecalho = criar("Frame", {
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 0, 130),
		BackgroundColor3 = cores.branco,
		Parent = cartao,
	})
	UI.cantos(cabecalho, 8)
	UI.gradiente(cabecalho, classe.cor, classe.cor:Lerp(cores.fundo, 0.75))
	UI.medalhao({ Parent = cabecalho, Icone = classe.icone, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(96, 96), Cor = classe.cor, EspessuraBorda = 3 })
	local nome = UI.texto({ Position = UDim2.fromOffset(0, 144), Size = UDim2.new(1, 0, 0, 32), FontFace = fontes.cabecalho, Text = classe.nome, TextColor3 = classe.cor:Lerp(cores.branco, 0.35), Parent = cartao })
	UI.contorno(nome, 2)
	UI.texto({ Position = UDim2.fromOffset(0, 176), Size = UDim2.new(1, 0, 0, 18), FontFace = fontes.texto, Text = classe.titulo, TextColor3 = cores.ouro, Parent = cartao })
	local descricao = UI.texto({
		Position = UDim2.fromOffset(16, 198),
		Size = UDim2.new(1, -32, 0, 44),
		FontFace = fontes.texto,
		Text = classe.descricao,
		TextColor3 = cores.texto,
		TextWrapped = true,
		Parent = cartao,
	})
	UI.limiteTexto(descricao, 15)
	-- pontos fortes e fracos
	for i, info in { { "✔ " .. (classe.forte or ""), Color3.fromRGB(130, 230, 140) }, { "✘ " .. (classe.fraco or ""), Color3.fromRGB(255, 120, 120) } } do
		local linha = UI.texto({
			Position = UDim2.fromOffset(16, 244 + (i - 1) * 32),
			Size = UDim2.new(1, -32, 0, 30),
			FontFace = fontes.forte,
			Text = info[1],
			TextColor3 = info[2],
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cartao,
		})
		UI.limiteTexto(linha, 13)
	end
	local y = 314
	for _, atributo in { "Vida", "Dano", "Alcance", "Velocidade" } do
		UI.texto({
			Position = UDim2.fromOffset(20, y),
			Size = UDim2.fromOffset(120, 18),
			FontFace = fontes.forte,
			Text = atributo,
			TextColor3 = cores.textoSuave,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cartao,
		})
		pontos(cartao, UDim2.fromOffset(146, y + 3), classe.notas[atributo], classe.cor)
		y += 22
	end
	for i, info in { { classe.habilidade, "E" }, { classe.supremo, "R" } } do
		local linhaY = 408 + (i - 1) * 52
		UI.medalhao({ Parent = cartao, Icone = info[1].icone, Position = UDim2.fromOffset(14, linhaY), Size = UDim2.fromOffset(40, 40), Cor = classe.cor })
		UI.texto({
			Position = UDim2.fromOffset(60, linhaY),
			Size = UDim2.new(1, -70, 0, 18),
			FontFace = fontes.forte,
			Text = info[1].nome .. "  [" .. info[2] .. "]",
			TextColor3 = cores.ouroClaro,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cartao,
		})
		local d = UI.texto({
			Position = UDim2.fromOffset(60, linhaY + 18),
			Size = UDim2.new(1, -70, 0, 30),
			FontFace = fontes.texto,
			Text = info[1].descricao,
			TextColor3 = cores.textoSuave,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = cartao,
		})
		UI.limiteTexto(d, 12)
	end
	local botao = UI.botao({
		Parent = cartao,
		Texto = "ESCOLHER",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(230, 42),
	})
	botao.Activated:Connect(function()
		if Estado.perfil.classe ~= id or not Estado.perfil.escolheuClasse then
			Acao:FireServer("escolherClasse", id)
		end
		fechar(menuClasses)
	end)
	cartao.MouseEnter:Connect(function()
		animar(zoom, 0.15, { Scale = 1.03 })
	end)
	cartao.MouseLeave:Connect(function()
		animar(zoom, 0.15, { Scale = 1 })
	end)
	botoesClasse[id] = botao
end

local function atualizarClasses()
	for id, botao in botoesClasse do
		local selecionada = Estado.perfil.classe == id and Estado.perfil.escolheuClasse
		UI.textoBotao(botao, if selecionada then "SELECIONADA ✓" else "ESCOLHER")
		UI.estiloBotao(botao, if selecionada then "verde" else "ouro")
	end
end

function Menus.abrirClasses()
	if Estado.modo ~= "lobby" then
		return
	end
	atualizarClasses()
	abrir(menuClasses)
end

------------------------------------------------------------------------
-- Cartas
------------------------------------------------------------------------

local menuCartas = novoMenu("Cartas", 1040, 560)
UI.titulo(menuCartas.conteudo, "ESCOLHA UMA CARTA", 0, 600, 56)
local tempoCartas = UI.texto({
	Position = UDim2.fromOffset(0, 72),
	Size = UDim2.new(1, 0, 0, 24),
	FontFace = fontes.forte,
	Text = "",
	TextColor3 = cores.textoSuave,
	Parent = menuCartas.conteudo,
})
local linhaCartas = criar("Frame", { Position = UDim2.fromOffset(0, 120), Size = UDim2.new(1, 0, 0, 420), BackgroundTransparency = 1, Parent = menuCartas.conteudo })
criar("UIListLayout", {
	FillDirection = Enum.FillDirection.Horizontal,
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 30),
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = linhaCartas,
})

local escolhaFeita = false
local idCartas = 0

local function criarCarta(id: string, indice: number)
	local carta = Cartas.porId[id]
	if not carta then
		return
	end
	local raridade = Config.RARIDADES[carta.raridade]
	local classe = carta.classe and Classes.dados[carta.classe]
	local botao = criar("TextButton", {
		Size = UDim2.fromOffset(280, 410),
		BackgroundColor3 = cores.branco,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = indice,
		Parent = linhaCartas,
	})
	UI.cantos(botao, 14)
	UI.gradiente(botao, raridade.cor:Lerp(cores.fundo, 0.55), cores.fundo)
	local contorno = UI.borda(botao, raridade.cor, 3)
	if carta.raridade == "Epica" or carta.raridade == "Lendaria" then
		local brilho = criar("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, raridade.cor),
				ColorSequenceKeypoint.new(0.5, cores.branco),
				ColorSequenceKeypoint.new(1, raridade.cor),
			}),
			Parent = contorno,
		})
		contorno.Thickness = 4
		table.insert(gradientesGirando, brilho)
	end
	local zoom = criar("UIScale", { Scale = 0, Parent = botao })

	-- Etiqueta da classe
	local etiqueta = criar("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(150, 26),
		BackgroundColor3 = if classe then classe.cor:Lerp(cores.fundo, 0.3) else cores.bronze,
		ZIndex = 3,
		Parent = botao,
	})
	UI.cantos(etiqueta, 13)
	UI.borda(etiqueta, cores.preto, 1.5, 0.2)
	local textoEtiqueta = UI.texto({
		Size = UDim2.fromScale(1, 1),
		FontFace = fontes.numero,
		Text = if classe then string.upper(classe.nome) else "UNIVERSAL",
		ZIndex = 4,
		Parent = etiqueta,
	})
	UI.limiteTexto(textoEtiqueta, 15)

	local rotuloRaridade = UI.texto({ Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 22), FontFace = fontes.cabecalho, Text = raridade.nome, TextColor3 = raridade.cor, Parent = botao })
	UI.contorno(rotuloRaridade, 1.5)
	UI.medalhao({
		Parent = botao,
		Icone = carta.icone,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(124, 124),
		Cor = raridade.cor,
		Borda = raridade.cor:Lerp(cores.branco, 0.3),
		EspessuraBorda = 3,
	})
	local nome = UI.texto({ Position = UDim2.fromOffset(12, 196), Size = UDim2.new(1, -24, 0, 34), FontFace = fontes.cabecalho, Text = carta.nome, Parent = botao })
	UI.contorno(nome, 2)
	UI.separador(botao, UDim2.new(0.5, 0, 0, 240), 200, raridade.cor)
	local descricao = UI.texto({
		Position = UDim2.fromOffset(18, 254),
		Size = UDim2.new(1, -36, 0, 96),
		FontFace = fontes.forte,
		Text = carta.descricao,
		TextColor3 = cores.texto,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = botao,
	})
	UI.limiteTexto(descricao, 21)
	local tenho = Estado.cartas[id] or 0
	if tenho > 0 then
		UI.texto({
			Position = UDim2.new(0, 12, 1, -38),
			Size = UDim2.new(1, -24, 0, 22),
			FontFace = fontes.forte,
			Text = "Você já tem: " .. tenho .. " de " .. carta.maxPilha,
			TextColor3 = cores.ouro,
			Parent = botao,
		})
	end

	-- entrada em sequência
	task.delay((indice - 1) * 0.09, function()
		animar(zoom, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	botao.MouseEnter:Connect(function()
		if not escolhaFeita then
			animar(zoom, 0.12, { Scale = 1.06 })
		end
	end)
	botao.MouseLeave:Connect(function()
		if not escolhaFeita then
			animar(zoom, 0.12, { Scale = 1 })
		end
	end)
	botao.Activated:Connect(function()
		if escolhaFeita then
			return
		end
		escolhaFeita = true
		UI.tocar(UI.SONS.clique, 0.5)
		Acao:FireServer("escolherCarta", indice)
		for _, outro in linhaCartas:GetChildren() do
			if outro:IsA("TextButton") and outro ~= botao then
				local escala = outro:FindFirstChildOfClass("UIScale")
				if escala then
					animar(escala, 0.2, { Scale = 0 })
				end
			end
		end
		animar(zoom, 0.2, { Scale = 1.12 }, Enum.EasingStyle.Back)
		tempoCartas.Text = "Esperando os outros jogadores..."
	end)
end

function Menus.cartas(dados)
	idCartas += 1
	local meu = idCartas
	escolhaFeita = false
	table.clear(gradientesGirando)
	for _, filho in linhaCartas:GetChildren() do
		if filho:IsA("TextButton") then
			filho:Destroy()
		end
	end
	for indice, id in dados.opcoes do
		criarCarta(id, indice)
	end
	abrir(menuCartas)
	local fim = os.clock() + (dados.tempo or 20)
	task.spawn(function()
		while idCartas == meu and abertos[menuCartas] do
			if not escolhaFeita then
				tempoCartas.Text = "⏳ " .. math.max(0, math.ceil(fim - os.clock())) .. "s para escolher"
			end
			task.wait(0.2)
		end
	end)
end

function Menus.fecharCartas()
	fechar(menuCartas)
end

-- O servidor confirmou a carta: fecha logo para o jogador voltar a se mexer
function Menus.cartaEscolhida()
	if escolhaFeita then
		task.delay(0.35, function()
			fechar(menuCartas)
		end)
	end
end

------------------------------------------------------------------------
-- Elevador
------------------------------------------------------------------------

local menuElevador = novoMenu("Elevador", 920, 460)
local painelElevador = UI.painel({ Size = UDim2.fromScale(1, 1), Parent = menuElevador.conteudo })
UI.titulo(painelElevador, "O CHEFE CAIU", 18, 500, 52)
UI.texto({ Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 26), FontFace = fontes.cabecalho, Text = "Para onde agora?", TextColor3 = cores.texto, Parent = painelElevador })

local function opcaoElevador(estilo: string, x: number, icone: string, titulo: string)
	local botao = UI.botao({ Parent = painelElevador, Estilo = estilo, Position = UDim2.fromOffset(x, 130), Size = UDim2.fromOffset(400, 230) })
	local rotulo = botao:FindFirstChild("Rotulo") :: TextLabel
	rotulo.Visible = false
	UI.texto({ Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 70), Text = icone, Parent = botao })
	local t = UI.texto({ Position = UDim2.fromOffset(0, 92), Size = UDim2.new(1, 0, 0, 44), FontFace = fontes.titulo, Text = titulo, TextColor3 = if estilo == "ouro" then Color3.fromRGB(46, 28, 8) else cores.texto, Parent = botao })
	if estilo ~= "ouro" then
		UI.contorno(t, 2)
	end
	local detalhe = UI.texto({
		Position = UDim2.fromOffset(20, 142),
		Size = UDim2.new(1, -40, 0, 70),
		FontFace = fontes.forte,
		Text = "",
		TextColor3 = if estilo == "ouro" then Color3.fromRGB(60, 36, 10) else cores.texto,
		TextWrapped = true,
		Parent = botao,
	})
	UI.limiteTexto(detalhe, 22)
	return botao, detalhe
end

local botaoSubir, detalheSubir = opcaoElevador("ouro", 40, "⬆️", "SUBIR")
local botaoDescer, detalheDescer = opcaoElevador("perigo", 480, "⬇️", "DESCER")
local barraTempo = UI.barra({
	Parent = painelElevador,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 384),
	Size = UDim2.fromOffset(840, 16),
	Cor = cores.ouro,
	Raio = 5,
})
local avisoElevador = UI.texto({
	Position = UDim2.fromOffset(0, 408),
	Size = UDim2.new(1, 0, 0, 22),
	FontFace = fontes.texto,
	Text = "",
	TextColor3 = Color3.fromRGB(255, 170, 160),
	Parent = painelElevador,
})

local function responderElevador(escolha: string)
	if abertos[menuElevador] then
		fechar(menuElevador)
		Acao:FireServer("elevador", escolha)
	end
end
botaoSubir.Activated:Connect(function()
	responderElevador("sair")
end)
botaoDescer.Activated:Connect(function()
	responderElevador("continuar")
end)

local idElevador = 0
function Menus.elevador(dados)
	idElevador += 1
	local meu = idElevador
	fechar(menuCartas)
	detalheSubir.Text = "Volte ao acampamento e guarde 💰 " .. dados.ouro
	detalheDescer.Text = "Siga para a sala " .. dados.proximaSala .. ": inimigos mais fortes e mais ouro"
	avisoElevador.Text = "Se cair lá embaixo, você fica com só " .. math.floor(Config.OURO_MANTIDO_AO_MORRER * 100) .. "% do ouro. Sem resposta, você sobe."
	abrir(menuElevador)
	local total = dados.tempo or 25
	local fim = os.clock() + total
	task.spawn(function()
		while idElevador == meu and abertos[menuElevador] do
			local restante = math.max(0, fim - os.clock())
			barraTempo.definir(restante / total, math.ceil(restante) .. "s")
			task.wait(0.1)
		end
	end)
end

------------------------------------------------------------------------
-- Loja do mercador
------------------------------------------------------------------------

local menuLoja = novoMenu("Loja", 680, 560)
local painelLoja = UI.painel({ Size = UDim2.fromScale(1, 1), Parent = menuLoja.conteudo })
botaoFechar(menuLoja)
UI.titulo(painelLoja, "MERCADOR", 16, 400, 52)
local ouroLoja = UI.texto({ Position = UDim2.fromOffset(0, 84), Size = UDim2.new(1, 0, 0, 28), FontFace = fontes.numero, Text = "", TextColor3 = cores.ouroClaro, Parent = painelLoja })
UI.contorno(ouroLoja, 1.5)

local linhasLoja = {}
for i, melhoria in Config.MELHORIAS do
	local linha = criar("Frame", {
		Position = UDim2.fromOffset(28, 128 + (i - 1) * 132),
		Size = UDim2.new(1, -56, 0, 118),
		BackgroundColor3 = cores.branco,
		Parent = painelLoja,
	})
	UI.cantos(linha, 10)
	UI.gradiente(linha, cores.painelClaro, cores.fundo)
	UI.borda(linha, cores.bronze, 1.5)
	UI.medalhao({ Parent = linha, Icone = melhoria.icone, Position = UDim2.fromOffset(14, 20), Size = UDim2.fromOffset(78, 78), Cor = cores.painelClaro })
	local nome = UI.texto({
		Position = UDim2.fromOffset(106, 14),
		Size = UDim2.fromOffset(300, 30),
		FontFace = fontes.cabecalho,
		Text = melhoria.nome,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = linha,
	})
	UI.contorno(nome, 1.5)
	UI.texto({
		Position = UDim2.fromOffset(106, 46),
		Size = UDim2.fromOffset(300, 22),
		FontFace = fontes.texto,
		Text = melhoria.descricao,
		TextColor3 = cores.textoSuave,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = linha,
	})
	local niveis = criar("Frame", { Position = UDim2.fromOffset(110, 80), Size = UDim2.fromOffset(300, 16), BackgroundTransparency = 1, Parent = linha })
	criar("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), VerticalAlignment = Enum.VerticalAlignment.Center, Parent = niveis })
	local marcas = {}
	for n = 1, melhoria.nivelMax do
		local marca = criar("Frame", { Size = UDim2.fromOffset(12, 12), Rotation = 45, BackgroundColor3 = cores.bronze, BorderSizePixel = 0, LayoutOrder = n, Parent = niveis })
		UI.borda(marca, cores.preto, 1, 0.3)
		marcas[n] = marca
	end
	local comprar = UI.botao({ Parent = linha, Position = UDim2.new(1, -172, 0.5, -28), Size = UDim2.fromOffset(156, 56) })
	comprar.Activated:Connect(function()
		Acao:FireServer("comprarMelhoria", melhoria.id)
	end)
	linhasLoja[melhoria.id] = { melhoria = melhoria, botao = comprar, marcas = marcas }
end

local function atualizarLoja()
	local perfil = Estado.perfil
	ouroLoja.Text = "Seu ouro: 💰 " .. (perfil.ouro or 0)
	for id, linha in linhasLoja do
		local nivel = (perfil.melhorias and perfil.melhorias[id]) or 0
		for n, marca in linha.marcas do
			marca.BackgroundColor3 = if n <= nivel then cores.ouro else Color3.fromRGB(56, 48, 66)
		end
		if nivel >= linha.melhoria.nivelMax then
			UI.textoBotao(linha.botao, "MÁXIMO")
			UI.estiloBotao(linha.botao, "cinza")
		else
			local preco = Config.precoMelhoria(linha.melhoria, nivel)
			UI.textoBotao(linha.botao, "💰 " .. preco)
			UI.estiloBotao(linha.botao, if (perfil.ouro or 0) >= preco then "ouro" else "cinza")
		end
	end
end

function Menus.abrirLoja()
	if Estado.modo ~= "lobby" then
		return
	end
	atualizarLoja()
	abrir(menuLoja)
end

