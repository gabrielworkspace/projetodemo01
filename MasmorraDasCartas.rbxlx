-- Elites: versões mais fortes com um poder especial
Inimigos.ELITES = {
	Blindado = { cor = Color3.fromRGB(205, 215, 235), vida = 1.8, armadura = 0.3 },
	Veloz = { cor = Color3.fromRGB(255, 232, 80), velocidade = 1.45, recarga = 0.7 },
	["Gélido"] = { cor = Color3.fromRGB(120, 210, 255), gelido = true },
	Explosivo = { cor = Color3.fromRGB(255, 120, 40), explosivo = true },
	Gigante = { cor = Color3.fromRGB(255, 80, 80), escala = 1.45, vida = 2.5, dano = 1.3 },
}
Inimigos.LISTA_ELITES = { "Blindado", "Veloz", "Gélido", "Explosivo", "Gigante" }

------------------------------------------------------------------------
-- Criação
------------------------------------------------------------------------

local function criarCaixa(nome: string, tamanho: Vector3, quadril: number)
	local modelo = Instance.new("Model")
	modelo.Name = nome

	local raiz = Instance.new("Part")
	raiz.Name = "HumanoidRootPart"
	raiz.Size = tamanho
	raiz.Transparency = 1
	raiz.CanCollide = true
	raiz.CFrame = CFrame.new()
	raiz.Parent = modelo
	modelo.PrimaryPart = raiz

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = quadril
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.Parent = modelo
	-- A vida é controlada pelo nosso código; o Humanoid só serve para andar
	for _, estado in {
		Enum.HumanoidStateType.Dead,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Climbing,
		Enum.HumanoidStateType.Seated,
	} do
		humanoid:SetStateEnabled(estado, false)
	end
	return modelo, raiz, humanoid
end

-- "posicao" é um ponto no chão. mult = { vida, dano }. elite = nome da elite ou nil.
function Inimigos.criar(run, tipo: string, posicao: Vector3, mult, elite: string?)
	local def = Inimigos.TIPOS[tipo]
	local modificador = elite and Inimigos.ELITES[elite]
	local escala = if modificador then modificador.escala or 1 else 1
	local vida = def.vida * mult.vida * (if modificador then 1.5 * (modificador.vida or 1) else 1)
	local dano = def.dano * mult.dano * (if modificador then modificador.dano or 1 else 1)

	local modelo, raiz, humanoid = criarCaixa(def.nome, def.raiz * escala, def.quadril * escala)
	local alturaRaiz = def.quadril * escala + def.raiz.Y * escala / 2

	modelo:SetAttribute("Tipo", tipo)
	modelo:SetAttribute("Nome", def.nome)
	modelo:SetAttribute("Titulo", def.titulo or "")
	modelo:SetAttribute("Chefe", def.chefe == true)
	modelo:SetAttribute("Elite", elite or "")
	modelo:SetAttribute("Escala", escala)
	modelo:SetAttribute("Vida", vida)
	modelo:SetAttribute("VidaMax", vida)
	modelo:SetAttribute("AlturaBarra", def.alturaBarra * escala)
	modelo:SetAttribute("Acao", "")
	modelo:SetAttribute("Furioso", false)
	CollectionService:AddTag(modelo, "Inimigo")

	local centroSala = if run.sala then run.sala.origem else posicao
	local olhar = unidade(centroSala - posicao, Vector3.new(0, 0, -1))
	modelo:PivotTo(CFrame.lookAt(posicao + Vector3.new(0, alturaRaiz + 0.2, 0), posicao + Vector3.new(0, alturaRaiz + 0.2, 0) + olhar))
	modelo.Parent = run.pasta
	pcall(function()
		raiz:SetNetworkOwner(nil) -- o servidor controla o movimento
	end)

	local ataques = {}
	for _, ataque in def.ataques do
		table.insert(ataques, ataque)
	end

	local agora = os.clock()
	local inimigo = {
		tipo = tipo,
		def = def,
		modelo = modelo,
		raiz = raiz,
		humanoid = humanoid,
		vida = vida,
		vidaMax = vida,
		dano = dano,
		mult = mult,
		escala = escala,
		raio = def.raio * escala,
		alturaRaiz = alturaRaiz,
		alturaBarra = def.alturaBarra * escala,
		armadura = (def.armadura or 0) + (if modificador then modificador.armadura or 0 else 0),
		pesado = def.pesado == true or escala > 1.2,
		chefe = def.chefe == true,
		elite = elite,
		modificador = modificador,
		velocidadeMult = if modificador then modificador.velocidade or 1 else 1,
		recargaMult = if modificador then modificador.recarga or 1 else 1,
		ouro = def.ouro * (if elite then 3 else 1),
		vivo = true,
		ameaca = {},
		ataques = ataques,
		prontoEm = {},
		ocupadoAte = agora + 0.4,
		proximaDecisao = agora + math.random() * 0.2,
		lentoAte = 0,
		lentoFator = 1,
		atordoadoAte = 0,
		acaoN = 0,
		lado = if math.random() < 0.5 then -1 else 1,
		trocaLadoEm = agora + 2,
	}
	for _, ataque in ataques do
		inimigo.prontoEm[ataque] = agora + (ataque.inicial or math.random() * (ataque.recarga or 1) * 0.5)
	end
	run.inimigos[inimigo] = true
	return inimigo
end

------------------------------------------------------------------------
-- Ajudantes
------------------------------------------------------------------------

local function definirAcao(inimigo, nome: string)
	inimigo.acaoN += 1
	if inimigo.modelo.Parent then
		inimigo.modelo:SetAttribute("Acao", nome .. "|" .. inimigo.acaoN)
	end
end

local function podeContinuar(run, inimigo): boolean
	return inimigo.vivo and run.ativa and os.clock() >= inimigo.atordoadoAte
end

local function noChao(run, pos: Vector3): Vector3
	return Vector3.new(pos.X, if run.sala then run.sala.origem.Y else pos.Y, pos.Z)
end

local function limitarNaSala(run, pos: Vector3, margem: number): Vector3
	local sala = run.sala
	if not sala then
		return pos
	end
	local local_ = pos - sala.origem
	local x = math.clamp(local_.X, -sala.largura / 2 + margem + 1, sala.largura / 2 - margem - 1)
	local z = math.clamp(local_.Z, -sala.comprimento / 2 + margem + 1, sala.comprimento / 2 - margem - 1)
	return sala.origem + Vector3.new(x, local_.Y, z)
end

local function parar(inimigo)
	inimigo.humanoid:MoveTo(inimigo.raiz.Position)
end

local function olharPara(inimigo, alvo: Vector3)
	local pos = inimigo.raiz.Position
	local direcao = planar(alvo - pos)
	if direcao.Magnitude > 0.1 then
		inimigo.raiz.CFrame = CFrame.lookAt(pos, pos + direcao)
	end
end

local function jogadoresAtingiveis(run)
	local lista = {}
	for _, estado in run.jogadores do
		if estado.vivo and not estado.caido then
			local raiz = Combate.raizDe(estado)
			if raiz then
				table.insert(lista, { estado = estado, raiz = raiz })
			end
		end
	end
	return lista
end

local function opcoesDoEfeito(inimigo, efeito: string?)
	local opcoes = {}
	if efeito == "lento" or (inimigo.modificador and inimigo.modificador.gelido) then
		opcoes.lento = { fator = 0.6, duracao = 2 }
	end
	if efeito == "queimar" then
		opcoes.queimar = inimigo.dano * 0.15
	end
	return opcoes
end

-- Acerta os jogadores dentro de um cone (ou círculo, se arco >= 360)
local function acertarJogadores(run, inimigo, centro: Vector3, direcao: Vector3?, alcance: number, arco: number, mult: number, efeito: string?)
	local limite = math.cos(math.rad(math.min(arco, 359) / 2 + 10))
	for _, info in jogadoresAtingiveis(run) do
		local delta = planar(info.raiz.Position - centro)
		local distancia = delta.Magnitude
		if distancia <= alcance + 1.6 then
			local dentro = arco >= 360 or not direcao or distancia < 2 or delta.Unit:Dot(direcao) >= limite
			if dentro then
				Combate.danoAoJogador(run, info.estado, inimigo.dano * mult, inimigo, opcoesDoEfeito(inimigo, efeito))
			end
		end
	end
end

local function corDoEfeito(efeito: string?): Color3
	if efeito == "queimar" then
		return Color3.fromRGB(255, 120, 40)
	elseif efeito == "lento" then
		return Color3.fromRGB(130, 210, 255)
	end
	return Color3.fromRGB(255, 70, 70)
end

local function contarInimigos(run): number
	local total = 0
	for _ in run.inimigos do
		total += 1
	end
	return total
end

------------------------------------------------------------------------
-- Ataques. Cada um devolve false se não pôde ser usado agora.
------------------------------------------------------------------------

local function ataqueGolpe(run, inimigo, ataque, alvoPos: Vector3, agora: number): boolean
	local alcance = ataque.alcance * inimigo.escala
	local arco = ataque.arco or 100
	local preparo = ataque.preparo * inimigo.recargaMult
	local acertos = ataque.acertos or 1
	local entre = ataque.entreAcertos or 0.3
	local direcao = unidade(alvoPos - inimigo.raiz.Position, inimigo.raiz.CFrame.LookVector)
	local giro = arco >= 360

	parar(inimigo)
	olharPara(inimigo, alvoPos)
	definirAcao(inimigo, if giro then "prepararGiro" else "preparar")
	inimigo.ocupadoAte = agora + preparo + (acertos - 1) * entre + 0.4
	Vfx.partida(run, "telegrafo", {
		forma = if giro then "circulo" else "cone",
		pos = noChao(run, inimigo.raiz.Position),
		dir = direcao,
		raio = alcance,
		arco = arco,
		duracao = preparo,
		chefe = inimigo.chefe,
	})

	task.delay(preparo, function()
		for i = 1, acertos do
			if not podeContinuar(run, inimigo) then
				return
			end
			definirAcao(inimigo, if giro then "giro" else "golpe")
			local centro = inimigo.raiz.Position
			Vfx.partida(run, "golpeInimigo", { pos = centro, dir = direcao, alcance = alcance, arco = arco, cor = corDoEfeito(ataque.efeito) })
			acertarJogadores(run, inimigo, centro, direcao, alcance, arco, ataque.mult or 1, ataque.efeito)
			if i < acertos then
				task.wait(entre)
			end
		end
		task.delay(0.3, function()
			if inimigo.vivo then
				definirAcao(inimigo, "")
			end
		end)
	end)
	return true
end

local function ataqueDisparo(run, inimigo, ataque, alvo, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + preparo + 0.35
	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		local raizAlvo = Combate.raizDe(alvo)
		local origem = inimigo.raiz.Position + Vector3.new(0, 0.8, 0)
		local destino = if raizAlvo and alvo.vivo then raizAlvo.Position else origem + inimigo.raiz.CFrame.LookVector * 10
		olharPara(inimigo, destino)
		definirAcao(inimigo, "disparo")
		local direcao = unidade(destino - origem, inimigo.raiz.CFrame.LookVector)
		local quantidade = ataque.quantidade or 1
		local abertura = ataque.espalhamento or 10
		local lista = {}
		for i = 1, quantidade do
			local angulo = math.rad((i - (quantidade + 1) / 2) * abertura)
			table.insert(lista, {
				lado = "inimigo",
				tipo = ataque.projetil,
				pos = origem + direcao * inimigo.raio,
				dir = CFrame.Angles(0, angulo, 0):VectorToWorldSpace(direcao),
				velocidade = ataque.velocidade or 45,
				alcance = (ataque.alcance or 45) * 1.3,
				raio = 1.1,
				aoAcertar = function(estado)
					Combate.danoAoJogador(run, estado, inimigo.dano * (ataque.mult or 1), inimigo, opcoesDoEfeito(inimigo, ataque.efeito))
				end,
			})
		end
		Projeteis.disparar(run, lista)
		task.delay(0.3, function()
			if inimigo.vivo then
				definirAcao(inimigo, "")
			end
		end)
	end)
	return true
end

local function ataqueRajada(run, inimigo, ataque, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + preparo + 0.5
	Vfx.partida(run, "telegrafo", { forma = "circulo", pos = noChao(run, inimigo.raiz.Position), raio = inimigo.raio + 3, duracao = preparo, chefe = true })
	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		definirAcao(inimigo, "disparo")
		local quantidade = ataque.quantidade or 12
		local giro = math.random() * math.pi
		local origem = inimigo.raiz.Position
		local lista = {}
		for i = 1, quantidade do
			local angulo = giro + i * (math.pi * 2 / quantidade)
			local direcao = Vector3.new(math.sin(angulo), 0, math.cos(angulo))
			table.insert(lista, {
				lado = "inimigo",
				tipo = ataque.projetil,
				pos = origem + direcao * (inimigo.raio + 1),
				dir = direcao,
				velocidade = ataque.velocidade or 35,
				alcance = 70,
				raio = 1.2,
				aoAcertar = function(estado)
					Combate.danoAoJogador(run, estado, inimigo.dano * (ataque.mult or 1), inimigo, opcoesDoEfeito(inimigo, ataque.efeito))
				end,
			})
		end
		Projeteis.disparar(run, lista)
		task.delay(0.4, function()
			if inimigo.vivo then
				definirAcao(inimigo, "")
			end
		end)
	end)
	return true
end

local function ataqueInvestida(run, inimigo, ataque, alvoPos: Vector3, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	local direcao = unidade(alvoPos - inimigo.raiz.Position, inimigo.raiz.CFrame.LookVector)
	local distancia = ataque.distancia * inimigo.escala
	local largura = ataque.largura * inimigo.escala

	parar(inimigo)
	olharPara(inimigo, alvoPos)
	definirAcao(inimigo, "prepararInvestida")
	inimigo.ocupadoAte = agora + preparo + 0.7
	Vfx.partida(run, "telegrafo", {
		forma = "linha",
		pos = noChao(run, inimigo.raiz.Position),
		dir = direcao,
		comprimento = distancia,
		largura = largura,
		duracao = preparo,
		chefe = inimigo.chefe,
	})

	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		definirAcao(inimigo, "investida")
		local destino = limitarNaSala(run, inimigo.raiz.Position + direcao * distancia, inimigo.raio)
		inimigo.investindo = true
		inimigo.humanoid.WalkSpeed = 75
		inimigo.humanoid:MoveTo(destino)
		local atingidos = {}
		local fim = os.clock() + 0.5
		while os.clock() < fim and inimigo.vivo and run.ativa do
			for _, info in jogadoresAtingiveis(run) do
				if not atingidos[info.estado] and planar(info.raiz.Position - inimigo.raiz.Position).Magnitude <= inimigo.raio + largura / 2 + 0.5 then
					atingidos[info.estado] = true
					Combate.danoAoJogador(run, info.estado, inimigo.dano * (ataque.mult or 1), inimigo, opcoesDoEfeito(inimigo, ataque.efeito))
				end
			end
			task.wait(0.05)
		end
		inimigo.investindo = false
		if inimigo.vivo then
			parar(inimigo)
			definirAcao(inimigo, "")
		end
	end)
	return true
end

local function ataqueSalto(run, inimigo, ataque, alvoPos: Vector3, agora: number): boolean
	local preparo = ataque.preparo * inimigo.recargaMult
	local voo = ataque.voo or 0.6
	local raio = ataque.raio * inimigo.escala
	local destino = limitarNaSala(run, noChao(run, alvoPos), inimigo.raio)

	parar(inimigo)
	olharPara(inimigo, alvoPos)
	definirAcao(inimigo, "prepararSalto")
	inimigo.ocupadoAte = agora + preparo + voo + 0.45
	Vfx.partida(run, "telegrafo", { forma = "circulo", pos = destino, raio = raio, duracao = preparo + voo, chefe = inimigo.chefe })

	task.delay(preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		definirAcao(inimigo, "salto")
		local chegada = destino + Vector3.new(0, inimigo.alturaRaiz, 0)
		Vfx.partida(run, "salto", { modelo = inimigo.modelo, de = inimigo.raiz.Position, para = chegada, duracao = voo })
		task.delay(voo, function()
			if not inimigo.vivo or not run.ativa then
				return
			end
			local olhar = unidade(destino - inimigo.raiz.Position, inimigo.raiz.CFrame.LookVector)
			inimigo.modelo:PivotTo(CFrame.lookAt(chegada, chegada + olhar))
			Vfx.partida(run, "impacto", { pos = destino, raio = raio, cor = corDoEfeito(ataque.efeito), forte = inimigo.chefe })
			acertarJogadores(run, inimigo, destino, nil, raio, 360, ataque.mult or 1, ataque.efeito)
			definirAcao(inimigo, "")
		end)
	end)
	return true
end

local function ataqueExplodir(run, inimigo, ataque, agora: number): boolean
	local raio = ataque.raio * inimigo.escala
	parar(inimigo)
	definirAcao(inimigo, "prepararExplosao")
	inimigo.ocupadoAte = agora + 99
	Vfx.partida(run, "telegrafo", { forma = "circulo", pos = noChao(run, inimigo.raiz.Position), raio = raio, duracao = ataque.preparo })
	task.delay(ataque.preparo, function()
		if not inimigo.vivo or not run.ativa then
			return
		end
		local centro = inimigo.raiz.Position
		Vfx.partida(run, "explosao", { pos = centro, raio = raio, cor = ataque.cor or Color3.fromRGB(255, 140, 40), forte = true })
		acertarJogadores(run, inimigo, centro, nil, raio, 360, ataque.mult or 1, ataque.efeito)
		run:aoMorrerInimigo(inimigo, nil)
	end)
	return true
end

local function ataqueInvocar(run, inimigo, ataque, agora: number): boolean
	if contarInimigos(run) >= (ataque.maxVivos or 12) or not run.sala then
		return false
	end
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + ataque.preparo + 0.4
	task.delay(ataque.preparo, function()
		if not podeContinuar(run, inimigo) or not run.sala then
			return
		end
		for i = 1, ataque.quantidade or 2 do
			local angulo = i * (math.pi * 2 / (ataque.quantidade or 2)) + math.random()
			local pos = noChao(run, inimigo.raiz.Position + Vector3.new(math.cos(angulo), 0, math.sin(angulo)) * (inimigo.raio + 5))
			pos = limitarNaSala(run, pos, 2)
			if Masmorra.posicaoValida(run.sala, pos, 1.5) then
				run:invocar(ataque.invocado, pos, nil)
			end
		end
		definirAcao(inimigo, "")
	end)
	return true
end

local function ataqueArea(run, inimigo, ataque, agora: number): boolean
	if not run.sala then
		return false
	end
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + ataque.preparo + 0.4
	task.delay(ataque.preparo, function()
		if not podeContinuar(run, inimigo) or not run.sala then
			return
		end
		local pontos = {}
		local alvos = jogadoresAtingiveis(run)
		for _, info in alvos do
			table.insert(pontos, noChao(run, info.raiz.Position))
		end
		while #pontos < (ataque.quantidade or 3) and #alvos > 0 do
			local base = alvos[math.random(#alvos)].raiz.Position
			table.insert(pontos, limitarNaSala(run, noChao(run, base + Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))), 2))
		end
		local raio = ataque.raio
		local atraso = ataque.atraso or 1.2
		for i = 1, math.min(#pontos, ataque.quantidade or 3) do
			local ponto = pontos[i]
			Vfx.partida(run, "telegrafo", { forma = "circulo", pos = ponto, raio = raio, duracao = atraso, chefe = true })
			if ataque.visual == "meteoro" then
				Vfx.partida(run, "meteoro", { pos = ponto, duracao = atraso, raio = raio })
			end
			task.delay(atraso, function()
				if not run.ativa then
					return
				end
				Vfx.partida(run, "impactoArea", { pos = ponto, raio = raio, visual = ataque.visual })
				for _, info in jogadoresAtingiveis(run) do
					if planar(info.raiz.Position - ponto).Magnitude <= raio + 1 then
						Combate.danoAoJogador(run, info.estado, inimigo.dano * (ataque.mult or 1), nil, opcoesDoEfeito(inimigo, ataque.efeito))
					end
				end
			end)
		end
		definirAcao(inimigo, "")
	end)
	return true
end

local function ataqueTeleporte(run, inimigo, ataque, agora: number): boolean
	local sala = run.sala
	if not sala then
		return false
	end
	local alvos = jogadoresAtingiveis(run)
	local destino = nil
	for _ = 1, 20 do
		local ponto = Masmorra.pontoLivre(sala, run.rng, inimigo.raio + 1)
		if ponto then
			local longe = true
			for _, info in alvos do
				if planar(info.raiz.Position - ponto).Magnitude < 14 then
					longe = false
				end
			end
			if longe then
				destino = ponto
				break
			end
		end
	end
	if not destino then
		return false
	end
	parar(inimigo)
	definirAcao(inimigo, "conjurar")
	inimigo.ocupadoAte = agora + ataque.preparo + 0.5
	Vfx.partida(run, "teleporte", { pos = inimigo.raiz.Position })
	task.delay(ataque.preparo, function()
		if not podeContinuar(run, inimigo) then
			return
		end
		local chegada = destino + Vector3.new(0, inimigo.alturaRaiz, 0)
		inimigo.modelo:PivotTo(CFrame.new(chegada) * inimigo.raiz.CFrame.Rotation)
		Vfx.partida(run, "teleporte", { pos = chegada })
		definirAcao(inimigo, "")
	end)
	return true
end

local function executarAtaque(run, inimigo, ataque, alvo, alvoPos: Vector3, agora: number): boolean
	local tipo = ataque.tipo
	if tipo == "golpe" then
		return ataqueGolpe(run, inimigo, ataque, alvoPos, agora)
	elseif tipo == "disparo" then
		return ataqueDisparo(run, inimigo, ataque, alvo, agora)
	elseif tipo == "rajada" then
		return ataqueRajada(run, inimigo, ataque, agora)
	elseif tipo == "investida" then
		return ataqueInvestida(run, inimigo, ataque, alvoPos, agora)
	elseif tipo == "salto" then
		return ataqueSalto(run, inimigo, ataque, alvoPos, agora)
	elseif tipo == "explodir" then
		return ataqueExplodir(run, inimigo, ataque, agora)
	elseif tipo == "invocar" then
		return ataqueInvocar(run, inimigo, ataque, agora)
	elseif tipo == "area" then
		return ataqueArea(run, inimigo, ataque, agora)
	elseif tipo == "teleporte" then
		return ataqueTeleporte(run, inimigo, ataque, agora)
	end
	return false
end

------------------------------------------------------------------------
-- Movimento e decisões
------------------------------------------------------------------------

-- Anda até o destino desviando de pilares e de outros inimigos
local function mover(run, inimigo, destino: Vector3)
	local pos = inimigo.raiz.Position
	local caminho = planar(destino - pos)
	local distancia = caminho.Magnitude
	if distancia < 0.5 then
		return
	end
	local direcao = caminho / distancia

	if run.sala then
		for _, pilar in run.sala.pilares do
			local paraPilar = planar(pilar.pos - pos)
			local projecao = paraPilar:Dot(direcao)
			if projecao > 0 and projecao < math.min(distancia, 14) then
				local lateral = paraPilar - direcao * projecao
				if lateral.Magnitude < pilar.raio + inimigo.raio + 1.5 then
					local desvio = -lateral
					if desvio.Magnitude < 0.01 then
						desvio = Vector3.new(-direcao.Z, 0, direcao.X)
					end
					direcao = (direcao + desvio.Unit * 1.4).Unit
				end
			end
		end
	end

	for outro in run.inimigos do
		if outro ~= inimigo and outro.vivo then
			local afastar = planar(pos - outro.raiz.Position)
			local m = afastar.Magnitude
			if m > 0.01 and m < inimigo.raio + outro.raio + 0.5 then
				direcao += afastar / m * 0.6
			end
		end
	end

	if direcao.Magnitude > 0.01 then
		inimigo.humanoid:MoveTo(limitarNaSala(run, pos + direcao.Unit * 6, inimigo.raio))
	end
end

local function escolherAlvo(run, inimigo)
	local pos = inimigo.raiz.Position
	local melhor, melhorNota, melhorDistancia = nil, -math.huge, math.huge
	for estado, valor in inimigo.ameaca do
		inimigo.ameaca[estado] = valor * 0.985
	end
	for _, info in jogadoresAtingiveis(run) do
		local distancia = planar(info.raiz.Position - pos).Magnitude
		local nota = (inimigo.ameaca[info.estado] or 0) - distancia * 3
		if info.estado == inimigo.alvoAtual then
			nota += 15 -- não troca de alvo a toda hora
		end
		if nota > melhorNota then
			melhor, melhorNota, melhorDistancia = info, nota, distancia
		end
	end
	inimigo.alvoAtual = melhor and melhor.estado
	return melhor, melhorDistancia
end

local function entrarNaFase2(run, inimigo)
	local fase2 = inimigo.def.fase2
	inimigo.fase2 = true
	inimigo.velocidadeMult *= fase2.velocidade or 1
	inimigo.recargaMult *= fase2.recarga or 1
	if fase2.ataques then
		for i, ataque in fase2.ataques do
			table.insert(inimigo.ataques, i, ataque)
			inimigo.prontoEm[ataque] = os.clock() + (ataque.inicial or 1)
		end
	end
	inimigo.modelo:SetAttribute("Furioso", true)
	run:anunciar("🔥 " .. (fase2.anuncio or (inimigo.def.nome .. " se enfurece!")), Color3.fromRGB(255, 90, 60))
	Vfx.partida(run, "furia", { pos = inimigo.raiz.Position })
end

local function decidir(run, inimigo, agora: number)
	local def = inimigo.def

	if agora < inimigo.atordoadoAte then
		parar(inimigo)
		return
	elseif inimigo.modelo:GetAttribute("Atordoado") then
		inimigo.modelo:SetAttribute("Atordoado", false)
	end
	if agora >= inimigo.lentoAte and inimigo.lentoFator < 1 then
		inimigo.lentoFator = 1
		inimigo.modelo:SetAttribute("Lento", false)
	end

	if inimigo.chefe and def.fase2 and not inimigo.fase2 and inimigo.vida <= inimigo.vidaMax * 0.5 then
		entrarNaFase2(run, inimigo)
	end

	if agora < inimigo.ocupadoAte or inimigo.investindo then
		return
	end

	local velocidade = def.velocidade * inimigo.velocidadeMult
	if agora < inimigo.lentoAte then
		velocidade *= inimigo.lentoFator
	end
	inimigo.humanoid.WalkSpeed = velocidade

	local info, distancia = escolherAlvo(run, inimigo)
	if not info then
		parar(inimigo)
		return
	end
	local alvoPos = info.raiz.Position

	for _, ataque in inimigo.ataques do
		if agora >= (inimigo.prontoEm[ataque] or 0) and distancia <= (ataque.alcance or 999) * inimigo.escala and distancia >= (ataque.minimo or 0) then
			if executarAtaque(run, inimigo, ataque, info.estado, alvoPos, agora) then
				inimigo.prontoEm[ataque] = agora + (ataque.recarga or 2) * inimigo.recargaMult
				return
			else
				inimigo.prontoEm[ataque] = agora + 2
			end
		end
	end

	-- Ninguém no alcance: anda
	local comportamento = def.comportamento or "perseguir"
	if comportamento == "perseguir" then
		local alcanceGolpe = 4
		for _, ataque in inimigo.ataques do
			if ataque.tipo == "golpe" or ataque.tipo == "explodir" then
				alcanceGolpe = math.max(alcanceGolpe, ataque.alcance * inimigo.escala)
			end
		end
		if distancia > alcanceGolpe * 0.75 then
			mover(run, inimigo, alvoPos)
		else
			parar(inimigo)
			olharPara(inimigo, alvoPos)
		end
	else
		local ideal = def.distancia or 24
		local pos = inimigo.raiz.Position
		if agora >= inimigo.trocaLadoEm then
			inimigo.lado = -inimigo.lado
			inimigo.trocaLadoEm = agora + 1.5 + math.random() * 2
		end
		if distancia > ideal + 4 then
			mover(run, inimigo, alvoPos)
		elseif distancia < ideal - 8 then
			mover(run, inimigo, pos + unidade(pos - alvoPos, Vector3.new(1, 0, 0)) * 10)
		else
			-- anda de lado para não ficar parado
			local paraAlvo = unidade(alvoPos - pos, Vector3.new(0, 0, 1))
			mover(run, inimigo, pos + Vector3.new(-paraAlvo.Z, 0, paraAlvo.X) * inimigo.lado * 6)
		end
	end
end

-- Chamado a cada frame pelo controlador da partida
function Inimigos.atualizar(run, agora: number)
	local lista = {}
	for inimigo in run.inimigos do
		table.insert(lista, inimigo)
	end
	for _, inimigo in lista do
		if inimigo.vivo and agora >= inimigo.proximaDecisao then
			inimigo.proximaDecisao = agora + 0.12
			decidir(run, inimigo, agora)
		end
	end
end

------------------------------------------------------------------------
-- Morte
------------------------------------------------------------------------

function Inimigos.morrer(run, inimigo)
	if not inimigo.vivo then
		return
	end
	inimigo.vivo = false
	run.inimigos[inimigo] = nil
	local posicao = inimigo.raiz.Position
	inimigo.modelo:Destroy() -- os jogadores veem a animação de morte no próprio computador

	if not run.ativa or not run.sala then
		return
	end
	local chao = noChao(run, posicao)

	-- Gosmas se dividem em gosminhas
	if inimigo.def.divide then
		for i = 1, 2 do
			local angulo = i * math.pi + math.random()
			run:invocar(inimigo.def.divide, chao + Vector3.new(math.cos(angulo), 0, math.sin(angulo)) * 2, nil, true)
		end
	end

	-- Elite explosiva: explode logo depois de morrer
	if inimigo.modificador and inimigo.modificador.explosivo then
		local raio = 8 * inimigo.escala
		Vfx.partida(run, "telegrafo", { forma = "circulo", pos = chao, raio = raio, duracao = 1 })
		task.delay(1, function()
			if not run.ativa then
				return
			end
			Vfx.partida(run, "explosao", { pos = chao, raio = raio, cor = Color3.fromRGB(255, 120, 40), forte = true })
			for _, info in jogadoresAtingiveis(run) do
				if planar(info.raiz.Position - chao).Magnitude <= raio + 1 then
					Combate.danoAoJogador(run, info.estado, inimigo.dano * 1.5, nil, {})
				end
			end
		end)
	end
end

function Inimigos.limparTodos(run)
	for inimigo in run.inimigos do
		inimigo.vivo = false
		inimigo.modelo:Destroy()
	end
	table.clear(run.inimigos)
end

return Inimigos
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000015">
        <Properties>
          <string name="Name">Lobby</string>
          <ProtectedString name="Source"><![CDATA[-- Lobby (o acampamento): terreno, altares das classes, portal da masmorra e loja do mercador.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))

local servidor = script.Parent
local Remotos = require(servidor.Remotos)
local Dados = require(servidor.Dados)
local Vfx = require(servidor.Vfx)
local Armas = require(servidor.Armas)
local Partida = require(servidor.Partida)

local Lobby = {}

local POSICAO_PORTAL = Vector3.new(0, 0, -46)
local RAIO_PORTAL = 9
local EM_PE = CFrame.Angles(0, 0, math.rad(90))
local ROXO = Color3.fromRGB(150, 70, 255)
local PEDRA = Color3.fromRGB(120, 116, 122)
local PEDRA_ESCURA = Color3.fromRGB(72, 68, 76)
local MADEIRA = Color3.fromRGB(100, 68, 44)

local modelo = Instance.new("Model")
modelo.Name = "Lobby"

local function parte(nome: string, tamanho: Vector3, cframe: CFrame, material: Enum.Material, cor: Color3, opcoes): Part
	opcoes = opcoes or {}
	local p = Instance.new("Part")
	p.Name = nome
	p.Anchored = true
	p.Shape = opcoes.formato or Enum.PartType.Block
	p.Size = tamanho
	p.CFrame = cframe
	p.Material = material
	p.Color = cor
	p.Transparency = opcoes.transparencia or 0
	p.CanCollide = opcoes.colide ~= false
	if opcoes.colide == false then
		p.CanQuery = false
		p.CanTouch = false
	end
	p.CastShadow = opcoes.sombra ~= false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = opcoes.pai or modelo
	return p
end

local function luz(pai: Instance, cor: Color3, alcance: number, brilho: number, tremula: boolean?)
	local l = Instance.new("PointLight")
	l.Color = cor
	l.Range = alcance
	l.Brightness = brilho
	l.Parent = pai
	if tremula then
		CollectionService:AddTag(l, "Chama")
	end
end

local function sequencia(pontos): NumberSequence
	local chaves = {}
	for _, ponto in pontos do
		table.insert(chaves, NumberSequenceKeypoint.new(ponto[1], ponto[2]))
	end
	return NumberSequence.new(chaves)
end

local function particulas(pai: Instance, propriedades)
	local e = Instance.new("ParticleEmitter")
	e.LightInfluence = 0
	for chave, valor in propriedades do
		(e :: any)[chave] = valor
	end
	e.Parent = pai
	return e
end

local function letreiro(posicao: Vector3, titulo: string, subtitulo: string, cor: Color3)
	local ancora = parte("Letreiro", Vector3.one, CFrame.new(posicao), Enum.Material.SmoothPlastic, cor, { colide = false, transparencia = 1 })
	local placa = Instance.new("BillboardGui")
	placa.Size = UDim2.fromScale(20, 5)
	placa.MaxDistance = 160
	placa.LightInfluence = 0
	placa.Parent = ancora

	local textoTitulo = Instance.new("TextLabel")
	textoTitulo.Size = UDim2.fromScale(1, 0.62)
	textoTitulo.BackgroundTransparency = 1
	textoTitulo.FontFace = Font.new(Font.fromEnum(Enum.Font.Merriweather).Family, Enum.FontWeight.Bold)
	textoTitulo.Text = titulo
	textoTitulo.TextColor3 = cor
	textoTitulo.TextScaled = true
	textoTitulo.TextStrokeTransparency = 0.25
	textoTitulo.Parent = placa

	local textoSub = Instance.new("TextLabel")
	textoSub.Position = UDim2.fromScale(0, 0.64)
	textoSub.Size = UDim2.fromScale(1, 0.34)
	textoSub.BackgroundTransparency = 1
	textoSub.FontFace = Font.new(Font.fromEnum(Enum.Font.BuilderSans).Family, Enum.FontWeight.Bold)
	textoSub.Text = subtitulo
	textoSub.TextColor3 = Color3.fromRGB(245, 238, 220)
	textoSub.TextScaled = true
	textoSub.TextStrokeTransparency = 0.35
	textoSub.Parent = placa
end

------------------------------------------------------------------------
-- Terreno
------------------------------------------------------------------------

local function construirTerreno()
	local terreno = workspace.Terrain
	terreno:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(96, 150, 66))
	terreno:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(80, 132, 58))
	terreno:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(122, 96, 70))
	terreno:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(112, 108, 104))

	terreno:FillBlock(CFrame.new(0, -8, 0), Vector3.new(320, 16, 320), Enum.Material.Grass)

	-- Colinas em volta (fecham o acampamento num vale)
	local rng = Random.new(7)
	for i = 0, 23 do
		local angulo = i / 24 * math.pi * 2
		local distancia = rng:NextNumber(128, 148)
		local centro = Vector3.new(math.cos(angulo) * distancia, rng:NextNumber(-6, 4), math.sin(angulo) * distancia)
		local material = if i % 3 == 0 then Enum.Material.Rock else Enum.Material.LeafyGrass
		terreno:FillBall(centro, rng:NextNumber(26, 40), material)
	end

	-- Caminhos de terra até o portal, os altares e a loja
	terreno:FillBlock(CFrame.new(0, -2, -24), Vector3.new(12, 4, 44), Enum.Material.Ground)
	terreno:FillBlock(CFrame.new(-26, -2, 0), Vector3.new(30, 4, 10), Enum.Material.Ground)
	terreno:FillBlock(CFrame.new(26, -2, 0), Vector3.new(30, 4, 10), Enum.Material.Ground)
	terreno:FillBlock(CFrame.new(0, -2, 26), Vector3.new(10, 4, 26), Enum.Material.Ground)

	-- Lago
	terreno:FillCylinder(CFrame.new(72, -3, 58), 6, 17, Enum.Material.Air)
	terreno:FillCylinder(CFrame.new(72, -4.5, 58), 3, 16, Enum.Material.Water)
	for i = 1, 6 do
		local angulo = i / 6 * math.pi * 2 + 0.4
		terreno:FillBall(Vector3.new(72 + math.cos(angulo) * 17, -1, 58 + math.sin(angulo) * 17), rng:NextNumber(2.5, 4), Enum.Material.Rock)
	end
end

------------------------------------------------------------------------
-- Decoração
------------------------------------------------------------------------

local function lanterna(posicao: Vector3)
	parte("Poste", Vector3.new(0.6, 7, 0.6), CFrame.new(posicao + Vector3.new(0, 3.5, 0)), Enum.Material.Wood, MADEIRA)
	parte("Braco", Vector3.new(0.4, 0.4, 1.8), CFrame.new(posicao + Vector3.new(0, 6.8, -0.7)), Enum.Material.Wood, MADEIRA)
	local caixa = parte("Lanterna", Vector3.new(0.9, 1.2, 0.9), CFrame.new(posicao + Vector3.new(0, 6, -1.4)), Enum.Material.Glass, Color3.fromRGB(255, 220, 150), { colide = false, transparencia = 0.3 })
	local chama = parte("Chama", Vector3.one * 0.45, caixa.CFrame, Enum.Material.Neon, Color3.fromRGB(255, 190, 90), { colide = false, sombra = false })
	luz(chama, Color3.fromRGB(255, 190, 110), 18, 1.4, true)
end

local function braseiro(posicao: Vector3)
	parte("Pe", Vector3.new(3, 1.2, 1.2), CFrame.new(posicao + Vector3.new(0, 1.5, 0)) * EM_PE, Enum.Material.Slate, PEDRA_ESCURA, { formato = Enum.PartType.Cylinder })
	local tigela = parte("Tigela", Vector3.new(1, 2.8, 2.8), CFrame.new(posicao + Vector3.new(0, 3.3, 0)) * EM_PE, Enum.Material.Metal, Color3.fromRGB(70, 60, 54), { formato = Enum.PartType.Cylinder })
	local brasa = parte("Brasa", Vector3.new(0.3, 2.2, 2.2), tigela.CFrame * CFrame.new(0.5, 0, 0), Enum.Material.Neon, Color3.fromRGB(255, 150, 60), { formato = Enum.PartType.Cylinder, colide = false })
	local fogo = Instance.new("Fire")
	fogo.Size = 4
	fogo.Heat = 8
	fogo.Parent = brasa
	particulas(brasa, {
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 140), Color3.fromRGB(255, 90, 30)),
		LightEmission = 1,
		Size = sequencia({ { 0, 0.25 }, { 1, 0 } }),
		Lifetime = NumberRange.new(1, 2),
		Speed = NumberRange.new(3, 6),
		SpreadAngle = Vector2.new(20, 20),
		Acceleration = Vector3.new(0, 3, 0),
		Rate = 12,
		EmissionDirection = Enum.NormalId.Top,
	})
	luz(brasa, Color3.fromRGB(255, 160, 80), 26, 2, true)
end

local function carvalho(x: number, z: number, escala: number, rng: Random)
	local tronco = Color3.fromRGB(96, 66, 44)
	parte("Tronco", Vector3.new(10 * escala, 2.4 * escala, 2.4 * escala), CFrame.new(x, 5 * escala, z) * EM_PE, Enum.Material.Wood, tronco, { formato = Enum.PartType.Cylinder })
	parte("Galho", Vector3.new(4 * escala, 1 * escala, 1 * escala), CFrame.new(x + 1.4 * escala, 8.5 * escala, z) * CFrame.Angles(0, 0, math.rad(40)), Enum.Material.Wood, tronco, { formato = Enum.PartType.Cylinder })
	for _ = 1, 4 do
		local deslocamento = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(10, 14), rng:NextNumber(-3, 3)) * escala
		local verde = Color3.fromRGB(64, 128, 52):Lerp(Color3.fromRGB(110, 160, 60), rng:NextNumber())
		parte("Copa", Vector3.one * rng:NextNumber(7, 10) * escala, CFrame.new(Vector3.new(x, 0, z) + deslocamento), Enum.Material.LeafyGrass, verde, { formato = Enum.PartType.Ball, colide = false })
	end
end

local function pinheiro(x: number, z: number, escala: number)
	parte("Tronco", Vector3.new(6 * escala, 1.6 * escala, 1.6 * escala), CFrame.new(x, 3 * escala, z) * EM_PE, Enum.Material.Wood, Color3.fromRGB(86, 58, 40), { formato = Enum.PartType.Cylinder })
	for i = 0, 3 do
		local largura = (9 - i * 2) * escala
		parte("Folhas", Vector3.new(3 * escala, largura, largura), CFrame.new(x, (5 + i * 3) * escala, z) * EM_PE, Enum.Material.LeafyGrass, Color3.fromRGB(48, 96, 60), { formato = Enum.PartType.Cylinder, colide = false })
	end
end

local function construirPraca()
	parte("Praca", Vector3.new(1, 62, 62), CFrame.new(0, -0.38, 0) * EM_PE, Enum.Material.Cobblestone, PEDRA, { formato = Enum.PartType.Cylinder })
	parte("AnelPraca", Vector3.new(1.05, 40, 40), CFrame.new(0, -0.36, 0) * EM_PE, Enum.Material.Slate, PEDRA_ESCURA, { formato = Enum.PartType.Cylinder })
	parte("MioloPraca", Vector3.new(1.1, 37, 37), CFrame.new(0, -0.34, 0) * EM_PE, Enum.Material.Cobblestone, Color3.fromRGB(135, 130, 128), { formato = Enum.PartType.Cylinder })

	-- Obelisco com cristal flutuante no centro
	parte("BaseObelisco", Vector3.new(7, 1.4, 7), CFrame.new(0, 0.7, 0), Enum.Material.Slate, PEDRA_ESCURA)
	parte("Degrau", Vector3.new(5, 1, 5), CFrame.new(0, 1.9, 0), Enum.Material.Slate, PEDRA)
	parte("Obelisco", Vector3.new(2.6, 10, 2.6), CFrame.new(0, 7.4, 0), Enum.Material.Marble, Color3.fromRGB(190, 186, 196))
	for _, lado in { 0, 1, 2, 3 } do
		parte("Runa", Vector3.new(0.2, 6, 0.6), CFrame.new(0, 7.4, 0) * CFrame.Angles(0, lado * math.pi / 2, 0) * CFrame.new(1.32, 0, 0), Enum.Material.Neon, Color3.fromRGB(120, 200, 255), { colide = false, sombra = false })
	end
	local cristal = Instance.new("Model")
	cristal.Name = "CristalFlutuante"
	local nucleo = parte("Cristal", Vector3.new(2.4, 4, 2.4), CFrame.new(0, 16, 0) * CFrame.Angles(0, math.rad(45), 0), Enum.Material.Neon, Color3.fromRGB(110, 200, 255), { colide = false, pai = cristal })
	parte("Anel", Vector3.new(0.3, 6, 6), CFrame.new(0, 16, 0) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(20), 0, 0), Enum.Material.Metal, Color3.fromRGB(230, 190, 90), { formato = Enum.PartType.Cylinder, colide = false, pai = cristal })
	cristal.PrimaryPart = nucleo
	cristal:SetAttribute("Giro", 0.6)
	cristal:SetAttribute("Flutuar", 0.8)
	CollectionService:AddTag(cristal, "Girar")
	cristal.Parent = modelo
	luz(nucleo, Color3.fromRGB(110, 200, 255), 30, 2.5)
	particulas(nucleo, {
		Color = ColorSequence.new(Color3.fromRGB(160, 220, 255)),
		LightEmission = 1,
		Size = sequencia({ { 0, 0 }, { 0.4, 0.5 }, { 1, 0 } }),
		Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180),
		Rate = 15,
	})

	for _, angulo in { 45, 135, 225, 315 } do
		local r = math.rad(angulo)
		braseiro(Vector3.new(math.cos(r) * 17, 0, math.sin(r) * 17))
	end

	-- Ponto de nascimento (invisível, no meio da praça, de frente para o portal)
	local nascimento = Instance.new("SpawnLocation")
	nascimento.Name = "Nascimento"
	nascimento.Anchored = true
	nascimento.Size = Vector3.new(10, 1, 6)
	nascimento.CFrame = CFrame.new(0, 0.2, 22)
	nascimento.Transparency = 1
	nascimento.CanCollide = false
	nascimento.CanQuery = false
	nascimento.Neutral = true
	nascimento.Duration = 0
	nascimento.Parent = modelo
end

local function construirPortal()
	local z = -64
	local corPedra = Color3.fromRGB(78, 72, 84)
	parte("Muralha", Vector3.new(60, 28, 7), CFrame.new(0, 14, z), Enum.Material.Brick, corPedra)
	parte("Ameias", Vector3.new(60, 2, 7.6), CFrame.new(0, 28.6, z), Enum.Material.Slate, PEDRA_ESCURA)
	for i = -6, 6, 2 do
		parte("Ameia", Vector3.new(3, 3, 7.6), CFrame.new(i * 4.6, 31, z), Enum.Material.Brick, corPedra)
	end
	for _, x in { -30, 30 } do
		parte("Torre", Vector3.new(38, 12, 12), CFrame.new(x, 19, z) * EM_PE, Enum.Material.Brick, corPedra:Lerp(Color3.new(0, 0, 0), 0.12), { formato = Enum.PartType.Cylinder })
		parte("Teto", Vector3.new(2, 14, 14), CFrame.new(x, 39, z) * EM_PE, Enum.Material.Slate, PEDRA_ESCURA, { formato = Enum.PartType.Cylinder })
		local bandeira = parte("Bandeira", Vector3.new(0.2, 12, 5), CFrame.new(x, 20, z + 6.2) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Fabric, Color3.fromRGB(110, 40, 150), { colide = false })
		parte("Simbolo", Vector3.new(0.25, 2.4, 2.4), bandeira.CFrame * CFrame.new(-0.05, 2, 0) * CFrame.Angles(math.rad(45), 0, 0), Enum.Material.Neon, Color3.fromRGB(230, 190, 90), { colide = false })
		lanterna(Vector3.new(x * 0.62, 0, z + 8))
	end

	-- Arco do portal
	local corArco = Color3.fromRGB(52, 46, 60)
	for _, x in { -9.5, 9.5 } do
		parte("Coluna", Vector3.new(3, 22, 3.4), CFrame.new(x, 11, z + 4), Enum.Material.Slate, corArco)
	end
	parte("Verga", Vector3.new(22, 3, 3.4), CFrame.new(0, 23.5, z + 4), Enum.Material.Slate, corArco)
	parte("Chave", Vector3.new(3.4, 3.4, 3.6), CFrame.new(0, 24, z + 4.2) * CFrame.Angles(0, 0, math.rad(45)), Enum.Material.Neon, ROXO, { colide = false })

	-- Vórtice (o centro gira no computador de cada jogador)
	local vortice = Instance.new("Model")
	vortice.Name = "Vortice"
	local disco = parte("Disco", Vector3.new(0.4, 18, 18), CFrame.new(0, 11, z + 4) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Neon, Color3.fromRGB(90, 30, 170), { formato = Enum.PartType.Cylinder, colide = false, pai = vortice, transparencia = 0.15 })
	parte("Espiral", Vector3.new(0.5, 13, 2), disco.CFrame * CFrame.new(-0.1, 0, 0), Enum.Material.Neon, Color3.fromRGB(190, 120, 255), { colide = false, pai = vortice, transparencia = 0.3 })
	parte("Espiral", Vector3.new(0.5, 2, 13), disco.CFrame * CFrame.new(-0.1, 0, 0), Enum.Material.Neon, Color3.fromRGB(190, 120, 255), { colide = false, pai = vortice, transparencia = 0.3 })
	parte("Miolo", Vector3.new(0.6, 6, 6), disco.CFrame * CFrame.new(-0.15, 0, 0), Enum.Material.Neon, Color3.fromRGB(255, 220, 255), { formato = Enum.PartType.Cylinder, colide = false, pai = vortice, transparencia = 0.2 })
	vortice.PrimaryPart = disco
	vortice:SetAttribute("Giro", 1.4)
	vortice:SetAttribute("EixoGiro", "X")
	CollectionService:AddTag(vortice, "Girar")
	vortice.Parent = modelo
	luz(disco, ROXO, 45, 3)
	particulas(disco, {
		Color = ColorSequence.new(Color3.fromRGB(210, 160, 255), ROXO),
		LightEmission = 1,
		Size = sequencia({ { 0, 0.6 }, { 1, 0 } }),
		Lifetime = NumberRange.new(1, 1.8),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(60, 60),
		Rate = 30,
		EmissionDirection = Enum.NormalId.Right,
	})

	-- Círculo onde o grupo se junta
	parte("Aro", Vector3.new(0.4, RAIO_PORTAL * 2 + 3, RAIO_PORTAL * 2 + 3), CFrame.new(POSICAO_PORTAL + Vector3.new(0, 0.1, 0)) * EM_PE, Enum.Material.Slate, PEDRA_ESCURA, { formato = Enum.PartType.Cylinder })
	local circulo = parte("CirculoPortal", Vector3.new(0.3, RAIO_PORTAL * 2, RAIO_PORTAL * 2), CFrame.new(POSICAO_PORTAL + Vector3.new(0, 0.2, 0)) * EM_PE, Enum.Material.Neon, ROXO, { formato = Enum.PartType.Cylinder, colide = false, sombra = false })
	TweenService:Create(circulo, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.55 }):Play()
	particulas(circulo, {
		Color = ColorSequence.new(Color3.fromRGB(200, 150, 255)),
		LightEmission = 1,
		Size = sequencia({ { 0, 0.4 }, { 1, 0 } }),
		Lifetime = NumberRange.new(1.2, 2),
		Speed = NumberRange.new(2, 4),
		SpreadAngle = Vector2.new(10, 10),
		Rate = 25,
		Shape = Enum.ParticleEmitterShape.Cylinder,
		EmissionDirection = Enum.NormalId.Right,
	})
	for i = 0, 3 do
		local angulo = i * math.pi / 2 + math.pi / 4
		local p = POSICAO_PORTAL + Vector3.new(math.cos(angulo), 0, math.sin(angulo)) * (RAIO_PORTAL + 2.5)
		parte("PedraRunica", Vector3.new(1.6, 4, 1.2), CFrame.new(p + Vector3.new(0, 2, 0)) * CFrame.Angles(0, -angulo, 0), Enum.Material.Slate, PEDRA_ESCURA)
		parte("RunaPedra", Vector3.new(1.7, 1, 0.5), CFrame.new(p + Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, -angulo, 0), Enum.Material.Neon, ROXO, { colide = false })
	end
	letreiro(POSICAO_PORTAL + Vector3.new(0, 11, 0), "⚔️ A MASMORRA", "Fique no círculo roxo com seu grupo (1 a 4)", Color3.fromRGB(210, 170, 255))
end

-- Altares: chegue perto e escolha sua classe
local function construirAltares()
	local centroX = -40
	for i, id in Classes.ordem do
		local classe = Classes.dados[id]
		local z = (i - (#Classes.ordem + 1) / 2) * 15
		local base = Vector3.new(centroX, 0, z)
		parte("Degrau", Vector3.new(9, 1, 9), CFrame.new(base + Vector3.new(0, 0.5, 0)), Enum.Material.Slate, PEDRA_ESCURA)
		parte("Pedestal", Vector3.new(4, 4, 4), CFrame.new(base + Vector3.new(0, 3, 0)), Enum.Material.Marble, Color3.fromRGB(196, 190, 200))
		parte("Topo", Vector3.new(5, 0.8, 5), CFrame.new(base + Vector3.new(0, 5.4, 0)), Enum.Material.Slate, PEDRA_ESCURA)
		local runa = parte("Runa", Vector3.new(0.3, 2.4, 2.4), CFrame.new(base + Vector3.new(2.05, 3, 0)) * CFrame.Angles(math.rad(45), 0, 0), Enum.Material.Neon, classe.cor, { colide = false })
		local estandarte = parte("Estandarte", Vector3.new(0.3, 10, 5), CFrame.new(base + Vector3.new(-6, 7, 0)), Enum.Material.Fabric, classe.cor:Lerp(Color3.new(0, 0, 0), 0.35))
		parte("Haste", Vector3.new(0.5, 13, 0.5), CFrame.new(base + Vector3.new(-6.3, 6.5, 2.7)), Enum.Material.Wood, MADEIRA)
		parte("Emblema", Vector3.new(0.35, 2.4, 2.4), estandarte.CFrame * CFrame.new(0.05, 1.5, 0) * CFrame.Angles(math.rad(45), 0, 0), Enum.Material.Neon, classe.cor, { colide = false })

		-- Arma flutuando sobre o altar (gira no computador de cada jogador)
		local exibicao = Armas.modeloExibicao(id)
		exibicao.Name = "Arma" .. classe.nome
		local orientacao = if id == "cavaleiro" or id == "assassino" then CFrame.Angles(math.rad(-90), 0, 0) else CFrame.new()
		exibicao:PivotTo(CFrame.new(base + Vector3.new(0, 9.5, 0)) * orientacao)
		exibicao:SetAttribute("Giro", 0.8)
		exibicao:SetAttribute("Flutuar", 0.6)
		CollectionService:AddTag(exibicao, "Girar")
		exibicao.Parent = modelo

		luz(runa, classe.cor, 22, 2)
		particulas(runa, {
			Color = ColorSequence.new(classe.cor),
			LightEmission = 1,
			Size = sequencia({ { 0, 0.3 }, { 1, 0 } }),
			Lifetime = NumberRange.new(1.5, 2.5),
			Speed = NumberRange.new(1, 2),
			SpreadAngle = Vector2.new(30, 30),
			Acceleration = Vector3.new(0, 2, 0),
			Rate = 10,
			EmissionDirection = Enum.NormalId.Top,
		})

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Tornar-se " .. classe.nome
		prompt.ObjectText = classe.titulo
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 11
		prompt.RequiresLineOfSight = false
		prompt.Parent = runa
		prompt.Triggered:Connect(function(player)
			Lobby.escolherClasse(player, id)
		end)

		letreiro(base + Vector3.new(0, 14.5, 0), classe.icone .. " " .. string.upper(classe.nome), classe.titulo, classe.cor:Lerp(Color3.new(1, 1, 1), 0.35))
	end
	letreiro(Vector3.new(centroX - 2, 20, 0), "ALTARES DAS CLASSES", "Chegue perto de um altar para escolher", Color3.fromRGB(255, 220, 140))
end

local function construirLoja()
	local x, z = 42, 0
	local lona = Color3.fromRGB(150, 44, 50)
	parte("Chao", Vector3.new(14, 0.6, 12), CFrame.new(x, 0.3, z), Enum.Material.WoodPlanks, Color3.fromRGB(120, 86, 56))
	for _, dx in { -6, 6 } do
		for _, dz in { -5, 5 } do
			parte("Poste", Vector3.new(0.7, 11, 0.7), CFrame.new(x + dx, 5.5, z + dz), Enum.Material.Wood, MADEIRA)
		end
	end
	-- Telhado em duas águas (cunhas)
	for _, lado in { -1, 1 } do
		local cunha = Instance.new("WedgePart")
		cunha.Name = "Telhado"
		cunha.Anchored = true
		cunha.Size = Vector3.new(14.5, 4, 6.5)
		cunha.CFrame = CFrame.new(x, 13, z + lado * 3.25) * CFrame.Angles(0, if lado == 1 then math.pi else 0, 0)
		cunha.Material = Enum.Material.Fabric
		cunha.Color = lona
		cunha.Parent = modelo
	end
	local balcao = parte("Balcao", Vector3.new(3, 3.5, 10), CFrame.new(x - 5, 2.35, z), Enum.Material.WoodPlanks, Color3.fromRGB(140, 95, 55))
	parte("Tampo", Vector3.new(3.6, 0.4, 10.6), CFrame.new(x - 5, 4.3, z), Enum.Material.Wood, Color3.fromRGB(96, 62, 38))
	for _, dz in { -3, -1.5, 2.5 } do
		parte("Moeda", Vector3.new(0.2, 0.9, 0.9), CFrame.new(x - 5, 4.6, z + dz) * EM_PE, Enum.Material.Neon, Color3.fromRGB(255, 205, 60), { formato = Enum.PartType.Cylinder, colide = false })
	end
	local pocao = parte("Pocao", Vector3.one * 0.9, CFrame.new(x - 5, 5, z + 0.5), Enum.Material.Glass, Color3.fromRGB(255, 70, 110), { formato = Enum.PartType.Ball, colide = false, transparencia = 0.2 })
	luz(pocao, Color3.fromRGB(255, 80, 120), 8, 1)

	-- Mercador encapuzado
	local capa = Color3.fromRGB(60, 44, 80)
	parte("Corpo", Vector3.new(2.4, 4.6, 1.8), CFrame.new(x - 1, 2.9, z), Enum.Material.Fabric, capa)
	parte("Capuz", Vector3.new(2, 2, 2), CFrame.new(x - 1, 6, z), Enum.Material.Fabric, capa:Lerp(Color3.new(0, 0, 0), 0.2))
	parte("Rosto", Vector3.new(0.2, 1.3, 1.5), CFrame.new(x - 2, 5.9, z), Enum.Material.SmoothPlastic, Color3.fromRGB(10, 8, 14))
	for _, dz in { -0.35, 0.35 } do
		local olho = parte("Olho", Vector3.new(0.15, 0.22, 0.3), CFrame.new(x - 2.12, 6.05, z + dz), Enum.Material.Neon, Color3.fromRGB(255, 210, 90), { colide = false })
		luz(olho, Color3.fromRGB(255, 210, 90), 4, 0.6)
	end
	lanterna(Vector3.new(x - 7, 0, z + 6))
	lanterna(Vector3.new(x - 7, 0, z - 6))

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Abrir loja"
	prompt.ObjectText = "Mercador"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = balcao
	prompt.Triggered:Connect(function(player)
		if not Partida.emPartida(player) then
			Remotos.enviar(player, "abrirLoja", {})
		end
	end)
	letreiro(Vector3.new(x, 18, z), "🛒 MERCADOR", "Melhorias permanentes", Color3.fromRGB(255, 205, 90))
end

local function construirNatureza()
	local rng = Random.new(42)
	for i = 0, 27 do
		local angulo = i / 28 * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
		local distancia = rng:NextNumber(70, 108)
		local x, z = math.cos(angulo) * distancia, math.sin(angulo) * distancia
		-- deixa livre a frente do portal e o lago
		local pertoDoPortal = z < -50 and math.abs(x) < 45
		local pertoDoLago = (Vector3.new(x, 0, z) - Vector3.new(72, 0, 58)).Magnitude < 24
		if not pertoDoPortal and not pertoDoLago then
			if rng:NextNumber() < 0.5 then
				carvalho(x, z, rng:NextNumber(0.9, 1.3), rng)
			else
				pinheiro(x, z, rng:NextNumber(1, 1.5))
			end
		end
	end
	for _, pos in { Vector3.new(-6, 0, -14), Vector3.new(6, 0, -14), Vector3.new(-6, 0, -32), Vector3.new(6, 0, -32), Vector3.new(-18, 0, 6), Vector3.new(18, 0, 6) } do
		lanterna(pos)
	end

	-- Vagalumes
	local ar = parte("Vagalumes", Vector3.new(200, 10, 200), CFrame.new(0, 7, 0), Enum.Material.SmoothPlastic, Color3.new(1, 1, 1), { colide = false, transparencia = 1, sombra = false })
	particulas(ar, {
		Color = ColorSequence.new(Color3.fromRGB(230, 255, 140)),
		LightEmission = 1,
		Size = sequencia({ { 0, 0 }, { 0.5, 0.22 }, { 1, 0 } }),
		Lifetime = NumberRange.new(3, 6),
		Speed = NumberRange.new(0.3, 1),
		SpreadAngle = Vector2.new(180, 180),
		Rate = 35,
		Shape = Enum.ParticleEmitterShape.Box,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
	})

	-- Paredes invisíveis (as colinas já cercam, mas por segurança)
	for _, info in {
		{ Vector3.new(240, 60, 2), Vector3.new(0, 30, 118) },
		{ Vector3.new(240, 60, 2), Vector3.new(0, 30, -118) },
		{ Vector3.new(2, 60, 240), Vector3.new(118, 30, 0) },
		{ Vector3.new(2, 60, 240), Vector3.new(-118, 30, 0) },
	} do
		parte("Limite", info[1], CFrame.new(info[2]), Enum.Material.SmoothPlastic, Color3.new(1, 1, 1), { transparencia = 1 })
	end
end

local function construirPlaca()
	local base = Vector3.new(16, 0, 30)
	local quadro = parte("Quadro", Vector3.new(14, 9, 0.8), CFrame.new(base + Vector3.new(0, 6, 0)) * CFrame.Angles(0, math.rad(20), 0), Enum.Material.WoodPlanks, Color3.fromRGB(120, 85, 55))
	for _, dx in { -6, 6 } do
		parte("Pe", Vector3.new(0.8, 6, 0.8), quadro.CFrame * CFrame.new(dx, -4, 0), Enum.Material.Wood, MADEIRA)
	end
	local tela = Instance.new("SurfaceGui")
	tela.Face = Enum.NormalId.Front
	tela.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	tela.PixelsPerStud = 50
	tela.LightInfluence = 0.2
	tela.Parent = quadro

	local titulo = Instance.new("TextLabel")
	titulo.Size = UDim2.fromScale(1, 0.2)
	titulo.BackgroundTransparency = 1
	titulo.FontFace = Font.new(Font.fromEnum(Enum.Font.Merriweather).Family, Enum.FontWeight.Bold)
	titulo.Text = "COMO JOGAR"
	titulo.TextColor3 = Color3.fromRGB(255, 220, 130)
	titulo.TextScaled = true
	titulo.Parent = tela

	local regras = Instance.new("TextLabel")
	regras.Position = UDim2.fromScale(0.05, 0.22)
	regras.Size = UDim2.fromScale(0.9, 0.74)
	regras.BackgroundTransparency = 1
	regras.FontFace = Font.new(Font.fromEnum(Enum.Font.BuilderSans).Family, Enum.FontWeight.Bold)
	regras.TextColor3 = Color3.fromRGB(245, 238, 220)
	regras.TextScaled = true
	regras.TextWrapped = true
	regras.TextXAlignment = Enum.TextXAlignment.Left
	regras.Text = "1. Escolha sua classe nos altares (à esquerda)\n"
		.. "2. Entre no círculo roxo com seu grupo\n"
		.. "3. Combo de 3 golpes, habilidade (E), esquiva (Q) e supremo (R)\n"
		.. "4. Limpe a sala e escolha uma carta de poder\n"
		.. "5. Aliado caído? Fique perto para reviver!\n"
		.. "6. Depois do chefe: SUBA com o ouro ou DESÇA mais fundo"
	regras.Parent = tela
end

------------------------------------------------------------------------
-- API
------------------------------------------------------------------------

function Lobby.construir()
	construirTerreno()
	construirPraca()
	construirPortal()
	construirAltares()
	construirLoja()
	construirNatureza()
	construirPlaca()
	modelo.Parent = workspace
end

-- Coloca a arma e os acessórios da classe no personagem (no lobby, só para exibir)
function Lobby.vestirClasse(player: Player)
	local personagem = player.Character
	local perfil = Dados.obter(player)
	if not personagem or not perfil or Partida.emPartida(player) then
		return
	end
	Armas.vestir(personagem, perfil.Classe)
end

function Lobby.escolherClasse(player: Player, classe: any)
	if Partida.emPartida(player) or not Dados.definirClasse(player, classe) then
		return
	end
	Lobby.vestirClasse(player)
	Dados.enviarPerfil(player)
	local dados = Classes.obter(classe)
	Remotos.enviar(player, "aviso", { texto = dados.icone .. " Agora você é " .. dados.nome .. "!" })
	Vfx.todos("escolheuClasse", { jogador = player, cor = dados.cor })
end

-- Fica olhando quem está no círculo do portal e começa a partida após a contagem
function Lobby.iniciarFila()
	local fimContagem: number? = nil
	local ultimoEnviado = {}

	while true do
		task.wait(0.25)
		local naFila = {}
		for _, player in Players:GetPlayers() do
			local personagem = player.Character
			local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
			if raiz and humanoid and humanoid.Health > 0 and Dados.obter(player) and not Partida.emPartida(player) then
				local delta = raiz.Position - POSICAO_PORTAL
				if Vector3.new(delta.X, 0, delta.Z).Magnitude <= RAIO_PORTAL and math.abs(delta.Y) < 8 then
					table.insert(naFila, player)
				end
			end
		end

		local grupo = {}
		for i = 1, math.min(#naFila, Config.MAX_JOGADORES_POR_PARTIDA) do
			grupo[i] = naFila[i]
		end

		local agora = os.clock()
		if #grupo == 0 then
			fimContagem = nil
		else
			fimContagem = fimContagem or agora + Config.CONTAGEM_PORTAL
			if #grupo >= Config.MAX_JOGADORES_POR_PARTIDA then
				fimContagem = math.min(fimContagem :: number, agora + Config.CONTAGEM_PORTAL_CHEIO)
			end
		end

		local membros = {}
		for _, player in grupo do
			local perfil = Dados.obter(player)
			table.insert(membros, { userId = player.UserId, nome = player.DisplayName, classe = perfil and perfil.Classe or "cavaleiro" })
		end

		local mensagens = {}
		for _, player in grupo do
			mensagens[player] = {
				segundos = math.max(0, math.ceil((fimContagem :: number) - agora)),
				membros = membros,
				max = Config.MAX_JOGADORES_POR_PARTIDA,
			}
		end
		for _, player in naFila do
			if not mensagens[player] then
				mensagens[player] = { cheio = true }
			end
		end
		for _, player in Players:GetPlayers() do
			local mensagem = mensagens[player]
			local chave = "nada"
			if mensagem then
				if mensagem.cheio then
					chave = "cheio"
				else
					local ids = {}
					for _, membro in membros do
						table.insert(ids, membro.userId .. membro.classe)
					end
					chave = mensagem.segundos .. "|" .. table.concat(ids, ",")
				end
			end
			if ultimoEnviado[player] ~= chave then
				ultimoEnviado[player] = chave
				Remotos.enviar(player, "fila", mensagem or { esconder = true })
			end
		end
		for player in ultimoEnviado do
			if not player.Parent then
				ultimoEnviado[player] = nil
			end
		end

		if fimContagem and agora >= fimContagem then
			fimContagem = nil
			for _, player in grupo do
				ultimoEnviado[player] = "nada"
				Remotos.enviar(player, "fila", { esconder = true })
			end
			Partida.iniciar(grupo)
		end
	end
end

return Lobby
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX00000016">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source"><![CDATA[-- Script principal do servidor: monta o lobby e cuida da entrada e saída dos jogadores.

local Players = game:GetService("Players")

-- Os personagens são criados pelo nosso código (para controlar mortes e renascimentos)
Players.CharacterAutoLoads = false

local servidor = script.Parent
local Remotos = require(servidor.Remotos)
local Dados = require(servidor.Dados)
local Partida = require(servidor.Partida)
local Lobby = require(servidor.Lobby)

Lobby.construir()
task.spawn(Lobby.iniciarFila)

local function aoEntrar(player: Player)
	local perfil = Dados.carregar(player)
	if not perfil or not player.Parent then
		return
	end

	player.CharacterAdded:Connect(function(personagem)
		local humanoid = personagem:WaitForChild("Humanoid", 10) :: Humanoid?
		if not humanoid then
			return
		end
		if not Partida.emPartida(player) then
			task.defer(Lobby.vestirClasse, player)
		end
		-- Mortes no lobby: renasce em 3 segundos. Mortes na masmorra são tratadas pela Partida.
		humanoid.Died:Connect(function()
			if Partida.emPartida(player) then
				return
			end
			task.delay(3, function()
				if player.Parent and player.Character == personagem and not Partida.emPartida(player) then
					player:LoadCharacterAsync()
				end
			end)
		end)
	end)

	player:LoadCharacterAsync()
	Dados.enviarPerfil(player)
	Remotos.enviar(player, "lobby", {})
end

Players.PlayerAdded:Connect(aoEntrar)
for _, player in Players:GetPlayers() do
	task.spawn(aoEntrar, player)
end

Players.PlayerRemoving:Connect(function(player)
	Partida.removerJogador(player)
	Dados.salvarERemover(player)
end)

game:BindToClose(function()
	Dados.salvarTodos()
end)

local ACOES_DE_COMBATE = { atacar = true, carregar = true, soltar = true, cancelar = true, habilidade = true, esquiva = true, supremo = true }

Remotos.Acao.OnServerEvent:Connect(function(player, tipo, dados, extra)
	if type(tipo) ~= "string" then
		return
	end
	if ACOES_DE_COMBATE[tipo] then
		Partida.acaoDeCombate(player, tipo, dados, extra)
	elseif tipo == "pronto" then
		Dados.enviarPerfil(player)
		if not Partida.emPartida(player) then
			Remotos.enviar(player, "lobby", {})
		end
	elseif tipo == "escolherClasse" then
		Lobby.escolherClasse(player, dados)
	elseif tipo == "escolherCarta" then
		Partida.escolherCarta(player, dados)
	elseif tipo == "elevador" then
		Partida.escolherElevador(player, dados)
	elseif tipo == "comprarMelhoria" then
		if Partida.emPartida(player) then
			return
		end
		local _, mensagem = Dados.comprarMelhoria(player, dados)
		Remotos.enviar(player, "aviso", { texto = mensagem })
		Dados.enviarPerfil(player)
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000017">
        <Properties>
          <string name="Name">Masmorra</string>
          <ProtectedString name="Source"><![CDATA[-- Gera as salas da masmorra por código. Cada sala é sorteada na hora: tamanho, pilares,
-- lava e decoração mudam a cada partida, e o visual muda conforme o tema do andar.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Masmorra = {}

local ALTURA_PAREDE = 24
local LARGURA_PORTA = 10
local ALTURA_PORTA = 13
local TAMANHO_LAJOTA = 10
local EM_PE = CFrame.Angles(0, 0, math.rad(90)) -- deixa um cilindro em pé (ou deitado como disco)

local function planar(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function escurecer(cor: Color3, quanto: number): Color3
	return cor:Lerp(Color3.new(0, 0, 0), quanto)
end

local function variar(cor: Color3, rng: Random, quanto: number): Color3
	local fator = 1 + rng:NextNumber(-quanto, quanto)
	return Color3.new(math.clamp(cor.R * fator, 0, 1), math.clamp(cor.G * fator, 0, 1), math.clamp(cor.B * fator, 0, 1))
end

-- opcoes: formato, colide (padrão true), transparencia, sombra (padrão true)
local function parte(pai: Instance, nome: string, tamanho: Vector3, cframe: CFrame, material: Enum.Material, cor: Color3, opcoes): Part
	opcoes = opcoes or {}
	local p = Instance.new("Part")
	p.Name = nome
	p.Anchored = true
	p.Shape = opcoes.formato or Enum.PartType.Block
	p.Size = tamanho
	p.CFrame = cframe
	p.Material = material
	p.Color = cor
	p.Transparency = opcoes.transparencia or 0
	p.CanCollide = opcoes.colide ~= false
	p.CastShadow = opcoes.sombra ~= false
	if opcoes.colide == false then
		p.CanQuery = false
		p.CanTouch = false
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = pai
	return p
end

local function ponta(pai: Instance, nome: string, tamanho: Vector3, cframe: CFrame, material: Enum.Material, cor: Color3): CornerWedgePart
	local w = Instance.new("CornerWedgePart")
	w.Name = nome
	w.Anchored = true
	w.Size = tamanho
	w.CFrame = cframe
	w.Material = material
	w.Color = cor
	w.CanCollide = false
	w.CanQuery = false
	w.Parent = pai
	return w
end

local function luz(pai: Instance, cor: Color3, alcance: number, brilho: number, tremula: boolean?)
	local l = Instance.new("PointLight")
	l.Color = cor
	l.Range = alcance
	l.Brightness = brilho
	l.Parent = pai
	if tremula then
		CollectionService:AddTag(l, "Chama") -- os jogadores fazem a luz tremular
	end
	return l
end

local function sequencia(pontos): NumberSequence
	local chaves = {}
	for _, ponto in pontos do
		table.insert(chaves, NumberSequenceKeypoint.new(ponto[1], ponto[2]))
	end
	return NumberSequence.new(chaves)
end

-- Fogo: chama clássica + faíscas subindo
local function fogo(pai: BasePart, cor: Color3, tamanho: number)
	local f = Instance.new("Fire")
	f.Size = tamanho
	f.Heat = tamanho * 2
	f.Color = cor
	f.SecondaryColor = Color3.fromRGB(255, 60, 10)
	f.Parent = pai

	local e = Instance.new("ParticleEmitter")
	e.Name = "Faiscas"
	e.Color = ColorSequence.new(Color3.fromRGB(255, 230, 160), cor)
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Size = sequencia({ { 0, 0.18 * tamanho / 2 }, { 1, 0 } })
	e.Transparency = sequencia({ { 0, 0 }, { 1, 1 } })
	e.Lifetime = NumberRange.new(0.8, 1.6)
	e.Speed = NumberRange.new(2, 5)
	e.SpreadAngle = Vector2.new(25, 25)
	e.Acceleration = Vector3.new(0, 4, 0)
	e.Drag = 1
	e.Rate = 6 * tamanho
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = pai
end

------------------------------------------------------------------------
-- Posições livres
------------------------------------------------------------------------

-- Caminho da entrada até a porta (nada que atrapalhe é colocado ali)
local function noCaminho(sala, pos: Vector3, folga: number): boolean
	local local_ = pos - sala.origem
	local meiaC = sala.comprimento / 2
	local pertoDaEntrada = (planar(local_) - Vector3.new(0, 0, -meiaC + 7)).Magnitude < 12 + folga
	local pertoDaPorta = math.abs(local_.X) < 8 + folga and local_.Z > meiaC - 14 - folga
	return pertoDaEntrada or pertoDaPorta
end

function Masmorra.posicaoValida(sala, pos: Vector3, raio: number): boolean
	local local_ = pos - sala.origem
	if math.abs(local_.X) > sala.largura / 2 - raio or math.abs(local_.Z) > sala.comprimento / 2 - raio then
		return false
	end
	for _, pilar in sala.pilares do
		if planar(pos - pilar.pos).Magnitude < pilar.raio + raio then
			return false
		end
	end
	for _, perigo in sala.perigos do
		local d = pos - perigo.centro
		if math.abs(d.X) < perigo.meio.X + raio and math.abs(d.Z) < perigo.meio.Z + raio then
			return false
		end
	end
	return true
end

local function posicaoLivre(sala, rng: Random, raio: number, evitarCaminho: boolean): Vector3?
	for _ = 1, 40 do
		local x = rng:NextNumber(-sala.largura / 2 + raio + 2, sala.largura / 2 - raio - 2)
		local z = rng:NextNumber(-sala.comprimento / 2 + raio + 2, sala.comprimento / 2 - raio - 2)
		local pos = sala.origem + Vector3.new(x, 0, z)
		if Masmorra.posicaoValida(sala, pos, raio) and not (evitarCaminho and noCaminho(sala, pos, raio)) then
			return pos
		end
	end
	return nil
end

function Masmorra.pontoLivre(sala, rng: Random, raio: number): Vector3?
	return posicaoLivre(sala, rng, raio, false)
end

-- Ponto encostado numa parede (para decoração), com a direção "para dentro" da sala
local function pontoNaParede(sala, rng: Random, recuo: number): (Vector3, Vector3)
	local meiaL, meiaC = sala.largura / 2, sala.comprimento / 2
	local lado = rng:NextInteger(1, 3) -- 1 esquerda, 2 direita, 3 fundo
	if lado == 1 then
		return sala.origem + Vector3.new(-meiaL + recuo, 0, rng:NextNumber(-meiaC + 14, meiaC - 6)), Vector3.new(1, 0, 0)
	elseif lado == 2 then
		return sala.origem + Vector3.new(meiaL - recuo, 0, rng:NextNumber(-meiaC + 14, meiaC - 6)), Vector3.new(-1, 0, 0)
	end
	local x = rng:NextNumber(meiaL * 0.35, meiaL - 6) * (if rng:NextNumber() < 0.5 then -1 else 1)
	return sala.origem + Vector3.new(x, 0, -meiaC + recuo), Vector3.new(0, 0, 1)
end

-- Registra um objeto como obstáculo (inimigos desviam e projéteis batem nele)
local function obstaculo(sala, pos: Vector3, raio: number)
	table.insert(sala.pilares, { pos = pos, raio = raio })
end

------------------------------------------------------------------------
-- Partes da sala
------------------------------------------------------------------------

local function criarChao(sala, rng: Random)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	parte(modelo, "Base", Vector3.new(sala.largura + 4, 2, sala.comprimento + 4), CFrame.new(origem + Vector3.new(0, -1.2, 0)), tema.detalhe.material, escurecer(tema.detalhe.cor, 0.35))
	-- Lajotas com pequenas variações de cor (as frestas mostram a base mais escura)
	local colunas = math.ceil(sala.largura / TAMANHO_LAJOTA)
	local linhas = math.ceil(sala.comprimento / TAMANHO_LAJOTA)
	local larguraLajota = sala.largura / colunas
	local comprimentoLajota = sala.comprimento / linhas
	for i = 0, colunas - 1 do
		for j = 0, linhas - 1 do
			local x = -sala.largura / 2 + (i + 0.5) * larguraLajota
			local z = -sala.comprimento / 2 + (j + 0.5) * comprimentoLajota
			local especial = rng:NextNumber() < 0.08
			parte(
				modelo,
				"Lajota",
				Vector3.new(larguraLajota - 0.3, 0.6, comprimentoLajota - 0.3),
				CFrame.new(origem + Vector3.new(x, -0.3, z)),
				if especial then tema.detalhe.material else tema.chao.material,
				variar(if especial then tema.detalhe.cor else tema.chao.cor, rng, 0.09),
				{ sombra = false }
			)
		end
	end
end

local function criarArandela(sala, pos: Vector3, paraDentro: Vector3)
	local tema, modelo = sala.tema, sala.modelo
	local base = CFrame.lookAt(pos, pos + paraDentro)
	parte(modelo, "Suporte", Vector3.new(0.5, 0.5, 1.6), base * CFrame.new(0, 0, -0.6), Enum.Material.Metal, Color3.fromRGB(45, 40, 40), { colide = false })
	local tigela = parte(modelo, "Tigela", Vector3.new(0.7, 1.2, 1.2), base * CFrame.new(0, 0.2, -1.4) * EM_PE, Enum.Material.Metal, Color3.fromRGB(60, 52, 48), { formato = Enum.PartType.Cylinder, colide = false })
	local chama = parte(modelo, "Chama", Vector3.new(0.6, 0.6, 0.6), tigela.CFrame * CFrame.new(0.6, 0, 0), Enum.Material.Neon, tema.luz, { colide = false, sombra = false })
	fogo(chama, tema.luz, 2.2)
	luz(chama, tema.luz, 22, 1.7, true)
end

local function criarBraseiro(sala, pos: Vector3, escala: number)
	local tema, modelo = sala.tema, sala.modelo
	parte(modelo, "PeBraseiro", Vector3.new(3 * escala, 1.4 * escala, 1.4 * escala), CFrame.new(pos + Vector3.new(0, 1.5 * escala, 0)) * EM_PE, tema.detalhe.material, tema.detalhe.cor, { formato = Enum.PartType.Cylinder })
	parte(modelo, "Base", Vector3.new(0.6 * escala, 2.4 * escala, 2.4 * escala), CFrame.new(pos + Vector3.new(0, 0.3 * escala, 0)) * EM_PE, tema.detalhe.material, escurecer(tema.detalhe.cor, 0.2), { formato = Enum.PartType.Cylinder })
	local tigela = parte(modelo, "Tigela", Vector3.new(1 * escala, 3 * escala, 3 * escala), CFrame.new(pos + Vector3.new(0, 3.3 * escala, 0)) * EM_PE, Enum.Material.Metal, Color3.fromRGB(55, 48, 44), { formato = Enum.PartType.Cylinder })
	local brasa = parte(modelo, "Brasa", Vector3.new(0.3, 2.4 * escala, 2.4 * escala), tigela.CFrame * CFrame.new(0.5 * escala, 0, 0), Enum.Material.Neon, tema.luz, { formato = Enum.PartType.Cylinder, colide = false })
	fogo(brasa, tema.luz, 4 * escala)
	luz(brasa, tema.luz, 30 * escala, 2, true)
	obstaculo(sala, pos, 1.6 * escala)
end

local function criarParedes(sala)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local meiaL, meiaC = sala.largura / 2, sala.comprimento / 2
	local y = ALTURA_PAREDE / 2
	local corParede, matParede = tema.parede.cor, tema.parede.material
	local corDetalhe, matDetalhe = tema.detalhe.cor, tema.detalhe.material

	local function parede(tamanho: Vector3, posicao: Vector3)
		parte(modelo, "Parede", tamanho, CFrame.new(origem + posicao), matParede, corParede)
	end

	parede(Vector3.new(2, ALTURA_PAREDE, sala.comprimento + 4), Vector3.new(-meiaL - 1, y, 0))
	parede(Vector3.new(2, ALTURA_PAREDE, sala.comprimento + 4), Vector3.new(meiaL + 1, y, 0))
	parede(Vector3.new(sala.largura + 4, ALTURA_PAREDE, 2), Vector3.new(0, y, -meiaC - 1))
	local segmento = (sala.largura + 4 - LARGURA_PORTA) / 2
	parede(Vector3.new(segmento, ALTURA_PAREDE, 2), Vector3.new(-(LARGURA_PORTA / 2 + segmento / 2), y, meiaC + 1))
	parede(Vector3.new(segmento, ALTURA_PAREDE, 2), Vector3.new(LARGURA_PORTA / 2 + segmento / 2, y, meiaC + 1))
	local alturaVerga = ALTURA_PAREDE - ALTURA_PORTA
	parede(Vector3.new(LARGURA_PORTA, alturaVerga, 2), Vector3.new(0, ALTURA_PORTA + alturaVerga / 2, meiaC + 1))

	-- Rodapé e cornija (dão volume às paredes)
	for _, info in {
		{ Vector3.new(1, 1.6, sala.comprimento), Vector3.new(-meiaL + 0.5, 0.8, 0) },
		{ Vector3.new(1, 1.6, sala.comprimento), Vector3.new(meiaL - 0.5, 0.8, 0) },
		{ Vector3.new(sala.largura, 1.6, 1), Vector3.new(0, 0.8, -meiaC + 0.5) },
	} do
		parte(modelo, "Rodape", info[1], CFrame.new(origem + info[2]), matDetalhe, corDetalhe)
		parte(modelo, "Cornija", info[1] + Vector3.new(0.6, -0.4, 0.6), CFrame.new(origem + info[2] + Vector3.new(0, ALTURA_PAREDE - 1.6, 0)), matDetalhe, corDetalhe, { colide = false })
	end

	-- Contrafortes ao longo das paredes laterais, com arandelas entre eles
	local passos = math.max(3, math.floor(sala.comprimento / 16))
	for i = 0, passos do
		local z = -meiaC + 4 + i * ((sala.comprimento - 8) / passos)
		for _, lado in { -1, 1 } do
			local x = lado * (meiaL - 1)
			parte(modelo, "Contraforte", Vector3.new(2.4, ALTURA_PAREDE, 2.4), CFrame.new(origem + Vector3.new(x, y, z)), matDetalhe, corDetalhe)
			parte(modelo, "Capitel", Vector3.new(3, 1, 3), CFrame.new(origem + Vector3.new(x, ALTURA_PAREDE - 3, z)), matDetalhe, escurecer(corDetalhe, 0.15), { colide = false })
			if i < passos and i % 2 == 0 then
				local zMeio = z + (sala.comprimento - 8) / passos / 2
				criarArandela(sala, origem + Vector3.new(lado * meiaL, 8, zMeio), Vector3.new(-lado, 0, 0))
			end
		end
	end

	-- Estandartes no fundo
	for _, x in { -meiaL / 2, meiaL / 2 } do
		local estandarte = parte(modelo, "Estandarte", Vector3.new(4.4, 9, 0.2), CFrame.new(origem + Vector3.new(x, 13, -meiaC + 0.2)), Enum.Material.Fabric, Color3.fromRGB(120, 24, 34), { colide = false })
		parte(modelo, "Barra", Vector3.new(5.2, 0.3, 0.3), estandarte.CFrame * CFrame.new(0, 4.6, 0), Enum.Material.Metal, Color3.fromRGB(200, 160, 70), { colide = false })
		parte(modelo, "Simbolo", Vector3.new(1.6, 1.6, 0.1), estandarte.CFrame * CFrame.new(0, 1, -0.12) * CFrame.Angles(0, 0, math.rad(45)), Enum.Material.Neon, tema.luz, { colide = false })
	end
end

local function criarPorta(sala)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local meiaC = sala.comprimento / 2
	local corDetalhe, matDetalhe = tema.detalhe.cor, tema.detalhe.material
	local zParede = meiaC + 1

	-- Moldura em arco
	for _, lado in { -1, 1 } do
		parte(modelo, "Umbral", Vector3.new(2.2, ALTURA_PORTA + 1, 3), CFrame.new(origem + Vector3.new(lado * (LARGURA_PORTA / 2 + 1), (ALTURA_PORTA + 1) / 2, zParede - 0.5)), matDetalhe, corDetalhe)
	end
	parte(modelo, "Arco", Vector3.new(LARGURA_PORTA + 4.4, 2.2, 3), CFrame.new(origem + Vector3.new(0, ALTURA_PORTA + 1.1, zParede - 0.5)), matDetalhe, corDetalhe)
	local runa = parte(modelo, "Runa", Vector3.new(1.4, 1.4, 0.3), CFrame.new(origem + Vector3.new(0, ALTURA_PORTA + 1.1, zParede - 2.05)) * CFrame.Angles(0, 0, math.rad(45)), Enum.Material.Neon, Color3.fromRGB(255, 70, 70), { colide = false })
	sala.runaPorta = runa

	-- Grade levadiça (sobe quando a sala é limpa)
	local grade = Instance.new("Model")
	grade.Name = "Grade"
	local corFerro = Color3.fromRGB(46, 44, 46)
	for i = 0, 5 do
		local x = -LARGURA_PORTA / 2 + 0.8 + i * ((LARGURA_PORTA - 1.6) / 5)
		parte(grade, "Barra", Vector3.new(0.5, ALTURA_PORTA, 0.5), CFrame.new(origem + Vector3.new(x, ALTURA_PORTA / 2, zParede)), Enum.Material.Metal, corFerro)
	end
	for _, h in { 3, 7, 11 } do
		parte(grade, "Travessa", Vector3.new(LARGURA_PORTA, 0.4, 0.4), CFrame.new(origem + Vector3.new(0, h, zParede)), Enum.Material.Metal, corFerro)
	end
	grade.Parent = modelo
	sala.grade = grade

	-- Gatilho invisível no vão (quem entra vai para a próxima sala)
	local gatilho = parte(modelo, "Porta", Vector3.new(LARGURA_PORTA, ALTURA_PORTA, 1.5), CFrame.new(origem + Vector3.new(0, ALTURA_PORTA / 2, zParede + 1.5)), Enum.Material.Neon, Color3.fromRGB(80, 255, 140), { colide = false, transparencia = 1 })
	gatilho.CanTouch = true
	sala.porta = gatilho

	-- Corredor com névoa atrás da porta
	parte(modelo, "Corredor", Vector3.new(LARGURA_PORTA + 4, 2, 14), CFrame.new(origem + Vector3.new(0, -1, meiaC + 9)), tema.chao.material, escurecer(tema.chao.cor, 0.3))
	parte(modelo, "ParedeCorredor", Vector3.new(2, ALTURA_PORTA + 2, 14), CFrame.new(origem + Vector3.new(-LARGURA_PORTA / 2 - 1, ALTURA_PORTA / 2, meiaC + 9)), tema.parede.material, tema.parede.cor)
	parte(modelo, "ParedeCorredor", Vector3.new(2, ALTURA_PORTA + 2, 14), CFrame.new(origem + Vector3.new(LARGURA_PORTA / 2 + 1, ALTURA_PORTA / 2, meiaC + 9)), tema.parede.material, tema.parede.cor)
	parte(modelo, "FundoCorredor", Vector3.new(LARGURA_PORTA + 4, ALTURA_PORTA + 2, 2), CFrame.new(origem + Vector3.new(0, ALTURA_PORTA / 2, meiaC + 17)), tema.parede.material, tema.parede.cor)
	local nevoa = parte(modelo, "Nevoa", Vector3.new(LARGURA_PORTA, 1, 10), CFrame.new(origem + Vector3.new(0, 0.6, meiaC + 9)), Enum.Material.SmoothPlastic, Color3.new(1, 1, 1), { colide = false, transparencia = 1 })
	local emissor = Instance.new("ParticleEmitter")
	emissor.Name = "Nevoa"
	emissor.Color = ColorSequence.new(tema.nevoa:Lerp(Color3.new(1, 1, 1), 0.3))
	emissor.Size = sequencia({ { 0, 3 }, { 1, 6 } })
	emissor.Transparency = sequencia({ { 0, 1 }, { 0.3, 0.75 }, { 1, 1 } })
	emissor.Lifetime = NumberRange.new(3, 5)
	emissor.Speed = NumberRange.new(0.3, 1)
	emissor.SpreadAngle = Vector2.new(180, 30)
	emissor.Rate = 8
	emissor.Shape = Enum.ParticleEmitterShape.Box
	emissor.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emissor.Parent = nevoa
	sala.luzPorta = luz(nevoa, Color3.fromRGB(255, 80, 80), 18, 1.2, false)
end

local function criarEntrada(sala)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local meiaC = sala.comprimento / 2
	local centro = origem + Vector3.new(0, 0.05, -meiaC + 7)
	-- Círculo de runas onde o grupo aparece (anel = disco brilhante + disco do chão por cima)
	parte(modelo, "Circulo", Vector3.new(0.12, 11, 11), CFrame.new(centro) * EM_PE, Enum.Material.Neon, tema.luz, { formato = Enum.PartType.Cylinder, colide = false, transparencia = 0.3, sombra = false })
	parte(modelo, "CirculoMiolo", Vector3.new(0.14, 10, 10), CFrame.new(centro + Vector3.new(0, 0.02, 0)) * EM_PE, tema.chao.material, escurecer(tema.chao.cor, 0.15), { formato = Enum.PartType.Cylinder, colide = false, sombra = false })
	parte(modelo, "PortaEntrada", Vector3.new(LARGURA_PORTA, ALTURA_PORTA, 0.6), CFrame.new(origem + Vector3.new(0, ALTURA_PORTA / 2, -meiaC + 0.1)), Enum.Material.WoodPlanks, Color3.fromRGB(70, 46, 30))
	for _, lado in { -1, 1 } do
		parte(modelo, "UmbralEntrada", Vector3.new(2, ALTURA_PORTA + 1, 1.6), CFrame.new(origem + Vector3.new(lado * (LARGURA_PORTA / 2 + 1), (ALTURA_PORTA + 1) / 2, -meiaC + 0.6)), tema.detalhe.material, tema.detalhe.cor)
	end
end

local function criarPilares(sala, rng: Random)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local posicoes = {}
	if sala.tipo == "chefe" then
		local dx, dz = sala.largura / 3, sala.comprimento / 3
		posicoes = {
			origem + Vector3.new(-dx, 0, -dz / 2),
			origem + Vector3.new(dx, 0, -dz / 2),
			origem + Vector3.new(-dx, 0, dz),
			origem + Vector3.new(dx, 0, dz),
		}
	elseif sala.tipo == "combate" then
		for _ = 1, rng:NextInteger(2, 6) do
			local pos = posicaoLivre(sala, rng, 9, true)
			if pos then
				table.insert(posicoes, pos)
				-- reserva o espaço para o próximo pilar não ficar colado neste
				table.insert(sala.pilares, { pos = pos, raio = 5 })
			end
		end
		table.clear(sala.pilares)
	end

	for _, pos in posicoes do
		local diametro = rng:NextInteger(4, 6)
		parte(modelo, "Pilar", Vector3.new(ALTURA_PAREDE, diametro, diametro), CFrame.new(pos + Vector3.new(0, ALTURA_PAREDE / 2, 0)) * EM_PE, tema.parede.material, tema.parede.cor, { formato = Enum.PartType.Cylinder })
		parte(modelo, "BasePilar", Vector3.new(diametro + 1.6, 1.6, diametro + 1.6), CFrame.new(pos + Vector3.new(0, 0.8, 0)), tema.detalhe.material, tema.detalhe.cor)
		parte(modelo, "AnelPilar", Vector3.new(0.8, diametro + 0.6, diametro + 0.6), CFrame.new(pos + Vector3.new(0, 2.2, 0)) * EM_PE, tema.detalhe.material, escurecer(tema.detalhe.cor, 0.15), { formato = Enum.PartType.Cylinder })
		parte(modelo, "Capitel", Vector3.new(diametro + 1.4, 1.4, diametro + 1.4), CFrame.new(pos + Vector3.new(0, ALTURA_PAREDE - 2, 0)), tema.detalhe.material, tema.detalhe.cor, { colide = false })
		-- Runa brilhante no pilar
		parte(modelo, "RunaPilar", Vector3.new(0.2, 1.2, 1.2), CFrame.new(pos + Vector3.new(0, 7, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0) * CFrame.new(diametro / 2, 0, 0) * CFrame.Angles(math.rad(45), 0, 0), Enum.Material.Neon, tema.luz, { colide = false, sombra = false })
		table.insert(sala.pilares, { pos = pos, raio = diametro / 2 + 0.6 })
	end
end

local function criarLava(sala, rng: Random)
	if sala.tipo ~= "combate" then
		return
	end
	if not (sala.tema.lava or (sala.numero >= 7 and rng:NextNumber() < 0.35)) then
		return
	end
	for _ = 1, rng:NextInteger(1, 3) do
		local tamanho = Vector3.new(rng:NextInteger(8, 14), 0.4, rng:NextInteger(8, 14))
		local pos = posicaoLivre(sala, rng, math.max(tamanho.X, tamanho.Z) / 2 + 2, true)
		if pos then
			parte(sala.modelo, "Borda", tamanho + Vector3.new(1.6, 0.3, 1.6), CFrame.new(pos + Vector3.new(0, 0.1, 0)), Enum.Material.Basalt, Color3.fromRGB(35, 28, 28), { colide = false })
			local lava = parte(sala.modelo, "Lava", tamanho, CFrame.new(pos + Vector3.new(0, 0.2, 0)), Enum.Material.Neon, Color3.fromRGB(255, 96, 24), { colide = false, sombra = false })
			luz(lava, Color3.fromRGB(255, 110, 40), 18, 1.6, true)
			local brasas = Instance.new("ParticleEmitter")
			brasas.Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 70, 20))
			brasas.LightEmission = 1
			brasas.Size = sequencia({ { 0, 0.3 }, { 1, 0 } })
			brasas.Lifetime = NumberRange.new(1, 2)
			brasas.Speed = NumberRange.new(2, 5)
			brasas.SpreadAngle = Vector2.new(20, 20)
			brasas.Rate = 10
			brasas.EmissionDirection = Enum.NormalId.Top
			brasas.Shape = Enum.ParticleEmitterShape.Box
			brasas.Parent = lava
			table.insert(sala.perigos, { centro = pos, meio = Vector3.new(tamanho.X / 2, 0, tamanho.Z / 2) })
		end
	end
end

-- Decoração própria de cada tema, encostada nas paredes
local function criarDecoracao(sala, rng: Random)
	local tema, modelo = sala.tema, sala.modelo
	local quantidade = rng:NextInteger(6, 10)
	for _ = 1, quantidade do
		local pos, dentro = pontoNaParede(sala, rng, 3)
		local giro = CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		if tema.id == "calabouco" then
			if rng:NextNumber() < 0.5 then
				local barril = parte(modelo, "Barril", Vector3.new(3, 2.2, 2.2), CFrame.new(pos + Vector3.new(0, 1.5, 0)) * EM_PE, Enum.Material.WoodPlanks, Color3.fromRGB(110, 72, 44), { formato = Enum.PartType.Cylinder })
				for _, h in { -0.9, 0.9 } do
					parte(modelo, "Aro", Vector3.new(0.2, 2.3, 2.3), barril.CFrame * CFrame.new(h, 0, 0), Enum.Material.Metal, Color3.fromRGB(60, 56, 56), { formato = Enum.PartType.Cylinder, colide = false })
				end
				obstaculo(sala, pos, 1.3)
			else
				local tamanho = rng:NextNumber(2.2, 3.2)
				parte(modelo, "Caixote", Vector3.one * tamanho, CFrame.new(pos + Vector3.new(0, tamanho / 2, 0)) * giro, Enum.Material.WoodPlanks, Color3.fromRGB(125, 88, 52))
				if rng:NextNumber() < 0.5 then
					parte(modelo, "Caixote", Vector3.one * tamanho * 0.7, CFrame.new(pos + Vector3.new(0, tamanho + tamanho * 0.35, 0)) * giro * CFrame.Angles(0, 0.4, 0), Enum.Material.WoodPlanks, Color3.fromRGB(110, 76, 46))
				end
				obstaculo(sala, pos, tamanho * 0.7)
			end
			-- Crânio no chão
			parte(modelo, "Cranio", Vector3.one * 0.8, CFrame.new(pos + dentro * 2.5 + Vector3.new(0, 0.4, 0)), Enum.Material.SmoothPlastic, Color3.fromRGB(225, 218, 196), { formato = Enum.PartType.Ball, colide = false })
		elseif tema.id == "caverna" then
			if rng:NextNumber() < 0.6 then
				-- Cogumelos brilhantes
				for k = 1, rng:NextInteger(2, 4) do
					local p = pos + Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
					local altura = rng:NextNumber(1.2, 3.5)
					parte(modelo, "Caule", Vector3.new(altura, 0.5, 0.5), CFrame.new(p + Vector3.new(0, altura / 2, 0)) * EM_PE, Enum.Material.SmoothPlastic, Color3.fromRGB(220, 215, 190), { formato = Enum.PartType.Cylinder, colide = false })
					local chapeu = parte(modelo, "Chapeu", Vector3.new(0.6, altura * 0.9 + 0.6, altura * 0.9 + 0.6), CFrame.new(p + Vector3.new(0, altura + 0.2, 0)) * EM_PE, Enum.Material.Neon, if k % 2 == 0 then Color3.fromRGB(90, 255, 180) else Color3.fromRGB(140, 120, 255), { formato = Enum.PartType.Cylinder, colide = false })
					if k == 1 then
						luz(chapeu, chapeu.Color, 10, 1, false)
					end
				end
			else
				-- Estalagmite
				local altura = rng:NextNumber(5, 9)
				for k = 0, 2 do
					local h = altura * (1 - k * 0.3)
					parte(modelo, "Estalagmite", Vector3.new(h, 2.6 - k * 0.7, 2.6 - k * 0.7), CFrame.new(pos + Vector3.new(0, h / 2, 0)) * EM_PE, tema.parede.material, escurecer(tema.parede.cor, k * 0.08), { formato = Enum.PartType.Cylinder })
				end
				obstaculo(sala, pos, 1.4)
			end
		elseif tema.id == "cripta" then
			if rng:NextNumber() < 0.55 then
				-- Lápide
				local lapide = CFrame.lookAt(pos, pos + dentro)
				parte(modelo, "Lapide", Vector3.new(2.4, 3, 0.6), lapide * CFrame.new(0, 1.5, 0), Enum.Material.Slate, Color3.fromRGB(120, 125, 140))
				parte(modelo, "TopoLapide", Vector3.new(0.6, 2.4, 2.4), lapide * CFrame.new(0, 3, 0) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Slate, Color3.fromRGB(120, 125, 140), { formato = Enum.PartType.Cylinder, colide = false })
				local vela = parte(modelo, "Vela", Vector3.new(0.3, 0.8, 0.3), lapide * CFrame.new(0.8, 0.4, -1), Enum.Material.SmoothPlastic, Color3.fromRGB(230, 230, 240), { colide = false })
				local chama = parte(modelo, "ChamaVela", Vector3.one * 0.25, vela.CFrame * CFrame.new(0, 0.55, 0), Enum.Material.Neon, Color3.fromRGB(140, 210, 255), { colide = false, sombra = false })
				luz(chama, Color3.fromRGB(140, 210, 255), 8, 1, true)
				obstaculo(sala, pos, 1.3)
			else
				-- Cristais de gelo
				for _ = 1, rng:NextInteger(2, 4) do
					local altura = rng:NextNumber(2, 6)
					local p = pos + Vector3.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
					parte(modelo, "Cristal", Vector3.new(1, altura, 1), CFrame.new(p + Vector3.new(0, altura / 2 - 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, 3), rng:NextNumber(-0.35, 0.35)), Enum.Material.Glass, Color3.fromRGB(160, 220, 255), { colide = false, transparencia = 0.25 })
				end
				local nucleo = parte(modelo, "Nucleo", Vector3.one * 0.6, CFrame.new(pos + Vector3.new(0, 1, 0)), Enum.Material.Neon, Color3.fromRGB(150, 220, 255), { colide = false, sombra = false })
				luz(nucleo, nucleo.Color, 10, 1, false)
			end
		else
			if rng:NextNumber() < 0.6 then
				-- Espinhos de obsidiana
				for _ = 1, rng:NextInteger(2, 4) do
					local altura = rng:NextNumber(3, 7)
					local p = pos + Vector3.new(rng:NextNumber(-1.8, 1.8), 0, rng:NextNumber(-1.8, 1.8))
					ponta(modelo, "Espinho", Vector3.new(1.4, altura, 1.4), CFrame.new(p + Vector3.new(0, altura / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), Enum.Material.Basalt, Color3.fromRGB(28, 22, 26))
				end
				obstaculo(sala, pos, 1.6)
			else
				-- Fenda de lava na parede
				local fenda = parte(modelo, "Fenda", Vector3.new(0.4, rng:NextNumber(4, 9), 1.2), CFrame.lookAt(pos - dentro * 2.3, pos) * CFrame.new(0, 3, 0), Enum.Material.Neon, Color3.fromRGB(255, 100, 30), { colide = false, sombra = false })
				luz(fenda, Color3.fromRGB(255, 110, 40), 14, 1.4, true)
			end
		end
	end
end

-- Partículas no ar da sala (poeira, esporos, neve ou brasas)
local function criarAtmosfera(sala)
	local tema = sala.tema
	local volume = parte(sala.modelo, "Atmosfera", Vector3.new(sala.largura - 4, 12, sala.comprimento - 4), CFrame.new(sala.origem + Vector3.new(0, 8, 0)), Enum.Material.SmoothPlastic, Color3.new(1, 1, 1), { colide = false, transparencia = 1, sombra = false })
	local e = Instance.new("ParticleEmitter")
	e.Name = "Ambiente"
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.LightInfluence = 0
	local area = sala.largura * sala.comprimento / 6000
	if tema.particulas == "neve" then
		e.Color = ColorSequence.new(Color3.fromRGB(235, 245, 255))
		e.Size = sequencia({ { 0, 0.25 }, { 1, 0.15 } })
		e.Transparency = sequencia({ { 0, 1 }, { 0.15, 0.2 }, { 1, 1 } })
		e.Lifetime = NumberRange.new(5, 8)
		e.Speed = NumberRange.new(1, 2)
		e.Acceleration = Vector3.new(0.4, -1.5, 0)
		e.Rate = 50 * area
		e.LightEmission = 0.4
	elseif tema.particulas == "brasas" then
		e.Color = ColorSequence.new(Color3.fromRGB(255, 210, 90), Color3.fromRGB(255, 70, 20))
		e.Size = sequencia({ { 0, 0.22 }, { 1, 0 } })
		e.Transparency = sequencia({ { 0, 0 }, { 1, 1 } })
		e.Lifetime = NumberRange.new(3, 6)
		e.Speed = NumberRange.new(1, 3)
		e.Acceleration = Vector3.new(0, 1.5, 0)
		e.Rate = 40 * area
		e.LightEmission = 1
	elseif tema.particulas == "esporos" then
		e.Color = ColorSequence.new(Color3.fromRGB(150, 255, 170), Color3.fromRGB(120, 200, 255))
		e.Size = sequencia({ { 0, 0 }, { 0.3, 0.25 }, { 1, 0 } })
		e.Transparency = NumberSequence.new(0.2)
		e.Lifetime = NumberRange.new(4, 7)
		e.Speed = NumberRange.new(0.2, 0.8)
		e.Acceleration = Vector3.new(0, 0.3, 0)
		e.Rate = 30 * area
		e.LightEmission = 1
	else
		e.Color = ColorSequence.new(Color3.fromRGB(220, 205, 185))
		e.Size = sequencia({ { 0, 0 }, { 0.3, 0.15 }, { 1, 0 } })
		e.Transparency = NumberSequence.new(0.45)
		e.Lifetime = NumberRange.new(5, 9)
		e.Speed = NumberRange.new(0.1, 0.5)
		e.Rate = 25 * area
		e.LightEmission = 0.3
	end
	e.SpreadAngle = Vector2.new(180, 180)
	e.Parent = volume
end

local function criarSalaDoChefe(sala)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local meiaL, meiaC = sala.largura / 2, sala.comprimento / 2
	-- Círculo ritual no centro
	local centro = origem + Vector3.new(0, 0.05, 6)
	parte(modelo, "Ritual", Vector3.new(0.12, 44, 44), CFrame.new(centro) * EM_PE, Enum.Material.Neon, Color3.fromRGB(200, 40, 40), { formato = Enum.PartType.Cylinder, colide = false, transparencia = 0.35, sombra = false })
	parte(modelo, "RitualMiolo", Vector3.new(0.14, 42, 42), CFrame.new(centro + Vector3.new(0, 0.02, 0)) * EM_PE, tema.chao.material, escurecer(tema.chao.cor, 0.2), { formato = Enum.PartType.Cylinder, colide = false, sombra = false })
	parte(modelo, "RitualInterno", Vector3.new(0.12, 20, 20), CFrame.new(centro + Vector3.new(0, 0.04, 0)) * EM_PE, Enum.Material.Neon, Color3.fromRGB(200, 40, 40), { formato = Enum.PartType.Cylinder, colide = false, transparencia = 0.5, sombra = false })
	parte(modelo, "RitualInternoMiolo", Vector3.new(0.14, 18.6, 18.6), CFrame.new(centro + Vector3.new(0, 0.06, 0)) * EM_PE, tema.chao.material, escurecer(tema.chao.cor, 0.25), { formato = Enum.PartType.Cylinder, colide = false, sombra = false })
	-- Trono no fundo
	local trono = origem + Vector3.new(0, 0, meiaC - 8)
	parte(modelo, "Degrau", Vector3.new(16, 1, 8), CFrame.new(trono + Vector3.new(0, 0.5, 0)), tema.detalhe.material, tema.detalhe.cor)
	parte(modelo, "Assento", Vector3.new(6, 3, 4), CFrame.new(trono + Vector3.new(0, 2.5, 0.5)), tema.detalhe.material, escurecer(tema.detalhe.cor, 0.1))
	parte(modelo, "Encosto", Vector3.new(6, 9, 1.4), CFrame.new(trono + Vector3.new(0, 6, 2.6)), tema.detalhe.material, escurecer(tema.detalhe.cor, 0.1))
	local gema = parte(modelo, "Gema", Vector3.one * 1.4, CFrame.new(trono + Vector3.new(0, 9.4, 1.8)) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Enum.Material.Neon, Color3.fromRGB(255, 50, 60), { colide = false })
	luz(gema, gema.Color, 16, 2, false)
	obstaculo(sala, trono, 4)
	-- Braseiros grandes nos cantos
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			criarBraseiro(sala, origem + Vector3.new(x * (meiaL - 8), 0, z * (meiaC - 10)), 1.6)
		end
	end
end

local function criarBau(sala)
	local origem, tema, modelo = sala.origem, sala.tema, sala.modelo
	local madeira = Color3.fromRGB(120, 75, 40)
	local dourado = Color3.fromRGB(255, 200, 60)
	local centro = origem + Vector3.new(0, 0, 4)
	parte(modelo, "Estrado", Vector3.new(12, 1, 10), CFrame.new(centro + Vector3.new(0, 0.5, 0)), tema.detalhe.material, tema.detalhe.cor)
	local base = parte(modelo, "Bau", Vector3.new(5, 3, 3.5), CFrame.new(centro + Vector3.new(0, 2.5, 0)), Enum.Material.WoodPlanks, madeira)
	local tampa = parte(modelo, "Tampa", Vector3.new(5.2, 1.2, 3.7), CFrame.new(centro + Vector3.new(0, 4.6, 0)), Enum.Material.WoodPlanks, escurecer(madeira, 0.25))
	parte(modelo, "Faixa", Vector3.new(5.3, 0.4, 3.8), CFrame.new(centro + Vector3.new(0, 3.6, 0)), Enum.Material.Neon, dourado, { colide = false })
	for _, x in { -1.8, 1.8 } do
		parte(modelo, "Reforco", Vector3.new(0.35, 3.2, 3.8), CFrame.new(centro + Vector3.new(x, 2.6, 0)), Enum.Material.Metal, dourado)
	end
	-- Moedas espalhadas
	for _ = 1, 14 do
		local p = centro + Vector3.new(math.random(-5, 5), 1.15, math.random(-4, 4))
		parte(modelo, "Moeda", Vector3.new(0.15, 0.8, 0.8), CFrame.new(p) * EM_PE * CFrame.Angles(math.random() * 0.5, 0, 0), Enum.Material.Neon, dourado, { formato = Enum.PartType.Cylinder, colide = false, sombra = false })
	end
	-- Feixe de luz vindo de cima
	parte(modelo, "Feixe", Vector3.new(40, 7, 7), CFrame.new(centro + Vector3.new(0, 20, 0)) * EM_PE, Enum.Material.Neon, dourado, { formato = Enum.PartType.Cylinder, colide = false, transparencia = 0.88, sombra = false })
	luz(base, dourado, 24, 2.5, false)
	local brilho = Instance.new("ParticleEmitter")
	brilho.Color = ColorSequence.new(dourado)
	brilho.LightEmission = 1
	brilho.Size = sequencia({ { 0, 0 }, { 0.5, 0.4 }, { 1, 0 } })
	brilho.Lifetime = NumberRange.new(1, 2)
	brilho.Speed = NumberRange.new(1, 3)
	brilho.SpreadAngle = Vector2.new(60, 60)
	brilho.Rate = 12
	brilho.EmissionDirection = Enum.NormalId.Top
	brilho.Parent = base

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Abrir"
	prompt.ObjectText = "Baú do Tesouro"
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = base

	sala.bau = base
	sala.tampaBau = tampa
	sala.promptBau = prompt
	obstaculo(sala, centro, 3)
end

------------------------------------------------------------------------
-- API
------------------------------------------------------------------------

-- Cria uma sala nova. "origem" é o centro do chão (a superfície fica em origem.Y).
function Masmorra.construir(origem: Vector3, numero: number, tipo: string, rng: Random)
	local largura, comprimento
	if tipo == "chefe" then
		largura, comprimento = 110, 110
	elseif tipo == "tesouro" then
		largura, comprimento = 50, 56
	else
		largura = rng:NextInteger(14, 19) * 5
		comprimento = rng:NextInteger(14, 19) * 5
	end

	local modelo = Instance.new("Model")
	modelo.Name = "Sala" .. numero

	local sala = {
		modelo = modelo,
		origem = origem,
		numero = numero,
		tipo = tipo,
		tema = Config.temaDaSala(numero),
		largura = largura,
		comprimento = comprimento,
		pilares = {},
		perigos = {},
		spawn = CFrame.lookAt(origem + Vector3.new(0, 3, -comprimento / 2 + 7), origem + Vector3.new(0, 3, comprimento / 2)),
	}

	criarChao(sala, rng)
	criarParedes(sala)
	criarPorta(sala)
	criarEntrada(sala)
	criarPilares(sala, rng)
	criarLava(sala, rng)
	criarDecoracao(sala, rng)
	criarAtmosfera(sala)
	if tipo == "chefe" then
		criarSalaDoChefe(sala)
	elseif tipo == "tesouro" then
		criarBau(sala)
	else
		-- braseiros nos cantos da entrada
		local meiaL, meiaC = largura / 2, comprimento / 2
		criarBraseiro(sala, origem + Vector3.new(-meiaL + 5, 0, -meiaC + 5), 1)
		criarBraseiro(sala, origem + Vector3.new(meiaL - 5, 0, -meiaC + 5), 1)
	end
	return sala
end

-- Ponto no chão para um inimigo aparecer, longe da entrada dos jogadores
function Masmorra.posicaoInimigo(sala, rng: Random): Vector3
	local entrada = sala.spawn.Position
	for _ = 1, 30 do
		local pos = posicaoLivre(sala, rng, 3, false)
		if pos and planar(pos - entrada).Magnitude > 24 then
			return pos
		end
	end
	return sala.origem + Vector3.new(0, 0, sala.comprimento / 4)
end

function Masmorra.naLava(sala, pos: Vector3): boolean
	if pos.Y > sala.origem.Y + 6 then
		return false
	end
	for _, perigo in sala.perigos do
		local d = pos - perigo.centro
		if math.abs(d.X) < perigo.meio.X and math.abs(d.Z) < perigo.meio.Z then
			return true
		end
	end
	return false
end

-- Sobe a grade e acende a saída. Retorna a peça que leva para a próxima sala.
function Masmorra.abrirPorta(sala): BasePart
	if sala.grade then
		for _, barra in sala.grade:GetChildren() do
			if barra:IsA("BasePart") then
				barra.CanCollide = false
				TweenService:Create(barra, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
					CFrame = barra.CFrame + Vector3.new(0, ALTURA_PORTA - 1, 0),
				}):Play()
			end
		end
	end
	if sala.runaPorta then
		sala.runaPorta.Color = Color3.fromRGB(90, 255, 150)
		luz(sala.runaPorta, Color3.fromRGB(90, 255, 150), 20, 2, false)
	end
	if sala.luzPorta then
		sala.luzPorta.Color = Color3.fromRGB(90, 255, 150)
		sala.luzPorta.Brightness = 3
	end
	local porta = sala.porta
	porta.Transparency = 0.8

	local placa = Instance.new("BillboardGui")
	placa.Size = UDim2.fromScale(12, 2.5)
	placa.StudsOffset = Vector3.new(0, 9, -2)
	placa.AlwaysOnTop = true
	placa.MaxDistance = 150
	placa.LightInfluence = 0
	placa.Parent = porta

	local texto = Instance.new("TextLabel")
	texto.Size = UDim2.fromScale(1, 1)
	texto.BackgroundTransparency = 1
	texto.Text = "PRÓXIMA SALA ➜"
	texto.TextScaled = true
	texto.Font = Enum.Font.Merriweather
	texto.TextColor3 = Color3.fromRGB(140, 255, 175)
	texto.TextStrokeTransparency = 0.2
	texto.Parent = placa
	return porta
end

function Masmorra.abrirBau(sala)
	local tampa = sala.tampaBau
	if tampa then
		TweenService:Create(tampa, TweenInfo.new(0.5, Enum.EasingStyle.Back), {
			CFrame = tampa.CFrame * CFrame.new(0, 1.2, 1.8) * CFrame.Angles(math.rad(-70), 0, 0),
		}):Play()
	end
end

return Masmorra
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000018">
        <Properties>
          <string name="Name">Partida</string>
          <ProtectedString name="Source"><![CDATA[-- Controla cada partida: salas, ondas de inimigos, cartas, elevador e fim de jogo.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cartas = require(Shared:WaitForChild("Cartas"))

local servidor = script.Parent
local Remotos = require(servidor.Remotos)
local Dados = require(servidor.Dados)
local Vfx = require(servidor.Vfx)
local Masmorra = require(servidor.Masmorra)
local Combate = require(servidor.Combate)
local Projeteis = require(servidor.Projeteis)
local Inimigos = require(servidor.Inimigos)

local Partida = {}

local partidasAtivas = {} -- [run] = true
local partidaDoJogador = {} -- [Player] = run
local contadorPartidas = 0

local COR_OURO = Color3.fromRGB(255, 205, 60)
local COR_VERDE = Color3.fromRGB(120, 255, 150)
local COR_VERMELHO = Color3.fromRGB(255, 80, 80)

------------------------------------------------------------------------
-- Objeto da partida
------------------------------------------------------------------------
local Run = {}
Run.__index = Run

function Run:enviar(player: Player, tipo: string, dados)
	Remotos.enviar(player, tipo, dados)
end

function Run:enviarTodos(tipo: string, dados)
	for player in self.jogadores do
		Remotos.enviar(player, tipo, dados)
	end
end

function Run:anunciar(texto: string, cor: Color3?)
	self:enviarTodos("banner", { texto = texto, cor = cor })
end

-- Jogadores de pé (vivos e não caídos)
function Run:jogadoresAtivos(): number
	local total = 0
	for _, estado in self.jogadores do
		if estado.vivo and not estado.caido then
			total += 1
		end
	end
	return total
end

function Run:quantidadeJogadores(): number
	local total = 0
	for _ in self.jogadores do
		total += 1
	end
	return total
end

function Run:quantidadeInimigos(): number
	local total = 0
	for _ in self.inimigos do
		total += 1
	end
	return total
end

local function darOuro(run, estado, base: number)
	local valor = math.max(1, math.floor(base * estado.stats.multOuro + 0.5))
	estado.ouro += valor
	run:enviar(estado.player, "ouro", { total = estado.ouro, ganho = valor })
end

-- Cria um inimigo. Sem "imediato", ele sai de um portal no chão (o jogador vê de onde vem).
function Run:invocar(tipo: string, posicao: Vector3, elite: string?, imediato: boolean?)
	local sala = self.sala
	if imediato then
		Inimigos.criar(self, tipo, posicao, self.mult, elite)
		return
	end
	self.inimigosPendentes += 1
	Vfx.partida(self, "portal", { pos = posicao, duracao = 0.9, elite = elite ~= nil })
	task.delay(0.9, function()
		self.inimigosPendentes -= 1
		if self.ativa and self.sala == sala then
			Inimigos.criar(self, tipo, posicao, self.mult, elite)
		end
	end)
end

function Run:aoMorrerInimigo(inimigo, estadoMatador)
	if not inimigo.vivo then
		return
	end
	local posicao = inimigo.raiz.Position
	local eraChefe = inimigo.chefe
	Inimigos.morrer(self, inimigo)

	if estadoMatador then
		local ouroBase = inimigo.ouro * (1 + self.numeroSala * 0.08)
		for _, estado in self.jogadores do
			darOuro(self, estado, ouroBase)
		end
		Vfx.partida(self, "moedas", { pos = posicao, quantidade = math.clamp(math.floor(ouroBase / 2), 2, 14) })
		estadoMatador.abates += 1
		Combate.adicionarCarga(estadoMatador, Config.CARGA_POR_ABATE)

		local stats = estadoMatador.stats
		if stats.arquimago then
			Combate.reduzirRecarga(estadoMatador, 1)
		end
		-- Carta Combustão: explosões em cadeia
		if stats.explosaoMorte > 0 then
			task.delay(0.12, function()
				if not self.ativa then
					return
				end
				Vfx.partida(self, "explosao", { pos = posicao, raio = 10, cor = Color3.fromRGB(255, 140, 40) })
				Combate.danoEmArea(self, posicao, 10, stats.dano * 0.6 * stats.explosaoMorte, estadoMatador, {
					semEfeitos = true,
					cor = Color3.fromRGB(255, 140, 40),
				})
			end)
		end
	end

	if eraChefe then
		self:enviarTodos("chefe", { fim = true })
	end
end

------------------------------------------------------------------------
-- Personagens
------------------------------------------------------------------------

local function personagemVivo(player: Player): boolean
	local personagem = player.Character
	local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function configurarPersonagem(run, estado)
	local player = estado.player
	local personagem = player.Character
	local humanoid = personagem and personagem:WaitForChild("Humanoid", 5) :: Humanoid?
	if not humanoid then
		return
	end
	for _, conexao in estado.conexoes do
		conexao:Disconnect()
	end
	estado.conexoes = {}

	Combate.aplicarStats(estado, true)
	Combate.equipar(estado)
	Combate.enviarStats(estado)

	table.insert(estado.conexoes, humanoid.Died:Connect(function()
		if run.jogadores[player] ~= estado or not estado.vivo then
			return
		end
		estado.vivo = false
		estado.caido = false
		run:enviar(player, "morreu", {})
	end))
end

local function reviver(run, estado, cframe: CFrame)
	local player = estado.player
	if not player.Parent then
		return
	end
	player:LoadCharacterAsync()
	if not player.Parent or run.jogadores[player] ~= estado then
		return
	end
	local personagem = player.Character
	if not personagem then
		return
	end
	personagem:PivotTo(cframe)
	estado.vivo = true
	estado.caido = false
	configurarPersonagem(run, estado)
	run:enviar(player, "reviveu", {})
end

------------------------------------------------------------------------
-- Fim da partida para um jogador
------------------------------------------------------------------------

-- motivo: "saiu" (elevador), "morreu" ou "desconectou"
local function finalizarJogador(run, estado, motivo: string)
	local player = estado.player
	if run.jogadores[player] ~= estado then
		return
	end
	run.jogadores[player] = nil
	partidaDoJogador[player] = nil
	for _, conexao in estado.conexoes do
		conexao:Disconnect()
	end

	local ganho = if motivo == "saiu" then estado.ouro else math.floor(estado.ouro * Config.OURO_MANTIDO_AO_MORRER)
	Dados.adicionarOuro(player, ganho)
	local novoRecorde = Dados.registrarRecorde(player, run.numeroSala)

	if motivo == "desconectou" then
		return
	end
	task.spawn(Dados.salvar, player)

	Remotos.enviar(player, "fimPartida", {
		motivo = motivo,
		sala = run.numeroSala,
		ouroPartida = estado.ouro,
		ganho = ganho,
		novoRecorde = novoRecorde,
		abates = estado.abates,
		dano = estado.danoCausado,
		cartas = estado.cartas,
		classe = estado.classe,
	})
	task.spawn(function()
		if player.Parent and not partidaDoJogador[player] then
			player:LoadCharacterAsync()
			Remotos.enviar(player, "lobby", {})
			Dados.enviarPerfil(player)
		end
	end)
end

------------------------------------------------------------------------
-- Salas
------------------------------------------------------------------------

local function escolherTipoSala(run, numero: number): string
	if numero % Config.SALAS_POR_ANDAR == 0 then
		return "chefe"
	end
	local depoisDoChefe = numero % Config.SALAS_POR_ANDAR == 1
	if numero > 1 and not depoisDoChefe and run.ultimoTesouro ~= numero - 1 and run.rng:NextNumber() < Config.CHANCE_SALA_TESOURO then
		run.ultimoTesouro = numero
		return "tesouro"
	end
	return "combate"
end

local function multiplicadores(run, numero: number)
	local jogadores = run:quantidadeJogadores()
	local ciclo = (numero - 1) // (Config.SALAS_POR_ANDAR * #Config.TEMAS)
	return {
		vida = (1 + (numero - 1) * Config.VIDA_INIMIGO_POR_SALA) * (1 + (jogadores - 1) * Config.VIDA_INIMIGO_POR_JOGADOR_EXTRA) * (1 + ciclo * 0.5),
		dano = (1 + (numero - 1) * Config.DANO_INIMIGO_POR_SALA) * (1 + ciclo * 0.25),
	}
end

local function prepararSala(run, numero: number, tipo: string)
	run:enviarTodos("transicao", {})
	task.wait(0.45)
	if not run.ativa then
		return
	end

	Inimigos.limparTodos(run)
	Projeteis.limpar(run)
	local salaAntiga = run.sala
	run.usarSegundoEspaco = not run.usarSegundoEspaco
	local origem = run.origemBase + (if run.usarSegundoEspaco then Vector3.new(0, 0, 400) else Vector3.zero)

	local sala = Masmorra.construir(origem, numero, tipo, run.rng)
	sala.modelo.Parent = run.pasta
	run.sala = sala
	run.numeroSala = numero
	run.mult = multiplicadores(run, numero)

	local jogadores = {}
	for _, estado in run.jogadores do
		table.insert(jogadores, estado)
	end
	for indice, estado in jogadores do
		local cframe = sala.spawn * CFrame.new((indice - 1) * 4 - 6, 0, 0)
		if not estado.vivo or estado.caido or not personagemVivo(estado.player) then
			reviver(run, estado, cframe)
		else
			local personagem = estado.player.Character
			if personagem then
				personagem:PivotTo(cframe)
			end
		end
		Combate.novaSala(estado)
	end

	if salaAntiga then
		salaAntiga.modelo:Destroy()
	end

	local tema = sala.tema
	run:enviarTodos("sala", {
		numero = numero,
		tipo = tipo,
		posicaoNoAndar = (numero - 1) % Config.SALAS_POR_ANDAR + 1,
		tema = {
			id = tema.id,
			nome = tema.nome,
			ambiente = tema.ambiente,
			nevoa = tema.nevoa,
			luz = tema.luz,
			tinta = tema.tinta,
		},
	})
end

local function sortearDaTabela(rng: Random, pesos): string
	local total = 0
	for _, peso in pesos do
		total += peso
	end
	local sorteio = rng:NextNumber() * total
	local ultimo = nil
	for tipo, peso in pesos do
		ultimo = tipo
		sorteio -= peso
		if sorteio <= 0 then
			return tipo
		end
	end
	return ultimo
end

local function sortearElite(run, numero: number): string?
	local chance = math.min(Config.CHANCE_ELITE_BASE + numero * Config.CHANCE_ELITE_POR_SALA, Config.CHANCE_ELITE_MAXIMA)
	if numero >= 2 and run.rng:NextNumber() < chance then
		return Inimigos.LISTA_ELITES[run.rng:NextInteger(1, #Inimigos.LISTA_ELITES)]
	end
	return nil
end

-- Retorna true se a sala foi limpa, false se o grupo inteiro caiu
local function salaDeCombate(run, tipo: string): boolean
	local sala = run.sala
	local numero = run.numeroSala
	local jogadores = run:quantidadeJogadores()
	run.inimigosPendentes = 0
	local terminouDeInvocar = false

	if tipo == "chefe" then
		local chefe = Inimigos.TIPOS[sala.tema.chefe]
		run:enviarTodos("introChefe", { nome = chefe.nome, titulo = chefe.titulo or "" })
		task.wait(2)
		run:invocar(sala.tema.chefe, sala.origem + Vector3.new(0, 0, sala.comprimento / 5), nil)
		terminouDeInvocar = true
	else
		local total = math.min(5 + math.floor(numero * 0.9) + (jogadores - 1) * 3, 34)
		local maximoVivos = math.min(6 + numero // 3 + (jogadores - 1) * 2, 15)
		task.spawn(function()
			local criados = 0
			while run.ativa and run.sala == sala and criados < total do
				if run:quantidadeInimigos() + run.inimigosPendentes < maximoVivos then
					local tipoInimigo = sortearDaTabela(run.rng, sala.tema.inimigos)
					local grupo = Inimigos.TIPOS[tipoInimigo].grupo or 1
					local base = Masmorra.posicaoInimigo(sala, run.rng)
					for g = 1, grupo do
						local pos = if g == 1 then base else base + Vector3.new(run.rng:NextNumber(-3, 3), 0, run.rng:NextNumber(-3, 3))
						run:invocar(tipoInimigo, pos, if g == 1 then sortearElite(run, numero) else nil)
					end
					criados += grupo
					task.wait(0.4)
				else
					task.wait(0.3)
				end
			end
			terminouDeInvocar = true
		end)
	end

	while run.ativa do
		if run:jogadoresAtivos() == 0 then
			return false
		end
		if terminouDeInvocar and run.inimigosPendentes == 0 and run:quantidadeInimigos() == 0 then
			return true
		end
		task.wait(0.25)
	end
	return false
end

local function salaDoTesouro(run): boolean
	local sala = run.sala
	local aberto = false

	local function abrir()
		if aberto then
			return
		end
		aberto = true
		sala.promptBau.Enabled = false
		Masmorra.abrirBau(sala)
		local base = 25 + run.numeroSala * 6
		for _, estado in run.jogadores do
			darOuro(run, estado, base)
		end
		Vfx.partida(run, "moedas", { pos = sala.bau.Position + Vector3.new(0, 2, 0), quantidade = 30 })
		run:anunciar("💰 Baú aberto! Ouro para todos!", COR_OURO)
	end

	run:anunciar("🎁 Sala do Tesouro!", COR_OURO)
	run:enviarTodos("aviso", { texto = "Abra o baú: as cartas daqui são raras ou melhores!" })
	local conexao = sala.promptBau.Triggered:Connect(function(player)
		if run.jogadores[player] then
			abrir()
		end
	end)
	local limite = os.clock() + 45
	while run.ativa and not aberto and os.clock() < limite do
		task.wait(0.25)
	end
	conexao:Disconnect()
	abrir()
	task.wait(1)
	return true
end

-- Ao limpar a sala, quem caiu levanta e quem morreu volta
local function reviverTodos(run)
	local sala = run.sala
	for _, estado in run.jogadores do
		if estado.caido then
			Combate.levantar(run, estado, 1)
		elseif not estado.vivo then
			task.spawn(reviver, run, estado, sala.spawn)
		end
	end
	task.wait(0.5)
end

------------------------------------------------------------------------
-- Cartas
------------------------------------------------------------------------

local function indiceRaridade(raridade: string): number
	return table.find(Config.ORDEM_RARIDADES, raridade) or 1
end

local function sortearCartas(estado, quantidade: number, raridadeMinima: string?)
	local sorte = estado.perfil.Melhorias.Sorte or 0
	local minimo = if raridadeMinima then indiceRaridade(raridadeMinima) else 1
	local disponiveis = {}
	for _, carta in Cartas.lista do
		local daClasse = carta.classe == estado.classe
		local permitida = carta.classe == nil or daClasse
		if permitida and (estado.cartas[carta.id] or 0) < carta.maxPilha and indiceRaridade(carta.raridade) >= minimo then
			local raridade = Config.RARIDADES[carta.raridade]
			local peso = math.max(0.5, raridade.peso + Config.SORTE_POR_NIVEL[carta.raridade] * sorte)
			if daClasse then
				peso *= Config.PESO_EXTRA_CARTA_DE_CLASSE
			end
			table.insert(disponiveis, { id = carta.id, peso = peso })
		end
	end

	local escolhidas = {}
	for _ = 1, quantidade do
		if #disponiveis == 0 then
			break
		end
		local total = 0
		for _, item in disponiveis do
			total += item.peso
		end
		local sorteio = math.random() * total
		local escolhido = #disponiveis
		for i, item in disponiveis do
			sorteio -= item.peso
			if sorteio <= 0 then
				escolhido = i
				break
			end
		end
		table.insert(escolhidas, disponiveis[escolhido].id)
		table.remove(disponiveis, escolhido)
	end
	return escolhidas
end

local function aplicarCarta(run, estado, id: string)
	estado.opcoesCartas = nil
	estado.cartas[id] = (estado.cartas[id] or 0) + 1
	Combate.calcularStats(estado)
	Combate.aplicarStats(estado, id == "coracao")
	if Cartas.porId[id].efeitos.escudo then
		estado.escudoAtivo = true
	end
	Combate.enviarStats(estado)
	run:enviar(estado.player, "minhasCartas", { cartas = estado.cartas })
	local carta = Cartas.porId[id]
	local cor = Config.RARIDADES[carta.raridade].cor
	Vfx.partida(run, "carta", { jogador = estado.player, cor = cor, raridade = carta.raridade })
	if carta.raridade == "Lendaria" then
		run:anunciar("🌟 " .. estado.player.DisplayName .. " pegou uma LENDÁRIA: " .. carta.nome .. "!", COR_OURO)
	end
end

local function oferecerCartas(run, raridadeMinima: string?)
	for player, estado in run.jogadores do
		local opcoes = sortearCartas(estado, 3, raridadeMinima)
		if #opcoes > 0 then
			estado.opcoesCartas = opcoes
			run:enviar(player, "cartas", { opcoes = opcoes, tempo = Config.TEMPO_ESCOLHER_CARTA, classe = estado.classe })
		end
	end

	local limite = os.clock() + Config.TEMPO_ESCOLHER_CARTA + 1
	while run.ativa and os.clock() < limite do
		local falta = false
		for _, estado in run.jogadores do
			if estado.opcoesCartas then
				falta = true
			end
		end
		if not falta then
			break
		end
		task.wait(0.2)
	end

	for player, estado in run.jogadores do
		if estado.opcoesCartas then
			aplicarCarta(run, estado, estado.opcoesCartas[math.random(#estado.opcoesCartas)])
			run:enviar(player, "cartasFechar", {})
		end
	end
end

function Partida.escolherCarta(player: Player, indice: any)
	local run = partidaDoJogador[player]
	local estado = run and run.jogadores[player]
	if not estado or not estado.opcoesCartas or type(indice) ~= "number" then
		return
	end
	local id = estado.opcoesCartas[indice]
	if id then
		aplicarCarta(run, estado, id)
	end
end

------------------------------------------------------------------------
-- Elevador (depois de cada chefe)
------------------------------------------------------------------------

local function elevador(run)
	for player, estado in run.jogadores do
		estado.escolhaElevador = "pendente"
		run:enviar(player, "elevador", { ouro = estado.ouro, tempo = Config.TEMPO_ELEVADOR, proximaSala = run.numeroSala + 1 })
	end

	local limite = os.clock() + Config.TEMPO_ELEVADOR + 1
	while run.ativa and os.clock() < limite do
		local falta = false
		for _, estado in run.jogadores do
			if estado.escolhaElevador == "pendente" then
				falta = true
			end
		end
		if not falta then
			break
		end
		task.wait(0.2)
	end

	local saindo, ficando = {}, 0
	for _, estado in run.jogadores do
		if estado.escolhaElevador == "continuar" then
			ficando += 1
		else
			table.insert(saindo, estado) -- quem não respondeu sobe e guarda o ouro
		end
		estado.escolhaElevador = nil
	end
	for _, estado in saindo do
		finalizarJogador(run, estado, "saiu")
		if ficando > 0 then
			run:anunciar("⬆️ " .. estado.player.DisplayName .. " subiu com o ouro!", COR_OURO)
		end
	end
	if ficando > 0 then
		run:anunciar("⬇️ Descendo mais fundo...", COR_VERMELHO)
	end
end

function Partida.escolherElevador(player: Player, escolha: any)
	local run = partidaDoJogador[player]
	local estado = run and run.jogadores[player]
	if estado and estado.escolhaElevador == "pendente" and (escolha == "sair" or escolha == "continuar") then
		estado.escolhaElevador = escolha
	end
end

local function aguardarPorta(run)
	local porta = Masmorra.abrirPorta(run.sala)
	run:enviarTodos("aviso", { texto = "A grade subiu! Entre na porta para seguir ➜" })
	local passou = false
	local conexao = porta.Touched:Connect(function(peca)
		local player = Players:GetPlayerFromCharacter(peca.Parent)
		local estado = player and run.jogadores[player]
		if estado and estado.vivo and not estado.caido then
			passou = true
		end
	end)
	local limite = os.clock() + Config.TEMPO_PORTA_AUTOMATICA
	while run.ativa and not passou and os.clock() < limite do
		task.wait(0.15)
	end
	conexao:Disconnect()
end

------------------------------------------------------------------------
-- Loop principal de uma partida
------------------------------------------------------------------------

local function encerrar(run)
	run.ativa = false
	partidasAtivas[run] = nil
	for _, estado in run.jogadores do
		finalizarJogador(run, estado, "morreu")
	end
	Inimigos.limparTodos(run)
	Projeteis.limpar(run)
	run.pasta:Destroy()
end

local function loopDaPartida(run)
	local aliados = {}
	for player, estado in run.jogadores do
		table.insert(aliados, { userId = player.UserId, nome = player.DisplayName, classe = estado.classe })
	end
	run:enviarTodos("inicioPartida", { aliados = aliados })

	local numero = 1
	while run.ativa do
		local tipo = escolherTipoSala(run, numero)
		prepararSala(run, numero, tipo)
		if not run.ativa then
			break
		end

		local venceu = if tipo == "tesouro" then salaDoTesouro(run) else salaDeCombate(run, tipo)
		if not run.ativa then
			break
		end
		if not venceu then
			run:anunciar("💀 O grupo inteiro caiu...", COR_VERMELHO)
			task.wait(2.5)
			break
		end

		if tipo == "chefe" then
			run:anunciar("🏆 CHEFE DERROTADO!", COR_OURO)
		elseif tipo == "combate" then
			run:anunciar("✨ Sala limpa!", COR_VERDE)
		end
		reviverTodos(run)

		local raridadeMinima = if tipo == "tesouro" then "Rara" elseif tipo == "chefe" then "Epica" else nil
		oferecerCartas(run, raridadeMinima)
		if not run.ativa then
			break
		end

		if tipo == "chefe" then
			elevador(run)
			if run:quantidadeJogadores() == 0 then
				break
			end
		end

		aguardarPorta(run)
		numero += 1
	end
end

------------------------------------------------------------------------
-- API pública
------------------------------------------------------------------------

function Partida.emPartida(player: Player): boolean
	return partidaDoJogador[player] ~= nil
end

function Partida.iniciar(lista: { Player })
	contadorPartidas += 1
	local pasta = Instance.new("Folder")
	pasta.Name = "Partida" .. contadorPartidas
	pasta.Parent = workspace

	local run = setmetatable({
		id = contadorPartidas,
		origemBase = Vector3.new(2000 + (contadorPartidas % 20) * 700, 0, 0),
		jogadores = {},
		inimigos = {},
		projeteis = {},
		inimigosPendentes = 0,
		sala = nil,
		numeroSala = 0,
		mult = { vida = 1, dano = 1 },
		ativa = true,
		rng = Random.new(),
		pasta = pasta,
		usarSegundoEspaco = false,
		ultimoTesouro = nil,
		acumulador = 0,
	}, Run)

	for _, player in lista do
		local perfil = Dados.obter(player)
		if player.Parent and perfil and not partidaDoJogador[player] then
			local estado = {
				player = player,
				perfil = perfil,
				classe = perfil.Classe,
				cartas = {},
				vivo = false, -- todos "renascem" na primeira sala
				caido = false,
				ouro = 0,
				abates = 0,
				danoCausado = 0,
				combo = 0,
				ultimoAtaque = 0,
				ultimoFoiFinal = false,
				habilidadeProntaEm = 0,
				esquivaProntaEm = 0,
				carga = 0,
				cargaEnviada = 0,
				progressoReviver = 0,
				escudoAtivo = false,
				invulneravelAte = 0,
				conexoes = {},
			}
			Combate.calcularStats(estado)
			run.jogadores[player] = estado
			partidaDoJogador[player] = run
		end
	end

	if run:quantidadeJogadores() == 0 then
		pasta:Destroy()
		return
	end
	partidasAtivas[run] = true
	task.spawn(function()
		-- Se algo der erro no meio da partida, os jogadores voltam ao lobby em vez de ficarem presos
		local ok, erro = pcall(loopDaPartida, run)
		if not ok then
			warn("[Partida] Erro na partida " .. run.id .. ": " .. tostring(erro))
		end
		encerrar(run)
	end)
end

function Partida.removerJogador(player: Player)
	local run = partidaDoJogador[player]
	local estado = run and run.jogadores[player]
	if estado then
		finalizarJogador(run, estado, "desconectou")
		if run:quantidadeJogadores() == 0 then
			run.ativa = false
		end
	end
end

-- No lobby os ataques são só para exibir a classe: os outros jogadores veem a animação
local cargaNoLobby = {} -- [Player] = momento em que começou a carregar

local function animacaoNoLobby(player: Player, tipo: string, extra: any)
	local dados = { jogador = player, classe = player:GetAttribute("Classe") or "cavaleiro" }
	if tipo == "atacar" then
		dados.acao = "ataque"
		dados.combo = if type(extra) == "number" then math.clamp(math.floor(extra), 1, 3) else 1
	elseif tipo == "carregar" then
		cargaNoLobby[player] = os.clock()
		dados.acao = "carregar"
	elseif tipo == "soltar" then
		local inicio = cargaNoLobby[player]
		cargaNoLobby[player] = nil
		if not inicio then
			return
		end
		dados.acao = "soltar"
		dados.fracao = math.clamp((os.clock() - inicio - Config.CARGA_ATAQUE_MIN) / (Config.CARGA_ATAQUE_MAX - Config.CARGA_ATAQUE_MIN), 0, 1)
	elseif tipo == "cancelar" then
		cargaNoLobby[player] = nil
		dados.acao = "cancelar"
	elseif tipo == "esquiva" then
		dados.acao = "esquiva"
	else
		return
	end
	Vfx.todos("anim", dados)
end

-- Ações de combate vindas do jogador
function Partida.acaoDeCombate(player: Player, tipo: string, direcao: any, extra: any)
	local run = partidaDoJogador[player]
	local estado = run and run.jogadores[player]
	if not estado then
		animacaoNoLobby(player, tipo, extra)
		return
	end
	if tipo == "atacar" then
		Combate.atacar(run, estado, direcao)
	elseif tipo == "carregar" then
		Combate.carregar(run, estado)
	elseif tipo == "soltar" then
		Combate.soltar(run, estado, direcao)
	elseif tipo == "cancelar" then
		Combate.cancelarCarga(run, estado)
	elseif tipo == "habilidade" then
		Combate.habilidade(run, estado, direcao)
	elseif tipo == "esquiva" then
		Combate.esquiva(run, estado, direcao)
	elseif tipo == "supremo" then
		Combate.supremo(run, estado)
	end
end

Players.PlayerRemoving:Connect(function(player)
	cargaNoLobby[player] = nil
end)

-- Inteligência dos inimigos e projéteis a cada frame; o resto a cada 0,25s
RunService.Heartbeat:Connect(function(dt)
	local agora = os.clock()
	for run in partidasAtivas do
		if run.ativa then
			Inimigos.atualizar(run, agora)
			Projeteis.atualizar(run, dt)
			run.acumulador += dt
			if run.acumulador >= 0.25 then
				Combate.tick(run, run.acumulador)
				run.acumulador = 0
			end
		end
	end
end)

return Partida
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000019">
        <Properties>
          <string name="Name">Projeteis</string>
          <ProtectedString name="Source"><![CDATA[-- Projéteis (flechas, orbes, bolas de fogo...). O servidor calcula o trajeto e os acertos;
-- os jogadores só desenham. Funciona para projéteis de jogadores e de inimigos.

local Vfx = require(script.Parent.Vfx)

local Projeteis = {}

local proximoId = 0

local function planar(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Distância (no plano) de um ponto até o segmento a-b, e a posição relativa no segmento (0 a 1)
local function distanciaAoSegmento(ponto: Vector3, a: Vector3, b: Vector3): (number, number)
	local p, ia, ib = planar(ponto), planar(a), planar(b)
	local ab = ib - ia
	local comprimento2 = ab:Dot(ab)
	local t = 0
	if comprimento2 > 0 then
		t = math.clamp((p - ia):Dot(ab) / comprimento2, 0, 1)
	end
	return (ia + ab * t - p).Magnitude, t
end
Projeteis.distanciaAoSegmento = distanciaAoSegmento

--[[ Cada item da lista aceita:
	lado = "jogador" ou "inimigo"   tipo = nome do visual (orbe, flecha, fogo...)
	pos, dir, velocidade, alcance, raio, tamanho
	perfuracao, ricochete           (quantos inimigos atravessa / quica)
	explosao                        (raio da explosão ao terminar, opcional)
	aoAcertar(alvo, pos, projetil)  alvo = inimigo (lado jogador) ou estado do jogador (lado inimigo)
	aoExplodir(pos, alvoPrincipal)  ]]
function Projeteis.disparar(run, lista)
	local visuais = {}
	for _, dados in lista do
		local direcao = planar(dados.dir)
		direcao = if direcao.Magnitude > 0.01 then direcao.Unit else Vector3.new(0, 0, -1)
		proximoId += 1
		local projetil = {
			id = proximoId,
			lado = dados.lado,
			pos = dados.pos,
			dir = direcao,
			velocidade = dados.velocidade,
			alcance = dados.alcance,
			percorrido = 0,
			raio = dados.raio or 1,
			perfuracao = dados.perfuracao or 0,
			ricochete = dados.ricochete or 0,
			explosao = dados.explosao,
			aoAcertar = dados.aoAcertar,
			aoExplodir = dados.aoExplodir,
			atingidos = {},
		}
		run.projeteis[projetil] = true
		table.insert(visuais, {
			id = projetil.id,
			tipo = dados.tipo,
			pos = dados.pos,
			dir = direcao,
			vel = dados.velocidade,
			alcance = dados.alcance,
			tamanho = dados.tamanho or 1,
		})
	end
	if #visuais > 0 then
		Vfx.partida(run, "projeteis", { lista = visuais })
	end
end

local function terminar(run, projetil, impacto: boolean, alvoPrincipal)
	run.projeteis[projetil] = nil
	if projetil.explosao and projetil.aoExplodir then
		projetil.aoExplodir(projetil.pos, alvoPrincipal)
	end
	Vfx.partida(run, "projetilFim", { id = projetil.id, pos = projetil.pos, impacto = impacto })
end

local function alvosDoInimigo(run)
	local lista = {}
	local agora = os.clock()
	for _, estado in run.jogadores do
		-- quem está esquivando atravessa os projéteis
		if estado.vivo and not estado.caido and agora >= (estado.invulneravelAte or 0) then
			local personagem = estado.player.Character
			local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
			if raiz then
				table.insert(lista, { alvo = estado, pos = raiz.Position, raio = 1.6 })
			end
		end
	end
	return lista
end

local function alvosDoJogador(run)
	local lista = {}
	for inimigo in run.inimigos do
		if inimigo.vivo then
			table.insert(lista, { alvo = inimigo, pos = inimigo.raiz.Position, raio = inimigo.raio })
		end
	end
	return lista
end

local function procurarRicochete(run, projetil)
	local melhor, melhorDistancia = nil, 24
	for inimigo in run.inimigos do
		if inimigo.vivo and not projetil.atingidos[inimigo] then
			local distancia = planar(inimigo.raiz.Position - projetil.pos).Magnitude
			if distancia < melhorDistancia then
				melhor, melhorDistancia = inimigo, distancia
			end
		end
	end
	return melhor
end

local function bateuNaSala(run, pos: Vector3): boolean
	local sala = run.sala
	if not sala then
		return false
	end
	local local_ = pos - sala.origem
	if math.abs(local_.X) > sala.largura / 2 or math.abs(local_.Z) > sala.comprimento / 2 then
		return true
	end
	for _, pilar in sala.pilares do
		if planar(pos - pilar.pos).Magnitude < pilar.raio then
			return true
		end
	end
	return false
end

function Projeteis.atualizar(run, dt: number)
	local lista = {}
	for projetil in run.projeteis do
		table.insert(lista, projetil)
	end

	for _, projetil in lista do
		local passo = projetil.velocidade * dt
		local inicio = projetil.pos
		local fim = inicio + projetil.dir * passo
		projetil.pos = fim
		projetil.percorrido += passo

		-- Quem está no caminho deste passo, em ordem
		local candidatos = {}
		local alvos = if projetil.lado == "jogador" then alvosDoJogador(run) else alvosDoInimigo(run)
		for _, info in alvos do
			if not projetil.atingidos[info.alvo] then
				local distancia, t = distanciaAoSegmento(info.pos, inicio, fim)
				if distancia <= projetil.raio + info.raio then
					table.insert(candidatos, { info = info, t = t })
				end
			end
		end
		table.sort(candidatos, function(a, b)
			return a.t < b.t
		end)

		local acabou = false
		for _, candidato in candidatos do
			local alvo = candidato.info.alvo
			projetil.atingidos[alvo] = true
			projetil.pos = inicio:Lerp(fim, candidato.t)
			if projetil.aoAcertar then
				projetil.aoAcertar(alvo, projetil.pos, projetil)
			end
			if projetil.perfuracao > 0 then
				projetil.perfuracao -= 1
			elseif projetil.ricochete > 0 and projetil.lado == "jogador" then
				projetil.ricochete -= 1
				local proximo = procurarRicochete(run, projetil)
				if proximo then
					projetil.dir = planar(proximo.raiz.Position - projetil.pos).Unit
					projetil.percorrido = math.max(0, projetil.alcance - 30)
					Vfx.partida(run, "projetilDir", { id = projetil.id, pos = projetil.pos, dir = projetil.dir })
				else
					terminar(run, projetil, true, alvo)
					acabou = true
				end
				break
			else
				terminar(run, projetil, true, alvo)
				acabou = true
				break
			end
		end

		if not acabou then
			if bateuNaSala(run, projetil.pos) then
				terminar(run, projetil, true, nil)
			elseif projetil.percorrido >= projetil.alcance then
				terminar(run, projetil, false, nil)
			end
		end
	end
end

function Projeteis.limpar(run)
	table.clear(run.projeteis)
end

return Projeteis
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000020">
        <Properties>
          <string name="Name">Remotos</string>
          <ProtectedString name="Source"><![CDATA[-- Canais de comunicação entre servidor e jogadores.
-- Evento: servidor -> jogador (tipo, dados). Acao: jogador -> servidor (tipo, dados).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotos = {}

local pasta = Instance.new("Folder")
pasta.Name = "Remotos"

local evento = Instance.new("RemoteEvent")
evento.Name = "Evento"
evento.Parent = pasta

local acao = Instance.new("RemoteEvent")
acao.Name = "Acao"
acao.Parent = pasta

pasta.Parent = ReplicatedStorage

Remotos.Evento = evento
Remotos.Acao = acao

function Remotos.enviar(player: Player, tipo: string, dados: any?)
	if player.Parent then
		evento:FireClient(player, tipo, dados or {})
	end
end

function Remotos.enviarParaTodos(tipo: string, dados: any?)
	evento:FireAllClients(tipo, dados or {})
end

return Remotos
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000021">
        <Properties>
          <string name="Name">Vfx</string>
          <ProtectedString name="Source"><![CDATA[-- Efeitos visuais: o servidor só avisa o que aconteceu e cada jogador desenha o efeito
-- no próprio computador (fica suave e não pesa na rede). Os desenhos ficam em Client/Vfx.

local Remotos = require(script.Parent.Remotos)

local Vfx = {}

-- Envia um efeito para todos os jogadores de uma partida (menos "exceto", se informado)
function Vfx.partida(run, tipo: string, dados, exceto: Player?)
	dados.t = tipo
	for player in run.jogadores do
		if player ~= exceto then
			Remotos.enviar(player, "vfx", dados)
		end
	end
end

-- Envia um efeito para todo mundo no servidor (usado no lobby)
function Vfx.todos(tipo: string, dados)
	dados.t = tipo
	Remotos.enviarParaTodos("vfx", dados)
end

return Vfx
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00000022">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00000023">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX00000024">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000025">
          <Properties>
            <string name="Name">Ambiente</string>
            <ProtectedString name="Source"><![CDATA[-- Iluminação e pós-processamento: fim de tarde dourado no acampamento, escuridão com
-- névoa colorida na masmorra. Também faz as chamas tremularem e os objetos girarem.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Ambiente = {}

local function obter(classe: string, nome: string): any
	local existente = Lighting:FindFirstChild(nome)
	if existente then
		return existente
	end
	local novo = Instance.new(classe)
	novo.Name = nome
	novo.Parent = Lighting
	return novo
end

local atmosfera = obter("Atmosphere", "AtmosferaJogo")
local bloom = obter("BloomEffect", "BrilhoJogo")
local cores = obter("ColorCorrectionEffect", "CoresJogo")
local raiosDeSol = obter("SunRaysEffect", "RaiosJogo")

local function animar(objeto: Instance, duracao: number, propriedades)
	TweenService:Create(objeto, TweenInfo.new(duracao, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), propriedades):Play()
end

function Ambiente.lobby()
	Lighting.ClockTime = 17.2
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(96, 84, 96)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 132, 126)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	atmosfera.Density = 0.3
	atmosfera.Offset = 0.25
	atmosfera.Color = Color3.fromRGB(255, 212, 168)
	atmosfera.Decay = Color3.fromRGB(122, 92, 112)
	atmosfera.Glare = 0.35
	atmosfera.Haze = 1.6
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.4
	cores.Brightness = 0.02
	cores.Contrast = 0.12
	cores.Saturation = 0.14
	cores.TintColor = Color3.fromRGB(255, 244, 230)
	raiosDeSol.Intensity = 0.06
	raiosDeSol.Spread = 0.6
end

function Ambiente.masmorra(tema)
	Lighting.ClockTime = 0
	Lighting.Brightness = 0.8
	Lighting.Ambient = tema.ambiente
	Lighting.OutdoorAmbient = tema.ambiente:Lerp(Color3.new(0, 0, 0), 0.2)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.6
	atmosfera.Density = 0.42
	atmosfera.Offset = 0
	atmosfera.Color = tema.nevoa:Lerp(Color3.new(1, 1, 1), 0.12)
	atmosfera.Decay = tema.nevoa
	atmosfera.Glare = 0
	atmosfera.Haze = 2.4
	bloom.Intensity = 1.1
	bloom.Size = 24
	bloom.Threshold = 0.9
	cores.Brightness = 0
	cores.Contrast = 0.18
	cores.Saturation = 0.06
	cores.TintColor = tema.tinta
	raiosDeSol.Intensity = 0
end

-- Tela sem cor enquanto o jogador está caído
function Ambiente.caido(ligar: boolean)
	animar(cores, 0.5, { Saturation = if ligar then -0.85 else 0.06, Contrast = if ligar then 0.3 else 0.18 })
end

------------------------------------------------------------------------
-- Chamas tremulando e objetos girando (só no computador do jogador)
------------------------------------------------------------------------

local chamas = {} -- [PointLight] = { brilho, semente }
local giratorios = {} -- [Model] = pivô original

local function adicionarChama(luz: Instance)
	if luz:IsA("PointLight") then
		chamas[luz] = { brilho = luz.Brightness, semente = math.random() * 100 }
	end
end

local function adicionarGiratorio(modelo: Instance)
	if modelo:IsA("Model") then
		giratorios[modelo] = modelo:GetPivot()
	end
end

function Ambiente.iniciar()
	Ambiente.lobby()
	for _, luz in CollectionService:GetTagged("Chama") do
		adicionarChama(luz)
	end
	CollectionService:GetInstanceAddedSignal("Chama"):Connect(adicionarChama)
	CollectionService:GetInstanceRemovedSignal("Chama"):Connect(function(luz)
		chamas[luz] = nil
	end)
	for _, modelo in CollectionService:GetTagged("Girar") do
		adicionarGiratorio(modelo)
	end
	CollectionService:GetInstanceAddedSignal("Girar"):Connect(adicionarGiratorio)
	CollectionService:GetInstanceRemovedSignal("Girar"):Connect(function(modelo)
		giratorios[modelo] = nil
	end)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for luz, info in chamas do
			if luz.Parent then
				luz.Brightness = info.brilho * (0.78 + 0.32 * math.noise(t * 7, info.semente))
			else
				chamas[luz] = nil
			end
		end
		for modelo, pivo in giratorios do
			if modelo.Parent then
				local giro = (modelo:GetAttribute("Giro") or 1) * t
				local flutuar = modelo:GetAttribute("Flutuar") or 0
				local deslocamento = CFrame.new(0, math.sin(t * 1.6) * flutuar, 0)
				if modelo:GetAttribute("EixoGiro") == "X" then
					modelo:PivotTo(pivo * deslocamento * CFrame.Angles(giro, 0, 0))
				else
					-- gira em volta do eixo vertical do mundo, mantendo a inclinação original
					modelo:PivotTo(deslocamento * CFrame.new(pivo.Position) * CFrame.Angles(0, giro, 0) * pivo.Rotation)
				end
			else
				giratorios[modelo] = nil
			end
		end
	end)
end

return Ambiente
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000026">
          <Properties>
            <string name="Name">Animacoes</string>
            <ProtectedString name="Source"><![CDATA[-- Animações dos personagens feitas por código (não precisam de arquivos de animação).
--
-- Cada animação é uma lista de "quadros-chave": em cada tempo, o ângulo de algumas juntas
-- (ombro, cotovelo, cintura...). Entre os quadros, os ângulos são suavizados. A animação é
-- aplicada por cima da animação padrão do Roblox (andar, pular), então as pernas continuam
-- andando enquanto os braços atacam.
--
-- Ângulos em radianos, no espaço da peça "pai" (X = direita, Y = cima, Z = trás):
--   rx > 0 leva o braço/perna para FRENTE (1,57 = esticado para frente; 3,14 = para cima)
--   ry > 0 gira para a ESQUERDA (visto de cima)   rz > 0 abre o braço direito para o lado
--   no tronco, rx < 0 inclina para frente

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))

local Vfx = require(script.Parent.Vfx)

local Animacoes = {}

local jogador = Players.LocalPlayer
local pasta = Instance.new("Folder")
pasta.Name = "AnimacoesLocais"
pasta.Parent = workspace

local PESO_POSTURA = 0.75
local ZERO = { 0, 0, 0, 0, 0, 0 }
local OURO = Color3.fromRGB(255, 214, 90)

-- Junta lógica -> { peça que contém o Motor6D, nome do Motor6D }
local JUNTAS_R15 = {
	raiz = { "LowerTorso", "Root" },
	cintura = { "UpperTorso", "Waist" },
	pescoco = { "Head", "Neck" },
	ombroD = { "RightUpperArm", "RightShoulder" },
	cotoveloD = { "RightLowerArm", "RightElbow" },
	pulsoD = { "RightHand", "RightWrist" },
	ombroE = { "LeftUpperArm", "LeftShoulder" },
	cotoveloE = { "LeftLowerArm", "LeftElbow" },
	pulsoE = { "LeftHand", "LeftWrist" },
	quadrilD = { "RightUpperLeg", "RightHip" },
	joelhoD = { "RightLowerLeg", "RightKnee" },
	quadrilE = { "LeftUpperLeg", "LeftHip" },
	joelhoE = { "LeftLowerLeg", "LeftKnee" },
	tornozeloD = { "RightFoot", "RightAnkle" },
	tornozeloE = { "LeftFoot", "LeftAnkle" },
}
local JUNTAS_R6 = {
	raiz = { "HumanoidRootPart", "RootJoint" },
	pescoco = { "Torso", "Neck" },
	ombroD = { "Torso", "Right Shoulder" },
	ombroE = { "Torso", "Left Shoulder" },
	quadrilD = { "Torso", "Right Hip" },
	quadrilE = { "Torso", "Left Hip" },
}

-- Ângulos (rx, ry, rz) e deslocamento (px, py, pz)
local function A(rx: number?, ry: number?, rz: number?, px: number?, py: number?, pz: number?)
	return { rx or 0, ry or 0, rz or 0, px or 0, py or 0, pz or 0 }
end

local function juntar(base, extra)
	local resultado = table.clone(base)
	for chave, valor in extra do
		resultado[chave] = valor
	end
	return resultado
end

------------------------------------------------------------------------
-- Posturas (como cada classe segura a arma parada) e animações
------------------------------------------------------------------------

-- Postura: vale sempre (andando ou parado) e mexe só da cintura para cima
local POSTURAS = {
	cavaleiro = { ombroD = A(0.35, 0, 0.12), cotoveloD = A(0.6), ombroE = A(0.55, 0.35, -0.1), cotoveloE = A(1.1), pescoco = A(-0.05) },
	mago = { ombroD = A(0.25, 0, 0.1), cotoveloD = A(0.8), pulsoD = A(-1.05), ombroE = A(0.15, 0, -0.12), cintura = A(0.06) },
	arqueiro = { ombroE = A(0.45, 0.2, -0.1), cotoveloE = A(0.3), ombroD = A(0.15, 0, 0.1) },
	-- o Assassino anda sempre curvado, com as adagas baixas e à frente
	assassino = {
		cintura = A(-0.3),
		pescoco = A(0.22),
		ombroD = A(0.55, 0, 0.3),
		cotoveloD = A(1.2),
		pulsoD = A(-0.3),
		ombroE = A(0.75, 0.25, -0.3),
		cotoveloE = A(1.35),
		pulsoE = A(-0.3),
	},
}

-- Pose parada: o corpo todo, só quando o personagem está quase sem se mexer.
-- "t" é o tempo em segundos (para respirar e balançar de leve).
local PARADO = {
	-- Guarda firme: base larga, escudo à frente, espada pronta
	cavaleiro = function(t: number)
		local respirar = math.sin(t * 1.6) * 0.025
		return {
			raiz = A(0, 0.3, 0, 0, -0.22, 0),
			cintura = A(-0.04 + respirar, -0.22),
			pescoco = A(-0.05, -0.08),
			ombroE = A(0.95, 0.55, -0.1),
			cotoveloE = A(1.25),
			ombroD = A(0.4, 0, 0.3),
			cotoveloD = A(0.75),
			pulsoD = A(-0.45),
			quadrilD = A(0.32, 0, 0.14),
			joelhoD = A(-0.5),
			tornozeloD = A(0.18),
			quadrilE = A(-0.12, 0, -0.14),
			joelhoE = A(-0.32),
			tornozeloE = A(0.18),
		}
	end,
	-- Ereto e confiante: cajado apoiado, a outra mão conjura uma luz, flutua de leve
	mago = function(t: number)
		local flutuar = math.sin(t * 2) * 0.06
		return {
			raiz = A(0, 0, 0, 0, flutuar, 0),
			cintura = A(0.1 + math.sin(t * 1.4) * 0.02),
			pescoco = A(-0.14),
			ombroD = A(0.2, 0, 0.2),
			cotoveloD = A(0.9),
			pulsoD = A(-1.1),
			ombroE = A(0.75, 0.35, -0.25),
			cotoveloE = A(1.35),
			pulsoE = A(0.45 + math.sin(t * 2) * 0.1),
			quadrilD = A(0, 0, 0.04),
			quadrilE = A(0, 0, -0.04),
			brilho = A(0.35 + math.sin(t * 2) * 0.1),
		}
	end,
	-- Relaxado, peso numa perna, arco baixo, olhando em volta
	arqueiro = function(t: number)
		return {
			raiz = A(0, -0.25, 0.07),
			cintura = A(0.02, 0.15, -0.05),
			pescoco = A(0, math.sin(t * 0.6) * 0.45),
			ombroE = A(0.25, 0, -0.18),
			cotoveloE = A(0.25),
			ombroD = A(-0.12, 0, 0.18),
			cotoveloD = A(0.5),
			quadrilD = A(0, 0, 0.1),
			quadrilE = A(0.18, 0, -0.16),
			joelhoE = A(-0.35),
			tornozeloE = A(0.15),
		}
	end,
	-- Agachado e inclinado para frente, pronto para dar o bote
	assassino = function(t: number)
		local respirar = math.sin(t * 3.2) * 0.04
		return {
			raiz = A(0, 0.3, 0, 0, -0.42 + respirar, 0),
			cintura = A(-0.5 + respirar, -0.2),
			pescoco = A(0.42, 0.15 + math.sin(t * 0.8) * 0.15),
			ombroD = A(0.7, 0, 0.4),
			cotoveloD = A(1.35),
			pulsoD = A(-0.35),
			ombroE = A(1, 0.35, -0.35),
			cotoveloE = A(1.55),
			pulsoE = A(-0.35),
			quadrilD = A(0.65, 0, 0.15),
			joelhoD = A(-1.1),
			tornozeloD = A(0.42),
			quadrilE = A(0.35, 0, -0.2),
			joelhoE = A(-1),
			tornozeloE = A(0.6),
		}
	end,
}

-- Arqueiro mirando: corpo de lado, braço do arco esticado, mão puxando a corda até o rosto
local MIRA = {
	cintura = A(0, -0.85),
	pescoco = A(0, 0.75),
	ombroE = A(1.57, 0.85),
	cotoveloE = A(0),
	pulsoE = A(0),
	ombroD = A(1.45, 1.1),
	cotoveloD = A(2.2),
	puxar = A(1),
}

local function lancarMago(lado: number)
	return {
		duracao = 0.32,
		quadros = {
			{ t = 0.07, suave = "forte", pose = { ombroD = A(1.55, -0.15 * lado), cotoveloD = A(0.1), pulsoD = A(-0.2), ombroE = A(1.4, 0.3, -0.1), cotoveloE = A(0.2), cintura = A(0, -0.2 * lado), brilho = A(1) } },
		},
	}
end

local CONJURAR_MAGO = {
	duracao = 0.5,
	quadros = {
		{ t = 0.13, pose = { ombroD = A(2.9, 0, 0.1), cotoveloD = A(0.2), pulsoD = A(0), ombroE = A(2.6, 0, -0.1), cintura = A(0.25), brilho = A(1) } },
		{ t = 0.24, suave = "forte", pose = { ombroD = A(1.5), cotoveloD = A(0), pulsoD = A(-0.1), ombroE = A(1.5, 0.3), cintura = A(-0.3), raiz = A(-0.12, 0, 0, 0, -0.2, 0), brilho = A(1.5) } },
	},
}

local function tiroArqueiro()
	return {
		duracao = 0.3,
		quadros = {
			{ t = 0.06, pose = MIRA },
			{ t = 0.09, suave = "forte", pose = { ombroD = A(1.3, 1.5, 0.3), cotoveloD = A(0.9), ombroE = A(1.75, 0.85), puxar = A(0) } },
		},
	}
end

local ACOES = {
	assassino = {
		-- corte rápido da direita para a esquerda (adaga direita)
		ataque1 = {
			duracao = 0.24,
			trilha = true,
			quadros = {
				{ t = 0.04, pose = { ombroD = A(1.1, -1, 0.35), cotoveloD = A(0.9), pulsoD = A(-0.6), cintura = A(-0.35, -0.45), raiz = A(0, -0.15, 0, 0, -0.3, 0) } },
				{ t = 0.11, suave = "forte", pose = { ombroD = A(1.45, 0.95), cotoveloD = A(0.15), pulsoD = A(-0.9), cintura = A(-0.4, 0.45), raiz = A(-0.05, 0.2, 0, 0, -0.35, 0) } },
			},
		},
		-- corte rápido da esquerda para a direita (adaga esquerda)
		ataque2 = {
			duracao = 0.24,
			trilha = true,
			quadros = {
				{ t = 0.04, pose = { ombroE = A(1.1, 1, -0.35), cotoveloE = A(0.9), pulsoE = A(-0.6), cintura = A(-0.35, 0.45), raiz = A(0, 0.15, 0, 0, -0.3, 0) } },
				{ t = 0.11, suave = "forte", pose = { ombroE = A(1.45, -0.95), cotoveloE = A(0.15), pulsoE = A(-0.9), cintura = A(-0.4, -0.45), raiz = A(-0.05, -0.2, 0, 0, -0.35, 0) } },
			},
		},
		-- golpe final: salta e cruza as duas adagas para baixo
		ataque3 = {
			duracao = 0.4,
			trilha = true,
			quadros = {
				{ t = 0.1, pose = { ombroD = A(2.4, 0.35), ombroE = A(2.4, -0.35), cotoveloD = A(1.1), cotoveloE = A(1.1), cintura = A(0.2), raiz = A(0.05, 0, 0, 0, 0.35, 0) } },
				{
