						tornozeloE = A(0.2),
					},
				},
				{
					t = 0.13,
					suave = "forte",
					pose = {
						raiz = A(-0.1, -0.15, 0, 0, -0.35, -0.3),
						cintura = A(-0.15, -0.2),
						pescoco = A(0.05, 0.25),
