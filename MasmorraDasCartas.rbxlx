			{
				t = 0.32,
				suave = "forte",
				pose = {
					ombroD = A(1, -0.14, -0.6),
					cotoveloD = A(0),
					pulsoD = A(-1.7),
					ombroE = A(1, -0.2),
					cotoveloE = A(0.3),
