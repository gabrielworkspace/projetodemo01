<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <Item class="Workspace" referent="RBX00000001">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
  <Item class="Lighting" referent="RBX00000002">
    <Properties>
      <string name="Name">Lighting</string>
      <token name="Technology">4</token>
      <Color3 name="Ambient"><R>0.35</R><G>0.35</G><B>0.4</B></Color3>
      <Color3 name="OutdoorAmbient"><R>0.5</R><G>0.5</G><B>0.55</B></Color3>
      <float name="Brightness">2.2</float>
      <string name="TimeOfDay">14:30:00</string>
      <bool name="GlobalShadows">true</bool>
    </Properties>
  </Item>
  <Item class="Players" referent="RBX00000003">
    <Properties>
      <string name="Name">Players</string>
      <bool name="CharacterAutoLoads">false</bool>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="RBX00000004">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="RBX00000005">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX00000006">
        <Properties>
          <string name="Name">Cartas</string>
          <ProtectedString name="Source"><![CDATA[-- Cartas de poder (11 universais e 11 de cada classe). "classe = nil" aparece para todos; as outras só para aquela classe.
-- "efeitos" soma valores aos atributos do jogador (veja Combate.calcularStats no servidor).

local Cartas = {}

local function carta(id, nome, icone, raridade, classe, maxPilha, descricao, efeitos)
	return {
		id = id,
		nome = nome,
		icone = icone,
		raridade = raridade,
		classe = classe,
		maxPilha = maxPilha,
		descricao = descricao,
		efeitos = efeitos,
	}
end

Cartas.lista = {
	-- Universais ------------------------------------------------------------
	carta("coracao", "Coração Forte", "❤️", "Comum", nil, 8, "+25 de vida máxima e cura total", { vidaPlana = 25 }),
	carta("forca", "Força Bruta", "💪", "Comum", nil, 8, "+15% de dano", { danoPct = 0.15 }),
	carta("botas", "Botas Ligeiras", "👟", "Comum", nil, 4, "+10% de velocidade", { velocidadePct = 0.1 }),
	carta("regen", "Regeneração", "🌿", "Comum", nil, 5, "Recupera 1,5 de vida por segundo", { regen = 1.5 }),
	carta("vampiro", "Vampirismo", "🦇", "Rara", nil, 4, "Cada acerto cura 2 de vida", { rouboVida = 2 }),
	carta("critico", "Olhar Mortal", "🎯", "Rara", nil, 4, "+12% de chance de crítico (dano triplo)", { critico = 0.12 }),
	carta("ampulheta", "Ampulheta", "⏳", "Rara", nil, 3, "A habilidade recarrega 15% mais rápido", { recargaPct = 0.15 }),
	carta("brasa", "Coração em Brasa", "🔥", "Rara", nil, 3, "O Supremo carrega 30% mais rápido", { cargaPct = 0.3 }),
	carta("ganancia", "Ganância", "💰", "Rara", nil, 3, "+50% de ouro, mas -15 de vida máxima", { ouroPct = 0.5, vidaPlana = -15 }),
	carta("segunda", "Segunda Chance", "👼", "Lendaria", nil, 1, "Ao cair, levanta na hora com metade da vida (uma vez)", { segundaChance = 1 }),
	carta("midas", "Rei Midas", "👑", "Lendaria", nil, 1, "Dobra todo o ouro que você ganha", { ouroMult = 1 }),

	-- Cavaleiro ------------------------------------------------------------
	carta("laminaLarga", "Lâmina Larga", "🗡️", "Comum", "cavaleiro", 4, "+25% de alcance dos cortes", { alcancePct = 0.25 }),
	carta("ritmo", "Ritmo de Batalha", "🥁", "Comum", "cavaleiro", 5, "Ataca 15% mais rápido", { ataqueVelPct = 0.15 }),
	carta("armadura", "Armadura Pesada", "🧱", "Comum", "cavaleiro", 4, "Recebe 10% menos dano", { armadura = 0.1 }),
	carta("espinhos", "Espinhos", "🌵", "Rara", "cavaleiro", 3, "Quem te acerta leva o mesmo dano de volta", { espinhos = 1 }),
	carta("investida", "Investida Brutal", "🐗", "Rara", "cavaleiro", 2, "Sua esquiva atropela os inimigos no caminho", { investida = 1 }),
	carta("escudo", "Escudo Abençoado", "🛡️", "Epica", "cavaleiro", 1, "Bloqueia o primeiro golpe que você leva em cada sala", { escudo = 1 }),
	carta("ondaCorte", "Onda de Corte", "🌊", "Epica", "cavaleiro", 2, "O golpe final do combo solta uma onda de energia", { ondaCorte = 1 }),
	carta("redemoinhoFogo", "Redemoinho Flamejante", "🌪️", "Epica", "cavaleiro", 1, "O Redemoinho dura 50% a mais e queima os inimigos", { redemoinhoFogo = 1 }),
	carta("gigante", "Gigante", "🗿", "Epica", "cavaleiro", 2, "Fica 30% maior: +50 de vida e +20% de alcance, mas 8% mais lento", { gigante = 1 }),
	carta("dragao", "Fúria do Dragão", "🐉", "Lendaria", "cavaleiro", 1, "Todo golpe solta uma rajada de fogo à frente", { dragao = 1 }),
	carta("protetor", "Aura do Protetor", "✨", "Lendaria", "cavaleiro", 1, "Aliados perto de você recebem 30% menos dano", { protetor = 1 }),

	-- Mago -----------------------------------------------------------------
	carta("orbeMaior", "Orbe Maior", "🔮", "Comum", "mago", 4, "+20% de dano e orbes maiores", { danoPct = 0.2, tamanhoPct = 0.2 }),
	carta("canalizacao", "Canalização", "🌀", "Comum", "mago", 5, "Lança orbes 15% mais rápido", { ataqueVelPct = 0.15 }),
	carta("explosaoArcana", "Explosão Arcana", "💠", "Comum", "mago", 3, "A explosão dos orbes fica 40% maior", { explosaoPct = 0.4 }),
	carta("missil", "Míssil Duplo", "🎆", "Rara", "mago", 2, "+1 orbe por ataque", { projeteisExtra = 1 }),
	carta("gelo", "Toque Gélido", "❄️", "Rara", "mago", 2, "Orbes deixam os inimigos 35% mais lentos", { lentidao = 1 }),
	carta("barreira", "Barreira Arcana", "🌐", "Epica", "mago", 1, "Bloqueia o primeiro golpe que você leva em cada sala", { escudo = 1 }),
	carta("raio", "Corrente Elétrica", "⚡", "Epica", "mago", 3, "Cada acerto solta raios em 2 inimigos próximos", { raios = 2 }),
	carta("chuvaMeteoros", "Chuva de Meteoros", "☄️", "Epica", "mago", 2, "O Meteoro cai mais 2 vezes", { meteoros = 2 }),
	carta("perfurante", "Orbe Perfurante", "📌", "Epica", "mago", 2, "Orbes atravessam mais 2 inimigos", { perfuracao = 2 }),
	carta("combustao", "Combustão", "💥", "Lendaria", "mago", 1, "Inimigos explodem ao morrer e ferem os vizinhos", { explosaoMorte = 1 }),
	carta("arquimago", "Arquimago", "🧙", "Lendaria", "mago", 1, "Cada inimigo derrotado reduz 1s da recarga da habilidade", { arquimago = 1 }),

	-- Arqueiro ---------------------------------------------------------------
	carta("pontaAfiada", "Ponta Afiada", "📍", "Comum", "arqueiro", 5, "+15% de dano", { danoPct = 0.15 }),
	carta("maoRapida", "Mão Rápida", "🤚", "Comum", "arqueiro", 5, "Atira 15% mais rápido", { ataqueVelPct = 0.15 }),
	carta("passosLeves", "Passos Leves", "🍃", "Comum", "arqueiro", 3, "+10% de velocidade e esquiva 25% mais rápida", { velocidadePct = 0.1, esquivaPct = 0.25 }),
	carta("multiplo", "Tiro Múltiplo", "🎇", "Rara", "arqueiro", 3, "+2 flechas em leque", { projeteisExtra = 2 }),
	carta("perfurantes", "Flechas Perfurantes", "➡️", "Rara", "arqueiro", 3, "Flechas atravessam mais 1 inimigo", { perfuracao = 1 }),
	carta("flechasFogo", "Flechas de Fogo", "🔥", "Rara", "arqueiro", 3, "Flechas queimam o inimigo por 3 segundos", { queimadura = 0.3 }),
	carta("aguia", "Olho de Águia", "🦅", "Rara", "arqueiro", 3, "+10% de crítico e flechas mais velozes", { critico = 0.1, velProjPct = 0.25 }),
	carta("ricochete", "Ricochete", "↪️", "Epica", "arqueiro", 2, "Flechas quicam em mais 2 inimigos", { ricochete = 2 }),
	carta("torrencial", "Chuva Torrencial", "🌧️", "Epica", "arqueiro", 2, "A Chuva de Flechas fica 40% maior e dura mais", { chuvaPct = 0.4 }),
	carta("fantasma", "Tiro Fantasma", "👻", "Lendaria", "arqueiro", 1, "O golpe final do combo dispara uma flecha gigante que atravessa tudo", { fantasma = 1 }),
	carta("cacador", "Caçador", "🏹", "Lendaria", "arqueiro", 1, "Críticos causam 5x de dano em vez de 3x", { multCritico = 2 }),

	-- Assassino --------------------------------------------------------------
	carta("laminasAfiadas", "Lâminas Afiadas", "🔪", "Comum", "assassino", 5, "+15% de dano", { danoPct = 0.15 }),
	carta("reflexos", "Reflexos", "⚡", "Comum", "assassino", 5, "Ataca 15% mais rápido", { ataqueVelPct = 0.15 }),
	carta("sombraAgil", "Sombra Ágil", "💨", "Comum", "assassino", 3, "+10% de velocidade e esquiva 20% mais rápida", { velocidadePct = 0.1, esquivaPct = 0.2 }),
	carta("venenoAdagas", "Lâminas Envenenadas", "🧪", "Rara", "assassino", 3, "Cada golpe envenena o inimigo por 3 segundos", { queimadura = 0.35 }),
	carta("pontoFraco", "Ponto Fraco", "🎯", "Rara", "assassino", 3, "Golpes pelas costas causam +40% de dano", { costasPct = 0.4 }),
	carta("sangria", "Sangria", "🩸", "Rara", "assassino", 3, "Críticos curam 4 de vida", { curaCritico = 4 }),
	carta("sombraPersistente", "Sombra Persistente", "🌑", "Epica", "assassino", 2, "O Passo Sombrio recarga 30% mais rápido", { recargaPct = 0.3 }),
	carta("lequeAdagas", "Leque de Adagas", "🎴", "Epica", "assassino", 2, "O golpe final do combo arremessa 3 adagas em leque", { leque = 1 }),
	carta("contraAtaque", "Contra-Ataque", "🔄", "Epica", "assassino", 1, "Depois de esquivar, o próximo golpe é crítico garantido", { contraAtaque = 1 }),
	carta("execucao", "Execução", "☠️", "Lendaria", "assassino", 1, "Golpes acabam na hora com inimigos abaixo de 20% de vida (chefes levam dano dobrado)", { execucao = 1 }),
	carta("milCortes", "Mil Cortes", "🌸", "Lendaria", "assassino", 1, "Cada crítico tira 0,5s da recarga do Passo Sombrio", { milCortes = 1 }),
}

Cartas.porId = {}
for _, c in Cartas.lista do
	Cartas.porId[c.id] = c
end

return Cartas
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000007">
        <Properties>
          <string name="Name">Classes</string>
          <ProtectedString name="Source"><![CDATA[-- As quatro classes jogáveis. Os números de cada classe ficam aqui.
-- As cartas de cada classe ficam em Cartas.luau (campo "classe").
--
-- Cada classe tem pontos fortes e fracos claros:
--   Cavaleiro: aguenta muito e protege o grupo, mas é lento e só bate de perto
--   Mago:      destrói grupos de longe, mas é frágil e ataca devagar
--   Arqueiro:  dano constante de longe e muito ágil, mas fraco contra quem chega perto
--   Assassino: mata um alvo de cada vez muito rápido, mas tem pouca vida e quase nenhuma área
--
-- Campos opcionais: critico (chance base), esquivaMult (recarga da esquiva),
-- ameacaMult (o quanto chama a atenção dos inimigos)

local Classes = {}

Classes.ordem = { "cavaleiro", "mago", "arqueiro", "assassino" }

Classes.dados = {
	cavaleiro = {
		id = "cavaleiro",
		nome = "Cavaleiro",
		titulo = "A Muralha de Aço",
		icone = "🛡️",
		cor = Color3.fromRGB(86, 156, 255),
		descricao = "Luta na linha de frente com espada e escudo e atrai os inimigos para si.",
		forte = "Muita vida e armadura, protege os aliados",
		fraco = "Lento, esquiva demora mais e só bate de perto",
		notas = { Vida = 5, Dano = 3, Alcance = 1, Velocidade = 1 },

		vida = 160,
		dano = 22,
		velocidade = 16,
		intervalo = 0.44,
		alcance = 9.5,
		armadura = 0.15,
		esquivaMult = 1.25,
		ameacaMult = 2.5,

		ataque = {
			tipo = "corte",
			arco = 140,
			combo = { 1, 1.1, 1.9 }, -- o terceiro golpe é o finalizador
			nome = "Combo de Espada",
			icone = "⚔️",
		},
		habilidade = {
			id = "redemoinho",
			nome = "Redemoinho",
			icone = "🌀",
			recarga = 8,
			descricao = "Gira por 2s puxando os inimigos para perto. Recebe 40% menos dano enquanto gira.",
		},
		supremo = {
			id = "julgamento",
			nome = "Julgamento",
			icone = "⚡",
			descricao = "Esmaga o chão: atordoa todos ao redor e dá um escudo aos aliados próximos.",
		},
	},

	mago = {
		id = "mago",
		nome = "Mago",
		titulo = "O Arcano",
		icone = "🔮",
		cor = Color3.fromRGB(180, 96, 255),
		descricao = "Ataca de longe com orbes que explodem e controla o campo com fogo e raios.",
		forte = "Enorme dano em área e controle de grupos",
		fraco = "Pouquíssima vida e ataque lento",
		notas = { Vida = 1, Dano = 5, Alcance = 4, Velocidade = 2 },

		vida = 80,
		dano = 21,
		velocidade = 17,
		intervalo = 0.52,
		alcance = 50,
		armadura = 0,

		ataque = {
			tipo = "projetil",
			projetil = "orbe",
			velocidade = 62,
			raio = 1.3,
			explosao = 4,
			combo = { 1, 1, 1.7 },
			nome = "Orbe Arcano",
			icone = "✨",
		},
		habilidade = {
			id = "meteoro",
			nome = "Meteoro",
			icone = "☄️",
			recarga = 9,
			descricao = "Um meteoro cai na mira e deixa o chão em chamas por 3 segundos.",
		},
		supremo = {
			id = "tempestade",
			nome = "Tempestade Arcana",
			icone = "🌩️",
			descricao = "Raios caem sem parar por 5s e deixam os inimigos atingidos lentos.",
		},
	},

	arqueiro = {
		id = "arqueiro",
		nome = "Arqueiro",
		titulo = "O Olho do Bosque",
		icone = "🏹",
		cor = Color3.fromRGB(96, 214, 120),
		descricao = "Rápido e certeiro. Atira sem parar enquanto mantém os inimigos longe.",
		forte = "Maior alcance, muito ágil, dano constante",
		fraco = "Flechas perdem força em inimigos colados",
		notas = { Vida = 3, Dano = 3, Alcance = 5, Velocidade = 4 },

		vida = 100,
		dano = 15,
		velocidade = 20,
		intervalo = 0.32,
		alcance = 60,
		armadura = 0,
		critico = 0.05,

		ataque = {
			tipo = "projetil",
			projetil = "flecha",
			velocidade = 115,
			raio = 0.9,
			explosao = 0,
			combo = { 1, 1, 2 },
			nome = "Flechada",
			icone = "🎯",
		},
		habilidade = {
			id = "chuva",
			nome = "Chuva de Flechas",
			icone = "🌧️",
			recarga = 9,
			descricao = "Salta para trás e faz chover flechas na mira por 3s, deixando os inimigos lentos.",
		},
		supremo = {
			id = "saraivada",
			nome = "Saraivada",
			icone = "💫",
			descricao = "Dispara flechas em todas as direções por 4s, correndo 30% mais rápido.",
		},
	},

	assassino = {
		id = "assassino",
		nome = "Assassino",
		titulo = "A Lâmina na Sombra",
		icone = "🗡️",
		cor = Color3.fromRGB(235, 60, 90),
		descricao = "Duas adagas, muitos críticos e golpes pelas costas. Some e reaparece atrás do alvo.",
		forte = "Mata um alvo de cada vez, críticos e esquiva rápida",
		fraco = "Pouca vida, alcance curtíssimo, quase nada de área",
		notas = { Vida = 2, Dano = 5, Alcance = 1, Velocidade = 5 },

		vida = 85,
		dano = 15,
		velocidade = 21,
		intervalo = 0.26,
		alcance = 7.5,
		armadura = 0,
		critico = 0.15,
		esquivaMult = 0.7,
		ameacaMult = 0.6,

		ataque = {
			tipo = "corte",
			arco = 95,
			combo = { 1, 1, 2.4 },
			costas = 0.5, -- +50% de dano acertando o inimigo pelas costas
			nome = "Dança das Adagas",
			icone = "🗡️",
		},
		habilidade = {
			id = "passoSombrio",
			nome = "Passo Sombrio",
			icone = "🌑",
			recarga = 6,
			descricao = "Some e aparece atrás do inimigo na mira, com um golpe crítico garantido.",
		},
		supremo = {
			id = "laminasNoturnas",
			nome = "Lâminas da Noite",
			icone = "🌙",
			descricao = "Fica intocável e salta de inimigo em inimigo, cortando até 10 vezes.",
		},
	},
}

function Classes.obter(id: string?)
	return Classes.dados[id or ""] or Classes.dados.cavaleiro
end

function Classes.existe(id: any): boolean
	return type(id) == "string" and Classes.dados[id] ~= nil
end

return Classes
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000008">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[-- Configurações do jogo. Quase todo o balanceamento fica aqui: mude os números e teste.

local Config = {}

Config.NOME_DO_JOGO = "Masmorra das Cartas"

-- Partida
Config.MAX_JOGADORES_POR_PARTIDA = 4
Config.CONTAGEM_PORTAL = 10 -- segundos em cima do portal até a partida começar
Config.CONTAGEM_PORTAL_CHEIO = 3 -- contagem quando o grupo já está completo
Config.SALAS_POR_ANDAR = 5 -- a cada 5 salas vem um chefe e o elevador
Config.CHANCE_SALA_TESOURO = 0.15
Config.TEMPO_ESCOLHER_CARTA = 20
Config.TEMPO_ELEVADOR = 25
Config.TEMPO_PORTA_AUTOMATICA = 60

-- Esquiva (todas as classes)
Config.ESQUIVA_RECARGA = 2.2
Config.ESQUIVA_INVULNERAVEL = 0.35
Config.ESQUIVA_VELOCIDADE = 78
Config.ESQUIVA_DURACAO = 0.17

-- Ataque carregado: segure o ataque para carregar e solte para um golpe mais forte
Config.CARGA_ATAQUE_COMECA = 0.3 -- segurando por este tempo, começa a carregar
Config.CARGA_ATAQUE_MIN = 0.3 -- carga mínima para o golpe carregado sair
Config.CARGA_ATAQUE_MAX = 1.2 -- carga cheia (dano máximo e efeito especial)
Config.DANO_CARGA_MIN = 1.6 -- multiplicador de dano com carga mínima
Config.DANO_CARGA_MAX = 3.2 -- multiplicador de dano com carga cheia
Config.VELOCIDADE_CARREGANDO = 0.5 -- anda mais devagar enquanto carrega

-- Supremo: a barra enche causando dano e derrotando inimigos
Config.CARGA_MAXIMA = 100
Config.CARGA_POR_ACERTO = 2.5
Config.CARGA_POR_ABATE = 4

-- Jogador caído: aliados reviram ficando perto
Config.TEMPO_CAIDO = 15
Config.TEMPO_PARA_REVIVER = 3
Config.RAIO_REVIVER = 8
Config.VIDA_AO_REVIVER = 0.4

-- Ouro: quem morre fica só com esta parte. Quem sobe no elevador fica com tudo.
Config.OURO_MANTIDO_AO_MORRER = 0.25

-- Inimigos ficam mais fortes a cada sala e quando há mais jogadores
Config.VIDA_INIMIGO_POR_SALA = 0.14
Config.DANO_INIMIGO_POR_SALA = 0.06
Config.VIDA_INIMIGO_POR_JOGADOR_EXTRA = 0.4

-- Inimigos de elite (mais fortes, com um poder especial, dão mais ouro)
Config.CHANCE_ELITE_BASE = 0.05
Config.CHANCE_ELITE_POR_SALA = 0.012
Config.CHANCE_ELITE_MAXIMA = 0.3

Config.RARIDADES = {
	Comum = { nome = "Comum", cor = Color3.fromRGB(196, 202, 214), peso = 60 },
	Rara = { nome = "Rara", cor = Color3.fromRGB(72, 165, 255), peso = 28 },
	Epica = { nome = "Épica", cor = Color3.fromRGB(190, 100, 255), peso = 10 },
	Lendaria = { nome = "Lendária", cor = Color3.fromRGB(255, 186, 48), peso = 2.5 },
}
Config.ORDEM_RARIDADES = { "Comum", "Rara", "Epica", "Lendaria" }
Config.SORTE_POR_NIVEL = { Comum = -3, Rara = 1.5, Epica = 1, Lendaria = 0.5 }
Config.PESO_EXTRA_CARTA_DE_CLASSE = 1.5 -- cartas da sua classe aparecem mais

Config.MELHORIAS = {
	{ id = "Vida", nome = "Vida Extra", icone = "❤️", descricao = "+15 de vida máxima por nível", precoBase = 40, nivelMax = 10 },
	{ id = "Forca", nome = "Força", icone = "💪", descricao = "+8% de dano por nível", precoBase = 50, nivelMax = 10 },
	{ id = "Sorte", nome = "Sorte", icone = "🍀", descricao = "Cartas raras aparecem mais", precoBase = 75, nivelMax = 5 },
}

function Config.precoMelhoria(melhoria, nivelAtual: number): number
	return math.floor(melhoria.precoBase * (nivelAtual + 1) ^ 1.6)
end

function Config.buscarMelhoria(id)
	for _, melhoria in Config.MELHORIAS do
		if melhoria.id == id then
			return melhoria
		end
	end
	return nil
end

-- Cada andar (5 salas) tem um tema: visual, inimigos e chefe próprios.
-- Depois do último tema, o ciclo recomeça com inimigos mais fortes.
Config.TEMAS = {
	{
		id = "calabouco",
		nome = "Calabouço",
		inimigos = { gosma = 4, esqueleto = 4, esqueletoArqueiro = 2.5, rato = 2 },
		chefe = "reiEsqueleto",
		chao = { material = Enum.Material.Cobblestone, cor = Color3.fromRGB(98, 94, 100) },
		parede = { material = Enum.Material.Brick, cor = Color3.fromRGB(84, 74, 76) },
		detalhe = { material = Enum.Material.Slate, cor = Color3.fromRGB(58, 52, 58) },
		luz = Color3.fromRGB(255, 165, 85),
		ambiente = Color3.fromRGB(62, 52, 62),
		nevoa = Color3.fromRGB(34, 24, 30),
		tinta = Color3.fromRGB(255, 236, 220),
		particulas = "poeira",
		lava = false,
	},
	{
		id = "caverna",
		nome = "Caverna Musgosa",
		inimigos = { kobold = 4, aranha = 3, cogumelo = 2, xama = 2, gosma = 1.5 },
		chefe = "rainhaAranha",
		chao = { material = Enum.Material.Ground, cor = Color3.fromRGB(74, 84, 58) },
		parede = { material = Enum.Material.Rock, cor = Color3.fromRGB(70, 78, 64) },
		detalhe = { material = Enum.Material.Slate, cor = Color3.fromRGB(50, 60, 48) },
		luz = Color3.fromRGB(170, 255, 140),
		ambiente = Color3.fromRGB(44, 66, 50),
		nevoa = Color3.fromRGB(18, 34, 24),
		tinta = Color3.fromRGB(225, 255, 230),
		particulas = "esporos",
		lava = false,
	},
	{
		id = "cripta",
		nome = "Cripta Congelada",
		inimigos = { carnical = 4, espectro = 3, cavaleiroMorto = 1.5, esqueleto = 1.5 },
		chefe = "lich",
		chao = { material = Enum.Material.Slate, cor = Color3.fromRGB(120, 140, 165) },
		parede = { material = Enum.Material.Glacier, cor = Color3.fromRGB(130, 160, 200) },
		detalhe = { material = Enum.Material.Ice, cor = Color3.fromRGB(165, 205, 240) },
		luz = Color3.fromRGB(140, 205, 255),
		ambiente = Color3.fromRGB(70, 86, 118),
		nevoa = Color3.fromRGB(30, 42, 66),
		tinta = Color3.fromRGB(220, 235, 255),
		particulas = "neve",
		lava = false,
	},
	{
		id = "fornalha",
		nome = "Fornalha",
		inimigos = { diabrete = 3.5, elementalFogo = 3, ogro = 1.5, carnical = 1 },
		chefe = "senhorChamas",
		chao = { material = Enum.Material.Basalt, cor = Color3.fromRGB(46, 38, 38) },
		parede = { material = Enum.Material.CrackedLava, cor = Color3.fromRGB(96, 46, 34) },
		detalhe = { material = Enum.Material.Basalt, cor = Color3.fromRGB(30, 24, 24) },
		luz = Color3.fromRGB(255, 120, 60),
		ambiente = Color3.fromRGB(86, 44, 34),
		nevoa = Color3.fromRGB(52, 16, 8),
		tinta = Color3.fromRGB(255, 220, 200),
		particulas = "brasas",
		lava = true,
	},
}

function Config.indiceTema(numeroSala: number): number
	return ((numeroSala - 1) // Config.SALAS_POR_ANDAR) % #Config.TEMAS + 1
end

function Config.temaDaSala(numeroSala: number)
	return Config.TEMAS[Config.indiceTema(numeroSala)]
end

return Config
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX00000009">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX00000010">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX00000011">
        <Properties>
          <string name="Name">Armas</string>
          <ProtectedString name="Source"><![CDATA[-- Armas e acessórios de cada classe, montados com peças e presos às mãos do personagem.
-- (Não usamos Tool: as animações de ataque são feitas por código em Client/Animacoes.)
--
-- Peças com nome fixo que a animação procura:
--   Espada e adagas: "Lamina" com os anexos "TrilhaBase" e "TrilhaPonta" (rastro do golpe)
--   (o Assassino tem uma segunda adaga, "ArmaSecundaria", na mão esquerda)
--   Cajado: "Haste" com o anexo "Ponta" (brilho do cristal)
--   Arco:   "Arco" com os anexos "CordaCima", "CordaBaixo" e "Encaixe" (corda que estica)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Classes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Classes"))

local Armas = {}

local OURO = Color3.fromRGB(232, 186, 82)
local COURO = Color3.fromRGB(92, 58, 34)
local MADEIRA = Color3.fromRGB(96, 64, 40)
local EM_PE = CFrame.Angles(0, 0, math.rad(90)) -- deixa um cilindro em pé

local function novaPeca(nome: string, tamanho: Vector3, cor: Color3, material: Enum.Material, formato: Enum.PartType?): Part
	local parte = Instance.new("Part")
	parte.Name = nome
	parte.Shape = formato or Enum.PartType.Block
	parte.Size = tamanho
	parte.Color = cor
	parte.Material = material
	parte.CanCollide = false
	parte.CanQuery = false
	parte.CanTouch = false
	parte.Massless = true
	parte.CastShadow = false
	parte.TopSurface = Enum.SurfaceType.Smooth
	parte.BottomSurface = Enum.SurfaceType.Smooth
	return parte
end

-- Prende uma peça a outra, na posição relativa indicada
local function prender(base: BasePart, parte: BasePart, deslocamento: CFrame, pai: Instance): BasePart
	parte.CFrame = base.CFrame * deslocamento
	local solda = Instance.new("WeldConstraint")
	solda.Part0 = base
	solda.Part1 = parte
	solda.Parent = parte
	parte.Parent = pai
	return parte
end

local function anexo(pai: BasePart, nome: string, posicao: Vector3)
	local a = Instance.new("Attachment")
	a.Name = nome
	a.Position = posicao
	a.Parent = pai
	return a
end

local function brilho(parte: BasePart, cor: Color3, alcance: number, intensidade: number)
	local luz = Instance.new("PointLight")
	luz.Color = cor
	luz.Range = alcance
	luz.Brightness = intensidade
	luz.Parent = parte
end

local function segmento(base: BasePart, pai: Instance, nome: string, a: Vector3, b: Vector3, espessura: number, cor: Color3, material: Enum.Material)
	local parte = novaPeca(nome, Vector3.new(espessura, espessura, (b - a).Magnitude), cor, material)
	return prender(base, parte, CFrame.lookAt((a + b) / 2, b), pai)
end

------------------------------------------------------------------------
-- Construção (cada arma é montada na origem; depois é movida para a mão ou o altar)
------------------------------------------------------------------------

-- Espada: a lâmina vai na direção +Z e a mão segura em z = -1.6
local function construirEspada(cor: Color3): (Model, BasePart, CFrame)
	local modelo = Instance.new("Model")
	modelo.Name = "Espada"
	local lamina = novaPeca("Lamina", Vector3.new(0.32, 0.16, 4.4), Color3.fromRGB(214, 222, 236), Enum.Material.Metal)
	lamina.CFrame = CFrame.new()
	lamina.Parent = modelo
	prender(lamina, novaPeca("Sulco", Vector3.new(0.08, 0.18, 2.9), cor, Enum.Material.Neon), CFrame.new(0, 0, 0.55), modelo)
	prender(lamina, novaPeca("Guarda", Vector3.new(1.6, 0.3, 0.34), OURO, Enum.Material.Metal), CFrame.new(0, 0, -1.15), modelo)
	prender(lamina, novaPeca("Cabo", Vector3.new(0.36, 0.36, 1.05), COURO, Enum.Material.Fabric), CFrame.new(0, 0, -1.75), modelo)
	prender(lamina, novaPeca("Pomo", Vector3.one * 0.5, OURO, Enum.Material.Metal, Enum.PartType.Ball), CFrame.new(0, 0, -2.35), modelo)
	anexo(lamina, "TrilhaBase", Vector3.new(0, 0, -0.6))
	anexo(lamina, "TrilhaPonta", Vector3.new(0, 0, 2.2))
	modelo.PrimaryPart = lamina
	-- na mão: lâmina para frente e um pouco para baixo
	local naMao = CFrame.Angles(math.rad(-20), 0, 0) * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, 0, 1.6)
	return modelo, lamina, naMao
end

-- Cajado: em pé (eixo Y), a mão segura em y = -1.2
local function construirCajado(cor: Color3): (Model, BasePart, CFrame)
	local modelo = Instance.new("Model")
	modelo.Name = "Cajado"
	local haste = novaPeca("Haste", Vector3.new(0.3, 6.4, 0.3), MADEIRA, Enum.Material.Wood)
	haste.CFrame = CFrame.new()
	haste.Parent = modelo
	prender(haste, novaPeca("Ponteira", Vector3.new(0.4, 0.4, 0.4), OURO, Enum.Material.Metal), CFrame.new(0, -3.2, 0), modelo)
	prender(haste, novaPeca("Garra", Vector3.new(0.9, 0.25, 0.25), OURO, Enum.Material.Metal), CFrame.new(0, 3.05, 0), modelo)
	prender(haste, novaPeca("Garra2", Vector3.new(0.25, 0.25, 0.9), OURO, Enum.Material.Metal), CFrame.new(0, 3.05, 0), modelo)
	local cristal = prender(haste, novaPeca("Cristal", Vector3.new(0.75, 1.2, 0.75), cor, Enum.Material.Neon), CFrame.new(0, 3.75, 0) * CFrame.Angles(0, math.rad(45), 0), modelo)
	local anel = novaPeca("Anel", Vector3.new(0.12, 1.7, 1.7), OURO, Enum.Material.Metal, Enum.PartType.Cylinder)
	prender(haste, anel, CFrame.new(0, 3.75, 0) * CFrame.Angles(math.rad(70), 0, 0), modelo)
	brilho(cristal, cor, 12, 2)
	anexo(haste, "Ponta", Vector3.new(0, 3.75, 0))
	modelo.PrimaryPart = haste
	return modelo, haste, CFrame.new(0, 1.2, 0)
end

-- Arco: em pé (eixo Y); os braços curvam para +Z (para quem segura). A corda é desenhada
-- no computador de cada jogador, para poder esticar na animação.
local function construirArco(cor: Color3): (Model, BasePart, CFrame)
	local modelo = Instance.new("Model")
	modelo.Name = "Arco"
	local empunhadura = novaPeca("Arco", Vector3.new(0.34, 1, 0.34), COURO, Enum.Material.Fabric)
	empunhadura.CFrame = CFrame.new()
	empunhadura.Parent = modelo
	local pontos = { Vector3.new(0, 0.5, 0), Vector3.new(0, 1.5, 0.18), Vector3.new(0, 2.35, 0.6) }
	for lado = -1, 1, 2 do
		for i = 1, #pontos - 1 do
			local a = Vector3.new(0, pontos[i].Y * lado, pontos[i].Z)
			local b = Vector3.new(0, pontos[i + 1].Y * lado, pontos[i + 1].Z)
			segmento(empunhadura, modelo, "Braco", a, b, 0.26, MADEIRA, Enum.Material.Wood)
		end
		prender(empunhadura, novaPeca("Ponta", Vector3.one * 0.32, OURO, Enum.Material.Metal), CFrame.new(0, 2.35 * lado, 0.6), modelo)
	end
	prender(empunhadura, novaPeca("Gema", Vector3.one * 0.3, cor, Enum.Material.Neon, Enum.PartType.Ball), CFrame.new(0, 0, -0.2), modelo)
	anexo(empunhadura, "CordaCima", Vector3.new(0, 2.32, 0.62))
	anexo(empunhadura, "CordaBaixo", Vector3.new(0, -2.32, 0.62))
	anexo(empunhadura, "Encaixe", Vector3.new(0, 0, 0.62))
	modelo.PrimaryPart = empunhadura
	-- na mão esquerda: fica em pé quando o braço aponta para frente
	return modelo, empunhadura, CFrame.Angles(math.rad(-90), 0, 0)
end

-- Adaga: como a espada, mas curta; a mão segura em z = -1.25
local function construirAdaga(cor: Color3): (Model, BasePart, CFrame)
	local modelo = Instance.new("Model")
	modelo.Name = "Adaga"
	local lamina = novaPeca("Lamina", Vector3.new(0.26, 0.1, 1.9), Color3.fromRGB(70, 70, 82), Enum.Material.Metal)
	lamina.CFrame = CFrame.new()
	lamina.Parent = modelo
	prender(lamina, novaPeca("Fio", Vector3.new(0.06, 0.12, 1.5), cor, Enum.Material.Neon), CFrame.new(0, 0, 0.1), modelo)
	prender(lamina, novaPeca("Guarda", Vector3.new(0.9, 0.18, 0.18), Color3.fromRGB(40, 36, 46), Enum.Material.Metal), CFrame.new(0, 0, -0.98), modelo)
	prender(lamina, novaPeca("Cabo", Vector3.new(0.26, 0.26, 0.7), Color3.fromRGB(34, 30, 38), Enum.Material.Fabric), CFrame.new(0, 0, -1.35), modelo)
	prender(lamina, novaPeca("Pomo", Vector3.one * 0.3, cor, Enum.Material.Neon, Enum.PartType.Ball), CFrame.new(0, 0, -1.75), modelo)
	anexo(lamina, "TrilhaBase", Vector3.new(0, 0, -0.5))
	anexo(lamina, "TrilhaPonta", Vector3.new(0, 0, 0.95))
	modelo.PrimaryPart = lamina
	local naMao = CFrame.Angles(math.rad(-30), 0, 0) * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, 0, 1.3)
	return modelo, lamina, naMao
end

local function construir(classe: string): (Model, BasePart, CFrame)
	local dados = Classes.obter(classe)
	if dados.id == "mago" then
		return construirCajado(dados.cor)
	elseif dados.id == "arqueiro" then
		return construirArco(dados.cor)
	elseif dados.id == "assassino" then
		return construirAdaga(dados.cor)
	end
	return construirEspada(dados.cor)
end

------------------------------------------------------------------------
-- Uso
------------------------------------------------------------------------

local function parteDoCorpo(personagem: Model, nomes: { string }): BasePart?
	for _, nome in nomes do
		local parte = personagem:FindFirstChild(nome)
		if parte and parte:IsA("BasePart") then
			return parte
		end
	end
	return nil
end

-- Ponto onde a mão segura (R15: centro da mão; R6: ponta do braço)
local function pegada(mao: BasePart): CFrame
	if mao.Name == "Right Arm" or mao.Name == "Left Arm" then
		return mao.CFrame * CFrame.new(0, -1, 0)
	end
	return mao.CFrame * CFrame.new(0, -0.15, 0)
end

-- Modelo parado para exibir num altar
function Armas.modeloExibicao(classe: string): Model
	local modelo = construir(classe)
	for _, peca in modelo:GetDescendants() do
		if peca:IsA("BasePart") then
			peca.Anchored = true
		end
	end
	return modelo
end

-- Coloca a arma na mão e os acessórios da classe no corpo
function Armas.vestir(personagem: Model, classe: string)
	local antigo = personagem:FindFirstChild("AcessoriosDeClasse")
	if antigo then
		antigo:Destroy()
	end
	local pasta = Instance.new("Model")
	pasta.Name = "AcessoriosDeClasse"
	local dados = Classes.obter(classe)

	-- Arma (o arqueiro segura o arco na mão esquerda)
	local nomesMao = if dados.id == "arqueiro" then { "LeftHand", "Left Arm" } else { "RightHand", "Right Arm" }
	local mao = parteDoCorpo(personagem, nomesMao)
	if mao then
		local arma, base, naMao = construir(classe)
		arma.Name = "ArmaDeClasse"
		arma:PivotTo(pegada(mao) * naMao)
		local solda = Instance.new("WeldConstraint")
		solda.Part0 = mao
		solda.Part1 = base
		solda.Parent = base
		arma.Parent = pasta
	end
	-- Assassino: segunda adaga na mão esquerda
	if dados.id == "assassino" then
		local maoEsquerda = parteDoCorpo(personagem, { "LeftHand", "Left Arm" })
		if maoEsquerda then
			local adaga, base, naMao = construirAdaga(dados.cor)
			adaga.Name = "ArmaSecundaria"
			adaga:PivotTo(pegada(maoEsquerda) * naMao)
			local solda = Instance.new("WeldConstraint")
			solda.Part0 = maoEsquerda
			solda.Part1 = base
			solda.Parent = base
			adaga.Parent = pasta
		end
	end

	local tronco = parteDoCorpo(personagem, { "UpperTorso", "Torso" })
	if dados.id == "cavaleiro" then
		local braco = parteDoCorpo(personagem, { "LeftLowerArm", "Left Arm" })
		if braco then
			local desloc = if braco.Name == "Left Arm" then CFrame.new(-0.62, -0.3, 0) else CFrame.new(-0.6, 0, 0)
			local escudo = prender(braco, novaPeca("Escudo", Vector3.new(0.3, 2.9, 2.3), Color3.fromRGB(46, 78, 150), Enum.Material.Metal), desloc, pasta)
			prender(escudo, novaPeca("Borda", Vector3.new(0.36, 0.22, 2.4), OURO, Enum.Material.Metal), CFrame.new(0, 1.42, 0), pasta)
			prender(escudo, novaPeca("Borda", Vector3.new(0.36, 0.22, 2.4), OURO, Enum.Material.Metal), CFrame.new(0, -1.42, 0), pasta)
			prender(escudo, novaPeca("Borda", Vector3.new(0.36, 3, 0.22), OURO, Enum.Material.Metal), CFrame.new(0, 0, 1.12), pasta)
			prender(escudo, novaPeca("Borda", Vector3.new(0.36, 3, 0.22), OURO, Enum.Material.Metal), CFrame.new(0, 0, -1.12), pasta)
			prender(escudo, novaPeca("Emblema", Vector3.new(0.34, 1.6, 0.26), dados.cor, Enum.Material.Neon), CFrame.new(-0.03, 0, 0), pasta)
			prender(escudo, novaPeca("Emblema", Vector3.new(0.34, 0.26, 1.2), dados.cor, Enum.Material.Neon), CFrame.new(-0.03, 0.25, 0), pasta)
		end
	elseif dados.id == "mago" and tronco then
		for lado = -1, 1, 2 do
			local ombro = prender(tronco, novaPeca("Ombreira", Vector3.new(1.1, 0.5, 1.2), Color3.fromRGB(70, 40, 110), Enum.Material.Fabric), CFrame.new(lado * 1.05, 0.75, 0), pasta)
			prender(ombro, novaPeca("Gema", Vector3.one * 0.32, dados.cor, Enum.Material.Neon), CFrame.new(0, 0.3, -0.45), pasta)
		end
	elseif dados.id == "arqueiro" and tronco then
		local aljava = prender(
			tronco,
			novaPeca("Aljava", Vector3.new(2.3, 0.75, 0.75), COURO, Enum.Material.Fabric, Enum.PartType.Cylinder),
			CFrame.new(0.35, 0.2, 0.75) * EM_PE * CFrame.Angles(math.rad(-20), 0, 0),
			pasta
		)
		for i = -1, 1 do
			prender(aljava, novaPeca("Pena", Vector3.new(0.5, 0.12, 0.35), dados.cor, Enum.Material.Neon), CFrame.new(1.35, i * 0.18, 0), pasta)
		end
	elseif dados.id == "assassino" and tronco then
		local escuro = Color3.fromRGB(30, 26, 36)
		-- cachecol com a ponta voando para trás
		local cachecol = prender(tronco, novaPeca("Cachecol", Vector3.new(1.7, 0.45, 1.15), dados.cor:Lerp(escuro, 0.35), Enum.Material.Fabric), CFrame.new(0, 0.85, 0), pasta)
		prender(cachecol, novaPeca("PontaCachecol", Vector3.new(0.45, 0.1, 1.6), dados.cor:Lerp(escuro, 0.35), Enum.Material.Fabric), CFrame.new(0.35, -0.1, 1.1) * CFrame.Angles(math.rad(-25), 0, 0), pasta)
		-- cinto com facas de reserva
		local cinto = prender(tronco, novaPeca("Cinto", Vector3.new(2.05, 0.3, 1.1), escuro, Enum.Material.Fabric), CFrame.new(0, -0.85, 0), pasta)
		for i = -1, 1 do
			prender(cinto, novaPeca("Faca", Vector3.new(0.12, 0.6, 0.18), Color3.fromRGB(200, 200, 210), Enum.Material.Metal), CFrame.new(i * 0.3, -0.15, 0.58) * CFrame.Angles(0, 0, math.rad(i * 12)), pasta)
		end
	end
	pasta.Parent = personagem
end

return Armas
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000012">
        <Properties>
          <string name="Name">Combate</string>
          <ProtectedString name="Source"><![CDATA[-- Combate: atributos, combos, habilidades, supremos, esquiva, dano e jogador caído.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local Cartas = require(Shared:WaitForChild("Cartas"))

local servidor = script.Parent
local Remotos = require(servidor.Remotos)
local Vfx = require(servidor.Vfx)
local Projeteis = require(servidor.Projeteis)
local Masmorra = require(servidor.Masmorra)
local Armas = require(servidor.Armas)

local Combate = {}

local COR_FOGO = Color3.fromRGB(255, 130, 40)
local COR_RAIO = Color3.fromRGB(255, 236, 110)
local COR_OURO = Color3.fromRGB(255, 205, 90)

local function planar(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function humanoidDe(estado): Humanoid?
	local personagem = estado.player.Character
	return personagem and personagem:FindFirstChildOfClass("Humanoid")
end
Combate.humanoidDe = humanoidDe

local function raizDe(estado): BasePart?
	local personagem = estado.player.Character
	return personagem and personagem:FindFirstChild("HumanoidRootPart") :: BasePart?
end
Combate.raizDe = raizDe

local function noChao(run, pos: Vector3): Vector3
	local y = if run.sala then run.sala.origem.Y else pos.Y
	return Vector3.new(pos.X, y, pos.Z)
end

local function inimigosVivos(run)
	local lista = {}
	for inimigo in run.inimigos do
		if inimigo.vivo then
			table.insert(lista, inimigo)
		end
	end
	return lista
end
Combate.inimigosVivos = inimigosVivos

------------------------------------------------------------------------
-- Atributos
------------------------------------------------------------------------

local function somarEfeitos(cartas)
	local soma = {}
	for id, quantidade in cartas do
		local carta = Cartas.porId[id]
		if carta and quantidade > 0 then
			for efeito, valor in carta.efeitos do
				soma[efeito] = (soma[efeito] or 0) + valor * quantidade
			end
		end
	end
	return soma
end

function Combate.calcularStats(estado)
	local classe = Classes.obter(estado.classe)
	local soma = somarEfeitos(estado.cartas)
	local function e(nome: string): number
		return soma[nome] or 0
	end
	local melhorias = estado.perfil.Melhorias

	estado.stats = {
		vidaMax = math.max(25, classe.vida + (melhorias.Vida or 0) * 15 + e("vidaPlana") + e("gigante") * 50),
		dano = classe.dano * (1 + (melhorias.Forca or 0) * 0.08) * (1 + e("danoPct")),
		velocidade = classe.velocidade * (1 + e("velocidadePct")) * (0.92 ^ e("gigante")),
		intervalo = classe.intervalo / (1 + e("ataqueVelPct")),
		alcance = classe.alcance * (1 + e("alcancePct")) * (1 + 0.2 * e("gigante")),
		critico = math.min((classe.critico or 0) + e("critico"), 0.75),
		multCritico = 3 + e("multCritico"),
		rouboVida = e("rouboVida"),
		regen = e("regen"),
		multOuro = (1 + e("ouroPct")) * (if e("ouroMult") > 0 then 2 else 1),
		armadura = math.min(classe.armadura + e("armadura"), 0.6),
		espinhos = e("espinhos"),
		escudo = e("escudo") > 0,
		investida = e("investida"),
		ondaCorte = e("ondaCorte"),
		redemoinhoFogo = e("redemoinhoFogo") > 0,
		escala = 1 + 0.3 * e("gigante"),
		dragao = e("dragao"),
		protetor = e("protetor") > 0,
		tamanho = 1 + e("tamanhoPct"),
		explosao = (classe.ataque.explosao or 0) * (1 + e("explosaoPct")),
		projeteis = 1 + e("projeteisExtra"),
		lentidao = if e("lentidao") > 0 then math.min(0.35 + 0.1 * (e("lentidao") - 1), 0.6) else 0,
		raios = e("raios"),
		meteoros = 1 + e("meteoros"),
		perfuracao = e("perfuracao"),
		explosaoMorte = e("explosaoMorte"),
		arquimago = e("arquimago") > 0,
		queimadura = e("queimadura"),
		velProjetil = (classe.ataque.velocidade or 0) * (1 + e("velProjPct")),
		ricochete = e("ricochete"),
		chuva = 1 + e("chuvaPct"),
		fantasma = e("fantasma") > 0,
		recarga = classe.habilidade.recarga * (1 - math.min(e("recargaPct"), 0.6)),
		recargaEsquiva = Config.ESQUIVA_RECARGA * (classe.esquivaMult or 1) * (1 - math.min(e("esquivaPct"), 0.6)),
		multCarga = 1 + e("cargaPct"),
		-- Assassino
		costas = (classe.ataque.costas or 0) + e("costasPct"),
		curaCritico = e("curaCritico"),
		leque = e("leque"),
		contraAtaque = e("contraAtaque") > 0,
		execucao = e("execucao") > 0,
		milCortes = e("milCortes") > 0,
	}
	return estado.stats
end

-- O jogador precisa destes números para mostrar recargas e prever o próprio ataque
function Combate.enviarStats(estado)
	local stats = estado.stats
	local classe = Classes.obter(estado.classe)
	Remotos.enviar(estado.player, "stats", {
		classe = classe.id,
		intervalo = stats.intervalo,
		recarga = stats.recarga,
		recargaEsquiva = stats.recargaEsquiva,
		alcance = stats.alcance,
		arco = classe.ataque.arco,
		carga = estado.carga,
		cargaMax = Config.CARGA_MAXIMA,
	})
end

function Combate.aplicarVelocidade(estado)
	local humanoid = humanoidDe(estado)
	if not humanoid then
		return
	end
	if estado.caido then
		humanoid.WalkSpeed = 0
		return
	end
	local fator = if os.clock() < (estado.lentoAte or 0) then estado.lentoFator or 1 else 1
	if estado.carregandoDesde then
		fator *= Config.VELOCIDADE_CARREGANDO
	end
	if os.clock() < (estado.rapidoAte or 0) then
		fator *= 1.3
	end
	humanoid.WalkSpeed = estado.stats.velocidade * fator
end

function Combate.aplicarStats(estado, curarTudo: boolean?)
	local personagem = estado.player.Character
	local humanoid = humanoidDe(estado)
	if not personagem or not humanoid or humanoid.Health <= 0 then
		return
	end
	local stats = estado.stats
	local maximoAntigo = humanoid.MaxHealth
	humanoid.MaxHealth = stats.vidaMax
	if curarTudo then
		humanoid.Health = stats.vidaMax
	elseif stats.vidaMax > maximoAntigo then
		humanoid.Health = math.min(humanoid.Health + (stats.vidaMax - maximoAntigo), stats.vidaMax)
	end
	Combate.aplicarVelocidade(estado)
	if math.abs(personagem:GetScale() - stats.escala) > 0.01 then
		pcall(function()
			personagem:ScaleTo(stats.escala)
		end)
	end
end

function Combate.equipar(estado)
	local personagem = estado.player.Character
	if personagem then
		Armas.vestir(personagem, estado.classe)
	end
end

-- Avisa os jogadores para tocarem uma animação no personagem (feita em Client/Animacoes).
-- "exceto" é quem já tocou a animação no próprio computador, na hora do clique.
local function animar(run, estado, acao: string, dados, exceto: Player?)
	dados = dados or {}
	dados.jogador = estado.player
	dados.acao = acao
	dados.classe = estado.classe
	Vfx.partida(run, "anim", dados, exceto)
end

local function podeAgir(run, estado): boolean
	return run.ativa and estado.vivo and not estado.caido and raizDe(estado) ~= nil
end

local function direcaoValida(direcao: any, raiz: BasePart): Vector3
	if typeof(direcao) == "Vector3" then
		local plano = planar(direcao)
		local tamanho = plano.Magnitude
		if tamanho > 0.01 and tamanho < 1e6 then
			return plano / tamanho
		end
	end
	return planar(raiz.CFrame.LookVector).Unit
end

------------------------------------------------------------------------
-- Supremo (barra de carga)
------------------------------------------------------------------------

function Combate.adicionarCarga(estado, valor: number)
	if estado.carga >= Config.CARGA_MAXIMA then
		return
	end
	estado.carga = math.min(Config.CARGA_MAXIMA, estado.carga + valor * estado.stats.multCarga)
	if estado.carga >= Config.CARGA_MAXIMA or estado.carga - (estado.cargaEnviada or 0) >= 3 then
		estado.cargaEnviada = estado.carga
		Remotos.enviar(estado.player, "carga", { valor = estado.carga, max = Config.CARGA_MAXIMA })
	end
end

------------------------------------------------------------------------
-- Dano em inimigos
------------------------------------------------------------------------

local function queimar(inimigo, danoPorSegundo: number, estado)
	inimigo.queimaAte = os.clock() + 3
	inimigo.queimaDps = math.max(inimigo.queimaDps or 0, danoPorSegundo)
	inimigo.queimaFonte = estado
	inimigo.modelo:SetAttribute("Queimando", true)
end

local function desacelerar(inimigo, fator: number, duracao: number)
	inimigo.lentoAte = os.clock() + duracao
	inimigo.lentoFator = math.min(inimigo.lentoFator or 1, fator)
	inimigo.modelo:SetAttribute("Lento", true)
end

function Combate.atordoar(inimigo, duracao: number)
	if inimigo.chefe then
		duracao *= 0.35
	end
	inimigo.atordoadoAte = math.max(inimigo.atordoadoAte or 0, os.clock() + duracao)
	inimigo.modelo:SetAttribute("Atordoado", true)
end

local function correnteEletrica(run, origem, estado, quantidade: number, dano: number)
	local candidatos = {}
	for _, outro in inimigosVivos(run) do
		if outro ~= origem then
			local distancia = (outro.raiz.Position - origem.raiz.Position).Magnitude
			if distancia <= 18 then
				table.insert(candidatos, { inimigo = outro, distancia = distancia })
			end
		end
	end
	table.sort(candidatos, function(a, b)
		return a.distancia < b.distancia
	end)
	for i = 1, math.min(quantidade, #candidatos) do
		local alvo = candidatos[i].inimigo
		Vfx.partida(run, "raio", { de = origem.raiz.Position, ate = alvo.raiz.Position })
		Combate.danoAoInimigo(run, alvo, dano, estado, { semEfeitos = true, cor = COR_RAIO })
	end
end

--[[ opcoes: critico, principal (ataque básico), empurrar (Vector3), semEfeitos,
	queimar, lento (fator), cor, exceto ]]
function Combate.danoAoInimigo(run, inimigo, dano: number, estado, opcoes)
	if not inimigo.vivo then
		return
	end
	opcoes = opcoes or {}
	dano = math.max(1, math.floor(dano * (1 - (inimigo.armadura or 0)) + 0.5))
	-- Carta Execução: golpes acabam com quem está quase morto (chefes só levam o dobro)
	if estado and opcoes.principal and estado.stats.execucao then
		if inimigo.chefe then
			if inimigo.vida <= inimigo.vidaMax * 0.2 then
				dano *= 2
			end
		elseif inimigo.vida - dano <= inimigo.vidaMax * 0.2 then
			dano = math.max(dano, math.ceil(inimigo.vida))
			opcoes.cor = opcoes.cor or Color3.fromRGB(255, 60, 90)
		end
	end
	inimigo.vida -= dano
	inimigo.modelo:SetAttribute("Vida", math.max(0, inimigo.vida))

	if estado then
		-- Ameaça: os inimigos preferem atacar quem causa mais dano (o Cavaleiro chama o dobro de atenção)
		inimigo.ameaca[estado] = (inimigo.ameaca[estado] or 0) + dano * (Classes.obter(estado.classe).ameacaMult or 1)
		estado.danoCausado += dano
	end

	Vfx.partida(run, "dano", {
		pos = inimigo.raiz.Position + Vector3.new(0, inimigo.alturaBarra, 0),
		impacto = inimigo.raiz.Position,
		valor = dano,
		critico = opcoes.critico == true,
		cor = opcoes.cor,
		autor = estado and estado.player,
	})

	if opcoes.empurrar and not inimigo.pesado and inimigo.vida > 0 then
		inimigo.raiz.AssemblyLinearVelocity = opcoes.empurrar + Vector3.new(0, 10, 0)
	end

	if estado and not opcoes.semEfeitos then
		local stats = estado.stats
		if stats.rouboVida > 0 then
			Combate.curar(run, estado, stats.rouboVida, true)
		end
		if stats.lentidao > 0 then
			desacelerar(inimigo, 1 - stats.lentidao, 2)
		end
		if stats.queimadura > 0 then
			queimar(inimigo, stats.dano * stats.queimadura, estado)
		end
		if stats.raios > 0 and opcoes.principal then
			correnteEletrica(run, inimigo, estado, stats.raios, stats.dano * 0.5)
		end
		if opcoes.critico then
			if stats.curaCritico > 0 then
				Combate.curar(run, estado, stats.curaCritico, true)
			end
			if stats.milCortes then
				Combate.reduzirRecarga(estado, 0.5)
			end
		end
		Combate.adicionarCarga(estado, Config.CARGA_POR_ACERTO)
	end
	if opcoes.queimar and estado then
		queimar(inimigo, estado.stats.dano * 0.3, estado)
	end
	if opcoes.lento then
		desacelerar(inimigo, opcoes.lento, 2)
	end

	if inimigo.vida <= 0 then
		run:aoMorrerInimigo(inimigo, estado)
	end
end

function Combate.danoEmArea(run, centro: Vector3, raio: number, dano: number, estado, opcoes)
	opcoes = opcoes or {}
	for _, inimigo in inimigosVivos(run) do
		if inimigo ~= opcoes.exceto and planar(inimigo.raiz.Position - centro).Magnitude <= raio + inimigo.raio then
			local opcoesDeste = table.clone(opcoes)
			if opcoes.empurrarForca then
				local fora = planar(inimigo.raiz.Position - centro)
				if fora.Magnitude > 0.1 then
					opcoesDeste.empurrar = fora.Unit * opcoes.empurrarForca
				end
			end
			Combate.danoAoInimigo(run, inimigo, dano, estado, opcoesDeste)
		end
	end
end

------------------------------------------------------------------------
-- Cura, dano em jogadores, caído e reviver
------------------------------------------------------------------------

function Combate.curar(run, estado, quantidade: number, silencioso: boolean?)
	local humanoid = humanoidDe(estado)
	if not humanoid or humanoid.Health <= 0 or estado.caido then
		return
	end
	local antes = humanoid.Health
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + quantidade)
	local curado = humanoid.Health - antes
	if not silencioso and curado >= 1 then
		Vfx.partida(run, "cura", { jogador = estado.player, valor = math.floor(curado + 0.5) })
	end
end

local function definirCaidoNoPersonagem(estado, caido: boolean)
	local personagem = estado.player.Character
	if personagem then
		personagem:SetAttribute("Caido", caido)
		personagem:SetAttribute("Reviver", 0)
		personagem:SetAttribute("CaidoRestante", if caido then Config.TEMPO_CAIDO else 0)
	end
end

-- Termina de morrer (o tempo de caído acabou ou não há ninguém para reviver)
function Combate.morrerDeVez(run, estado)
	estado.caido = false
	definirCaidoNoPersonagem(estado, false)
	local humanoid = humanoidDe(estado)
	if humanoid then
		humanoid.Sit = false
		humanoid.Health = 0
	end
end

local function contarAtivos(run, exceto)
	local total = 0
	for _, outro in run.jogadores do
		if outro ~= exceto and outro.vivo and not outro.caido then
			total += 1
		end
	end
	return total
end

function Combate.derrubar(run, estado)
	local humanoid = humanoidDe(estado)
	if not humanoid then
		return
	end
	-- Sozinho (ou sem ninguém de pé) não há quem reviva: cai de vez
	if contarAtivos(run, estado) == 0 then
		Combate.morrerDeVez(run, estado)
		return
	end
	estado.caido = true
	estado.caidoAte = os.clock() + Config.TEMPO_CAIDO
	estado.progressoReviver = 0
	humanoid.Health = 1
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0
	estado.carregandoDesde = nil
	humanoid.Sit = true
	Combate.aplicarVelocidade(estado)
	definirCaidoNoPersonagem(estado, true)
	Vfx.partida(run, "caiu", { jogador = estado.player })
	Remotos.enviar(estado.player, "caiu", { tempo = Config.TEMPO_CAIDO })
	run:anunciar("💀 " .. estado.player.DisplayName .. " caiu! Fique perto para reviver.", Color3.fromRGB(255, 110, 110))
end

function Combate.levantar(run, estado, fracaoVida: number)
	local humanoid = humanoidDe(estado)
	estado.caido = false
	definirCaidoNoPersonagem(estado, false)
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	humanoid.Sit = false
	humanoid.JumpPower = 50
	humanoid.Health = math.max(1, humanoid.MaxHealth * fracaoVida)
	estado.invulneravelAte = os.clock() + 1.5
	Combate.aplicarVelocidade(estado)
	Vfx.partida(run, "reviver", { jogador = estado.player })
	Remotos.enviar(estado.player, "levantou", {})
end

--[[ opcoes: ambiente (lava: ignora escudo e espinhos), lento = {fator, duracao}, queimar (dano/s) ]]
function Combate.danoAoJogador(run, estado, dano: number, fonte, opcoes)
	if not estado.vivo or estado.caido then
		return
	end
	local humanoid = humanoidDe(estado)
	local raiz = raizDe(estado)
	if not humanoid or not raiz or humanoid.Health <= 0 then
		return
	end
	opcoes = opcoes or {}
	local agora = os.clock()
	if agora < (estado.invulneravelAte or 0) then
		return
	end

	-- Aura do Protetor de um aliado próximo
	for _, outro in run.jogadores do
		if outro ~= estado and outro.vivo and not outro.caido and outro.stats.protetor then
			local raizOutro = raizDe(outro)
			if raizOutro and planar(raizOutro.Position - raiz.Position).Magnitude <= 18 then
				dano *= 0.7
				break
			end
		end
	end
	if agora < (estado.resistenteAte or 0) then
		dano *= 0.6
	end
	dano = math.max(1, math.floor(dano * (1 - estado.stats.armadura) + 0.5))

	if estado.escudoAtivo and not opcoes.ambiente then
		estado.escudoAtivo = false
		Vfx.partida(run, "bloqueio", { jogador = estado.player })
		return
	end

	if fonte and fonte.vivo and estado.stats.espinhos > 0 and not opcoes.ambiente then
		Combate.danoAoInimigo(run, fonte, dano * estado.stats.espinhos, estado, { semEfeitos = true, cor = Color3.fromRGB(140, 255, 120) })
	end

	if dano >= humanoid.Health then
		if (estado.cartas.segunda or 0) > 0 then
			estado.cartas.segunda -= 1
			humanoid.Health = humanoid.MaxHealth * 0.5
			estado.invulneravelAte = agora + 2
			Vfx.partida(run, "segundaChance", { jogador = estado.player })
			run:anunciar("👼 " .. estado.player.DisplayName .. " usou a Segunda Chance!", COR_OURO)
			Remotos.enviar(estado.player, "minhasCartas", { cartas = estado.cartas })
			return
		end
		Combate.derrubar(run, estado)
		return
	end

	humanoid:TakeDamage(dano)
	Vfx.partida(run, "danoJogador", { jogador = estado.player, valor = dano })

	if opcoes.lento then
		estado.lentoAte = agora + (opcoes.lento.duracao or 2)
		estado.lentoFator = opcoes.lento.fator or 0.6
		Combate.aplicarVelocidade(estado)
	end
	if opcoes.queimar then
		estado.queimaAte = agora + 3
		estado.queimaDps = opcoes.queimar
	end
end

------------------------------------------------------------------------
-- Ataque básico (combo de 3)
------------------------------------------------------------------------

local COR_COSTAS = Color3.fromRGB(255, 70, 110)

-- O atacante está atrás do inimigo? (o inimigo olha para o outro lado)
local function pelasCostas(inimigo, origem: Vector3): boolean
	local paraAtacante = planar(origem - inimigo.raiz.Position)
	local olhar = planar(inimigo.raiz.CFrame.LookVector)
	if paraAtacante.Magnitude < 0.1 or olhar.Magnitude < 0.1 then
		return false
	end
	return paraAtacante.Unit:Dot(olhar.Unit) < -0.25
end

local laminasNoturnas

local function golpeDeEspada(run, estado, classe, raiz: BasePart, direcao: Vector3, mult: number, final: boolean)
	local stats = estado.stats
	local arco = classe.ataque.arco * (if final then 1.25 else 1)
	local alcance = stats.alcance * (if final then 1.15 else 1)
	-- quem atacou já desenhou o próprio corte; os outros recebem aqui
	Vfx.partida(run, "corte", {
		jogador = estado.player,
		pos = raiz.Position,
		dir = direcao,
		alcance = alcance,
		arco = arco,
		cor = classe.cor,
		combo = estado.combo,
	}, estado.player)

	local limite = math.cos(math.rad(arco / 2))
	local alvos = {}
	for _, inimigo in inimigosVivos(run) do
		local delta = planar(inimigo.raiz.Position - raiz.Position)
		local distancia = delta.Magnitude
		if distancia <= alcance + inimigo.raio then
			if distancia < inimigo.raio + 1.5 or delta.Unit:Dot(direcao) >= limite then
				table.insert(alvos, inimigo)
			end
		end
	end
	local garantido = estado.criticoGarantido == true
	if #alvos > 0 then
		estado.criticoGarantido = nil
	end
	for _, inimigo in alvos do
		local critico = garantido or math.random() < stats.critico
		local dano = stats.dano * mult * (if critico then stats.multCritico else 1)
		local costas = pelasCostas(inimigo, raiz.Position)
		if costas and stats.costas > 0 then
			dano *= 1 + stats.costas
		end
		Combate.danoAoInimigo(run, inimigo, dano, estado, {
			critico = critico,
			principal = true,
			cor = if costas and stats.costas > 0 then COR_COSTAS else nil,
			empurrar = direcao * (if final then 50 else 25),
		})
	end

	-- Carta Leque de Adagas: o golpe final arremessa adagas
	if final and stats.leque > 0 then
		local lista = {}
		local quantidade = 1 + 2 * stats.leque
		for i = 1, quantidade do
			local angulo = math.rad((i - (quantidade + 1) / 2) * 14)
			table.insert(lista, {
				lado = "jogador",
				tipo = "adaga",
				pos = raiz.Position + direcao * 1.5 + Vector3.new(0, 0.6, 0),
				dir = CFrame.Angles(0, angulo, 0):VectorToWorldSpace(direcao),
				velocidade = 90,
				alcance = 30,
				raio = 1,
				perfuracao = 0,
				aoAcertar = function(inimigo)
					Combate.danoAoInimigo(run, inimigo, stats.dano * 0.9, estado, { semEfeitos = true, cor = classe.cor })
				end,
			})
		end
		Projeteis.disparar(run, lista)
	end

	if final and stats.ondaCorte > 0 then
		Projeteis.disparar(run, {
			{
				lado = "jogador",
				tipo = "onda",
				pos = raiz.Position + direcao * 2,
				dir = direcao,
				velocidade = 55,
				alcance = 32,
				raio = 3.2,
				perfuracao = 99,
				aoAcertar = function(inimigo)
					Combate.danoAoInimigo(run, inimigo, stats.dano * 0.8 * stats.ondaCorte, estado, { semEfeitos = true, cor = classe.cor })
				end,
			},
		})
	end
end

local function disparoDeClasse(run, estado, classe, raiz: BasePart, direcao: Vector3, mult: number, final: boolean)
	local stats = estado.stats
	local tipo = classe.ataque.projetil
	local tamanho = stats.tamanho
	local perfuracao = stats.perfuracao
	local explosao = stats.explosao
	local dano = stats.dano * mult

	if final then
		if classe.id == "mago" then
			tipo = "orbeGrande"
			tamanho *= 1.7
			explosao = math.max(explosao, 4) * 1.8
		elseif stats.fantasma then
			tipo = "fantasma"
			perfuracao = 999
			tamanho *= 2.4
			dano *= 1.6
		else
			tipo = "flechaGrande"
			perfuracao += 2
			tamanho *= 1.4
		end
	end

	local quantidade = stats.projeteis
	local abertura = if classe.id == "arqueiro" then 9 else 13
	local origem = raiz.Position + direcao * 1.5 + Vector3.new(0, 0.6, 0)
	local lista = {}
	for i = 1, quantidade do
		local angulo = math.rad((i - (quantidade + 1) / 2) * abertura)
		local critico = math.random() < stats.critico
		local danoFinal = dano * (if critico then stats.multCritico else 1)
		table.insert(lista, {
			lado = "jogador",
			tipo = tipo,
			pos = origem,
			dir = CFrame.Angles(0, angulo, 0):VectorToWorldSpace(direcao),
			velocidade = stats.velProjetil,
			alcance = stats.alcance,
			raio = classe.ataque.raio * tamanho,
			tamanho = tamanho,
			perfuracao = perfuracao,
			ricochete = stats.ricochete,
			explosao = if explosao > 0 then explosao else nil,
			aoAcertar = function(inimigo, _, projetil)
				local danoAqui = danoFinal
				-- Arqueiro: flecha disparada colada no inimigo perde força
				if classe.id == "arqueiro" then
					local raizAgora = raizDe(estado)
					if raizAgora and planar(raizAgora.Position - inimigo.raiz.Position).Magnitude < inimigo.raio + 6 then
						danoAqui *= 0.6
					end
				end
				Combate.danoAoInimigo(run, inimigo, danoAqui, estado, {
					critico = critico,
					principal = true,
					empurrar = projetil.dir * 18,
				})
			end,
			aoExplodir = function(pos: Vector3, principal)
				Vfx.partida(run, "explosao", { pos = pos, raio = explosao, cor = classe.cor, leve = true })
				Combate.danoEmArea(run, pos, explosao, dano * 0.6, estado, { semEfeitos = true, exceto = principal, cor = classe.cor })
			end,
		})
	end
	Projeteis.disparar(run, lista)
end

local function rajadaDoDragao(run, estado, raiz: BasePart, direcao: Vector3)
	local stats = estado.stats
	local alcance = stats.alcance * 2.2
	Vfx.partida(run, "rajada", { pos = raiz.Position, dir = direcao, alcance = alcance })
	local atingidos = {}
	for _, inimigo in inimigosVivos(run) do
		local delta = planar(inimigo.raiz.Position - raiz.Position)
		if delta.Magnitude > 0.1 and delta.Magnitude <= alcance + inimigo.raio and delta.Unit:Dot(direcao) >= 0.5 then
			table.insert(atingidos, inimigo)
		end
	end
	for _, inimigo in atingidos do
		Combate.danoAoInimigo(run, inimigo, stats.dano * 0.6 * stats.dragao, estado, { semEfeitos = true, queimar = true, cor = COR_FOGO })
	end
end

function Combate.atacar(run, estado, direcao: any)
	if not podeAgir(run, estado) or estado.carregandoDesde then
		return
	end
	local stats = estado.stats
	local classe = Classes.obter(estado.classe)
	local agora = os.clock()
	local espera = stats.intervalo * (if estado.ultimoFoiFinal then 1.35 else 1)
	if agora - estado.ultimoAtaque < espera * 0.8 then
		return
	end
	if agora - estado.ultimoAtaque > stats.intervalo * 2.6 + 0.3 then
		estado.combo = 0
	end
	estado.combo = estado.combo % 3 + 1
	local final = estado.combo == 3
	estado.ultimoFoiFinal = final
	estado.ultimoAtaque = agora

	local raiz = raizDe(estado) :: BasePart
	local dir = direcaoValida(direcao, raiz)
	local mult = classe.ataque.combo[estado.combo] or 1
	animar(run, estado, "ataque", { combo = estado.combo }, estado.player)

	if classe.ataque.tipo == "corte" then
		golpeDeEspada(run, estado, classe, raiz, dir, mult, final)
	else
		disparoDeClasse(run, estado, classe, raiz, dir, mult, final)
	end
	if stats.dragao > 0 then
		rajadaDoDragao(run, estado, raiz, dir)
	end
end

------------------------------------------------------------------------
-- Ataque carregado: segurar o ataque carrega; soltar dispara um golpe mais forte
------------------------------------------------------------------------

function Combate.carregar(run, estado)
	if not podeAgir(run, estado) or estado.carregandoDesde then
		return
	end
	estado.carregandoDesde = os.clock()
	Combate.aplicarVelocidade(estado)
	animar(run, estado, "carregar", nil, estado.player)
end

function Combate.cancelarCarga(run, estado)
	if not estado.carregandoDesde then
		return
	end
	estado.carregandoDesde = nil
	Combate.aplicarVelocidade(estado)
	animar(run, estado, "cancelar", nil, estado.player)
end

local function golpeCarregado(run, estado, classe, raiz: BasePart, direcao: Vector3, fracao: number)
	local stats = estado.stats
	local mult = Config.DANO_CARGA_MIN + (Config.DANO_CARGA_MAX - Config.DANO_CARGA_MIN) * fracao
	local perfeito = fracao >= 0.99

	if classe.id == "cavaleiro" then
		-- Giro completo com a espada, empurrando todos para longe
		local raio = stats.alcance * (1.25 + 0.3 * fracao)
		Vfx.partida(run, "giroCarregado", { jogador = estado.player, raio = raio, cor = classe.cor, perfeito = perfeito }, estado.player)
		local alvos = {}
		for _, inimigo in inimigosVivos(run) do
			if planar(inimigo.raiz.Position - raiz.Position).Magnitude <= raio + inimigo.raio then
				table.insert(alvos, inimigo)
			end
		end
		for _, inimigo in alvos do
			local critico = math.random() < stats.critico
			local fora = planar(inimigo.raiz.Position - raiz.Position)
			fora = if fora.Magnitude > 0.1 then fora.Unit else direcao
			Combate.danoAoInimigo(run, inimigo, stats.dano * mult * (if critico then stats.multCritico else 1), estado, {
				critico = critico,
				principal = true,
				empurrar = fora * (40 + 40 * fracao),
			})
			if perfeito and inimigo.vivo then
				Combate.atordoar(inimigo, 1.2)
			end
		end
		if perfeito then
			local centro = raiz.Position
			task.delay(0.15, function()
				if not run.ativa then
					return
				end
				Vfx.partida(run, "explosao", { pos = centro, raio = raio * 1.8, cor = classe.cor, forte = true })
				Combate.danoEmArea(run, centro, raio * 1.8, stats.dano * 1.2, estado, { semEfeitos = true, cor = classe.cor, empurrarForca = 50 })
			end)
		end
		if stats.dragao > 0 then
			rajadaDoDragao(run, estado, raiz, direcao)
		end
	elseif classe.id == "mago" then
		-- Orbe enorme e lento que explode forte (atravessa tudo com a carga cheia)
		local tamanho = (1.8 + 1.4 * fracao) * stats.tamanho
		local explosao = math.max(stats.explosao, 4) * (1.6 + 1.4 * fracao)
		local dano = stats.dano * mult
		Projeteis.disparar(run, {
			{
				lado = "jogador",
				tipo = "orbeCarregado",
				pos = raiz.Position + direcao * 2 + Vector3.new(0, 1, 0),
				dir = direcao,
				velocidade = 42,
				alcance = stats.alcance * 1.1,
				raio = 1.2 * tamanho,
				tamanho = tamanho,
				perfuracao = if perfeito then 999 else 2,
				explosao = explosao,
				aoAcertar = function(inimigo, _, projetil)
					Combate.danoAoInimigo(run, inimigo, dano, estado, { principal = true, empurrar = projetil.dir * 30 })
				end,
				aoExplodir = function(pos: Vector3, principal)
					Vfx.partida(run, "explosao", { pos = pos, raio = explosao, cor = classe.cor, forte = true })
					Combate.danoEmArea(run, pos, explosao, dano * 0.7, estado, { semEfeitos = true, exceto = principal, cor = classe.cor, empurrarForca = 35 })
				end,
			},
		})
	elseif classe.id == "assassino" then
		-- Investida Letal: avança cortando tudo numa linha (o movimento é feito no computador
		-- de quem ataca). Com a carga cheia, todo corte é crítico.
		local inicio = raiz.Position
		local fim = inicio + direcao * (12 + 6 * fracao)
		Vfx.partida(run, "investidaLetal", { jogador = estado.player, de = inicio, ate = fim, cor = classe.cor, perfeito = perfeito }, estado.player)
		estado.invulneravelAte = math.max(estado.invulneravelAte or 0, os.clock() + 0.3)
		task.delay(0.12, function()
			if not run.ativa then
				return
			end
			for _, inimigo in inimigosVivos(run) do
				if Projeteis.distanciaAoSegmento(inimigo.raiz.Position, inicio, fim) <= inimigo.raio + 3 then
					local critico = perfeito or math.random() < stats.critico
					Combate.danoAoInimigo(run, inimigo, stats.dano * mult * (if critico then stats.multCritico else 1), estado, {
						critico = critico,
						principal = true,
						empurrar = direcao * 20,
					})
				end
			end
		end)
	else
		-- Flecha perfurante e veloz (crítico garantido com a carga cheia)
		local critico = perfeito or math.random() < stats.critico
		local dano = stats.dano * mult * (if critico then stats.multCritico else 1)
		Projeteis.disparar(run, {
			{
				lado = "jogador",
				tipo = "flechaCarregada",
				pos = raiz.Position + direcao * 1.5 + Vector3.new(0, 0.6, 0),
				dir = direcao,
				velocidade = stats.velProjetil * 1.5,
				alcance = stats.alcance * 1.4,
				raio = 1.5,
				tamanho = 1.5 + 0.8 * fracao,
				perfuracao = 999,
				aoAcertar = function(inimigo, _, projetil)
					Combate.danoAoInimigo(run, inimigo, dano, estado, { critico = critico, principal = true, empurrar = projetil.dir * 35 })
				end,
			},
		})
	end
end

function Combate.soltar(run, estado, direcao: any)
	local inicio = estado.carregandoDesde
	if not inicio then
		return
	end
	estado.carregandoDesde = nil
	Combate.aplicarVelocidade(estado)
	if not podeAgir(run, estado) then
		return
	end
	local duracao = os.clock() - inicio
	if duracao < Config.CARGA_ATAQUE_MIN * 0.75 then
		animar(run, estado, "cancelar", nil, estado.player)
		return
	end
	local fracao = math.clamp((duracao - Config.CARGA_ATAQUE_MIN) / (Config.CARGA_ATAQUE_MAX - Config.CARGA_ATAQUE_MIN), 0, 1)
	estado.combo = 0
	estado.ultimoAtaque = os.clock()
	estado.ultimoFoiFinal = true
	local raiz = raizDe(estado) :: BasePart
	local dir = direcaoValida(direcao, raiz)
	local classe = Classes.obter(estado.classe)
	animar(run, estado, "soltar", { fracao = fracao }, estado.player)
	golpeCarregado(run, estado, classe, raiz, dir, fracao)
end

------------------------------------------------------------------------
-- Habilidades (tecla E)
------------------------------------------------------------------------

-- Inimigo mais perto da linha de mira
local function alvoNaMira(origem: Vector3, direcao: Vector3, run, alcanceMax: number)
	local melhor, melhorNota = nil, math.huge
	for _, inimigo in inimigosVivos(run) do
		local delta = planar(inimigo.raiz.Position - origem)
		local distancia = delta.Magnitude
		if distancia > 0.1 and distancia <= alcanceMax then
			local alinhamento = delta.Unit:Dot(direcao)
			if alinhamento > 0.4 then
				local nota = distancia * (2 - alinhamento)
				if nota < melhorNota then
					melhor, melhorNota = inimigo, nota
				end
			end
		end
	end
	return melhor
end

local function redemoinho(run, estado, classe)
	local stats = estado.stats
	local duracao = 2 * (if stats.redemoinhoFogo then 1.5 else 1)
	local raio = stats.alcance * 1.1
	Vfx.partida(run, "redemoinho", { jogador = estado.player, duracao = duracao, raio = raio, cor = classe.cor, fogo = stats.redemoinhoFogo })
	animar(run, estado, "habilidade", { duracao = duracao })
	estado.resistenteAte = os.clock() + duracao
	task.spawn(function()
		local fim = os.clock() + duracao
		while os.clock() < fim and run.ativa and estado.vivo and not estado.caido do
			local raiz = raizDe(estado)
			if not raiz then
				break
			end
			-- empurrar negativo puxa os inimigos para o centro do giro
			Combate.danoEmArea(run, raiz.Position, raio, stats.dano * 0.55, estado, { queimar = stats.redemoinhoFogo, empurrarForca = -18 })
			task.wait(0.22)
		end
		estado.resistenteAte = nil
	end)
end

local function meteoro(run, estado, raiz: BasePart, direcao: Vector3)
	local stats = estado.stats
	local primeiro = alvoNaMira(raiz.Position, direcao, run, 60)
	local base = noChao(run, if primeiro then primeiro.raiz.Position else raiz.Position + direcao * 18)

	-- Meteoros extras caem nos inimigos mais próximos do primeiro ponto
	local vizinhos = {}
	for _, inimigo in inimigosVivos(run) do
		if inimigo ~= primeiro then
			table.insert(vizinhos, inimigo)
		end
	end
	table.sort(vizinhos, function(a, b)
		return (a.raiz.Position - base).Magnitude < (b.raiz.Position - base).Magnitude
	end)

	for i = 1, stats.meteoros do
		local ponto = base
		if i > 1 then
			local vizinho = vizinhos[i - 1]
			ponto = if vizinho
				then noChao(run, vizinho.raiz.Position)
				else base + Vector3.new(math.random(-9, 9), 0, math.random(-9, 9))
		end
		task.delay((i - 1) * 0.35, function()
			if not run.ativa then
				return
			end
			Vfx.partida(run, "meteoro", { pos = ponto, duracao = 0.75, raio = 11, amigo = true })
			task.delay(0.75, function()
				if not run.ativa then
					return
				end
				Vfx.partida(run, "explosao", { pos = ponto, raio = 11, cor = COR_FOGO, forte = true })
				Combate.danoEmArea(run, ponto, 11, stats.dano * 3.5, estado, { semEfeitos = true, queimar = true, cor = COR_FOGO, empurrarForca = 40 })
				-- o chão fica em chamas por 3 segundos
				Vfx.partida(run, "zonaFogo", { pos = ponto, raio = 8, duracao = 3 })
				task.spawn(function()
					local fimZona = os.clock() + 3
					while os.clock() < fimZona and run.ativa do
						task.wait(0.5)
						Combate.danoEmArea(run, ponto, 8, stats.dano * 0.35, estado, { semEfeitos = true, cor = COR_FOGO })
					end
				end)
			end)
		end)
	end
end

local function chuvaDeFlechas(run, estado, classe, raiz: BasePart, direcao: Vector3)
	local stats = estado.stats
	local raio = 10 * math.sqrt(stats.chuva)
	local duracao = 3 * stats.chuva
	local alvo = alvoNaMira(raiz.Position, direcao, run, 60)
	local centro = noChao(run, if alvo then alvo.raiz.Position else raiz.Position + direcao * 20)
	Vfx.partida(run, "chuvaFlechas", { pos = centro, raio = raio, duracao = duracao, cor = classe.cor })
	task.spawn(function()
		local fim = os.clock() + duracao
		task.wait(0.35)
		while os.clock() < fim and run.ativa do
			Combate.danoEmArea(run, centro, raio, stats.dano * 0.45, estado, { semEfeitos = true, lento = 0.75 })
			task.wait(0.25)
		end
	end)
end

-- Ponto livre entre "de" e "ate" (não atravessa paredes)
local function pontoLivre(personagem: Model?, de: Vector3, ate: Vector3): Vector3
	local parametros = RaycastParams.new()
	parametros.FilterType = Enum.RaycastFilterType.Exclude
	local ignorar = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(ignorar, player.Character)
		end
	end
	if personagem then
		table.insert(ignorar, personagem)
	end
	for _, inimigo in CollectionService:GetTagged("Inimigo") do
		table.insert(ignorar, inimigo)
	end
	parametros.FilterDescendantsInstances = ignorar
	parametros.RespectCanCollide = true
	local delta = ate - de
	local resultado = workspace:Raycast(de, delta, parametros)
	if resultado then
		local recuo = math.max(0, (resultado.Position - de).Magnitude - 2)
		return de + delta.Unit * recuo
	end
	return ate
end

-- Coloca o jogador atrás do inimigo, olhando para ele
local function teleportarAtras(estado, inimigo, raiz: BasePart): Vector3
	local alvo = inimigo.raiz.Position
	local olhar = planar(inimigo.raiz.CFrame.LookVector)
	if olhar.Magnitude < 0.1 then
		olhar = planar(alvo - raiz.Position)
	end
	olhar = if olhar.Magnitude > 0.1 then olhar.Unit else Vector3.new(0, 0, -1)
	local altura = Vector3.new(0, raiz.Position.Y - alvo.Y, 0)
	local desejado = alvo + altura - olhar * (inimigo.raio + 2.5)
	local destino = pontoLivre(estado.player.Character, alvo + altura, desejado)
	local personagem = estado.player.Character
	if personagem then
		personagem:PivotTo(CFrame.lookAt(destino, Vector3.new(alvo.X, destino.Y, alvo.Z)))
	end
	return destino
end

local function passoSombrio(run, estado, classe, raiz: BasePart, direcao: Vector3)
	local stats = estado.stats
	local inicio = raiz.Position
	local alvo = alvoNaMira(inicio, direcao, run, 35)
	estado.invulneravelAte = math.max(estado.invulneravelAte or 0, os.clock() + 0.5)
	if not alvo then
		-- sem alvo: só avança na direção da mira
		local destino = pontoLivre(estado.player.Character, inicio, inicio + direcao * 14)
		local personagem = estado.player.Character
		if personagem then
			personagem:PivotTo(CFrame.lookAt(destino, destino + direcao))
		end
		Vfx.partida(run, "passoSombrio", { jogador = estado.player, de = inicio, ate = destino, cor = classe.cor })
		return
	end
	local destino = teleportarAtras(estado, alvo, raiz)
	Vfx.partida(run, "passoSombrio", { jogador = estado.player, de = inicio, ate = destino, cor = classe.cor })
	task.delay(0.1, function()
		if not run.ativa or not alvo.vivo then
			return
		end
		local dano = stats.dano * 2.2 * stats.multCritico * (1 + stats.costas)
		Combate.danoAoInimigo(run, alvo, dano, estado, { critico = true, principal = true, cor = COR_COSTAS, empurrar = planar(alvo.raiz.Position - destino).Unit * 20 })
	end)
end

function Combate.habilidade(run, estado, direcao: any)
	if not podeAgir(run, estado) then
		return
	end
	local agora = os.clock()
	if agora < estado.habilidadeProntaEm - 0.15 then
		return
	end
	local stats = estado.stats
	estado.habilidadeProntaEm = agora + stats.recarga
	Remotos.enviar(estado.player, "recarga", { tipo = "habilidade", restante = stats.recarga, total = stats.recarga })

	local raiz = raizDe(estado) :: BasePart
	local dir = direcaoValida(direcao, raiz)
	local classe = Classes.obter(estado.classe)
	local id = classe.habilidade.id
	if id == "redemoinho" then
		redemoinho(run, estado, classe)
	elseif id == "meteoro" then
		animar(run, estado, "habilidade", { duracao = 0.5 })
		meteoro(run, estado, raiz, dir)
	elseif id == "passoSombrio" then
		animar(run, estado, "habilidade", { duracao = 0.4 })
		passoSombrio(run, estado, classe, raiz, dir)
	else
		-- o salto para trás é feito no computador do arqueiro; aqui só fica intocável no salto
		estado.invulneravelAte = math.max(estado.invulneravelAte or 0, agora + 0.3)
		animar(run, estado, "habilidade", { duracao = 0.45 })
		chuvaDeFlechas(run, estado, classe, raiz, dir)
	end
end

-- Carta Arquimago: abates aceleram a habilidade
function Combate.reduzirRecarga(estado, segundos: number)
	estado.habilidadeProntaEm -= segundos
	local restante = math.max(0, estado.habilidadeProntaEm - os.clock())
	Remotos.enviar(estado.player, "recarga", { tipo = "habilidade", restante = restante, total = estado.stats.recarga })
end

------------------------------------------------------------------------
-- Supremos (tecla R)
------------------------------------------------------------------------

-- Assassino: salta de inimigo em inimigo, intocável, cortando cada um pelas costas
laminasNoturnas = function(run, estado, classe)
	local stats = estado.stats
	local golpes = 10
	local duracao = golpes * 0.28 + 0.3
	estado.invulneravelAte = math.max(estado.invulneravelAte or 0, os.clock() + duracao)
	animar(run, estado, "supremo", { duracao = duracao })
	task.spawn(function()
		local ultimo = nil
		for _ = 1, golpes do
			if not run.ativa or not estado.vivo or estado.caido then
				break
			end
			local raiz = raizDe(estado)
			if not raiz then
				break
			end
			-- o mais perto, evitando repetir o último (a não ser que só reste ele)
			local melhor, melhorDistancia = nil, math.huge
			for _, inimigo in inimigosVivos(run) do
				local distancia = (inimigo.raiz.Position - raiz.Position).Magnitude
				if inimigo == ultimo then
					distancia += 1000
				end
				if distancia < melhorDistancia then
					melhor, melhorDistancia = inimigo, distancia
				end
			end
			if not melhor then
				break
			end
			ultimo = melhor
			local inicio = raiz.Position
			local destino = teleportarAtras(estado, melhor, raiz)
			Vfx.partida(run, "passoSombrio", { jogador = estado.player, de = inicio, ate = destino, cor = classe.cor, leve = true })
			local critico = math.random() < stats.critico + 0.25
			local dano = stats.dano * 2.4 * (1 + stats.costas) * (if critico then stats.multCritico else 1)
			Combate.danoAoInimigo(run, melhor, dano, estado, { critico = critico, principal = true, cor = COR_COSTAS })
			task.wait(0.28)
		end
	end)
end

function Combate.supremo(run, estado)
	if not podeAgir(run, estado) or estado.carga < Config.CARGA_MAXIMA then
		return
	end
	estado.carga = 0
	estado.cargaEnviada = 0
	Remotos.enviar(estado.player, "carga", { valor = 0, max = Config.CARGA_MAXIMA })

	local stats = estado.stats
	local classe = Classes.obter(estado.classe)
	local raiz = raizDe(estado) :: BasePart
	Vfx.partida(run, "supremo", { jogador = estado.player, nome = classe.supremo.nome, cor = classe.cor })

	if classe.supremo.id == "julgamento" then
		animar(run, estado, "supremo", { duracao = 0.75 })
		local centro = noChao(run, raiz.Position)
		Vfx.partida(run, "julgamento", { pos = centro, raio = 18, cor = classe.cor })
		task.delay(0.35, function()
			if not run.ativa then
				return
			end
			for _, inimigo in inimigosVivos(run) do
				if planar(inimigo.raiz.Position - centro).Magnitude <= 18 + inimigo.raio then
					Combate.atordoar(inimigo, 2.5)
				end
			end
			Combate.danoEmArea(run, centro, 18, stats.dano * 5, estado, { semEfeitos = true, cor = COR_OURO, empurrarForca = 60 })
			-- o Cavaleiro e os aliados por perto ganham um escudo que bloqueia o próximo golpe
			for _, outro in run.jogadores do
				local raizOutro = raizDe(outro)
				if outro.vivo and not outro.caido and raizOutro and planar(raizOutro.Position - centro).Magnitude <= 25 then
					outro.escudoAtivo = true
					Vfx.partida(run, "escudoGanho", { jogador = outro.player, cor = classe.cor })
				end
			end
		end)
	elseif classe.supremo.id == "tempestade" then
		animar(run, estado, "supremo", { duracao = 5 })
		task.spawn(function()
			local fim = os.clock() + 5
			while os.clock() < fim and run.ativa do
				local vivos = inimigosVivos(run)
				if #vivos > 0 then
					local ponto = noChao(run, vivos[math.random(#vivos)].raiz.Position)
					Vfx.partida(run, "raioCeu", { pos = ponto, cor = classe.cor })
					Combate.danoEmArea(run, ponto, 4.5, stats.dano * 1.6, estado, { semEfeitos = true, cor = COR_RAIO, lento = 0.6 })
				end
				task.wait(0.2)
			end
		end)
	elseif classe.supremo.id == "laminasNoturnas" then
		laminasNoturnas(run, estado, classe)
	else
		animar(run, estado, "supremo", { duracao = 4 })
		estado.rapidoAte = os.clock() + 4
		Combate.aplicarVelocidade(estado)
		task.delay(4.05, function()
			Combate.aplicarVelocidade(estado)
		end)
		task.spawn(function()
			local fim = os.clock() + 4
			local giro = 0
			while os.clock() < fim and run.ativa and estado.vivo and not estado.caido do
				local raizAtual = raizDe(estado)
				if not raizAtual then
					break
				end
				local lista = {}
				for i = 1, 12 do
					local angulo = giro + i * (math.pi * 2 / 12)
					local dir = Vector3.new(math.sin(angulo), 0, math.cos(angulo))
					table.insert(lista, {
						lado = "jogador",
						tipo = "flecha",
						pos = raizAtual.Position + Vector3.new(0, 0.6, 0) + dir * 1.5,
						dir = dir,
						velocidade = stats.velProjetil,
						alcance = 45,
						raio = 1,
						perfuracao = 1,
						aoAcertar = function(inimigo)
							Combate.danoAoInimigo(run, inimigo, stats.dano * 0.7, estado, { semEfeitos = true })
						end,
					})
				end
				Projeteis.disparar(run, lista)
				giro += 0.13
				task.wait(0.3)
			end
		end)
	end
end

------------------------------------------------------------------------
-- Esquiva (tecla Q). O movimento é feito no computador do jogador; aqui só a invulnerabilidade.
------------------------------------------------------------------------

function Combate.esquiva(run, estado, direcao: any)
	if not podeAgir(run, estado) then
		return
	end
	local agora = os.clock()
	if agora < estado.esquivaProntaEm - 0.25 then
		return
	end
	estado.esquivaProntaEm = agora + estado.stats.recargaEsquiva
	estado.invulneravelAte = math.max(estado.invulneravelAte or 0, agora + Config.ESQUIVA_INVULNERAVEL)
	animar(run, estado, "esquiva", nil, estado.player)
	if estado.stats.contraAtaque then
		estado.criticoGarantido = true
	end

	-- Carta Investida Brutal: atropela quem estiver no caminho
	local stats = estado.stats
	if stats.investida > 0 then
		local raiz = raizDe(estado) :: BasePart
		local inicio = raiz.Position
		task.delay(Config.ESQUIVA_DURACAO + 0.05, function()
			local raizAgora = raizDe(estado)
			if not raizAgora or not run.ativa then
				return
			end
			local fim = raizAgora.Position
			local dir = direcaoValida(fim - inicio, raizAgora)
			for _, inimigo in inimigosVivos(run) do
				local distancia = Projeteis.distanciaAoSegmento(inimigo.raiz.Position, inicio, fim)
				if distancia <= inimigo.raio + 2.5 then
					Combate.danoAoInimigo(run, inimigo, stats.dano * 1.2 * stats.investida, estado, { semEfeitos = true, empurrar = dir * 45 })
				end
			end
		end)
	end
end

------------------------------------------------------------------------
-- Ciclo: queimaduras, regeneração, lava, lentidão e jogadores caídos (a cada 0,25s)
------------------------------------------------------------------------

local function processarCaido(run, estado, dt: number, agora: number)
	if agora >= estado.caidoAte then
		Combate.morrerDeVez(run, estado)
		return
	end
	local raiz = raizDe(estado)
	if not raiz then
		return
	end
	local ajudantes = 0
	for _, outro in run.jogadores do
		if outro ~= estado and outro.vivo and not outro.caido then
			local raizOutro = raizDe(outro)
			if raizOutro and planar(raizOutro.Position - raiz.Position).Magnitude <= Config.RAIO_REVIVER then
				ajudantes += 1
			end
		end
	end
	if ajudantes > 0 then
		estado.progressoReviver += dt * (1 + 0.5 * (ajudantes - 1)) / Config.TEMPO_PARA_REVIVER
	else
		estado.progressoReviver = math.max(0, estado.progressoReviver - dt * 0.25)
	end
	local personagem = estado.player.Character
	if personagem then
		personagem:SetAttribute("Reviver", math.min(1, estado.progressoReviver))
		personagem:SetAttribute("CaidoRestante", math.max(0, estado.caidoAte - agora))
	end
	if estado.progressoReviver >= 1 then
		Combate.levantar(run, estado, Config.VIDA_AO_REVIVER)
		return
	end
	local humanoid = humanoidDe(estado)
	if humanoid and not humanoid.Sit then
		humanoid.Sit = true
	end
end

function Combate.tick(run, dt: number)
	local agora = os.clock()
	for _, inimigo in inimigosVivos(run) do
		if inimigo.queimaAte then
			if agora < inimigo.queimaAte then
				Combate.danoAoInimigo(run, inimigo, inimigo.queimaDps * dt, inimigo.queimaFonte, { semEfeitos = true, cor = COR_FOGO })
			else
				inimigo.queimaAte = nil
				inimigo.queimaDps = 0
				inimigo.modelo:SetAttribute("Queimando", false)
			end
		end
	end

	for _, estado in run.jogadores do
		if estado.vivo then
			if estado.caido then
				processarCaido(run, estado, dt, agora)
			else
				if estado.stats.regen > 0 then
					Combate.curar(run, estado, estado.stats.regen * dt, true)
				end
				local raiz = raizDe(estado)
				if raiz and run.sala and Masmorra.naLava(run.sala, raiz.Position) then
					Combate.danoAoJogador(run, estado, 30 * dt, nil, { ambiente = true })
				end
				if estado.queimaAte then
					if agora < estado.queimaAte then
						Combate.danoAoJogador(run, estado, estado.queimaDps * dt, nil, { ambiente = true })
					else
						estado.queimaAte = nil
					end
				end
				if estado.lentoAte and agora >= estado.lentoAte then
					estado.lentoAte = nil
					Combate.aplicarVelocidade(estado)
				end
			end
		end
	end
end

-- Ao começar cada sala
function Combate.novaSala(estado)
	estado.carregandoDesde = nil
	estado.escudoAtivo = estado.stats.escudo
	estado.invulneravelAte = os.clock() + 1.5
	estado.lentoAte = nil
	estado.queimaAte = nil
end

return Combate
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000013">
        <Properties>
          <string name="Name">Dados</string>
          <ProtectedString name="Source"><![CDATA[-- Progresso permanente dos jogadores (ouro, recorde e melhorias), salvo no DataStore.
-- No Studio, o salvamento só funciona com o jogo publicado e com
-- "Game Settings > Security > Enable Studio Access to API Services" ligado.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local Remotos = require(script.Parent.Remotos)

local Dados = {}

local NOME_DO_BANCO = "MasmorraDasCartas_v1"

local banco: DataStore? = nil
do
	local ok, resultado = pcall(function()
		return DataStoreService:GetDataStore(NOME_DO_BANCO)
	end)
	if ok then
		banco = resultado
	else
		warn("[Dados] DataStore indisponível, o progresso não será salvo: " .. tostring(resultado))
	end
end

local perfis = {} -- [Player] = perfil
local podeSalvar = {} -- [Player] = true só se o carregamento deu certo (evita apagar progresso)

local function perfilPadrao()
	local melhorias = {}
	for _, melhoria in Config.MELHORIAS do
		melhorias[melhoria.id] = 0
	end
	return { Ouro = 0, Recorde = 0, Melhorias = melhorias, Classe = "cavaleiro", EscolheuClasse = false }
end

local function corrigirPerfil(salvo)
	local perfil = perfilPadrao()
	if type(salvo) ~= "table" then
		return perfil
	end
	if type(salvo.Ouro) == "number" then
		perfil.Ouro = math.max(0, math.floor(salvo.Ouro))
	end
	if type(salvo.Recorde) == "number" then
		perfil.Recorde = math.max(0, math.floor(salvo.Recorde))
	end
	if type(salvo.Melhorias) == "table" then
		for id, nivel in salvo.Melhorias do
			if perfil.Melhorias[id] ~= nil and type(nivel) == "number" then
				perfil.Melhorias[id] = math.max(0, math.floor(nivel))
			end
		end
	end
	if Classes.existe(salvo.Classe) then
		perfil.Classe = salvo.Classe
		perfil.EscolheuClasse = salvo.EscolheuClasse == true
	end
	return perfil
end

local function chave(player: Player): string
	return "jogador_" .. player.UserId
end

local function criarLeaderstats(player: Player, perfil)
	local pasta = Instance.new("Folder")
	pasta.Name = "leaderstats"

	local ouro = Instance.new("IntValue")
	ouro.Name = "Ouro"
	ouro.Value = perfil.Ouro
	ouro.Parent = pasta

	local recorde = Instance.new("IntValue")
	recorde.Name = "Recorde"
	recorde.Value = perfil.Recorde
	recorde.Parent = pasta

	pasta.Parent = player
end

local function atualizarLeaderstats(player: Player)
	local perfil = perfis[player]
	local pasta = player:FindFirstChild("leaderstats")
	if not perfil or not pasta then
		return
	end
	local ouro = pasta:FindFirstChild("Ouro") :: IntValue?
	local recorde = pasta:FindFirstChild("Recorde") :: IntValue?
	if ouro then
		ouro.Value = perfil.Ouro
	end
	if recorde then
		recorde.Value = perfil.Recorde
	end
end

function Dados.carregar(player: Player)
	local perfil = perfilPadrao()
	if banco then
		local ok, salvo = pcall(function()
			return banco:GetAsync(chave(player))
		end)
		if ok then
			perfil = corrigirPerfil(salvo)
			podeSalvar[player] = true
		else
			warn("[Dados] Não consegui carregar o progresso de " .. player.Name .. ": " .. tostring(salvo))
		end
	end
	if not player.Parent then
		return nil
	end
	perfis[player] = perfil
	criarLeaderstats(player, perfil)
	player:SetAttribute("Classe", perfil.Classe)
	return perfil
end

function Dados.obter(player: Player)
	return perfis[player]
end

function Dados.salvar(player: Player)
	local perfil = perfis[player]
	if not perfil or not podeSalvar[player] or not banco then
		return
	end
	local copia = {
		Ouro = perfil.Ouro,
		Recorde = perfil.Recorde,
		Melhorias = table.clone(perfil.Melhorias),
		Classe = perfil.Classe,
		EscolheuClasse = perfil.EscolheuClasse,
	}
	local ok, erro = pcall(function()
		banco:SetAsync(chave(player), copia)
	end)
	if not ok then
		warn("[Dados] Erro ao salvar " .. player.Name .. ": " .. tostring(erro))
	end
end

function Dados.salvarERemover(player: Player)
	Dados.salvar(player)
	perfis[player] = nil
	podeSalvar[player] = nil
end

function Dados.salvarTodos()
	for player in perfis do
		Dados.salvar(player)
	end
end

function Dados.enviarPerfil(player: Player)
	local perfil = perfis[player]
	if perfil then
		Remotos.enviar(player, "perfil", {
			ouro = perfil.Ouro,
			recorde = perfil.Recorde,
			melhorias = perfil.Melhorias,
			classe = perfil.Classe,
			escolheuClasse = perfil.EscolheuClasse,
		})
	end
end

function Dados.definirClasse(player: Player, classe: any): boolean
	local perfil = perfis[player]
	if not perfil or not Classes.existe(classe) then
		return false
	end
	perfil.Classe = classe
	perfil.EscolheuClasse = true
	player:SetAttribute("Classe", classe)
	return true
end

function Dados.adicionarOuro(player: Player, quantidade: number)
	local perfil = perfis[player]
	if perfil and quantidade > 0 then
		perfil.Ouro += math.floor(quantidade)
		atualizarLeaderstats(player)
	end
end

-- Retorna true se for um recorde novo
function Dados.registrarRecorde(player: Player, sala: number): boolean
	local perfil = perfis[player]
	if perfil and sala > perfil.Recorde then
		perfil.Recorde = sala
		atualizarLeaderstats(player)
		return true
	end
	return false
end

function Dados.comprarMelhoria(player: Player, id: any): (boolean, string)
	local perfil = perfis[player]
	local melhoria = Config.buscarMelhoria(id)
	if not perfil or not melhoria then
		return false, "Melhoria inválida"
	end
	local nivel = perfil.Melhorias[melhoria.id] or 0
	if nivel >= melhoria.nivelMax then
		return false, "Essa melhoria já está no máximo!"
	end
	local preco = Config.precoMelhoria(melhoria, nivel)
	if perfil.Ouro < preco then
		return false, "Ouro insuficiente: faltam " .. (preco - perfil.Ouro)
	end
	perfil.Ouro -= preco
	perfil.Melhorias[melhoria.id] = nivel + 1
	atualizarLeaderstats(player)
	return true, melhoria.icone .. " " .. melhoria.nome .. " agora está no nível " .. (nivel + 1) .. "!"
end

-- Salvamento automático a cada 2 minutos
task.spawn(function()
	while true do
		task.wait(120)
		Dados.salvarTodos()
	end
end)

return Dados
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000014">
        <Properties>
          <string name="Name">Inimigos</string>
          <ProtectedString name="Source"><![CDATA[-- Inimigos: tipos, ataques, elites, chefes e inteligência.
-- No servidor o inimigo é só uma "caixa" invisível que anda (Humanoid). A aparência e as
-- animações são desenhadas no computador de cada jogador (Client/Modelos e Client/VisualInimigos).

local CollectionService = game:GetService("CollectionService")

local servidor = script.Parent
local Vfx = require(servidor.Vfx)
local Projeteis = require(servidor.Projeteis)
local Combate = require(servidor.Combate)
local Masmorra = require(servidor.Masmorra)

local Inimigos = {}

local function planar(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function unidade(v: Vector3, padrao: Vector3): Vector3
	local p = planar(v)
	return if p.Magnitude > 0.01 then p.Unit else padrao
end

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

------------------------------------------------------------------------
-- Tipos de inimigo
-- raiz/quadril/raio: tamanho da caixa invisível | vida/dano: valores na primeira sala
-- comportamento: "perseguir" (corpo a corpo), "distancia" ou "flutuar" (mantém distância)
-- ataques: testados em ordem; o primeiro pronto e dentro do alcance é usado
------------------------------------------------------------------------
Inimigos.TIPOS = {
	-- Calabouço
	gosma = {
		nome = "Gosma", raiz = V(3, 2.4, 3), quadril = 0.4, raio = 1.8, alturaBarra = 3.6,
		vida = 34, dano = 8, velocidade = 11, ouro = 3, divide = "gosminha",
		ataques = { { tipo = "golpe", alcance = 5, arco = 360, preparo = 0.55, recarga = 1.4 } },
	},
	gosminha = {
		nome = "Gosminha", raiz = V(1.8, 1.4, 1.8), quadril = 0.3, raio = 1.1, alturaBarra = 2.4,
		vida = 12, dano = 5, velocidade = 14, ouro = 1,
		ataques = { { tipo = "golpe", alcance = 3.6, arco = 360, preparo = 0.45, recarga = 1.2 } },
	},
	esqueleto = {
		nome = "Esqueleto Guerreiro", raiz = V(2, 2, 1), quadril = 2, raio = 1.3, alturaBarra = 4,
		vida = 55, dano = 11, velocidade = 14, ouro = 5,
		ataques = { { tipo = "golpe", alcance = 6.5, arco = 110, preparo = 0.5, recarga = 1.3 } },
	},
	esqueletoArqueiro = {
		nome = "Esqueleto Arqueiro", raiz = V(2, 2, 1), quadril = 2, raio = 1.3, alturaBarra = 4,
		vida = 36, dano = 10, velocidade = 13, ouro = 5, comportamento = "distancia", distancia = 24,
		ataques = { { tipo = "disparo", alcance = 42, preparo = 0.7, recarga = 2.4, projetil = "flechaOssea", velocidade = 55 } },
	},
	rato = {
		nome = "Rato do Esgoto", raiz = V(1.6, 1.2, 2.4), quadril = 0.5, raio = 1.2, alturaBarra = 2.4,
		vida = 18, dano = 6, velocidade = 21, ouro = 2, grupo = 3,
		ataques = { { tipo = "golpe", alcance = 4, arco = 90, preparo = 0.35, recarga = 1 } },
	},

	-- Caverna
	kobold = {
		nome = "Kobold Mineiro", raiz = V(2, 1.8, 1.2), quadril = 1.4, raio = 1.3, alturaBarra = 4,
		vida = 60, dano = 13, velocidade = 15, ouro = 6,
		ataques = {
			{ tipo = "investida", alcance = 20, minimo = 8, preparo = 0.7, recarga = 6, distancia = 18, largura = 4, mult = 1.3 },
			{ tipo = "golpe", alcance = 6, arco = 100, preparo = 0.5, recarga = 1.3 },
		},
	},
	aranha = {
		nome = "Aranha da Caverna", raiz = V(3.6, 1.4, 3.6), quadril = 1.2, raio = 2.2, alturaBarra = 3.4,
		vida = 48, dano = 12, velocidade = 17, ouro = 6,
		ataques = {
			{ tipo = "salto", alcance = 26, minimo = 7, preparo = 0.5, voo = 0.55, recarga = 5.5, raio = 5.5, mult = 1.2, efeito = "lento" },
			{ tipo = "golpe", alcance = 5.5, arco = 120, preparo = 0.45, recarga = 1.2 },
		},
	},
	cogumelo = {
		nome = "Fungo Explosivo", raiz = V(2.4, 2, 2.4), quadril = 0.6, raio = 1.5, alturaBarra = 2.6,
		vida = 28, dano = 28, velocidade = 12, ouro = 4,
		ataques = { { tipo = "explodir", alcance = 5, preparo = 0.9, raio = 9, cor = Color3.fromRGB(150, 255, 90) } },
	},
	xama = {
		nome = "Xamã Kobold", raiz = V(2, 1.8, 1.2), quadril = 1.4, raio = 1.3, alturaBarra = 4.2,
		vida = 44, dano = 12, velocidade = 13, ouro = 7, comportamento = "distancia", distancia = 24,
		ataques = {
			{ tipo = "invocar", recarga = 14, inicial = 4, preparo = 1, invocado = "rato", quantidade = 2, maxVivos = 12 },
			{ tipo = "disparo", alcance = 40, preparo = 0.75, recarga = 2.6, projetil = "veneno", velocidade = 40, quantidade = 3, espalhamento = 18 },
		},
	},

	-- Cripta
	carnical = {
		nome = "Carniçal", raiz = V(2, 2, 1.4), quadril = 1.6, raio = 1.4, alturaBarra = 4,
		vida = 68, dano = 14, velocidade = 19, ouro = 7,
		ataques = {
			{ tipo = "salto", alcance = 24, minimo = 8, preparo = 0.45, voo = 0.5, recarga = 6, raio = 5, mult = 1.3 },
			{ tipo = "golpe", alcance = 5.5, arco = 110, preparo = 0.4, recarga = 1, acertos = 2, entreAcertos = 0.25 },
		},
	},
	espectro = {
		nome = "Espectro Gélido", raiz = V(2, 2, 1), quadril = 3, raio = 1.4, alturaBarra = 3,
		vida = 50, dano = 14, velocidade = 14, ouro = 8, comportamento = "flutuar", distancia = 26,
		ataques = {
			{ tipo = "teleporte", recarga = 9, inicial = 5, preparo = 0.4 },
			{ tipo = "disparo", alcance = 44, preparo = 0.7, recarga = 2.4, projetil = "gelo", velocidade = 48, efeito = "lento" },
		},
	},
	cavaleiroMorto = {
